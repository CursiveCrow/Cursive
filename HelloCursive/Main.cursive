import compiler
import types
import operations
import memory
import permissions
import pointers
import modals
import contracts
import attributes
import concurrency
import ffi
import linkedshared
import linkedstatic
import hostedshared

[[layout(C)]]
record HostedSharedAggregateResult {
    first: i32
    second: i32
    third: i32
}

[[layout(C), ffi_pass_by_value]]
record HostedSharedReadBodyCmd {
    world: u64
    body: u64
}

[[layout(C)]]
record HostedSharedBodyState {
    status: u32
    handle: u64
    motion: u32
}

extern "C" {
    procedure __cursive_host_abi_version() -> u32
    procedure __cursive_host_session_create() -> usize
    procedure __cursive_host_session_destroy(handle: usize) -> u32
}

extern "C-unwind" {
    procedure hc_hosted_session_next(handle: usize) -> i32
    procedure hc_hosted_fail_zero(handle: usize) -> i32
    procedure hc_hosted_aggregate_result(handle: usize) -> HostedSharedAggregateResult
    procedure hc_hosted_aggregate_fail_zero(handle: usize) -> HostedSharedAggregateResult
    procedure hc_hosted_read_body_state(handle: usize, move read_cmd: HostedSharedReadBodyCmd, move out_state: *mut HostedSharedBodyState) -> u32
}

public procedure main(move ctx: Context) -> i32 {
    let status_compiler: i32 = compiler::run(ctx)
    if (status_compiler != 0) {
        return 101
    }

    let status_types: i32 = types::run(ctx)
    if (status_types != 0) {
        return 102
    }

    let status_operations: i32 = operations::run(ctx)
    if (status_operations != 0) {
        return 103
    }

    let status_memory: i32 = memory::run(ctx)
    if (status_memory != 0) {
        return 104
    }

    let status_permissions: i32 = permissions::run(ctx)
    if (status_permissions != 0) {
        return 105
    }

    let status_pointers: i32 = pointers::run(ctx)
    if (status_pointers != 0) {
        return 106
    }

    let status_modals: i32 = modals::run(ctx)
    if (status_modals != 0) {
        return 107
    }

    let status_contracts: i32 = contracts::run(ctx)
    if (status_contracts != 0) {
        return 108
    }

    let status_attributes: i32 = attributes::run(ctx)
    if (status_attributes != 0) {
        return 109
    }

    let status_concurrency: i32 = concurrency::run(ctx)
    if (status_concurrency != 0) {
        return 110
    }

    let status_ffi: i32 = ffi::run(ctx)
    if (status_ffi != 0) {
        return 111
    }

    let status_linkedshared: i32 = linkedshared::run(ctx)
    if (status_linkedshared != 0) {
        return 112
    }

    let status_linkedstatic: i32 = linkedstatic::run(ctx)
    if (status_linkedstatic != 0) {
        return 113
    }

    let status_hostedshared: i32 = hostedshared::run(ctx)
    if (status_hostedshared != 0) {
        return 114
    }

    let hostedshared_ordinary_followup: i32 =
        [[log(label: "observed-hostedshared-ordinary-followup-metric", expected: 303)]]
        hostedshared::ordinary_followup_value()
    if (hostedshared_ordinary_followup != 303) {
        return 115
    }

    let hosted_abi_version: u32 = unsafe { __cursive_host_abi_version() }
    let hosted_abi_version_log: u32 =
        [[log(label: "observed-hostedshared-host-abi-version", expected: 1)]]
        hosted_abi_version
    if (hosted_abi_version_log != 1u32) {
        return 116
    }

    let hosted_session_a: usize = unsafe { __cursive_host_session_create() }
    if (hosted_session_a == 0usize) {
        return 117
    }

    let hosted_session_next: i32 = unsafe { hc_hosted_session_next(hosted_session_a) }
    let hosted_session_next_log: i32 =
        [[log(label: "observed-hostedshared-host-session-next-metric", expected: 101)]]
        hosted_session_next
    if (hosted_session_next_log != 101) {
        return 118
    }

    let hosted_fail_zero: i32 = unsafe { hc_hosted_fail_zero(hosted_session_a) }
    let hosted_fail_zero_log: i32 =
        [[log(label: "observed-hostedshared-host-fail-zero-metric", expected: 0)]]
        hosted_fail_zero
    if (hosted_fail_zero_log != 0) {
        return 119
    }

    let hosted_aggregate_result: HostedSharedAggregateResult =
        unsafe { hc_hosted_aggregate_result(hosted_session_a) }
    let hosted_aggregate_fail_zero: HostedSharedAggregateResult =
        unsafe { hc_hosted_aggregate_fail_zero(hosted_session_a) }

    let hosted_aggregate_result_ok: bool =
        (hosted_aggregate_result.first == 11) &&
        (hosted_aggregate_result.second == 22) &&
        (hosted_aggregate_result.third == 33)
    let hosted_aggregate_result_ok_log: bool =
        [[log(label: "observed-hostedshared-host-aggregate-result", expected: true)]]
        hosted_aggregate_result_ok
    if (hosted_aggregate_result_ok_log != true) {
        return 120
    }

    let hosted_aggregate_fail_zero_ok: bool =
        (hosted_aggregate_fail_zero.first == 0) &&
        (hosted_aggregate_fail_zero.second == 0) &&
        (hosted_aggregate_fail_zero.third == 0)
    let hosted_aggregate_fail_zero_ok_log: bool =
        [[log(label: "observed-hostedshared-host-aggregate-fail-zero-result", expected: true)]]
        hosted_aggregate_fail_zero_ok
    if (hosted_aggregate_fail_zero_ok_log != true) {
        return 121
    }

    var hosted_read_state: HostedSharedBodyState =
        HostedSharedBodyState { status: 99u32, handle: 0u64, motion: 0u32 }
    let hosted_read_state_ptr: Ptr<HostedSharedBodyState>@Valid = &hosted_read_state
    var hosted_read_state_raw: *mut HostedSharedBodyState =
        unsafe { transmute<Ptr<HostedSharedBodyState>@Valid, *mut HostedSharedBodyState>(hosted_read_state_ptr) }
    let hosted_read_cmd: HostedSharedReadBodyCmd =
        HostedSharedReadBodyCmd { world: 1u64, body: 1u64 }
    let hosted_read_status: u32 =
        unsafe { hc_hosted_read_body_state(hosted_session_a, move hosted_read_cmd, move hosted_read_state_raw) }
    let hosted_read_status_log: u32 =
        [[log(label: "observed-hostedshared-host-read-body-status", expected: 0)]]
        hosted_read_status
    if (hosted_read_status_log != 0u32) {
        return 128
    }
    let hosted_read_state_ok: bool =
        (hosted_read_state.status == 0u32) &&
        (hosted_read_state.handle == 1u64) &&
        (hosted_read_state.motion == 2u32)
    let hosted_read_state_ok_log: bool =
        [[log(label: "observed-hostedshared-host-read-body-state", expected: true)]]
        hosted_read_state_ok
    if (hosted_read_state_ok_log != true) {
        return 129
    }

    let hosted_destroy_a: u32 = unsafe { __cursive_host_session_destroy(hosted_session_a) }
    let hosted_destroy_a_log: u32 =
        [[log(label: "observed-hostedshared-host-destroy-a", expected: 1)]]
        hosted_destroy_a
    if (hosted_destroy_a_log != 1u32) {
        return 122
    }

    let hosted_destroy_a_second: u32 = unsafe { __cursive_host_session_destroy(hosted_session_a) }
    let hosted_destroy_a_second_log: u32 =
        [[log(label: "observed-hostedshared-host-destroy-a-second", expected: 0)]]
        hosted_destroy_a_second
    if (hosted_destroy_a_second_log != 0u32) {
        return 123
    }

    let hosted_session_b: usize = unsafe { __cursive_host_session_create() }
    if ((hosted_session_b == 0usize) || (hosted_session_b == hosted_session_a)) {
        return 124
    }

    let hosted_session_b_next: i32 = unsafe { hc_hosted_session_next(hosted_session_b) }
    let hosted_session_b_next_log: i32 =
        [[log(label: "observed-hostedshared-host-session-b-next-metric", expected: 101)]]
        hosted_session_b_next
    if (hosted_session_b_next_log != 101) {
        return 125
    }

    let hosted_destroy_b: u32 = unsafe { __cursive_host_session_destroy(hosted_session_b) }
    let hosted_destroy_b_log: u32 =
        [[log(label: "observed-hostedshared-host-destroy-b", expected: 1)]]
        hosted_destroy_b
    if (hosted_destroy_b_log != 1u32) {
        return 126
    }

    let hostedshared_ordinary_post_host: i32 =
        [[log(label: "observed-hostedshared-ordinary-post-host-metric", expected: 404)]]
        hostedshared::ordinary_followup_value()
    if (hostedshared_ordinary_post_host != 404) {
        return 127
    }

    return 0
}
