procedure compilerWriteStage(fs: $FileSystem, label: string@View) -> () {
    let _ = if fs~>write_stdout(label) is {
        _: () { true }
        _: IoError { false }
    }
    return ()
}

public procedure runSystemExitProbeIfRequested(ctx: Context) -> bool {
    let armed: string@View =
        ctx.sys~>get_env("CURSIVE_HELLOCURSIVE_SYSTEM_EXIT_PROBE_BA82D7004C4B4E8A8D4CA7D0A6F66252")
    if (string::is_empty(armed) == false) {
        ctx.sys~>exit(73)
        return true
    }
    return false
}

[[mangle("hc_compiler_runtime_contract_fail_catch"), export("C-unwind"), unwind("catch")]]
public procedure compilerRuntimeContractFailCatch(value: i32) -> i32
{
    return value
}

extern "C" {
    procedure hc_compiler_runtime_contract_fail_catch(value: i32) -> i32
}

procedure runCompilerRuntimeConformance(ctx: Context) -> i32 {
    compilerWriteStage(ctx.fs, "compiler-runtime-stage:start\n")
    let catch_boundary_metric: i32 = unsafe {
        hc_compiler_runtime_contract_fail_catch(0)
    }
    compilerWriteStage(ctx.fs, "compiler-runtime-stage:catch\n")
    let catch_boundary_ok: bool = catch_boundary_metric == 0
    let catch_boundary_ok_log: bool =
        [[log(label: "observed-compiler-runtime-catch-boundary", expected: true)]]
        catch_boundary_ok

    let sandbox: $FileSystem = ctx.fs~>restrict("compiler_runtime_sandbox")
    let widened: $FileSystem = sandbox~>restrict("C:/Windows")
    let escaped: bool = widened~>exists("System32")
    let attenuation_ok: bool = escaped == false
    let attenuation_ok_log: bool =
        [[log(label: "observed-compiler-runtime-capability-attenuation", expected: true)]]
        attenuation_ok
    compilerWriteStage(ctx.fs, "compiler-runtime-stage:attenuation\n")

    let system_run_status: i32 = runCompilerSystemRunRuntimeConformance(ctx)
    compilerWriteStage(ctx.fs, "compiler-runtime-stage:system-run\n")
    if (system_run_status != 0) {
        [[log(label: "compiler-log-item_fail")]]
        return 1
    }

    let system_get_env_status: i32 = runCompilerSystemGetEnvRuntimeConformance(ctx)
    compilerWriteStage(ctx.fs, "compiler-runtime-stage:get-env\n")
    if (system_get_env_status != 0) {
        [[log(label: "compiler-log-item_fail")]]
        return 1
    }

    let system_exit_status: i32 = runCompilerSystemExitRuntimeConformance(ctx)
    compilerWriteStage(ctx.fs, "compiler-runtime-stage:system-exit\n")
    if (system_exit_status != 0) {
        [[log(label: "compiler-log-item_fail")]]
        return 1
    }

    let network_restrict_status: i32 = runCompilerNetworkRestrictHostRuntimeConformance(ctx)
    compilerWriteStage(ctx.fs, "compiler-runtime-stage:network\n")
    if (network_restrict_status != 0) {
        [[log(label: "compiler-log-item_fail")]]
        return 1
    }

    if ((catch_boundary_ok_log == false) ||
        (attenuation_ok_log == false)) {
        [[log(label: "compiler-log-item_fail")]]
        return 1
    }

    compilerWriteStage(ctx.fs, "compiler-runtime-stage:done\n")
    [[log(label: "compiler-log-item_success")]]
    return 0
}

public procedure run(ctx: Context) -> i32 {
    let probe_exit_taken: bool = runSystemExitProbeIfRequested(ctx)
    if (probe_exit_taken) {
        return 0
    }

    return runCompilerRuntimeConformance(ctx)
}
