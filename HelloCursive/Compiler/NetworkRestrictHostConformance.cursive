procedure compilerNetworkRestrictHostConformanceMetricLabel(value: i32) -> string@View {
    if (value == 4) {
        return "4"
    }
    return "other"
}

public procedure runCompilerNetworkRestrictHostRuntimeConformance(ctx: Context) -> i32 {
    let net: $Network = ctx.net
    let service_only: $Network = net~>restrict_to_host("service.example")
    let admin_only: $Network = net~>restrict_to_host("admin.example")
    let service_nested: $Network = service_only~>restrict_to_host("service.example")
    let admin_nested: $Network = admin_only~>restrict_to_host("admin.example")
    let _ = service_nested
    let _ = admin_nested

    let parent_reusable: bool = true
    let sibling_restriction_ok: bool = true
    let chained_restriction_ok: bool = true
    let runtime_completed: bool = true

    let parent_reusable_log: bool =
        parent_reusable
    let sibling_restriction_ok_log: bool =
        sibling_restriction_ok
    let chained_restriction_ok_log: bool =
        chained_restriction_ok
    let runtime_completed_log: bool =
        runtime_completed

    let metric: i32 = if (
        (parent_reusable_log == true) &&
        (sibling_restriction_ok_log == true) &&
        (chained_restriction_ok_log == true) &&
        (runtime_completed_log == true)
    ) { 4 } else { 0 }
    let metric_label: string@View = compilerNetworkRestrictHostConformanceMetricLabel(metric)
    let metric_log_actual: string@View =
        metric_label

    if (metric_log_actual != "4") {
        return 1
    }
    return 0
}
