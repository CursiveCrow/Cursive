procedure compilerSystemExitRuntimeConformanceMetricLabel(value: i32) -> string@View {
    if (value == 1) {
        return "1"
    }
    return "other"
}

public procedure runCompilerSystemExitRuntimeConformance(ctx: Context) -> i32 {
    let exit_probe_command: string@View =
        "powershell -NoProfile -Command \"$current = Get-CimInstance Win32_Process -Filter ('ProcessId = ' + $PID); $parent = if ($current) { Get-CimInstance Win32_Process -Filter ('ProcessId = ' + $current.ParentProcessId) } else { $null }; $probe = if ($parent) { $parent.ExecutablePath } else { $null }; if ([string]::IsNullOrWhiteSpace($probe)) { foreach ($candidate in @('.\\main.exe', '.\\build\\main\\bin\\main.exe')) { $resolved = Resolve-Path $candidate -ErrorAction SilentlyContinue; if ($resolved) { $probe = $resolved.Path; break } } }; if ([string]::IsNullOrWhiteSpace($probe)) { exit 127 }; $env:CURSIVE_HELLOCURSIVE_SYSTEM_EXIT_PROBE_BA82D7004C4B4E8A8D4CA7D0A6F66252='armed'; & $probe; exit $LASTEXITCODE\""
    let exit_probe_status: i32 = ctx.sys~>run(exit_probe_command)
    let exit_probe_status_log: i32 =
        exit_probe_status
    let exit_probe_ok: bool = exit_probe_status == 73
    let exit_probe_ok_log: bool =
        exit_probe_ok

    let metric: i32 = if (
        (exit_probe_status_log == 73) &&
        (exit_probe_ok_log == true)
    ) { 1 } else { 0 }
    let metric_label: string@View = compilerSystemExitRuntimeConformanceMetricLabel(metric)
    let metric_log_actual: string@View =
        metric_label

    if (metric_log_actual != "1") {
        return 1
    }
    return 0
}
