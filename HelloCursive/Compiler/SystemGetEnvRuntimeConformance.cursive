procedure compilerSystemGetEnvRuntimeConformanceMetricLabel(value: i32) -> string@View {
    if (value == 2) {
        return "2"
    }
    return "other"
}

public procedure runCompilerSystemGetEnvRuntimeConformance(ctx: Context) -> i32 {
    let present_env: string@View = ctx.sys~>get_env("SystemRoot")
    let missing_env: string@View = ctx.sys~>get_env("CURSIVE_SENTINEL_ABSENT_6D5D4754A0CB4C4E8A33E4BC1CDEF001")
    let present_env_ok: bool = string::is_empty(present_env) == false
    let missing_env_ok: bool = string::is_empty(missing_env)

    let present_env_ok_log: bool =
        present_env_ok
    let missing_env_ok_log: bool =
        missing_env_ok

    let metric: i32 = if (
        (present_env_ok_log == true) &&
        (missing_env_ok_log == true)
    ) { 2 } else { 0 }
    let metric_label: string@View = compilerSystemGetEnvRuntimeConformanceMetricLabel(metric)
    let metric_log_actual: string@View =
        metric_label

    if (metric_log_actual != "2") {
        return 1
    }
    return 0
}
