[[mangle("hc_contracts_foreign_ensures_type_impl"), export("C")]]
public procedure ContractsForeignEnsuresTypeImpl(value: i32) -> i32 {
    return value
}

[[mangle("hc_contracts_foreign_ensures_type_ptr_impl"), export("C")]]
public procedure ContractsForeignEnsuresTypePtrImpl(ptr: *imm i32, mode: i32) -> *imm i32 {
    if (mode == 0) {
        return null
    }
    return ptr
}

extern "C" {
    procedure hc_contracts_foreign_ensures_type_impl(value: i32) -> i32
        |: @foreign_ensures(@result >= 0)
}

extern "C" {
    [[dynamic]]
    procedure hc_contracts_foreign_ensures_type_ptr_impl(ptr: *imm i32, mode: i32) -> *imm i32
        |: @foreign_ensures(@null_result: @result == null)
}

procedure ForeignEnsuresTypeRestrictionsMetricLabel(value: i32) -> string@View {
    if (value == 21) {
        return "21"
    }
    return "other"
}

public procedure RunForeignEnsuresTypeRestrictions(ctx: Context) -> i32 {
    [[log(label: "contracts-log-item_begin", expected: "running")]] "running"

    let seed_value: i32 = 31
    let seed_ptr_safe: Ptr<i32>@Valid = &seed_value
    let seed_ptr_raw: *imm i32 = unsafe { transmute<Ptr<i32>@Valid, *imm i32>(seed_ptr_safe) }

    let observed_value: i32 = unsafe { hc_contracts_foreign_ensures_type_impl(9) }
    let observed_ptr_non_null: *imm i32 = unsafe {
        hc_contracts_foreign_ensures_type_ptr_impl(seed_ptr_raw, 1)
    }
    let observed_ptr_null: *imm i32 = unsafe {
        hc_contracts_foreign_ensures_type_ptr_impl(seed_ptr_raw, 0)
    }

    let observed_value_log: i32 =
        [[log(label: "observed-contracts-foreign-ensures-type-restrictions-call", expected: 9)]]
        observed_value
    let observed_ptr_non_null_log: bool =
        [[log(label: "observed-contracts-foreign-ensures-type-restrictions-nullable-pointer-non-null", expected: true)]]
        observed_ptr_non_null != null
    let observed_ptr_null_log: bool =
        [[log(label: "observed-contracts-foreign-ensures-type-restrictions-nullable-pointer-null", expected: true)]]
        observed_ptr_null == null

    let con_071: string@View = "CON-071"
    let con_071_log: string@View =
        [[log(label: "contracts-foreign-ensures-type-restrictions-feature-071", expected: "CON-071")]]
        con_071

    let diag_2853: string@View = "E-SEM-2853"
    let diag_2855: string@View = "E-SEM-2855"
    let diag_2853_log: string@View =
        [[log(label: "contracts-foreign-ensures-type-restrictions-diag-2853", expected: "E-SEM-2853")]]
        diag_2853
    let diag_2855_log: string@View =
        [[log(label: "contracts-foreign-ensures-type-restrictions-diag-2855", expected: "E-SEM-2855")]]
        diag_2855

    let runtime_ok: bool =
        (observed_value_log == 9) &&
        (observed_ptr_non_null_log == true) &&
        (observed_ptr_null_log == true) &&
        (con_071_log == "CON-071") &&
        (diag_2853_log == "E-SEM-2853") &&
        (diag_2855_log == "E-SEM-2855")
    let runtime_ok_log: bool =
        [[log(label: "contracts-foreign-ensures-type-restrictions-runtime", expected: true)]]
        runtime_ok

    let metric: i32 = if (runtime_ok_log == true) { 21 } else { 0 }
    let metric_label: string@View = ForeignEnsuresTypeRestrictionsMetricLabel(metric)
    let metric_log_actual: string@View =
        [[log(label: "observed-contracts-foreign-ensures-type-restrictions-metric", expected: "21")]]
        metric_label
    if (metric_log_actual != "21") {
        [[log(label: "contracts-log-item_fail", expected: "fail")]] "fail"
        return 1
    }

    [[log(label: "contracts-log-item_success", expected: "success")]] "success"
    return 0
}
