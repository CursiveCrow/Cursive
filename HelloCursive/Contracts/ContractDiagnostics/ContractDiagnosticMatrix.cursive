procedure ContractDiagnosticMatrixMetricLabel(value: i32) -> string@View {
    if (value == 105) {
        return "105"
    }
    return "other"
}

public procedure RunContractDiagnosticMatrix(ctx: Context) -> i32 {
    "running"

    let status_static_proof: i32 = VerificationLogicAndRuntimeChecks::RunStaticProofAndDecidablePredicates(ctx)
    let status_impure_predicates: i32 = PredicatePurityAndContexts::RunContractPredicateImpureRejections(ctx)
    let status_liskov_pre: i32 = BehavioralSubtypingContracts::RunLiskovPreconditionWeakening(ctx)
    let status_liskov_post: i32 = BehavioralSubtypingContracts::RunLiskovPostconditionStrengthening(ctx)
    let status_result_intrinsic: i32 = PrePostContracts::RunResultIntrinsicTypingAndScope(ctx)
    let status_type_invariant_points: i32 = Invariants::RunTypeInvariantEnforcementPoints(ctx)
    let status_type_invariant_public_field: i32 = Invariants::RunTypeInvariantPublicFieldRestrictions(ctx)
    let status_loop_invariant: i32 = Invariants::RunLoopInvariantEnforcementAndFacts(ctx)
    let status_dynamic_attr_scope: i32 = ContractSyntaxAndFrontEnd::RunDynamicAttributeScopeAndPlacement(ctx)

    let status_static_proof_log: i32 =
        status_static_proof
    let status_impure_predicates_log: i32 =
        status_impure_predicates
    let status_liskov_pre_log: i32 =
        status_liskov_pre
    let status_liskov_post_log: i32 =
        status_liskov_post
    let status_result_intrinsic_log: i32 =
        status_result_intrinsic
    let status_type_invariant_points_log: i32 =
        status_type_invariant_points
    let status_type_invariant_public_field_log: i32 =
        status_type_invariant_public_field
    let status_loop_invariant_log: i32 =
        status_loop_invariant
    let status_dynamic_attr_scope_log: i32 =
        status_dynamic_attr_scope

    let core_diagnostics_exercised: bool =
        (status_static_proof_log == 0) &&
        (status_impure_predicates_log == 0) &&
        (status_liskov_pre_log == 0) &&
        (status_liskov_post_log == 0) &&
        (status_result_intrinsic_log == 0) &&
        (status_type_invariant_points_log == 0) &&
        (status_type_invariant_public_field_log == 0) &&
        (status_loop_invariant_log == 0)
    let dynamic_attr_diagnostics_exercised: bool = status_dynamic_attr_scope_log == 0

    let con_076: string@View =
        if (core_diagnostics_exercised == true) {
            "CON-076"
        } else {
            "missing"
        }
    let con_078: string@View =
        if (dynamic_attr_diagnostics_exercised == true) {
            "CON-078"
        } else {
            "missing"
        }
    let diag_2801: string@View = if (status_static_proof_log == 0) { "E-SEM-2801" } else { "missing" }
    let diag_2802: string@View = if (status_impure_predicates_log == 0) { "E-SEM-2802" } else { "missing" }
    let diag_2803: string@View = if (status_liskov_pre_log == 0) { "E-SEM-2803" } else { "missing" }
    let diag_2804: string@View = if (status_liskov_post_log == 0) { "E-SEM-2804" } else { "missing" }
    let diag_2806: string@View = if (status_result_intrinsic_log == 0) { "E-SEM-2806" } else { "missing" }
    let diag_2820: string@View = if (status_type_invariant_points_log == 0) { "E-SEM-2820" } else { "missing" }
    let diag_2821: string@View = if (status_type_invariant_points_log == 0) { "E-SEM-2821" } else { "missing" }
    let diag_2822: string@View = if (status_type_invariant_points_log == 0) { "E-SEM-2822" } else { "missing" }
    let diag_2823: string@View = if (status_type_invariant_points_log == 0) { "E-SEM-2823" } else { "missing" }
    let diag_2824: string@View = if (status_type_invariant_public_field_log == 0) { "E-SEM-2824" } else { "missing" }
    let diag_2830: string@View = if (status_loop_invariant_log == 0) { "E-SEM-2830" } else { "missing" }
    let diag_2831: string@View = if (status_loop_invariant_log == 0) { "E-SEM-2831" } else { "missing" }
    let diag_3004: string@View = if (status_impure_predicates_log == 0) { "E-SEM-3004" } else { "missing" }
    let diag_0410: string@View = if (status_dynamic_attr_scope_log == 0) { "E-CON-0410" } else { "missing" }
    let diag_0411: string@View = if (status_dynamic_attr_scope_log == 0) { "E-CON-0411" } else { "missing" }
    let diag_0412: string@View = if (status_dynamic_attr_scope_log == 0) { "E-CON-0412" } else { "missing" }
    let warn_0401: string@View = if (status_dynamic_attr_scope_log == 0) { "W-CON-0401" } else { "missing" }

    let check_0: string@View = con_076
    let check_0b: string@View = con_078
    let check_1: string@View = diag_2801
    let check_2: string@View = diag_2802
    let check_3: string@View = diag_2803
    let check_4: string@View = diag_2804
    let check_5: string@View = diag_2806
    let check_6: string@View = diag_2820
    let check_7: string@View = diag_2821
    let check_8: string@View = diag_2822
    let check_9: string@View = diag_2823
    let check_10: string@View = diag_2824
    let check_11: string@View = diag_2830
    let check_12: string@View = diag_2831
    let check_13: string@View = diag_3004
    let check_14: string@View = diag_0410
    let check_15: string@View = diag_0411
    let check_16: string@View = diag_0412
    let check_17: string@View = warn_0401

    let matrix_ok: bool =
        (check_0 == "CON-076") &&
        (check_0b == "CON-078") &&
        (check_1 == "E-SEM-2801") &&
        (check_2 == "E-SEM-2802") &&
        (check_3 == "E-SEM-2803") &&
        (check_4 == "E-SEM-2804") &&
        (check_5 == "E-SEM-2806") &&
        (check_6 == "E-SEM-2820") &&
        (check_7 == "E-SEM-2821") &&
        (check_8 == "E-SEM-2822") &&
        (check_9 == "E-SEM-2823") &&
        (check_10 == "E-SEM-2824") &&
        (check_11 == "E-SEM-2830") &&
        (check_12 == "E-SEM-2831") &&
        (check_13 == "E-SEM-3004") &&
        (check_14 == "E-CON-0410") &&
        (check_15 == "E-CON-0411") &&
        (check_16 == "E-CON-0412") &&
        (check_17 == "W-CON-0401")
    let matrix_ok_log: bool =
        matrix_ok

    let metric: i32 = if (matrix_ok_log == true) { 105 } else { 0 }
    let metric_label: string@View = ContractDiagnosticMatrixMetricLabel(metric)
    let metric_log_actual: string@View =
        metric_label
    if (metric_log_actual != "105") {
        "fail"
        return 1
    }

    "success"
    return 0
}
