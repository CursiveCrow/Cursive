public procedure runGroup(ctx: Context) -> i32 {
    [[log(label: "contracts-log-section_start", expected: "section-start")]] "section-start"

    let status_contract_diagnostic_matrix: i32 = RunContractDiagnosticMatrix(ctx)
    if (status_contract_diagnostic_matrix != 0) {
        [[log(label: "contracts-log-section_end", expected: "section-end")]] "section-end"
        return status_contract_diagnostic_matrix
    }

    let status_contract_runtime_panic_matrix: i32 = RunContractRuntimePanicMatrix(ctx)
    if (status_contract_runtime_panic_matrix != 0) {
        [[log(label: "contracts-log-section_end", expected: "section-end")]] "section-end"
        return status_contract_runtime_panic_matrix
    }

    let status_contract_spec_consistency_matrix: i32 = RunContractSpecConsistencyMatrix(ctx)
    if (status_contract_spec_consistency_matrix != 0) {
        [[log(label: "contracts-log-section_end", expected: "section-end")]] "section-end"
        return status_contract_spec_consistency_matrix
    }

    let status_foreign_contract_diagnostic_matrix: i32 = RunForeignContractDiagnosticMatrix(ctx)
    if (status_foreign_contract_diagnostic_matrix != 0) {
        [[log(label: "contracts-log-section_end", expected: "section-end")]] "section-end"
        return status_foreign_contract_diagnostic_matrix
    }

    [[log(label: "contracts-log-section_end", expected: "section-end")]] "section-end"
    return 0
}
