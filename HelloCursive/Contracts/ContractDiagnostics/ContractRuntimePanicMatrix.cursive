[[dynamic]]
procedure ContractRuntimePanicMatrixLocalPreProbe(value: i32) -> i32
    |: value >= 0
{
    return value + 1
}

[[dynamic]]
procedure ContractRuntimePanicMatrixLocalPostProbe(value: i32) -> i32
    |: => @result >= 0
{
    return value
}

[[dynamic, mangle("hc_contracts_runtime_panic_matrix_local_pre_catch"), export("C-unwind"), unwind("catch")]]
public procedure ContractRuntimePanicMatrixLocalPreCatch() -> i32 {
    let _panic: i32 = ContractRuntimePanicMatrixLocalPreProbe(-2)
    return _panic
}

[[dynamic, mangle("hc_contracts_runtime_panic_matrix_local_post_catch"), export("C-unwind"), unwind("catch")]]
public procedure ContractRuntimePanicMatrixLocalPostCatch() -> i32 {
    let _panic: i32 = ContractRuntimePanicMatrixLocalPostProbe(-3)
    return _panic
}

[[mangle("hc_contracts_runtime_panic_matrix_foreign_pre_impl"), export("C-unwind")]]
public procedure ContractRuntimePanicMatrixForeignPreImpl(value: i32) -> i32 {
    return value + 1
}

extern "C" {
    [[dynamic]]
    procedure hc_contracts_runtime_panic_matrix_foreign_pre_impl(value: i32) -> i32
        |: @foreign_assumes(value >= 0)
}

[[dynamic, mangle("hc_contracts_runtime_panic_matrix_foreign_pre_catch"), export("C-unwind"), unwind("catch")]]
public procedure ContractRuntimePanicMatrixForeignPreCatch() -> i32 {
    let _panic: i32 = unsafe {
        hc_contracts_runtime_panic_matrix_foreign_pre_impl(-4)
    }
    return _panic
}

[[mangle("hc_contracts_runtime_panic_matrix_foreign_post_impl"), export("C-unwind")]]
public procedure ContractRuntimePanicMatrixForeignPostImpl(value: i32) -> i32 {
    return value
}

extern "C" {
    [[dynamic]]
    procedure hc_contracts_runtime_panic_matrix_foreign_post_impl(value: i32) -> i32
        |: @foreign_ensures(@result >= 0)
}

[[dynamic, mangle("hc_contracts_runtime_panic_matrix_foreign_post_catch"), export("C-unwind"), unwind("catch")]]
public procedure ContractRuntimePanicMatrixForeignPostCatch() -> i32 {
    let _panic: i32 = unsafe {
        hc_contracts_runtime_panic_matrix_foreign_post_impl(-5)
    }
    return _panic
}

extern "C" {
    procedure hc_contracts_runtime_panic_matrix_local_pre_catch() -> i32
    procedure hc_contracts_runtime_panic_matrix_local_post_catch() -> i32
    procedure hc_contracts_runtime_panic_matrix_foreign_pre_catch() -> i32
    procedure hc_contracts_runtime_panic_matrix_foreign_post_catch() -> i32
}

procedure ContractRuntimePanicMatrixMetricLabel(value: i32) -> string@View {
    if (value == 21) {
        return "21"
    }
    return "other"
}

public procedure RunContractRuntimePanicMatrix(ctx: Context) -> i32 {
    let _ = ctx
    "running"

    let con_079: string@View = "CON-079"
    let con_079_log: string@View =
        con_079

    let local_pre_fail_catch_metric: i32 = unsafe {
        hc_contracts_runtime_panic_matrix_local_pre_catch()
    }
    let local_post_fail_catch_metric: i32 = unsafe {
        hc_contracts_runtime_panic_matrix_local_post_catch()
    }
    let foreign_pre_fail_catch_metric: i32 = unsafe {
        hc_contracts_runtime_panic_matrix_foreign_pre_catch()
    }
    let foreign_post_fail_catch_metric: i32 = unsafe {
        hc_contracts_runtime_panic_matrix_foreign_post_catch()
    }

    let local_pre_fail_catch_metric_log: i32 =
        local_pre_fail_catch_metric
    let local_post_fail_catch_metric_log: i32 =
        local_post_fail_catch_metric
    let foreign_pre_fail_catch_metric_log: i32 =
        foreign_pre_fail_catch_metric
    let foreign_post_fail_catch_metric_log: i32 =
        foreign_post_fail_catch_metric

    let panic_2850: string@View =
        if (
            (local_pre_fail_catch_metric_log == 0) &&
            (local_post_fail_catch_metric_log == 0)
        ) {
            "P-SEM-2850"
        } else {
            "missing"
        }
    let panic_2860: string@View =
        if (foreign_pre_fail_catch_metric_log == 0) {
            "P-SEM-2860"
        } else {
            "missing"
        }
    let panic_2861: string@View =
        if (foreign_post_fail_catch_metric_log == 0) {
            "P-SEM-2861"
        } else {
            "missing"
        }
    let panic_2850_log: string@View =
        panic_2850
    let panic_2860_log: string@View =
        panic_2860
    let panic_2861_log: string@View =
        panic_2861

    let runtime_ok: bool =
        (con_079_log == "CON-079") &&
        (local_pre_fail_catch_metric_log == 0) &&
        (local_post_fail_catch_metric_log == 0) &&
        (foreign_pre_fail_catch_metric_log == 0) &&
        (foreign_post_fail_catch_metric_log == 0) &&
        (panic_2850_log == "P-SEM-2850") &&
        (panic_2860_log == "P-SEM-2860") &&
        (panic_2861_log == "P-SEM-2861")
    let runtime_ok_log: bool =
        runtime_ok

    let metric: i32 = if (runtime_ok_log == true) { 21 } else { 0 }
    let metric_label: string@View = ContractRuntimePanicMatrixMetricLabel(metric)
    let metric_log_actual: string@View =
        metric_label
    if (metric_log_actual != "21") {
        "fail"
        return 1
    }

    "success"
    return 0
}
