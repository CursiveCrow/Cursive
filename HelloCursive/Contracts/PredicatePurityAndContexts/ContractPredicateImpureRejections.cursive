[[dynamic]]
procedure ContractImpureRejectionBaseline(value: i32) -> i32
    |: value >= 0 => @result >= 0
{
    let diag_value: i32 =
        [[log(label: "diag-contracts-impure-rejection-baseline-value", expected: 4)]]
        value
    let diag_next: i32 =
        [[log(label: "diag-contracts-impure-rejection-baseline-next", expected: 6)]]
        diag_value + 2
    return diag_next
}

procedure ContractPredicateImpureRejectionsMetricLabel(value: i32) -> string@View {
    if (value == 21) {
        return "21"
    }
    return "other"
}

public procedure RunContractPredicateImpureRejections(ctx: Context) -> i32 {
    let _ = ctx
    [[log(label: "contracts-log-item_begin", expected: "running")]] "running"

    let baseline: i32 = ContractImpureRejectionBaseline(4)
    let baseline_log: i32 =
        [[log(label: "observed-contracts-impure-rejection-baseline", expected: 6)]]
        baseline

    let con_021: string@View = "CON-021"
    let con_021_log: string@View =
        [[log(label: "contracts-contract-predicate-impure-rejections-feature-021", expected: "CON-021")]]
        con_021
    let con_082: string@View = "CON-082"
    let con_082_log: string@View =
        [[log(label: "contracts-contract-predicate-impure-rejections-feature-082", expected: "CON-082")]]
        con_082

    let diag_2802: string@View = "E-SEM-2802"
    let diag_3004: string@View = "E-SEM-3004"
    let diag_2802_log: string@View =
        [[log(label: "contracts-contract-predicate-impure-rejections-diag-2802", expected: "E-SEM-2802")]]
        diag_2802
    let diag_3004_log: string@View =
        [[log(label: "contracts-contract-predicate-impure-rejections-diag-3004", expected: "E-SEM-3004")]]
        diag_3004

    let runtime_ok: bool =
        (baseline_log == 6) &&
        (con_021_log == "CON-021") &&
        (con_082_log == "CON-082") &&
        (diag_2802_log == "E-SEM-2802") &&
        (diag_3004_log == "E-SEM-3004")
    let runtime_ok_log: bool =
        [[log(label: "contracts-contract-predicate-impure-rejections-runtime", expected: true)]]
        runtime_ok

    let metric: i32 = if (runtime_ok_log == true) { 21 } else { 0 }
    let metric_label: string@View = ContractPredicateImpureRejectionsMetricLabel(metric)
    let metric_log_actual: string@View =
        [[log(label: "observed-contracts-contract-predicate-impure-rejections-metric", expected: "21")]]
        metric_label
    if (metric_log_actual != "21") {
        [[log(label: "contracts-log-item_fail", expected: "fail")]] "fail"
        return 1
    }

    [[log(label: "contracts-log-item_success", expected: "success")]] "success"
    return 0
}
