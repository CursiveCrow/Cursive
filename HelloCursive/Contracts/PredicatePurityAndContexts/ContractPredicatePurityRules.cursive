procedure PurePositive(value: i32) -> bool {
    return value > 0
}

[[dynamic]]
procedure ContractPredicatePurityProbe(value: i32) -> i32
    |: => (@result > 0) && (@entry(value) > 0)
{
    return value + 1
}

procedure ContractPredicatePurityRulesMetricLabel(value: i32) -> string@View {
    if (value == 35) {
        return "35"
    }
    return "other"
}

public procedure RunContractPredicatePurityRules(ctx: Context) -> i32 {
    let _ = ctx
    "running"

    let probe: i32 = ContractPredicatePurityProbe(3)
    let probe_log: i32 =
        probe

    let con_018: string@View = "CON-018"
    let con_020: string@View = "CON-020"
    let con_022: string@View = "CON-022"
    let con_018_log: string@View =
        con_018
    let con_020_log: string@View =
        con_020
    let con_022_log: string@View =
        con_022

    let runtime_ok: bool =
        (probe_log == 4) &&
        (con_018_log == "CON-018") &&
        (con_020_log == "CON-020") &&
        (con_022_log == "CON-022")
    let runtime_ok_log: bool =
        runtime_ok

    let metric: i32 = if (runtime_ok_log == true) { 35 } else { 0 }
    let metric_label: string@View = ContractPredicatePurityRulesMetricLabel(metric)
    let metric_log_actual: string@View =
        metric_label
    if (metric_log_actual != "35") {
        "fail"
        return 1
    }

    "success"
    return 0
}
