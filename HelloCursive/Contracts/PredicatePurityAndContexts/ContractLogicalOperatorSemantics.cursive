[[dynamic]]
procedure ContractLogicalOperatorProbe(value: i32) -> i32
    |: (value > 0) && (value < 10) && !((value == 3) || (value == 12))
{
    return value + 2
}

procedure ContractLogicalOperatorSemanticsMetricLabel(value: i32) -> string@View {
    if (value == 21) {
        return "21"
    }
    return "other"
}

public procedure RunContractLogicalOperatorSemantics(ctx: Context) -> i32 {
    let _ = ctx
    [[log(label: "contracts-log-item_begin", expected: "running")]] "running"

    let probe: i32 = ContractLogicalOperatorProbe(4)
    let probe_log: i32 =
        [[log(label: "observed-contracts-logical-operator-probe", expected: 6)]]
        probe

    let con_019: string@View = "CON-019"
    let con_019_log: string@View =
        [[log(label: "contracts-contract-logical-operator-semantics-feature-019", expected: "CON-019")]]
        con_019

    let runtime_ok: bool =
        (probe_log == 6) &&
        (con_019_log == "CON-019")
    let runtime_ok_log: bool =
        [[log(label: "contracts-contract-logical-operator-semantics-runtime", expected: true)]]
        runtime_ok

    let metric: i32 = if (runtime_ok_log == true) { 21 } else { 0 }
    let metric_label: string@View = ContractLogicalOperatorSemanticsMetricLabel(metric)
    let metric_log_actual: string@View =
        [[log(label: "observed-contracts-contract-logical-operator-semantics-metric", expected: "21")]]
        metric_label
    if (metric_log_actual != "21") {
        [[log(label: "contracts-log-item_fail", expected: "fail")]] "fail"
        return 1
    }

    [[log(label: "contracts-log-item_success", expected: "success")]] "success"
    return 0
}
