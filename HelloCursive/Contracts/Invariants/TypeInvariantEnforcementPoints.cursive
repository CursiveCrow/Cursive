record TypeInvariantEnforcementPointsProbe {
    value: i32

    procedure Read(~) -> i32 {
        return self.value
    }

    procedure Shift(~, delta: i32) -> TypeInvariantEnforcementPointsProbe {
        return TypeInvariantEnforcementPointsProbe { value: self.value + delta }
    }
} |: { self.value >= 0 }

procedure TypeInvariantEnforcementPointsMetricLabel(value: i32) -> string@View {
    if (value == 35) {
        return "35"
    }
    return "other"
}

public procedure RunTypeInvariantEnforcementPoints(ctx: Context) -> i32 {
    let _ = ctx
    "running"

    let probe: TypeInvariantEnforcementPointsProbe =
        TypeInvariantEnforcementPointsProbe { value: 1 }
    let pre_call: i32 = probe~>Read()
    let shifted: TypeInvariantEnforcementPointsProbe = probe~>Shift(1)
    let post_mutate: i32 = shifted.value
    let post_call: i32 = shifted~>Read()

    let pre_call_log: i32 =
        pre_call
    let post_mutate_log: i32 =
        post_mutate
    let post_call_log: i32 =
        post_call

    let con_040: string@View = "CON-040"
    let con_040_log: string@View =
        con_040
    let con_083: string@View = "CON-083"
    let con_083_log: string@View =
        con_083

    let diag_2820: string@View = "E-SEM-2820"
    let diag_2821: string@View = "E-SEM-2821"
    let diag_2822: string@View = "E-SEM-2822"
    let diag_2823: string@View = "E-SEM-2823"
    let diag_2820_log: string@View =
        diag_2820
    let diag_2821_log: string@View =
        diag_2821
    let diag_2822_log: string@View =
        diag_2822
    let diag_2823_log: string@View =
        diag_2823

    let runtime_ok: bool =
        (pre_call_log == 1) &&
        (post_mutate_log == 2) &&
        (post_call_log == 2) &&
        (con_040_log == "CON-040") &&
        (con_083_log == "CON-083") &&
        (diag_2820_log == "E-SEM-2820") &&
        (diag_2821_log == "E-SEM-2821") &&
        (diag_2822_log == "E-SEM-2822") &&
        (diag_2823_log == "E-SEM-2823")
    let runtime_ok_log: bool =
        runtime_ok

    let metric: i32 = if (runtime_ok_log == true) { 35 } else { 0 }
    let metric_label: string@View = TypeInvariantEnforcementPointsMetricLabel(metric)
    let metric_log_actual: string@View =
        metric_label
    if (metric_log_actual != "35") {
        "fail"
        return 1
    }

    "success"
    return 0
}
