record TypeInvariantPublicFieldRestrictionsProbe {
    value: i32

    public procedure Read(~) -> i32 {
        return self.value
    }
} |: { self.value >= 0 }

procedure TypeInvariantPublicFieldRestrictionsMetricLabel(value: i32) -> string@View {
    if (value == 21) {
        return "21"
    }
    return "other"
}

public procedure RunTypeInvariantPublicFieldRestrictions(ctx: Context) -> i32 {
    let _ = ctx
    [[log(label: "contracts-log-item_begin", expected: "running")]] "running"

    let probe: TypeInvariantPublicFieldRestrictionsProbe =
        TypeInvariantPublicFieldRestrictionsProbe { value: 3 }
    let read_value: i32 = probe~>Read()
    let read_value_log: i32 =
        [[log(label: "observed-contracts-type-invariant-public-field-read", expected: 3)]]
        read_value

    let con_041: string@View = "CON-041"
    let con_041_log: string@View =
        [[log(label: "contracts-type-invariant-public-field-restrictions-feature-041", expected: "CON-041")]]
        con_041
    let con_084: string@View = "CON-084"
    let con_084_log: string@View =
        [[log(label: "contracts-type-invariant-public-field-restrictions-feature-084", expected: "CON-084")]]
        con_084

    let diag_2824: string@View = "E-SEM-2824"
    let diag_2824_log: string@View =
        [[log(label: "contracts-type-invariant-public-field-restrictions-diag-2824", expected: "E-SEM-2824")]]
        diag_2824

    let runtime_ok: bool =
        (read_value_log == 3) &&
        (con_041_log == "CON-041") &&
        (con_084_log == "CON-084") &&
        (diag_2824_log == "E-SEM-2824")
    let runtime_ok_log: bool =
        [[log(label: "contracts-type-invariant-public-field-restrictions-runtime", expected: true)]]
        runtime_ok

    let metric: i32 = if (runtime_ok_log == true) { 21 } else { 0 }
    let metric_label: string@View = TypeInvariantPublicFieldRestrictionsMetricLabel(metric)
    let metric_log_actual: string@View =
        [[log(label: "observed-contracts-type-invariant-public-field-restrictions-metric", expected: "21")]]
        metric_label
    if (metric_log_actual != "21") {
        [[log(label: "contracts-log-item_fail", expected: "fail")]] "fail"
        return 1
    }

    [[log(label: "contracts-log-item_success", expected: "success")]] "success"
    return 0
}
