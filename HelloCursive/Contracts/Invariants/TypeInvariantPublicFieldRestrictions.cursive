record TypeInvariantPublicFieldRestrictionsProbe {
    value: i32

    public procedure Read(~) -> i32 {
        return self.value
    }
} |: { self.value >= 0 }

procedure TypeInvariantPublicFieldRestrictionsMetricLabel(value: i32) -> string@View {
    if (value == 21) {
        return "21"
    }
    return "other"
}

public procedure RunTypeInvariantPublicFieldRestrictions(ctx: Context) -> i32 {
    let _ = ctx
    "running"

    let probe: TypeInvariantPublicFieldRestrictionsProbe =
        TypeInvariantPublicFieldRestrictionsProbe { value: 3 }
    let read_value: i32 = probe~>Read()
    let read_value_log: i32 =
        read_value

    let con_041: string@View = "CON-041"
    let con_041_log: string@View =
        con_041
    let con_084: string@View = "CON-084"
    let con_084_log: string@View =
        con_084

    let diag_2824: string@View = "E-SEM-2824"
    let diag_2824_log: string@View =
        diag_2824

    let runtime_ok: bool =
        (read_value_log == 3) &&
        (con_041_log == "CON-041") &&
        (con_084_log == "CON-084") &&
        (diag_2824_log == "E-SEM-2824")
    let runtime_ok_log: bool =
        runtime_ok

    let metric: i32 = if (runtime_ok_log == true) { 21 } else { 0 }
    let metric_label: string@View = TypeInvariantPublicFieldRestrictionsMetricLabel(metric)
    let metric_log_actual: string@View =
        metric_label
    if (metric_log_actual != "21") {
        "fail"
        return 1
    }

    "success"
    return 0
}
