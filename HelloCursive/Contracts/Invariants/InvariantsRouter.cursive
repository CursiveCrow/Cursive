public procedure RunGroup(ctx: Context) -> i32 {
    [[log(label: "contracts-log-section_start", expected: "section-start")]] "section-start"

    let status_invariant_dynamic_verification_bridge: i32 = RunInvariantDynamicVerificationBridge(ctx)
    if (status_invariant_dynamic_verification_bridge != 0) {
        [[log(label: "contracts-log-section_end", expected: "section-end")]] "section-end"
        return status_invariant_dynamic_verification_bridge
    }

    let status_loop_invariant_enforcement_and_facts: i32 = RunLoopInvariantEnforcementAndFacts(ctx)
    if (status_loop_invariant_enforcement_and_facts != 0) {
        [[log(label: "contracts-log-section_end", expected: "section-end")]] "section-end"
        return status_loop_invariant_enforcement_and_facts
    }

    let status_type_invariant_enforcement_points: i32 = RunTypeInvariantEnforcementPoints(ctx)
    if (status_type_invariant_enforcement_points != 0) {
        [[log(label: "contracts-log-section_end", expected: "section-end")]] "section-end"
        return status_type_invariant_enforcement_points
    }

    let status_type_invariant_predicate_context: i32 = RunTypeInvariantPredicateContext(ctx)
    if (status_type_invariant_predicate_context != 0) {
        [[log(label: "contracts-log-section_end", expected: "section-end")]] "section-end"
        return status_type_invariant_predicate_context
    }

    let status_type_invariant_public_field_restrictions: i32 = RunTypeInvariantPublicFieldRestrictions(ctx)
    if (status_type_invariant_public_field_restrictions != 0) {
        [[log(label: "contracts-log-section_end", expected: "section-end")]] "section-end"
        return status_type_invariant_public_field_restrictions
    }

    [[log(label: "contracts-log-section_end", expected: "section-end")]] "section-end"
    return 0
}
