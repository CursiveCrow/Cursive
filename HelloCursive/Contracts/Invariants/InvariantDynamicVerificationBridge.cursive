record InvariantDynamicVerificationBridgeProbe {
    value: i32
} |: { self.value >= 0 }

[[dynamic]]
procedure InvariantDynamicBridge(value: i32) -> i32
    |: => @result >= 0
{
    let probe: InvariantDynamicVerificationBridgeProbe =
        InvariantDynamicVerificationBridgeProbe { value: value + 1 }
    return probe.value
}

procedure InvariantDynamicVerificationBridgeMetricLabel(value: i32) -> string@View {
    if (value == 21) {
        return "21"
    }
    return "other"
}

public procedure RunInvariantDynamicVerificationBridge(ctx: Context) -> i32 {
    let _ = ctx
    "running"

    let probe: i32 = InvariantDynamicBridge(6)
    let probe_log: i32 =
        probe

    let con_044: string@View = "CON-044"
    let con_044_log: string@View =
        con_044

    let runtime_ok: bool =
        (probe_log == 7) &&
        (con_044_log == "CON-044")
    let runtime_ok_log: bool =
        runtime_ok

    let metric: i32 = if (runtime_ok_log == true) { 21 } else { 0 }
    let metric_label: string@View = InvariantDynamicVerificationBridgeMetricLabel(metric)
    let metric_log_actual: string@View =
        metric_label
    if (metric_log_actual != "21") {
        "fail"
        return 1
    }

    "success"
    return 0
}
