[[dynamic]]
procedure ContractElisionPreOnly(value: i32) -> i32
    |: value > 0
{
    return value
}

[[dynamic]]
procedure ContractElisionPostOnly(value: i32) -> i32
    |: => @result == @entry(value) + 1
{
    return value + 1
}

procedure ContractElisionNoClause(value: i32) -> i32 {
    return value + 2
}

procedure ContractElisionDefaultsMetricLabel(value: i32) -> string@View {
    if (value == 28) {
        return "28"
    }
    return "other"
}

public procedure RunContractElisionDefaults(ctx: Context) -> i32 {
    let _ = ctx
    "running"

    let pre_only: i32 = ContractElisionPreOnly(7)
    let post_only: i32 = ContractElisionPostOnly(7)
    let no_clause: i32 = ContractElisionNoClause(7)

    let pre_only_log: i32 =
        pre_only
    let post_only_log: i32 =
        post_only
    let no_clause_log: i32 =
        no_clause

    let con_027: string@View = "CON-027"
    let con_027_log: string@View =
        con_027

    let runtime_ok: bool =
        (pre_only_log == 7) &&
        (post_only_log == 8) &&
        (no_clause_log == 9) &&
        (con_027_log == "CON-027")
    let runtime_ok_log: bool =
        runtime_ok

    let metric: i32 = if (runtime_ok_log == true) { 28 } else { 0 }
    let metric_label: string@View = ContractElisionDefaultsMetricLabel(metric)
    let metric_log_actual: string@View =
        metric_label
    if (metric_log_actual != "28") {
        "fail"
        return 1
    }

    "success"
    return 0
}
