public procedure runGroup(ctx: Context) -> i32 {
    [[log(label: "contracts-log-section_start", expected: "section-start")]] "section-start"

    let status_contract_inheritance_consistency: i32 = RunContractInheritanceConsistency(ctx)
    if (status_contract_inheritance_consistency != 0) {
        [[log(label: "contracts-log-section_end", expected: "section-end")]] "section-end"
        return status_contract_inheritance_consistency
    }

    let status_liskov_postcondition_strengthening: i32 = RunLiskovPostconditionStrengthening(ctx)
    if (status_liskov_postcondition_strengthening != 0) {
        [[log(label: "contracts-log-section_end", expected: "section-end")]] "section-end"
        return status_liskov_postcondition_strengthening
    }

    let status_liskov_precondition_weakening: i32 = RunLiskovPreconditionWeakening(ctx)
    if (status_liskov_precondition_weakening != 0) {
        [[log(label: "contracts-log-section_end", expected: "section-end")]] "section-end"
        return status_liskov_precondition_weakening
    }

    [[log(label: "contracts-log-section_end", expected: "section-end")]] "section-end"
    return 0
}
