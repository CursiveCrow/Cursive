public class LiskovPreconditionSurface {
    procedure Evaluate(~, value: i32) -> i32
        |: value > 0
}

public record LiskovPreconditionModel <: LiskovPreconditionSurface {
    public procedure Evaluate(~, value: i32) -> i32
        |: value >= 0
    {
        return value + 1
    }
}

procedure LiskovPreconditionWeakeningMetricLabel(value: i32) -> string@View {
    if (value == 21) {
        return "21"
    }
    return "other"
}

public procedure RunLiskovPreconditionWeakening(ctx: Context) -> i32 {
    let _ = ctx
    "running"

    let model: LiskovPreconditionModel = LiskovPreconditionModel()
    let observed_value_strict: i32 = model~>Evaluate(9)
    let observed_value_weak: i32 = model~>Evaluate(0)
    let observed_value_strict_log: i32 =
        observed_value_strict
    let observed_value_weak_log: i32 =
        observed_value_weak

    let con_064: string@View = "CON-064"
    let con_064_log: string@View =
        con_064

    let diag_2803: string@View = "E-SEM-2803"
    let diag_2803_log: string@View =
        diag_2803

    let runtime_ok: bool =
        (observed_value_strict_log == 10) &&
        (observed_value_weak_log == 1) &&
        (con_064_log == "CON-064") &&
        (diag_2803_log == "E-SEM-2803")
    let runtime_ok_log: bool =
        runtime_ok

    let metric: i32 = if (runtime_ok_log == true) { 21 } else { 0 }
    let metric_label: string@View = LiskovPreconditionWeakeningMetricLabel(metric)
    let metric_log_actual: string@View =
        metric_label
    if (metric_log_actual != "21") {
        "fail"
        return 1
    }

    "success"
    return 0
}
