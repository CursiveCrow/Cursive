[[dynamic]]
procedure EntryCaptureTimingProbe(value: i32) -> i32
    |: => @result == @entry(value) + 1
{
    let local: i32 = value + 1
    return local
}

procedure EntryCaptureTimingAndDeterminismMetricLabel(value: i32) -> string@View {
    if (value == 35) {
        return "35"
    }
    return "other"
}

public procedure RunEntryCaptureTimingAndDeterminism(ctx: Context) -> i32 {
    let _ = ctx
    [[log(label: "contracts-log-item_begin", expected: "running")]] "running"

    let first: i32 = EntryCaptureTimingProbe(10)
    let second: i32 = EntryCaptureTimingProbe(10)

    let first_log: i32 =
        [[log(label: "observed-contracts-entry-capture-first", expected: 11)]]
        first
    let second_log: i32 =
        [[log(label: "observed-contracts-entry-capture-second", expected: 11)]]
        second

    let deterministic: bool = first_log == second_log
    let deterministic_log: bool =
        [[log(label: "contracts-entry-capture-deterministic", expected: true)]]
        deterministic

    let con_035: string@View = "CON-035"
    let con_035_log: string@View =
        [[log(label: "contracts-entry-capture-feature-035", expected: "CON-035")]]
        con_035

    let runtime_ok: bool =
        (first_log == 11) &&
        (second_log == 11) &&
        (deterministic_log == true) &&
        (con_035_log == "CON-035")
    let runtime_ok_log: bool =
        [[log(label: "contracts-entry-capture-runtime", expected: true)]]
        runtime_ok

    let metric: i32 = if (runtime_ok_log == true) { 35 } else { 0 }
    let metric_label: string@View = EntryCaptureTimingAndDeterminismMetricLabel(metric)
    let metric_log_actual: string@View =
        [[log(label: "observed-contracts-entry-capture-timing-and-determinism-metric", expected: "35")]]
        metric_label
    if (metric_log_actual != "35") {
        [[log(label: "contracts-log-item_fail", expected: "fail")]] "fail"
        return 1
    }

    [[log(label: "contracts-log-item_success", expected: "success")]] "success"
    return 0
}
