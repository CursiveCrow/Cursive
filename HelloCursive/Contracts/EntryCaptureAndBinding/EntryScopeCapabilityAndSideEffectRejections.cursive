[[dynamic]]
procedure EntryScopeBaseline(value: i32) -> i32
    |: => @result == @entry(value)
{
    return value
}

procedure EntryScopeCapabilityAndSideEffectRejectionsMetricLabel(value: i32) -> string@View {
    if (value == 28) {
        return "28"
    }
    return "other"
}

public procedure RunEntryScopeCapabilityAndSideEffectRejections(ctx: Context) -> i32 {
    let _ = ctx
    "running"

    let baseline: i32 = EntryScopeBaseline(10)
    let baseline_log: i32 =
        baseline

    let con_037: string@View = "CON-037"
    let con_038: string@View = "CON-038"
    let con_037_log: string@View =
        con_037
    let con_038_log: string@View =
        con_038

    let diag_2807: string@View = "E-SEM-2807"
    let diag_0415: string@View = "E-CON-0415"
    let diag_0416: string@View = "E-CON-0416"
    let diag_2807_log: string@View =
        diag_2807
    let diag_0415_log: string@View =
        diag_0415
    let diag_0416_log: string@View =
        diag_0416

    let runtime_ok: bool =
        (baseline_log == 10) &&
        (con_037_log == "CON-037") &&
        (con_038_log == "CON-038") &&
        (diag_2807_log == "E-SEM-2807") &&
        (diag_0415_log == "E-CON-0415") &&
        (diag_0416_log == "E-CON-0416")
    let runtime_ok_log: bool =
        runtime_ok

    let metric: i32 = if (runtime_ok_log == true) { 28 } else { 0 }
    let metric_label: string@View = EntryScopeCapabilityAndSideEffectRejectionsMetricLabel(metric)
    let metric_log_actual: string@View =
        metric_label
    if (metric_log_actual != "28") {
        "fail"
        return 1
    }

    "success"
    return 0
}
