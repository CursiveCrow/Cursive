[[dynamic]]
procedure EntryIntrinsicTypingProbe(value: i32) -> i32
    |: => @result == @entry(value) + 1
{
    return value + 1
}

procedure EntryIntrinsicTypingAndRestrictionsMetricLabel(value: i32) -> string@View {
    if (value == 21) {
        return "21"
    }
    return "other"
}

public procedure RunEntryIntrinsicTypingAndRestrictions(ctx: Context) -> i32 {
    let _ = ctx
    [[log(label: "contracts-log-item_begin", expected: "running")]] "running"

    let probe: i32 = EntryIntrinsicTypingProbe(8)
    let probe_log: i32 =
        [[log(label: "observed-contracts-entry-intrinsic-typing-probe", expected: 9)]]
        probe

    let con_034: string@View = "CON-034"
    let con_034_log: string@View =
        [[log(label: "contracts-entry-intrinsic-typing-and-restrictions-feature-034", expected: "CON-034")]]
        con_034

    let diag_2805: string@View = "E-SEM-2805"
    let diag_2805_log: string@View =
        [[log(label: "contracts-entry-intrinsic-typing-and-restrictions-diag-2805", expected: "E-SEM-2805")]]
        diag_2805

    let runtime_ok: bool =
        (probe_log == 9) &&
        (con_034_log == "CON-034") &&
        (diag_2805_log == "E-SEM-2805")
    let runtime_ok_log: bool =
        [[log(label: "contracts-entry-intrinsic-typing-and-restrictions-runtime", expected: true)]]
        runtime_ok

    let metric: i32 = if (runtime_ok_log == true) { 21 } else { 0 }
    let metric_label: string@View = EntryIntrinsicTypingAndRestrictionsMetricLabel(metric)
    let metric_log_actual: string@View =
        [[log(label: "observed-contracts-entry-intrinsic-typing-and-restrictions-metric", expected: "21")]]
        metric_label
    if (metric_log_actual != "21") {
        [[log(label: "contracts-log-item_fail", expected: "fail")]] "fail"
        return 1
    }

    [[log(label: "contracts-log-item_success", expected: "success")]] "success"
    return 0
}
