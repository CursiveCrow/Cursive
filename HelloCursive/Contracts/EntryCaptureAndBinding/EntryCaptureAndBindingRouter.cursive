public procedure runGroup(ctx: Context) -> i32 {
    "section-start"

    let status_entry_capture_copy_clone_semantics: i32 = RunEntryCaptureCopyCloneSemantics(ctx)
    if (status_entry_capture_copy_clone_semantics != 0) {
        "section-end"
        return status_entry_capture_copy_clone_semantics
    }

    let status_entry_capture_timing_and_determinism: i32 = RunEntryCaptureTimingAndDeterminism(ctx)
    if (status_entry_capture_timing_and_determinism != 0) {
        "section-end"
        return status_entry_capture_timing_and_determinism
    }

    let status_entry_intrinsic_typing_and_restrictions: i32 = RunEntryIntrinsicTypingAndRestrictions(ctx)
    if (status_entry_intrinsic_typing_and_restrictions != 0) {
        "section-end"
        return status_entry_intrinsic_typing_and_restrictions
    }

    let status_entry_scope_capability_and_side_effect_rejections: i32 = RunEntryScopeCapabilityAndSideEffectRejections(ctx)
    if (status_entry_scope_capability_and_side_effect_rejections != 0) {
        "section-end"
        return status_entry_scope_capability_and_side_effect_rejections
    }

    "section-end"
    return 0
}
