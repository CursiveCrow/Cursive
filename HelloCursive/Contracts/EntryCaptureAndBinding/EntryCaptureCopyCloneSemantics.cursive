[[dynamic]]
procedure EntryCaptureBitcopyProbe(value: i32) -> i32
    |: => @result == @entry(value)
{
    return value
}

procedure EntryCaptureCopyCloneSemanticsMetricLabel(value: i32) -> string@View {
    if (value == 21) {
        return "21"
    }
    return "other"
}

public procedure RunEntryCaptureCopyCloneSemantics(ctx: Context) -> i32 {
    let _ = ctx
    "running"

    let bitcopy_probe: i32 = EntryCaptureBitcopyProbe(12)
    let bitcopy_probe_log: i32 =
        bitcopy_probe

    let copy_path_ok: bool = bitcopy_probe_log == 12
    let clone_path_ok: bool = true
    let copy_path_ok_log: bool =
        copy_path_ok
    let clone_path_ok_log: bool =
        clone_path_ok

    let con_036: string@View = "CON-036"
    let con_036_log: string@View =
        con_036

    let runtime_ok: bool =
        (copy_path_ok_log == true) &&
        (clone_path_ok_log == true) &&
        (con_036_log == "CON-036")
    let runtime_ok_log: bool =
        runtime_ok

    let metric: i32 = if (runtime_ok_log == true) { 21 } else { 0 }
    let metric_label: string@View = EntryCaptureCopyCloneSemanticsMetricLabel(metric)
    let metric_log_actual: string@View =
        metric_label
    if (metric_log_actual != "21") {
        "fail"
        return 1
    }

    "success"
    return 0
}
