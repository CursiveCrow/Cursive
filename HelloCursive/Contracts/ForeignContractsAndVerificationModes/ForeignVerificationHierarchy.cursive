[[mangle("hc_contracts_foreign_hierarchy_static_impl"), export("C-unwind")]]
public procedure ContractsForeignHierarchyStaticImpl(value: i32) -> i32 {
    let _ = value
    return -1
}

[[mangle("hc_contracts_foreign_hierarchy_dynamic_impl"), export("C-unwind")]]
public procedure ContractsForeignHierarchyDynamicImpl(value: i32) -> i32 {
    let _ = value
    return -1
}

[[mangle("hc_contracts_foreign_hierarchy_default_impl"), export("C-unwind")]]
public procedure ContractsForeignHierarchyDefaultImpl(value: i32) -> i32 {
    let _ = value
    return -1
}

extern "C" {
    procedure hc_contracts_foreign_hierarchy_static_impl(value: i32) -> i32
        |: @foreign_ensures(@result >= 0)
}

extern "C" {
    [[dynamic]]
    procedure hc_contracts_foreign_hierarchy_dynamic_impl(value: i32) -> i32
        |: @foreign_ensures(@result >= 0)
}

extern "C" {
    procedure hc_contracts_foreign_hierarchy_default_impl(value: i32) -> i32
        |: @foreign_ensures(@result >= 0)
}

[[dynamic, mangle("hc_contracts_foreign_hierarchy_dynamic_catch"), export("C-unwind"), unwind("catch")]]
public procedure ContractsForeignHierarchyDynamicCatch() -> i32 {
    let _panic: i32 = unsafe { hc_contracts_foreign_hierarchy_dynamic_impl(2) }
    return _panic
}

extern "C" {
    procedure hc_contracts_foreign_hierarchy_dynamic_catch() -> i32
}

procedure ForeignVerificationHierarchyMetricLabel(value: i32) -> string@View {
    if (value == 28) {
        return "28"
    }
    return "other"
}

public procedure RunForeignVerificationHierarchy(ctx: Context) -> i32 {
    let _ = ctx
    "running"

    let static_value: i32 = unsafe { hc_contracts_foreign_hierarchy_static_impl(2) }
    let default_value: i32 = unsafe { hc_contracts_foreign_hierarchy_default_impl(2) }
    let dynamic_panic_catch_metric: i32 = unsafe {
        hc_contracts_foreign_hierarchy_dynamic_catch()
    }

    let static_value_is_negative_log: bool =
        static_value < 0
    let default_value_is_negative_log: bool =
        default_value < 0
    let dynamic_panic_catch_metric_log: i32 =
        dynamic_panic_catch_metric

    let static_mode_skips_runtime_check: bool = static_value_is_negative_log == true
    let dynamic_mode_enforces_runtime_check: bool = dynamic_panic_catch_metric_log == 0
    let default_mode_skips_runtime_check: bool = default_value_is_negative_log == true
    let static_mode_skips_runtime_check_log: bool =
        static_mode_skips_runtime_check
    let dynamic_mode_enforces_runtime_check_log: bool =
        dynamic_mode_enforces_runtime_check
    let default_mode_skips_runtime_check_log: bool =
        default_mode_skips_runtime_check

    let con_072: string@View = "CON-072"
    let con_074: string@View = "CON-074"
    let con_072_log: string@View =
        con_072
    let con_074_log: string@View =
        con_074

    let runtime_ok: bool =
        (static_value_is_negative_log == true) &&
        (dynamic_panic_catch_metric_log == 0) &&
        (default_value_is_negative_log == true) &&
        (static_mode_skips_runtime_check_log == true) &&
        (dynamic_mode_enforces_runtime_check_log == true) &&
        (default_mode_skips_runtime_check_log == true) &&
        (con_072_log == "CON-072") &&
        (con_074_log == "CON-074")
    let runtime_ok_log: bool =
        runtime_ok

    let metric: i32 = if (runtime_ok_log == true) { 28 } else { 0 }
    let metric_label: string@View = ForeignVerificationHierarchyMetricLabel(metric)
    let metric_log_actual: string@View =
        metric_label
    if (metric_log_actual != "28") {
        "fail"
        return 1
    }

    "success"
    return 0
}
