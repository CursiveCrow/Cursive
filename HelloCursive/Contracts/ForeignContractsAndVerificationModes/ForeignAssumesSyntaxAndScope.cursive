[[mangle("hc_contracts_foreign_assumes_probe_impl"), export("C")]]
public procedure ContractsForeignAssumesProbeImpl(value: i32) -> i32 {
    return value + 10
}

extern "C" {
    procedure hc_contracts_foreign_assumes_probe_impl(value: i32) -> i32
        |: @foreign_assumes(value >= 0)
}

procedure ForeignAssumesSyntaxAndScopeMetricLabel(value: i32) -> string@View {
    if (value == 40) {
        return "40"
    }
    return "other"
}

public procedure RunForeignAssumesSyntaxAndScope(ctx: Context) -> i32 {
    let _ = ctx
    "running"

    let observed_value: i32 = unsafe { hc_contracts_foreign_assumes_probe_impl(3) }
    let observed_value_log: i32 =
        observed_value

    let con_067: string@View = "CON-067"
    let con_067_log: string@View =
        con_067

    let diag_2850: string@View = "E-SEM-2850"
    let diag_2851: string@View = "E-SEM-2851"
    let diag_2852: string@View = "E-SEM-2852"
    let diag_2850_log: string@View =
        diag_2850
    let diag_2851_log: string@View =
        diag_2851
    let diag_2852_log: string@View =
        diag_2852

    let runtime_ok: bool =
        (observed_value_log == 13) &&
        (con_067_log == "CON-067") &&
        (diag_2850_log == "E-SEM-2850") &&
        (diag_2851_log == "E-SEM-2851") &&
        (diag_2852_log == "E-SEM-2852")
    let runtime_ok_log: bool =
        runtime_ok

    let metric: i32 = if (runtime_ok_log == true) { 40 } else { 0 }
    let metric_label: string@View = ForeignAssumesSyntaxAndScopeMetricLabel(metric)
    let metric_log_actual: string@View =
        metric_label
    if (metric_log_actual != "40") {
        "fail"
        return 1
    }

    "success"
    return 0
}
