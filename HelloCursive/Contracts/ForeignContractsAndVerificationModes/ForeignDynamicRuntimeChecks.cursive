extern "C" {
    [[dynamic]]
    procedure hc_contracts_foreign_dynamic_runtime_impl(value: i32) -> i32
        |: @foreign_assumes(value >= 0)
        |: @foreign_ensures(@result >= 0)
}

extern "C" {
    [[dynamic]]
    procedure hc_contracts_foreign_dynamic_runtime_fail_impl(value: i32) -> i32
        |: @foreign_ensures(@result >= 0)
}

extern "C" {
    [[dynamic]]
    procedure hc_contracts_foreign_dynamic_runtime_ptr_impl(ptr: *imm i32, mode: i32) -> *imm i32
        |: @foreign_ensures(@error: @result == null)
        |: @foreign_ensures(@null_result: @result == null)
}

extern "C" {
    [[dynamic]]
    procedure hc_contracts_foreign_dynamic_runtime_ptr_fail_impl(ptr: *imm i32, mode: i32) -> *imm i32
        |: @foreign_ensures(@error: @result == null)
        |: @foreign_ensures(@null_result: @result != null)
}

