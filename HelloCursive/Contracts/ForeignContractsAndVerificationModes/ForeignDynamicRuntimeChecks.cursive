procedure ForeignDynamicRuntimeChecksMetricLabel(value: i32) -> string@View {
    if (value == 21) {
        return "21"
    }
    return "other"
}

public procedure RunForeignDynamicRuntimeChecks(ctx: Context) -> i32 {
    "running"

    let seed_value: i32 = 41
    let seed_ptr_safe: Ptr<i32>@Valid = &seed_value
    let seed_ptr_raw: *imm i32 = unsafe { transmute<Ptr<i32>@Valid, *imm i32>(seed_ptr_safe) }

    let observed_value: i32 = unsafe { hc_contracts_foreign_dynamic_runtime_impl(5) }
    let panic_catch_metric: i32 = unsafe {
        hc_contracts_foreign_dynamic_runtime_fail_catch()
    }
    let ptr_no_panic_metric: i32 = unsafe {
        hc_contracts_foreign_dynamic_runtime_ptr_no_panic_catch(seed_ptr_raw)
    }
    let ptr_fail_panic_metric: i32 = unsafe {
        hc_contracts_foreign_dynamic_runtime_ptr_fail_catch(seed_ptr_raw)
    }

    let observed_value_log: i32 =
        observed_value
    let panic_catch_metric_log: i32 =
        panic_catch_metric
    let ptr_no_panic_metric_log: i32 =
        ptr_no_panic_metric
    let ptr_fail_panic_metric_log: i32 =
        ptr_fail_panic_metric

    let dynamic_success_path: bool = observed_value_log >= 0
    let dynamic_failure_path: bool = panic_catch_metric_log == 0
    let dynamic_null_err_cond_and_null_cond_path: bool = ptr_no_panic_metric_log == 17
    let dynamic_null_result_failure_path: bool = ptr_fail_panic_metric_log == 0
    let dynamic_success_path_log: bool =
        dynamic_success_path
    let dynamic_failure_path_log: bool =
        dynamic_failure_path
    let dynamic_null_err_cond_and_null_cond_path_log: bool =
        dynamic_null_err_cond_and_null_cond_path
    let dynamic_null_result_failure_path_log: bool =
        dynamic_null_result_failure_path

    let con_073: string@View = "CON-073"
    let con_073_log: string@View =
        con_073

    let panic_2861: string@View = "P-SEM-2861"
    let panic_2861_log: string@View =
        panic_2861

    let runtime_ok: bool =
        (observed_value_log == 9) &&
        (panic_catch_metric_log == 0) &&
        (ptr_no_panic_metric_log == 17) &&
        (ptr_fail_panic_metric_log == 0) &&
        (dynamic_success_path_log == true) &&
        (dynamic_failure_path_log == true) &&
        (dynamic_null_err_cond_and_null_cond_path_log == true) &&
        (dynamic_null_result_failure_path_log == true) &&
        (con_073_log == "CON-073") &&
        (panic_2861_log == "P-SEM-2861")
    let runtime_ok_log: bool =
        runtime_ok

    let metric: i32 = if (runtime_ok_log == true) { 21 } else { 0 }
    let metric_label: string@View = ForeignDynamicRuntimeChecksMetricLabel(metric)
    let metric_log_actual: string@View =
        metric_label
    if (metric_log_actual != "21") {
        "fail"
        return 1
    }

    "success"
    return 0
}
