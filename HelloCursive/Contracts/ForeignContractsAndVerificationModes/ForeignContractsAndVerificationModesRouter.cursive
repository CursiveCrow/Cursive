public procedure runGroup(ctx: Context) -> i32 {
    "section-start"

    let status_foreign_assume_mode: i32 = RunForeignAssumeModeSemantics(ctx)
    if (status_foreign_assume_mode != 0) {
        "section-end"
        return status_foreign_assume_mode
    }

    let status_foreign_assumes_syntax_and_scope: i32 = RunForeignAssumesSyntaxAndScope(ctx)
    if (status_foreign_assumes_syntax_and_scope != 0) {
        "section-end"
        return status_foreign_assumes_syntax_and_scope
    }

    let status_foreign_assumes_verification_modes: i32 = RunForeignAssumesVerificationModes(ctx)
    if (status_foreign_assumes_verification_modes != 0) {
        "section-end"
        return status_foreign_assumes_verification_modes
    }

    let status_foreign_dynamic_runtime_checks: i32 = RunForeignDynamicRuntimeChecks(ctx)
    if (status_foreign_dynamic_runtime_checks != 0) {
        "section-end"
        return status_foreign_dynamic_runtime_checks
    }

    let status_foreign_ensures_classification_and_obligations: i32 = RunForeignEnsuresClassificationAndObligations(ctx)
    if (status_foreign_ensures_classification_and_obligations != 0) {
        "section-end"
        return status_foreign_ensures_classification_and_obligations
    }

    let status_foreign_ensures_predicate_forms: i32 = RunForeignEnsuresPredicateForms(ctx)
    if (status_foreign_ensures_predicate_forms != 0) {
        "section-end"
        return status_foreign_ensures_predicate_forms
    }

    let status_foreign_ensures_type_restrictions: i32 = RunForeignEnsuresTypeRestrictions(ctx)
    if (status_foreign_ensures_type_restrictions != 0) {
        "section-end"
        return status_foreign_ensures_type_restrictions
    }

    let status_foreign_verification_hierarchy: i32 = RunForeignVerificationHierarchy(ctx)
    if (status_foreign_verification_hierarchy != 0) {
        "section-end"
        return status_foreign_verification_hierarchy
    }

    "section-end"
    return 0
}
