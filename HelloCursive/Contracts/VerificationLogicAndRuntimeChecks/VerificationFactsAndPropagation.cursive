type NonNegativeFact = i32 |: { self >= 0 }
procedure VerificationFactsSeed() -> i32 {
    return 7
}

[[dynamic]]
procedure VerificationFactDynamicPrecheck(value: i32) -> i32
    |: value >= 0 => @result > 0
{
    return value + 1
}

procedure VerificationFactsAndPropagationMetricLabel(value: i32) -> string@View {
    if (value == 42) {
        return "42"
    }
    return "other"
}

[[dynamic]]
public procedure RunVerificationFactsAndPropagation(ctx: Context) -> i32 {
    let _ = ctx
    [[log(label: "contracts-log-item_begin", expected: "running")]] "running"

    let seed_unknown: i32 = VerificationFactsSeed()
    let seed_unknown_log: i32 =
        [[log(label: "observed-contracts-verification-facts-seed", expected: 7)]]
        seed_unknown

    let narrowed_from_control_flow: i32 = if (seed_unknown >= 0) {
        let narrowed_non_negative: NonNegativeFact = seed_unknown
        let narrowed_non_negative_log: i32 =
            [[log(label: "observed-contracts-verification-facts-control-flow-narrowed", expected: 7)]]
            narrowed_non_negative
        narrowed_non_negative_log
    } else {
        0
    }

    let dynamically_checked: i32 = VerificationFactDynamicPrecheck(seed_unknown)
    let dynamically_checked_log: i32 =
        [[log(label: "observed-contracts-verification-facts-dynamic-check", expected: 8)]]
        dynamically_checked

    let dynamic_fact_positive: bool = dynamically_checked > 0
    let dynamic_fact_positive_log: bool =
        [[log(label: "contracts-verification-facts-dynamic-positive", expected: true)]]
        dynamic_fact_positive

    var loop_index: i32 = 0
    loop loop_index < 3 |: { loop_index >= 0 && loop_index <= 3 } {
        loop_index = loop_index + 1
    }
    let loop_exit_fact: bool = loop_index == 3

    let fact_non_negative_log: bool =
        [[log(label: "contracts-verification-facts-non-negative", expected: true)]]
        seed_unknown >= 0
    let loop_exit_fact_log: bool =
        [[log(label: "contracts-verification-facts-loop-exit", expected: true)]]
        loop_exit_fact

    let con_054: string@View = "CON-054"
    let con_055: string@View = "CON-055"
    let con_056: string@View = "CON-056"
    let con_057: string@View = "CON-057"
    let con_054_log: string@View =
        [[log(label: "contracts-verification-facts-and-propagation-feature-054", expected: "CON-054")]]
        con_054
    let con_055_log: string@View =
        [[log(label: "contracts-verification-facts-and-propagation-feature-055", expected: "CON-055")]]
        con_055
    let con_056_log: string@View =
        [[log(label: "contracts-verification-facts-and-propagation-feature-056", expected: "CON-056")]]
        con_056
    let con_057_log: string@View =
        [[log(label: "contracts-verification-facts-and-propagation-feature-057", expected: "CON-057")]]
        con_057

    let runtime_ok: bool =
        (seed_unknown_log == 7) &&
        (narrowed_from_control_flow == 7) &&
        (dynamically_checked_log == 8) &&
        (dynamic_fact_positive_log == true) &&
        (fact_non_negative_log == true) &&
        (loop_exit_fact_log == true) &&
        (con_054_log == "CON-054") &&
        (con_055_log == "CON-055") &&
        (con_056_log == "CON-056") &&
        (con_057_log == "CON-057")
    let runtime_ok_log: bool =
        [[log(label: "contracts-verification-facts-and-propagation-runtime", expected: true)]]
        runtime_ok

    let metric: i32 = if (runtime_ok_log == true) { 42 } else { 0 }
    let metric_label: string@View = VerificationFactsAndPropagationMetricLabel(metric)
    let metric_log_actual: string@View =
        [[log(label: "observed-contracts-verification-facts-and-propagation-metric", expected: "42")]]
        metric_label
    if (metric_log_actual != "42") {
        [[log(label: "contracts-log-item_fail", expected: "fail")]] "fail"
        return 1
    }

    [[log(label: "contracts-log-item_success", expected: "success")]] "success"
    return 0
}
