type PositiveRefinementProbe = i32 |: { self > 0 }

[[dynamic]]
procedure RefinementContractProbe(value: i32) -> i32
    |: => @result > 0
{
    return value + 1
}

procedure RefinementContractCheckIntegrationMetricLabel(value: i32) -> string@View {
    if (value == 21) {
        return "21"
    }
    return "other"
}

public procedure RunRefinementContractCheckIntegration(ctx: Context) -> i32 {
    let _ = ctx
    [[log(label: "contracts-log-item_begin", expected: "running")]] "running"

    let refined_value: PositiveRefinementProbe = 4
    let probe: i32 = RefinementContractProbe(refined_value)
    let probe_log: i32 =
        [[log(label: "observed-contracts-refinement-contract-probe", expected: 5)]]
        probe

    let con_063: string@View = "CON-063"
    let con_063_log: string@View =
        [[log(label: "contracts-refinement-contract-check-integration-feature-063", expected: "CON-063")]]
        con_063

    let runtime_ok: bool =
        (probe_log == 5) &&
        (con_063_log == "CON-063")
    let runtime_ok_log: bool =
        [[log(label: "contracts-refinement-contract-check-integration-runtime", expected: true)]]
        runtime_ok

    let metric: i32 = if (runtime_ok_log == true) { 21 } else { 0 }
    let metric_label: string@View = RefinementContractCheckIntegrationMetricLabel(metric)
    let metric_log_actual: string@View =
        [[log(label: "observed-contracts-refinement-contract-check-integration-metric", expected: "21")]]
        metric_label
    if (metric_log_actual != "21") {
        [[log(label: "contracts-log-item_fail", expected: "fail")]] "fail"
        return 1
    }

    [[log(label: "contracts-log-item_success", expected: "success")]] "success"
    return 0
}
