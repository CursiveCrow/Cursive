[[dynamic]]
procedure VerificationLocationPreProbe(value: i32) -> i32
    |: value >= 0
{
    return value + 2
}

[[dynamic]]
procedure VerificationLocationPostProbe(value: i32) -> i32
    |: => @result >= 0
{
    return value
}

[[dynamic]]
procedure VerificationLocationLoopProbe(limit: i32) -> i32 {
    var index: i32 = 0
    loop index < limit |: { index >= 0 && index <= limit } {
        index = index + 1
    }
    return index
}

[[dynamic, mangle("hc_contracts_verification_location_pre_catch"), export("C-unwind"), unwind("catch")]]
public procedure VerificationLocationPreCatch() -> i32 {
    let _panic: i32 = VerificationLocationPreProbe(-1)
    return _panic
}

[[dynamic, mangle("hc_contracts_verification_location_post_catch"), export("C-unwind"), unwind("catch")]]
public procedure VerificationLocationPostCatch() -> i32 {
    let _panic: i32 = VerificationLocationPostProbe(-1)
    return _panic
}

extern "C" {
    procedure hc_contracts_verification_location_pre_catch() -> i32
    procedure hc_contracts_verification_location_post_catch() -> i32
}

procedure VerificationLocationsAndContextsMetricLabel(value: i32) -> string@View {
    if (value == 21) {
        return "21"
    }
    return "other"
}

public procedure RunVerificationLocationsAndContexts(ctx: Context) -> i32 {
    let _ = ctx
    "running"

    let value_a: i32 = VerificationLocationPreProbe(5)
    let value_b: i32 = VerificationLocationPostProbe(6)
    let loop_value: i32 = VerificationLocationLoopProbe(3)

    let pre_check_panic_catch_metric: i32 = unsafe {
        hc_contracts_verification_location_pre_catch()
    }
    let post_check_panic_catch_metric: i32 = unsafe {
        hc_contracts_verification_location_post_catch()
    }

    let value_a_log: i32 =
        value_a
    let value_b_log: i32 =
        value_b
    let loop_value_log: i32 =
        loop_value
    let pre_check_panic_catch_metric_log: i32 =
        pre_check_panic_catch_metric
    let post_check_panic_catch_metric_log: i32 =
        post_check_panic_catch_metric

    let call_site_check_enforced: bool = pre_check_panic_catch_metric_log == 0
    let definition_site_check_enforced: bool = post_check_panic_catch_metric_log == 0
    let enforcement_point_check_enforced: bool = loop_value_log == 3

    let call_site_check_enforced_log: bool =
        call_site_check_enforced
    let definition_site_check_enforced_log: bool =
        definition_site_check_enforced
    let enforcement_point_check_enforced_log: bool =
        enforcement_point_check_enforced

    let con_052: string@View = "CON-052"
    let con_052_log: string@View =
        con_052

    let runtime_ok: bool =
        (value_a_log == 7) &&
        (value_b_log == 6) &&
        (loop_value_log == 3) &&
        (pre_check_panic_catch_metric_log == 0) &&
        (post_check_panic_catch_metric_log == 0) &&
        (call_site_check_enforced_log == true) &&
        (definition_site_check_enforced_log == true) &&
        (enforcement_point_check_enforced_log == true) &&
        (con_052_log == "CON-052")
    let runtime_ok_log: bool =
        runtime_ok

    let metric: i32 = if (runtime_ok_log == true) { 21 } else { 0 }
    let metric_label: string@View = VerificationLocationsAndContextsMetricLabel(metric)
    let metric_log_actual: string@View =
        metric_label
    if (metric_log_actual != "21") {
        "fail"
        return 1
    }

    "success"
    return 0
}
