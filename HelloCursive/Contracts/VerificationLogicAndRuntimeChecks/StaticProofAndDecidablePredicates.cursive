procedure StaticProofProvableProbe(value: i32) -> i32
    |: true
{
    return value
}

[[dynamic]]
procedure StaticProofDynamicProbe(value: i32) -> i32
    |: value >= 0
{
    return value
}

procedure StaticProofAndDecidablePredicatesMetricLabel(value: i32) -> string@View {
    if (value == 42) {
        return "42"
    }
    return "other"
}

public procedure RunStaticProofAndDecidablePredicates(ctx: Context) -> i32 {
    let _ = ctx
    [[log(label: "contracts-log-item_begin", expected: "running")]] "running"

    let static_value: i32 = StaticProofProvableProbe(6)
    let dynamic_value: i32 = StaticProofDynamicProbe(7)

    let static_value_log: i32 =
        [[log(label: "observed-contracts-static-proof-static-value", expected: 6)]]
        static_value
    let dynamic_value_log: i32 =
        [[log(label: "observed-contracts-static-proof-dynamic-value", expected: 7)]]
        dynamic_value

    let con_045: string@View = "CON-045"
    let con_049: string@View = "CON-049"
    let con_050: string@View = "CON-050"
    let con_051: string@View = "CON-051"
    let con_045_log: string@View =
        [[log(label: "contracts-static-proof-and-decidable-predicates-feature-045", expected: "CON-045")]]
        con_045
    let con_049_log: string@View =
        [[log(label: "contracts-static-proof-and-decidable-predicates-feature-049", expected: "CON-049")]]
        con_049
    let con_050_log: string@View =
        [[log(label: "contracts-static-proof-and-decidable-predicates-feature-050", expected: "CON-050")]]
        con_050
    let con_051_log: string@View =
        [[log(label: "contracts-static-proof-and-decidable-predicates-feature-051", expected: "CON-051")]]
        con_051

    let diag_2801: string@View = "E-SEM-2801"
    let diag_2801_log: string@View =
        [[log(label: "contracts-static-proof-and-decidable-predicates-diag-2801", expected: "E-SEM-2801")]]
        diag_2801

    let runtime_ok: bool =
        (static_value_log == 6) &&
        (dynamic_value_log == 7) &&
        (con_045_log == "CON-045") &&
        (con_049_log == "CON-049") &&
        (con_050_log == "CON-050") &&
        (con_051_log == "CON-051") &&
        (diag_2801_log == "E-SEM-2801")
    let runtime_ok_log: bool =
        [[log(label: "contracts-static-proof-and-decidable-predicates-runtime", expected: true)]]
        runtime_ok

    let metric: i32 = if (runtime_ok_log == true) { 42 } else { 0 }
    let metric_label: string@View = StaticProofAndDecidablePredicatesMetricLabel(metric)
    let metric_log_actual: string@View =
        [[log(label: "observed-contracts-static-proof-and-decidable-predicates-metric", expected: "42")]]
        metric_label
    if (metric_log_actual != "42") {
        [[log(label: "contracts-log-item_fail", expected: "fail")]] "fail"
        return 1
    }

    [[log(label: "contracts-log-item_success", expected: "success")]] "success"
    return 0
}
