[[mangle("hc_contracts_foreign_parse_assumes_impl"), export("C")]]
public procedure ContractsForeignParseAssumesImpl(value: i32) -> i32 {
    return value + 1
}

[[mangle("hc_contracts_foreign_parse_ensures_impl"), export("C")]]
public procedure ContractsForeignParseEnsuresImpl(value: i32) -> i32 {
    return value + 2
}

extern "C" {
    procedure hc_contracts_foreign_parse_assumes_impl(value: i32) -> i32
        |: @foreign_assumes((value >= 0) && (value <= 100))

    procedure hc_contracts_foreign_parse_ensures_impl(value: i32) -> i32
        |: @foreign_ensures(@result >= 0)
        |: @foreign_ensures(@error: @result < 0)
}

procedure ForeignContractParsingMetricLabel(value: i32) -> string@View {
    if (value == 46) {
        return "46"
    }
    return "other"
}

public procedure RunForeignContractParsing(ctx: Context) -> i32 {
    let _ = ctx
    "running"

    let assumes_value: i32 = unsafe { hc_contracts_foreign_parse_assumes_impl(7) }
    let ensures_value: i32 = unsafe { hc_contracts_foreign_parse_ensures_impl(8) }

    let assumes_value_log: i32 =
        assumes_value
    let ensures_value_log: i32 =
        ensures_value

    let con_008: string@View = "CON-008"
    let con_009: string@View = "CON-009"
    let con_008_log: string@View =
        con_008
    let con_009_log: string@View =
        con_009

    let runtime_ok: bool =
        (assumes_value_log == 8) &&
        (ensures_value_log == 10) &&
        (con_008_log == "CON-008") &&
        (con_009_log == "CON-009")
    let runtime_ok_log: bool =
        runtime_ok

    let metric: i32 = if (runtime_ok_log == true) { 46 } else { 0 }
    let metric_label: string@View = ForeignContractParsingMetricLabel(metric)
    let metric_log_actual: string@View =
        metric_label
    if (metric_log_actual != "46") {
        "fail"
        return 1
    }

    "success"
    return 0
}
