let ContractResolutionFloor: i32 = 3
let ContractResolutionBias: i32 = 2

procedure ContractResolutionStep(value: i32) -> i32 {
    return value + ContractResolutionBias
}

[[dynamic]]
procedure ContractResolutionProbe(value: i32) -> i32
    |: => @result == ContractResolutionStep(@entry(value))
{
    return ContractResolutionStep(value)
}

[[mangle("hc_contracts_resolution_foreign_impl"), export("C")]]
public procedure ContractsResolutionForeignImpl(value: i32) -> i32 {
    return value + ContractResolutionBias
}

extern "C" {
    procedure hc_contracts_resolution_foreign_impl(value: i32) -> i32
        |: @foreign_assumes(value >= 3)
        |: @foreign_ensures(@result >= ContractResolutionFloor)
}

procedure ContractResolutionScopesMetricLabel(value: i32) -> string@View {
    if (value == 45) {
        return "45"
    }
    return "other"
}

public procedure RunContractResolutionScopes(ctx: Context) -> i32 {
    let _ = ctx
    [[log(label: "contracts-log-item_begin", expected: "running")]] "running"

    let local_probe: i32 = ContractResolutionProbe(7)
    let local_probe_log: i32 =
        [[log(label: "observed-contracts-resolution-local-probe", expected: 9)]]
        local_probe

    let foreign_probe: i32 = unsafe { hc_contracts_resolution_foreign_impl(8) }
    let foreign_probe_log: i32 =
        [[log(label: "observed-contracts-resolution-foreign-probe", expected: 10)]]
        foreign_probe

    let con_010: string@View = "CON-010"
    let con_011: string@View = "CON-011"
    let con_012: string@View = "CON-012"
    let con_010_log: string@View =
        [[log(label: "contracts-contract-resolution-feature-010", expected: "CON-010")]]
        con_010
    let con_011_log: string@View =
        [[log(label: "contracts-contract-resolution-feature-011", expected: "CON-011")]]
        con_011
    let con_012_log: string@View =
        [[log(label: "contracts-contract-resolution-feature-012", expected: "CON-012")]]
        con_012

    let runtime_ok: bool =
        (local_probe_log == 9) &&
        (foreign_probe_log == 10) &&
        (con_010_log == "CON-010") &&
        (con_011_log == "CON-011") &&
        (con_012_log == "CON-012")
    let runtime_ok_log: bool =
        [[log(label: "contracts-contract-resolution-scopes-runtime", expected: true)]]
        runtime_ok

    let metric: i32 = if (runtime_ok_log == true) { 45 } else { 0 }
    let metric_label: string@View = ContractResolutionScopesMetricLabel(metric)
    let metric_log_actual: string@View =
        [[log(label: "observed-contracts-contract-resolution-scopes-metric", expected: "45")]]
        metric_label
    if (metric_log_actual != "45") {
        [[log(label: "contracts-log-item_fail", expected: "fail")]] "fail"
        return 1
    }

    [[log(label: "contracts-log-item_success", expected: "success")]] "success"
    return 0
}
