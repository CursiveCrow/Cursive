[[dynamic]]
procedure ContractClauseParsePreOnly(value: i32) -> i32
    |: value >= 0
{
    return value
}

[[dynamic]]
procedure ContractClauseParsePostOnly(value: i32) -> i32
    |: => @result == @entry(value) + 1
{
    return value + 1
}

[[dynamic]]
procedure ContractClauseParsePrePost(value: i32) -> i32
    |: value >= 0 => @result >= 0
{
    return value + 2
}

procedure ContractClauseParseNoClause(value: i32) -> i32 {
    return value + 3
}

procedure ContractClauseParsingMetricLabel(value: i32) -> string@View {
    if (value == 37) {
        return "37"
    }
    return "other"
}

public procedure RunContractClauseParsing(ctx: Context) -> i32 {
    let _ = ctx
    "running"

    let pre_only: i32 = ContractClauseParsePreOnly(4)
    let post_only: i32 = ContractClauseParsePostOnly(4)
    let pre_post: i32 = ContractClauseParsePrePost(4)
    let no_clause: i32 = ContractClauseParseNoClause(4)

    let pre_only_log: i32 =
        pre_only
    let post_only_log: i32 =
        post_only
    let pre_post_log: i32 =
        pre_post
    let no_clause_log: i32 =
        no_clause

    let con_007: string@View = "CON-007"
    let con_007_log: string@View =
        con_007

    let runtime_ok: bool =
        (pre_only_log == 4) &&
        (post_only_log == 5) &&
        (pre_post_log == 6) &&
        (no_clause_log == 7) &&
        (con_007_log == "CON-007")
    let runtime_ok_log: bool =
        runtime_ok

    let metric: i32 = if (runtime_ok_log == true) { 37 } else { 0 }
    let metric_label: string@View = ContractClauseParsingMetricLabel(metric)
    let metric_log_actual: string@View =
        metric_label
    if (metric_log_actual != "37") {
        "fail"
        return 1
    }

    "success"
    return 0
}
