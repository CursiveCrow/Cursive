public procedure runGroup(ctx: Context) -> i32 {
    "section-start"

    let status_contract_ast_forms: i32 = RunContractAstForms(ctx)
    if (status_contract_ast_forms != 0) {
        "section-end"
        return status_contract_ast_forms
    }

    let status_contract_clause_grammar_placement: i32 = RunContractClauseGrammarPlacement(ctx)
    if (status_contract_clause_grammar_placement != 0) {
        "section-end"
        return status_contract_clause_grammar_placement
    }

    let status_contract_clause_parsing: i32 = RunContractClauseParsing(ctx)
    if (status_contract_clause_parsing != 0) {
        "section-end"
        return status_contract_clause_parsing
    }

    let status_contract_resolution_scopes: i32 = RunContractResolutionScopes(ctx)
    if (status_contract_resolution_scopes != 0) {
        "section-end"
        return status_contract_resolution_scopes
    }

    let status_dynamic_attribute_scope_and_placement: i32 = RunDynamicAttributeScopeAndPlacement(ctx)
    if (status_dynamic_attribute_scope_and_placement != 0) {
        "section-end"
        return status_dynamic_attribute_scope_and_placement
    }

    let status_foreign_contract_parsing: i32 = RunForeignContractParsing(ctx)
    if (status_foreign_contract_parsing != 0) {
        "section-end"
        return status_foreign_contract_parsing
    }

    "section-end"
    return 0
}
