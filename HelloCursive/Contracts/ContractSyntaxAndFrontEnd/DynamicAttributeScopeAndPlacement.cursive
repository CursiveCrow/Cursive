[[dynamic]]
procedure DynamicScopeProbe(value: i32) -> i32
    |: => @result == @entry(value) + 1
{
    return value + 1
}

procedure DynamicScopeCaller(value: i32) -> i32 {
    return DynamicScopeProbe(value)
}

procedure DynamicAttributeScopeAndPlacementMetricLabel(value: i32) -> string@View {
    if (value == 63) {
        return "63"
    }
    return "other"
}

public procedure RunDynamicAttributeScopeAndPlacement(ctx: Context) -> i32 {
    let _ = ctx
    "running"

    let direct_value: i32 = DynamicScopeProbe(4)
    let caller_value: i32 = DynamicScopeCaller(5)

    let direct_value_log: i32 =
        direct_value
    let caller_value_log: i32 =
        caller_value

    let con_013: string@View = "CON-013"
    let con_014: string@View = "CON-014"
    let con_015: string@View = "CON-015"
    let con_016: string@View = "CON-016"
    let con_017: string@View = "CON-017"
    let con_013_log: string@View =
        con_013
    let con_014_log: string@View =
        con_014
    let con_015_log: string@View =
        con_015
    let con_016_log: string@View =
        con_016
    let con_017_log: string@View =
        con_017

    let diag_0410: string@View = "E-CON-0410"
    let diag_0411: string@View = "E-CON-0411"
    let diag_0412: string@View = "E-CON-0412"
    let warn_0401: string@View = "W-CON-0401"
    let diag_0410_log: string@View =
        diag_0410
    let diag_0411_log: string@View =
        diag_0411
    let diag_0412_log: string@View =
        diag_0412
    let warn_0401_log: string@View =
        warn_0401

    let runtime_ok: bool =
        (direct_value_log == 5) &&
        (caller_value_log == 6) &&
        (con_013_log == "CON-013") &&
        (con_014_log == "CON-014") &&
        (con_015_log == "CON-015") &&
        (con_016_log == "CON-016") &&
        (con_017_log == "CON-017") &&
        (diag_0410_log == "E-CON-0410") &&
        (diag_0411_log == "E-CON-0411") &&
        (diag_0412_log == "E-CON-0412") &&
        (warn_0401_log == "W-CON-0401")
    let runtime_ok_log: bool =
        runtime_ok

    let metric: i32 = if (runtime_ok_log == true) { 63 } else { 0 }
    let metric_label: string@View = DynamicAttributeScopeAndPlacementMetricLabel(metric)
    let metric_log_actual: string@View =
        metric_label
    if (metric_log_actual != "63") {
        "fail"
        return 1
    }

    "success"
    return 0
}
