public procedure runCancelTokenChildExercise(ctx: Context) -> i32 {
    let parent_owner: unique (CancelToken@Active;) = (CancelToken::new();)
    let parent: shared CancelToken@Active = move parent_owner.0

    let child: CancelToken@Active = parent~>child()

    let child_before: bool = child~>is_cancelled()
    let child_before_log: bool = child_before
    let child_before_ok: bool = child_before_log == false

    if (child_before_ok != true) {
        return 1
    }

    parent~>cancel()

    let parent_after: bool = parent~>is_cancelled()
    let parent_after_log: bool = parent_after

    let child_after: bool = child~>is_cancelled()
    let child_after_log: bool = child_after

    let hierarchy_ok: bool = (parent_after_log == true) && (child_after_log == true)
    let hierarchy_ok_log: bool = hierarchy_ok

    if (hierarchy_ok_log != true) {
        return 1
    }
    return 0
}

public procedure runCancelTokenChildIndependenceExercise(ctx: Context) -> i32 {
    let parent_owner: unique (CancelToken@Active;) = (CancelToken::new();)
    let parent: shared CancelToken@Active = move parent_owner.0

    let child_a: CancelToken@Active = parent~>child()
    let child_b: CancelToken@Active = parent~>child()

    let a_before: bool = child_a~>is_cancelled()
    let b_before: bool = child_b~>is_cancelled()
    let siblings_clean: bool = (a_before == false) && (b_before == false)
    let siblings_clean_log: bool = siblings_clean

    if (siblings_clean_log != true) {
        return 1
    }

    parent~>cancel()

    let a_after: bool = child_a~>is_cancelled()
    let b_after: bool = child_b~>is_cancelled()
    let both_cancelled: bool = (a_after == true) && (b_after == true)
    let both_cancelled_log: bool = both_cancelled

    if (both_cancelled_log != true) {
        return 1
    }
    return 0
}

public procedure runCancelTokenGrandchildExercise(ctx: Context) -> i32 {
    let root_owner: unique (CancelToken@Active;) = (CancelToken::new();)
    let root: shared CancelToken@Active = move root_owner.0

    let child_owner: unique (CancelToken@Active;) = (root~>child();)
    let child: shared CancelToken@Active = move child_owner.0
    let grandchild: CancelToken@Active = child~>child()

    let gc_before: bool = grandchild~>is_cancelled()
    let gc_before_log: bool = gc_before

    if (gc_before_log != false) {
        return 1
    }

    root~>cancel()

    let gc_after: bool = grandchild~>is_cancelled()
    let gc_after_log: bool = gc_after

    if (gc_after_log != true) {
        return 1
    }
    return 0
}

public procedure runCancelTokenChildCancelDoesNotReachAncestorExercise(ctx: Context) -> i32 {
    let root_owner: unique (CancelToken@Active;) = (CancelToken::new();)
    let root: shared CancelToken@Active = move root_owner.0

    let child_owner: unique (CancelToken@Active;) = (root~>child();)
    let child: shared CancelToken@Active = move child_owner.0
    let grandchild: CancelToken@Active = child~>child()

    child~>cancel()

    let root_after: bool = root~>is_cancelled()
    let root_after_log: bool = root_after

    let child_after: bool = child~>is_cancelled()
    let child_after_log: bool = child_after

    let grandchild_after: bool = grandchild~>is_cancelled()
    let grandchild_after_log: bool = grandchild_after

    let tree_ok: bool = (root_after_log == false) && (child_after_log == true) && (grandchild_after_log == true)
    let tree_ok_log: bool = tree_ok

    if (tree_ok_log != true) {
        return 1
    }
    return 0
}

procedure runCancelTokenHierarchyExercises(ctx: Context) -> i32 {
    let status_child: i32 = runCancelTokenChildExercise(ctx)
    if (status_child != 0) {
        return status_child
    }

    let status_independence: i32 = runCancelTokenChildIndependenceExercise(ctx)
    if (status_independence != 0) {
        return status_independence
    }

    let status_grandchild: i32 = runCancelTokenGrandchildExercise(ctx)
    if (status_grandchild != 0) {
        return status_grandchild
    }

    let status_child_no_ancestor: i32 = runCancelTokenChildCancelDoesNotReachAncestorExercise(ctx)
    if (status_child_no_ancestor != 0) {
        return status_child_no_ancestor
    }

    return 0
}
