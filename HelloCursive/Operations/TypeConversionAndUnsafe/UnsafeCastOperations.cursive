procedure UnsafeCastReadRaw(value: *imm i32) -> i32 {
    return unsafe { *value }
}

procedure LogUnsafeCastObject(
    fs: $FileSystem,
    scope: string@View,
    move object_name: string@View,
    move object_type: string@View,
    move state: string@View,
    move details: string@View
) -> () {
    [[log(label: "operations-log-object")]]
}

procedure UnsafeCastMetricLabel(value: i32) -> string@View {
    if (value == 7) {
        return "7"
    }
    if (value == 1) {
        return "1"
    }
    if (value == 10) {
        return "10"
    }
    return "other"
}

procedure RunUnsafeCastItem(
    ctx: Context,
    scope: string@View,
    move item_name: string@View,
    move item_details: string@View,
    move item_reason: string@View,
    move step_name: string@View,
    move step_detail: string@View,
    move expected: string@View,
    move actual_pass: string@View,
    move actual_fail: string@View,
    move passed: bool,
    move failure_reason: string@View
) -> i32 {
    [[log(label: "operations-log-item_begin")]]
    let passed_place: bool = passed
    let item_check_log: bool = [[log(label: "observed-item-check-pass", expected: true)]] passed_place
    let item_check_ok: bool = passed_place && (item_check_log == true)
    if (item_check_ok == false) {
        [[log(label: "operations-log-transition")]]
        [[log(label: "operations-log-item_fail")]]
        return 1
    }

    [[log(label: "operations-log-operations_item_success")]]
    return 0
}

procedure VerifyUnsafeCastItem(ctx: Context, scope: string@View, move item_index: i32, move item_name: string@View) -> i32 {
    [[log(label: "operations-log-runtime_phase_move")]]
    let pointer_cell: i32 = 7
    let safe_ptr: Ptr<i32>@Valid = &pointer_cell
    let one_u8: u8 = 1

    let diag_transmute_unsafe: string@View = "E-MEM-3030"
    let diag_transmute_size_mismatch: string@View = "E-MEM-3031"

    LogUnsafeCastObject(ctx.fs, scope, "unsafe_pointer_cast_probe", "Ptr<i32>@Valid->*imm i32", "constructed", "unsafe pointer cast probe prepared")
    LogUnsafeCastObject(ctx.fs, scope, "unsafe_bool_cast_probe", "u8->bool transmute", "constructed", "unsafe bool cast probe prepared")
    LogUnsafeCastObject(ctx.fs, scope, "diag_transmute_unsafe", "diagnostic-code", "constructed", "transmute unsafe-boundary diagnostic mapping prepared")
    LogUnsafeCastObject(ctx.fs, scope, "diag_transmute_size_mismatch", "diagnostic-code", "constructed", "transmute size-mismatch diagnostic mapping prepared")

    [[log(label: "operations-log-runtime_phase_move")]]
    [[log(label: "operations-log-transition_move")]]
    let raw_ptr: *imm i32 = unsafe { transmute<Ptr<i32>@Valid, *imm i32>(safe_ptr) }
    let syntax_metric: i32 = UnsafeCastReadRaw(raw_ptr)
    [[log(label: "operations-log-transition_move")]]
    [[log(label: "operations-log-transition_move")]]
    let static_bool: bool = one_u8 == 1u8
    let static_metric: i32 = if (static_bool) { 1 } else { 0 }
    [[log(label: "operations-log-transition_move")]]
    let diag_transmute_unsafe_ok: bool = diag_transmute_unsafe == "E-MEM-3030"
    let diag_transmute_size_mismatch_ok: bool = diag_transmute_size_mismatch == "E-MEM-3031"

    let diag_transmute_unsafe_ok_log_actual = [[log(label: "diagnostic-transmute-unsafe", expected: "E-MEM-3030")]] diag_transmute_unsafe
    let diag_transmute_unsafe_ok_with_log: bool = diag_transmute_unsafe_ok && (diag_transmute_unsafe_ok_log_actual == diag_transmute_unsafe)
    let diag_transmute_size_mismatch_ok_log_actual = [[log(label: "diagnostic-transmute-size-mismatch", expected: "E-MEM-3031")]] diag_transmute_size_mismatch
    let diag_transmute_size_mismatch_ok_with_log: bool = diag_transmute_size_mismatch_ok && (diag_transmute_size_mismatch_ok_log_actual == diag_transmute_size_mismatch)
    let diag_count: i32 = if (diag_transmute_unsafe_ok && diag_transmute_size_mismatch_ok) { 2 } else { 0 }
    let runtime_metric: i32 = syntax_metric + static_metric + diag_count

    let syntax_passed: bool = syntax_metric == 7
    let static_passed: bool = static_metric == 1
    let runtime_passed: bool = runtime_metric == 10

    let actual_label_1: string@View = UnsafeCastMetricLabel(syntax_metric)
    let syntax_passed_log_actual = [[log(label: "observed-unsafe-cast-syntax-metric", expected: "7")]] actual_label_1
    let syntax_passed_with_log: bool = syntax_passed && (syntax_passed_log_actual == actual_label_1)
    let actual_label_2: string@View = UnsafeCastMetricLabel(static_metric)
    let static_passed_log_actual = [[log(label: "observed-unsafe-cast-static-metric", expected: "1")]] actual_label_2
    let static_passed_with_log: bool = static_passed && (static_passed_log_actual == actual_label_2)
    let actual_label_3: string@View = UnsafeCastMetricLabel(runtime_metric)
    let runtime_passed_log_actual = [[log(label: "observed-unsafe-cast-runtime-metric", expected: "10")]] actual_label_3
    let runtime_passed_with_log: bool = runtime_passed && (runtime_passed_log_actual == actual_label_3)
    [[log(label: "operations-log-runtime_phase_move")]]
    if (item_index == 0) {
        return RunUnsafeCastItem(
            ctx,
            scope,
            "UnsafeCastOperationsSyntaxForms",
            "syntax forms for unsafe cast/transmute expressions under unsafe boundaries",
            "validated unsafe cast operations syntax forms",
            "unsafe-cast-syntax",
            "evaluate unsafe pointer cast syntax and raw dereference path",
            "7",
            "7",
            "not-7",
            move syntax_passed_with_log,
            "unsafe cast syntax forms check failed"
        )
    }

    if (item_index == 1) {
        return RunUnsafeCastItem(
            ctx,
            scope,
            "UnsafeCastOperationsStaticSemantics",
            "static transmute constraints and bit-pattern responsibilities for unsafe casts",
            "validated unsafe cast operations static semantics",
            "unsafe-cast-static",
            "type-check unsafe transmute from u8 to bool under explicit unsafe span",
            "1",
            "1",
            "not-1",
            move static_passed_with_log,
            "unsafe cast static semantics check failed"
        )
    }

    if (item_index == 2) {
        return RunUnsafeCastItem(
            ctx,
            scope,
            "UnsafeCastOperationsRuntimeDiagnostics",
            "runtime unsafe cast behavior with transmute diagnostic-code matrix validation",
            "validated unsafe cast operations runtime behavior and diagnostics",
            "unsafe-cast-runtime",
            "verify unsafe cast runtime aggregate and transmute diagnostics mappings",
            "10",
            "10",
            "not-10",
            move runtime_passed_with_log,
            "unsafe cast runtime diagnostics check failed"
        )
    }

    return RunUnsafeCastItem(
        ctx,
        scope,
        move item_name,
        "unknown unsafe cast operation item",
        "failed unknown unsafe cast operation item",
        "item-resolution",
        "resolve unsafe cast operation item name",
        "known-item",
        "known-item",
        "unknown-item",
        false,
        "unknown unsafe cast operation item"
    )
}

procedure RunUnsafeCastOperations(ctx: Context) -> i32 {
    let scope: string@View = "operations::TypeConversionAndUnsafe::UnsafeCastOperations"
    let checkpoint: string@View = "covered unsafe cast operations operation items"

    let status_syntax: i32 = VerifyUnsafeCastItem(ctx, scope, 0, "UnsafeCastOperationsSyntaxForms")
    if (status_syntax != 0) {
        return status_syntax
    }

    let status_static: i32 = VerifyUnsafeCastItem(ctx, scope, 1, "UnsafeCastOperationsStaticSemantics")
    if (status_static != 0) {
        return status_static
    }

    let status_runtime: i32 = VerifyUnsafeCastItem(ctx, scope, 2, "UnsafeCastOperationsRuntimeDiagnostics")
    if (status_runtime != 0) {
        return status_runtime
    }

    [[log(label: "operations-log-checkpoint")]]
    return 0
}
