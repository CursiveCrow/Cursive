procedure RawPointerUnsafeRead(value: *imm i32) -> i32 {
    return unsafe { *value }
}

procedure LogRawPointerUnsafeObject(
    fs: $FileSystem,
    scope: string@View,
    move object_name: string@View,
    move object_type: string@View,
    move state: string@View,
    move details: string@View
) -> () {
    }

procedure RawPointerUnsafeMetricLabel(value: i32) -> string@View {
    if (value == 6) {
        return "6"
    }
    if (value == 12) {
        return "12"
    }
    return "other"
}

procedure RunRawPointerUnsafeItem(
    ctx: Context,
    scope: string@View,
    move item_name: string@View,
    move item_details: string@View,
    move item_reason: string@View,
    move step_name: string@View,
    move step_detail: string@View,
    move expected: string@View,
    move actual_pass: string@View,
    move actual_fail: string@View,
    move passed: bool,
    move failure_reason: string@View
) -> i32 {
    let passed_place: bool = passed
    let item_check_log: bool = passed_place
    let item_check_ok: bool = passed_place && (item_check_log == true)
    if (item_check_ok == false) {
        return 1
    }

    return 0
}

procedure VerifyRawPointerUnsafeItem(ctx: Context, scope: string@View, move item_index: i32, move item_name: string@View) -> i32 {
    let raw_cell: i32 = 6
    let safe_ptr: Ptr<i32>@Valid = &raw_cell
    let raw_ptr: *imm i32 = unsafe { transmute<Ptr<i32>@Valid, *imm i32>(safe_ptr) }

    LogRawPointerUnsafeObject(ctx.fs, scope, "raw_cell", "i32", "constructed", "stack value for raw pointer derivation prepared")
    LogRawPointerUnsafeObject(ctx.fs, scope, "safe_ptr", "Ptr<i32>@Valid", "constructed", "safe pointer source prepared")
    LogRawPointerUnsafeObject(ctx.fs, scope, "raw_ptr", "*imm i32", "constructed", "raw pointer derived via unsafe transmute prepared")

    let syntax_metric: i32 = RawPointerUnsafeRead(raw_ptr)
    let raw_addr: Ptr<const i32>@Valid = unsafe { &*raw_ptr }
    let static_metric: i32 = *raw_addr
    let runtime_metric: i32 = syntax_metric + static_metric

    let syntax_passed: bool = syntax_metric == 6
    let static_passed: bool = static_metric == 6
    let runtime_passed: bool = runtime_metric == 12

    let actual_label_1: string@View = RawPointerUnsafeMetricLabel(syntax_metric)
    let syntax_passed_log_actual = actual_label_1
    let syntax_passed_with_log: bool = syntax_passed && (syntax_passed_log_actual == actual_label_1)
    let actual_label_2: string@View = RawPointerUnsafeMetricLabel(static_metric)
    let static_passed_log_actual = actual_label_2
    let static_passed_with_log: bool = static_passed && (static_passed_log_actual == actual_label_2)
    let actual_label_3: string@View = RawPointerUnsafeMetricLabel(runtime_metric)
    let runtime_passed_log_actual = actual_label_3
    let runtime_passed_with_log: bool = runtime_passed && (runtime_passed_log_actual == actual_label_3)
    if (item_index == 0) {
        return RunRawPointerUnsafeItem(
            ctx,
            scope,
            "RawPointerUnsafeOperationsSyntaxForms",
            "syntax forms for `*imm` raw pointers and unsafe dereference surface",
            "validated raw pointer unsafe operations syntax forms",
            "raw-pointer-unsafe-syntax",
            "evaluate raw pointer unsafe dereference expression forms",
            "6",
            "6",
            "not-6",
            move syntax_passed_with_log,
            "raw-pointer unsafe syntax forms check failed"
        )
    }

    if (item_index == 1) {
        return RunRawPointerUnsafeItem(
            ctx,
            scope,
            "RawPointerUnsafeOperationsStaticSemantics",
            "unsafe-span requirement and raw-pointer dereference typing constraints",
            "validated raw pointer unsafe operations static semantics",
            "raw-pointer-unsafe-static",
            "type-check raw pointer dereference inside unsafe and address recomposition",
            "6",
            "6",
            "not-6",
            move static_passed_with_log,
            "raw-pointer unsafe static semantics check failed"
        )
    }

    if (item_index == 2) {
        return RunRawPointerUnsafeItem(
            ctx,
            scope,
            "RawPointerUnsafeOperationsRuntimeDiagnostics",
            "runtime raw-pointer read behavior across unsafe dereference paths",
            "validated raw pointer unsafe operations runtime behavior and diagnostics",
            "raw-pointer-unsafe-runtime",
            "execute unsafe raw-pointer read paths and verify aggregate metric",
            "12",
            "12",
            "not-12",
            move runtime_passed_with_log,
            "raw-pointer unsafe runtime diagnostics check failed"
        )
    }

    return RunRawPointerUnsafeItem(
        ctx,
        scope,
        move item_name,
        "unknown raw-pointer unsafe operation item",
        "failed unknown raw-pointer unsafe operation item",
        "item-resolution",
        "resolve raw-pointer unsafe operation item name",
        "known-item",
        "known-item",
        "unknown-item",
        false,
        "unknown raw-pointer unsafe operation item"
    )
}

procedure RunRawPointerUnsafeOperations(ctx: Context) -> i32 {
    let scope: string@View = "operations::TypeConversionAndUnsafe::RawPointerUnsafeOperations"
    let checkpoint: string@View = "covered raw pointer unsafe operations operation items"

    let status_syntax: i32 = VerifyRawPointerUnsafeItem(ctx, scope, 0, "RawPointerUnsafeOperationsSyntaxForms")
    if (status_syntax != 0) {
        return status_syntax
    }

    let status_static: i32 = VerifyRawPointerUnsafeItem(ctx, scope, 1, "RawPointerUnsafeOperationsStaticSemantics")
    if (status_static != 0) {
        return status_static
    }

    let status_runtime: i32 = VerifyRawPointerUnsafeItem(ctx, scope, 2, "RawPointerUnsafeOperationsRuntimeDiagnostics")
    if (status_runtime != 0) {
        return status_runtime
    }

    return 0
}
