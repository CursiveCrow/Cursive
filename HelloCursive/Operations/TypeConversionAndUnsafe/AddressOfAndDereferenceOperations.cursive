procedure AddressOfDereferenceReadSafe(value: Ptr<i32>@Valid) -> i32 {
    return *value
}

procedure AddressOfDereferenceReadRaw(value: *imm i32) -> i32 {
    return unsafe { *value }
}

procedure LogAddressOfDereferenceObject(
    fs: $FileSystem,
    scope: string@View,
    move object_name: string@View,
    move object_type: string@View,
    move state: string@View,
    move details: string@View
) -> () {
    }

procedure AddressOfDereferenceMetricLabel(value: i32) -> string@View {
    if (value == 9) {
        return "9"
    }
    if (value == 18) {
        return "18"
    }
    return "other"
}

procedure RunAddressOfDereferenceItem(
    ctx: Context,
    scope: string@View,
    move item_name: string@View,
    move item_details: string@View,
    move item_reason: string@View,
    move step_name: string@View,
    move step_detail: string@View,
    move expected: string@View,
    move actual_pass: string@View,
    move actual_fail: string@View,
    move passed: bool,
    move failure_reason: string@View
) -> i32 {
    let passed_place: bool = passed
    let item_check_log: bool = passed_place
    let item_check_ok: bool = passed_place && (item_check_log == true)
    if (item_check_ok == false) {
        return 1
    }

    return 0
}

procedure VerifyAddressOfDereferenceItem(ctx: Context, scope: string@View, move item_index: i32, move item_name: string@View) -> i32 {
    let cell: i32 = 9
    let safe_ptr: Ptr<i32>@Valid = &cell
    let raw_ptr: *imm i32 = unsafe { transmute<Ptr<i32>@Valid, *imm i32>(safe_ptr) }

    LogAddressOfDereferenceObject(ctx.fs, scope, "cell", "i32", "constructed", "stack place for address-of operation prepared")
    LogAddressOfDereferenceObject(ctx.fs, scope, "safe_ptr", "Ptr<i32>@Valid", "constructed", "safe pointer from address-of prepared")
    LogAddressOfDereferenceObject(ctx.fs, scope, "raw_ptr", "*imm i32", "constructed", "raw pointer derived from safe pointer prepared")

    let syntax_metric: i32 = AddressOfDereferenceReadSafe(safe_ptr)
    let static_metric: i32 = AddressOfDereferenceReadRaw(raw_ptr)
    let runtime_metric: i32 = syntax_metric + static_metric

    let syntax_passed: bool = syntax_metric == 9
    let static_passed: bool = static_metric == 9
    let runtime_passed: bool = runtime_metric == 18

    let actual_label_1: string@View = AddressOfDereferenceMetricLabel(syntax_metric)
    let syntax_passed_log_actual = actual_label_1
    let syntax_passed_with_log: bool = syntax_passed && (syntax_passed_log_actual == actual_label_1)
    let actual_label_2: string@View = AddressOfDereferenceMetricLabel(static_metric)
    let static_passed_log_actual = actual_label_2
    let static_passed_with_log: bool = static_passed && (static_passed_log_actual == actual_label_2)
    let actual_label_3: string@View = AddressOfDereferenceMetricLabel(runtime_metric)
    let runtime_passed_log_actual = actual_label_3
    let runtime_passed_with_log: bool = runtime_passed && (runtime_passed_log_actual == actual_label_3)
    if (item_index == 0) {
        return RunAddressOfDereferenceItem(
            ctx,
            scope,
            "AddressOfAndDereferenceOperationsSyntaxForms",
            "syntax forms for `&place` and unary `*` dereference expressions",
            "validated address-of and dereference syntax forms",
            "address-deref-syntax",
            "evaluate address-of creation and safe dereference expression surface",
            "9",
            "9",
            "not-9",
            move syntax_passed_with_log,
            "address-of/dereference syntax forms check failed"
        )
    }

    if (item_index == 1) {
        return RunAddressOfDereferenceItem(
            ctx,
            scope,
            "AddressOfAndDereferenceOperationsStaticSemantics",
            "pointer-state and unsafe-span typing constraints for dereference operations",
            "validated address-of and dereference static semantics",
            "address-deref-static",
            "type-check raw pointer dereference inside required unsafe boundary",
            "9",
            "9",
            "not-9",
            move static_passed_with_log,
            "address-of/dereference static semantics check failed"
        )
    }

    if (item_index == 2) {
        return RunAddressOfDereferenceItem(
            ctx,
            scope,
            "AddressOfAndDereferenceOperationsRuntimeDiagnostics",
            "runtime read behavior across safe and raw pointer dereference paths",
            "validated address-of and dereference runtime behavior and diagnostics",
            "address-deref-runtime",
            "execute safe/raw dereference paths and verify runtime aggregate metric",
            "18",
            "18",
            "not-18",
            move runtime_passed_with_log,
            "address-of/dereference runtime diagnostics check failed"
        )
    }

    return RunAddressOfDereferenceItem(
        ctx,
        scope,
        move item_name,
        "unknown address-of/dereference operation item",
        "failed unknown address-of/dereference operation item",
        "item-resolution",
        "resolve address-of/dereference operation item name",
        "known-item",
        "known-item",
        "unknown-item",
        false,
        "unknown address-of/dereference operation item"
    )
}

procedure RunAddressOfAndDereferenceOperations(ctx: Context) -> i32 {
    let scope: string@View = "operations::TypeConversionAndUnsafe::AddressOfAndDereferenceOperations"
    let checkpoint: string@View = "covered address of and dereference operations operation items"

    let status_syntax: i32 = VerifyAddressOfDereferenceItem(ctx, scope, 0, "AddressOfAndDereferenceOperationsSyntaxForms")
    if (status_syntax != 0) {
        return status_syntax
    }

    let status_static: i32 = VerifyAddressOfDereferenceItem(ctx, scope, 1, "AddressOfAndDereferenceOperationsStaticSemantics")
    if (status_static != 0) {
        return status_static
    }

    let status_runtime: i32 = VerifyAddressOfDereferenceItem(ctx, scope, 2, "AddressOfAndDereferenceOperationsRuntimeDiagnostics")
    if (status_runtime != 0) {
        return status_runtime
    }

    return 0
}
