procedure TransmuteReadRaw(value: *imm i32) -> i32 {
    return unsafe { *value }
}

procedure LogTransmuteObject(
    fs: $FileSystem,
    scope: string@View,
    move object_name: string@View,
    move object_type: string@View,
    move state: string@View,
    move details: string@View
) -> () {
    [[log(label: "operations-log-object")]]
}

procedure TransmuteMetricLabel(value: i32) -> string@View {
    if (value == 5) {
        return "5"
    }
    if (value == 6) {
        return "6"
    }
    if (value == 11) {
        return "11"
    }
    return "other"
}

procedure RunTransmuteItem(
    ctx: Context,
    scope: string@View,
    move item_name: string@View,
    move item_details: string@View,
    move item_reason: string@View,
    move step_name: string@View,
    move step_detail: string@View,
    move expected: string@View,
    move actual_pass: string@View,
    move actual_fail: string@View,
    move passed: bool,
    move failure_reason: string@View
) -> i32 {
    [[log(label: "operations-log-item_begin")]]
    let passed_place: bool = passed
    let item_check_log: bool = [[log(label: "observed-item-check-pass", expected: true)]] passed_place
    let item_check_ok: bool = passed_place && (item_check_log == true)
    if (item_check_ok == false) {
        [[log(label: "operations-log-transition")]]
        [[log(label: "operations-log-item_fail")]]
        return 1
    }

    [[log(label: "operations-log-operations_item_success")]]
    return 0
}

procedure VerifyTransmuteItem(ctx: Context, scope: string@View, move item_index: i32, move item_name: string@View) -> i32 {
    [[log(label: "operations-log-runtime_phase_move")]]
    let pointer_cell: i32 = 6
    let safe_ptr: Ptr<i32>@Valid = &pointer_cell

    LogTransmuteObject(ctx.fs, scope, "primitive_transmute_probe", "i32->u32", "constructed", "primitive transmute probe prepared")
    LogTransmuteObject(ctx.fs, scope, "pointer_transmute_probe", "Ptr<i32>@Valid->*imm i32", "constructed", "pointer transmute probe prepared")

    [[log(label: "operations-log-runtime_phase_move")]]
    [[log(label: "operations-log-transition_move")]]
    let syntax_u32: u32 = unsafe { transmute<i32, u32>(5) }
    let syntax_metric: i32 = syntax_u32 as i32
    [[log(label: "operations-log-transition_move")]]
    [[log(label: "operations-log-transition_move")]]
    let raw_ptr: *imm i32 = unsafe { transmute<Ptr<i32>@Valid, *imm i32>(safe_ptr) }
    let static_metric: i32 = TransmuteReadRaw(raw_ptr)
    [[log(label: "operations-log-transition_move")]]
    let runtime_metric: i32 = syntax_metric + static_metric

    let syntax_passed: bool = syntax_metric == 5
    let static_passed: bool = static_metric == 6
    let runtime_passed: bool = runtime_metric == 11

    let actual_label_1: string@View = TransmuteMetricLabel(syntax_metric)
    let syntax_passed_log_actual = [[log(label: "observed-transmute-syntax-metric", expected: "5")]] actual_label_1
    let syntax_passed_with_log: bool = syntax_passed && (syntax_passed_log_actual == actual_label_1)
    let actual_label_2: string@View = TransmuteMetricLabel(static_metric)
    let static_passed_log_actual = [[log(label: "observed-transmute-static-metric", expected: "6")]] actual_label_2
    let static_passed_with_log: bool = static_passed && (static_passed_log_actual == actual_label_2)
    let actual_label_3: string@View = TransmuteMetricLabel(runtime_metric)
    let runtime_passed_log_actual = [[log(label: "observed-transmute-runtime-metric", expected: "11")]] actual_label_3
    let runtime_passed_with_log: bool = runtime_passed && (runtime_passed_log_actual == actual_label_3)
    [[log(label: "operations-log-runtime_phase_move")]]
    if (item_index == 0) {
        return RunTransmuteItem(
            ctx,
            scope,
            "TransmuteOperationsSyntaxForms",
            "syntax forms for `transmute<Src, Dst>(expr)` within required unsafe spans",
            "validated transmute operations syntax forms",
            "transmute-syntax",
            "evaluate primitive transmute syntax and resulting bitcast value",
            "5",
            "5",
            "not-5",
            move syntax_passed_with_log,
            "transmute syntax forms check failed"
        )
    }

    if (item_index == 1) {
        return RunTransmuteItem(
            ctx,
            scope,
            "TransmuteOperationsStaticSemantics",
            "size/alignment and type-shape compatibility for transmute source/target pairs",
            "validated transmute operations static semantics",
            "transmute-static",
            "type-check pointer-shaped transmute pair and resulting raw pointer dereference",
            "6",
            "6",
            "not-6",
            move static_passed_with_log,
            "transmute static semantics check failed"
        )
    }

    if (item_index == 2) {
        return RunTransmuteItem(
            ctx,
            scope,
            "TransmuteOperationsRuntimeDiagnostics",
            "runtime transmute behavior across primitive and pointer conversion paths",
            "validated transmute operations runtime behavior and diagnostics",
            "transmute-runtime",
            "execute primitive+pointer transmute paths and verify runtime aggregate metric",
            "11",
            "11",
            "not-11",
            move runtime_passed_with_log,
            "transmute runtime diagnostics check failed"
        )
    }

    return RunTransmuteItem(
        ctx,
        scope,
        move item_name,
        "unknown transmute operation item",
        "failed unknown transmute operation item",
        "item-resolution",
        "resolve transmute operation item name",
        "known-item",
        "known-item",
        "unknown-item",
        false,
        "unknown transmute operation item"
    )
}

procedure RunTransmuteOperations(ctx: Context) -> i32 {
    let scope: string@View = "operations::TypeConversionAndUnsafe::TransmuteOperations"
    let checkpoint: string@View = "covered transmute operations operation items"

    let status_syntax: i32 = VerifyTransmuteItem(ctx, scope, 0, "TransmuteOperationsSyntaxForms")
    if (status_syntax != 0) {
        return status_syntax
    }

    let status_static: i32 = VerifyTransmuteItem(ctx, scope, 1, "TransmuteOperationsStaticSemantics")
    if (status_static != 0) {
        return status_static
    }

    let status_runtime: i32 = VerifyTransmuteItem(ctx, scope, 2, "TransmuteOperationsRuntimeDiagnostics")
    if (status_runtime != 0) {
        return status_runtime
    }

    [[log(label: "operations-log-checkpoint")]]
    return 0
}
