
public procedure runGroup(ctx: Context) -> i32 {
    let section_name: string@View = "operations/TypeConversionAndUnsafe"
    let status_ok: string@View = "ok"
    let status_failed: string@View = "failed"

    let phase_planned: string@View = "planned"
    let phase_running: string@View = "running"
    let phase_complete: string@View = "complete"
    let phase_failed: string@View = "failed"
    let dispatch_reason: string@View = "dispatching operation topic function"
    let complete_reason: string@View = "operation topic function completed"
    let failed_reason: string@View = "operation topic function returned non-zero status"

    let feature_SafeCastOperations: string@View = "TypeConversionAndUnsafe::SafeCastOperations"
    let feature_UnsafeCastOperations: string@View = "TypeConversionAndUnsafe::UnsafeCastOperations"
    let feature_TransmuteOperations: string@View = "TypeConversionAndUnsafe::TransmuteOperations"
    let feature_RawPointerUnsafeOperations: string@View = "TypeConversionAndUnsafe::RawPointerUnsafeOperations"
    let feature_AddressOfAndDereferenceOperations: string@View = "TypeConversionAndUnsafe::AddressOfAndDereferenceOperations"

    let status_SafeCastOperations: i32 = RunSafeCastOperations(ctx)
    if (status_SafeCastOperations != 0) {
        return status_SafeCastOperations
    }
    let status_UnsafeCastOperations: i32 = RunUnsafeCastOperations(ctx)
    if (status_UnsafeCastOperations != 0) {
        return status_UnsafeCastOperations
    }
    let status_TransmuteOperations: i32 = RunTransmuteOperations(ctx)
    if (status_TransmuteOperations != 0) {
        return status_TransmuteOperations
    }
    let status_RawPointerUnsafeOperations: i32 = RunRawPointerUnsafeOperations(ctx)
    if (status_RawPointerUnsafeOperations != 0) {
        return status_RawPointerUnsafeOperations
    }
    let status_AddressOfAndDereferenceOperations: i32 = RunAddressOfAndDereferenceOperations(ctx)
    if (status_AddressOfAndDereferenceOperations != 0) {
        return status_AddressOfAndDereferenceOperations
    }
    return 0
}
