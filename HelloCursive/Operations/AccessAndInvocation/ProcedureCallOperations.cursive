procedure ProcedureCallAdd(left: i32, right: i32) -> i32 {
    return left + right
}

procedure ProcedureCallConsume(move value: i32) -> i32 {
    return value + 1
}

procedure ProcedureCallReadPair(left: const i32, right: const i32) -> i32 {
    return left + right
}

procedure LogProcedureCallObject(
    fs: $FileSystem,
    scope: string@View,
    move object_name: string@View,
    move object_type: string@View,
    move state: string@View,
    move details: string@View
) -> () {
    [[log(label: "operations-log-object")]]
}

procedure ProcedureCallMetricLabel(value: i32) -> string@View {
    if (value == 7) {
        return "7"
    }
    if (value == 10) {
        return "10"
    }
    if (value == 18) {
        return "18"
    }
    return "other"
}

procedure RunProcedureCallOperationsItem(
    ctx: Context,
    scope: string@View,
    move item_name: string@View,
    move item_details: string@View,
    move item_reason: string@View,
    move step_name: string@View,
    move step_detail: string@View,
    move expected: string@View,
    move actual_pass: string@View,
    move actual_fail: string@View,
    move passed: bool,
    move failure_reason: string@View
) -> i32 {
    let detail_begin: string@View = "operation feature item exercise start"
    [[log(label: "operations-log-item_begin")]]
    let passed_place: bool = passed
    let item_check_log: bool = [[log(label: "observed-item-check-pass", expected: true)]] passed_place
    let item_check_ok: bool = passed_place && (item_check_log == true)
    if (item_check_ok == false) {
        [[log(label: "operations-log-transition")]]
        [[log(label: "operations-log-item_fail")]]
        return 1
    }

    [[log(label: "operations-log-operations_item_success")]]
    return 0
}

procedure VerifyProcedureCallOperationsItem(ctx: Context, scope: string@View, move item_index: i32, move item_name: string@View) -> i32 {
    [[log(label: "operations-log-runtime_phase_move")]]
    let direct_lhs: i32 = 3
    let direct_rhs: i32 = 4
    let typed_callable: (i32, i32) -> i32 = ProcedureCallAdd
    LogProcedureCallObject(ctx.fs, scope, "direct_args", "i32,i32", "constructed", "direct procedure call arguments prepared")
    LogProcedureCallObject(ctx.fs, scope, "typed_callable", "(i32,i32)->i32", "constructed", "typed callable value prepared")

    [[log(label: "operations-log-runtime_phase_move")]]
    [[log(label: "operations-log-transition_move")]]
    let procedure_syntax_metric: i32 = ProcedureCallAdd(direct_lhs, direct_rhs)
    [[log(label: "operations-log-transition_move")]]
    [[log(label: "operations-log-transition_move")]]
    let procedure_static_metric: i32 = typed_callable(4, 6)
    [[log(label: "operations-log-transition_move")]]
    LogProcedureCallObject(ctx.fs, scope, "consume_literal", "i32 literal", "constructed", "consuming call literal argument prepared")
    LogProcedureCallObject(ctx.fs, scope, "consume_place", "i32 place", "constructed", "consuming call place argument prepared")
    LogProcedureCallObject(ctx.fs, scope, "read_pair", "const i32,const i32", "constructed", "non-consuming pair arguments prepared")

    [[log(label: "operations-log-transition_move")]]
    let consume_literal_metric: i32 = ProcedureCallConsume(5)
    [[log(label: "operations-log-transition_move")]]
    let consume_place_source: i32 = 8
    [[log(label: "operations-log-transition_move")]]
    let consume_place_metric: i32 = ProcedureCallConsume(move consume_place_source)
    [[log(label: "operations-log-transition_move")]]
    [[log(label: "operations-log-transition_move")]]
    let read_pair_metric: i32 = ProcedureCallReadPair(1, 2)
    [[log(label: "operations-log-transition_move")]]
    let procedure_runtime_metric: i32 = consume_literal_metric + consume_place_metric + read_pair_metric

    let observed_syntax_step: string@View = "observed-procedure-call-syntax-metric"
    let observed_static_step: string@View = "observed-procedure-call-static-metric"
    let observed_runtime_step: string@View = "observed-procedure-call-runtime-metric"
    let expected_syntax: string@View = "7"
    let expected_static: string@View = "10"
    let expected_runtime: string@View = "18"
    let syntax_label: string@View = ProcedureCallMetricLabel(procedure_syntax_metric)
    let static_label: string@View = ProcedureCallMetricLabel(procedure_static_metric)
    let runtime_label: string@View = ProcedureCallMetricLabel(procedure_runtime_metric)
    let syntax_passed: bool = procedure_syntax_metric == 7
    let static_passed: bool = procedure_static_metric == 10
    let runtime_passed: bool = procedure_runtime_metric == 18

    let syntax_passed_log_actual = [[log(label: "observed-procedure-call-syntax-metric", expected: "7")]] syntax_label
    let syntax_passed_with_log: bool = syntax_passed && (syntax_passed_log_actual == syntax_label)
    let static_passed_log_actual = [[log(label: "observed-procedure-call-static-metric", expected: "10")]] static_label
    let static_passed_with_log: bool = static_passed && (static_passed_log_actual == static_label)
    let runtime_passed_log_actual = [[log(label: "observed-procedure-call-runtime-metric", expected: "18")]] runtime_label
    let runtime_passed_with_log: bool = runtime_passed && (runtime_passed_log_actual == runtime_label)
    [[log(label: "operations-log-runtime_phase_move")]]
    if (item_index == 0) {
        return RunProcedureCallOperationsItem(
            ctx,
            scope,
            "ProcedureCallOperationsSyntaxForms",
            "direct procedure invocation syntax and argument list forms",
            "validated procedure-call syntax forms",
            "procedure-call-syntax",
            "parse and evaluate direct procedure invocation expression form",
            "7",
            "7",
            "not-7",
            move syntax_passed_with_log,
            "procedure-call syntax forms check failed"
        )
    }

    if (item_index == 1) {
        return RunProcedureCallOperationsItem(
            ctx,
            scope,
            "ProcedureCallOperationsStaticSemantics",
            "procedure type signatures and typed-callable invocation typing",
            "validated procedure-call static semantics",
            "procedure-call-static",
            "type-check and invoke callable value with explicit procedure type",
            "10",
            "10",
            "not-10",
            move static_passed_with_log,
            "procedure-call static semantics check failed"
        )
    }

    if (item_index == 2) {
        return RunProcedureCallOperationsItem(
            ctx,
            scope,
            "ProcedureCallOperationsRuntimeDiagnostics",
            "consuming and non-consuming call behavior across literal and place arguments",
            "validated procedure-call runtime behavior and diagnostics",
            "procedure-call-runtime",
            "execute consuming/non-consuming call paths and verify aggregate metric",
            "18",
            "18",
            "not-18",
            move runtime_passed_with_log,
            "procedure-call runtime diagnostics check failed"
        )
    }

    return RunProcedureCallOperationsItem(
        ctx,
        scope,
        move item_name,
        "unknown procedure-call operation item",
        "failed unknown procedure-call operation item",
        "item-resolution",
        "resolve procedure-call operation item name",
        "known-item",
        "known-item",
        "unknown-item",
        false,
        "unknown procedure-call operation item"
    )
}

procedure RunProcedureCallOperations(ctx: Context) -> i32 {
    let scope: string@View = "operations::AccessAndInvocation::ProcedureCallOperations"
    let checkpoint: string@View = "covered procedure call operations operation items"

    let status_syntax: i32 = VerifyProcedureCallOperationsItem(ctx, scope, 0, "ProcedureCallOperationsSyntaxForms")
    if (status_syntax != 0) {
        return status_syntax
    }

    let status_static: i32 = VerifyProcedureCallOperationsItem(ctx, scope, 1, "ProcedureCallOperationsStaticSemantics")
    if (status_static != 0) {
        return status_static
    }

    let status_runtime: i32 = VerifyProcedureCallOperationsItem(ctx, scope, 2, "ProcedureCallOperationsRuntimeDiagnostics")
    if (status_runtime != 0) {
        return status_runtime
    }

    [[log(label: "operations-log-checkpoint")]]
    return 0
}
