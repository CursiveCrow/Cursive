public record PartialMoveCarrier {
    public left: unique i32
    public right: unique i32
}

procedure MoveConsumeValue(move value: i32) -> i32 {
    return value + 1
}

procedure LogMoveOperationsObject(
    fs: $FileSystem,
    scope: string@View,
    move object_name: string@View,
    move object_type: string@View,
    move state: string@View,
    move details: string@View
) -> () {
    [[log(label: "operations-log-object")]]
}

procedure MoveOperationsMetricLabel(value: i32) -> string@View {
    if (value == 6) {
        return "6"
    }
    if (value == 9) {
        return "9"
    }
    if (value == 18) {
        return "18"
    }
    if (value == 27) {
        return "27"
    }
    return "other"
}

procedure RunMoveAndPartialMoveOperationsItem(
    ctx: Context,
    scope: string@View,
    move item_name: string@View,
    move item_details: string@View,
    move item_reason: string@View,
    move step_name: string@View,
    move step_detail: string@View,
    move expected: string@View,
    move actual_pass: string@View,
    move actual_fail: string@View,
    move passed: bool,
    move failure_reason: string@View
) -> i32 {
    let detail_begin: string@View = "operation feature item exercise start"
    [[log(label: "operations-log-item_begin")]]
    let passed_place: bool = passed
    let item_check_log: bool = [[log(label: "observed-item-check-pass", expected: true)]] passed_place
    let item_check_ok: bool = passed_place && (item_check_log == true)
    if (item_check_ok == false) {
        [[log(label: "operations-log-transition")]]
        [[log(label: "operations-log-item_fail")]]
        return 1
    }

    [[log(label: "operations-log-operations_item_success")]]
    return 0
}

procedure VerifyMoveAndPartialMoveOperationsItem(ctx: Context, scope: string@View, move item_index: i32, move item_name: string@View) -> i32 {
    [[log(label: "operations-log-runtime_phase_move")]]
    LogMoveOperationsObject(ctx.fs, scope, "move_literal", "i32 literal", "constructed", "literal source for consuming call prepared")
    LogMoveOperationsObject(ctx.fs, scope, "move_place", "i32 place", "constructed", "place source for explicit move call prepared")
    LogMoveOperationsObject(ctx.fs, scope, "partial_carrier", "PartialMoveCarrier", "constructed", "carrier with unique fields for partial moves prepared")

    [[log(label: "operations-log-runtime_phase_move")]]
    [[log(label: "operations-log-transition_move")]]
    let move_syntax_metric: i32 = MoveConsumeValue(5)
    [[log(label: "operations-log-transition_move")]]
    let move_place_source: i32 = 8
    [[log(label: "operations-log-transition_move")]]
    let move_static_metric: i32 = MoveConsumeValue(move move_place_source)
    [[log(label: "operations-log-transition_move")]]
    let partial_carrier: PartialMoveCarrier = PartialMoveCarrier { left: 7, right: 9 }
    [[log(label: "operations-log-transition_move")]]
    let partial_left_metric: i32 = MoveConsumeValue(move partial_carrier.left)
    [[log(label: "operations-log-transition_move")]]
    [[log(label: "operations-log-transition_move")]]
    let partial_right_metric: i32 = MoveConsumeValue(move partial_carrier.right)
    [[log(label: "operations-log-transition_move")]]
    let partial_metric: i32 = partial_left_metric + partial_right_metric
    let move_runtime_metric: i32 = move_static_metric + partial_metric

    let observed_syntax_step: string@View = "observed-move-syntax-metric"
    let observed_static_step: string@View = "observed-move-static-metric"
    let observed_partial_step: string@View = "observed-partial-move-metric"
    let observed_runtime_step: string@View = "observed-move-runtime-metric"
    let expected_syntax: string@View = "6"
    let expected_static: string@View = "9"
    let expected_partial: string@View = "18"
    let expected_runtime: string@View = "27"
    let syntax_label: string@View = MoveOperationsMetricLabel(move_syntax_metric)
    let static_label: string@View = MoveOperationsMetricLabel(move_static_metric)
    let partial_label: string@View = MoveOperationsMetricLabel(partial_metric)
    let runtime_label: string@View = MoveOperationsMetricLabel(move_runtime_metric)
    let syntax_passed: bool = move_syntax_metric == 6
    let static_passed: bool = move_static_metric == 9
    let partial_passed: bool = partial_metric == 18
    let runtime_passed: bool = move_runtime_metric == 27

    let syntax_passed_log_actual = [[log(label: "observed-move-syntax-metric", expected: "6")]] syntax_label
    let syntax_passed_with_log: bool = syntax_passed && (syntax_passed_log_actual == syntax_label)
    let static_passed_log_actual = [[log(label: "observed-move-static-metric", expected: "9")]] static_label
    let static_passed_with_log: bool = static_passed && (static_passed_log_actual == static_label)
    let partial_passed_log_actual = [[log(label: "observed-partial-move-metric", expected: "18")]] partial_label
    let partial_passed_with_log: bool = partial_passed && (partial_passed_log_actual == partial_label)
    let runtime_passed_log_actual = [[log(label: "observed-move-runtime-metric", expected: "27")]] runtime_label
    let runtime_passed_with_log: bool = runtime_passed && (runtime_passed_log_actual == runtime_label)
    let runtime_combined_passed: bool = partial_passed_with_log && runtime_passed_with_log
    [[log(label: "operations-log-runtime_phase_move")]]

    let _ = observed_syntax_step
    let _ = observed_static_step
    let _ = observed_partial_step
    let _ = observed_runtime_step
    let _ = expected_syntax
    let _ = expected_static
    let _ = expected_partial
    let _ = expected_runtime
    let _ = static_passed_with_log
    let _ = partial_passed_with_log
    let _ = runtime_passed_with_log

    if (item_index == 0) {
        return RunMoveAndPartialMoveOperationsItem(
            ctx,
            scope,
            "MoveAndPartialMoveOperationsSyntaxForms",
            "`move` expression syntax forms at consuming call sites",
            "validated move/partial-move syntax forms",
            "move-syntax",
            "parse and evaluate consuming call with literal argument",
            "6",
            "6",
            "not-6",
            move syntax_passed_with_log,
            "move/partial-move syntax forms check failed"
        )
    }

    if (item_index == 1) {
        return RunMoveAndPartialMoveOperationsItem(
            ctx,
            scope,
            "MoveAndPartialMoveOperationsStaticSemantics",
            "provenance-aware consuming argument rules requiring explicit move on places",
            "validated move/partial-move static semantics",
            "move-static",
            "type-check consuming call with explicit move from provenance-bearing place",
            "9",
            "9",
            "not-9",
            move static_passed_with_log,
            "move/partial-move static semantics check failed"
        )
    }

    if (item_index == 2) {
        return RunMoveAndPartialMoveOperationsItem(
            ctx,
            scope,
            "MoveAndPartialMoveOperationsRuntimeDiagnostics",
            "runtime partial-move state transitions across per-field moves on unique fields",
            "validated move/partial-move runtime behavior and diagnostics",
            "move-runtime",
            "execute per-field partial moves and verify runtime aggregate over consuming paths",
            "27",
            "27",
            "not-27",
            move runtime_combined_passed,
            "move/partial-move runtime diagnostics check failed"
        )
    }

    return RunMoveAndPartialMoveOperationsItem(
        ctx,
        scope,
        move item_name,
        "unknown move/partial-move operation item",
        "failed unknown move/partial-move operation item",
        "item-resolution",
        "resolve move/partial-move operation item name",
        "known-item",
        "known-item",
        "unknown-item",
        false,
        "unknown move/partial-move operation item"
    )
}

procedure RunMoveAndPartialMoveOperations(ctx: Context) -> i32 {
    let scope: string@View = "operations::AccessAndInvocation::MoveAndPartialMoveOperations"
    let checkpoint: string@View = "covered move and partial move operations operation items"

    let status_syntax: i32 = VerifyMoveAndPartialMoveOperationsItem(ctx, scope, 0, "MoveAndPartialMoveOperationsSyntaxForms")
    if (status_syntax != 0) {
        return status_syntax
    }

    let status_static: i32 = VerifyMoveAndPartialMoveOperationsItem(ctx, scope, 1, "MoveAndPartialMoveOperationsStaticSemantics")
    if (status_static != 0) {
        return status_static
    }

    let status_runtime: i32 = VerifyMoveAndPartialMoveOperationsItem(ctx, scope, 2, "MoveAndPartialMoveOperationsRuntimeDiagnostics")
    if (status_runtime != 0) {
        return status_runtime
    }

    [[log(label: "operations-log-checkpoint")]]
    return 0
}
