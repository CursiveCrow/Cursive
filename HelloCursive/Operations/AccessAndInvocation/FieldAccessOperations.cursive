public record AccessFieldInner {
    public value: i32
}

public record AccessFieldOuter {
    public left: i32
    public right: AccessFieldInner
}

procedure LogFieldAccessObject(
    fs: $FileSystem,
    scope: string@View,
    move object_name: string@View,
    move object_type: string@View,
    move state: string@View,
    move details: string@View
) -> () {
    }

procedure FieldAccessMetricLabel(value: i32) -> string@View {
    if (value == 7) {
        return "7"
    }
    if (value == 10) {
        return "10"
    }
    if (value == 11) {
        return "11"
    }
    return "other"
}

procedure RunFieldAccessOperationsItem(
    ctx: Context,
    scope: string@View,
    move item_name: string@View,
    move item_details: string@View,
    move item_reason: string@View,
    move step_name: string@View,
    move step_detail: string@View,
    move expected: string@View,
    move actual_pass: string@View,
    move actual_fail: string@View,
    move passed: bool,
    move failure_reason: string@View
) -> i32 {
    let detail_begin: string@View = "operation feature item exercise start"
    let passed_place: bool = passed
    let item_check_log: bool = passed_place
    let item_check_ok: bool = passed_place && (item_check_log == true)
    if (item_check_ok == false) {
        return 1
    }

    return 0
}

procedure VerifyFieldAccessOperationsItem(ctx: Context, scope: string@View, move item_index: i32, move item_name: string@View) -> i32 {
    let field_probe: AccessFieldOuter = AccessFieldOuter { left: 4, right: AccessFieldInner { value: 7 } }
    var mutable_probe: AccessFieldOuter = AccessFieldOuter { left: 1, right: AccessFieldInner { value: 2 } }
    LogFieldAccessObject(ctx.fs, scope, "field_probe", "AccessFieldOuter", "constructed", "record probe for field projection prepared")
    LogFieldAccessObject(ctx.fs, scope, "mutable_probe", "AccessFieldOuter", "constructed", "mutable record probe for field mutation prepared")

    let field_syntax_metric: i32 = field_probe.right.value
    let field_static_metric: i32 = field_probe.left + field_probe.right.value
    mutable_probe.left = mutable_probe.left + 3
    mutable_probe.right.value = mutable_probe.right.value + 4
    let field_runtime_metric: i32 = mutable_probe.left + mutable_probe.right.value
    let observed_syntax_step: string@View = "observed-field-access-syntax-metric"
    let observed_static_step: string@View = "observed-field-access-static-metric"
    let observed_runtime_step: string@View = "observed-field-access-runtime-metric"
    let expected_syntax: string@View = "7"
    let expected_static: string@View = "11"
    let expected_runtime: string@View = "10"
    let syntax_label: string@View = FieldAccessMetricLabel(field_syntax_metric)
    let static_label: string@View = FieldAccessMetricLabel(field_static_metric)
    let runtime_label: string@View = FieldAccessMetricLabel(field_runtime_metric)
    let syntax_passed: bool = field_syntax_metric == 7
    let static_passed: bool = field_static_metric == 11
    let runtime_passed: bool = field_runtime_metric == 10

    let syntax_passed_log_actual = syntax_label
    let syntax_passed_with_log: bool = syntax_passed && (syntax_passed_log_actual == syntax_label)
    let static_passed_log_actual = static_label
    let static_passed_with_log: bool = static_passed && (static_passed_log_actual == static_label)
    let runtime_passed_log_actual = runtime_label
    let runtime_passed_with_log: bool = runtime_passed && (runtime_passed_log_actual == runtime_label)
    if (item_index == 0) {
        return RunFieldAccessOperationsItem(
            ctx,
            scope,
            "FieldAccessOperationsSyntaxForms",
            "record field and nested-field postfix syntax forms",
            "validated field-access syntax forms",
            "field-access-syntax",
            "parse and evaluate nested field access expression form",
            "7",
            "7",
            "not-7",
            move syntax_passed_with_log,
            "field-access syntax forms check failed"
        )
    }

    if (item_index == 1) {
        return RunFieldAccessOperationsItem(
            ctx,
            scope,
            "FieldAccessOperationsStaticSemantics",
            "field projection typing and expression composition across field paths",
            "validated field-access static semantics",
            "field-access-static",
            "type-check composed expression over multiple projected fields",
            "11",
            "11",
            "not-11",
            move static_passed_with_log,
            "field-access static semantics check failed"
        )
    }

    if (item_index == 2) {
        return RunFieldAccessOperationsItem(
            ctx,
            scope,
            "FieldAccessOperationsRuntimeDiagnostics",
            "field-place mutation and runtime readback over updated object state",
            "validated field-access runtime behavior and diagnostics",
            "field-access-runtime",
            "mutate record fields and verify runtime-updated projection values",
            "10",
            "10",
            "not-10",
            move runtime_passed_with_log,
            "field-access runtime diagnostics check failed"
        )
    }

    return RunFieldAccessOperationsItem(
        ctx,
        scope,
        move item_name,
        "unknown field-access operation item",
        "failed unknown field-access operation item",
        "item-resolution",
        "resolve field-access operation item name",
        "known-item",
        "known-item",
        "unknown-item",
        false,
        "unknown field-access operation item"
    )
}

procedure RunFieldAccessOperations(ctx: Context) -> i32 {
    let scope: string@View = "operations::AccessAndInvocation::FieldAccessOperations"
    let checkpoint: string@View = "covered field access operations operation items"

    let status_syntax: i32 = VerifyFieldAccessOperationsItem(ctx, scope, 0, "FieldAccessOperationsSyntaxForms")
    if (status_syntax != 0) {
        return status_syntax
    }

    let status_static: i32 = VerifyFieldAccessOperationsItem(ctx, scope, 1, "FieldAccessOperationsStaticSemantics")
    if (status_static != 0) {
        return status_static
    }

    let status_runtime: i32 = VerifyFieldAccessOperationsItem(ctx, scope, 2, "FieldAccessOperationsRuntimeDiagnostics")
    if (status_runtime != 0) {
        return status_runtime
    }

    return 0
}
