public record AccessDispatchProbe {
    public base: i32

    procedure read(~) -> i32 {
        return self.base
    }

    procedure metric(~, delta: i32) -> i32 {
        return self.base + delta
    }

    procedure bump(~!, delta: i32) -> i32 {
        return self.base + delta + 1
    }
}

public record MethodsTypePathProjectionProbe {
    public value: i32
    public mirror: i32

    procedure project(~, delta: i32) -> i32 {
        return self.value + delta
    }

    procedure mirror_ref(~) -> i32 {
        return self.mirror
    }
}

procedure AccessStaticDispatchCall(probe: AccessDispatchProbe, delta: i32) -> i32 {
    return probe~>metric(delta)
}

procedure MethodsTypePathProjectionCall(probe: MethodsTypePathProjectionProbe, delta: i32) -> i32 {
    let mirror_metric: i32 = probe~>mirror_ref()
    return probe~>project(delta) + mirror_metric
}

procedure LogMethodDispatchObject(
    fs: $FileSystem,
    scope: string@View,
    move object_name: string@View,
    move object_type: string@View,
    move state: string@View,
    move details: string@View
) -> () {
    }

procedure MethodDispatchMetricLabel(value: i32) -> string@View {
    if (value == 5) {
        return "5"
    }
    if (value == 7) {
        return "7"
    }
    if (value == 16) {
        return "16"
    }
    if (value == 19) {
        return "19"
    }
    return "other"
}

procedure RunMethodAndStaticDispatchOperationsItem(
    ctx: Context,
    scope: string@View,
    move item_name: string@View,
    move item_details: string@View,
    move item_reason: string@View,
    move step_name: string@View,
    move step_detail: string@View,
    move expected: string@View,
    move actual_pass: string@View,
    move actual_fail: string@View,
    move passed: bool,
    move failure_reason: string@View
) -> i32 {
    let detail_begin: string@View = "operation feature item exercise start"
    let passed_place: bool = passed
    let item_check_log: bool = passed_place
    let item_check_ok: bool = passed_place && (item_check_log == true)
    if (item_check_ok == false) {
        return 1
    }

    return 0
}

procedure VerifyMethodAndStaticDispatchOperationsItem(ctx: Context, scope: string@View, move item_index: i32, move item_name: string@View) -> i32 {
    let probe_const: AccessDispatchProbe = AccessDispatchProbe { base: 5 }
    let probe_static: AccessDispatchProbe = AccessDispatchProbe { base: 5 }
    let probe_unique_seed: unique AccessDispatchProbe = AccessDispatchProbe { base: 5 }
    let methods_typepath_probe: MethodsTypePathProjectionProbe = MethodsTypePathProjectionProbe { value: 11, mirror: 4 }
    LogMethodDispatchObject(ctx.fs, scope, "probe_const", "AccessDispatchProbe", "constructed", "const receiver probe for method-call syntax prepared")
    LogMethodDispatchObject(ctx.fs, scope, "probe_static", "AccessDispatchProbe", "constructed", "probe for static method dispatch helper prepared")
    LogMethodDispatchObject(ctx.fs, scope, "probe_unique_seed", "unique AccessDispatchProbe", "constructed", "unique receiver seed for ~! method path prepared")
    LogMethodDispatchObject(ctx.fs, scope, "methods_typepath_probe", "MethodsTypePathProjectionProbe", "constructed", "record receiver for Methods(T) projection prepared")

    let method_syntax_metric: i32 = probe_const~>read()
    let static_dispatch_metric: i32 = AccessStaticDispatchCall(probe_static, 2)
    var probe_unique: unique AccessDispatchProbe = move probe_unique_seed
    LogMethodDispatchObject(ctx.fs, scope, "probe_unique", "unique AccessDispatchProbe", "constructed", "unique receiver for ~! dispatch path prepared")

    let unique_dispatch_metric: i32 = probe_unique~>bump(3)
    let method_runtime_metric: i32 = static_dispatch_metric + unique_dispatch_metric
    let methods_typepath_metric: i32 = MethodsTypePathProjectionCall(methods_typepath_probe, 4)

    let observed_syntax_step: string@View = "observed-method-dispatch-syntax-metric"
    let observed_static_step: string@View = "observed-method-dispatch-static-metric"
    let observed_runtime_step: string@View = "observed-method-dispatch-runtime-metric"
    let observed_methods_typepath_step: string@View = "observed-methods-typepath-projection-metric"
    let expected_syntax: string@View = "5"
    let expected_static: string@View = "7"
    let expected_runtime: string@View = "16"
    let expected_methods_typepath: string@View = "19"
    let syntax_label: string@View = MethodDispatchMetricLabel(method_syntax_metric)
    let static_label: string@View = MethodDispatchMetricLabel(static_dispatch_metric)
    let runtime_label: string@View = MethodDispatchMetricLabel(method_runtime_metric)
    let methods_typepath_label: string@View = MethodDispatchMetricLabel(methods_typepath_metric)
    let syntax_passed: bool = method_syntax_metric == 5
    let static_passed: bool = static_dispatch_metric == 7
    let runtime_passed: bool = method_runtime_metric == 16
    let methods_typepath_passed: bool = methods_typepath_metric == 19

    let syntax_passed_log_actual = syntax_label
    let syntax_passed_with_log: bool = syntax_passed && (syntax_passed_log_actual == syntax_label)
    let static_passed_log_actual = static_label
    let static_passed_with_log: bool = static_passed && (static_passed_log_actual == static_label)
    let runtime_passed_log_actual = runtime_label
    let runtime_passed_with_log: bool = runtime_passed && (runtime_passed_log_actual == runtime_label)
    let methods_typepath_passed_log_actual = methods_typepath_label
    let methods_typepath_passed_with_log: bool = methods_typepath_passed && (methods_typepath_passed_log_actual == methods_typepath_label)
    if (item_index == 0) {
        return RunMethodAndStaticDispatchOperationsItem(
            ctx,
            scope,
            "MethodAndStaticDispatchOperationsSyntaxForms",
            "method-call receiver syntax forms using the `~>` operator",
            "validated method and static dispatch syntax forms",
            "method-dispatch-syntax",
            "parse and evaluate receiver method-call syntax on concrete record value",
            "5",
            "5",
            "not-5",
            move syntax_passed_with_log,
            "method/static-dispatch syntax forms check failed"
        )
    }

    if (item_index == 1) {
        return RunMethodAndStaticDispatchOperationsItem(
            ctx,
            scope,
            "MethodAndStaticDispatchOperationsStaticSemantics",
            "statically resolved dispatch typing for concrete receiver method surfaces",
            "validated method and static dispatch static semantics",
            "method-dispatch-static",
            "type-check statically resolved method dispatch through helper procedure",
            "7",
            "7",
            "not-7",
            move static_passed_with_log,
            "method/static-dispatch static semantics check failed"
        )
    }

    if (item_index == 2) {
        return RunMethodAndStaticDispatchOperationsItem(
            ctx,
            scope,
            "MethodAndStaticDispatchOperationsRuntimeDiagnostics",
            "runtime dispatch behavior across const and unique receiver call paths",
            "validated method and static dispatch runtime behavior and diagnostics",
            "method-dispatch-runtime",
            "execute const and unique receiver dispatch path and verify runtime aggregate",
            "16",
            "16",
            "not-16",
            move runtime_passed_with_log,
            "method/static-dispatch runtime diagnostics check failed"
        )
    }

    if (item_index == 3) {
        return RunMethodAndStaticDispatchOperationsItem(
            ctx,
            scope,
            "MethodTypePathProjectionRuntime",
            "record Methods(T) projection through a TypePath receiver",
            "validated record method lookup, lowering, codegen, and runtime dispatch",
            "method-typepath-projection-runtime",
            "execute record method calls through a concrete TypePath receiver",
            "19",
            "19",
            "not-19",
            move methods_typepath_passed_with_log,
            "record Methods(T) TypePath projection runtime check failed"
        )
    }

    return RunMethodAndStaticDispatchOperationsItem(
        ctx,
        scope,
        move item_name,
        "unknown method/static-dispatch operation item",
        "failed unknown method/static-dispatch operation item",
        "item-resolution",
        "resolve method/static-dispatch operation item name",
        "known-item",
        "known-item",
        "unknown-item",
        false,
        "unknown method/static-dispatch operation item"
    )
}

procedure RunMethodAndStaticDispatchOperations(ctx: Context) -> i32 {
    let scope: string@View = "operations::AccessAndInvocation::MethodAndStaticDispatchOperations"
    let checkpoint: string@View = "covered method and static dispatch operations operation items"

    let status_syntax: i32 = VerifyMethodAndStaticDispatchOperationsItem(ctx, scope, 0, "MethodAndStaticDispatchOperationsSyntaxForms")
    if (status_syntax != 0) {
        return status_syntax
    }

    let status_static: i32 = VerifyMethodAndStaticDispatchOperationsItem(ctx, scope, 1, "MethodAndStaticDispatchOperationsStaticSemantics")
    if (status_static != 0) {
        return status_static
    }

    let status_runtime: i32 = VerifyMethodAndStaticDispatchOperationsItem(ctx, scope, 2, "MethodAndStaticDispatchOperationsRuntimeDiagnostics")
    if (status_runtime != 0) {
        return status_runtime
    }

    let status_methods_typepath: i32 = VerifyMethodAndStaticDispatchOperationsItem(ctx, scope, 3, "MethodTypePathProjectionRuntime")
    if (status_methods_typepath != 0) {
        return status_methods_typepath
    }

    return 0
}
