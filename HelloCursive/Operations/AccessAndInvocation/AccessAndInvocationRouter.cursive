        [[log(label: "operations-log-section_end")]]
        return status_PropagationOperatorOperations
    }
    [[log(label: "operations-log-transition")]]
    [[log(label: "operations-log-transition")]]
    let status_MoveAndPartialMoveOperations: i32 = RunMoveAndPartialMoveOperations(ctx)
    if (status_MoveAndPartialMoveOperations != 0) {
        [[log(label: "operations-log-transition")]]
        [[log(label: "operations-log-section_end")]]
        return status_MoveAndPartialMoveOperations
