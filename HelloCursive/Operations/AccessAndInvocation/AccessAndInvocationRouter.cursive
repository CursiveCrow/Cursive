    }
    [[log(label: "operations-log-transition")]]
    [[log(label: "operations-log-transition")]]
    let status_IndexAccessOperations: i32 = RunIndexAccessOperations(ctx)
    if (status_IndexAccessOperations != 0) {
        [[log(label: "operations-log-transition")]]
        [[log(label: "operations-log-section_end")]]
        return status_IndexAccessOperations
    }
    [[log(label: "operations-log-transition")]]
    [[log(label: "operations-log-transition")]]
    let status_ProcedureCallOperations: i32 = RunProcedureCallOperations(ctx)
    if (status_ProcedureCallOperations != 0) {
        [[log(label: "operations-log-transition")]]
        [[log(label: "operations-log-section_end")]]
        return status_ProcedureCallOperations
    }
    [[log(label: "operations-log-transition")]]
    [[log(label: "operations-log-transition")]]
    let status_GenericCallTypeArgumentOperations: i32 = RunGenericCallTypeArgumentOperations(ctx)
    if (status_GenericCallTypeArgumentOperations != 0) {
        [[log(label: "operations-log-transition")]]
        [[log(label: "operations-log-section_end")]]
        return status_GenericCallTypeArgumentOperations
    }
    [[log(label: "operations-log-transition")]]
    [[log(label: "operations-log-transition")]]
    let status_MethodAndStaticDispatchOperations: i32 = RunMethodAndStaticDispatchOperations(ctx)
    if (status_MethodAndStaticDispatchOperations != 0) {
        [[log(label: "operations-log-transition")]]
        [[log(label: "operations-log-section_end")]]
        return status_MethodAndStaticDispatchOperations
    }
    [[log(label: "operations-log-transition")]]
    [[log(label: "operations-log-transition")]]
    let status_PipelineOperations: i32 = RunPipelineOperations(ctx)
    if (status_PipelineOperations != 0) {
        [[log(label: "operations-log-transition")]]
        [[log(label: "operations-log-section_end")]]
