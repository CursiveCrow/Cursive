    let feature_PipelineOperations: string@View = "AccessAndInvocation::PipelineOperations"
    let feature_PropagationOperatorOperations: string@View = "AccessAndInvocation::PropagationOperatorOperations"
    let feature_MoveAndPartialMoveOperations: string@View = "AccessAndInvocation::MoveAndPartialMoveOperations"

    [[log(label: "operations-log-section_start")]]
    [[log(label: "operations-log-transition")]]
    let status_FieldAccessOperations: i32 = RunFieldAccessOperations(ctx)
    if (status_FieldAccessOperations != 0) {
        [[log(label: "operations-log-transition")]]
        [[log(label: "operations-log-section_end")]]
        return status_FieldAccessOperations
    }
    [[log(label: "operations-log-transition")]]
    [[log(label: "operations-log-transition")]]
    let status_TupleElementAccessOperations: i32 = RunTupleElementAccessOperations(ctx)
    if (status_TupleElementAccessOperations != 0) {
        [[log(label: "operations-log-transition")]]
        [[log(label: "operations-log-section_end")]]
