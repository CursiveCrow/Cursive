procedure PropagationMaybeDouble(value: i32) -> i32 | bool {
    if (value > 0) {
        return value * 2
    }
    return false
}

procedure PropagationCompute(value: i32) -> bool {
    let doubled: i32 = PropagationMaybeDouble(value)?
    let computed: i32 = doubled + 1
    return computed == 7
}

procedure PropagationComputeNested(value: i32) -> bool {
    let first: i32 = PropagationMaybeDouble(value)?
    let second: i32 = PropagationMaybeDouble(first)?
    return second == 8
}

procedure LogPropagationObject(
    fs: $FileSystem,
    scope: string@View,
    move object_name: string@View,
    move object_type: string@View,
    move state: string@View,
    move details: string@View
) -> () {
    [[log(label: "operations-log-object")]]
}

procedure PropagationMetricLabel(value: i32) -> string@View {
    if (value == 1) {
        return "1"
    }
    if (value == 7) {
        return "7"
    }
    if (value == 10) {
        return "10"
    }
    if (value == 11) {
        return "11"
    }
    return "other"
}

procedure RunPropagationOperatorOperationsItem(
    ctx: Context,
    scope: string@View,
    move item_name: string@View,
    move item_details: string@View,
    move item_reason: string@View,
    move step_name: string@View,
    move step_detail: string@View,
    move expected: string@View,
    move actual_pass: string@View,
    move actual_fail: string@View,
    move passed: bool,
    move failure_reason: string@View
) -> i32 {
    let detail_begin: string@View = "operation feature item exercise start"
    [[log(label: "operations-log-item_begin")]]
    let passed_place: bool = passed
    let item_check_log: bool = [[log(label: "observed-item-check-pass", expected: true)]] passed_place
    let item_check_ok: bool = passed_place && (item_check_log == true)
    if (item_check_ok == false) {
        [[log(label: "operations-log-transition")]]
        [[log(label: "operations-log-item_fail")]]
        return 1
    }

    [[log(label: "operations-log-operations_item_success")]]
    return 0
}

procedure VerifyPropagationOperatorOperationsItem(ctx: Context, scope: string@View, move item_index: i32, move item_name: string@View) -> i32 {
    [[log(label: "operations-log-runtime_phase_move")]]
    LogPropagationObject(ctx.fs, scope, "propagation_input_success", "i32", "constructed", "success-path source for `?` propagation prepared")
    LogPropagationObject(ctx.fs, scope, "propagation_input_failure", "i32", "constructed", "failure-path source for `?` propagation prepared")

    [[log(label: "operations-log-runtime_phase_move")]]
    [[log(label: "operations-log-transition_move")]]
    let propagation_syntax_ok: bool = PropagationCompute(3)
    let propagation_syntax_metric: i32 = if (propagation_syntax_ok) { 7 } else { 0 }
    [[log(label: "operations-log-transition_move")]]
    [[log(label: "operations-log-transition_move")]]
    let propagation_static_ok: bool = PropagationComputeNested(2)
    let propagation_static_metric: i32 = if (propagation_static_ok) { 10 } else { 0 }
    [[log(label: "operations-log-transition_move")]]
    [[log(label: "operations-log-transition_move")]]
    let propagation_failure_ok: bool = PropagationComputeNested(0) == false
    let propagation_failure_metric: i32 = if (propagation_failure_ok) { 1 } else { 0 }
    [[log(label: "operations-log-transition_move")]]
    let propagation_runtime_metric: i32 = propagation_static_metric + propagation_failure_metric

    let observed_syntax_step: string@View = "observed-propagation-operator-syntax-metric"
    let observed_static_step: string@View = "observed-propagation-operator-static-metric"
    let observed_runtime_step: string@View = "observed-propagation-operator-runtime-metric"
    let expected_syntax: string@View = "7"
    let expected_static: string@View = "10"
    let expected_runtime: string@View = "11"
    let syntax_label: string@View = PropagationMetricLabel(propagation_syntax_metric)
    let static_label: string@View = PropagationMetricLabel(propagation_static_metric)
    let runtime_label: string@View = PropagationMetricLabel(propagation_runtime_metric)
    let syntax_passed: bool = propagation_syntax_metric == 7
    let static_passed: bool = propagation_static_metric == 10
    let runtime_passed: bool = propagation_runtime_metric == 11

    let syntax_passed_log_actual = [[log(label: "observed-propagation-operator-syntax-metric", expected: "7")]] syntax_label
    let syntax_passed_with_log: bool = syntax_passed && (syntax_passed_log_actual == syntax_label)
    let static_passed_log_actual = [[log(label: "observed-propagation-operator-static-metric", expected: "10")]] static_label
    let static_passed_with_log: bool = static_passed && (static_passed_log_actual == static_label)
    let runtime_passed_log_actual = [[log(label: "observed-propagation-operator-runtime-metric", expected: "11")]] runtime_label
    let runtime_passed_with_log: bool = runtime_passed && (runtime_passed_log_actual == runtime_label)
    [[log(label: "operations-log-runtime_phase_move")]]
    if (item_index == 0) {
        return RunPropagationOperatorOperationsItem(
            ctx,
            scope,
            "PropagationOperatorOperationsSyntaxForms",
            "`?` postfix propagation syntax and parse boundaries in expression contexts",
            "validated propagation-operator syntax forms",
            "propagation-operator-syntax",
            "parse and evaluate single-level `?` propagation expression",
            "7",
            "7",
            "not-7",
            move syntax_passed_with_log,
            "propagation-operator syntax forms check failed"
        )
    }

    if (item_index == 1) {
        return RunPropagationOperatorOperationsItem(
            ctx,
            scope,
            "PropagationOperatorOperationsStaticSemantics",
            "type flow through propagated union channels and nested `?` typing",
            "validated propagation-operator static semantics",
            "propagation-operator-static",
            "type-check nested `?` propagation across multi-step union-return procedures",
            "10",
            "10",
            "not-10",
            move static_passed_with_log,
            "propagation-operator static semantics check failed"
        )
    }

    if (item_index == 2) {
        return RunPropagationOperatorOperationsItem(
            ctx,
            scope,
            "PropagationOperatorOperationsRuntimeDiagnostics",
            "runtime early-return behavior when propagated union carries non-success branch",
            "validated propagation-operator runtime behavior and diagnostics",
            "propagation-operator-runtime",
            "execute failing propagation path and verify early-propagation aggregate",
            "11",
            "11",
            "not-11",
            move runtime_passed_with_log,
            "propagation-operator runtime diagnostics check failed"
        )
    }

    return RunPropagationOperatorOperationsItem(
        ctx,
        scope,
        move item_name,
        "unknown propagation-operator operation item",
        "failed unknown propagation-operator operation item",
        "item-resolution",
        "resolve propagation-operator operation item name",
        "known-item",
        "known-item",
        "unknown-item",
        false,
        "unknown propagation-operator operation item"
    )
}

procedure RunPropagationOperatorOperations(ctx: Context) -> i32 {
    let scope: string@View = "operations::AccessAndInvocation::PropagationOperatorOperations"
    let checkpoint: string@View = "covered propagation operator operations operation items"

    let status_syntax: i32 = VerifyPropagationOperatorOperationsItem(ctx, scope, 0, "PropagationOperatorOperationsSyntaxForms")
    if (status_syntax != 0) {
        return status_syntax
    }

    let status_static: i32 = VerifyPropagationOperatorOperationsItem(ctx, scope, 1, "PropagationOperatorOperationsStaticSemantics")
    if (status_static != 0) {
        return status_static
    }

    let status_runtime: i32 = VerifyPropagationOperatorOperationsItem(ctx, scope, 2, "PropagationOperatorOperationsRuntimeDiagnostics")
    if (status_runtime != 0) {
        return status_runtime
    }

    [[log(label: "operations-log-checkpoint")]]
    return 0
}
