procedure PipelineAddOne(value: i32) -> i32 {
    return value + 1
}

procedure PipelineTimesTwo(value: i32) -> i32 {
    return value * 2
}

procedure PipelineMinusThree(value: i32) -> i32 {
    return value - 3
}

procedure LogPipelineObject(
    fs: $FileSystem,
    scope: string@View,
    move object_name: string@View,
    move object_type: string@View,
    move state: string@View,
    move details: string@View
) -> () {
    [[log(label: "operations-log-object")]]
}

procedure PipelineMetricLabel(value: i32) -> string@View {
    if (value == 7) {
        return "7"
    }
    if (value == 8) {
        return "8"
    }
    if (value == 9) {
        return "9"
    }
    if (value == 17) {
        return "17"
    }
    return "other"
}

procedure RunPipelineOperationsItem(
    ctx: Context,
    scope: string@View,
    move item_name: string@View,
    move item_details: string@View,
    move item_reason: string@View,
    move step_name: string@View,
    move step_detail: string@View,
    move expected: string@View,
    move actual_pass: string@View,
    move actual_fail: string@View,
    move passed: bool,
    move failure_reason: string@View
) -> i32 {
    let detail_begin: string@View = "operation feature item exercise start"
    [[log(label: "operations-log-item_begin")]]
    let passed_place: bool = passed
    let item_check_log: bool = [[log(label: "observed-item-check-pass", expected: true)]] passed_place
    let item_check_ok: bool = passed_place && (item_check_log == true)
    if (item_check_ok == false) {
        [[log(label: "operations-log-transition")]]
        [[log(label: "operations-log-item_fail")]]
        return 1
    }

    [[log(label: "operations-log-operations_item_success")]]
    return 0
}

procedure VerifyPipelineOperationsItem(ctx: Context, scope: string@View, move item_index: i32, move item_name: string@View) -> i32 {
    [[log(label: "operations-log-runtime_phase_move")]]
    let pipeline_seed_syntax: i32 = 3
    let pipeline_seed_static: i32 = 5
    let pipeline_seed_runtime: i32 = 5
    LogPipelineObject(ctx.fs, scope, "pipeline_seed_syntax", "i32", "constructed", "pipeline syntax seed prepared")
    LogPipelineObject(ctx.fs, scope, "pipeline_seed_static", "i32", "constructed", "pipeline static typing seed prepared")
    LogPipelineObject(ctx.fs, scope, "pipeline_seed_runtime", "i32", "constructed", "pipeline runtime chaining seed prepared")

    [[log(label: "operations-log-runtime_phase_move")]]
    [[log(label: "operations-log-transition_move")]]
    let pipeline_syntax_metric: i32 = pipeline_seed_syntax => PipelineAddOne => PipelineTimesTwo
    [[log(label: "operations-log-transition_move")]]
    [[log(label: "operations-log-transition_move")]]
    let pipeline_static_metric: i32 = pipeline_seed_static => PipelineTimesTwo => PipelineMinusThree
    [[log(label: "operations-log-transition_move")]]
    [[log(label: "operations-log-transition_move")]]
    let pipeline_runtime_stage: i32 = pipeline_seed_runtime => PipelineAddOne => PipelineTimesTwo => PipelineMinusThree
    let pipeline_runtime_metric: i32 = pipeline_runtime_stage + pipeline_syntax_metric
    [[log(label: "operations-log-transition_move")]]
    let observed_syntax_step: string@View = "observed-pipeline-syntax-metric"
    let observed_static_step: string@View = "observed-pipeline-static-metric"
    let observed_runtime_step: string@View = "observed-pipeline-runtime-metric"
    let expected_syntax: string@View = "8"
    let expected_static: string@View = "7"
    let expected_runtime: string@View = "17"
    let syntax_label: string@View = PipelineMetricLabel(pipeline_syntax_metric)
    let static_label: string@View = PipelineMetricLabel(pipeline_static_metric)
    let runtime_label: string@View = PipelineMetricLabel(pipeline_runtime_metric)
    let syntax_passed: bool = pipeline_syntax_metric == 8
    let static_passed: bool = pipeline_static_metric == 7
    let runtime_passed: bool = pipeline_runtime_metric == 17

    let syntax_passed_log_actual = [[log(label: "observed-pipeline-syntax-metric", expected: "8")]] syntax_label
    let syntax_passed_with_log: bool = syntax_passed && (syntax_passed_log_actual == syntax_label)
    let static_passed_log_actual = [[log(label: "observed-pipeline-static-metric", expected: "7")]] static_label
    let static_passed_with_log: bool = static_passed && (static_passed_log_actual == static_label)
    let runtime_passed_log_actual = [[log(label: "observed-pipeline-runtime-metric", expected: "17")]] runtime_label
    let runtime_passed_with_log: bool = runtime_passed && (runtime_passed_log_actual == runtime_label)
    [[log(label: "operations-log-runtime_phase_move")]]
    if (item_index == 0) {
        return RunPipelineOperationsItem(
            ctx,
            scope,
            "PipelineOperationsSyntaxForms",
            "pipeline operator syntax form `lhs => rhs` with chained postfix pipelines",
            "validated pipeline syntax forms",
            "pipeline-syntax",
            "parse and evaluate chained pipeline syntax across two stages",
            "8",
            "8",
            "not-8",
            move syntax_passed_with_log,
            "pipeline syntax forms check failed"
        )
    }

    if (item_index == 1) {
        return RunPipelineOperationsItem(
            ctx,
            scope,
            "PipelineOperationsStaticSemantics",
            "pipeline stage input/output typing and intermediate compatibility",
            "validated pipeline static semantics",
            "pipeline-static",
            "type-check compatible stage chaining across intermediate outputs",
            "7",
            "7",
            "not-7",
            move static_passed_with_log,
            "pipeline static semantics check failed"
        )
    }

    if (item_index == 2) {
        return RunPipelineOperationsItem(
            ctx,
            scope,
            "PipelineOperationsRuntimeDiagnostics",
            "runtime pipeline stage execution order and aggregate result production",
            "validated pipeline runtime behavior and diagnostics",
            "pipeline-runtime",
            "execute multi-stage pipeline path and verify runtime aggregate metric",
            "17",
            "17",
            "not-17",
            move runtime_passed_with_log,
            "pipeline runtime diagnostics check failed"
        )
    }

    return RunPipelineOperationsItem(
        ctx,
        scope,
        move item_name,
        "unknown pipeline operation item",
        "failed unknown pipeline operation item",
        "item-resolution",
        "resolve pipeline operation item name",
        "known-item",
        "known-item",
        "unknown-item",
        false,
        "unknown pipeline operation item"
    )
}

procedure RunPipelineOperations(ctx: Context) -> i32 {
    let scope: string@View = "operations::AccessAndInvocation::PipelineOperations"
    let checkpoint: string@View = "covered pipeline operations operation items"

    let status_syntax: i32 = VerifyPipelineOperationsItem(ctx, scope, 0, "PipelineOperationsSyntaxForms")
    if (status_syntax != 0) {
        return status_syntax
    }

    let status_static: i32 = VerifyPipelineOperationsItem(ctx, scope, 1, "PipelineOperationsStaticSemantics")
    if (status_static != 0) {
        return status_static
    }

    let status_runtime: i32 = VerifyPipelineOperationsItem(ctx, scope, 2, "PipelineOperationsRuntimeDiagnostics")
    if (status_runtime != 0) {
        return status_runtime
    }

    [[log(label: "operations-log-checkpoint")]]
    return 0
}
