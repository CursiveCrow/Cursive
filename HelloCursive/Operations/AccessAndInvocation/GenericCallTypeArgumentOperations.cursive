procedure GenericCallIdentity<T>(value: T) -> T {
    return value
}

procedure GenericCallChooseLeft<T>(left: T, right: T) -> T {
    let _discard: T = right
    return left
}

procedure LogGenericCallTypeArgObject(
    fs: $FileSystem,
    scope: string@View,
    move object_name: string@View,
    move object_type: string@View,
    move state: string@View,
    move details: string@View
) -> () {
    [[log(label: "operations-log-object")]]
}

procedure GenericCallTypeArgMetricLabel(value: i32) -> string@View {
    if (value == 5) {
        return "5"
    }
    if (value == 7) {
        return "7"
    }
    if (value == 10) {
        return "10"
    }
    return "other"
}

procedure RunGenericCallTypeArgItem(
    ctx: Context,
    scope: string@View,
    move item_name: string@View,
    move item_details: string@View,
    move item_reason: string@View,
    move step_name: string@View,
    move step_detail: string@View,
    move expected: string@View,
    move actual_pass: string@View,
    move actual_fail: string@View,
    move passed: bool,
    move failure_reason: string@View
) -> i32 {
    [[log(label: "operations-log-item_begin")]]
    let passed_place: bool = passed
    let item_check_log: bool = [[log(label: "observed-item-check-pass", expected: true)]] passed_place
    let item_check_ok: bool = passed_place && (item_check_log == true)
    if (item_check_ok == false) {
        [[log(label: "operations-log-transition")]]
        [[log(label: "operations-log-item_fail")]]
        return 1
    }

    [[log(label: "operations-log-operations_item_success")]]
    return 0
}

procedure VerifyGenericCallTypeArgItem(ctx: Context, scope: string@View, move item_index: i32, move item_name: string@View) -> i32 {
    [[log(label: "operations-log-runtime_phase_move")]]
    LogGenericCallTypeArgObject(ctx.fs, scope, "generic_identity_call", "CallTypeArgs<T>", "constructed", "generic identity call-site probe prepared")
    LogGenericCallTypeArgObject(ctx.fs, scope, "generic_choose_left_call", "CallTypeArgs<T>", "constructed", "generic choose-left call-site probe prepared")
    LogGenericCallTypeArgObject(ctx.fs, scope, "generic_runtime_aggregate", "CallTypeArgs<T>", "constructed", "runtime aggregate call-type-args probe prepared")

    [[log(label: "operations-log-runtime_phase_move")]]
    [[log(label: "operations-log-transition_move")]]
    let syntax_metric: i32 = GenericCallIdentity<i32>(5)
    [[log(label: "operations-log-transition_move")]]
    [[log(label: "operations-log-transition_move")]]
    let static_metric: i32 = GenericCallChooseLeft<i32>(7, 1)
    [[log(label: "operations-log-transition_move")]]
    [[log(label: "operations-log-transition_move")]]
    let runtime_metric: i32 = GenericCallIdentity<i32>(3) + GenericCallChooseLeft<i32>(7, 2)
    [[log(label: "operations-log-transition_move")]]
    let syntax_passed: bool = syntax_metric == 5
    let static_passed: bool = static_metric == 7
    let runtime_passed: bool = runtime_metric == 10

    let actual_label_1: string@View = GenericCallTypeArgMetricLabel(syntax_metric)
    let syntax_passed_log_actual = [[log(label: "observed-generic-call-type-args-syntax-metric", expected: "5")]] actual_label_1
    let syntax_passed_with_log: bool = syntax_passed && (syntax_passed_log_actual == actual_label_1)
    let actual_label_2: string@View = GenericCallTypeArgMetricLabel(static_metric)
    let static_passed_log_actual = [[log(label: "observed-generic-call-type-args-static-metric", expected: "7")]] actual_label_2
    let static_passed_with_log: bool = static_passed && (static_passed_log_actual == actual_label_2)
    let actual_label_3: string@View = GenericCallTypeArgMetricLabel(runtime_metric)
    let runtime_passed_log_actual = [[log(label: "observed-generic-call-type-args-runtime-metric", expected: "10")]] actual_label_3
    let runtime_passed_with_log: bool = runtime_passed && (runtime_passed_log_actual == actual_label_3)
    [[log(label: "operations-log-runtime_phase_move")]]
    if (item_index == 0) {
        return RunGenericCallTypeArgItem(
            ctx,
            scope,
            "GenericCallTypeArgumentOperationsSyntaxForms",
            "syntax forms for explicit generic call type arguments `callee<T>(...)`",
            "validated generic call type argument operations syntax forms",
            "generic-call-type-args-syntax",
            "evaluate explicit type-argument generic identity call",
            "5",
            "5",
            "not-5",
            move syntax_passed_with_log,
            "generic call type-argument syntax forms check failed"
        )
    }

    if (item_index == 1) {
        return RunGenericCallTypeArgItem(
            ctx,
            scope,
            "GenericCallTypeArgumentOperationsStaticSemantics",
            "generic call instantiation semantics and argument typing under explicit call type args",
            "validated generic call type argument operations static semantics",
            "generic-call-type-args-static",
            "type-check explicit type-argument invocation for generic choose-left call",
            "7",
            "7",
            "not-7",
            move static_passed_with_log,
            "generic call type-argument static semantics check failed"
        )
    }

    if (item_index == 2) {
        return RunGenericCallTypeArgItem(
            ctx,
            scope,
            "GenericCallTypeArgumentOperationsRuntimeDiagnostics",
            "runtime behavior for repeated explicit generic call instantiations",
            "validated generic call type argument operations runtime behavior and diagnostics",
            "generic-call-type-args-runtime",
            "execute composed explicit generic calls and verify runtime aggregate metric",
            "10",
            "10",
            "not-10",
            move runtime_passed_with_log,
            "generic call type-argument runtime diagnostics check failed"
        )
    }

    return RunGenericCallTypeArgItem(
        ctx,
        scope,
        move item_name,
        "unknown generic call type-argument operation item",
        "failed unknown generic call type-argument operation item",
        "item-resolution",
        "resolve generic call type-argument operation item name",
        "known-item",
        "known-item",
        "unknown-item",
        false,
        "unknown generic call type-argument operation item"
    )
}

procedure RunGenericCallTypeArgumentOperations(ctx: Context) -> i32 {
    let scope: string@View = "operations::AccessAndInvocation::GenericCallTypeArgumentOperations"
    let checkpoint: string@View = "covered generic call type argument operations operation items"

    let status_syntax: i32 = VerifyGenericCallTypeArgItem(ctx, scope, 0, "GenericCallTypeArgumentOperationsSyntaxForms")
    if (status_syntax != 0) {
        return status_syntax
    }

    let status_static: i32 = VerifyGenericCallTypeArgItem(ctx, scope, 1, "GenericCallTypeArgumentOperationsStaticSemantics")
    if (status_static != 0) {
        return status_static
    }

    let status_runtime: i32 = VerifyGenericCallTypeArgItem(ctx, scope, 2, "GenericCallTypeArgumentOperationsRuntimeDiagnostics")
    if (status_runtime != 0) {
        return status_runtime
    }

    [[log(label: "operations-log-checkpoint")]]
    return 0
}
