public record PatternRecordProbe {
    left: i32
    right: i32
}

modal PatternModalProbe {
    @Cold {
        code: i32
    }
    @Hot {
        code: i32
    }
}

procedure LogRecordModalPatternObject(
    fs: $FileSystem,
    scope: string@View,
    move object_name: string@View,
    move object_type: string@View,
    move state: string@View,
    move details: string@View
) -> () {
    }

procedure RecordModalPatternMetricLabel(value: i32) -> string@View {
    if (value == 7) {
        return "7"
    }
    if (value == 8) {
        return "8"
    }
    if (value == 10) {
        return "10"
    }
    return "other"
}

procedure RunRecordModalPatternItem(
    ctx: Context,
    scope: string@View,
    move item_name: string@View,
    move item_details: string@View,
    move item_reason: string@View,
    move step_name: string@View,
    move step_detail: string@View,
    move expected: string@View,
    move actual_pass: string@View,
    move actual_fail: string@View,
    move passed: bool,
    move failure_reason: string@View
) -> i32 {
    let passed_place: bool = passed
    let item_check_log: bool = passed_place
    let item_check_ok: bool = passed_place && (item_check_log == true)
    if (item_check_ok == false) {
        return 1
    }

    return 0
}

procedure VerifyRecordModalPatternItem(ctx: Context, scope: string@View, move item_index: i32, move item_name: string@View) -> i32 {
    let record_scrutinee: PatternRecordProbe = PatternRecordProbe { left: 3, right: 4 }
    let modal_scrutinee: PatternModalProbe = widen(PatternModalProbe@Hot { code: 5 })
    let runtime_record_scrutinee: PatternRecordProbe = PatternRecordProbe { left: 6, right: 1 }
    let runtime_modal_scrutinee: PatternModalProbe = widen(PatternModalProbe@Cold { code: 4 })

    LogRecordModalPatternObject(ctx.fs, scope, "record_scrutinee", "PatternRecordProbe", "constructed", "record scrutinee for record-pattern matching prepared")
    LogRecordModalPatternObject(ctx.fs, scope, "modal_scrutinee", "PatternModalProbe", "constructed", "modal scrutinee for modal-pattern matching prepared")
    LogRecordModalPatternObject(ctx.fs, scope, "runtime_record_scrutinee", "PatternRecordProbe", "constructed", "runtime record-pattern aggregate probe prepared")
    LogRecordModalPatternObject(ctx.fs, scope, "runtime_modal_scrutinee", "PatternModalProbe", "constructed", "runtime modal-pattern aggregate probe prepared")

    let syntax_metric: i32 = if record_scrutinee is {
        PatternRecordProbe { left: left_value, right: right_value } { left_value + right_value }
    }
    let static_metric: i32 = if modal_scrutinee is {
        @Cold { code: cold_code } { cold_code }
        @Hot { code: hot_code } { hot_code + 3 }
    }
    let runtime_record_metric: i32 = if runtime_record_scrutinee is {
        PatternRecordProbe { left: runtime_left, right: _ } { runtime_left + 1 }
    }
    let runtime_modal_metric: i32 = if runtime_modal_scrutinee is {
        @Cold { code: cold_code } { cold_code + 5 }
        @Hot { code: hot_code } { hot_code }
    }
    let runtime_metric: i32 = runtime_record_metric + runtime_modal_metric - 6

    let syntax_passed: bool = syntax_metric == 7
    let static_passed: bool = static_metric == 8
    let runtime_passed: bool = runtime_metric == 10

    let actual_label_1: string@View = RecordModalPatternMetricLabel(syntax_metric)
    let syntax_passed_log_actual = actual_label_1
    let syntax_passed_with_log: bool = syntax_passed && (syntax_passed_log_actual == actual_label_1)
    let actual_label_2: string@View = RecordModalPatternMetricLabel(static_metric)
    let static_passed_log_actual = actual_label_2
    let static_passed_with_log: bool = static_passed && (static_passed_log_actual == actual_label_2)
    let actual_label_3: string@View = RecordModalPatternMetricLabel(runtime_metric)
    let runtime_passed_log_actual = actual_label_3
    let runtime_passed_with_log: bool = runtime_passed && (runtime_passed_log_actual == actual_label_3)
    if (item_index == 0) {
        return RunRecordModalPatternItem(
            ctx,
            scope,
            "RecordAndModalPatternOperationsSyntaxForms",
            "record pattern syntax forms with explicit field-pattern bindings",
            "validated record/modal pattern operations syntax forms",
            "record-modal-pattern-syntax",
            "evaluate record-pattern syntax with explicit field pattern bindings",
            "7",
            "7",
            "not-7",
            move syntax_passed_with_log,
            "record/modal pattern syntax forms check failed"
        )
    }

    if (item_index == 1) {
        return RunRecordModalPatternItem(
            ctx,
            scope,
            "RecordAndModalPatternOperationsStaticSemantics",
            "modal pattern state matching and state-payload typing",
            "validated record/modal pattern operations static semantics",
            "record-modal-pattern-static",
            "type-check modal state-pattern arms and payload binding types",
            "8",
            "8",
            "not-8",
            move static_passed_with_log,
            "record/modal pattern static semantics check failed"
        )
    }

    if (item_index == 2) {
        return RunRecordModalPatternItem(
            ctx,
            scope,
            "RecordAndModalPatternOperationsRuntimeDiagnostics",
            "runtime selected-arm behavior for record and modal pattern matches",
            "validated record/modal pattern operations runtime behavior and diagnostics",
            "record-modal-pattern-runtime",
            "execute combined record/modal pattern paths and verify runtime aggregate metric",
            "10",
            "10",
            "not-10",
            move runtime_passed_with_log,
            "record/modal pattern runtime diagnostics check failed"
        )
    }

    return RunRecordModalPatternItem(
        ctx,
        scope,
        move item_name,
        "unknown record/modal pattern operation item",
        "failed unknown record/modal pattern operation item",
        "item-resolution",
        "resolve record/modal pattern operation item name",
        "known-item",
        "known-item",
        "unknown-item",
        false,
        "unknown record/modal pattern operation item"
    )
}

procedure RunRecordAndModalPatternOperations(ctx: Context) -> i32 {
    let scope: string@View = "operations::ControlFlowExpressions::RecordAndModalPatternOperations"
    let checkpoint: string@View = "covered record and modal pattern operations operation items"

    let status_syntax: i32 = VerifyRecordModalPatternItem(ctx, scope, 0, "RecordAndModalPatternOperationsSyntaxForms")
    if (status_syntax != 0) {
        return status_syntax
    }

    let status_static: i32 = VerifyRecordModalPatternItem(ctx, scope, 1, "RecordAndModalPatternOperationsStaticSemantics")
    if (status_static != 0) {
        return status_static
    }

    let status_runtime: i32 = VerifyRecordModalPatternItem(ctx, scope, 2, "RecordAndModalPatternOperationsRuntimeDiagnostics")
    if (status_runtime != 0) {
        return status_runtime
    }

    return 0
}
