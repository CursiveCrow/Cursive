procedure LogLoopControlObject(
    fs: $FileSystem,
    scope: string@View,
    move object_name: string@View,
    move object_type: string@View,
    move state: string@View,
    move details: string@View
) -> () {
    [[log(label: "operations-log-object")]]
}

procedure LoopControlMetricLabel(value: i32) -> string@View {
    if (value == 3) {
        return "3"
    }
    if (value == 7) {
        return "7"
    }
    if (value == 12) {
        return "12"
    }
    return "other"
}

procedure RunLabeledLoopControlOperationsItem(
    ctx: Context,
    scope: string@View,
    move item_name: string@View,
    move item_details: string@View,
    move item_reason: string@View,
    move step_name: string@View,
    move step_detail: string@View,
    move expected: string@View,
    move actual_pass: string@View,
    move actual_fail: string@View,
    move passed: bool,
    move failure_reason: string@View
) -> i32 {
    let detail_begin: string@View = "operation feature item exercise start"
    [[log(label: "operations-log-item_begin")]]
    let passed_place: bool = passed
    let item_check_log: bool = [[log(label: "observed-item-check-pass", expected: true)]] passed_place
    let item_check_ok: bool = passed_place && (item_check_log == true)
    if (item_check_ok == false) {
        [[log(label: "operations-log-transition")]]
        [[log(label: "operations-log-item_fail")]]
        return 1
    }

    [[log(label: "operations-log-operations_item_success")]]
    return 0
}

procedure VerifyLabeledLoopControlOperationsItem(ctx: Context, scope: string@View, move item_index: i32, move item_name: string@View) -> i32 {
    [[log(label: "operations-log-runtime_phase_move")]]
    var continue_counter: i32 = 0
    var nested_outer: i32 = 0
    var control_sum: i32 = 0
    LogLoopControlObject(ctx.fs, scope, "continue_counter", "i32", "constructed", "counter for continue-and-break loop expression prepared")
    LogLoopControlObject(ctx.fs, scope, "nested_outer", "i32", "constructed", "outer counter for nested loop control prepared")
    LogLoopControlObject(ctx.fs, scope, "control_sum", "i32", "constructed", "accumulator for iterator control statements prepared")

    [[log(label: "operations-log-runtime_phase_move")]]
    [[log(label: "operations-log-transition_move")]]
    let control_syntax_metric: i32 = loop {
        continue_counter = continue_counter + 1
        if (continue_counter < 3) {
            continue
        }
        break continue_counter
    }
    [[log(label: "operations-log-transition_move")]]
    [[log(label: "operations-log-transition_move")]]
    let control_static_metric: i32 = loop {
        nested_outer = nested_outer + 1
        let inner_value: i32 = loop {
            if (nested_outer == 2) {
                break 5
            }
            break 1
        }
        if (nested_outer == 2) {
            break inner_value + nested_outer
        }
    }
    [[log(label: "operations-log-transition_move")]]
    [[log(label: "operations-log-transition_move")]]
    let control_values: [i32; 5] = [0, 1, 2, 3, 4]
    loop item in control_values {
        if (item == 1) {
            continue
        }
        if (item == 4) {
            break
        }
        control_sum = control_sum + item
    }
    let control_runtime_metric: i32 = control_static_metric + control_sum
    [[log(label: "operations-log-transition_move")]]
    let syntax_passed: bool = control_syntax_metric == 3
    let static_passed: bool = control_static_metric == 7
    let runtime_passed: bool = control_runtime_metric == 12

    let actual_label_1: string@View = LoopControlMetricLabel(control_syntax_metric)
    let syntax_passed_log_actual = [[log(label: "observed-loop-control-syntax-metric", expected: "3")]] actual_label_1
    let syntax_passed_with_log: bool = syntax_passed && (syntax_passed_log_actual == actual_label_1)
    let actual_label_2: string@View = LoopControlMetricLabel(control_static_metric)
    let static_passed_log_actual = [[log(label: "observed-loop-control-static-metric", expected: "7")]] actual_label_2
    let static_passed_with_log: bool = static_passed && (static_passed_log_actual == actual_label_2)
    let actual_label_3: string@View = LoopControlMetricLabel(control_runtime_metric)
    let runtime_passed_log_actual = [[log(label: "observed-loop-control-runtime-metric", expected: "12")]] actual_label_3
    let runtime_passed_with_log: bool = runtime_passed && (runtime_passed_log_actual == actual_label_3)
    [[log(label: "operations-log-runtime_phase_move")]]
    if (item_index == 0) {
        return RunLabeledLoopControlOperationsItem(
            ctx,
            scope,
            "LabeledLoopControlOperationsSyntaxForms",
            "break/continue statement syntax surfaces within loop expressions",
            "validated loop-control syntax forms",
            "loop-control-syntax",
            "parse and evaluate continue then break control path",
            "3",
            "3",
            "not-3",
            move syntax_passed_with_log,
            "loop-control syntax forms check failed"
        )
    }

    if (item_index == 1) {
        return RunLabeledLoopControlOperationsItem(
            ctx,
            scope,
            "LabeledLoopControlOperationsStaticSemantics",
            "nested loop break-value typing and control-flow join typing",
            "validated loop-control static semantics",
            "loop-control-static",
            "type-check nested break-value flow across inner and outer loops",
            "7",
            "7",
            "not-7",
            move static_passed_with_log,
            "loop-control static semantics check failed"
        )
    }

    if (item_index == 2) {
        return RunLabeledLoopControlOperationsItem(
            ctx,
            scope,
            "LabeledLoopControlOperationsRuntimeDiagnostics",
            "runtime continue/break execution order through iterator and nested loop paths",
            "validated loop-control runtime behavior and diagnostics",
            "loop-control-runtime",
            "execute iterator and nested control paths and verify runtime aggregate",
            "12",
            "12",
            "not-12",
            move runtime_passed_with_log,
            "loop-control runtime diagnostics check failed"
        )
    }

    return RunLabeledLoopControlOperationsItem(
        ctx,
        scope,
        move item_name,
        "unknown loop-control operation item",
        "failed unknown loop-control operation item",
        "item-resolution",
        "resolve loop-control operation item name",
        "known-item",
        "known-item",
        "unknown-item",
        false,
        "unknown loop-control operation item"
    )
}

procedure RunLabeledLoopControlOperations(ctx: Context) -> i32 {
    let scope: string@View = "operations::ControlFlowExpressions::LabeledLoopControlOperations"
    let checkpoint: string@View = "covered labeled loop control operations operation items"

    let status_syntax: i32 = VerifyLabeledLoopControlOperationsItem(ctx, scope, 0, "LabeledLoopControlOperationsSyntaxForms")
    if (status_syntax != 0) {
        return status_syntax
    }

    let status_static: i32 = VerifyLabeledLoopControlOperationsItem(ctx, scope, 1, "LabeledLoopControlOperationsStaticSemantics")
    if (status_static != 0) {
        return status_static
    }

    let status_runtime: i32 = VerifyLabeledLoopControlOperationsItem(ctx, scope, 2, "LabeledLoopControlOperationsRuntimeDiagnostics")
    if (status_runtime != 0) {
        return status_runtime
    }

    [[log(label: "operations-log-checkpoint")]]
    return 0
}
