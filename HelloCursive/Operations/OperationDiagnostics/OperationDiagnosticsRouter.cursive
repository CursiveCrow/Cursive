
public procedure runGroup(ctx: Context) -> i32 {
    let section_name: string@View = "operations/OperationDiagnostics"
    let status_ok: string@View = "ok"
    let status_failed: string@View = "failed"

    let phase_planned: string@View = "planned"
    let phase_running: string@View = "running"
    let phase_complete: string@View = "complete"
    let phase_failed: string@View = "failed"
    let dispatch_reason: string@View = "dispatching operation topic function"
    let complete_reason: string@View = "operation topic function completed"
    let failed_reason: string@View = "operation topic function returned non-zero status"

    let feature_OperatorAndExpressionDiagnosticMatrix: string@View = "OperationDiagnostics::OperatorAndExpressionDiagnosticMatrix"
    let feature_AssignmentAndMutationDiagnosticMatrix: string@View = "OperationDiagnostics::AssignmentAndMutationDiagnosticMatrix"
    let feature_ControlFlowAndPatternDiagnosticMatrix: string@View = "OperationDiagnostics::ControlFlowAndPatternDiagnosticMatrix"
    let feature_UnsafeAndPointerDiagnosticMatrix: string@View = "OperationDiagnostics::UnsafeAndPointerDiagnosticMatrix"
    let feature_KeySystemDiagnosticMatrix: string@View = "OperationDiagnostics::KeySystemDiagnosticMatrix"
    let feature_AsyncConcurrencyDiagnosticMatrix: string@View = "OperationDiagnostics::AsyncConcurrencyDiagnosticMatrix"
    let feature_ConcurrencyInfoDiagnosticMatrix: string@View = "OperationDiagnostics::ConcurrencyInfoDiagnosticMatrix"
    let feature_ConcurrencyWarningDiagnosticMatrix: string@View = "OperationDiagnostics::ConcurrencyWarningDiagnosticMatrix"

    let status_OperatorAndExpressionDiagnosticMatrix: i32 = RunOperatorAndExpressionDiagnosticMatrix(ctx)
    if (status_OperatorAndExpressionDiagnosticMatrix != 0) {
        return status_OperatorAndExpressionDiagnosticMatrix
    }
    let status_AssignmentAndMutationDiagnosticMatrix: i32 = RunAssignmentAndMutationDiagnosticMatrix(ctx)
    if (status_AssignmentAndMutationDiagnosticMatrix != 0) {
        return status_AssignmentAndMutationDiagnosticMatrix
    }
    let status_ControlFlowAndPatternDiagnosticMatrix: i32 = RunControlFlowAndPatternDiagnosticMatrix(ctx)
    if (status_ControlFlowAndPatternDiagnosticMatrix != 0) {
        return status_ControlFlowAndPatternDiagnosticMatrix
    }
    let status_UnsafeAndPointerDiagnosticMatrix: i32 = RunUnsafeAndPointerDiagnosticMatrix(ctx)
    if (status_UnsafeAndPointerDiagnosticMatrix != 0) {
        return status_UnsafeAndPointerDiagnosticMatrix
    }
    let status_KeySystemDiagnosticMatrix: i32 = RunKeySystemDiagnosticMatrix(ctx)
    if (status_KeySystemDiagnosticMatrix != 0) {
        return status_KeySystemDiagnosticMatrix
    }
    let status_AsyncConcurrencyDiagnosticMatrix: i32 = RunAsyncConcurrencyDiagnosticMatrix(ctx)
    if (status_AsyncConcurrencyDiagnosticMatrix != 0) {
        return status_AsyncConcurrencyDiagnosticMatrix
    }
    let status_ConcurrencyInfoDiagnosticMatrix: i32 = RunConcurrencyInfoDiagnosticMatrix(ctx)
    if (status_ConcurrencyInfoDiagnosticMatrix != 0) {
        return status_ConcurrencyInfoDiagnosticMatrix
    }
    let status_ConcurrencyWarningDiagnosticMatrix: i32 = RunConcurrencyWarningDiagnosticMatrix(ctx)
    if (status_ConcurrencyWarningDiagnosticMatrix != 0) {
        return status_ConcurrencyWarningDiagnosticMatrix
    }
    return 0
}
