procedure LogOperatorExpressionDiagnosticObject(
    fs: $FileSystem,
    scope: string@View,
    move object_name: string@View,
    move object_type: string@View,
    move state: string@View,
    move details: string@View
) -> () {
    }

procedure OperatorExpressionMetricLabel(value: i32) -> string@View {
    if (value == 8) {
        return "8"
    }
    if (value == 3) {
        return "3"
    }
    if (value == 14) {
        return "14"
    }
    return "other"
}

procedure RunOperatorExpressionDiagnosticItem(
    ctx: Context,
    scope: string@View,
    move item_name: string@View,
    move item_details: string@View,
    move item_reason: string@View,
    move step_name: string@View,
    move step_detail: string@View,
    move expected: string@View,
    move actual_pass: string@View,
    move actual_fail: string@View,
    move passed: bool,
    move failure_reason: string@View
) -> i32 {
    let passed_place: bool = passed
    let item_check_log: bool = passed_place
    let item_check_ok: bool = passed_place && (item_check_log == true)
    if (item_check_ok == false) {
        return 1
    }

    return 0
}

procedure VerifyOperatorExpressionDiagnosticItem(ctx: Context, scope: string@View, move item_index: i32, move item_name: string@View) -> i32 {
    let diag_call_callee_not_func: string@View = "E-SEM-2531"
    let diag_pipeline_not_callable: string@View = "E-SEM-2538"
    let diag_pipeline_arg_mismatch: string@View = "E-SEM-2539"

    LogOperatorExpressionDiagnosticObject(ctx.fs, scope, "operator_precedence_probe", "i32", "constructed", "operator precedence probe prepared")
    LogOperatorExpressionDiagnosticObject(ctx.fs, scope, "logical_expression_probe", "bool", "constructed", "logical expression probe prepared")
    LogOperatorExpressionDiagnosticObject(ctx.fs, scope, "diag_call_callee_not_func", "diagnostic-code", "constructed", "call-callee-not-func diagnostic mapping prepared")
    LogOperatorExpressionDiagnosticObject(ctx.fs, scope, "diag_pipeline_not_callable", "diagnostic-code", "constructed", "pipeline-not-callable diagnostic mapping prepared")
    LogOperatorExpressionDiagnosticObject(ctx.fs, scope, "diag_pipeline_arg_mismatch", "diagnostic-code", "constructed", "pipeline-arg-mismatch diagnostic mapping prepared")

    let syntax_metric: i32 = (2 + 2) * 2
    let static_metric: i32 = if ((true && !false) || false) { 3 } else { 0 }
    let diag_call_callee_not_func_ok: bool = diag_call_callee_not_func == "E-SEM-2531"
    let diag_pipeline_not_callable_ok: bool = diag_pipeline_not_callable == "E-SEM-2538"
    let diag_pipeline_arg_mismatch_ok: bool = diag_pipeline_arg_mismatch == "E-SEM-2539"

    let diag_call_callee_not_func_ok_log_actual = diag_call_callee_not_func
    let diag_call_callee_not_func_ok_with_log: bool = diag_call_callee_not_func_ok && (diag_call_callee_not_func_ok_log_actual == diag_call_callee_not_func)
    let diag_pipeline_not_callable_ok_log_actual = diag_pipeline_not_callable
    let diag_pipeline_not_callable_ok_with_log: bool = diag_pipeline_not_callable_ok && (diag_pipeline_not_callable_ok_log_actual == diag_pipeline_not_callable)
    let diag_pipeline_arg_mismatch_ok_log_actual = diag_pipeline_arg_mismatch
    let diag_pipeline_arg_mismatch_ok_with_log: bool = diag_pipeline_arg_mismatch_ok && (diag_pipeline_arg_mismatch_ok_log_actual == diag_pipeline_arg_mismatch)
    let diag_count: i32 = if (diag_call_callee_not_func_ok && diag_pipeline_not_callable_ok && diag_pipeline_arg_mismatch_ok) { 3 } else { 0 }
    let runtime_metric: i32 = syntax_metric + static_metric + diag_count

    let syntax_passed: bool = syntax_metric == 8
    let static_passed: bool = static_metric == 3
    let runtime_passed: bool = runtime_metric == 14

    let actual_label_1: string@View = OperatorExpressionMetricLabel(syntax_metric)
    let syntax_passed_log_actual = actual_label_1
    let syntax_passed_with_log: bool = syntax_passed && (syntax_passed_log_actual == actual_label_1)
    let actual_label_2: string@View = OperatorExpressionMetricLabel(static_metric)
    let static_passed_log_actual = actual_label_2
    let static_passed_with_log: bool = static_passed && (static_passed_log_actual == actual_label_2)
    let actual_label_3: string@View = OperatorExpressionMetricLabel(runtime_metric)
    let runtime_passed_log_actual = actual_label_3
    let runtime_passed_with_log: bool = runtime_passed && (runtime_passed_log_actual == actual_label_3)
    if (item_index == 0) {
        return RunOperatorExpressionDiagnosticItem(
            ctx,
            scope,
            "OperatorAndExpressionDiagnosticMatrixSyntaxForms",
            "syntax forms for arithmetic/logical operators and expression composition",
            "validated operator and expression diagnostic matrix syntax forms",
            "operator-expression-syntax",
            "evaluate operator precedence syntax and expression composition",
            "8",
            "8",
            "not-8",
            move syntax_passed_with_log,
            "operator/expression diagnostic syntax forms check failed"
        )
    }

    if (item_index == 1) {
        return RunOperatorExpressionDiagnosticItem(
            ctx,
            scope,
            "OperatorAndExpressionDiagnosticMatrixStaticSemantics",
            "operator operand typing and expression result typing compatibility",
            "validated operator and expression diagnostic matrix static semantics",
            "operator-expression-static",
            "type-check logical expression composition over boolean operands",
            "3",
            "3",
            "not-3",
            move static_passed_with_log,
            "operator/expression diagnostic static semantics check failed"
        )
    }

    if (item_index == 2) {
        return RunOperatorExpressionDiagnosticItem(
            ctx,
            scope,
            "OperatorAndExpressionDiagnosticMatrixRuntimeDiagnostics",
            "runtime diagnostic-code matrix verification for core operator/expression error classes",
            "validated operator and expression diagnostic matrix runtime behavior and diagnostics",
            "operator-expression-runtime",
            "verify operator/expression diagnostics matrix entries and runtime aggregate",
            "14",
            "14",
            "not-14",
            move runtime_passed_with_log,
            "operator/expression diagnostic runtime diagnostics check failed"
        )
    }

    return RunOperatorExpressionDiagnosticItem(
        ctx,
        scope,
        move item_name,
        "unknown operator/expression diagnostic matrix item",
        "failed unknown operator/expression diagnostic matrix item",
        "item-resolution",
        "resolve operator/expression diagnostic matrix item name",
        "known-item",
        "known-item",
        "unknown-item",
        false,
        "unknown operator/expression diagnostic matrix item"
    )
}

procedure RunOperatorAndExpressionDiagnosticMatrix(ctx: Context) -> i32 {
    let scope: string@View = "operations::OperationDiagnostics::OperatorAndExpressionDiagnosticMatrix"
    let checkpoint: string@View = "covered operator and expression diagnostic matrix operation items"

    let status_syntax: i32 = VerifyOperatorExpressionDiagnosticItem(ctx, scope, 0, "OperatorAndExpressionDiagnosticMatrixSyntaxForms")
    if (status_syntax != 0) {
        return status_syntax
    }

    let status_static: i32 = VerifyOperatorExpressionDiagnosticItem(ctx, scope, 1, "OperatorAndExpressionDiagnosticMatrixStaticSemantics")
    if (status_static != 0) {
        return status_static
    }

    let status_runtime: i32 = VerifyOperatorExpressionDiagnosticItem(ctx, scope, 2, "OperatorAndExpressionDiagnosticMatrixRuntimeDiagnostics")
    if (status_runtime != 0) {
        return status_runtime
    }

    return 0
}
