procedure AsyncConcurrencyDiagImmediateOne() -> Async<(), (), i32, !> {
    return 1
}

procedure AsyncConcurrencyDiagYieldTwo() -> Async<(), (), i32, !> {
    let resume_value: () = yield release ()
    return 2
}

procedure LogAsyncConcurrencyDiagnosticObject(
    fs: $FileSystem,
    scope: string@View,
    move object_name: string@View,
    move object_type: string@View,
    move state: string@View,
    move details: string@View
) -> () {
    }

procedure AsyncConcurrencyDiagnosticMetricLabel(value: i32) -> string@View {
    if (value == 2) {
        return "2"
    }
    if (value == 3) {
        return "3"
    }
    if (value == 8) {
        return "8"
    }
    return "other"
}

procedure RunAsyncConcurrencyDiagnosticItem(
    ctx: Context,
    scope: string@View,
    move item_name: string@View,
    move item_details: string@View,
    move item_reason: string@View,
    move step_name: string@View,
    move step_detail: string@View,
    move expected: string@View,
    move actual_pass: string@View,
    move actual_fail: string@View,
    move passed: bool,
    move failure_reason: string@View
) -> i32 {
    let passed_place: bool = passed
    let item_check_log: bool = passed_place
    let item_check_ok: bool = passed_place && (item_check_log == true)
    if (item_check_ok == false) {
        return 1
    }

    return 0
}

procedure VerifyAsyncConcurrencyDiagnosticItem(ctx: Context, scope: string@View, move item_index: i32, move item_name: string@View) -> i32 {
    let diag_yield_with_key: string@View = "E-CON-0213"
    let diag_yield_from_with_key: string@View = "E-CON-0224"
    let diag_gpu_shared_capture: string@View = "E-CON-0151"

    LogAsyncConcurrencyDiagnosticObject(ctx.fs, scope, "async_diag_all_operands", "Async<(),(),i32,!> x2", "constructed", "all-expression operands for async matrix prepared")
    LogAsyncConcurrencyDiagnosticObject(ctx.fs, scope, "async_diag_sync_operand", "Async<(),(),i32,!>", "constructed", "sync operand for async matrix prepared")
    LogAsyncConcurrencyDiagnosticObject(ctx.fs, scope, "diag_yield_with_key", "diagnostic-code", "constructed", "yield-with-key diagnostic entry prepared")
    LogAsyncConcurrencyDiagnosticObject(ctx.fs, scope, "diag_yield_from_with_key", "diagnostic-code", "constructed", "yield-from-with-key diagnostic entry prepared")
    LogAsyncConcurrencyDiagnosticObject(ctx.fs, scope, "diag_gpu_shared_capture", "diagnostic-code", "constructed", "GPU shared-capture diagnostic entry prepared")

    let all_metric: (i32, i32) | ! = all {
        AsyncConcurrencyDiagImmediateOne(),
        AsyncConcurrencyDiagYieldTwo()
    }
    let syntax_metric: i32 = if all_metric is {
        pair: (i32, i32) { pair.0 + pair.1 }
        _: ! { 0 }
    }
    let static_metric: i32 = sync AsyncConcurrencyDiagYieldTwo()
    let diag_yield_with_key_ok: bool = diag_yield_with_key == "E-CON-0213"
    let diag_yield_from_with_key_ok: bool = diag_yield_from_with_key == "E-CON-0224"
    let diag_gpu_shared_capture_ok: bool = diag_gpu_shared_capture == "E-CON-0151"

    let diag_yield_with_key_ok_log_actual = diag_yield_with_key
    let diag_yield_with_key_ok_with_log: bool = diag_yield_with_key_ok && (diag_yield_with_key_ok_log_actual == diag_yield_with_key)
    let diag_yield_from_with_key_ok_log_actual = diag_yield_from_with_key
    let diag_yield_from_with_key_ok_with_log: bool = diag_yield_from_with_key_ok && (diag_yield_from_with_key_ok_log_actual == diag_yield_from_with_key)
    let diag_gpu_shared_capture_ok_log_actual = diag_gpu_shared_capture
    let diag_gpu_shared_capture_ok_with_log: bool = diag_gpu_shared_capture_ok && (diag_gpu_shared_capture_ok_log_actual == diag_gpu_shared_capture)
    let diag_count: i32 = if (diag_yield_with_key_ok && diag_yield_from_with_key_ok && diag_gpu_shared_capture_ok) { 3 } else { 0 }
    let runtime_metric: i32 = syntax_metric + static_metric + diag_count

    let syntax_passed: bool = syntax_metric == 3
    let static_passed: bool = static_metric == 2
    let runtime_passed: bool = runtime_metric == 8

    let actual_label_1: string@View = AsyncConcurrencyDiagnosticMetricLabel(syntax_metric)
    let syntax_passed_log_actual = actual_label_1
    let syntax_passed_with_log: bool = syntax_passed && (syntax_passed_log_actual == actual_label_1)
    let actual_label_2: string@View = AsyncConcurrencyDiagnosticMetricLabel(static_metric)
    let static_passed_log_actual = actual_label_2
    let static_passed_with_log: bool = static_passed && (static_passed_log_actual == actual_label_2)
    let actual_label_3: string@View = AsyncConcurrencyDiagnosticMetricLabel(runtime_metric)
    let runtime_passed_log_actual = actual_label_3
    let runtime_passed_with_log: bool = runtime_passed && (runtime_passed_log_actual == actual_label_3)
    if (item_index == 0) {
        return RunAsyncConcurrencyDiagnosticItem(
            ctx,
            scope,
            "AsyncConcurrencyDiagnosticMatrixSyntaxForms",
            "async operator syntax forms (`all`, `sync`, `yield release`) in diagnostic matrix baseline",
            "validated async concurrency diagnostic matrix syntax forms",
            "async-diagnostic-syntax",
            "evaluate async all-expression syntax and operand list forms",
            "3",
            "3",
            "not-3",
            move syntax_passed_with_log,
            "async concurrency diagnostic syntax forms check failed"
        )
    }

    if (item_index == 1) {
        return RunAsyncConcurrencyDiagnosticItem(
            ctx,
            scope,
            "AsyncConcurrencyDiagnosticMatrixStaticSemantics",
            "async shape compatibility for sync and all expression operands",
            "validated async concurrency diagnostic matrix static semantics",
            "async-diagnostic-static",
            "type-check sync input shape and all tuple synthesis",
            "2",
            "2",
            "not-2",
            move static_passed_with_log,
            "async concurrency diagnostic static semantics check failed"
        )
    }

    if (item_index == 2) {
        return RunAsyncConcurrencyDiagnosticItem(
            ctx,
            scope,
            "AsyncConcurrencyDiagnosticMatrixRuntimeDiagnostics",
            "diagnostic-code mapping verification for async/concurrency error classes",
            "validated async concurrency diagnostic matrix runtime behavior and diagnostics",
            "async-diagnostic-runtime",
            "verify async diagnostic-code matrix entries and runtime aggregate",
            "8",
            "8",
            "not-8",
            move runtime_passed_with_log,
            "async concurrency diagnostic runtime diagnostics check failed"
        )
    }

    return RunAsyncConcurrencyDiagnosticItem(
        ctx,
        scope,
        move item_name,
        "unknown async concurrency diagnostic matrix item",
        "failed unknown async concurrency diagnostic matrix item",
        "item-resolution",
        "resolve async concurrency diagnostic matrix item name",
        "known-item",
        "known-item",
        "unknown-item",
        false,
        "unknown async concurrency diagnostic matrix item"
    )
}

procedure RunAsyncConcurrencyDiagnosticMatrix(ctx: Context) -> i32 {
    let scope: string@View = "operations::OperationDiagnostics::AsyncConcurrencyDiagnosticMatrix"
    let checkpoint: string@View = "covered async concurrency diagnostic matrix operation items"

    let status_syntax: i32 = VerifyAsyncConcurrencyDiagnosticItem(ctx, scope, 0, "AsyncConcurrencyDiagnosticMatrixSyntaxForms")
    if (status_syntax != 0) {
        return status_syntax
    }

    let status_static: i32 = VerifyAsyncConcurrencyDiagnosticItem(ctx, scope, 1, "AsyncConcurrencyDiagnosticMatrixStaticSemantics")
    if (status_static != 0) {
        return status_static
    }

    let status_runtime: i32 = VerifyAsyncConcurrencyDiagnosticItem(ctx, scope, 2, "AsyncConcurrencyDiagnosticMatrixRuntimeDiagnostics")
    if (status_runtime != 0) {
        return status_runtime
    }

    return 0
}
