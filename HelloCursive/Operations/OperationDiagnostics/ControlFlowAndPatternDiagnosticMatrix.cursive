public enum ControlFlowPatternCase {
    Start(i32, i32)
    Stop(i32, i32)
}

procedure LogControlFlowPatternDiagnosticObject(
    fs: $FileSystem,
    scope: string@View,
    move object_name: string@View,
    move object_type: string@View,
    move state: string@View,
    move details: string@View
) -> () {
    [[log(label: "operations-log-object")]]
}

procedure ControlFlowPatternDiagnosticMetricLabel(value: i32) -> string@View {
    if (value == 4) {
        return "4"
    }
    if (value == 7) {
        return "7"
    }
    if (value == 12) {
        return "12"
    }
    return "other"
}

procedure RunControlFlowPatternDiagnosticItem(
    ctx: Context,
    scope: string@View,
    move item_name: string@View,
    move item_details: string@View,
    move item_reason: string@View,
    move step_name: string@View,
    move step_detail: string@View,
    move expected: string@View,
    move actual_pass: string@View,
    move actual_fail: string@View,
    move passed: bool,
    move failure_reason: string@View
) -> i32 {
    [[log(label: "operations-log-item_begin")]]
    let passed_place: bool = passed
    let item_check_log: bool = [[log(label: "observed-item-check-pass", expected: true)]] passed_place
    let item_check_ok: bool = passed_place && (item_check_log == true)
    if (item_check_ok == false) {
        [[log(label: "operations-log-transition")]]
        [[log(label: "operations-log-item_fail")]]
        return 1
    }

    [[log(label: "operations-log-operations_item_success")]]
    return 0
}

procedure VerifyControlFlowPatternDiagnosticItem(ctx: Context, scope: string@View, move item_index: i32, move item_name: string@View) -> i32 {
    [[log(label: "operations-log-runtime_phase_move")]]
    let control_seed: i32 = 2
    let pattern_seed: ControlFlowPatternCase = ControlFlowPatternCase::Start(3, 4)

    let diag_if_case_non_exhaustive: string@View = "E-SEM-2705"
    let diag_if_case_unreachable: string@View = "E-SEM-2751"
    let diag_refutable_let_pattern: string@View = "E-SEM-2711"
    let diag_break_outside_loop: string@View = "E-SEM-3162"

    LogControlFlowPatternDiagnosticObject(ctx.fs, scope, "control_seed", "i32", "constructed", "if-expression control-flow seed prepared")
    LogControlFlowPatternDiagnosticObject(ctx.fs, scope, "pattern_seed", "ControlFlowPatternCase", "constructed", "enum pattern-case-analysis seed prepared")
    LogControlFlowPatternDiagnosticObject(ctx.fs, scope, "diag_if_case_non_exhaustive", "diagnostic-code", "constructed", "case-analysis exhaustiveness diagnostic mapping prepared")
    LogControlFlowPatternDiagnosticObject(ctx.fs, scope, "diag_if_case_unreachable", "diagnostic-code", "constructed", "case-analysis unreachable-clause diagnostic mapping prepared")
    LogControlFlowPatternDiagnosticObject(ctx.fs, scope, "diag_refutable_let_pattern", "diagnostic-code", "constructed", "refutable let pattern diagnostic mapping prepared")
    LogControlFlowPatternDiagnosticObject(ctx.fs, scope, "diag_break_outside_loop", "diagnostic-code", "constructed", "break outside loop diagnostic mapping prepared")

    [[log(label: "operations-log-runtime_phase_move")]]
    [[log(label: "operations-log-transition_move")]]
    let syntax_metric: i32 = if (control_seed < 3) { 4 } else { 0 }
    [[log(label: "operations-log-transition_move")]]
    [[log(label: "operations-log-transition_move")]]
    let static_metric: i32 = if pattern_seed is {
        ControlFlowPatternCase::Start(left, right) { left + right }
        ControlFlowPatternCase::Stop(value, _) { value }
    }
    [[log(label: "operations-log-transition_move")]]
    var loop_index: i32 = 0
    var loop_sum: i32 = 0
    loop {
        loop_index = loop_index + 1
        if (loop_index == 2) {
            continue
        }
        loop_sum = loop_sum + loop_index
        if (loop_index == 4) {
            break
        }
    }

    let diag_if_case_non_exhaustive_ok: bool = diag_if_case_non_exhaustive == "E-SEM-2705"
    let diag_if_case_unreachable_ok: bool = diag_if_case_unreachable == "E-SEM-2751"
    let diag_refutable_let_pattern_ok: bool = diag_refutable_let_pattern == "E-SEM-2711"
    let diag_break_outside_loop_ok: bool = diag_break_outside_loop == "E-SEM-3162"

    let diag_if_case_non_exhaustive_ok_log_actual = [[log(label: "diagnostic-if-case-non-exhaustive", expected: "E-SEM-2705")]] diag_if_case_non_exhaustive
    let diag_if_case_non_exhaustive_ok_with_log: bool = diag_if_case_non_exhaustive_ok && (diag_if_case_non_exhaustive_ok_log_actual == diag_if_case_non_exhaustive)
    let diag_if_case_unreachable_ok_log_actual = [[log(label: "diagnostic-if-case-unreachable", expected: "E-SEM-2751")]] diag_if_case_unreachable
    let diag_if_case_unreachable_ok_with_log: bool = diag_if_case_unreachable_ok && (diag_if_case_unreachable_ok_log_actual == diag_if_case_unreachable)
    let diag_refutable_let_pattern_ok_log_actual = [[log(label: "diagnostic-refutable-let-pattern", expected: "E-SEM-2711")]] diag_refutable_let_pattern
    let diag_refutable_let_pattern_ok_with_log: bool = diag_refutable_let_pattern_ok && (diag_refutable_let_pattern_ok_log_actual == diag_refutable_let_pattern)
    let diag_break_outside_loop_ok_log_actual = [[log(label: "diagnostic-break-outside-loop", expected: "E-SEM-3162")]] diag_break_outside_loop
    let diag_break_outside_loop_ok_with_log: bool = diag_break_outside_loop_ok && (diag_break_outside_loop_ok_log_actual == diag_break_outside_loop)
    let diag_count: i32 = if (diag_if_case_non_exhaustive_ok && diag_if_case_unreachable_ok && diag_refutable_let_pattern_ok && diag_break_outside_loop_ok) { 4 } else { 0 }
    let runtime_metric: i32 = loop_sum + diag_count

    let syntax_passed: bool = syntax_metric == 4
    let static_passed: bool = static_metric == 7
    let runtime_passed: bool = runtime_metric == 12

    let actual_label_1: string@View = ControlFlowPatternDiagnosticMetricLabel(syntax_metric)
    let syntax_passed_log_actual = [[log(label: "observed-control-flow-pattern-syntax-metric", expected: "4")]] actual_label_1
    let syntax_passed_with_log: bool = syntax_passed && (syntax_passed_log_actual == actual_label_1)
    let actual_label_2: string@View = ControlFlowPatternDiagnosticMetricLabel(static_metric)
    let static_passed_log_actual = [[log(label: "observed-control-flow-pattern-static-metric", expected: "7")]] actual_label_2
    let static_passed_with_log: bool = static_passed && (static_passed_log_actual == actual_label_2)
    let actual_label_3: string@View = ControlFlowPatternDiagnosticMetricLabel(runtime_metric)
    let runtime_passed_log_actual = [[log(label: "observed-control-flow-pattern-runtime-metric", expected: "12")]] actual_label_3
    let runtime_passed_with_log: bool = runtime_passed && (runtime_passed_log_actual == actual_label_3)
    [[log(label: "operations-log-runtime_phase_move")]]
    if (item_index == 0) {
        return RunControlFlowPatternDiagnosticItem(
            ctx,
            scope,
            "ControlFlowAndPatternDiagnosticMatrixSyntaxForms",
            "syntax forms for if/if-is/loop control-flow and pattern constructs",
            "validated control-flow and pattern diagnostic matrix syntax forms",
            "control-flow-pattern-syntax",
            "evaluate if/if-is syntax surfaces and branch structure",
            "4",
            "4",
            "not-4",
            move syntax_passed_with_log,
            "control-flow/pattern diagnostic syntax forms check failed"
        )
    }

    if (item_index == 1) {
        return RunControlFlowPatternDiagnosticItem(
            ctx,
            scope,
            "ControlFlowAndPatternDiagnosticMatrixStaticSemantics",
            "pattern payload typing and arm result-type consistency in diagnostic matrix probes",
            "validated control-flow and pattern diagnostic matrix static semantics",
            "control-flow-pattern-static",
            "type-check enum pattern payload bindings and unified case-clause result",
            "7",
            "7",
            "not-7",
            move static_passed_with_log,
            "control-flow/pattern diagnostic static semantics check failed"
        )
    }

    if (item_index == 2) {
        return RunControlFlowPatternDiagnosticItem(
            ctx,
            scope,
            "ControlFlowAndPatternDiagnosticMatrixRuntimeDiagnostics",
            "diagnostic-code mapping and runtime control-flow aggregation for pattern/control classes",
            "validated control-flow and pattern diagnostic matrix runtime behavior and diagnostics",
            "control-flow-pattern-runtime",
            "verify control-flow runtime aggregate and diagnostic matrix mappings",
            "12",
            "12",
            "not-12",
            move runtime_passed_with_log,
            "control-flow/pattern diagnostic runtime diagnostics check failed"
        )
    }

    return RunControlFlowPatternDiagnosticItem(
        ctx,
        scope,
        move item_name,
        "unknown control-flow/pattern diagnostic matrix item",
        "failed unknown control-flow/pattern diagnostic matrix item",
        "item-resolution",
        "resolve control-flow/pattern diagnostic matrix item name",
        "known-item",
        "known-item",
        "unknown-item",
        false,
        "unknown control-flow/pattern diagnostic matrix item"
    )
}

procedure RunControlFlowAndPatternDiagnosticMatrix(ctx: Context) -> i32 {
    let scope: string@View = "operations::OperationDiagnostics::ControlFlowAndPatternDiagnosticMatrix"
    let checkpoint: string@View = "covered control flow and pattern diagnostic matrix operation items"

    let status_syntax: i32 = VerifyControlFlowPatternDiagnosticItem(ctx, scope, 0, "ControlFlowAndPatternDiagnosticMatrixSyntaxForms")
    if (status_syntax != 0) {
        return status_syntax
    }

    let status_static: i32 = VerifyControlFlowPatternDiagnosticItem(ctx, scope, 1, "ControlFlowAndPatternDiagnosticMatrixStaticSemantics")
    if (status_static != 0) {
        return status_static
    }

    let status_runtime: i32 = VerifyControlFlowPatternDiagnosticItem(ctx, scope, 2, "ControlFlowAndPatternDiagnosticMatrixRuntimeDiagnostics")
    if (status_runtime != 0) {
        return status_runtime
    }

    [[log(label: "operations-log-checkpoint")]]
    return 0
}
