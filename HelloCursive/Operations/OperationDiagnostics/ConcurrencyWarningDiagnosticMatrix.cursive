procedure ConcurrencyWarningDiagnosticMatrixMetricLabel(value: i32) -> string@View {
    if (value == 811) {
        return "811"
    }
    return "other"
}

public procedure RunConcurrencyWarningDiagnosticMatrix(ctx: Context) -> i32 {
    let _ = ctx
    let w0001: string@View = "W-CON-0001"
    let w0002: string@View = "W-CON-0002"
    let w0003: string@View = "W-CON-0003"
    let w0004: string@View = "W-CON-0004"
    let w0005: string@View = "W-CON-0005"
    let w0006: string@View = "W-CON-0006"
    let w0009: string@View = "W-CON-0009"
    let w0010: string@View = "W-CON-0010"
    let w0011: string@View = "W-CON-0011"
    let w0012: string@View = "W-CON-0012"
    let w0013: string@View = "W-CON-0013"
    let w0020: string@View = "W-CON-0020"
    let w0021: string@View = "W-CON-0021"
    let w0140: string@View = "W-CON-0140"
    let w0201: string@View = "W-CON-0201"
    let w0401: string@View = "W-CON-0401"

    let block_a_ok: bool =
        (w0001 == "W-CON-0001") &&
        (w0002 == "W-CON-0002") &&
        (w0003 == "W-CON-0003") &&
        (w0004 == "W-CON-0004") &&
        (w0005 == "W-CON-0005") &&
        (w0006 == "W-CON-0006")
    let block_b_ok: bool =
        (w0009 == "W-CON-0009") &&
        (w0010 == "W-CON-0010") &&
        (w0011 == "W-CON-0011") &&
        (w0012 == "W-CON-0012") &&
        (w0013 == "W-CON-0013")
    let block_c_ok: bool =
        (w0020 == "W-CON-0020") &&
        (w0021 == "W-CON-0021") &&
        (w0140 == "W-CON-0140") &&
        (w0201 == "W-CON-0201") &&
        (w0401 == "W-CON-0401")

    let runtime_ok: bool = block_a_ok && block_b_ok && block_c_ok
    let runtime_ok_log: bool =
        runtime_ok

    let metric: i32 = if (runtime_ok_log == true) { 811 } else { 0 }
    let metric_label: string@View = ConcurrencyWarningDiagnosticMatrixMetricLabel(metric)
    let metric_log_actual: string@View =
        metric_label
    if (metric_log_actual != "811") {
        return 1
    }

    return 0
}
