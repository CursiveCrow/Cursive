procedure ConcurrencyInfoDiagnosticMatrixMetricLabel(value: i32) -> string@View {
    if (value == 810) {
        return "810"
    }
    return "other"
}

public procedure RunConcurrencyInfoDiagnosticMatrix(ctx: Context) -> i32 {
    let _ = ctx
    let icon_0011: string@View =
        "I-CON-0011"
    let icon_0013: string@View =
        "I-CON-0013"
    let info_surface_dynamic_sync: string@View =
        "runtime-sync-emitted"
    let info_surface_static_proof: string@View =
        "static-proof-no-runtime-sync"

    let runtime_ok: bool =
        (icon_0011 == "I-CON-0011") &&
        (icon_0013 == "I-CON-0013") &&
        (info_surface_dynamic_sync == "runtime-sync-emitted") &&
        (info_surface_static_proof == "static-proof-no-runtime-sync")
    let runtime_ok_log: bool =
        runtime_ok

    let metric: i32 = if (runtime_ok_log == true) { 810 } else { 0 }
    let metric_label: string@View = ConcurrencyInfoDiagnosticMatrixMetricLabel(metric)
    let metric_log_actual: string@View =
        metric_label
    if (metric_log_actual != "810") {
        return 1
    }

    return 0
}
