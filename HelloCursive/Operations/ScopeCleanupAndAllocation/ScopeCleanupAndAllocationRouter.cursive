
public procedure runGroup(ctx: Context) -> i32 {
    let section_name: string@View = "operations/ScopeCleanupAndAllocation"
    let status_ok: string@View = "ok"
    let status_failed: string@View = "failed"

    let phase_planned: string@View = "planned"
    let phase_running: string@View = "running"
    let phase_complete: string@View = "complete"
    let phase_failed: string@View = "failed"
    let dispatch_reason: string@View = "dispatching operation topic function"
    let complete_reason: string@View = "operation topic function completed"
    let failed_reason: string@View = "operation topic function returned non-zero status"

    let feature_DeferOperations: string@View = "ScopeCleanupAndAllocation::DeferOperations"
    let feature_RegionBlockOperations: string@View = "ScopeCleanupAndAllocation::RegionBlockOperations"
    let feature_RegionOptionsOperations: string@View = "ScopeCleanupAndAllocation::RegionOptionsOperations"
    let feature_RegionAllocationOperatorOperations: string@View = "ScopeCleanupAndAllocation::RegionAllocationOperatorOperations"
    let feature_FrameOperations: string@View = "ScopeCleanupAndAllocation::FrameOperations"
    let feature_PanicAndUnwindingOperations: string@View = "ScopeCleanupAndAllocation::PanicAndUnwindingOperations"

    [[log(label: "operations-log-section_start")]]
    [[log(label: "operations-log-transition")]]
    let status_DeferOperations: i32 = RunDeferOperations(ctx)
    if (status_DeferOperations != 0) {
        [[log(label: "operations-log-transition")]]
        [[log(label: "operations-log-section_end")]]
        return status_DeferOperations
    }
    [[log(label: "operations-log-transition")]]
    [[log(label: "operations-log-transition")]]
    let status_RegionBlockOperations: i32 = RunRegionBlockOperations(ctx)
    if (status_RegionBlockOperations != 0) {
        [[log(label: "operations-log-transition")]]
        [[log(label: "operations-log-section_end")]]
        return status_RegionBlockOperations
    }
    [[log(label: "operations-log-transition")]]
    [[log(label: "operations-log-transition")]]
    let status_RegionOptionsOperations: i32 = RunRegionOptionsOperations(ctx)
    if (status_RegionOptionsOperations != 0) {
        [[log(label: "operations-log-transition")]]
        [[log(label: "operations-log-section_end")]]
        return status_RegionOptionsOperations
    }
    [[log(label: "operations-log-transition")]]
    [[log(label: "operations-log-transition")]]
    let status_RegionAllocationOperatorOperations: i32 = RunRegionAllocationOperatorOperations(ctx)
    if (status_RegionAllocationOperatorOperations != 0) {
        [[log(label: "operations-log-transition")]]
        [[log(label: "operations-log-section_end")]]
        return status_RegionAllocationOperatorOperations
    }
    [[log(label: "operations-log-transition")]]
    [[log(label: "operations-log-transition")]]
    let status_FrameOperations: i32 = RunFrameOperations(ctx)
    if (status_FrameOperations != 0) {
        [[log(label: "operations-log-transition")]]
        [[log(label: "operations-log-section_end")]]
        return status_FrameOperations
    }
    [[log(label: "operations-log-transition")]]
    [[log(label: "operations-log-transition")]]
    let status_PanicAndUnwindingOperations: i32 = RunPanicAndUnwindingOperations(ctx)
    if (status_PanicAndUnwindingOperations != 0) {
        [[log(label: "operations-log-transition")]]
        [[log(label: "operations-log-section_end")]]
        return status_PanicAndUnwindingOperations
    }
    [[log(label: "operations-log-transition")]]
    [[log(label: "operations-log-section_end")]]
    return 0
}
