procedure UnwindBreakCleanupProbe() -> i32 {
    var metric: i32 = 0
    loop {
        defer {
            metric = metric + 1
        }
        metric = metric + 4
        break
    }
    return metric
}

procedure UnwindNestedCleanupProbe() -> i32 {
    var metric: i32 = 0
    {
        defer {
            metric = metric + 1
        }
        {
            defer {
                metric = metric + 5
            }
            metric = metric + 2
        }
        metric = metric + 3
    }
    return metric
}

procedure LogPanicUnwindingObject(
    fs: $FileSystem,
    scope: string@View,
    move object_name: string@View,
    move object_type: string@View,
    move state: string@View,
    move details: string@View
) -> () {
    [[log(label: "operations-log-object")]]
}

procedure PanicUnwindingMetricLabel(value: i32) -> string@View {
    if (value == 5) {
        return "5"
    }
    if (value == 11) {
        return "11"
    }
    if (value == 18) {
        return "18"
    }
    return "other"
}

procedure RunPanicUnwindingItem(
    ctx: Context,
    scope: string@View,
    move item_name: string@View,
    move item_details: string@View,
    move item_reason: string@View,
    move step_name: string@View,
    move step_detail: string@View,
    move expected: string@View,
    move actual_pass: string@View,
    move actual_fail: string@View,
    move passed: bool,
    move failure_reason: string@View
) -> i32 {
    [[log(label: "operations-log-item_begin")]]
    let passed_place: bool = passed
    let item_check_log: bool = [[log(label: "observed-item-check-pass", expected: true)]] passed_place
    let item_check_ok: bool = passed_place && (item_check_log == true)
    if (item_check_ok == false) {
        [[log(label: "operations-log-transition")]]
        [[log(label: "operations-log-item_fail")]]
        return 1
    }

    [[log(label: "operations-log-operations_item_success")]]
    return 0
}

procedure VerifyPanicUnwindingItem(ctx: Context, scope: string@View, move item_index: i32, move item_name: string@View) -> i32 {
    [[log(label: "operations-log-runtime_phase_move")]]
    let diag_runtime_type_panic: string@View = "P-TYP-1953"
    let diag_runtime_semantic_panic: string@View = "P-SEM-2861"

    LogPanicUnwindingObject(ctx.fs, scope, "unwind_break_probe", "procedure()->i32", "constructed", "break-exit cleanup probe prepared")
    LogPanicUnwindingObject(ctx.fs, scope, "unwind_nested_probe", "procedure()->i32", "constructed", "nested cleanup sequencing probe prepared")
    LogPanicUnwindingObject(ctx.fs, scope, "diag_runtime_type_panic", "diagnostic-code", "constructed", "runtime panic typing diagnostic mapping prepared")
    LogPanicUnwindingObject(ctx.fs, scope, "diag_runtime_semantic_panic", "diagnostic-code", "constructed", "runtime panic semantic diagnostic mapping prepared")

    [[log(label: "operations-log-runtime_phase_move")]]
    [[log(label: "operations-log-transition_move")]]
    let syntax_metric: i32 = UnwindBreakCleanupProbe()
    [[log(label: "operations-log-transition_move")]]
    [[log(label: "operations-log-transition_move")]]
    let static_metric: i32 = UnwindNestedCleanupProbe()
    [[log(label: "operations-log-transition_move")]]
    let diag_runtime_type_ok: bool = diag_runtime_type_panic == "P-TYP-1953"
    let diag_runtime_semantic_ok: bool = diag_runtime_semantic_panic == "P-SEM-2861"

    let diag_runtime_type_ok_log_actual = [[log(label: "diagnostic-runtime-type-panic", expected: "P-TYP-1953")]] diag_runtime_type_panic
    let diag_runtime_type_ok_with_log: bool = diag_runtime_type_ok && (diag_runtime_type_ok_log_actual == diag_runtime_type_panic)
    let diag_runtime_semantic_ok_log_actual = [[log(label: "diagnostic-runtime-semantic-panic", expected: "P-SEM-2861")]] diag_runtime_semantic_panic
    let diag_runtime_semantic_ok_with_log: bool = diag_runtime_semantic_ok && (diag_runtime_semantic_ok_log_actual == diag_runtime_semantic_panic)
    let diag_count: i32 = if (diag_runtime_type_ok && diag_runtime_semantic_ok) { 2 } else { 0 }
    let runtime_metric: i32 = syntax_metric + static_metric + diag_count

    let syntax_passed: bool = syntax_metric == 5
    let static_passed: bool = static_metric == 11
    let runtime_passed: bool = runtime_metric == 18

    let actual_label_1: string@View = PanicUnwindingMetricLabel(syntax_metric)
    let syntax_passed_log_actual = [[log(label: "observed-panic-unwinding-syntax-metric", expected: "5")]] actual_label_1
    let syntax_passed_with_log: bool = syntax_passed && (syntax_passed_log_actual == actual_label_1)
    let actual_label_2: string@View = PanicUnwindingMetricLabel(static_metric)
    let static_passed_log_actual = [[log(label: "observed-panic-unwinding-static-metric", expected: "11")]] actual_label_2
    let static_passed_with_log: bool = static_passed && (static_passed_log_actual == actual_label_2)
    let actual_label_3: string@View = PanicUnwindingMetricLabel(runtime_metric)
    let runtime_passed_log_actual = [[log(label: "observed-panic-unwinding-runtime-metric", expected: "18")]] actual_label_3
    let runtime_passed_with_log: bool = runtime_passed && (runtime_passed_log_actual == actual_label_3)
    [[log(label: "operations-log-runtime_phase_move")]]
    if (item_index == 0) {
        return RunPanicUnwindingItem(
            ctx,
            scope,
            "PanicAndUnwindingOperationsSyntaxForms",
            "syntax forms for control-transfer cleanup constructs relevant to unwind paths",
            "validated panic and unwinding operations syntax forms",
            "panic-unwinding-syntax",
            "evaluate loop-break cleanup syntax surface with defer integration",
            "5",
            "5",
            "not-5",
            move syntax_passed_with_log,
            "panic/unwinding syntax forms check failed"
        )
    }

    if (item_index == 1) {
        return RunPanicUnwindingItem(
            ctx,
            scope,
            "PanicAndUnwindingOperationsStaticSemantics",
            "cleanup sequencing validity across nested scopes and defer blocks",
            "validated panic and unwinding operations static semantics",
            "panic-unwinding-static",
            "type-check nested cleanup sequencing across unwind-relevant scope exits",
            "11",
            "11",
            "not-11",
            move static_passed_with_log,
            "panic/unwinding static semantics check failed"
        )
    }

    if (item_index == 2) {
        return RunPanicUnwindingItem(
            ctx,
            scope,
            "PanicAndUnwindingOperationsRuntimeDiagnostics",
            "runtime cleanup behavior with panic/unwinding diagnostic matrix mapping",
            "validated panic and unwinding operations runtime behavior and diagnostics",
            "panic-unwinding-runtime",
            "verify cleanup aggregate and runtime panic diagnostic mappings",
            "18",
            "18",
            "not-18",
            move runtime_passed_with_log,
            "panic/unwinding runtime diagnostics check failed"
        )
    }

    return RunPanicUnwindingItem(
        ctx,
        scope,
        move item_name,
        "unknown panic/unwinding operation item",
        "failed unknown panic/unwinding operation item",
        "item-resolution",
        "resolve panic/unwinding operation item name",
        "known-item",
        "known-item",
        "unknown-item",
        false,
        "unknown panic/unwinding operation item"
    )
}

procedure RunPanicAndUnwindingOperations(ctx: Context) -> i32 {
    let scope: string@View = "operations::ScopeCleanupAndAllocation::PanicAndUnwindingOperations"
    let checkpoint: string@View = "covered panic and unwinding operations operation items"

    let status_syntax: i32 = VerifyPanicUnwindingItem(ctx, scope, 0, "PanicAndUnwindingOperationsSyntaxForms")
    if (status_syntax != 0) {
        return status_syntax
    }

    let status_static: i32 = VerifyPanicUnwindingItem(ctx, scope, 1, "PanicAndUnwindingOperationsStaticSemantics")
    if (status_static != 0) {
        return status_static
    }

    let status_runtime: i32 = VerifyPanicUnwindingItem(ctx, scope, 2, "PanicAndUnwindingOperationsRuntimeDiagnostics")
    if (status_runtime != 0) {
        return status_runtime
    }

    [[log(label: "operations-log-checkpoint")]]
    return 0
}
