procedure DeferLifoProbe() -> i32 {
    var marker: i32 = 0
    {
        defer {
            marker = marker + 1
        }
        defer {
            marker = marker + 10
        }
        marker = marker + 100
    }
    return marker
}

procedure DeferNestedScopeProbe() -> i32 {
    var marker: i32 = 0
    {
        defer {
            marker = marker + 1
        }
        {
            defer {
                marker = marker + 5
            }
            marker = marker + 20
        }
        marker = marker + 3
    }
    return marker
}

procedure LogDeferOperationObject(
    fs: $FileSystem,
    scope: string@View,
    move object_name: string@View,
    move object_type: string@View,
    move state: string@View,
    move details: string@View
) -> () {
    [[log(label: "operations-log-object")]]
}

procedure DeferOperationMetricLabel(value: i32) -> string@View {
    if (value == 29) {
        return "29"
    }
    if (value == 111) {
        return "111"
    }
    if (value == 140) {
        return "140"
    }
    return "other"
}

procedure RunDeferOperationItem(
    ctx: Context,
    scope: string@View,
    move item_name: string@View,
    move item_details: string@View,
    move item_reason: string@View,
    move step_name: string@View,
    move step_detail: string@View,
    move expected: string@View,
    move actual_pass: string@View,
    move actual_fail: string@View,
    move passed: bool,
    move failure_reason: string@View
) -> i32 {
    [[log(label: "operations-log-item_begin")]]
    let passed_place: bool = passed
    let item_check_log: bool = [[log(label: "observed-item-check-pass", expected: true)]] passed_place
    let item_check_ok: bool = passed_place && (item_check_log == true)
    if (item_check_ok == false) {
        [[log(label: "operations-log-transition")]]
        [[log(label: "operations-log-item_fail")]]
        return 1
    }

    [[log(label: "operations-log-operations_item_success")]]
    return 0
}

procedure VerifyDeferOperationItem(ctx: Context, scope: string@View, move item_index: i32, move item_name: string@View) -> i32 {
    [[log(label: "operations-log-runtime_phase_move")]]
    LogDeferOperationObject(ctx.fs, scope, "defer_lifo_probe", "procedure()->i32", "constructed", "defer LIFO ordering probe prepared")
    LogDeferOperationObject(ctx.fs, scope, "defer_nested_probe", "procedure()->i32", "constructed", "defer nested scope ordering probe prepared")

    [[log(label: "operations-log-runtime_phase_move")]]
    [[log(label: "operations-log-transition_move")]]
    let syntax_metric: i32 = DeferLifoProbe()
    [[log(label: "operations-log-transition_move")]]
    [[log(label: "operations-log-transition_move")]]
    let static_metric: i32 = DeferNestedScopeProbe()
    [[log(label: "operations-log-transition_move")]]
    let runtime_metric: i32 = syntax_metric + static_metric

    let syntax_passed: bool = syntax_metric == 111
    let static_passed: bool = static_metric == 29
    let runtime_passed: bool = runtime_metric == 140

    let actual_label_1: string@View = DeferOperationMetricLabel(syntax_metric)
    let syntax_passed_log_actual = [[log(label: "observed-defer-syntax-metric", expected: "111")]] actual_label_1
    let syntax_passed_with_log: bool = syntax_passed && (syntax_passed_log_actual == actual_label_1)
    let actual_label_2: string@View = DeferOperationMetricLabel(static_metric)
    let static_passed_log_actual = [[log(label: "observed-defer-static-metric", expected: "29")]] actual_label_2
    let static_passed_with_log: bool = static_passed && (static_passed_log_actual == actual_label_2)
    let actual_label_3: string@View = DeferOperationMetricLabel(runtime_metric)
    let runtime_passed_log_actual = [[log(label: "observed-defer-runtime-metric", expected: "140")]] actual_label_3
    let runtime_passed_with_log: bool = runtime_passed && (runtime_passed_log_actual == actual_label_3)
    [[log(label: "operations-log-runtime_phase_move")]]
    if (item_index == 0) {
        return RunDeferOperationItem(
            ctx,
            scope,
            "DeferOperationsSyntaxForms",
            "`defer { ... }` statement syntax and block-form placement",
            "validated defer operations syntax forms",
            "defer-syntax",
            "evaluate defer declaration forms and LIFO stack registration surface",
            "111",
            "111",
            "not-111",
            move syntax_passed_with_log,
            "defer syntax forms check failed"
        )
    }

    if (item_index == 1) {
        return RunDeferOperationItem(
            ctx,
            scope,
            "DeferOperationsStaticSemantics",
            "defer block typing and nested scope legality under unit-return requirement",
            "validated defer operations static semantics",
            "defer-static",
            "type-check nested defer blocks and scope-local cleanup formation",
            "29",
            "29",
            "not-29",
            move static_passed_with_log,
            "defer static semantics check failed"
        )
    }

    if (item_index == 2) {
        return RunDeferOperationItem(
            ctx,
            scope,
            "DeferOperationsRuntimeDiagnostics",
            "runtime defer execution order and scope-exit cleanup aggregation",
            "validated defer operations runtime behavior and diagnostics",
            "defer-runtime",
            "execute defer cleanup paths and verify aggregate runtime order metric",
            "140",
            "140",
            "not-140",
            move runtime_passed_with_log,
            "defer runtime diagnostics check failed"
        )
    }

    return RunDeferOperationItem(
        ctx,
        scope,
        move item_name,
        "unknown defer operation item",
        "failed unknown defer operation item",
        "item-resolution",
        "resolve defer operation item name",
        "known-item",
        "known-item",
        "unknown-item",
        false,
        "unknown defer operation item"
    )
}

procedure RunDeferOperations(ctx: Context) -> i32 {
    let scope: string@View = "operations::ScopeCleanupAndAllocation::DeferOperations"
    let checkpoint: string@View = "covered defer operations operation items"

    let status_syntax: i32 = VerifyDeferOperationItem(ctx, scope, 0, "DeferOperationsSyntaxForms")
    if (status_syntax != 0) {
        return status_syntax
    }

    let status_static: i32 = VerifyDeferOperationItem(ctx, scope, 1, "DeferOperationsStaticSemantics")
    if (status_static != 0) {
        return status_static
    }

    let status_runtime: i32 = VerifyDeferOperationItem(ctx, scope, 2, "DeferOperationsRuntimeDiagnostics")
    if (status_runtime != 0) {
        return status_runtime
    }

    [[log(label: "operations-log-checkpoint")]]
    return 0
}
