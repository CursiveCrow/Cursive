procedure FrameImplicitProbe() -> i32 {
    var metric: i32 = 0
    region as r {
        var local_value: i32 = 1
        frame {
            local_value = local_value + 4
        }
        metric = local_value
    }
    return metric
}

procedure FrameExplicitProbe() -> i32 {
    var metric: i32 = 0
    region as r {
        var local_value: i32 = 2
        r.frame {
            local_value = local_value + 6
        }
        metric = local_value
    }
    return metric
}

procedure LogFrameOperationObject(
    fs: $FileSystem,
    scope: string@View,
    move object_name: string@View,
    move object_type: string@View,
    move state: string@View,
    move details: string@View
) -> () {
    [[log(label: "operations-log-object")]]
}

procedure FrameOperationMetricLabel(value: i32) -> string@View {
    if (value == 5) {
        return "5"
    }
    if (value == 8) {
        return "8"
    }
    if (value == 13) {
        return "13"
    }
    return "other"
}

procedure RunFrameOperationItem(
    ctx: Context,
    scope: string@View,
    move item_name: string@View,
    move item_details: string@View,
    move item_reason: string@View,
    move step_name: string@View,
    move step_detail: string@View,
    move expected: string@View,
    move actual_pass: string@View,
    move actual_fail: string@View,
    move passed: bool,
    move failure_reason: string@View
) -> i32 {
    [[log(label: "operations-log-item_begin")]]
    let passed_place: bool = passed
    let item_check_log: bool = [[log(label: "observed-item-check-pass", expected: true)]] passed_place
    let item_check_ok: bool = passed_place && (item_check_log == true)
    if (item_check_ok == false) {
        [[log(label: "operations-log-transition")]]
        [[log(label: "operations-log-item_fail")]]
        return 1
    }

    [[log(label: "operations-log-operations_item_success")]]
    return 0
}

procedure VerifyFrameOperationItem(ctx: Context, scope: string@View, move item_index: i32, move item_name: string@View) -> i32 {
    [[log(label: "operations-log-runtime_phase_move")]]
    LogFrameOperationObject(ctx.fs, scope, "frame_implicit_probe", "procedure()->i32", "constructed", "implicit frame probe prepared")
    LogFrameOperationObject(ctx.fs, scope, "frame_explicit_probe", "procedure()->i32", "constructed", "explicit region-targeted frame probe prepared")

    [[log(label: "operations-log-runtime_phase_move")]]
    [[log(label: "operations-log-transition_move")]]
    let syntax_metric: i32 = FrameImplicitProbe()
    [[log(label: "operations-log-transition_move")]]
    [[log(label: "operations-log-transition_move")]]
    let static_metric: i32 = FrameExplicitProbe()
    [[log(label: "operations-log-transition_move")]]
    let runtime_metric: i32 = syntax_metric + static_metric

    let syntax_passed: bool = syntax_metric == 5
    let static_passed: bool = static_metric == 8
    let runtime_passed: bool = runtime_metric == 13

    let actual_label_1: string@View = FrameOperationMetricLabel(syntax_metric)
    let syntax_passed_log_actual = [[log(label: "observed-frame-syntax-metric", expected: "5")]] actual_label_1
    let syntax_passed_with_log: bool = syntax_passed && (syntax_passed_log_actual == actual_label_1)
    let actual_label_2: string@View = FrameOperationMetricLabel(static_metric)
    let static_passed_log_actual = [[log(label: "observed-frame-static-metric", expected: "8")]] actual_label_2
    let static_passed_with_log: bool = static_passed && (static_passed_log_actual == actual_label_2)
    let actual_label_3: string@View = FrameOperationMetricLabel(runtime_metric)
    let runtime_passed_log_actual = [[log(label: "observed-frame-runtime-metric", expected: "13")]] actual_label_3
    let runtime_passed_with_log: bool = runtime_passed && (runtime_passed_log_actual == actual_label_3)
    [[log(label: "operations-log-runtime_phase_move")]]
    if (item_index == 0) {
        return RunFrameOperationItem(
            ctx,
            scope,
            "FrameOperationsSyntaxForms",
            "syntax forms for `frame { ... }` and explicit `r.frame { ... }`",
            "validated frame operations syntax forms",
            "frame-syntax",
            "evaluate implicit frame statement syntax in active region scope",
            "5",
            "5",
            "not-5",
            move syntax_passed_with_log,
            "frame syntax forms check failed"
        )
    }

    if (item_index == 1) {
        return RunFrameOperationItem(
            ctx,
            scope,
            "FrameOperationsStaticSemantics",
            "frame target typing and active-region requirements for explicit frame statements",
            "validated frame operations static semantics",
            "frame-static",
            "type-check explicit frame target resolution through region alias",
            "8",
            "8",
            "not-8",
            move static_passed_with_log,
            "frame static semantics check failed"
        )
    }

    if (item_index == 2) {
        return RunFrameOperationItem(
            ctx,
            scope,
            "FrameOperationsRuntimeDiagnostics",
            "runtime frame reset behavior and scoped state restoration",
            "validated frame operations runtime behavior and diagnostics",
            "frame-runtime",
            "execute implicit+explicit frame paths and verify aggregate runtime metric",
            "13",
            "13",
            "not-13",
            move runtime_passed_with_log,
            "frame runtime diagnostics check failed"
        )
    }

    return RunFrameOperationItem(
        ctx,
        scope,
        move item_name,
        "unknown frame operation item",
        "failed unknown frame operation item",
        "item-resolution",
        "resolve frame operation item name",
        "known-item",
        "known-item",
        "unknown-item",
        false,
        "unknown frame operation item"
    )
}

procedure RunFrameOperations(ctx: Context) -> i32 {
    let scope: string@View = "operations::ScopeCleanupAndAllocation::FrameOperations"
    let checkpoint: string@View = "covered frame operations operation items"

    let status_syntax: i32 = VerifyFrameOperationItem(ctx, scope, 0, "FrameOperationsSyntaxForms")
    if (status_syntax != 0) {
        return status_syntax
    }

    let status_static: i32 = VerifyFrameOperationItem(ctx, scope, 1, "FrameOperationsStaticSemantics")
    if (status_static != 0) {
        return status_static
    }

    let status_runtime: i32 = VerifyFrameOperationItem(ctx, scope, 2, "FrameOperationsRuntimeDiagnostics")
    if (status_runtime != 0) {
        return status_runtime
    }

    [[log(label: "operations-log-checkpoint")]]
    return 0
}
