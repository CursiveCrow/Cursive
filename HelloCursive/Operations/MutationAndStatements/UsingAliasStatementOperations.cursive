procedure LogUsingAliasObject(
    fs: $FileSystem,
    scope: string@View,
    move object_name: string@View,
    move object_type: string@View,
    move state: string@View,
    move details: string@View
) -> () {
    [[log(label: "operations-log-object")]]
}

procedure UsingAliasMetricLabel(value: i32) -> string@View {
    if (value == 5) {
        return "5"
    }
    if (value == 6) {
        return "6"
    }
    if (value == 10) {
        return "10"
    }
    return "other"
}

procedure RunUsingAliasItem(
    ctx: Context,
    scope: string@View,
    move item_name: string@View,
    move item_details: string@View,
    move item_reason: string@View,
    move step_name: string@View,
    move step_detail: string@View,
    move expected: string@View,
    move actual_pass: string@View,
    move actual_fail: string@View,
    move passed: bool,
    move failure_reason: string@View
) -> i32 {
    [[log(label: "operations-log-item_begin")]]
    let passed_place: bool = passed
    let item_check_log: bool = [[log(label: "observed-item-check-pass", expected: true)]] passed_place
    let item_check_ok: bool = passed_place && (item_check_log == true)
    if (item_check_ok == false) {
        [[log(label: "operations-log-transition")]]
        [[log(label: "operations-log-item_fail")]]
        return 1
    }

    [[log(label: "operations-log-operations_item_success")]]
    return 0
}

procedure VerifyUsingAliasItem(ctx: Context, scope: string@View, move item_index: i32, move item_name: string@View) -> i32 {
    [[log(label: "operations-log-runtime_phase_move")]]
    LogUsingAliasObject(ctx.fs, scope, "syntax_source", "i32", "constructed", "seed binding for using alias syntax probe prepared")
    LogUsingAliasObject(ctx.fs, scope, "static_source", "var i32", "constructed", "seed binding for using alias on mutable source prepared")
    LogUsingAliasObject(ctx.fs, scope, "chained_source", "var i32", "constructed", "seed binding for chained using aliases prepared")

    // Item 0: `using` as a read-only alias for an immutable binding in an inner scope.
    [[log(label: "operations-log-runtime_phase_move")]]
    [[log(label: "operations-log-transition_move")]]
    let syntax_source: i32 = 5
    var syntax_metric: i32 = 0
    {
        using syntax_source as syntax_alias
        syntax_metric = syntax_alias
    }

    // Item 1: `using` aliasing a mutable source - writes through source are
    // visible through alias since both resolve to the same binding.
    [[log(label: "operations-log-transition_move")]]
    [[log(label: "operations-log-transition_move")]]
    var static_source: i32 = 1
    var static_metric: i32 = 0
    {
        using static_source as static_alias
        static_source = static_source + 5
        static_metric = static_alias
    }

    // Item 2: chained `using` aliases - aliasing an alias still resolves to
    // the original binding, with the full accumulated value visible.
    [[log(label: "operations-log-transition_move")]]
    [[log(label: "operations-log-transition_move")]]
    var chained_source: i32 = 4
    var chained_metric: i32 = 0
    {
        using chained_source as chained_first
        {
            using chained_first as chained_second
            chained_source = chained_source + 6
            chained_metric = chained_second
        }
    }
    [[log(label: "operations-log-transition_move")]]
    let syntax_passed: bool = syntax_metric == 5
    let static_passed: bool = static_metric == 6
    let chained_passed: bool = chained_metric == 10

    let actual_label_1: string@View = UsingAliasMetricLabel(syntax_metric)
    let syntax_passed_log_actual = [[log(label: "observed-using-alias-syntax-metric", expected: "5")]] actual_label_1
    let syntax_passed_with_log: bool = syntax_passed && (syntax_passed_log_actual == actual_label_1)
    let actual_label_2: string@View = UsingAliasMetricLabel(static_metric)
    let static_passed_log_actual = [[log(label: "observed-using-alias-static-metric", expected: "6")]] actual_label_2
    let static_passed_with_log: bool = static_passed && (static_passed_log_actual == actual_label_2)
    let actual_label_3: string@View = UsingAliasMetricLabel(chained_metric)
    let chained_passed_log_actual = [[log(label: "observed-using-alias-chained-metric", expected: "10")]] actual_label_3
    let chained_passed_with_log: bool = chained_passed && (chained_passed_log_actual == actual_label_3)
    [[log(label: "operations-log-runtime_phase_move")]]
    if (item_index == 0) {
        return RunUsingAliasItem(
            ctx,
            scope,
            "UsingAliasStatementOperationsSyntax",
            "syntax form `using source as alias` at statement position",
            "validated using alias statement syntax form",
            "using-alias-syntax",
            "evaluate using-alias statement syntax on an immutable source",
            "5",
            "5",
            "not-5",
            move syntax_passed_with_log,
            "using alias syntax form check failed"
        )
    }

    if (item_index == 1) {
        return RunUsingAliasItem(
            ctx,
            scope,
            "UsingAliasStatementOperationsMutableSource",
            "using alias on a mutable source preserves source-alias identity",
            "validated using alias with mutable source",
            "using-alias-mutable-source",
            "mutate source through its original name; alias observes the updated value",
            "6",
            "6",
            "not-6",
            move static_passed_with_log,
            "using alias mutable source check failed"
        )
    }

    if (item_index == 2) {
        return RunUsingAliasItem(
            ctx,
            scope,
            "UsingAliasStatementOperationsChained",
            "chained using aliases resolve to the original binding",
            "validated chained using aliases",
            "using-alias-chained",
            "alias an alias; mutation through the original is visible through the chained alias",
            "10",
            "10",
            "not-10",
            move chained_passed_with_log,
            "chained using aliases check failed"
        )
    }

    return RunUsingAliasItem(
        ctx,
        scope,
        move item_name,
        "unknown using alias statement operation item",
        "failed unknown using alias statement operation item",
        "item-resolution",
        "resolve using alias statement operation item name",
        "known-item",
        "known-item",
        "unknown-item",
        false,
        "unknown using alias statement operation item"
    )
}

procedure RunUsingAliasStatementOperations(ctx: Context) -> i32 {
    let scope: string@View = "operations::MutationAndStatements::UsingAliasStatementOperations"
    let checkpoint: string@View = "covered using alias statement operations items"

    let status_syntax: i32 = VerifyUsingAliasItem(ctx, scope, 0, "UsingAliasStatementOperationsSyntax")
    if (status_syntax != 0) {
        return status_syntax
    }

    let status_static: i32 = VerifyUsingAliasItem(ctx, scope, 1, "UsingAliasStatementOperationsMutableSource")
    if (status_static != 0) {
        return status_static
    }

    let status_chained: i32 = VerifyUsingAliasItem(ctx, scope, 2, "UsingAliasStatementOperationsChained")
    if (status_chained != 0) {
        return status_chained
    }

    [[log(label: "operations-log-checkpoint")]]
    return 0
}
