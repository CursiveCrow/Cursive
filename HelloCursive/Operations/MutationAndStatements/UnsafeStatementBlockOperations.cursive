procedure LogUnsafeStatementObject(
    fs: $FileSystem,
    scope: string@View,
    move object_name: string@View,
    move object_type: string@View,
    move state: string@View,
    move details: string@View
) -> () {
    }

procedure UnsafeStatementMetricLabel(value: i32) -> string@View {
    if (value == 3) {
        return "3"
    }
    if (value == 6) {
        return "6"
    }
    if (value == 8) {
        return "8"
    }
    return "other"
}

procedure RunUnsafeStatementItem(
    ctx: Context,
    scope: string@View,
    move item_name: string@View,
    move item_details: string@View,
    move item_reason: string@View,
    move step_name: string@View,
    move step_detail: string@View,
    move expected: string@View,
    move actual_pass: string@View,
    move actual_fail: string@View,
    move passed: bool,
    move failure_reason: string@View
) -> i32 {
    let passed_place: bool = passed
    let item_check_log: bool = passed_place
    let item_check_ok: bool = passed_place && (item_check_log == true)
    if (item_check_ok == false) {
        return 1
    }

    return 0
}

procedure VerifyUnsafeStatementItem(ctx: Context, scope: string@View, move item_index: i32, move item_name: string@View) -> i32 {
    LogUnsafeStatementObject(ctx.fs, scope, "unsafe_statement_syntax_slot", "i32", "constructed", "syntax mutation carrier for statement unsafe block prepared")
    LogUnsafeStatementObject(ctx.fs, scope, "unsafe_statement_static_source", "Ptr<i32>@Valid", "constructed", "safe pointer source for statement unsafe raw operations prepared")
    LogUnsafeStatementObject(ctx.fs, scope, "unsafe_statement_runtime_source", "Ptr<i32>@Valid", "constructed", "runtime safe pointer source for statement unsafe aggregate prepared")

    var syntax_slot: i32 = 1
    unsafe {
        syntax_slot = syntax_slot + 2
    }
    let syntax_metric: i32 = syntax_slot
    let static_source: i32 = 4
    let static_safe_ptr: Ptr<i32>@Valid = &static_source
    var static_metric: i32 = 0
    unsafe {
        let static_raw_ptr: *imm i32 = transmute<Ptr<i32>@Valid, *imm i32>(static_safe_ptr)
        static_metric = *static_raw_ptr + 2
    }
    let runtime_source: i32 = 5
    let runtime_safe_ptr: Ptr<i32>@Valid = &runtime_source
    var runtime_metric: i32 = 0
    unsafe {
        let runtime_raw_ptr: *imm i32 = transmute<Ptr<i32>@Valid, *imm i32>(runtime_safe_ptr)
        runtime_metric = *runtime_raw_ptr
    }
    runtime_metric = runtime_metric + syntax_metric
    let syntax_passed: bool = syntax_metric == 3
    let static_passed: bool = static_metric == 6
    let runtime_passed: bool = runtime_metric == 8

    let actual_label_1: string@View = UnsafeStatementMetricLabel(syntax_metric)
    let syntax_passed_log_actual = actual_label_1
    let syntax_passed_with_log: bool = syntax_passed && (syntax_passed_log_actual == actual_label_1)
    let actual_label_2: string@View = UnsafeStatementMetricLabel(static_metric)
    let static_passed_log_actual = actual_label_2
    let static_passed_with_log: bool = static_passed && (static_passed_log_actual == actual_label_2)
    let actual_label_3: string@View = UnsafeStatementMetricLabel(runtime_metric)
    let runtime_passed_log_actual = actual_label_3
    let runtime_passed_with_log: bool = runtime_passed && (runtime_passed_log_actual == actual_label_3)
    if (item_index == 0) {
        return RunUnsafeStatementItem(
            ctx,
            scope,
            "UnsafeStatementBlockOperationsSyntaxForms",
            "statement-form unsafe block syntax using `unsafe { ... }`",
            "validated unsafe statement block operations syntax forms",
            "unsafe-statement-syntax",
            "evaluate statement-form unsafe block syntax with mutable side effect",
            "3",
            "3",
            "not-3",
            move syntax_passed_with_log,
            "unsafe statement block syntax forms check failed"
        )
    }

    if (item_index == 1) {
        return RunUnsafeStatementItem(
            ctx,
            scope,
            "UnsafeStatementBlockOperationsStaticSemantics",
            "unsafe-boundary typing for raw pointer transmute and dereference in statement block",
            "validated unsafe statement block operations static semantics",
            "unsafe-statement-static",
            "type-check raw pointer unsafe operations contained by statement unsafe block",
            "6",
            "6",
            "not-6",
            move static_passed_with_log,
            "unsafe statement block static semantics check failed"
        )
    }

    if (item_index == 2) {
        return RunUnsafeStatementItem(
            ctx,
            scope,
            "UnsafeStatementBlockOperationsRuntimeDiagnostics",
            "runtime sequencing of statement unsafe effects with outer expression aggregation",
            "validated unsafe statement block operations runtime behavior and diagnostics",
            "unsafe-statement-runtime",
            "execute statement unsafe raw-pointer path and verify runtime aggregate metric",
            "8",
            "8",
            "not-8",
            move runtime_passed_with_log,
            "unsafe statement block runtime diagnostics check failed"
        )
    }

    return RunUnsafeStatementItem(
        ctx,
        scope,
        move item_name,
        "unknown unsafe statement block operation item",
        "failed unknown unsafe statement block operation item",
        "item-resolution",
        "resolve unsafe statement block operation item name",
        "known-item",
        "known-item",
        "unknown-item",
        false,
        "unknown unsafe statement block operation item"
    )
}

procedure RunUnsafeStatementBlockOperations(ctx: Context) -> i32 {
    let scope: string@View = "operations::MutationAndStatements::UnsafeStatementBlockOperations"
    let checkpoint: string@View = "covered unsafe statement block operations operation items"

    let status_syntax: i32 = VerifyUnsafeStatementItem(ctx, scope, 0, "UnsafeStatementBlockOperationsSyntaxForms")
    if (status_syntax != 0) {
        return status_syntax
    }

    let status_static: i32 = VerifyUnsafeStatementItem(ctx, scope, 1, "UnsafeStatementBlockOperationsStaticSemantics")
    if (status_static != 0) {
        return status_static
    }

    let status_runtime: i32 = VerifyUnsafeStatementItem(ctx, scope, 2, "UnsafeStatementBlockOperationsRuntimeDiagnostics")
    if (status_runtime != 0) {
        return status_runtime
    }

    return 0
}
