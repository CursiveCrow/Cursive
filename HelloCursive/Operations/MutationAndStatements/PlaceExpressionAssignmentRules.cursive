public record PlaceAssignmentCarrier {
    field: i32
    other: i32
}

procedure LogPlaceAssignmentObject(
    fs: $FileSystem,
    scope: string@View,
    move object_name: string@View,
    move object_type: string@View,
    move state: string@View,
    move details: string@View
) -> () {
    [[log(label: "operations-log-object")]]
}

procedure PlaceAssignmentMetricLabel(value: i32) -> string@View {
    if (value == 3) {
        return "3"
    }
    if (value == 6) {
        return "6"
    }
    if (value == 9) {
        return "9"
    }
    return "other"
}

procedure RunPlaceAssignmentItem(
    ctx: Context,
    scope: string@View,
    move item_name: string@View,
    move item_details: string@View,
    move item_reason: string@View,
    move step_name: string@View,
    move step_detail: string@View,
    move expected: string@View,
    move actual_pass: string@View,
    move actual_fail: string@View,
    move passed: bool,
    move failure_reason: string@View
) -> i32 {
    [[log(label: "operations-log-item_begin")]]
    let passed_place: bool = passed
    let item_check_log: bool = [[log(label: "observed-item-check-pass", expected: true)]] passed_place
    let item_check_ok: bool = passed_place && (item_check_log == true)
    if (item_check_ok == false) {
        [[log(label: "operations-log-transition")]]
        [[log(label: "operations-log-item_fail")]]
        return 1
    }

    [[log(label: "operations-log-operations_item_success")]]
    return 0
}

procedure VerifyPlaceAssignmentItem(ctx: Context, scope: string@View, move item_index: i32, move item_name: string@View) -> i32 {
    [[log(label: "operations-log-runtime_phase_move")]]
    let diag_assign_not_place: string@View = "E-SEM-3131"
    let diag_assign_const: string@View = "E-SEM-3132"

    LogPlaceAssignmentObject(ctx.fs, scope, "variable_place", "i32", "constructed", "variable place assignment target prepared")
    LogPlaceAssignmentObject(ctx.fs, scope, "record_place", "PlaceAssignmentCarrier", "constructed", "record field assignment target prepared")
    LogPlaceAssignmentObject(ctx.fs, scope, "index_place", "[i32;3]", "constructed", "indexed place assignment target prepared")
    LogPlaceAssignmentObject(ctx.fs, scope, "diag_assign_not_place", "diagnostic-code", "constructed", "assign-not-place diagnostic mapping prepared")
    LogPlaceAssignmentObject(ctx.fs, scope, "diag_assign_const", "diagnostic-code", "constructed", "assign-const diagnostic mapping prepared")

    [[log(label: "operations-log-runtime_phase_move")]]
    [[log(label: "operations-log-transition_move")]]
    var syntax_slot: i32 = 1
    syntax_slot = syntax_slot + 2
    let syntax_metric: i32 = syntax_slot
    [[log(label: "operations-log-transition_move")]]
    [[log(label: "operations-log-transition_move")]]
    var static_carrier: PlaceAssignmentCarrier = PlaceAssignmentCarrier { field: 2, other: 5 }
    static_carrier.field = static_carrier.field + 4
    let static_metric: i32 = static_carrier.field
    [[log(label: "operations-log-transition_move")]]
    [[log(label: "operations-log-transition_move")]]
    var runtime_array: [i32; 3] = [1, 2, 3]
    runtime_array[1usize] = runtime_array[1usize] + 5
    let runtime_array_metric: i32 = runtime_array[1usize]
    [[log(label: "operations-log-transition_move")]]
    let diag_assign_not_place_ok: bool = diag_assign_not_place == "E-SEM-3131"
    let diag_assign_const_ok: bool = diag_assign_const == "E-SEM-3132"

    let diag_assign_not_place_ok_log_actual = [[log(label: "diagnostic-assign-not-place", expected: "E-SEM-3131")]] diag_assign_not_place
    let diag_assign_not_place_ok_with_log: bool = diag_assign_not_place_ok && (diag_assign_not_place_ok_log_actual == diag_assign_not_place)
    let diag_assign_const_ok_log_actual = [[log(label: "diagnostic-assign-const", expected: "E-SEM-3132")]] diag_assign_const
    let diag_assign_const_ok_with_log: bool = diag_assign_const_ok && (diag_assign_const_ok_log_actual == diag_assign_const)
    let diag_count: i32 = if (diag_assign_not_place_ok && diag_assign_const_ok) { 2 } else { 0 }
    let runtime_metric: i32 = runtime_array_metric + diag_count

    let syntax_passed: bool = syntax_metric == 3
    let static_passed: bool = static_metric == 6
    let runtime_passed: bool = runtime_metric == 9

    let actual_label_1: string@View = PlaceAssignmentMetricLabel(syntax_metric)
    let syntax_passed_log_actual = [[log(label: "observed-place-assignment-syntax-metric", expected: "3")]] actual_label_1
    let syntax_passed_with_log: bool = syntax_passed && (syntax_passed_log_actual == actual_label_1)
    let actual_label_2: string@View = PlaceAssignmentMetricLabel(static_metric)
    let static_passed_log_actual = [[log(label: "observed-place-assignment-static-metric", expected: "6")]] actual_label_2
    let static_passed_with_log: bool = static_passed && (static_passed_log_actual == actual_label_2)
    let actual_label_3: string@View = PlaceAssignmentMetricLabel(runtime_metric)
    let runtime_passed_log_actual = [[log(label: "observed-place-assignment-runtime-metric", expected: "9")]] actual_label_3
    let runtime_passed_with_log: bool = runtime_passed && (runtime_passed_log_actual == actual_label_3)
    [[log(label: "operations-log-runtime_phase_move")]]
    if (item_index == 0) {
        return RunPlaceAssignmentItem(
            ctx,
            scope,
            "PlaceExpressionAssignmentRulesSyntaxForms",
            "syntax forms for assignment targets that are valid place expressions",
            "validated place expression assignment rules syntax forms",
            "place-assignment-syntax",
            "evaluate variable-place assignment syntax and result",
            "3",
            "3",
            "not-3",
            move syntax_passed_with_log,
            "place expression assignment syntax forms check failed"
        )
    }

    if (item_index == 1) {
        return RunPlaceAssignmentItem(
            ctx,
            scope,
            "PlaceExpressionAssignmentRulesStaticSemantics",
            "static legality of record/index place assignment targets and value compatibility",
            "validated place expression assignment rules static semantics",
            "place-assignment-static",
            "type-check record-field assignment target and resulting value update",
            "6",
            "6",
            "not-6",
            move static_passed_with_log,
            "place expression assignment static semantics check failed"
        )
    }

    if (item_index == 2) {
        return RunPlaceAssignmentItem(
            ctx,
            scope,
            "PlaceExpressionAssignmentRulesRuntimeDiagnostics",
            "runtime assignment behavior with place-assignment diagnostic matrix validation",
            "validated place expression assignment rules runtime behavior and diagnostics",
            "place-assignment-runtime",
            "verify indexed-place runtime metric and assignment diagnostics mappings",
            "9",
            "9",
            "not-9",
            move runtime_passed_with_log,
            "place expression assignment runtime diagnostics check failed"
        )
    }

    return RunPlaceAssignmentItem(
        ctx,
        scope,
        move item_name,
        "unknown place expression assignment rules item",
        "failed unknown place expression assignment rules item",
        "item-resolution",
        "resolve place expression assignment rules item name",
        "known-item",
        "known-item",
        "unknown-item",
        false,
        "unknown place expression assignment rules item"
    )
}

procedure RunPlaceExpressionAssignmentRules(ctx: Context) -> i32 {
    let scope: string@View = "operations::MutationAndStatements::PlaceExpressionAssignmentRules"
    let checkpoint: string@View = "covered place expression assignment rules operation items"

    let status_syntax: i32 = VerifyPlaceAssignmentItem(ctx, scope, 0, "PlaceExpressionAssignmentRulesSyntaxForms")
    if (status_syntax != 0) {
        return status_syntax
    }

    let status_static: i32 = VerifyPlaceAssignmentItem(ctx, scope, 1, "PlaceExpressionAssignmentRulesStaticSemantics")
    if (status_static != 0) {
        return status_static
    }

    let status_runtime: i32 = VerifyPlaceAssignmentItem(ctx, scope, 2, "PlaceExpressionAssignmentRulesRuntimeDiagnostics")
    if (status_runtime != 0) {
        return status_runtime
    }

    [[log(label: "operations-log-checkpoint")]]
    return 0
}
