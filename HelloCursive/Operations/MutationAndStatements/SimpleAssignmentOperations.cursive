public record SimpleAssignmentCarrier {
    field: i32
    other: i32
}

procedure LogSimpleAssignmentObject(
    fs: $FileSystem,
    scope: string@View,
    move object_name: string@View,
    move object_type: string@View,
    move state: string@View,
    move details: string@View
) -> () {
    [[log(label: "operations-log-object")]]
}

procedure SimpleAssignmentMetricLabel(value: i32) -> string@View {
    if (value == 3) {
        return "3"
    }
    if (value == 6) {
        return "6"
    }
    if (value == 9) {
        return "9"
    }
    return "other"
}

procedure RunSimpleAssignmentItem(
    ctx: Context,
    scope: string@View,
    move item_name: string@View,
    move item_details: string@View,
    move item_reason: string@View,
    move step_name: string@View,
    move step_detail: string@View,
    move expected: string@View,
    move actual_pass: string@View,
    move actual_fail: string@View,
    move passed: bool,
    move failure_reason: string@View
) -> i32 {
    [[log(label: "operations-log-item_begin")]]
    let passed_place: bool = passed
    let item_check_log: bool = [[log(label: "observed-item-check-pass", expected: true)]] passed_place
    let item_check_ok: bool = passed_place && (item_check_log == true)
    if (item_check_ok == false) {
        [[log(label: "operations-log-transition")]]
        [[log(label: "operations-log-item_fail")]]
        return 1
    }

    [[log(label: "operations-log-operations_item_success")]]
    return 0
}

procedure VerifySimpleAssignmentItem(ctx: Context, scope: string@View, move item_index: i32, move item_name: string@View) -> i32 {
    [[log(label: "operations-log-runtime_phase_move")]]
    let diag_assign_not_place: string@View = "E-SEM-3131"
    let diag_assign_type_mismatch: string@View = "E-SEM-3133"

    LogSimpleAssignmentObject(ctx.fs, scope, "simple_variable_slot", "i32", "constructed", "simple variable assignment target prepared")
    LogSimpleAssignmentObject(ctx.fs, scope, "simple_record_slot", "SimpleAssignmentCarrier", "constructed", "simple record assignment target prepared")
    LogSimpleAssignmentObject(ctx.fs, scope, "simple_index_slot", "[i32;3]", "constructed", "simple index assignment target prepared")
    LogSimpleAssignmentObject(ctx.fs, scope, "diag_assign_not_place", "diagnostic-code", "constructed", "assign-not-place diagnostic mapping prepared")
    LogSimpleAssignmentObject(ctx.fs, scope, "diag_assign_type_mismatch", "diagnostic-code", "constructed", "assign-type-mismatch diagnostic mapping prepared")

    [[log(label: "operations-log-runtime_phase_move")]]
    [[log(label: "operations-log-transition_move")]]
    var syntax_slot: i32 = 1
    syntax_slot = 3
    let syntax_metric: i32 = syntax_slot
    [[log(label: "operations-log-transition_move")]]
    [[log(label: "operations-log-transition_move")]]
    var static_carrier: SimpleAssignmentCarrier = SimpleAssignmentCarrier { field: 2, other: 4 }
    static_carrier.field = 6
    let static_metric: i32 = static_carrier.field
    [[log(label: "operations-log-transition_move")]]
    [[log(label: "operations-log-transition_move")]]
    var runtime_array: [i32; 3] = [1, 2, 3]
    runtime_array[1usize] = 7
    let runtime_array_metric: i32 = runtime_array[1usize]
    [[log(label: "operations-log-transition_move")]]
    let diag_assign_not_place_ok: bool = diag_assign_not_place == "E-SEM-3131"
    let diag_assign_type_mismatch_ok: bool = diag_assign_type_mismatch == "E-SEM-3133"

    let diag_assign_not_place_ok_log_actual = [[log(label: "diagnostic-simple-assign-not-place", expected: "E-SEM-3131")]] diag_assign_not_place
    let diag_assign_not_place_ok_with_log: bool = diag_assign_not_place_ok && (diag_assign_not_place_ok_log_actual == diag_assign_not_place)
    let diag_assign_type_mismatch_ok_log_actual = [[log(label: "diagnostic-simple-assign-type-mismatch", expected: "E-SEM-3133")]] diag_assign_type_mismatch
    let diag_assign_type_mismatch_ok_with_log: bool = diag_assign_type_mismatch_ok && (diag_assign_type_mismatch_ok_log_actual == diag_assign_type_mismatch)
    let diag_count: i32 = if (diag_assign_not_place_ok && diag_assign_type_mismatch_ok) { 2 } else { 0 }
    let runtime_metric: i32 = runtime_array_metric + diag_count

    let syntax_passed: bool = syntax_metric == 3
    let static_passed: bool = static_metric == 6
    let runtime_passed: bool = runtime_metric == 9

    let actual_label_1: string@View = SimpleAssignmentMetricLabel(syntax_metric)
    let syntax_passed_log_actual = [[log(label: "observed-simple-assignment-syntax-metric", expected: "3")]] actual_label_1
    let syntax_passed_with_log: bool = syntax_passed && (syntax_passed_log_actual == actual_label_1)
    let actual_label_2: string@View = SimpleAssignmentMetricLabel(static_metric)
    let static_passed_log_actual = [[log(label: "observed-simple-assignment-static-metric", expected: "6")]] actual_label_2
    let static_passed_with_log: bool = static_passed && (static_passed_log_actual == actual_label_2)
    let actual_label_3: string@View = SimpleAssignmentMetricLabel(runtime_metric)
    let runtime_passed_log_actual = [[log(label: "observed-simple-assignment-runtime-metric", expected: "9")]] actual_label_3
    let runtime_passed_with_log: bool = runtime_passed && (runtime_passed_log_actual == actual_label_3)
    [[log(label: "operations-log-runtime_phase_move")]]
    if (item_index == 0) {
        return RunSimpleAssignmentItem(
            ctx,
            scope,
            "SimpleAssignmentOperationsSyntaxForms",
            "syntax forms for simple `=` assignment statements",
            "validated simple assignment operations syntax forms",
            "simple-assignment-syntax",
            "evaluate simple `=` assignment syntax on variable place",
            "3",
            "3",
            "not-3",
            move syntax_passed_with_log,
            "simple assignment syntax forms check failed"
        )
    }

    if (item_index == 1) {
        return RunSimpleAssignmentItem(
            ctx,
            scope,
            "SimpleAssignmentOperationsStaticSemantics",
            "place and type compatibility for simple assignments",
            "validated simple assignment operations static semantics",
            "simple-assignment-static",
            "type-check record-field simple assignment target and assigned value",
            "6",
            "6",
            "not-6",
            move static_passed_with_log,
            "simple assignment static semantics check failed"
        )
    }

    if (item_index == 2) {
        return RunSimpleAssignmentItem(
            ctx,
            scope,
            "SimpleAssignmentOperationsRuntimeDiagnostics",
            "runtime simple assignment behavior with assignment diagnostics matrix validation",
            "validated simple assignment operations runtime behavior and diagnostics",
            "simple-assignment-runtime",
            "verify simple indexed assignment runtime metric and diagnostics mappings",
            "9",
            "9",
            "not-9",
            move runtime_passed_with_log,
            "simple assignment runtime diagnostics check failed"
        )
    }

    return RunSimpleAssignmentItem(
        ctx,
        scope,
        move item_name,
        "unknown simple assignment operation item",
        "failed unknown simple assignment operation item",
        "item-resolution",
        "resolve simple assignment operation item name",
        "known-item",
        "known-item",
        "unknown-item",
        false,
        "unknown simple assignment operation item"
    )
}

procedure RunSimpleAssignmentOperations(ctx: Context) -> i32 {
    let scope: string@View = "operations::MutationAndStatements::SimpleAssignmentOperations"
    let checkpoint: string@View = "covered simple assignment operations operation items"

    let status_syntax: i32 = VerifySimpleAssignmentItem(ctx, scope, 0, "SimpleAssignmentOperationsSyntaxForms")
    if (status_syntax != 0) {
        return status_syntax
    }

    let status_static: i32 = VerifySimpleAssignmentItem(ctx, scope, 1, "SimpleAssignmentOperationsStaticSemantics")
    if (status_static != 0) {
        return status_static
    }

    let status_runtime: i32 = VerifySimpleAssignmentItem(ctx, scope, 2, "SimpleAssignmentOperationsRuntimeDiagnostics")
    if (status_runtime != 0) {
        return status_runtime
    }

    [[log(label: "operations-log-checkpoint")]]
    return 0
}
