procedure ContextualKeywordMetricLabel(value: i32) -> string@View {
    if (value == 6) {
        return "6"
    }
    if (value == 23) {
        return "23"
    }
    if (value == 52) {
        return "52"
    }
    return "other"
}

procedure RunContextualKeywordSurfaceOperations(ctx: Context) -> i32 {
    let in: i32 = 5
    let key: i32 = 7
    let wait: i32 = 11
    let identifiers_metric: i32 = in + key + wait

    let dispatch_metric: i32 = parallel ctx~>cpu() {
        let gate: i32 = 0
        dispatch i in 0usize..3usize key gate read [reduce: +] { (i as i32) + 1 }
    }

    let wait_metric: i32 = parallel ctx~>cpu() {
        let handle = spawn { wait + key }
        let waited_value: i32 = wait handle
        waited_value + in
    }

    let aggregate_metric: i32 =
        identifiers_metric + dispatch_metric + wait_metric

    let identifiers_label: string@View = ContextualKeywordMetricLabel(identifiers_metric)
    let dispatch_label: string@View = ContextualKeywordMetricLabel(dispatch_metric)
    let wait_label: string@View = ContextualKeywordMetricLabel(wait_metric)
    let aggregate_label: string@View = ContextualKeywordMetricLabel(aggregate_metric)

    let identifiers_log: string@View = identifiers_label
    let dispatch_log: string@View = dispatch_label
    let wait_log: string@View = wait_label
    let aggregate_log: string@View = aggregate_label

    let runtime_ok: bool =
        (identifiers_log == "23") &&
        (dispatch_log == "6") &&
        (wait_log == "23") &&
        (aggregate_log == "52")
    let runtime_ok_log: bool = runtime_ok
    if (runtime_ok_log == false) {
        return 1
    }

    return 0
}
