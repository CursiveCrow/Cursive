procedure InlineGpuDomainMetricLabel(value: i32) -> string@View {
    if (value == 0) {
        return "0"
    }
    if (value == 1) {
        return "1"
    }
    if (value == 3) {
        return "3"
    }
    if (value == 4) {
        return "4"
    }
    if (value == 5) {
        return "5"
    }
    if (value == 7) {
        return "7"
    }
    if (value == 8) {
        return "8"
    }
    if (value == 10) {
        return "10"
    }
    if (value == 12) {
        return "12"
    }
    if (value == 15) {
        return "15"
    }
    if (value == 22) {
        return "22"
    }
    if (value == 34) {
        return "34"
    }
    return "other"
}

procedure RunInlineAndGpuDomainOperationsItem(
    ctx: Context,
    scope: string@View,
    move item_name: string@View,
    move item_details: string@View,
    move item_reason: string@View,
    move step_name: string@View,
    move step_detail: string@View,
    move expected: string@View,
    move actual_pass: string@View,
    move actual_fail: string@View,
    move passed: bool,
    move failure_reason: string@View
) -> i32 {
    let detail_begin: string@View = "operation feature item exercise start"
    [[log(label: "operations-log-item_begin")]]
    let passed_place: bool = passed
    let item_check_log: bool = [[log(label: "observed-item-check-pass", expected: true)]] passed_place
    let item_check_ok: bool = passed_place && (item_check_log == true)
    if (item_check_ok == false) {
        [[log(label: "operations-log-transition")]]
        [[log(label: "operations-log-item_fail")]]
        return 1
    }

    [[log(label: "operations-log-operations_item_success")]]
    return 0
}

procedure VerifyInlineAndGpuDomainOperationsItem(ctx: Context, scope: string@View, move item_index: i32, move item_name: string@View) -> i32 {
    [[log(label: "operations-log-runtime_phase_move")]]

    [[log(label: "operations-log-runtime_phase_move")]]
    [[log(label: "operations-log-transition_move")]]
    let inline_single_metric: i32 = parallel ctx~>inline() {
        spawn { 5 }
    }
    [[log(label: "operations-log-transition_move")]]
    [[log(label: "operations-log-transition_move")]]
    let inline_multi_metric: (i32, i32) = parallel ctx~>inline() {
        spawn { 3 };
        spawn { 4 }
    }
    let inline_multi_sum: i32 = inline_multi_metric.0 + inline_multi_metric.1
    [[log(label: "operations-log-transition_move")]]
    [[log(label: "operations-log-transition_move")]]
    let inline_named_metric: i32 = parallel ctx~>inline() [name: "inline-named"] {
        spawn { 8 }
    }
    [[log(label: "operations-log-transition_move")]]
    [[log(label: "operations-log-transition_move")]]
    let inline_dispatch_metric: i32 = parallel ctx~>inline() {
        dispatch i in 0usize..4usize [reduce: +] { (i as i32) + 1 }
    }
    [[log(label: "operations-log-transition_move")]]
    [[log(label: "operations-log-transition_move")]]
    let gpu_single_metric: i32 = parallel ctx~>gpu() {
        spawn { 12 }
    }
    [[log(label: "operations-log-transition_move")]]
    [[log(label: "operations-log-transition_move")]]
    let gpu_dispatch_metric: i32 = parallel ctx~>gpu() {
        dispatch j in 0usize..5usize [reduce: +] { (j as i32) + 1 }
    }
    [[log(label: "operations-log-transition_move")]]

    let inline_runtime_metric: i32 = inline_single_metric + inline_multi_sum + inline_named_metric + inline_dispatch_metric
    let gpu_runtime_metric: i32 = gpu_single_metric + gpu_dispatch_metric

    let observed_inline_single: string@View = "observed-inline-single-spawn-metric"
    let observed_inline_multi: string@View = "observed-inline-multi-spawn-metric"
    let observed_inline_named: string@View = "observed-inline-named-metric"
    let observed_inline_dispatch: string@View = "observed-inline-dispatch-metric"
    let observed_gpu_single: string@View = "observed-gpu-single-spawn-metric"
    let observed_gpu_dispatch: string@View = "observed-gpu-dispatch-metric"

    let expected_inline_single: string@View = "5"
    let expected_inline_multi: string@View = "7"
    let expected_inline_named: string@View = "8"
    let expected_inline_dispatch: string@View = "10"
    let expected_gpu_single: string@View = "12"
    let expected_gpu_dispatch: string@View = "15"

    let inline_single_label: string@View = InlineGpuDomainMetricLabel(inline_single_metric)
    let inline_multi_label: string@View = InlineGpuDomainMetricLabel(inline_multi_sum)
    let inline_named_label: string@View = InlineGpuDomainMetricLabel(inline_named_metric)
    let inline_dispatch_label: string@View = InlineGpuDomainMetricLabel(inline_dispatch_metric)
    let gpu_single_label: string@View = InlineGpuDomainMetricLabel(gpu_single_metric)
    let gpu_dispatch_label: string@View = InlineGpuDomainMetricLabel(gpu_dispatch_metric)

    let inline_single_passed: bool = inline_single_metric == 5
    let inline_multi_passed: bool = inline_multi_sum == 7
    let inline_named_passed: bool = inline_named_metric == 8
    let inline_dispatch_passed: bool = inline_dispatch_metric == 10
    let gpu_single_passed: bool = gpu_single_metric == 12
    let gpu_dispatch_passed: bool = gpu_dispatch_metric == 15

    let inline_single_log = [[log(label: "observed-inline-single-spawn-metric", expected: "5")]] inline_single_label
    let inline_single_with_log: bool = inline_single_passed && (inline_single_log == inline_single_label)
    let inline_multi_log = [[log(label: "observed-inline-multi-spawn-metric", expected: "7")]] inline_multi_label
    let inline_multi_with_log: bool = inline_multi_passed && (inline_multi_log == inline_multi_label)
    let inline_named_log = [[log(label: "observed-inline-named-metric", expected: "8")]] inline_named_label
    let inline_named_with_log: bool = inline_named_passed && (inline_named_log == inline_named_label)
    let inline_dispatch_log = [[log(label: "observed-inline-dispatch-metric", expected: "10")]] inline_dispatch_label
    let inline_dispatch_with_log: bool = inline_dispatch_passed && (inline_dispatch_log == inline_dispatch_label)
    let gpu_single_log = [[log(label: "observed-gpu-single-spawn-metric", expected: "12")]] gpu_single_label
    let gpu_single_with_log: bool = gpu_single_passed && (gpu_single_log == gpu_single_label)
    let gpu_dispatch_log = [[log(label: "observed-gpu-dispatch-metric", expected: "15")]] gpu_dispatch_label
    let gpu_dispatch_with_log: bool = gpu_dispatch_passed && (gpu_dispatch_log == gpu_dispatch_label)

    [[log(label: "operations-log-runtime_phase_move")]]
    if (item_index == 0) {
        return RunInlineAndGpuDomainOperationsItem(
            ctx,
            scope,
            "InlineDomainSpawnAndDispatch",
            "inline execution domain spawn and dispatch operations",
            "validated inline domain operations",
            "inline-domain",
            "evaluate parallel spawn and dispatch on inline sequential domain",
            "5",
            "5",
            "not-5",
            move inline_single_with_log,
            "inline domain single spawn check failed"
        )
    }

    if (item_index == 1) {
        let inline_all_ok: bool = inline_multi_with_log && inline_named_with_log && inline_dispatch_with_log
        return RunInlineAndGpuDomainOperationsItem(
            ctx,
            scope,
            "InlineDomainCompletionSemantics",
            "inline domain multi-spawn, named block, and dispatch completion",
            "validated inline domain completion semantics",
            "inline-completion",
            "verify inline domain multi-spawn tuple, named block, and dispatch reduction",
            "10",
            "10",
            "not-10",
            move inline_all_ok,
            "inline domain completion semantics check failed"
        )
    }

    if (item_index == 2) {
        let gpu_all_ok: bool = gpu_single_with_log && gpu_dispatch_with_log
        return RunInlineAndGpuDomainOperationsItem(
            ctx,
            scope,
            "GpuDomainSpawnAndDispatch",
            "GPU execution domain spawn and dispatch operations",
            "validated GPU domain operations",
            "gpu-domain",
            "evaluate parallel spawn and dispatch on GPU execution domain",
            "12",
            "12",
            "not-12",
            move gpu_all_ok,
            "GPU domain operations check failed"
        )
    }

    return RunInlineAndGpuDomainOperationsItem(
        ctx,
        scope,
        move item_name,
        "unknown inline/GPU domain operation item",
        "failed unknown inline/GPU domain operation item",
        "item-resolution",
        "resolve inline/GPU domain operation item name",
        "known-item",
        "known-item",
        "unknown-item",
        false,
        "unknown inline/GPU domain operation item"
    )
}

procedure RunInlineAndGpuDomainOperations(ctx: Context) -> i32 {
    let scope: string@View = "operations::StructuredParallel::InlineAndGpuDomainOperations"
    let checkpoint: string@View = "covered inline and GPU domain operation items"

    let status_inline_single: i32 = VerifyInlineAndGpuDomainOperationsItem(ctx, scope, 0, "InlineDomainSpawnAndDispatch")
    if (status_inline_single != 0) {
        return status_inline_single
    }

    let status_inline_completion: i32 = VerifyInlineAndGpuDomainOperationsItem(ctx, scope, 1, "InlineDomainCompletionSemantics")
    if (status_inline_completion != 0) {
        return status_inline_completion
    }

    let status_gpu: i32 = VerifyInlineAndGpuDomainOperationsItem(ctx, scope, 2, "GpuDomainSpawnAndDispatch")
    if (status_gpu != 0) {
        return status_gpu
    }

    [[log(label: "operations-log-checkpoint")]]
    return 0
}
