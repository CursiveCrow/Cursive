procedure DispatchCustomReduce(left: i32, right: i32) -> i32 {
    return left + right
}

procedure LogDispatchExpressionObject(
    fs: $FileSystem,
    scope: string@View,
    move object_name: string@View,
    move object_type: string@View,
    move state: string@View,
    move details: string@View
) -> () {
    [[log(label: "operations-log-object")]]
}

procedure DispatchExpressionMetricLabel(value: i32) -> string@View {
    if (value == 0) {
        return "0"
    }
    if (value == 1) {
        return "1"
    }
    if (value == 2) {
        return "2"
    }
    if (value == 4) {
        return "4"
    }
    if (value == 5) {
        return "5"
    }
    if (value == 6) {
        return "6"
    }
    if (value == 7) {
        return "7"
    }
    if (value == 8) {
        return "8"
    }
    if (value == 9) {
        return "9"
    }
    if (value == 10) {
        return "10"
    }
    if (value == 11) {
        return "11"
    }
    if (value == 12) {
        return "12"
    }
    if (value == 3) {
        return "3"
    }
    if (value == 13) {
        return "13"
    }
    if (value == 14) {
        return "14"
    }
    if (value == 20) {
        return "20"
    }
    if (value == 42) {
        return "42"
    }
    if (value == 55) {
        return "55"
    }
    return "other"
}

procedure RunDispatchExpressionOperationsItem(
    ctx: Context,
    scope: string@View,
    move item_name: string@View,
    move item_details: string@View,
    move item_reason: string@View,
    move step_name: string@View,
    move step_detail: string@View,
    move expected: string@View,
    move actual_pass: string@View,
    move actual_fail: string@View,
    move passed: bool,
    move failure_reason: string@View
) -> i32 {
    let detail_begin: string@View = "operation feature item exercise start"
    [[log(label: "operations-log-item_begin")]]
    let passed_place: bool = passed
    let item_check_log: bool = [[log(label: "observed-item-check-pass", expected: true)]] passed_place
    let item_check_ok: bool = passed_place && (item_check_log == true)
    if (item_check_ok == false) {
        [[log(label: "operations-log-transition")]]
        [[log(label: "operations-log-item_fail")]]
        return 1
    }

    [[log(label: "operations-log-operations_item_success")]]
    return 0
}

procedure VerifyDispatchExpressionOperationsItem(ctx: Context, scope: string@View, move item_index: i32, move item_name: string@View) -> i32 {
    [[log(label: "operations-log-runtime_phase_move")]]
    LogDispatchExpressionObject(ctx.fs, scope, "dispatch_reduce_basic", "i32", "constructed", "dispatch reduce metric container prepared")
    LogDispatchExpressionObject(ctx.fs, scope, "dispatch_reduce_chunk", "i32", "constructed", "dispatch reduce+chunk metric container prepared")
    LogDispatchExpressionObject(ctx.fs, scope, "dispatch_ordered_reduce", "i32", "constructed", "dispatch ordered+reduce metric container prepared")
    LogDispatchExpressionObject(ctx.fs, scope, "dispatch_key_read_reduce", "i32", "constructed", "dispatch key-clause read reduction metric container prepared")
    LogDispatchExpressionObject(ctx.fs, scope, "dispatch_key_write", "i32", "constructed", "dispatch key-clause write metric container prepared")
    LogDispatchExpressionObject(ctx.fs, scope, "dispatch_reduce_operator_matrix", "i32", "constructed", "dispatch non-plus reduction operator matrix container prepared")
    LogDispatchExpressionObject(ctx.fs, scope, "dispatch_custom_reduce", "i32", "constructed", "dispatch custom identifier reduce metric container prepared")

    [[log(label: "operations-log-runtime_phase_move")]]
    [[log(label: "operations-log-transition_move")]]
    let dispatch_reduce_metric: i32 = parallel ctx~>cpu() { dispatch _ in 0usize..4usize [reduce: +] { 1 } }
    [[log(label: "operations-log-transition_move")]]
    [[log(label: "operations-log-transition_move")]]
    let dispatch_chunk_metric: i32 = parallel ctx~>cpu() { dispatch _ in 0usize..3usize [reduce: +, chunk: 1usize] { 2 } }
    [[log(label: "operations-log-transition_move")]]
    [[log(label: "operations-log-transition_move")]]
    let dispatch_ordered_metric: i32 = parallel ctx~>cpu() { dispatch _ in 0usize..1usize [ordered, reduce: +] { 3 } }
    [[log(label: "operations-log-transition_move")]]
    [[log(label: "operations-log-transition_move")]]
    let dispatch_key_read_metric: i32 = parallel ctx~>cpu() {
        let key_gate: i32 = 0
        dispatch i in 0usize..4usize key key_gate read [reduce: +] { (i as i32) + 2 }
    }
    [[log(label: "operations-log-transition_move")]]
    [[log(label: "operations-log-transition_move")]]
    let dispatch_key_write_metric: i32 = parallel ctx~>cpu() {
        var write_gate: i32 = 0
        dispatch _ in 0usize..4usize key write_gate write { write_gate = write_gate + 1; }
        write_gate
    }
    [[log(label: "operations-log-transition_move")]]
    [[log(label: "operations-log-transition_move")]]
    let dispatch_mul_metric: i32 = parallel ctx~>cpu() { dispatch _ in 1usize..4usize [reduce: *] { 2 } }
    let dispatch_min_metric: i32 = parallel ctx~>cpu() { dispatch _ in 0usize..4usize [reduce: min] { 6 } }
    let dispatch_max_metric: i32 = parallel ctx~>cpu() { dispatch _ in 0usize..4usize [reduce: max] { 4 } }
    let dispatch_and_bool: bool = parallel ctx~>cpu() { dispatch _ in 0usize..3usize [reduce: and] { true } }
    let dispatch_or_bool: bool = parallel ctx~>cpu() { dispatch _ in 0usize..3usize [reduce: or] { true } }
    let dispatch_and_metric: i32 = if (dispatch_and_bool) { 1 } else { 0 }
    let dispatch_or_metric: i32 = if (dispatch_or_bool) { 1 } else { 0 }
    let dispatch_reduce_matrix_metric: i32 = dispatch_mul_metric + dispatch_min_metric + dispatch_max_metric + dispatch_and_metric + dispatch_or_metric
    [[log(label: "operations-log-transition_move")]]
    [[log(label: "operations-log-transition_move")]]
    let dispatch_custom_reduce_metric: i32 = parallel ctx~>cpu() { dispatch _ in 0usize..4usize [ordered, reduce: DispatchCustomReduce] { 1 } }
    [[log(label: "operations-log-transition_move")]]
    let dispatch_static_matrix_metric: i32 = dispatch_key_read_metric + dispatch_key_write_metric + dispatch_reduce_matrix_metric + dispatch_custom_reduce_metric
    let dispatch_runtime_metric: i32 = dispatch_reduce_metric + dispatch_chunk_metric + dispatch_ordered_metric + dispatch_static_matrix_metric

    let observed_reduce_step: string@View = "observed-dispatch-reduce-metric"
    let observed_chunk_step: string@View = "observed-dispatch-reduce-chunk-metric"
    let observed_ordered_step: string@View = "observed-dispatch-ordered-metric"
    let observed_key_read_step: string@View = "observed-dispatch-key-read-reduce-metric"
    let observed_key_write_step: string@View = "observed-dispatch-key-write-metric"
    let observed_mul_step: string@View = "observed-dispatch-reduce-mul-metric"
    let observed_min_step: string@View = "observed-dispatch-reduce-min-metric"
    let observed_max_step: string@View = "observed-dispatch-reduce-max-metric"
    let observed_and_step: string@View = "observed-dispatch-reduce-and-metric"
    let observed_or_step: string@View = "observed-dispatch-reduce-or-metric"
    let observed_reduce_matrix_step: string@View = "observed-dispatch-reduce-operator-matrix-metric"
    let observed_custom_reduce_step: string@View = "observed-dispatch-custom-reduce-metric"
    let observed_static_matrix_step: string@View = "observed-dispatch-static-matrix-metric"
    let observed_runtime_step: string@View = "observed-dispatch-runtime-aggregate-metric"
    let expected_reduce: string@View = "4"
    let expected_chunk: string@View = "6"
    let expected_ordered: string@View = "3"
    let expected_key_read: string@View = "14"
    let expected_key_write: string@View = "4"
    let expected_mul: string@View = "8"
    let expected_min: string@View = "6"
    let expected_max: string@View = "4"
    let expected_and: string@View = "1"
    let expected_or: string@View = "1"
    let expected_reduce_matrix: string@View = "20"
    let expected_custom_reduce: string@View = "4"
    let expected_static_matrix: string@View = "42"
    let expected_runtime: string@View = "55"
    let reduce_label: string@View = DispatchExpressionMetricLabel(dispatch_reduce_metric)
    let chunk_label: string@View = DispatchExpressionMetricLabel(dispatch_chunk_metric)
    let ordered_label: string@View = DispatchExpressionMetricLabel(dispatch_ordered_metric)
    let key_read_label: string@View = DispatchExpressionMetricLabel(dispatch_key_read_metric)
    let key_write_label: string@View = DispatchExpressionMetricLabel(dispatch_key_write_metric)
    let mul_label: string@View = DispatchExpressionMetricLabel(dispatch_mul_metric)
    let min_label: string@View = DispatchExpressionMetricLabel(dispatch_min_metric)
    let max_label: string@View = DispatchExpressionMetricLabel(dispatch_max_metric)
    let and_label: string@View = DispatchExpressionMetricLabel(dispatch_and_metric)
    let or_label: string@View = DispatchExpressionMetricLabel(dispatch_or_metric)
    let reduce_matrix_label: string@View = DispatchExpressionMetricLabel(dispatch_reduce_matrix_metric)
    let custom_reduce_label: string@View = DispatchExpressionMetricLabel(dispatch_custom_reduce_metric)
    let static_matrix_label: string@View = DispatchExpressionMetricLabel(dispatch_static_matrix_metric)
    let runtime_label: string@View = DispatchExpressionMetricLabel(dispatch_runtime_metric)
    let reduce_passed: bool = dispatch_reduce_metric == 4
    let chunk_passed: bool = dispatch_chunk_metric == 6
    let ordered_passed: bool = dispatch_ordered_metric == 3
    let key_read_passed: bool = dispatch_key_read_metric == 14
    let key_write_passed: bool = dispatch_key_write_metric == 4
    let mul_passed: bool = dispatch_mul_metric == 8
    let min_passed: bool = dispatch_min_metric == 6
    let max_passed: bool = dispatch_max_metric == 4
    let and_passed: bool = dispatch_and_metric == 1
    let or_passed: bool = dispatch_or_metric == 1
    let reduce_matrix_passed: bool = dispatch_reduce_matrix_metric == 20
    let custom_reduce_passed: bool = dispatch_custom_reduce_metric == 4
    let static_matrix_passed: bool = dispatch_static_matrix_metric == 42
    let runtime_passed: bool = dispatch_runtime_metric == 55

    let reduce_passed_log_actual = [[log(label: "observed-dispatch-reduce-metric", expected: "4")]] reduce_label
    let reduce_passed_with_log: bool = reduce_passed && (reduce_passed_log_actual == reduce_label)
    let chunk_passed_log_actual = [[log(label: "observed-dispatch-reduce-chunk-metric", expected: "6")]] chunk_label
    let chunk_passed_with_log: bool = chunk_passed && (chunk_passed_log_actual == chunk_label)
    let ordered_passed_log_actual = [[log(label: "observed-dispatch-ordered-metric", expected: "3")]] ordered_label
    let ordered_passed_with_log: bool = ordered_passed && (ordered_passed_log_actual == ordered_label)
    let key_read_passed_log_actual = [[log(label: "observed-dispatch-key-read-reduce-metric", expected: "14")]] key_read_label
    let key_read_passed_with_log: bool = key_read_passed && (key_read_passed_log_actual == key_read_label)
    let key_write_passed_log_actual = [[log(label: "observed-dispatch-key-write-metric", expected: "4")]] key_write_label
    let key_write_passed_with_log: bool = key_write_passed && (key_write_passed_log_actual == key_write_label)
    let mul_passed_log_actual = [[log(label: "observed-dispatch-reduce-mul-metric", expected: "8")]] mul_label
    let mul_passed_with_log: bool = mul_passed && (mul_passed_log_actual == mul_label)
    let min_passed_log_actual = [[log(label: "observed-dispatch-reduce-min-metric", expected: "6")]] min_label
    let min_passed_with_log: bool = min_passed && (min_passed_log_actual == min_label)
    let max_passed_log_actual = [[log(label: "observed-dispatch-reduce-max-metric", expected: "4")]] max_label
    let max_passed_with_log: bool = max_passed && (max_passed_log_actual == max_label)
    let and_passed_log_actual = [[log(label: "observed-dispatch-reduce-and-metric", expected: "1")]] and_label
    let and_passed_with_log: bool = and_passed && (and_passed_log_actual == and_label)
    let or_passed_log_actual = [[log(label: "observed-dispatch-reduce-or-metric", expected: "1")]] or_label
    let or_passed_with_log: bool = or_passed && (or_passed_log_actual == or_label)
    let reduce_matrix_passed_log_actual = [[log(label: "observed-dispatch-reduce-operator-matrix-metric", expected: "20")]] reduce_matrix_label
    let reduce_matrix_passed_with_log: bool = reduce_matrix_passed && (reduce_matrix_passed_log_actual == reduce_matrix_label)
    let custom_reduce_passed_log_actual = [[log(label: "observed-dispatch-custom-reduce-metric", expected: "4")]] custom_reduce_label
    let custom_reduce_passed_with_log: bool = custom_reduce_passed && (custom_reduce_passed_log_actual == custom_reduce_label)
    let static_matrix_passed_log_actual = [[log(label: "observed-dispatch-static-matrix-metric", expected: "42")]] static_matrix_label
    let static_matrix_passed_with_log: bool = static_matrix_passed && (static_matrix_passed_log_actual == static_matrix_label)
    let runtime_passed_log_actual = [[log(label: "observed-dispatch-runtime-aggregate-metric", expected: "55")]] runtime_label
    let runtime_passed_with_log: bool = runtime_passed && (runtime_passed_log_actual == runtime_label)
    [[log(label: "operations-log-runtime_phase_move")]]
    if (item_index == 0) {
        return RunDispatchExpressionOperationsItem(
            ctx,
            scope,
            "DispatchExpressionOperationsSyntaxForms",
            "dispatch keyword form with pattern, range, key clause, and option list parsing",
            "validated dispatch expression syntax forms",
            "dispatch-syntax",
            "evaluate dispatch parse surface for key clause and reduce option forms",
            "14",
            "14",
            "not-14",
            move key_read_passed_with_log,
            "dispatch syntax forms check failed"
        )
    }

    if (item_index == 1) {
        return RunDispatchExpressionOperationsItem(
            ctx,
            scope,
            "DispatchExpressionOperationsStaticSemantics",
            "dispatch key-path typing plus reduction-operator typing across operator matrix and custom reduce",
            "validated dispatch expression static semantics",
            "dispatch-static",
            "type-check key clause dispatch, non-plus reducers, and custom reduce compatibility",
            "42",
            "42",
            "not-42",
            move static_matrix_passed_with_log,
            "dispatch static semantics check failed"
        )
    }

    if (item_index == 2) {
        return RunDispatchExpressionOperationsItem(
            ctx,
            scope,
            "DispatchExpressionOperationsRuntimeDiagnostics",
            "dispatch runtime iteration scheduling, key-partition execution paths, and reduction behavior",
            "validated dispatch expression runtime behavior and diagnostics",
            "dispatch-runtime",
            "execute dispatch runtime schedule and verify aggregate contract",
            "55",
            "55",
            "not-55",
            move runtime_passed_with_log,
            "dispatch runtime diagnostics check failed"
        )
    }

    return RunDispatchExpressionOperationsItem(
        ctx,
        scope,
        move item_name,
        "unknown dispatch expression operation item",
        "failed unknown dispatch expression operation item",
        "item-resolution",
        "resolve dispatch expression operation item name",
        "known-item",
        "known-item",
        "unknown-item",
        false,
        "unknown dispatch expression operation item"
    )
}

procedure RunDispatchExpressionOperations(ctx: Context) -> i32 {
    let scope: string@View = "operations::StructuredParallel::DispatchExpressionOperations"
    let checkpoint: string@View = "covered dispatch expression operations operation items"

    let status_syntax: i32 = VerifyDispatchExpressionOperationsItem(ctx, scope, 0, "DispatchExpressionOperationsSyntaxForms")
    if (status_syntax != 0) {
        return status_syntax
    }

    let status_static: i32 = VerifyDispatchExpressionOperationsItem(ctx, scope, 1, "DispatchExpressionOperationsStaticSemantics")
    if (status_static != 0) {
        return status_static
    }

    let status_runtime: i32 = VerifyDispatchExpressionOperationsItem(ctx, scope, 2, "DispatchExpressionOperationsRuntimeDiagnostics")
    if (status_runtime != 0) {
        return status_runtime
    }

    [[log(label: "operations-log-checkpoint")]]
    return 0
}
