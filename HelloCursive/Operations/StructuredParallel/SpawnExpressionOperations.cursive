procedure SpawnAdd(left: i32, right: i32) -> i32 {
    return left + right
}

procedure LogSpawnExpressionObject(
    fs: $FileSystem,
    scope: string@View,
    move object_name: string@View,
    move object_type: string@View,
    move state: string@View,
    move details: string@View
) -> () {
    [[log(label: "operations-log-object")]]
}

procedure SpawnExpressionMetricLabel(value: i32) -> string@View {
    if (value == 5) {
        return "5"
    }
    if (value == 9) {
        return "9"
    }
    if (value == 11) {
        return "11"
    }
    if (value == 16) {
        return "16"
    }
    if (value == 25) {
        return "25"
    }
    return "other"
}

procedure RunSpawnExpressionOperationsItem(
    ctx: Context,
    scope: string@View,
    move item_name: string@View,
    move item_details: string@View,
    move item_reason: string@View,
    move step_name: string@View,
    move step_detail: string@View,
    move expected: string@View,
    move actual_pass: string@View,
    move actual_fail: string@View,
    move passed: bool,
    move failure_reason: string@View
) -> i32 {
    let detail_begin: string@View = "operation feature item exercise start"
    [[log(label: "operations-log-item_begin")]]
    let passed_place: bool = passed
    let item_check_log: bool = [[log(label: "observed-item-check-pass", expected: true)]] passed_place
    let item_check_ok: bool = passed_place && (item_check_log == true)
    if (item_check_ok == false) {
        [[log(label: "operations-log-transition")]]
        [[log(label: "operations-log-item_fail")]]
        return 1
    }

    [[log(label: "operations-log-operations_item_success")]]
    return 0
}

procedure VerifySpawnExpressionOperationsItem(ctx: Context, scope: string@View, move item_index: i32, move item_name: string@View) -> i32 {
    [[log(label: "operations-log-runtime_phase_move")]]
    LogSpawnExpressionObject(ctx.fs, scope, "parallel_domain", "$ExecutionDomain", "constructed", "parallel execution domain handle prepared from context")
    LogSpawnExpressionObject(ctx.fs, scope, "named_spawn_literal", "i32", "constructed", "spawn body literal for named spawn prepared")
    LogSpawnExpressionObject(ctx.fs, scope, "pair_spawn_literals", "i32,i32", "constructed", "spawn body literals for pair wait exercise prepared")
    LogSpawnExpressionObject(ctx.fs, scope, "optioned_spawn_literal", "i32", "constructed", "spawn body literal for affinity/priority option exercise prepared")

    [[log(label: "operations-log-runtime_phase_move")]]
    [[log(label: "operations-log-transition_move")]]
    let spawn_named_metric: i32 = parallel ctx~>cpu() { let named_handle = spawn [name: "spawn-named"] { SpawnAdd(2, 3) }; let named_value: i32 = wait named_handle; named_value }
    [[log(label: "operations-log-transition_move")]]
    [[log(label: "operations-log-transition_move")]]
    let spawn_pair_metric: i32 = parallel ctx~>cpu() { let left_handle = spawn { 4 }; let right_handle = spawn { 7 }; let left_value: i32 = wait left_handle; let right_value: i32 = wait right_handle; left_value + right_value }
    [[log(label: "operations-log-transition_move")]]
    [[log(label: "operations-log-transition_move")]]
    let spawn_affinity_priority_metric: i32 = parallel ctx~>cpu() {
        let affinity_mask: CpuSet = 3u64
        let task_priority: Priority = Priority::High
        let optioned_handle = spawn [name: "spawn-optioned", affinity: affinity_mask, priority: task_priority] { 9 }
        let optioned_value: i32 = wait optioned_handle
        optioned_value
    }
    [[log(label: "operations-log-transition_move")]]
    let spawn_runtime_metric: i32 = spawn_named_metric + spawn_pair_metric + spawn_affinity_priority_metric

    let observed_named_step: string@View = "observed-spawn-named-handle-metric"
    let observed_pair_step: string@View = "observed-spawn-pair-wait-metric"
    let observed_options_step: string@View = "observed-spawn-affinity-priority-metric"
    let observed_runtime_step: string@View = "observed-spawn-runtime-aggregate-metric"
    let expected_named: string@View = "5"
    let expected_pair: string@View = "11"
    let expected_options: string@View = "9"
    let expected_runtime: string@View = "25"
    let named_label: string@View = SpawnExpressionMetricLabel(spawn_named_metric)
    let pair_label: string@View = SpawnExpressionMetricLabel(spawn_pair_metric)
    let options_label: string@View = SpawnExpressionMetricLabel(spawn_affinity_priority_metric)
    let runtime_label: string@View = SpawnExpressionMetricLabel(spawn_runtime_metric)
    let named_passed: bool = spawn_named_metric == 5
    let pair_passed: bool = spawn_pair_metric == 11
    let options_passed: bool = spawn_affinity_priority_metric == 9
    let runtime_passed: bool = spawn_runtime_metric == 25

    let named_passed_log_actual = [[log(label: "observed-spawn-named-handle-metric", expected: "5")]] named_label
    let named_passed_with_log: bool = named_passed && (named_passed_log_actual == named_label)
    let pair_passed_log_actual = [[log(label: "observed-spawn-pair-wait-metric", expected: "11")]] pair_label
    let pair_passed_with_log: bool = pair_passed && (pair_passed_log_actual == pair_label)
    let options_passed_log_actual = [[log(label: "observed-spawn-affinity-priority-metric", expected: "9")]] options_label
    let options_passed_with_log: bool = options_passed && (options_passed_log_actual == options_label)
    let runtime_passed_log_actual = [[log(label: "observed-spawn-runtime-aggregate-metric", expected: "25")]] runtime_label
    let runtime_passed_with_log: bool = runtime_passed && (runtime_passed_log_actual == runtime_label)
    [[log(label: "operations-log-runtime_phase_move")]]
    if (item_index == 0) {
        return RunSpawnExpressionOperationsItem(
            ctx,
            scope,
            "SpawnExpressionOperationsSyntaxForms",
            "spawn expression keyword form with spawn options and block body parsing",
            "validated spawn expression syntax forms",
            "spawn-syntax",
            "evaluate optioned spawn expression parse and wait consumption shape",
            "5",
            "5",
            "not-5",
            move named_passed_with_log,
            "spawn syntax forms check failed"
        )
    }

    if (item_index == 1) {
        return RunSpawnExpressionOperationsItem(
            ctx,
            scope,
            "SpawnExpressionOperationsStaticSemantics",
            "spawn handle typing and wait result typing across multiple work items",
            "validated spawn expression static semantics",
            "spawn-static",
            "type-check affinity and priority option expressions with spawn handle typing",
            "9",
            "9",
            "not-9",
            move options_passed_with_log,
            "spawn static semantics check failed"
        )
    }

    if (item_index == 2) {
        return RunSpawnExpressionOperationsItem(
            ctx,
            scope,
            "SpawnExpressionOperationsRuntimeDiagnostics",
            "spawn runtime scheduling, join behavior, and deterministic aggregation",
            "validated spawn expression runtime behavior and diagnostics",
            "spawn-runtime",
            "execute spawn scheduling and wait joins through full runtime path",
            "25",
            "25",
            "not-25",
            move runtime_passed_with_log,
            "spawn runtime diagnostics check failed"
        )
    }

    return RunSpawnExpressionOperationsItem(
        ctx,
        scope,
        move item_name,
        "unknown spawn expression operation item",
        "failed unknown spawn expression operation item",
        "item-resolution",
        "resolve spawn expression operation item name",
        "known-item",
        "known-item",
        "unknown-item",
        false,
        "unknown spawn expression operation item"
    )
}

procedure RunSpawnExpressionOperations(ctx: Context) -> i32 {
    let scope: string@View = "operations::StructuredParallel::SpawnExpressionOperations"
    let checkpoint: string@View = "covered spawn expression operations operation items"

    let status_syntax: i32 = VerifySpawnExpressionOperationsItem(ctx, scope, 0, "SpawnExpressionOperationsSyntaxForms")
    if (status_syntax != 0) {
        return status_syntax
    }

    let status_static: i32 = VerifySpawnExpressionOperationsItem(ctx, scope, 1, "SpawnExpressionOperationsStaticSemantics")
    if (status_static != 0) {
        return status_static
    }

    let status_runtime: i32 = VerifySpawnExpressionOperationsItem(ctx, scope, 2, "SpawnExpressionOperationsRuntimeDiagnostics")
    if (status_runtime != 0) {
        return status_runtime
    }

    [[log(label: "operations-log-checkpoint")]]
    return 0
}
