procedure ParallelSumTuple(values: (i32, i32)) -> i32 {
    return values.0 + values.1
}

procedure LogParallelExpressionObject(
    fs: $FileSystem,
    scope: string@View,
    move object_name: string@View,
    move object_type: string@View,
    move state: string@View,
    move details: string@View
) -> () {
    }

procedure ParallelExpressionMetricLabel(value: i32) -> string@View {
    if (value == -1) {
        return "-1"
    }
    if (value == 0) {
        return "0"
    }
    if (value == 1) {
        return "1"
    }
    if (value == 2) {
        return "2"
    }
    if (value == 3) {
        return "3"
    }
    if (value == 4) {
        return "4"
    }
    if (value == 5) {
        return "5"
    }
    if (value == 6) {
        return "6"
    }
    if (value == 7) {
        return "7"
    }
    if (value == 8) {
        return "8"
    }
    if (value == 9) {
        return "9"
    }
    if (value == 10) {
        return "10"
    }
    if (value == 11) {
        return "11"
    }
    if (value == 12) {
        return "12"
    }
    if (value == 13) {
        return "13"
    }
    if (value == 14) {
        return "14"
    }
    if (value == 15) {
        return "15"
    }
    if (value == 16) {
        return "16"
    }
    if (value == 17) {
        return "17"
    }
    if (value == 18) {
        return "18"
    }
    if (value == 19) {
        return "19"
    }
    if (value == 20) {
        return "20"
    }
    return "other"
}

procedure RunParallelExpressionOperationsItem(
    ctx: Context,
    scope: string@View,
    move item_name: string@View,
    move item_details: string@View,
    move item_reason: string@View,
    move step_name: string@View,
    move step_detail: string@View,
    move expected: string@View,
    move actual_pass: string@View,
    move actual_fail: string@View,
    move passed: bool,
    move failure_reason: string@View
) -> i32 {
    let detail_begin: string@View = "operation feature item exercise start"
    let passed_place: bool = passed
    let item_check_log: bool = passed_place
    let item_check_ok: bool = passed_place && (item_check_log == true)
    if (item_check_ok == false) {
        return 1
    }

    return 0
}

procedure VerifyParallelExpressionOperationsItem(ctx: Context, scope: string@View, move item_index: i32, move item_name: string@View) -> i32 {
    LogParallelExpressionObject(ctx.fs, scope, "parallel_domain", "$ExecutionDomain", "constructed", "parallel expression domain prepared from context")
    LogParallelExpressionObject(ctx.fs, scope, "parallel_single_spawn", "i32", "constructed", "single-spawn parallel completion value prepared")
    LogParallelExpressionObject(ctx.fs, scope, "parallel_multi_spawn", "(i32,i32)", "constructed", "multi-spawn parallel tuple result carrier prepared")
    LogParallelExpressionObject(ctx.fs, scope, "parallel_named_block", "i32", "constructed", "named parallel block result carrier prepared")
    LogParallelExpressionObject(ctx.fs, scope, "parallel_cancel_block", "i32", "constructed", "cancel-enabled parallel block result carrier prepared")

    let parallel_single_metric: i32 = parallel ctx~>cpu() { spawn { 4 } }
    let parallel_tuple_metric: (i32, i32) = parallel ctx~>cpu() { spawn { 2 }; spawn { 5 } }
    let parallel_tuple_sum: i32 = ParallelSumTuple(parallel_tuple_metric)
    let parallel_named_metric: i32 = parallel ctx~>cpu() [name: "parallel-named"] { spawn { 6 } }
    let cancel_token_owner: unique (CancelToken@Active;) = (CancelToken::new();)
    let cancel_token: shared CancelToken@Active = move cancel_token_owner.0
    let cancel_option_token: CancelToken = widen(cancel_token)
    let parallel_cancel_metric: i32 = parallel ctx~>cpu() [cancel: cancel_option_token, name: "parallel-cancel"] {
        let token_before: bool = cancel_token~>is_cancelled()
        cancel_token~>cancel()
        let token_after: bool = cancel_token~>is_cancelled()
        if ((token_before == false) && (token_after == true)) {
            1
        } else {
            0
        }
    }
    let parallel_runtime_metric: i32 = parallel_single_metric + parallel_tuple_sum + parallel_named_metric + parallel_cancel_metric

    let observed_single_step: string@View = "observed-parallel-single-spawn-metric"
    let observed_multi_step: string@View = "observed-parallel-multi-spawn-metric"
    let observed_named_step: string@View = "observed-parallel-named-option-metric"
    let observed_cancel_step: string@View = "observed-parallel-cancel-option-metric"
    let observed_runtime_step: string@View = "observed-parallel-runtime-aggregate-metric"
    let expected_single: string@View = "4"
    let expected_multi: string@View = "7"
    let expected_named: string@View = "6"
    let expected_cancel: string@View = "1"
    let expected_runtime: string@View = "18"
    let single_label: string@View = ParallelExpressionMetricLabel(parallel_single_metric)
    let multi_label: string@View = ParallelExpressionMetricLabel(parallel_tuple_sum)
    let named_label: string@View = ParallelExpressionMetricLabel(parallel_named_metric)
    let cancel_label: string@View = ParallelExpressionMetricLabel(parallel_cancel_metric)
    let runtime_label: string@View = ParallelExpressionMetricLabel(parallel_runtime_metric)
    let single_passed: bool = parallel_single_metric == 4
    let multi_passed: bool = parallel_tuple_sum == 7
    let named_passed: bool = parallel_named_metric == 6
    let cancel_passed: bool = parallel_cancel_metric == 1
    let runtime_passed: bool = parallel_runtime_metric == 18

    let single_passed_log_actual = single_label
    let single_passed_with_log: bool = single_passed && (single_passed_log_actual == single_label)
    let multi_passed_log_actual = multi_label
    let multi_passed_with_log: bool = multi_passed && (multi_passed_log_actual == multi_label)
    let named_passed_log_actual = named_label
    let named_passed_with_log: bool = named_passed && (named_passed_log_actual == named_label)
    let cancel_passed_log_actual = cancel_label
    let cancel_passed_with_log: bool = cancel_passed && (cancel_passed_log_actual == cancel_label)
    let runtime_passed_log_actual = runtime_label
    let runtime_passed_with_log: bool = runtime_passed && (runtime_passed_log_actual == runtime_label)
    if (item_index == 0) {
        return RunParallelExpressionOperationsItem(
            ctx,
            scope,
            "ParallelExpressionOperationsSyntaxForms",
            "parallel keyword form, domain expression, and block-option parsing",
            "validated parallel expression syntax forms",
            "parallel-syntax",
            "evaluate parallel expression surface forms across single and named blocks",
            "4",
            "4",
            "not-4",
            move single_passed_with_log,
            "parallel syntax forms check failed"
        )
    }

    if (item_index == 1) {
        return RunParallelExpressionOperationsItem(
            ctx,
            scope,
            "ParallelExpressionOperationsStaticSemantics",
            "parallel completion typing for single and multi-spawn result forms",
            "validated parallel expression static semantics",
            "parallel-static",
            "type-check single result and tuple result completion paths",
            "7",
            "7",
            "not-7",
            move multi_passed_with_log,
            "parallel static semantics check failed"
        )
    }

    if (item_index == 2) {
        return RunParallelExpressionOperationsItem(
            ctx,
            scope,
            "ParallelExpressionOperationsRuntimeDiagnostics",
            "parallel fork-join completion, option handling, and aggregate runtime behavior",
            "validated parallel expression runtime behavior and diagnostics",
            "parallel-runtime",
            "execute full parallel runtime path including named option behavior",
            "18",
            "18",
            "not-18",
            move runtime_passed_with_log,
            "parallel runtime diagnostics check failed"
        )
    }

    return RunParallelExpressionOperationsItem(
        ctx,
        scope,
        move item_name,
        "unknown parallel expression operation item",
        "failed unknown parallel expression operation item",
        "item-resolution",
        "resolve parallel expression operation item name",
        "known-item",
        "known-item",
        "unknown-item",
        false,
        "unknown parallel expression operation item"
    )
}

procedure RunParallelExpressionOperations(ctx: Context) -> i32 {
    let scope: string@View = "operations::StructuredParallel::ParallelExpressionOperations"
    let checkpoint: string@View = "covered parallel expression operations operation items"

    let status_syntax: i32 = VerifyParallelExpressionOperationsItem(ctx, scope, 0, "ParallelExpressionOperationsSyntaxForms")
    if (status_syntax != 0) {
        return status_syntax
    }

    let status_static: i32 = VerifyParallelExpressionOperationsItem(ctx, scope, 1, "ParallelExpressionOperationsStaticSemantics")
    if (status_static != 0) {
        return status_static
    }

    let status_runtime: i32 = VerifyParallelExpressionOperationsItem(ctx, scope, 2, "ParallelExpressionOperationsRuntimeDiagnostics")
    if (status_runtime != 0) {
        return status_runtime
    }

    return 0
}
