procedure UntilPredicateEqualsThree(value: const i32) -> bool {
    return value == 3
}

procedure UntilActionAddFour(value: unique i32) -> i32 {
    return value + 4
}

procedure UntilPredicatePositive(value: const i32) -> bool {
    return value > 0
}

procedure UntilActionDouble(value: unique i32) -> i32 {
    return value * 2
}

procedure LogUntilExpressionObject(
    fs: $FileSystem,
    scope: string@View,
    move object_name: string@View,
    move object_type: string@View,
    move state: string@View,
    move details: string@View
) -> () {
    [[log(label: "operations-log-object")]]
}

procedure UntilExpressionMetricLabel(value: i32) -> string@View {
    if (value == 7) {
        return "7"
    }
    if (value == 8) {
        return "8"
    }
    if (value == 15) {
        return "15"
    }
    return "other"
}

procedure RunUntilExpressionOperationsItem(
    ctx: Context,
    scope: string@View,
    move item_name: string@View,
    move item_details: string@View,
    move item_reason: string@View,
    move step_name: string@View,
    move step_detail: string@View,
    move expected: string@View,
    move actual_pass: string@View,
    move actual_fail: string@View,
    move passed: bool,
    move failure_reason: string@View
) -> i32 {
    let detail_begin: string@View = "operation feature item exercise start"
    [[log(label: "operations-log-item_begin")]]
    let passed_place: bool = passed
    let item_check_log: bool = [[log(label: "observed-item-check-pass", expected: true)]] passed_place
    let item_check_ok: bool = passed_place && (item_check_log == true)
    if (item_check_ok == false) {
        [[log(label: "operations-log-transition")]]
        [[log(label: "operations-log-item_fail")]]
        return 1
    }

    [[log(label: "operations-log-operations_item_success")]]
    return 0
}

procedure VerifyUntilExpressionOperationsItem(ctx: Context, scope: string@View, move item_index: i32, move item_name: string@View) -> i32 {
    [[log(label: "operations-log-runtime_phase_move")]]
    LogUntilExpressionObject(ctx.fs, scope, "until_shared_target_a", "shared i32", "constructed", "shared target for equals-three predicate prepared")
    LogUntilExpressionObject(ctx.fs, scope, "until_shared_target_b", "shared i32", "constructed", "shared target for positive predicate prepared")

    [[log(label: "operations-log-runtime_phase_move")]]
    [[log(label: "operations-log-transition_move")]]
    let until_seed_a: unique i32 = 3
    let until_shared_a: shared i32 = until_seed_a
    let until_future_a: Async<(), (), i32, !> = until_shared_a~>until(UntilPredicateEqualsThree, UntilActionAddFour)
    let until_metric_a: i32 = sync until_future_a
    [[log(label: "operations-log-transition_move")]]
    [[log(label: "operations-log-transition_move")]]
    let until_seed_b: unique i32 = 4
    let until_shared_b: shared i32 = until_seed_b
    let until_future_b: Async<(), (), i32, !> = until_shared_b~>until(UntilPredicatePositive, UntilActionDouble)
    let until_metric_b: i32 = sync until_future_b
    [[log(label: "operations-log-transition_move")]]
    let until_runtime_metric: i32 = until_metric_a + until_metric_b

    let observed_until_a_step: string@View = "observed-until-predicate-action-a-metric"
    let observed_until_b_step: string@View = "observed-until-predicate-action-b-metric"
    let observed_runtime_step: string@View = "observed-until-runtime-aggregate-metric"
    let expected_until_a: string@View = "7"
    let expected_until_b: string@View = "8"
    let expected_runtime: string@View = "15"
    let until_a_label: string@View = UntilExpressionMetricLabel(until_metric_a)
    let until_b_label: string@View = UntilExpressionMetricLabel(until_metric_b)
    let runtime_label: string@View = UntilExpressionMetricLabel(until_runtime_metric)
    let until_a_passed: bool = until_metric_a == 7
    let until_b_passed: bool = until_metric_b == 8
    let runtime_passed: bool = until_runtime_metric == 15

    let until_a_passed_log_actual = [[log(label: "observed-until-predicate-action-a-metric", expected: "7")]] until_a_label
    let until_a_passed_with_log: bool = until_a_passed && (until_a_passed_log_actual == until_a_label)
    let until_b_passed_log_actual = [[log(label: "observed-until-predicate-action-b-metric", expected: "8")]] until_b_label
    let until_b_passed_with_log: bool = until_b_passed && (until_b_passed_log_actual == until_b_label)
    let runtime_passed_log_actual = [[log(label: "observed-until-runtime-aggregate-metric", expected: "15")]] runtime_label
    let runtime_passed_with_log: bool = runtime_passed && (runtime_passed_log_actual == runtime_label)
    [[log(label: "operations-log-runtime_phase_move")]]
    if (item_index == 0) {
        return RunUntilExpressionOperationsItem(
            ctx,
            scope,
            "UntilExpressionOperationsSyntaxForms",
            "method-call surface for shared_value~>until(pred, action)",
            "validated until expression syntax forms",
            "until-syntax",
            "evaluate until method-call shape and argument placement",
            "7",
            "7",
            "not-7",
            move until_a_passed_with_log,
            "until syntax forms check failed"
        )
    }

    if (item_index == 1) {
        return RunUntilExpressionOperationsItem(
            ctx,
            scope,
            "UntilExpressionOperationsStaticSemantics",
            "until predicate/action signature compatibility and Future result typing",
            "validated until expression static semantics",
            "until-static",
            "type-check until predicate(const T) and action(unique T)->R signatures",
            "8",
            "8",
            "not-8",
            move until_b_passed_with_log,
            "until static semantics check failed"
        )
    }

    if (item_index == 2) {
        return RunUntilExpressionOperationsItem(
            ctx,
            scope,
            "UntilExpressionOperationsRuntimeDiagnostics",
            "until runtime predicate evaluation, action execution, and future completion",
            "validated until expression runtime behavior and diagnostics",
            "until-runtime",
            "execute until runtime path and verify aggregate result",
            "15",
            "15",
            "not-15",
            move runtime_passed_with_log,
            "until runtime diagnostics check failed"
        )
    }

    return RunUntilExpressionOperationsItem(
        ctx,
        scope,
        move item_name,
        "unknown until expression operation item",
        "failed unknown until expression operation item",
        "item-resolution",
        "resolve until expression operation item name",
        "known-item",
        "known-item",
        "unknown-item",
        false,
        "unknown until expression operation item"
    )
}

procedure RunUntilExpressionOperations(ctx: Context) -> i32 {
    let scope: string@View = "operations::AsyncFlow::UntilExpressionOperations"
    let checkpoint: string@View = "covered until expression operations operation items"

    let status_syntax: i32 = VerifyUntilExpressionOperationsItem(ctx, scope, 0, "UntilExpressionOperationsSyntaxForms")
    if (status_syntax != 0) {
        return status_syntax
    }

    let status_static: i32 = VerifyUntilExpressionOperationsItem(ctx, scope, 1, "UntilExpressionOperationsStaticSemantics")
    if (status_static != 0) {
        return status_static
    }

    let status_runtime: i32 = VerifyUntilExpressionOperationsItem(ctx, scope, 2, "UntilExpressionOperationsRuntimeDiagnostics")
    if (status_runtime != 0) {
        return status_runtime
    }

    [[log(label: "operations-log-checkpoint")]]
    return 0
}
