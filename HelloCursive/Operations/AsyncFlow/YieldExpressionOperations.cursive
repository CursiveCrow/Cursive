procedure YieldUnitOnce() -> Async<(), (), i32, !> {
    let resume_value: () = yield ()
    return 5
}

procedure YieldUnitReleaseOnce() -> Async<(), (), i32, !> {
    let resume_value: () = yield release ()
    return 7
}

procedure YieldUnitTwice() -> Async<(), (), i32, !> {
    let first_resume: () = yield ()
    let second_resume: () = yield release ()
    return 9
}

procedure LogYieldExpressionObject(
    fs: $FileSystem,
    scope: string@View,
    move object_name: string@View,
    move object_type: string@View,
    move state: string@View,
    move details: string@View
) -> () {
    }

procedure YieldExpressionMetricLabel(value: i32) -> string@View {
    if (value == 5) {
        return "5"
    }
    if (value == 7) {
        return "7"
    }
    if (value == 9) {
        return "9"
    }
    if (value == 21) {
        return "21"
    }
    return "other"
}

procedure RunYieldExpressionOperationsItem(
    ctx: Context,
    scope: string@View,
    move item_name: string@View,
    move item_details: string@View,
    move item_reason: string@View,
    move step_name: string@View,
    move step_detail: string@View,
    move expected: string@View,
    move actual_pass: string@View,
    move actual_fail: string@View,
    move passed: bool,
    move failure_reason: string@View
) -> i32 {
    let detail_begin: string@View = "operation feature item exercise start"
    let passed_place: bool = passed
    let item_check_log: bool = passed_place
    let item_check_ok: bool = passed_place && (item_check_log == true)
    if (item_check_ok == false) {
        return 1
    }

    return 0
}

procedure VerifyYieldExpressionOperationsItem(ctx: Context, scope: string@View, move item_index: i32, move item_name: string@View) -> i32 {
    LogYieldExpressionObject(ctx.fs, scope, "yield_async_once", "Async<(),(),i32,!>", "constructed", "single-yield async source prepared")
    LogYieldExpressionObject(ctx.fs, scope, "yield_async_release", "Async<(),(),i32,!>", "constructed", "yield-release async source prepared")
    LogYieldExpressionObject(ctx.fs, scope, "yield_async_twice", "Async<(),(),i32,!>", "constructed", "multi-yield async source prepared")

    let yield_once_metric: i32 = sync YieldUnitOnce()
    let yield_release_metric: i32 = sync YieldUnitReleaseOnce()
    let yield_twice_metric: i32 = sync YieldUnitTwice()
    let yield_runtime_metric: i32 = yield_once_metric + yield_release_metric + yield_twice_metric

    let observed_once_step: string@View = "observed-yield-once-metric"
    let observed_release_step: string@View = "observed-yield-release-metric"
    let observed_twice_step: string@View = "observed-yield-twice-metric"
    let observed_runtime_step: string@View = "observed-yield-runtime-aggregate-metric"
    let expected_once: string@View = "5"
    let expected_release: string@View = "7"
    let expected_twice: string@View = "9"
    let expected_runtime: string@View = "21"
    let once_label: string@View = YieldExpressionMetricLabel(yield_once_metric)
    let release_label: string@View = YieldExpressionMetricLabel(yield_release_metric)
    let twice_label: string@View = YieldExpressionMetricLabel(yield_twice_metric)
    let runtime_label: string@View = YieldExpressionMetricLabel(yield_runtime_metric)
    let once_passed: bool = yield_once_metric == 5
    let release_passed: bool = yield_release_metric == 7
    let twice_passed: bool = yield_twice_metric == 9
    let runtime_passed: bool = yield_runtime_metric == 21

    let once_passed_log_actual = once_label
    let once_passed_with_log: bool = once_passed && (once_passed_log_actual == once_label)
    let release_passed_log_actual = release_label
    let release_passed_with_log: bool = release_passed && (release_passed_log_actual == release_label)
    let twice_passed_log_actual = twice_label
    let twice_passed_with_log: bool = twice_passed && (twice_passed_log_actual == twice_label)
    let runtime_passed_log_actual = runtime_label
    let runtime_passed_with_log: bool = runtime_passed && (runtime_passed_log_actual == runtime_label)
    if (item_index == 0) {
        return RunYieldExpressionOperationsItem(
            ctx,
            scope,
            "YieldExpressionOperationsSyntaxForms",
            "yield and yield release syntax forms within async procedure bodies",
            "validated yield expression syntax forms",
            "yield-syntax",
            "evaluate yield keyword form with optional release modifier",
            "5",
            "5",
            "not-5",
            move once_passed_with_log,
            "yield syntax forms check failed"
        )
    }

    if (item_index == 1) {
        return RunYieldExpressionOperationsItem(
            ctx,
            scope,
            "YieldExpressionOperationsStaticSemantics",
            "yield operand typing against async Out parameter and yield-result In typing",
            "validated yield expression static semantics",
            "yield-static",
            "type-check yield suspension points and resumed input typing",
            "7",
            "7",
            "not-7",
            move release_passed_with_log,
            "yield static semantics check failed"
        )
    }

    if (item_index == 2) {
        return RunYieldExpressionOperationsItem(
            ctx,
            scope,
            "YieldExpressionOperationsRuntimeDiagnostics",
            "yield runtime suspension, resume, and completion sequencing",
            "validated yield expression runtime behavior and diagnostics",
            "yield-runtime",
            "execute complete yield suspension/resume lifecycle",
            "21",
            "21",
            "not-21",
            move runtime_passed_with_log,
            "yield runtime diagnostics check failed"
        )
    }

    return RunYieldExpressionOperationsItem(
        ctx,
        scope,
        move item_name,
        "unknown yield expression operation item",
        "failed unknown yield expression operation item",
        "item-resolution",
        "resolve yield expression operation item name",
        "known-item",
        "known-item",
        "unknown-item",
        false,
        "unknown yield expression operation item"
    )
}

procedure RunYieldExpressionOperations(ctx: Context) -> i32 {
    let scope: string@View = "operations::AsyncFlow::YieldExpressionOperations"
    let checkpoint: string@View = "covered yield expression operations operation items"

    let status_syntax: i32 = VerifyYieldExpressionOperationsItem(ctx, scope, 0, "YieldExpressionOperationsSyntaxForms")
    if (status_syntax != 0) {
        return status_syntax
    }

    let status_static: i32 = VerifyYieldExpressionOperationsItem(ctx, scope, 1, "YieldExpressionOperationsStaticSemantics")
    if (status_static != 0) {
        return status_static
    }

    let status_runtime: i32 = VerifyYieldExpressionOperationsItem(ctx, scope, 2, "YieldExpressionOperationsRuntimeDiagnostics")
    if (status_runtime != 0) {
        return status_runtime
    }

    return 0
}
