procedure RaceFast() -> Async<(), (), i32, !> {
    return 6
}

procedure RaceFastWithOffset() -> Async<(), (), i32, !> {
    return 8
}

procedure RaceSlow() -> Async<(), (), i32, !> {
    let resume_value: () = yield ()
    return 10
}

procedure LogRaceExpressionObject(
    fs: $FileSystem,
    scope: string@View,
    move object_name: string@View,
    move object_type: string@View,
    move state: string@View,
    move details: string@View
) -> () {
    }

procedure RaceExpressionMetricLabel(value: i32) -> string@View {
    if (value == 6) {
        return "6"
    }
    if (value == 10) {
        return "10"
    }
    if (value == 16) {
        return "16"
    }
    return "other"
}

procedure RunRaceExpressionOperationsItem(
    ctx: Context,
    scope: string@View,
    move item_name: string@View,
    move item_details: string@View,
    move item_reason: string@View,
    move step_name: string@View,
    move step_detail: string@View,
    move expected: string@View,
    move actual_pass: string@View,
    move actual_fail: string@View,
    move passed: bool,
    move failure_reason: string@View
) -> i32 {
    let detail_begin: string@View = "operation feature item exercise start"
    let passed_place: bool = passed
    let item_check_log: bool = passed_place
    let item_check_ok: bool = passed_place && (item_check_log == true)
    if (item_check_ok == false) {
        return 1
    }

    return 0
}

procedure VerifyRaceExpressionOperationsItem(ctx: Context, scope: string@View, move item_index: i32, move item_name: string@View) -> i32 {
    LogRaceExpressionObject(ctx.fs, scope, "race_fast_arm", "Async<(),(),i32,!>", "constructed", "fast-completing race arm prepared")
    LogRaceExpressionObject(ctx.fs, scope, "race_slow_arm", "Async<(),(),i32,!>", "constructed", "suspending race arm prepared")
    LogRaceExpressionObject(ctx.fs, scope, "race_handler_arm", "Async<(),(),i32,!>", "constructed", "race arm for handler transform prepared")

    let race_fast_result: i32 | ! = race {
        RaceFast() -> |value| {
            value
        },
        RaceSlow() -> |value| {
            value
        }
    }
    let race_fast_metric: i32 = if race_fast_result is {
        value: i32 { value }
        _: ! { 0 }
    }
    let race_handler_result: i32 | ! = race {
        RaceSlow() -> |value| {
            value
        },
        RaceFastWithOffset() -> |value| {
            value + 2
        }
    }
    let race_handler_metric: i32 = if race_handler_result is {
        value: i32 { value }
        _: ! { 0 }
    }
    let race_runtime_metric: i32 = race_fast_metric + race_handler_metric

    let observed_fast_step: string@View = "observed-race-first-completion-metric"
    let observed_handler_step: string@View = "observed-race-handler-transform-metric"
    let observed_runtime_step: string@View = "observed-race-runtime-aggregate-metric"
    let expected_fast: string@View = "6"
    let expected_handler: string@View = "10"
    let expected_runtime: string@View = "16"
    let fast_label: string@View = RaceExpressionMetricLabel(race_fast_metric)
    let handler_label: string@View = RaceExpressionMetricLabel(race_handler_metric)
    let runtime_label: string@View = RaceExpressionMetricLabel(race_runtime_metric)
    let fast_passed: bool = race_fast_metric == 6
    let handler_passed: bool = race_handler_metric == 10
    let runtime_passed: bool = race_runtime_metric == 16

    let fast_passed_log_actual = fast_label
    let fast_passed_with_log: bool = fast_passed && (fast_passed_log_actual == fast_label)
    let handler_passed_log_actual = handler_label
    let handler_passed_with_log: bool = handler_passed && (handler_passed_log_actual == handler_label)
    let runtime_passed_log_actual = runtime_label
    let runtime_passed_with_log: bool = runtime_passed && (runtime_passed_log_actual == runtime_label)
    if (item_index == 0) {
        return RunRaceExpressionOperationsItem(
            ctx,
            scope,
            "RaceExpressionOperationsSyntaxForms",
            "race expression arm syntax with handler delimiters and comma-separated arms",
            "validated race expression syntax forms",
            "race-syntax",
            "evaluate race arm parse shape and handler body forms",
            "6",
            "6",
            "not-6",
            move fast_passed_with_log,
            "race syntax forms check failed"
        )
    }

    if (item_index == 1) {
        return RunRaceExpressionOperationsItem(
            ctx,
            scope,
            "RaceExpressionOperationsStaticSemantics",
            "race return-mode operand typing and handler result unification",
            "validated race expression static semantics",
            "race-static",
            "type-check race arm async signatures and handler result type agreement",
            "10",
            "10",
            "not-10",
            move handler_passed_with_log,
            "race static semantics check failed"
        )
    }

    if (item_index == 2) {
        return RunRaceExpressionOperationsItem(
            ctx,
            scope,
            "RaceExpressionOperationsRuntimeDiagnostics",
            "race runtime first-completion selection and aggregate behavior",
            "validated race expression runtime behavior and diagnostics",
            "race-runtime",
            "execute race runtime path and verify first-completion aggregate",
            "16",
            "16",
            "not-16",
            move runtime_passed_with_log,
            "race runtime diagnostics check failed"
        )
    }

    return RunRaceExpressionOperationsItem(
        ctx,
        scope,
        move item_name,
        "unknown race expression operation item",
        "failed unknown race expression operation item",
        "item-resolution",
        "resolve race expression operation item name",
        "known-item",
        "known-item",
        "unknown-item",
        false,
        "unknown race expression operation item"
    )
}

procedure RunRaceExpressionOperations(ctx: Context) -> i32 {
    let scope: string@View = "operations::AsyncFlow::RaceExpressionOperations"
    let checkpoint: string@View = "covered race expression operations operation items"

    let status_syntax: i32 = VerifyRaceExpressionOperationsItem(ctx, scope, 0, "RaceExpressionOperationsSyntaxForms")
    if (status_syntax != 0) {
        return status_syntax
    }

    let status_static: i32 = VerifyRaceExpressionOperationsItem(ctx, scope, 1, "RaceExpressionOperationsStaticSemantics")
    if (status_static != 0) {
        return status_static
    }

    let status_runtime: i32 = VerifyRaceExpressionOperationsItem(ctx, scope, 2, "RaceExpressionOperationsRuntimeDiagnostics")
    if (status_runtime != 0) {
        return status_runtime
    }

    return 0
}
