procedure SyncImmediate() -> Async<(), (), i32, !> {
    return 4
}

procedure SyncYieldOnce() -> Async<(), (), i32, !> {
    let resume_value: () = yield ()
    return 7
}

procedure SyncYieldReleaseOnce() -> Async<(), (), i32, !> {
    let resume_value: () = yield release ()
    return 9
}

procedure LogSyncExpressionObject(
    fs: $FileSystem,
    scope: string@View,
    move object_name: string@View,
    move object_type: string@View,
    move state: string@View,
    move details: string@View
) -> () {
    [[log(label: "operations-log-object")]]
}

procedure SyncExpressionMetricLabel(value: i32) -> string@View {
    if (value == 4) {
        return "4"
    }
    if (value == 7) {
        return "7"
    }
    if (value == 9) {
        return "9"
    }
    if (value == 20) {
        return "20"
    }
    return "other"
}

procedure RunSyncExpressionOperationsItem(
    ctx: Context,
    scope: string@View,
    move item_name: string@View,
    move item_details: string@View,
    move item_reason: string@View,
    move step_name: string@View,
    move step_detail: string@View,
    move expected: string@View,
    move actual_pass: string@View,
    move actual_fail: string@View,
    move passed: bool,
    move failure_reason: string@View
) -> i32 {
    let detail_begin: string@View = "operation feature item exercise start"
    [[log(label: "operations-log-item_begin")]]
    let passed_place: bool = passed
    let item_check_log: bool = [[log(label: "observed-item-check-pass", expected: true)]] passed_place
    let item_check_ok: bool = passed_place && (item_check_log == true)
    if (item_check_ok == false) {
        [[log(label: "operations-log-transition")]]
        [[log(label: "operations-log-item_fail")]]
        return 1
    }

    [[log(label: "operations-log-operations_item_success")]]
    return 0
}

procedure VerifySyncExpressionOperationsItem(ctx: Context, scope: string@View, move item_index: i32, move item_name: string@View) -> i32 {
    [[log(label: "operations-log-runtime_phase_move")]]
    LogSyncExpressionObject(ctx.fs, scope, "sync_async_immediate", "Async<(),(),i32,!>", "constructed", "immediate async source prepared")
    LogSyncExpressionObject(ctx.fs, scope, "sync_async_yield", "Async<(),(),i32,!>", "constructed", "yielding async source prepared")
    LogSyncExpressionObject(ctx.fs, scope, "sync_async_yield_release", "Async<(),(),i32,!>", "constructed", "yield-release async source prepared")

    [[log(label: "operations-log-runtime_phase_move")]]
    [[log(label: "operations-log-transition_move")]]
    let sync_immediate_metric: i32 = sync SyncImmediate()
    [[log(label: "operations-log-transition_move")]]
    [[log(label: "operations-log-transition_move")]]
    let sync_yield_metric: i32 = sync SyncYieldOnce()
    [[log(label: "operations-log-transition_move")]]
    [[log(label: "operations-log-transition_move")]]
    let sync_yield_release_metric: i32 = sync SyncYieldReleaseOnce()
    [[log(label: "operations-log-transition_move")]]
    let sync_runtime_metric: i32 = sync_immediate_metric + sync_yield_metric + sync_yield_release_metric

    let observed_immediate_step: string@View = "observed-sync-immediate-metric"
    let observed_yield_step: string@View = "observed-sync-yield-metric"
    let observed_release_step: string@View = "observed-sync-yield-release-metric"
    let observed_runtime_step: string@View = "observed-sync-runtime-aggregate-metric"
    let expected_immediate: string@View = "4"
    let expected_yield: string@View = "7"
    let expected_release: string@View = "9"
    let expected_runtime: string@View = "20"
    let immediate_label: string@View = SyncExpressionMetricLabel(sync_immediate_metric)
    let yield_label: string@View = SyncExpressionMetricLabel(sync_yield_metric)
    let release_label: string@View = SyncExpressionMetricLabel(sync_yield_release_metric)
    let runtime_label: string@View = SyncExpressionMetricLabel(sync_runtime_metric)
    let immediate_passed: bool = sync_immediate_metric == 4
    let yield_passed: bool = sync_yield_metric == 7
    let release_passed: bool = sync_yield_release_metric == 9
    let runtime_passed: bool = sync_runtime_metric == 20

    let immediate_passed_log_actual = [[log(label: "observed-sync-immediate-metric", expected: "4")]] immediate_label
    let immediate_passed_with_log: bool = immediate_passed && (immediate_passed_log_actual == immediate_label)
    let yield_passed_log_actual = [[log(label: "observed-sync-yield-metric", expected: "7")]] yield_label
    let yield_passed_with_log: bool = yield_passed && (yield_passed_log_actual == yield_label)
    let release_passed_log_actual = [[log(label: "observed-sync-yield-release-metric", expected: "9")]] release_label
    let release_passed_with_log: bool = release_passed && (release_passed_log_actual == release_label)
    let runtime_passed_log_actual = [[log(label: "observed-sync-runtime-aggregate-metric", expected: "20")]] runtime_label
    let runtime_passed_with_log: bool = runtime_passed && (runtime_passed_log_actual == runtime_label)
    [[log(label: "operations-log-runtime_phase_move")]]
    if (item_index == 0) {
        return RunSyncExpressionOperationsItem(
            ctx,
            scope,
            "SyncExpressionOperationsSyntaxForms",
            "sync expression keyword form over Async operands",
            "validated sync expression syntax forms",
            "sync-syntax",
            "evaluate sync expression parse and operand placement",
            "4",
            "4",
            "not-4",
            move immediate_passed_with_log,
            "sync syntax forms check failed"
        )
    }

    if (item_index == 1) {
        return RunSyncExpressionOperationsItem(
            ctx,
            scope,
            "SyncExpressionOperationsStaticSemantics",
            "sync operand typing requires Async<(),(),Result,E> and union result extraction",
            "validated sync expression static semantics",
            "sync-static",
            "type-check sync operand shape and result typing",
            "7",
            "7",
            "not-7",
            move yield_passed_with_log,
            "sync static semantics check failed"
        )
    }

    if (item_index == 2) {
        return RunSyncExpressionOperationsItem(
            ctx,
            scope,
            "SyncExpressionOperationsRuntimeDiagnostics",
            "sync runtime stepping through suspension and completion states",
            "validated sync expression runtime behavior and diagnostics",
            "sync-runtime",
            "execute full sync stepping path including yield release",
            "20",
            "20",
            "not-20",
            move runtime_passed_with_log,
            "sync runtime diagnostics check failed"
        )
    }

    return RunSyncExpressionOperationsItem(
        ctx,
        scope,
        move item_name,
        "unknown sync expression operation item",
        "failed unknown sync expression operation item",
        "item-resolution",
        "resolve sync expression operation item name",
        "known-item",
        "known-item",
        "unknown-item",
        false,
        "unknown sync expression operation item"
    )
}

procedure RunSyncExpressionOperations(ctx: Context) -> i32 {
    let scope: string@View = "operations::AsyncFlow::SyncExpressionOperations"
    let checkpoint: string@View = "covered sync expression operations operation items"

    let status_syntax: i32 = VerifySyncExpressionOperationsItem(ctx, scope, 0, "SyncExpressionOperationsSyntaxForms")
    if (status_syntax != 0) {
        return status_syntax
    }

    let status_static: i32 = VerifySyncExpressionOperationsItem(ctx, scope, 1, "SyncExpressionOperationsStaticSemantics")
    if (status_static != 0) {
        return status_static
    }

    let status_runtime: i32 = VerifySyncExpressionOperationsItem(ctx, scope, 2, "SyncExpressionOperationsRuntimeDiagnostics")
    if (status_runtime != 0) {
        return status_runtime
    }

    [[log(label: "operations-log-checkpoint")]]
    return 0
}
