
public procedure runGroup(ctx: Context) -> i32 {
    let section_name: string@View = "operations/AsyncFlow"
    let status_ok: string@View = "ok"
    let status_failed: string@View = "failed"

    let phase_planned: string@View = "planned"
    let phase_running: string@View = "running"
    let phase_complete: string@View = "complete"
    let phase_failed: string@View = "failed"
    let dispatch_reason: string@View = "dispatching operation topic function"
    let complete_reason: string@View = "operation topic function completed"
    let failed_reason: string@View = "operation topic function returned non-zero status"

    let feature_SyncExpressionOperations: string@View = "AsyncFlow::SyncExpressionOperations"
    let feature_RaceExpressionOperations: string@View = "AsyncFlow::RaceExpressionOperations"
    let feature_AllExpressionOperations: string@View = "AsyncFlow::AllExpressionOperations"
    let feature_YieldExpressionOperations: string@View = "AsyncFlow::YieldExpressionOperations"
    let feature_YieldFromExpressionOperations: string@View = "AsyncFlow::YieldFromExpressionOperations"
    let feature_UntilExpressionOperations: string@View = "AsyncFlow::UntilExpressionOperations"

    let status_SyncExpressionOperations: i32 = RunSyncExpressionOperations(ctx)
    if (status_SyncExpressionOperations != 0) {
        return status_SyncExpressionOperations
    }
    let status_RaceExpressionOperations: i32 = RunRaceExpressionOperations(ctx)
    if (status_RaceExpressionOperations != 0) {
        return status_RaceExpressionOperations
    }
    let status_AllExpressionOperations: i32 = RunAllExpressionOperations(ctx)
    if (status_AllExpressionOperations != 0) {
        return status_AllExpressionOperations
    }
    let status_YieldExpressionOperations: i32 = RunYieldExpressionOperations(ctx)
    if (status_YieldExpressionOperations != 0) {
        return status_YieldExpressionOperations
    }
    let status_YieldFromExpressionOperations: i32 = RunYieldFromExpressionOperations(ctx)
    if (status_YieldFromExpressionOperations != 0) {
        return status_YieldFromExpressionOperations
    }
    let status_UntilExpressionOperations: i32 = RunUntilExpressionOperations(ctx)
    if (status_UntilExpressionOperations != 0) {
        return status_UntilExpressionOperations
    }
    return 0
}
