procedure AllImmediateTwo() -> Async<(), (), i32, !> {
    return 2
}

procedure AllYieldThree() -> Async<(), (), i32, !> {
    let resume_value: () = yield ()
    return 3
}

procedure AllYieldReleaseFour() -> Async<(), (), i32, !> {
    let resume_value: () = yield release ()
    return 4
}

procedure LogAllExpressionObject(
    fs: $FileSystem,
    scope: string@View,
    move object_name: string@View,
    move object_type: string@View,
    move state: string@View,
    move details: string@View
) -> () {
    [[log(label: "operations-log-object")]]
}

procedure AllExpressionMetricLabel(value: i32) -> string@View {
    if (value == 5) {
        return "5"
    }
    if (value == 9) {
        return "9"
    }
    if (value == 14) {
        return "14"
    }
    return "other"
}

procedure RunAllExpressionOperationsItem(
    ctx: Context,
    scope: string@View,
    move item_name: string@View,
    move item_details: string@View,
    move item_reason: string@View,
    move step_name: string@View,
    move step_detail: string@View,
    move expected: string@View,
    move actual_pass: string@View,
    move actual_fail: string@View,
    move passed: bool,
    move failure_reason: string@View
) -> i32 {
    let detail_begin: string@View = "operation feature item exercise start"
    [[log(label: "operations-log-item_begin")]]
    let passed_place: bool = passed
    let item_check_log: bool = [[log(label: "observed-item-check-pass", expected: true)]] passed_place
    let item_check_ok: bool = passed_place && (item_check_log == true)
    if (item_check_ok == false) {
        [[log(label: "operations-log-transition")]]
        [[log(label: "operations-log-item_fail")]]
        return 1
    }

    [[log(label: "operations-log-operations_item_success")]]
    return 0
}

procedure VerifyAllExpressionOperationsItem(ctx: Context, scope: string@View, move item_index: i32, move item_name: string@View) -> i32 {
    [[log(label: "operations-log-runtime_phase_move")]]
    LogAllExpressionObject(ctx.fs, scope, "all_pair_operands", "Async<(),(),i32,!> x2", "constructed", "pair async operands prepared for all expression")
    LogAllExpressionObject(ctx.fs, scope, "all_triple_operands", "Async<(),(),i32,!> x3", "constructed", "triple async operands prepared for all expression")

    [[log(label: "operations-log-runtime_phase_move")]]
    [[log(label: "operations-log-transition_move")]]
    let all_pair_result: (i32, i32) | ! = all {
        AllImmediateTwo(),
        AllYieldThree()
    }
    let all_pair_metric: i32 = if all_pair_result is {
        pair: (i32, i32) { pair.0 + pair.1 }
        _: ! { 0 }
    }
    [[log(label: "operations-log-transition_move")]]
    [[log(label: "operations-log-transition_move")]]
    let all_triple_result: (i32, i32, i32) | ! = all {
        AllImmediateTwo(),
        AllYieldThree(),
        AllYieldReleaseFour()
    }
    let all_triple_metric: i32 = if all_triple_result is {
        triple: (i32, i32, i32) { triple.0 + triple.1 + triple.2 }
        _: ! { 0 }
    }
    [[log(label: "operations-log-transition_move")]]
    let all_runtime_metric: i32 = all_pair_metric + all_triple_metric

    let observed_pair_step: string@View = "observed-all-pair-metric"
    let observed_triple_step: string@View = "observed-all-triple-metric"
    let observed_runtime_step: string@View = "observed-all-runtime-aggregate-metric"
    let expected_pair: string@View = "5"
    let expected_triple: string@View = "9"
    let expected_runtime: string@View = "14"
    let pair_label: string@View = AllExpressionMetricLabel(all_pair_metric)
    let triple_label: string@View = AllExpressionMetricLabel(all_triple_metric)
    let runtime_label: string@View = AllExpressionMetricLabel(all_runtime_metric)
    let pair_passed: bool = all_pair_metric == 5
    let triple_passed: bool = all_triple_metric == 9
    let runtime_passed: bool = all_runtime_metric == 14

    let pair_passed_log_actual = [[log(label: "observed-all-pair-metric", expected: "5")]] pair_label
    let pair_passed_with_log: bool = pair_passed && (pair_passed_log_actual == pair_label)
    let triple_passed_log_actual = [[log(label: "observed-all-triple-metric", expected: "9")]] triple_label
    let triple_passed_with_log: bool = triple_passed && (triple_passed_log_actual == triple_label)
    let runtime_passed_log_actual = [[log(label: "observed-all-runtime-aggregate-metric", expected: "14")]] runtime_label
    let runtime_passed_with_log: bool = runtime_passed && (runtime_passed_log_actual == runtime_label)
    [[log(label: "operations-log-runtime_phase_move")]]
    if (item_index == 0) {
        return RunAllExpressionOperationsItem(
            ctx,
            scope,
            "AllExpressionOperationsSyntaxForms",
            "all expression brace-list syntax and expression list parsing",
            "validated all expression syntax forms",
            "all-syntax",
            "evaluate all-expression brace list and comma-separated operand forms",
            "5",
            "5",
            "not-5",
            move pair_passed_with_log,
            "all syntax forms check failed"
        )
    }

    if (item_index == 1) {
        return RunAllExpressionOperationsItem(
            ctx,
            scope,
            "AllExpressionOperationsStaticSemantics",
            "all operand async-shape typing and tuple result typing",
            "validated all expression static semantics",
            "all-static",
            "type-check all operands for Out=() and In=() and tuple synthesis",
            "9",
            "9",
            "not-9",
            move triple_passed_with_log,
            "all static semantics check failed"
        )
    }

    if (item_index == 2) {
        return RunAllExpressionOperationsItem(
            ctx,
            scope,
            "AllExpressionOperationsRuntimeDiagnostics",
            "all runtime completion collection and ordered tuple materialization",
            "validated all expression runtime behavior and diagnostics",
            "all-runtime",
            "execute all-expression runtime aggregation path",
            "14",
            "14",
            "not-14",
            move runtime_passed_with_log,
            "all runtime diagnostics check failed"
        )
    }

    return RunAllExpressionOperationsItem(
        ctx,
        scope,
        move item_name,
        "unknown all expression operation item",
        "failed unknown all expression operation item",
        "item-resolution",
        "resolve all expression operation item name",
        "known-item",
        "known-item",
        "unknown-item",
        false,
        "unknown all expression operation item"
    )
}

procedure RunAllExpressionOperations(ctx: Context) -> i32 {
    let scope: string@View = "operations::AsyncFlow::AllExpressionOperations"
    let checkpoint: string@View = "covered all expression operations operation items"

    let status_syntax: i32 = VerifyAllExpressionOperationsItem(ctx, scope, 0, "AllExpressionOperationsSyntaxForms")
    if (status_syntax != 0) {
        return status_syntax
    }

    let status_static: i32 = VerifyAllExpressionOperationsItem(ctx, scope, 1, "AllExpressionOperationsStaticSemantics")
    if (status_static != 0) {
        return status_static
    }

    let status_runtime: i32 = VerifyAllExpressionOperationsItem(ctx, scope, 2, "AllExpressionOperationsRuntimeDiagnostics")
    if (status_runtime != 0) {
        return status_runtime
    }

    [[log(label: "operations-log-checkpoint")]]
    return 0
}
