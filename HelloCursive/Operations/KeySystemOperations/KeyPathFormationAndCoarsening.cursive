public record KeyPathLeaf {
    value: i32
}

public record KeyPathRoot {
    leaf: KeyPathLeaf
}

procedure LogKeyPathFormationObject(
    fs: $FileSystem,
    scope: string@View,
    move object_name: string@View,
    move object_type: string@View,
    move state: string@View,
    move details: string@View
) -> () {
    [[log(label: "operations-log-object")]]
}

procedure KeyPathFormationMetricLabel(value: i32) -> string@View {
    if (value == 4) {
        return "4"
    }
    if (value == 7) {
        return "7"
    }
    if (value == 13) {
        return "13"
    }
    return "other"
}

procedure RunKeyPathFormationItem(
    ctx: Context,
    scope: string@View,
    move item_name: string@View,
    move item_details: string@View,
    move item_reason: string@View,
    move step_name: string@View,
    move step_detail: string@View,
    move expected: string@View,
    move actual_pass: string@View,
    move actual_fail: string@View,
    move passed: bool,
    move failure_reason: string@View
) -> i32 {
    [[log(label: "operations-log-item_begin")]]
    let passed_place: bool = passed
    let item_check_log: bool = [[log(label: "observed-item-check-pass", expected: true)]] passed_place
    let item_check_ok: bool = passed_place && (item_check_log == true)
    if (item_check_ok == false) {
        [[log(label: "operations-log-transition")]]
        [[log(label: "operations-log-item_fail")]]
        return 1
    }

    [[log(label: "operations-log-operations_item_success")]]
    return 0
}

[[dynamic]]
procedure VerifyKeyPathFormationItem(ctx: Context, scope: string@View, move item_index: i32, move item_name: string@View) -> i32 {
    [[log(label: "operations-log-runtime_phase_move")]]
    var nested_root: shared KeyPathRoot = KeyPathRoot { leaf: KeyPathLeaf { value: 4 } }
    var indexed_slots: shared [i32; 3] = [1, 2, 3]
    let index: usize = 1

    let diag_coarsen_non_record: string@View = "E-CON-0033"
    let diag_coarsen_ordered_hint: string@View = "W-CON-0013"

    LogKeyPathFormationObject(ctx.fs, scope, "nested_root", "KeyPathRoot", "constructed", "nested key-path root prepared")
    LogKeyPathFormationObject(ctx.fs, scope, "indexed_slots", "[i32;3]", "constructed", "indexed key-path root prepared")
    LogKeyPathFormationObject(ctx.fs, scope, "diag_coarsen_non_record", "diagnostic-code", "constructed", "coarsen non-record diagnostic mapping prepared")
    LogKeyPathFormationObject(ctx.fs, scope, "diag_coarsen_ordered_hint", "diagnostic-code", "constructed", "coarsen ordered-hint warning mapping prepared")

    [[log(label: "operations-log-runtime_phase_move")]]
    var syntax_metric: i32 = 0
    [[log(label: "operations-log-transition_move")]]
    # nested_root.leaf read {
        syntax_metric = nested_root.leaf.value
    }
    [[log(label: "operations-log-transition_move")]]
    [[log(label: "operations-log-transition_move")]]
    # indexed_slots[index] write {
        let current_value: i32 = indexed_slots[index]
        let updated_value: i32 = current_value + 5
        indexed_slots[index] = updated_value
    }
    let static_metric: i32 = indexed_slots[index]
    [[log(label: "operations-log-transition_move")]]
    let diag_coarsen_non_record_ok: bool = diag_coarsen_non_record == "E-CON-0033"
    let diag_coarsen_ordered_hint_ok: bool = diag_coarsen_ordered_hint == "W-CON-0013"

    let diag_coarsen_non_record_ok_log_actual = [[log(label: "diagnostic-coarsen-non-record", expected: "E-CON-0033")]] diag_coarsen_non_record
    let diag_coarsen_non_record_ok_with_log: bool = diag_coarsen_non_record_ok && (diag_coarsen_non_record_ok_log_actual == diag_coarsen_non_record)
    let diag_coarsen_ordered_hint_ok_log_actual = [[log(label: "diagnostic-coarsen-ordered-hint", expected: "W-CON-0013")]] diag_coarsen_ordered_hint
    let diag_coarsen_ordered_hint_ok_with_log: bool = diag_coarsen_ordered_hint_ok && (diag_coarsen_ordered_hint_ok_log_actual == diag_coarsen_ordered_hint)
    let diag_count: i32 = if (diag_coarsen_non_record_ok && diag_coarsen_ordered_hint_ok) { 2 } else { 0 }
    let runtime_metric: i32 = syntax_metric + static_metric + diag_count

    let syntax_passed: bool = syntax_metric == 4
    let static_passed: bool = static_metric == 7
    let runtime_passed: bool = runtime_metric == 13

    let actual_label_1: string@View = KeyPathFormationMetricLabel(syntax_metric)
    let syntax_passed_log_actual = [[log(label: "observed-key-path-formation-syntax-metric", expected: "4")]] actual_label_1
    let syntax_passed_with_log: bool = syntax_passed && (syntax_passed_log_actual == actual_label_1)
    let actual_label_2: string@View = KeyPathFormationMetricLabel(static_metric)
    let static_passed_log_actual = [[log(label: "observed-key-path-formation-static-metric", expected: "7")]] actual_label_2
    let static_passed_with_log: bool = static_passed && (static_passed_log_actual == actual_label_2)
    let actual_label_3: string@View = KeyPathFormationMetricLabel(runtime_metric)
    let runtime_passed_log_actual = [[log(label: "observed-key-path-formation-runtime-metric", expected: "13")]] actual_label_3
    let runtime_passed_with_log: bool = runtime_passed && (runtime_passed_log_actual == actual_label_3)
    [[log(label: "operations-log-runtime_phase_move")]]
    if (item_index == 0) {
        return RunKeyPathFormationItem(
            ctx,
            scope,
            "KeyPathFormationAndCoarseningSyntaxForms",
            "syntax forms for nested and indexed key-path expressions in key blocks",
            "validated key path formation and coarsening syntax forms",
            "key-path-formation-syntax",
            "evaluate nested path key-block syntax and read behavior",
            "4",
            "4",
            "not-4",
            move syntax_passed_with_log,
            "key path formation/coarsening syntax forms check failed"
        )
    }

    if (item_index == 1) {
        return RunKeyPathFormationItem(
            ctx,
            scope,
            "KeyPathFormationAndCoarseningStaticSemantics",
            "static key-path root/type validation for nested and indexed acquisitions",
            "validated key path formation and coarsening static semantics",
            "key-path-formation-static",
            "type-check indexed write key path and resulting value update",
            "7",
            "7",
            "not-7",
            move static_passed_with_log,
            "key path formation/coarsening static semantics check failed"
        )
    }

    if (item_index == 2) {
        return RunKeyPathFormationItem(
            ctx,
            scope,
            "KeyPathFormationAndCoarseningRuntimeDiagnostics",
            "runtime key-path behavior with coarsening diagnostic-code matrix checks",
            "validated key path formation and coarsening runtime behavior and diagnostics",
            "key-path-formation-runtime",
            "verify nested/indexed runtime aggregate and coarsening diagnostics mappings",
            "13",
            "13",
            "not-13",
            move runtime_passed_with_log,
            "key path formation/coarsening runtime diagnostics check failed"
        )
    }

    return RunKeyPathFormationItem(
        ctx,
        scope,
        move item_name,
        "unknown key path formation/coarsening item",
        "failed unknown key path formation/coarsening item",
        "item-resolution",
        "resolve key path formation/coarsening item name",
        "known-item",
        "known-item",
        "unknown-item",
        false,
        "unknown key path formation/coarsening item"
    )
}

procedure RunKeyPathFormationAndCoarsening(ctx: Context) -> i32 {
    let scope: string@View = "operations::KeySystemOperations::KeyPathFormationAndCoarsening"
    let checkpoint: string@View = "covered key path formation and coarsening operation items"

    let status_syntax: i32 = VerifyKeyPathFormationItem(ctx, scope, 0, "KeyPathFormationAndCoarseningSyntaxForms")
    if (status_syntax != 0) {
        return status_syntax
    }

    let status_static: i32 = VerifyKeyPathFormationItem(ctx, scope, 1, "KeyPathFormationAndCoarseningStaticSemantics")
    if (status_static != 0) {
        return status_static
    }

    let status_runtime: i32 = VerifyKeyPathFormationItem(ctx, scope, 2, "KeyPathFormationAndCoarseningRuntimeDiagnostics")
    if (status_runtime != 0) {
        return status_runtime
    }

    [[log(label: "operations-log-checkpoint")]]
    return 0
}
