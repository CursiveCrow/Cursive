procedure KeyAcquisitionPredicate(value: const i32) -> bool {
    return value >= 2
}

procedure KeyAcquisitionAction(value: unique i32) -> i32 {
    return value + 1
}

procedure LogKeyAcquisitionObject(
    fs: $FileSystem,
    scope: string@View,
    move object_name: string@View,
    move object_type: string@View,
    move state: string@View,
    move details: string@View
) -> () {
    }

procedure KeyAcquisitionMetricLabel(value: i32) -> string@View {
    if (value == 4) {
        return "4"
    }
    if (value == 7) {
        return "7"
    }
    if (value == 10) {
        return "10"
    }
    return "other"
}

procedure RunKeyAcquisitionItem(
    ctx: Context,
    scope: string@View,
    move item_name: string@View,
    move item_details: string@View,
    move item_reason: string@View,
    move step_name: string@View,
    move step_detail: string@View,
    move expected: string@View,
    move actual_pass: string@View,
    move actual_fail: string@View,
    move passed: bool,
    move failure_reason: string@View
) -> i32 {
    let passed_place: bool = passed
    let item_check_log: bool = passed_place
    let item_check_ok: bool = passed_place && (item_check_log == true)
    if (item_check_ok == false) {
        return 1
    }

    return 0
}

procedure VerifyKeyAcquisitionItem(ctx: Context, scope: string@View, move item_index: i32, move item_name: string@View) -> i32 {
    var explicit_slot: shared i32 = 4
    let implicit_seed: unique i32 = 2
    let implicit_shared: shared i32 = implicit_seed

    LogKeyAcquisitionObject(ctx.fs, scope, "explicit_slot", "i32", "constructed", "explicit key-block target prepared")
    LogKeyAcquisitionObject(ctx.fs, scope, "implicit_shared", "shared i32", "constructed", "implicit shared-access target prepared")

    var syntax_metric: i32 = 0
    # explicit_slot read {
        syntax_metric = explicit_slot
    }
    # explicit_slot write {
        let rmw_warning_6 = explicit_slot
        explicit_slot = rmw_warning_6 + 3
    }
    let static_metric: i32 = explicit_slot
    let implicit_future: Async<(), (), i32, !> = implicit_shared~>until(KeyAcquisitionPredicate, KeyAcquisitionAction)
    let implicit_metric: i32 = sync implicit_future
    let runtime_metric: i32 = static_metric + implicit_metric

    let syntax_passed: bool = syntax_metric == 4
    let static_passed: bool = static_metric == 7
    let runtime_passed: bool = runtime_metric == 10

    let actual_label_1: string@View = KeyAcquisitionMetricLabel(syntax_metric)
    let syntax_passed_log_actual = actual_label_1
    let syntax_passed_with_log: bool = syntax_passed && (syntax_passed_log_actual == actual_label_1)
    let actual_label_2: string@View = KeyAcquisitionMetricLabel(static_metric)
    let static_passed_log_actual = actual_label_2
    let static_passed_with_log: bool = static_passed && (static_passed_log_actual == actual_label_2)
    let actual_label_3: string@View = KeyAcquisitionMetricLabel(runtime_metric)
    let runtime_passed_log_actual = actual_label_3
    let runtime_passed_with_log: bool = runtime_passed && (runtime_passed_log_actual == actual_label_3)
    if (item_index == 0) {
        return RunKeyAcquisitionItem(
            ctx,
            scope,
            "ImplicitAndExplicitKeyAcquisitionSyntaxForms",
            "syntax forms for explicit `# path read/write {}` key blocks",
            "validated implicit and explicit key acquisition syntax forms",
            "key-acquisition-syntax",
            "evaluate explicit read key-block syntax and value readback",
            "4",
            "4",
            "not-4",
            move syntax_passed_with_log,
            "implicit/explicit key acquisition syntax forms check failed"
        )
    }

    if (item_index == 1) {
        return RunKeyAcquisitionItem(
            ctx,
            scope,
            "ImplicitAndExplicitKeyAcquisitionStaticSemantics",
            "mode correctness for explicit write key block and typed mutation legality",
            "validated implicit and explicit key acquisition static semantics",
            "key-acquisition-static",
            "type-check explicit write key-block mutation against path mode requirements",
            "7",
            "7",
            "not-7",
            move static_passed_with_log,
            "implicit/explicit key acquisition static semantics check failed"
        )
    }

    if (item_index == 2) {
        return RunKeyAcquisitionItem(
            ctx,
            scope,
            "ImplicitAndExplicitKeyAcquisitionRuntimeDiagnostics",
            "runtime implicit key acquisition via shared access and explicit block release behavior",
            "validated implicit and explicit key acquisition runtime behavior and diagnostics",
            "key-acquisition-runtime",
            "execute explicit + implicit key paths and verify runtime aggregate metric",
            "10",
            "10",
            "not-10",
            move runtime_passed_with_log,
            "implicit/explicit key acquisition runtime diagnostics check failed"
        )
    }

    return RunKeyAcquisitionItem(
        ctx,
        scope,
        move item_name,
        "unknown implicit/explicit key acquisition item",
        "failed unknown implicit/explicit key acquisition item",
        "item-resolution",
        "resolve implicit/explicit key acquisition item name",
        "known-item",
        "known-item",
        "unknown-item",
        false,
        "unknown implicit/explicit key acquisition item"
    )
}

procedure RunImplicitAndExplicitKeyAcquisition(ctx: Context) -> i32 {
    let scope: string@View = "operations::KeySystemOperations::ImplicitAndExplicitKeyAcquisition"
    let checkpoint: string@View = "covered implicit and explicit key acquisition operation items"

    let status_syntax: i32 = VerifyKeyAcquisitionItem(ctx, scope, 0, "ImplicitAndExplicitKeyAcquisitionSyntaxForms")
    if (status_syntax != 0) {
        return status_syntax
    }

    let status_static: i32 = VerifyKeyAcquisitionItem(ctx, scope, 1, "ImplicitAndExplicitKeyAcquisitionStaticSemantics")
    if (status_static != 0) {
        return status_static
    }

    let status_runtime: i32 = VerifyKeyAcquisitionItem(ctx, scope, 2, "ImplicitAndExplicitKeyAcquisitionRuntimeDiagnostics")
    if (status_runtime != 0) {
        return status_runtime
    }

    return 0
}
