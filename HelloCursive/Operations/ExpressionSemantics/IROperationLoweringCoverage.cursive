procedure IROperationLoweringSelect(flag: bool, left: i32, right: i32) -> i32 {
    if (flag) {
        return left
    }
    return right
}

procedure IROperationLoweringMetricLabel(value: i32) -> string@View {
    if (value == 52) {
        return "52"
    }
    return "other"
}

procedure RunIROperationLoweringCoverage(ctx: Context) -> i32 {
    let _ = ctx

    let seq_metric: i32 = {
        let left: i32 = 3
        let right: i32 = 4
        left + right
    }

    let phi_metric: i32 = if (seq_metric == 7) { 11 } else { 13 }

    var loop_index: i32 = 0
    var loop_acc: i32 = 0
    loop {
        if (loop_index == 4) {
            break
        }
        loop_acc = loop_acc + loop_index
        loop_index = loop_index + 1
    }
    let loop_metric: i32 = loop_acc

    let union_value: i32 | bool = true
    let if_case_metric: i32 = if union_value is {
        _: i32 { 17 }
        _: bool { 19 }
    }

    let loop_is_six: bool = loop_metric == 6
    let merge_metric: i32 = IROperationLoweringSelect(loop_is_six, 9, 1)

    let total_metric: i32 =
        seq_metric +
        phi_metric +
        loop_metric +
        if_case_metric +
        merge_metric

    let lowering_surface_ok: bool = total_metric == 52
    let lowering_surface_ok_log: bool =
        [[log(label: "operations-expression-ir-lowering-surface", expected: true)]]
        lowering_surface_ok

    let metric: i32 = if ((lowering_surface_ok_log == true) && lowering_surface_ok) { 52 } else { 0 }
    let metric_label: string@View = IROperationLoweringMetricLabel(metric)
    let metric_log_actual: string@View =
        [[log(label: "observed-operations-expression-ir-lowering-metric", expected: "52")]]
        metric_label
    if (metric_log_actual != "52") {
        [[log(label: "operations-log-item_fail")]]
        return 1
    }

    [[log(label: "operations-log-operations_item_success")]]
    return 0
}
