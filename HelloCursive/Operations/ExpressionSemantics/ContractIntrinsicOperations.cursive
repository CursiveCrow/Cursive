[[dynamic]]
procedure ContractIntrinsicProbeSingle(x: i32) -> i32
    |: => @entry(x) + 2 == @result
{
    return x + 2
}

[[dynamic]]
procedure ContractIntrinsicProbePair(left: i32, right: i32) -> i32
    |: => @entry(left) + @entry(right) == @result
{
    return left + right
}

procedure LogContractIntrinsicObject(
    fs: $FileSystem,
    scope: string@View,
    move object_name: string@View,
    move object_type: string@View,
    move state: string@View,
    move details: string@View
) -> () {
    }

procedure ContractIntrinsicMetricLabel(value: i32) -> string@View {
    if (value == 5) {
        return "5"
    }
    if (value == 6) {
        return "6"
    }
    if (value == 11) {
        return "11"
    }
    return "other"
}

procedure RunContractIntrinsicOperationsItem(
    ctx: Context,
    scope: string@View,
    move item_name: string@View,
    move item_details: string@View,
    move item_reason: string@View,
    move step_name: string@View,
    move step_detail: string@View,
    move expected: string@View,
    move actual_pass: string@View,
    move actual_fail: string@View,
    move passed: bool,
    move failure_reason: string@View
) -> i32 {
    let detail_begin: string@View = "operation feature item exercise start"
    let passed_place: bool = passed
    let item_check_log: bool = passed_place
    let item_check_ok: bool = passed_place && (item_check_log == true)
    if (item_check_ok == false) {
        return 1
    }

    return 0
}

procedure VerifyContractIntrinsicOperationsItem(ctx: Context, scope: string@View, move item_index: i32, move item_name: string@View) -> i32 {
    LogContractIntrinsicObject(ctx.fs, scope, "contract_probe_single", "procedure(i32)->i32", "constructed", "single-parameter contract probe prepared")
    LogContractIntrinsicObject(ctx.fs, scope, "contract_probe_pair", "procedure(i32,i32)->i32", "constructed", "pair-parameter contract probe prepared")

    let single_metric: i32 = ContractIntrinsicProbeSingle(3)
    let pair_metric: i32 = ContractIntrinsicProbePair(2, 4)
    let runtime_metric: i32 = single_metric + pair_metric

    let observed_single_step: string@View = "observed-contract-single-metric"
    let observed_pair_step: string@View = "observed-contract-pair-metric"
    let observed_runtime_step: string@View = "observed-contract-runtime-aggregate-metric"
    let expected_single: string@View = "5"
    let expected_pair: string@View = "6"
    let expected_runtime: string@View = "11"
    let single_label: string@View = ContractIntrinsicMetricLabel(single_metric)
    let pair_label: string@View = ContractIntrinsicMetricLabel(pair_metric)
    let runtime_label: string@View = ContractIntrinsicMetricLabel(runtime_metric)
    let single_passed: bool = single_metric == 5
    let pair_passed: bool = pair_metric == 6
    let runtime_passed: bool = runtime_metric == 11

    let single_passed_log_actual = single_label
    let single_passed_with_log: bool = single_passed && (single_passed_log_actual == single_label)
    let pair_passed_log_actual = pair_label
    let pair_passed_with_log: bool = pair_passed && (pair_passed_log_actual == pair_label)
    let runtime_passed_log_actual = runtime_label
    let runtime_passed_with_log: bool = runtime_passed && (runtime_passed_log_actual == runtime_label)
    if (item_index == 0) {
        return RunContractIntrinsicOperationsItem(
            ctx,
            scope,
            "ContractIntrinsicOperationsSyntaxForms",
            "postcondition syntax containing @entry(...) and @result intrinsics",
            "validated contract intrinsic syntax forms",
            "contract-intrinsic-syntax",
            "evaluate contract clause surface with @entry and @result",
            "5",
            "5",
            "not-5",
            move single_passed_with_log,
            "contract intrinsic syntax forms check failed"
        )
    }

    if (item_index == 1) {
        return RunContractIntrinsicOperationsItem(
            ctx,
            scope,
            "ContractIntrinsicOperationsStaticSemantics",
            "intrinsic scope restrictions and postcondition typing over entry/result bindings",
            "validated contract intrinsic static semantics",
            "contract-intrinsic-static",
            "type-check @entry and @result within postcondition context",
            "6",
            "6",
            "not-6",
            move pair_passed_with_log,
            "contract intrinsic static semantics check failed"
        )
    }

    if (item_index == 2) {
        return RunContractIntrinsicOperationsItem(
            ctx,
            scope,
            "ContractIntrinsicOperationsRuntimeDiagnostics",
            "runtime capture of @entry values and @result validation at return",
            "validated contract intrinsic runtime behavior and diagnostics",
            "contract-intrinsic-runtime",
            "execute contract-enabled procedures and verify aggregate metric",
            "11",
            "11",
            "not-11",
            move runtime_passed_with_log,
            "contract intrinsic runtime diagnostics check failed"
        )
    }

    return RunContractIntrinsicOperationsItem(
        ctx,
        scope,
        move item_name,
        "unknown contract-intrinsic operation item",
        "failed unknown contract-intrinsic operation item",
        "item-resolution",
        "resolve contract-intrinsic operation item name",
        "known-item",
        "known-item",
        "unknown-item",
        false,
        "unknown contract-intrinsic operation item"
    )
}

procedure RunContractIntrinsicOperations(ctx: Context) -> i32 {
    let scope: string@View = "operations::ExpressionSemantics::ContractIntrinsicOperations"
    let checkpoint: string@View = "covered contract intrinsic operations operation items"

    let status_syntax: i32 = VerifyContractIntrinsicOperationsItem(ctx, scope, 0, "ContractIntrinsicOperationsSyntaxForms")
    if (status_syntax != 0) {
        return status_syntax
    }

    let status_static: i32 = VerifyContractIntrinsicOperationsItem(ctx, scope, 1, "ContractIntrinsicOperationsStaticSemantics")
    if (status_static != 0) {
        return status_static
    }

    let status_runtime: i32 = VerifyContractIntrinsicOperationsItem(ctx, scope, 2, "ContractIntrinsicOperationsRuntimeDiagnostics")
    if (status_runtime != 0) {
        return status_runtime
    }

    return 0
}
