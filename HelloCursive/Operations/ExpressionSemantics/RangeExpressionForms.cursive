procedure CountExclusiveRange() -> i32 {
    let exclusive_values: Range<usize> = 0usize..3usize
    var count: i32 = 0
    loop _ in exclusive_values {
        count = count + 1
    }
    return count
}

procedure CountInclusiveRange() -> i32 {
    let inclusive_values: RangeInclusive<usize> = 0usize..=3usize
    var count: i32 = 0
    loop _ in inclusive_values {
        count = count + 1
    }
    return count
}

procedure AdvanceRangeEvalOrder(counter: *mut i32, move digit: i32) -> i32 {
    var counter_mut: *mut i32 = counter
    let next: i32 = unsafe {
        let prior: i32 = *counter_mut
        let advanced: i32 = (prior * 10) + digit
        *counter_mut = advanced
        advanced
    }
    return next
}

procedure BuildRangeBound(counter: *mut i32, move digit: i32, move value: usize) -> usize {
    let _ = AdvanceRangeEvalOrder(counter, move digit)
    return value
}

procedure EvaluateRangeValueProbe(counter: *mut i32) -> Range<usize> {
    var counter_mut: *mut i32 = counter
    return BuildRangeBound(counter_mut, 1, 1usize)..BuildRangeBound(counter_mut, 2, 4usize)
}

procedure EvaluateRangeControlLoProbe(counter: *mut i32) -> i32 {
    var counter_mut: *mut i32 = counter
    let _range_probe: Range<usize> =
        (
            if (AdvanceRangeEvalOrder(counter_mut, 1) == 1) {
                return 17
            } else {
                1usize
            }
        )..BuildRangeBound(counter_mut, 2, 4usize)
    unsafe {
        *counter_mut = 999
    }
    return 0
}

procedure EvaluateRangeControlHiProbe(counter: *mut i32) -> i32 {
    var counter_mut: *mut i32 = counter
    let _range_probe: Range<usize> =
        BuildRangeBound(counter_mut, 1, 1usize)..(
            if (AdvanceRangeEvalOrder(counter_mut, 2) == 12) {
                return 17
            } else {
                4usize
            }
        )
    unsafe {
        *counter_mut = 999
    }
    return 0
}

procedure EvaluateRangeWindowMetric(values: [i32; 5], counter: *mut i32) -> i32 {
    let narrowed = values[EvaluateRangeValueProbe(counter)]
    return narrowed[0usize] + narrowed[2usize]
}

procedure LogRangeExpressionObject(
    fs: $FileSystem,
    scope: string@View,
    move object_name: string@View,
    move object_type: string@View,
    move state: string@View,
    move details: string@View
) -> () {
    }

procedure RangeExpressionMetricLabel(value: i32) -> string@View {
    if (value == 6) {
        return "6"
    }
    if (value == 7) {
        return "7"
    }
    if (value == 13) {
        return "13"
    }
    if (value == 20) {
        return "20"
    }
    return "other"
}

procedure RunRangeExpressionFormsItem(
    ctx: Context,
    scope: string@View,
    move item_name: string@View,
    move item_details: string@View,
    move item_reason: string@View,
    move step_name: string@View,
    move step_detail: string@View,
    move expected: string@View,
    move actual_pass: string@View,
    move actual_fail: string@View,
    move passed: bool,
    move failure_reason: string@View
) -> i32 {
    let detail_begin: string@View = "operation feature item exercise start"
    let passed_place: bool = passed
    let item_check_log: bool = passed_place
    let item_check_ok: bool = passed_place && (item_check_log == true)
    if (item_check_ok == false) {
        return 1
    }

    return 0
}

procedure VerifyRangeExpressionFormsItem(ctx: Context, scope: string@View, move item_index: i32, move item_name: string@View) -> i32 {
    LogRangeExpressionObject(ctx.fs, scope, "range_forms_decl", "range-expression-set", "constructed", "all range-form declarations prepared")
    LogRangeExpressionObject(ctx.fs, scope, "range_iterable_metrics", "i32", "constructed", "exclusive/inclusive range iteration metrics prepared")
    LogRangeExpressionObject(ctx.fs, scope, "range_to_bound_metrics", "i32", "constructed", "to/to-inclusive range iteration metrics prepared")
    LogRangeExpressionObject(ctx.fs, scope, "range_value_windows", "[i32]", "constructed", "standalone range values prepared for later slicing")
    LogRangeExpressionObject(ctx.fs, scope, "range_control_metrics", "i32", "constructed", "range bound evaluation-order control probes prepared")

    let range_exclusive: Range<usize> = 0usize..3usize
    let range_inclusive: RangeInclusive<usize> = 0usize..=3usize
    let range_from: RangeFrom<usize> = 1usize..
    let range_to: RangeTo<usize> = ..3usize
    let range_to_inclusive: RangeToInclusive<usize> = ..=3usize
    let range_full: RangeFull = ..
    let forms_metric: i32 = 6
    let exclusive_count: i32 = CountExclusiveRange()
    let inclusive_count: i32 = CountInclusiveRange()
    let iteration_metric: i32 = exclusive_count + inclusive_count
    let to_metric: i32 = parallel ctx~>cpu() { dispatch _ in ..3usize [reduce: +] { 1 } }
    let to_inclusive_metric: i32 = parallel ctx~>cpu() { dispatch _ in ..=3usize [reduce: +] { 1 } }
    let bounded_range_metric: i32 = to_metric + to_inclusive_metric
    let range_values: [i32; 5] = [2, 4, 6, 8, 10]
    let dynamic_start: usize = 1usize
    let dynamic_end: usize = 3usize
    let dynamic_range: Range<usize> = dynamic_start..dynamic_end
    let exclusive_window: [i32] = range_values[range_exclusive]
    let inclusive_window: [i32] = range_values[range_inclusive]
    let dynamic_window: [i32] = range_values[dynamic_range]
    let from_window: [i32] = range_values[range_from]
    let to_window: [i32] = range_values[range_to]
    let to_inclusive_window: [i32] = range_values[range_to_inclusive]
    let full_window: [i32] = range_values[range_full]
    let range_value_metric: i32 =
        exclusive_window[0usize] +
        inclusive_window[3usize] +
        dynamic_window[1usize] +
        from_window[3usize] +
        to_window[2usize] +
        to_inclusive_window[3usize] +
        full_window[4usize]
    var range_eval_ok_order: i32 = 0
    let range_eval_ok_ptr: Ptr<i32>@Valid = &range_eval_ok_order
    var range_eval_ok_raw: *mut i32 =
        unsafe { transmute<Ptr<i32>@Valid, *mut i32>(range_eval_ok_ptr) }
    let range_eval_ok_metric: i32 =
        EvaluateRangeWindowMetric(range_values, range_eval_ok_raw)
    var range_eval_lo_order: i32 = 0
    let range_eval_lo_ptr: Ptr<i32>@Valid = &range_eval_lo_order
    var range_eval_lo_raw: *mut i32 =
        unsafe { transmute<Ptr<i32>@Valid, *mut i32>(range_eval_lo_ptr) }
    let range_eval_lo_metric: i32 = EvaluateRangeControlLoProbe(range_eval_lo_raw)
    var range_eval_hi_order: i32 = 0
    let range_eval_hi_ptr: Ptr<i32>@Valid = &range_eval_hi_order
    var range_eval_hi_raw: *mut i32 =
        unsafe { transmute<Ptr<i32>@Valid, *mut i32>(range_eval_hi_ptr) }
    let range_eval_hi_metric: i32 = EvaluateRangeControlHiProbe(range_eval_hi_raw)
    let runtime_metric: i32 = forms_metric + iteration_metric + bounded_range_metric

    let observed_forms_step: string@View = "observed-range-forms-declaration-metric"
    let observed_iteration_step: string@View = "observed-range-iteration-metric"
    let observed_bounded_step: string@View = "observed-range-to-bounded-metric"
    let observed_runtime_step: string@View = "observed-range-runtime-aggregate-metric"
    let expected_forms: string@View = "6"
    let expected_iteration: string@View = "7"
    let expected_bounded: string@View = "7"
    let expected_runtime: string@View = "20"
    let forms_label: string@View = RangeExpressionMetricLabel(forms_metric)
    let iteration_label: string@View = RangeExpressionMetricLabel(iteration_metric)
    let bounded_label: string@View = RangeExpressionMetricLabel(bounded_range_metric)
    let runtime_label: string@View = RangeExpressionMetricLabel(runtime_metric)
    let forms_passed: bool = forms_metric == 6
    let iteration_passed: bool = iteration_metric == 7
    let bounded_passed: bool = bounded_range_metric == 7
    let range_value_metric_log: i32 =
        range_value_metric
    let range_eval_ok_metric_log: i32 =
        range_eval_ok_metric
    let range_eval_ok_order_log: i32 =
        range_eval_ok_order
    let range_eval_lo_metric_log: i32 =
        range_eval_lo_metric
    let range_eval_lo_order_log: i32 =
        range_eval_lo_order
    let range_eval_hi_metric_log: i32 =
        range_eval_hi_metric
    let range_eval_hi_order_log: i32 =
        range_eval_hi_order
    let range_value_passed: bool = range_value_metric_log == 50
    let range_eval_ok_passed: bool =
        (range_eval_ok_metric_log == 12) &&
        (range_eval_ok_order_log == 12)
    let range_eval_lo_passed: bool =
        (range_eval_lo_metric_log == 17) &&
        (range_eval_lo_order_log == 1)
    let range_eval_hi_passed: bool =
        (range_eval_hi_metric_log == 17) &&
        (range_eval_hi_order_log == 12)
    let range_value_passed_log: bool =
        range_value_passed
    let range_eval_ok_passed_log: bool =
        range_eval_ok_passed
    let range_eval_lo_passed_log: bool =
        range_eval_lo_passed
    let range_eval_hi_passed_log: bool =
        range_eval_hi_passed
    let runtime_passed: bool =
        (runtime_metric == 20) &&
        range_value_passed_log &&
        range_eval_ok_passed_log &&
        range_eval_lo_passed_log &&
        range_eval_hi_passed_log

    let forms_passed_log_actual = forms_label
    let forms_passed_with_log: bool = forms_passed && (forms_passed_log_actual == forms_label)
    let iteration_passed_log_actual = iteration_label
    let iteration_passed_with_log: bool = iteration_passed && (iteration_passed_log_actual == iteration_label)
    let bounded_passed_log_actual = bounded_label
    let bounded_passed_with_log: bool = bounded_passed && (bounded_passed_log_actual == bounded_label)
    let runtime_passed_log_actual = runtime_label
    let runtime_passed_with_log: bool = runtime_passed && (runtime_passed_log_actual == runtime_label)
    if (item_index == 0) {
        return RunRangeExpressionFormsItem(
            ctx,
            scope,
            "RangeExpressionFormsSyntaxForms",
            "exclusive, inclusive, from, to, to-inclusive, and full range syntax forms",
            "validated range-expression syntax forms",
            "range-syntax",
            "evaluate declaration of all range grammar forms",
            "6",
            "6",
            "not-6",
            move forms_passed_with_log,
            "range syntax forms check failed"
        )
    }

    if (item_index == 1) {
        return RunRangeExpressionFormsItem(
            ctx,
            scope,
            "RangeExpressionFormsStaticSemantics",
            "range typing and loop-iterable constraints for exclusive/inclusive forms",
            "validated range-expression static semantics",
            "range-static",
            "type-check range iteration over exclusive and inclusive forms",
            "7",
            "7",
            "not-7",
            move iteration_passed_with_log,
            "range static semantics check failed"
        )
    }

    if (item_index == 2) {
        return RunRangeExpressionFormsItem(
            ctx,
            scope,
            "RangeExpressionFormsRuntimeDiagnostics",
            "range runtime bounds behavior, standalone range-value slicing, and lower/upper bound control propagation",
            "validated range-expression runtime behavior, materialization, and diagnostics",
            "range-runtime",
            "execute full range declaration, standalone value slicing, and panic-catch control paths",
            "20",
            "20",
            "not-20",
            move runtime_passed_with_log,
            "range runtime diagnostics check failed"
        )
    }

    return RunRangeExpressionFormsItem(
        ctx,
        scope,
        move item_name,
        "unknown range-expression operation item",
        "failed unknown range-expression operation item",
        "item-resolution",
        "resolve range-expression operation item name",
        "known-item",
        "known-item",
        "unknown-item",
        false,
        "unknown range-expression operation item"
    )
}

procedure RunRangeExpressionForms(ctx: Context) -> i32 {
    let scope: string@View = "operations::ExpressionSemantics::RangeExpressionForms"
    let checkpoint: string@View = "covered range expression forms operation items"

    let status_syntax: i32 = VerifyRangeExpressionFormsItem(ctx, scope, 0, "RangeExpressionFormsSyntaxForms")
    if (status_syntax != 0) {
        return status_syntax
    }

    let status_static: i32 = VerifyRangeExpressionFormsItem(ctx, scope, 1, "RangeExpressionFormsStaticSemantics")
    if (status_static != 0) {
        return status_static
    }

    let status_runtime: i32 = VerifyRangeExpressionFormsItem(ctx, scope, 2, "RangeExpressionFormsRuntimeDiagnostics")
    if (status_runtime != 0) {
        return status_runtime
    }

    return 0
}
