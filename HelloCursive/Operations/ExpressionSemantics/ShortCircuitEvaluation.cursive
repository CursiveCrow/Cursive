procedure LogShortCircuitObject(
    fs: $FileSystem,
    scope: string@View,
    move object_name: string@View,
    move object_type: string@View,
    move state: string@View,
    move details: string@View
) -> () {
    [[log(label: "operations-log-object")]]
}

procedure ShortCircuitMetricLabel(value: i32) -> string@View {
    if (value == 0) {
        return "0"
    }
    if (value == 1) {
        return "1"
    }
    if (value == 2) {
        return "2"
    }
    if (value == 3) {
        return "3"
    }
    return "other"
}

procedure RunShortCircuitEvaluationItem(
    ctx: Context,
    scope: string@View,
    move item_name: string@View,
    move item_details: string@View,
    move item_reason: string@View,
    move step_name: string@View,
    move step_detail: string@View,
    move expected: string@View,
    move actual_pass: string@View,
    move actual_fail: string@View,
    move passed: bool,
    move failure_reason: string@View
) -> i32 {
    let detail_begin: string@View = "operation feature item exercise start"
    [[log(label: "operations-log-item_begin")]]
    let passed_place: bool = passed
    let item_check_log: bool = [[log(label: "observed-item-check-pass", expected: true)]] passed_place
    let item_check_ok: bool = passed_place && (item_check_log == true)
    if (item_check_ok == false) {
        [[log(label: "operations-log-transition")]]
        [[log(label: "operations-log-item_fail")]]
        return 1
    }

    [[log(label: "operations-log-operations_item_success")]]
    return 0
}

procedure VerifyShortCircuitEvaluationItem(ctx: Context, scope: string@View, move item_index: i32, move item_name: string@View) -> i32 {
    [[log(label: "operations-log-runtime_phase_move")]]
    LogShortCircuitObject(ctx.fs, scope, "short_circuit_and_rhs", "i32", "constructed", "rhs side-effect sentinel for && prepared")
    LogShortCircuitObject(ctx.fs, scope, "short_circuit_or_rhs", "i32", "constructed", "rhs side-effect sentinel for || prepared")

    [[log(label: "operations-log-runtime_phase_move")]]
    var and_rhs_effect: i32 = 0
    var or_rhs_effect: i32 = 0

    [[log(label: "operations-log-transition_move")]]
    let and_result: bool = false && {
        and_rhs_effect = 1
        true
    }
    [[log(label: "operations-log-transition_move")]]
    [[log(label: "operations-log-transition_move")]]
    let or_result: bool = true || {
        or_rhs_effect = 1
        false
    }
    [[log(label: "operations-log-transition_move")]]
    let and_guard_metric: i32 = if (and_result == false) { 1 } else { 0 }
    let or_guard_metric: i32 = if (or_result == true) { 1 } else { 0 }
    let effect_metric: i32 = and_rhs_effect + or_rhs_effect
    let runtime_metric: i32 = and_guard_metric + or_guard_metric + effect_metric

    let observed_effect_step: string@View = "observed-short-circuit-rhs-effect-metric"
    let observed_guard_step: string@View = "observed-short-circuit-guard-metric"
    let observed_runtime_step: string@View = "observed-short-circuit-runtime-aggregate-metric"
    let expected_effect: string@View = "0"
    let expected_guard: string@View = "2"
    let expected_runtime: string@View = "2"
    let effect_label: string@View = ShortCircuitMetricLabel(effect_metric)
    let guard_metric: i32 = and_guard_metric + or_guard_metric
    let guard_label: string@View = ShortCircuitMetricLabel(guard_metric)
    let runtime_label: string@View = ShortCircuitMetricLabel(runtime_metric)
    let effect_passed: bool = effect_metric == 0
    let guard_passed: bool = guard_metric == 2
    let runtime_passed: bool = runtime_metric == 2

    let effect_passed_log_actual = [[log(label: "observed-short-circuit-rhs-effect-metric", expected: "0")]] effect_label
    let effect_passed_with_log: bool = effect_passed && (effect_passed_log_actual == effect_label)
    let guard_passed_log_actual = [[log(label: "observed-short-circuit-guard-metric", expected: "2")]] guard_label
    let guard_passed_with_log: bool = guard_passed && (guard_passed_log_actual == guard_label)
    let runtime_passed_log_actual = [[log(label: "observed-short-circuit-runtime-aggregate-metric", expected: "2")]] runtime_label
    let runtime_passed_with_log: bool = runtime_passed && (runtime_passed_log_actual == runtime_label)
    [[log(label: "operations-log-runtime_phase_move")]]
    if (item_index == 0) {
        return RunShortCircuitEvaluationItem(
            ctx,
            scope,
            "ShortCircuitEvaluationSyntaxForms",
            "logical-and and logical-or syntax with block rhs forms",
            "validated short-circuit syntax forms",
            "short-circuit-syntax",
            "evaluate && and || syntax with side-effectful rhs block expressions",
            "0",
            "0",
            "not-0",
            move effect_passed_with_log,
            "short-circuit syntax forms check failed"
        )
    }

    if (item_index == 1) {
        return RunShortCircuitEvaluationItem(
            ctx,
            scope,
            "ShortCircuitEvaluationStaticSemantics",
            "boolean operator typing and block-tail typing in short-circuit contexts",
            "validated short-circuit static semantics",
            "short-circuit-static",
            "type-check logical short-circuit expressions and bool result guards",
            "2",
            "2",
            "not-2",
            move guard_passed_with_log,
            "short-circuit static semantics check failed"
        )
    }

    if (item_index == 2) {
        return RunShortCircuitEvaluationItem(
            ctx,
            scope,
            "ShortCircuitEvaluationRuntimeDiagnostics",
            "runtime short-circuit behavior that suppresses rhs side effects",
            "validated short-circuit runtime behavior and diagnostics",
            "short-circuit-runtime",
            "execute short-circuit runtime path and verify rhs suppression",
            "2",
            "2",
            "not-2",
            move runtime_passed_with_log,
            "short-circuit runtime diagnostics check failed"
        )
    }

    return RunShortCircuitEvaluationItem(
        ctx,
        scope,
        move item_name,
        "unknown short-circuit operation item",
        "failed unknown short-circuit operation item",
        "item-resolution",
        "resolve short-circuit operation item name",
        "known-item",
        "known-item",
        "unknown-item",
        false,
        "unknown short-circuit operation item"
    )
}

procedure RunShortCircuitEvaluation(ctx: Context) -> i32 {
    let scope: string@View = "operations::ExpressionSemantics::ShortCircuitEvaluation"
    let checkpoint: string@View = "covered short circuit evaluation operation items"

    let status_syntax: i32 = VerifyShortCircuitEvaluationItem(ctx, scope, 0, "ShortCircuitEvaluationSyntaxForms")
    if (status_syntax != 0) {
        return status_syntax
    }

    let status_static: i32 = VerifyShortCircuitEvaluationItem(ctx, scope, 1, "ShortCircuitEvaluationStaticSemantics")
    if (status_static != 0) {
        return status_static
    }

    let status_runtime: i32 = VerifyShortCircuitEvaluationItem(ctx, scope, 2, "ShortCircuitEvaluationRuntimeDiagnostics")
    if (status_runtime != 0) {
        return status_runtime
    }

    [[log(label: "operations-log-checkpoint")]]
    return 0
}
