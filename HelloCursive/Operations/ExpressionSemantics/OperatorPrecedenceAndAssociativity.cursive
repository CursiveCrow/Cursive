procedure LogOperatorPrecedenceObject(
    fs: $FileSystem,
    scope: string@View,
    move object_name: string@View,
    move object_type: string@View,
    move state: string@View,
    move details: string@View
) -> () {
    [[log(label: "operations-log-object")]]
}

procedure OperatorPrecedenceMetricLabel(value: i32) -> string@View {
    if (value == 1) {
        return "1"
    }
    if (value == 2) {
        return "2"
    }
    if (value == 3) {
        return "3"
    }
    if (value == 4) {
        return "4"
    }
    if (value == 5) {
        return "5"
    }
    if (value == 6) {
        return "6"
    }
    if (value == 7) {
        return "7"
    }
    if (value == 8) {
        return "8"
    }
    if (value == 9) {
        return "9"
    }
    if (value == 12) {
        return "12"
    }
    if (value == 23) {
        return "23"
    }
    if (value == 512) {
        return "512"
    }
    if (value == 549) {
        return "549"
    }
    if (value == 580) {
        return "580"
    }
    return "other"
}

procedure RunOperatorPrecedenceAndAssociativityItem(
    ctx: Context,
    scope: string@View,
    move item_name: string@View,
    move item_details: string@View,
    move item_reason: string@View,
    move step_name: string@View,
    move step_detail: string@View,
    move expected: string@View,
    move actual_pass: string@View,
    move actual_fail: string@View,
    move passed: bool,
    move failure_reason: string@View
) -> i32 {
    let detail_begin: string@View = "operation feature item exercise start"
    [[log(label: "operations-log-item_begin")]]
    let passed_place: bool = passed
    let item_check_log: bool = [[log(label: "observed-item-check-pass", expected: true)]] passed_place
    let item_check_ok: bool = passed_place && (item_check_log == true)
    if (item_check_ok == false) {
        [[log(label: "operations-log-transition")]]
        [[log(label: "operations-log-item_fail")]]
        return 1
    }

    [[log(label: "operations-log-operations_item_success")]]
    return 0
}

procedure VerifyOperatorPrecedenceAndAssociativityItem(ctx: Context, scope: string@View, move item_index: i32, move item_name: string@View) -> i32 {
    [[log(label: "operations-log-runtime_phase_move")]]
    LogOperatorPrecedenceObject(ctx.fs, scope, "precedence_expr", "i32", "constructed", "multiplicative-over-additive precedence expression prepared")
    LogOperatorPrecedenceObject(ctx.fs, scope, "bitwise_expr", "i32", "constructed", "bit-and over bit-or precedence expression prepared")
    LogOperatorPrecedenceObject(ctx.fs, scope, "associativity_expr", "i32", "constructed", "left-associative subtraction and right-associative power expressions prepared")
    LogOperatorPrecedenceObject(ctx.fs, scope, "shift_expr", "i32", "constructed", "shift operator precedence expression set prepared")
    LogOperatorPrecedenceObject(ctx.fs, scope, "comparison_expr", "i32", "constructed", "full comparison-operator set expression prepared")
    LogOperatorPrecedenceObject(ctx.fs, scope, "unary_expr", "i32", "constructed", "unary logical/arithmetic/bitwise expression set prepared")

    [[log(label: "operations-log-runtime_phase_move")]]
    [[log(label: "operations-log-transition_move")]]
    let precedence_metric: i32 = 1 + (2 * 3)
    let grouped_metric: i32 = (1 + 2) * 3
    let mod_metric: i32 = 17 % 5
    [[log(label: "operations-log-transition_move")]]
    [[log(label: "operations-log-transition_move")]]
    let bitwise_metric: i32 = 5 | (2 & 1)
    [[log(label: "operations-log-transition_move")]]
    [[log(label: "operations-log-transition_move")]]
    let associativity_metric: i32 = (8 - 3) - 2
    let power_metric: i32 = 2 ** 3 ** 2
    let div_metric: i32 = 17 / 5
    [[log(label: "operations-log-transition_move")]]
    [[log(label: "operations-log-transition_move")]]
    let shift_left_metric: i32 = (1 + 2) << (2 as u32)
    let shift_right_metric: i32 = 32 >> (2 as u32)
    let xor_metric: i32 = 5 ^ 3
    [[log(label: "operations-log-transition_move")]]
    [[log(label: "operations-log-transition_move")]]
    let cmp_lt: i32 = if (2 < 3) { 1 } else { 0 }
    let cmp_le: i32 = if (3 <= 3) { 1 } else { 0 }
    let cmp_gt: i32 = if (4 > 3) { 1 } else { 0 }
    let cmp_ge: i32 = if (4 >= 4) { 1 } else { 0 }
    let cmp_eq: i32 = if (5 == 5) { 1 } else { 0 }
    let cmp_ne: i32 = if (5 != 4) { 1 } else { 0 }
    let comparison_metric: i32 = cmp_lt + cmp_le + cmp_gt + cmp_ge + cmp_eq + cmp_ne
    [[log(label: "operations-log-transition_move")]]
    [[log(label: "operations-log-transition_move")]]
    let unary_neg_metric: i32 = -5 + 9
    let unary_not_metric: i32 = if (!false) { 1 } else { 0 }
    let unary_int_not_metric: i32 = if ((!0) == -1) { 1 } else { 0 }
    [[log(label: "operations-log-transition_move")]]
    let logical_metric: i32 = if (((1 + (2 * 3)) == 7) && ((9 > 3) || false)) { 1 } else { 0 }

    let syntax_metric: i32 = precedence_metric + grouped_metric + bitwise_metric + mod_metric
    let static_metric: i32 = associativity_metric + shift_left_metric + shift_right_metric + xor_metric + power_metric + div_metric + unary_neg_metric + unary_int_not_metric
    let runtime_metric: i32 = syntax_metric + static_metric + logical_metric + comparison_metric + unary_not_metric

    let precedence_label: string@View = OperatorPrecedenceMetricLabel(precedence_metric)
    let grouping_label: string@View = OperatorPrecedenceMetricLabel(grouped_metric)
    let mod_label: string@View = OperatorPrecedenceMetricLabel(mod_metric)
    let bitwise_label: string@View = OperatorPrecedenceMetricLabel(bitwise_metric)
    let associativity_label: string@View = OperatorPrecedenceMetricLabel(associativity_metric)
    let div_label: string@View = OperatorPrecedenceMetricLabel(div_metric)
    let shift_left_label: string@View = OperatorPrecedenceMetricLabel(shift_left_metric)
    let shift_right_label: string@View = OperatorPrecedenceMetricLabel(shift_right_metric)
    let xor_label: string@View = OperatorPrecedenceMetricLabel(xor_metric)
    let power_label: string@View = OperatorPrecedenceMetricLabel(power_metric)
    let logical_label: string@View = OperatorPrecedenceMetricLabel(logical_metric)
    let comparison_label: string@View = OperatorPrecedenceMetricLabel(comparison_metric)
    let unary_neg_label: string@View = OperatorPrecedenceMetricLabel(unary_neg_metric)
    let unary_not_label: string@View = OperatorPrecedenceMetricLabel(unary_not_metric)
    let unary_int_not_label: string@View = OperatorPrecedenceMetricLabel(unary_int_not_metric)
    let syntax_label: string@View = OperatorPrecedenceMetricLabel(syntax_metric)
    let static_label: string@View = OperatorPrecedenceMetricLabel(static_metric)
    let runtime_label: string@View = OperatorPrecedenceMetricLabel(runtime_metric)

    let precedence_passed: bool = precedence_metric == 7
    let grouping_passed: bool = grouped_metric == 9
    let mod_passed: bool = mod_metric == 2
    let bitwise_passed: bool = bitwise_metric == 5
    let associativity_passed: bool = associativity_metric == 3
    let div_passed: bool = div_metric == 3
    let shift_left_passed: bool = shift_left_metric == 12
    let shift_right_passed: bool = shift_right_metric == 8
    let xor_passed: bool = xor_metric == 6
    let power_passed: bool = power_metric == 512
    let logical_passed: bool = logical_metric == 1
    let comparison_passed: bool = comparison_metric == 6
    let unary_neg_passed: bool = unary_neg_metric == 4
    let unary_not_passed: bool = unary_not_metric == 1
    let unary_int_not_passed: bool = unary_int_not_metric == 1

    let syntax_passed: bool = precedence_passed && grouping_passed && mod_passed && bitwise_passed && syntax_metric == 23
    let static_passed: bool = associativity_passed && div_passed && shift_left_passed && shift_right_passed && xor_passed && power_passed && unary_neg_passed && unary_int_not_passed && static_metric == 549
    let runtime_passed: bool = logical_passed && comparison_passed && unary_not_passed && runtime_metric == 580

    let precedence_passed_log_actual = [[log(label: "observed-precedence-metric", expected: "7")]] precedence_label
    let precedence_passed_with_log: bool = precedence_passed && (precedence_passed_log_actual == precedence_label)
    let grouping_passed_log_actual = [[log(label: "observed-grouped-precedence-metric", expected: "9")]] grouping_label
    let grouping_passed_with_log: bool = grouping_passed && (grouping_passed_log_actual == grouping_label)
    let mod_passed_log_actual = [[log(label: "observed-modulo-metric", expected: "2")]] mod_label
    let mod_passed_with_log: bool = mod_passed && (mod_passed_log_actual == mod_label)
    let bitwise_passed_log_actual = [[log(label: "observed-bitwise-precedence-metric", expected: "5")]] bitwise_label
    let bitwise_passed_with_log: bool = bitwise_passed && (bitwise_passed_log_actual == bitwise_label)
    let associativity_passed_log_actual = [[log(label: "observed-associativity-metric", expected: "3")]] associativity_label
    let associativity_passed_with_log: bool = associativity_passed && (associativity_passed_log_actual == associativity_label)
    let div_passed_log_actual = [[log(label: "observed-division-metric", expected: "3")]] div_label
    let div_passed_with_log: bool = div_passed && (div_passed_log_actual == div_label)
    let shift_left_passed_log_actual = [[log(label: "observed-shift-left-metric", expected: "12")]] shift_left_label
    let shift_left_passed_with_log: bool = shift_left_passed && (shift_left_passed_log_actual == shift_left_label)
    let shift_right_passed_log_actual = [[log(label: "observed-shift-right-metric", expected: "8")]] shift_right_label
    let shift_right_passed_with_log: bool = shift_right_passed && (shift_right_passed_log_actual == shift_right_label)
    let xor_passed_log_actual = [[log(label: "observed-xor-metric", expected: "6")]] xor_label
    let xor_passed_with_log: bool = xor_passed && (xor_passed_log_actual == xor_label)
    let power_passed_log_actual = [[log(label: "observed-power-right-associative-metric", expected: "512")]] power_label
    let power_passed_with_log: bool = power_passed && (power_passed_log_actual == power_label)
    let logical_passed_log_actual = [[log(label: "observed-logical-precedence-metric", expected: "1")]] logical_label
    let logical_passed_with_log: bool = logical_passed && (logical_passed_log_actual == logical_label)
    let comparison_passed_log_actual = [[log(label: "observed-comparison-family-metric", expected: "6")]] comparison_label
    let comparison_passed_with_log: bool = comparison_passed && (comparison_passed_log_actual == comparison_label)
    let unary_neg_passed_log_actual = [[log(label: "observed-unary-negation-metric", expected: "4")]] unary_neg_label
    let unary_neg_passed_with_log: bool = unary_neg_passed && (unary_neg_passed_log_actual == unary_neg_label)
    let unary_not_passed_log_actual = [[log(label: "observed-unary-not-metric", expected: "1")]] unary_not_label
    let unary_not_passed_with_log: bool = unary_not_passed && (unary_not_passed_log_actual == unary_not_label)
    let unary_int_not_passed_log_actual = [[log(label: "observed-unary-int-not-metric", expected: "1")]] unary_int_not_label
    let unary_int_not_passed_with_log: bool = unary_int_not_passed && (unary_int_not_passed_log_actual == unary_int_not_label)
    let syntax_passed_log_actual = [[log(label: "observed-operator-syntax-aggregate-metric", expected: "23")]] syntax_label
    let syntax_passed_with_log: bool = syntax_passed && (syntax_passed_log_actual == syntax_label)
    let static_passed_log_actual = [[log(label: "observed-operator-static-aggregate-metric", expected: "549")]] static_label
    let static_passed_with_log: bool = static_passed && (static_passed_log_actual == static_label)
    let runtime_passed_log_actual = [[log(label: "observed-operator-runtime-aggregate-metric", expected: "580")]] runtime_label
    let runtime_passed_with_log: bool = runtime_passed && (runtime_passed_log_actual == runtime_label)
    [[log(label: "operations-log-runtime_phase_move")]]
    if (item_index == 0) {
        return RunOperatorPrecedenceAndAssociativityItem(
            ctx,
            scope,
            "OperatorPrecedenceAndAssociativitySyntaxForms",
            "infix operator syntax forms and explicit grouping with arithmetic/bitwise precedence",
            "validated operator precedence syntax forms",
            "operator-syntax",
            "evaluate additive/multiplicative grouping, modulo, and bitwise precedence",
            "23",
            "23",
            "not-23",
            move syntax_passed_with_log,
            "operator precedence syntax forms check failed"
        )
    }

    if (item_index == 1) {
        return RunOperatorPrecedenceAndAssociativityItem(
            ctx,
            scope,
            "OperatorPrecedenceAndAssociativityStaticSemantics",
            "typing and associativity across subtraction, division, shifts, xor, power, and unary forms",
            "validated operator precedence static semantics",
            "operator-static",
            "type-check and evaluate subtraction associativity, division, shifts, xor, exponentiation, unary negation, and int unary-not",
            "549",
            "549",
            "not-549",
            move static_passed_with_log,
            "operator precedence static semantics check failed"
        )
    }

    if (item_index == 2) {
        return RunOperatorPrecedenceAndAssociativityItem(
            ctx,
            scope,
            "OperatorPrecedenceAndAssociativityRuntimeDiagnostics",
            "runtime precedence evaluation across arithmetic/bitwise/logical/comparison/unary chains",
            "validated operator precedence runtime behavior and diagnostics",
            "operator-runtime",
            "execute full precedence/associativity path including comparison and unary families",
            "580",
            "580",
            "not-580",
            move runtime_passed_with_log,
            "operator precedence runtime diagnostics check failed"
        )
    }

    return RunOperatorPrecedenceAndAssociativityItem(
        ctx,
        scope,
        move item_name,
        "unknown operator-precedence operation item",
        "failed unknown operator-precedence operation item",
        "item-resolution",
        "resolve operator-precedence operation item name",
        "known-item",
        "known-item",
        "unknown-item",
        false,
        "unknown operator-precedence operation item"
    )
}

procedure RunOperatorPrecedenceAndAssociativity(ctx: Context) -> i32 {
    let scope: string@View = "operations::ExpressionSemantics::OperatorPrecedenceAndAssociativity"
    let checkpoint: string@View = "covered operator precedence and associativity operation items"

    let status_syntax: i32 = VerifyOperatorPrecedenceAndAssociativityItem(ctx, scope, 0, "OperatorPrecedenceAndAssociativitySyntaxForms")
    if (status_syntax != 0) {
        return status_syntax
    }

    let status_static: i32 = VerifyOperatorPrecedenceAndAssociativityItem(ctx, scope, 1, "OperatorPrecedenceAndAssociativityStaticSemantics")
    if (status_static != 0) {
        return status_static
    }

    let status_runtime: i32 = VerifyOperatorPrecedenceAndAssociativityItem(ctx, scope, 2, "OperatorPrecedenceAndAssociativityRuntimeDiagnostics")
    if (status_runtime != 0) {
        return status_runtime
    }

    [[log(label: "operations-log-checkpoint")]]
    return 0
}
