import testsupport

public procedure runCompileChecks(ctx: Context) -> i32 {
    let command: string@View =
        "cmd.exe /C %CURSIVE_COMPILER_UNDER_TEST% --incremental off --check --diag-json ..\\TestProjects\\Source\\TrailingCommaSingleLine\\Main.cursive > build\\main\\logs\\compile_checks\\source_trailing_comma_single_line.json 2> build\\main\\logs\\compile_checks\\source_trailing_comma_single_line.stderr & if errorlevel 2 exit /b 1 & if not errorlevel 1 exit /b 1 & findstr /C:\"\\\"E-SRC-0521\\\"\" build\\main\\logs\\compile_checks\\source_trailing_comma_single_line.json >nul"
    return testsupport::runCompileCheckCommand(ctx, command, "source/trailing_comma_single_line")
}
