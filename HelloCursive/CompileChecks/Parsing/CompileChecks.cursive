import testsupport

procedure runExternTerminatorRequired(ctx: Context) -> i32 {
    let command: string@View =
        "cmd.exe /C %CURSIVE_COMPILER_UNDER_TEST% --incremental off --check --diag-json --quiet ..\\TestProjects\\Parsing\\ExternTerminatorRequired\\Main.cursive > build\\main\\logs\\compile_checks\\parsing_extern_terminator_required.json 2> build\\main\\logs\\compile_checks\\parsing_extern_terminator_required.stderr & if errorlevel 2 exit /b 1 & if not errorlevel 1 exit /b 1 & findstr /C:\"\\\"E-SRC-0510\\\"\" build\\main\\logs\\compile_checks\\parsing_extern_terminator_required.json >nul"
    return testsupport::runCompileCheckCommand(ctx, command, "parsing/extern_terminator_required")
}

procedure runPredicateReqPairTrace(ctx: Context) -> i32 {
    let command: string@View =
        "cmd.exe /C %CURSIVE_COMPILER_UNDER_TEST% --incremental off --phase1-only --diag-json --quiet --conformance parse_predicate_req_pair_trace.log ..\\TestProjects\\Parsing\\Generated\\parse_predicate_req_tail_trace\\Main.cursive > build\\main\\logs\\compile_checks\\parse_predicate_req_pair_trace.json 2> build\\main\\logs\\compile_checks\\parse_predicate_req_pair_trace.stderr & if errorlevel 1 exit /b 1 & findstr /R /C:\"PredicateReq.*fields.*pred,type.*pred.*Bitcopy.*type.*TypePath:T\" ..\\TestProjects\\Parsing\\Generated\\parse_predicate_req_tail_trace\\build\\probe\\logs\\conformance\\parse_predicate_req_pair_trace.log >nul & if errorlevel 1 exit /b 1 & findstr /R /C:\"PredicateReq.*fields.*pred,type.*pred.*Clone.*type.*TypeApply:probe::predicatetaildep::ExternalBox\" ..\\TestProjects\\Parsing\\Generated\\parse_predicate_req_tail_trace\\build\\probe\\logs\\conformance\\parse_predicate_req_pair_trace.log >nul"
    return testsupport::runCompileCheckCommand(ctx, command, "parse_predicate_req_pair_trace")
}

procedure runPredicateReqPairInvalidRejected(ctx: Context) -> i32 {
    let command: string@View =
        "cmd.exe /C %CURSIVE_COMPILER_UNDER_TEST% --incremental off --phase1-only --diag-json --quiet --conformance parse_predicate_req_pair_invalid_rejected.log ..\\TestProjects\\Parsing\\Generated\\parse_predicate_req_pair_invalid_rejected\\Main.cursive > build\\main\\logs\\compile_checks\\parse_predicate_req_pair_invalid_rejected.json 2> build\\main\\logs\\compile_checks\\parse_predicate_req_pair_invalid_rejected.stderr & if errorlevel 2 exit /b 1 & if not errorlevel 1 exit /b 1 & findstr /C:\"\\\"E-SRC-0520\\\"\" build\\main\\logs\\compile_checks\\parse_predicate_req_pair_invalid_rejected.json >nul & if errorlevel 1 exit /b 1 & findstr /R /C:\"Parse-PredicateReq-Err.*PredicateReq.*fields.*pred,type.*pred.*Copyish.*type.*TypePrim:!\" ..\\TestProjects\\Parsing\\Generated\\parse_predicate_req_pair_invalid_rejected\\build\\probe\\logs\\conformance\\parse_predicate_req_pair_invalid_rejected.log >nul"
    return testsupport::runCompileCheckCommand(ctx, command, "parse_predicate_req_pair_invalid_rejected")
}

public procedure runCompileChecks(ctx: Context) -> i32 {
    let extern_status: i32 = runExternTerminatorRequired(ctx)
    if (extern_status != 0) {
        return extern_status
    }

    let pair_trace_status: i32 = runPredicateReqPairTrace(ctx)
    if (pair_trace_status != 0) {
        return pair_trace_status
    }

    return runPredicateReqPairInvalidRejected(ctx)
}
