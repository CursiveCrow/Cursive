import testsupport

public procedure runCompileChecks(ctx: Context) -> i32 {
    let command: string@View =
        "cmd.exe /C %CURSIVE_COMPILER_UNDER_TEST% --incremental off --check --diag-json --quiet ..\\TestProjects\\Attributes\\FfiAttributes\\UnknownExternVerificationAttr\\Main.cursive > build\\main\\logs\\compile_checks\\attributes_ffi_unknown_extern_verification_attr.json 2> build\\main\\logs\\compile_checks\\attributes_ffi_unknown_extern_verification_attr.stderr & if errorlevel 2 exit /b 1 & if not errorlevel 1 exit /b 1 & findstr /C:\"\\\"E-MOD-2451\\\"\" build\\main\\logs\\compile_checks\\attributes_ffi_unknown_extern_verification_attr.json >nul"
    return testsupport::runCompileCheckCommand(ctx, command, "attributes/ffi/unknown_extern_verification_attr")
}
