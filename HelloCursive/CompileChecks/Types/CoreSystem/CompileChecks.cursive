import testsupport

public procedure runCompileChecks(ctx: Context) -> i32 {
    let command: string@View =
        "cmd.exe /C %CURSIVE_COMPILER_UNDER_TEST% --incremental off --check --diag-json --quiet ..\\TestProjects\\Types\\CoreSystem\\ExplicitFloatSuffixMismatch\\Main.cursive > build\\main\\logs\\compile_checks\\types_core_explicit_float_suffix_mismatch.json 2> build\\main\\logs\\compile_checks\\types_core_explicit_float_suffix_mismatch.stderr & if errorlevel 2 exit /b 1 & if not errorlevel 1 exit /b 1 & findstr /C:\"\\\"E-TYP-1531\\\"\" build\\main\\logs\\compile_checks\\types_core_explicit_float_suffix_mismatch.json >nul"
    let status: i32 = testsupport::runCompileCheckCommand(ctx, command, "types/core/explicit_float_suffix_mismatch")
    if (status != 0) {
        return status
    }

    let modal_ref_path_command: string@View =
        "cmd.exe /C %CURSIVE_COMPILER_UNDER_TEST% --incremental off --check --diag-json --quiet --conformance issue980_modal_ref_path_type_path.log ..\\TestProjects\\Types\\CoreSystem\\Generated\\issue980_modal_ref_path_type_path\\Main.cursive > build\\main\\logs\\compile_checks\\issue980_modal_ref_path_type_path.json 2> build\\main\\logs\\compile_checks\\issue980_modal_ref_path_type_path.stderr & if errorlevel 1 exit /b 1 & findstr /C:\"ModalRefPath(TypePath(p))\" ..\\TestProjects\\Types\\CoreSystem\\Generated\\issue980_modal_ref_path_type_path\\build\\probe\\logs\\conformance\\issue980_modal_ref_path_type_path.log >nul & if errorlevel 1 exit /b 1 & findstr /C:\"ModalRefArgs(TypePath(_))\" ..\\TestProjects\\Types\\CoreSystem\\Generated\\issue980_modal_ref_path_type_path\\build\\probe\\logs\\conformance\\issue980_modal_ref_path_type_path.log >nul"
    let modal_ref_path_status: i32 = testsupport::runCompileCheckCommand(ctx, modal_ref_path_command, "issue980_modal_ref_path_type_path")
    if (modal_ref_path_status != 0) {
        return modal_ref_path_status
    }

    let modal_ref_apply_path_command: string@View =
        "cmd.exe /C %CURSIVE_COMPILER_UNDER_TEST% --incremental off --check --diag-json --quiet --conformance issue981_modal_ref_path_type_apply.log ..\\TestProjects\\Types\\CoreSystem\\Generated\\issue981_modal_ref_path_type_apply\\Main.cursive > build\\main\\logs\\compile_checks\\issue981_modal_ref_path_type_apply.json 2> build\\main\\logs\\compile_checks\\issue981_modal_ref_path_type_apply.stderr & if errorlevel 1 exit /b 1 & findstr /C:\"ModalRefPath(TypeApply(p, _))\" ..\\TestProjects\\Types\\CoreSystem\\Generated\\issue981_modal_ref_path_type_apply\\build\\probe\\logs\\conformance\\issue981_modal_ref_path_type_apply.log >nul & if errorlevel 1 exit /b 1 & findstr /C:\"ModalRefArgs(TypeApply(_, args))\" ..\\TestProjects\\Types\\CoreSystem\\Generated\\issue981_modal_ref_path_type_apply\\build\\probe\\logs\\conformance\\issue981_modal_ref_path_type_apply.log >nul"
    return testsupport::runCompileCheckCommand(ctx, modal_ref_apply_path_command, "issue981_modal_ref_path_type_apply")
}
