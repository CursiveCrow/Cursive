import testsupport

public procedure runCompileChecks(ctx: Context) -> i32 {
    let command: string@View =
        "cmd.exe /C %CURSIVE_COMPILER_UNDER_TEST% --incremental off --check --diag-json --quiet ..\\TestProjects\\Types\\CoreSystem\\ExplicitFloatSuffixMismatch\\Main.cursive > build\\main\\logs\\compile_checks\\types_core_explicit_float_suffix_mismatch.json 2> build\\main\\logs\\compile_checks\\types_core_explicit_float_suffix_mismatch.stderr & if errorlevel 2 exit /b 1 & if not errorlevel 1 exit /b 1 & findstr /C:\"\\\"E-TYP-1531\\\"\" build\\main\\logs\\compile_checks\\types_core_explicit_float_suffix_mismatch.json >nul"
    return testsupport::runCompileCheckCommand(ctx, command, "types/core/explicit_float_suffix_mismatch")
}
