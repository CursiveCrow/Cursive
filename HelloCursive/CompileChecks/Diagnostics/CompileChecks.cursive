import testsupport

procedure runInvalidCastCode(ctx: Context) -> i32 {
    let command: string@View =
        "cmd.exe /C %CURSIVE_COMPILER_UNDER_TEST% --incremental off --check --diag-json ..\\TestProjects\\Diagnostics\\InvalidCastCode\\Main.cursive > build\\main\\logs\\compile_checks\\diagnostics_invalid_cast_code.json 2> build\\main\\logs\\compile_checks\\diagnostics_invalid_cast_code.stderr & if errorlevel 2 exit /b 1 & if not errorlevel 1 exit /b 1 & findstr /C:\"\\\"E-SEM-2528\\\"\" build\\main\\logs\\compile_checks\\diagnostics_invalid_cast_code.json >nul"
    return testsupport::runCompileCheckCommand(ctx, command, "diagnostics/invalid_cast_code")
}

procedure runMoveImmovableAlias(ctx: Context) -> i32 {
    let command: string@View =
        "cmd.exe /C %CURSIVE_COMPILER_UNDER_TEST% --incremental off --check --diag-json ..\\TestProjects\\Diagnostics\\MoveImmovableAlias\\Cursive.toml > build\\main\\logs\\compile_checks\\diagnostics_move_immovable_alias.json 2> build\\main\\logs\\compile_checks\\diagnostics_move_immovable_alias.stderr & if errorlevel 2 exit /b 1 & if not errorlevel 1 exit /b 1 & findstr /C:\"\\\"E-MEM-3006\\\"\" build\\main\\logs\\compile_checks\\diagnostics_move_immovable_alias.json >nul & findstr /C:\"unknown diagnostic id\" build\\main\\logs\\compile_checks\\diagnostics_move_immovable_alias.json >nul && exit /b 1 || exit /b 0"
    return testsupport::runCompileCheckCommand(ctx, command, "diagnostics/move_immovable_alias")
}

public procedure runCompileChecks(ctx: Context) -> i32 {
    let invalid_cast_status: i32 = runInvalidCastCode(ctx)
    if (invalid_cast_status != 0) {
        return invalid_cast_status
    }

    return runMoveImmovableAlias(ctx)
}
