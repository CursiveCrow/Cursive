import testsupport

public procedure runCompileChecks(ctx: Context) -> i32 {
    let command: string@View =
        "cmd.exe /C %CURSIVE_COMPILER_UNDER_TEST% --incremental off --check --diag-json --quiet ..\\TestProjects\\Diagnostics\\InvalidCastCode\\Main.cursive > build\\main\\logs\\compile_checks\\diagnostics_invalid_cast_code.json 2> build\\main\\logs\\compile_checks\\diagnostics_invalid_cast_code.stderr & if errorlevel 2 exit /b 1 & if not errorlevel 1 exit /b 1 & findstr /C:\"\\\"E-SEM-2528\\\"\" build\\main\\logs\\compile_checks\\diagnostics_invalid_cast_code.json >nul"
    return testsupport::runCompileCheckCommand(ctx, command, "diagnostics/invalid_cast_code")
}
