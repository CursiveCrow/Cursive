import testsupport

public procedure runCompileChecks(ctx: Context) -> i32 {
    let command: string@View =
        "cmd.exe /C %CURSIVE_COMPILER_UNDER_TEST% --incremental off --check --diag-json --quiet ..\\TestProjects\\Modals\\Diagnostics\\ModalNoStates\\Main.cursive > build\\main\\logs\\compile_checks\\modals_diagnostics_modal_no_states.json 2> build\\main\\logs\\compile_checks\\modals_diagnostics_modal_no_states.stderr & if errorlevel 2 exit /b 1 & if not errorlevel 1 exit /b 1 & findstr /C:\"\\\"E-TYP-2050\\\"\" build\\main\\logs\\compile_checks\\modals_diagnostics_modal_no_states.json >nul"
    let status_seed: i32 =
        testsupport::runCompileCheckCommand(ctx, command, "modals/diagnostics/modal_no_states")
    if (status_seed != 0) {
        return status_seed
    }

    let modal_ref_apply_command: string@View =
        "cmd.exe /C %CURSIVE_COMPILER_UNDER_TEST% --incremental off --check --diag-json --quiet --conformance modal_ref_type_apply.log ..\\TestProjects\\Modals\\Diagnostics\\ModalRefTypeApplyConformance\\Main.cursive > build\\main\\logs\\compile_checks\\modal_ref_type_apply.json 2> build\\main\\logs\\compile_checks\\modal_ref_type_apply.stderr & if errorlevel 1 exit /b 1 & findstr /C:\"result\" ..\\TestProjects\\Modals\\Diagnostics\\ModalRefTypeApplyConformance\\build\\probe\\logs\\conformance\\modal_ref_type_apply.log >nul"
    let modal_ref_apply_status: i32 = testsupport::runCompileCheckCommand(
        ctx,
        modal_ref_apply_command,
        "modals/diagnostics/modal_ref_type_apply_conformance"
    )
    if (modal_ref_apply_status != 0) {
        return modal_ref_apply_status
    }

    let modal_ref_subst_default_command: string@View =
        "cmd.exe /C %CURSIVE_COMPILER_UNDER_TEST% --incremental off --check --diag-json --quiet --conformance issue987_modal_ref_subst_default.log ..\\TestProjects\\Modals\\Diagnostics\\Generated\\issue987_modal_ref_subst_default\\Main.cursive > build\\main\\logs\\compile_checks\\issue987_modal_ref_subst_default.json 2> build\\main\\logs\\compile_checks\\issue987_modal_ref_subst_default.stderr & if errorlevel 1 exit /b 1 & findstr /C:\"ModalRefSubst\" ..\\TestProjects\\Modals\\Diagnostics\\Generated\\issue987_modal_ref_subst_default\\build\\probe\\logs\\conformance\\issue987_modal_ref_subst_default.log >nul"
    let modal_ref_subst_default_status: i32 = testsupport::runCompileCheckCommand(
        ctx,
        modal_ref_subst_default_command,
        "modals/diagnostics/issue987_modal_ref_subst_default"
    )
    if (modal_ref_subst_default_status != 0) {
        return modal_ref_subst_default_status
    }

    let modal_decl_of_command: string@View =
        "cmd.exe /C %CURSIVE_COMPILER_UNDER_TEST% --incremental off --check --diag-json --quiet --conformance issue986_modal_decl_of_direct.log ..\\TestProjects\\Modals\\Diagnostics\\Generated\\issue986_modal_decl_of_direct\\Main.cursive > build\\main\\logs\\compile_checks\\issue986_modal_decl_of_direct.json 2> build\\main\\logs\\compile_checks\\issue986_modal_decl_of_direct.stderr & if errorlevel 1 exit /b 1 & findstr /C:\"ModalDeclOf\" ..\\TestProjects\\Modals\\Diagnostics\\Generated\\issue986_modal_decl_of_direct\\build\\probe\\logs\\conformance\\issue986_modal_decl_of_direct.log >nul"
    return testsupport::runCompileCheckCommand(
        ctx,
        modal_decl_of_command,
        "modals/diagnostics/issue986_modal_decl_of_direct"
    )
}
