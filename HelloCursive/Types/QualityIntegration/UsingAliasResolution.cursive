using ValueData::TypeRecordCase as AliasedRecord
using ValueData::TypeEnumCase as AliasedEnum

procedure UsingAliasMetricLabel(value: i32) -> string@View {
    if (value == 1) {
        return "1"
    }
    return "other"
}

procedure RunUsingAliasResolution(ctx: Context) -> i32 {
    let scope: string@View = "types::QualityIntegration::UsingAliasResolution"
    let aliased_rec: AliasedRecord = AliasedRecord{ left: 10, right: 20, bias: 1 }
    let rec_sum: i32 = aliased_rec.left + aliased_rec.right + aliased_rec.bias
    let rec_sum_log: i32 = rec_sum

    let aliased_unit: AliasedEnum = AliasedEnum::Unit
    let enum_check: i32 = if aliased_unit is {
        AliasedEnum::Unit { 1 }
        _: AliasedEnum { 0 }
    }
    let enum_check_log: i32 = enum_check

    let ualias_001: string@View = "UALIAS-001"
    let ualias_002: string@View = "UALIAS-002"

    let runtime_ok: bool =
        (rec_sum_log == 31) &&
        (enum_check_log == 1) &&
        (ualias_001 == "UALIAS-001") &&
        (ualias_002 == "UALIAS-002")
    let runtime_ok_log: bool = runtime_ok

    let metric: i32 = if (runtime_ok_log == true) { 1 } else { 0 }
    let metric_label: string@View = UsingAliasMetricLabel(metric)
    let metric_log_actual: string@View = metric_label
    if (metric_log_actual != "1") {
        return 1
    }

    return 0
}
