
procedure FeatureStatusLabel(status: i32) -> string@View {
    if (status == 0) {
        return "0"
    }
    return "non-zero"
}

procedure LogFeatureStatus(
    fs: $FileSystem,
    scope: string@View,
    feature_name: string@View,
    step_name: string@View,
    status: i32
) -> () {
    let expected_zero: string@View = "0"
    let actual_status: string@View = FeatureStatusLabel(status)
    let passed: bool = status == 0
    let passed_log_actual = [[log(label: "observed-feature-status", expected: "0")]] actual_status
    let passed_with_log: bool = passed && (passed_log_actual == expected_zero)
}

public procedure RunGroup(ctx: Context) -> i32 {
    let section_name: string@View = "types/QualityIntegration"
    let status_ok: string@View = "ok"
    let status_failed: string@View = "failed"

    let phase_planned: string@View = "planned"
    let phase_running: string@View = "running"
    let phase_complete: string@View = "complete"
    let phase_failed: string@View = "failed"
    let dispatch_reason: string@View = "dispatching feature function"
    let complete_reason: string@View = "feature function completed"
    let failed_reason: string@View = "feature function returned non-zero status"

    let feature_diag: string@View = "QualityIntegration::DiagnosticMatrix"
    let feature_cross: string@View = "QualityIntegration::CrossAssemblyTypeBoundaries"
    let feature_behavior_types_diag: string@View = "QualityIntegration::BehaviorTypesDiagnostics"
    let feature_using_item: string@View = "QualityIntegration::UsingItemResolution"

    [[log(label: "types-log-section_start")]]
    [[log(label: "types-log-transition")]]
    let status_diag: i32 = RunDiagnosticMatrix(ctx)
    let observed_diag_step: string@View = "observed-diagnostic-feature-status"
    LogFeatureStatus(ctx.fs, section_name, feature_diag, observed_diag_step, status_diag)
    if (status_diag != 0) {
        [[log(label: "types-log-transition")]]
        [[log(label: "types-log-section_end")]]
        return status_diag
    }
    [[log(label: "types-log-transition")]]
    [[log(label: "types-log-transition")]]
    let status_cross: i32 = RunCrossAssemblyTypeBoundaries(ctx)
    let observed_cross_step: string@View = "observed-cross-boundary-feature-status"
    LogFeatureStatus(ctx.fs, section_name, feature_cross, observed_cross_step, status_cross)
    if (status_cross != 0) {
        [[log(label: "types-log-transition")]]
        [[log(label: "types-log-section_end")]]
        return status_cross
    }
    [[log(label: "types-log-transition")]]
    [[log(label: "types-log-transition")]]
    let feature_import_alias: string@View = "QualityIntegration::ImportAliasResolution"
    let status_import_alias: i32 = RunImportAliasResolution(ctx)
    let observed_import_alias_step: string@View = "observed-import-alias-feature-status"
    LogFeatureStatus(ctx.fs, section_name, feature_import_alias, observed_import_alias_step, status_import_alias)
    if (status_import_alias != 0) {
        [[log(label: "types-log-transition")]]
        [[log(label: "types-log-section_end")]]
        return status_import_alias
    }
    [[log(label: "types-log-transition")]]
    [[log(label: "types-log-transition")]]
    let feature_using_alias: string@View = "QualityIntegration::UsingAliasResolution"
    let status_using_alias: i32 = RunUsingAliasResolution(ctx)
    let observed_using_alias_step: string@View = "observed-using-alias-feature-status"
    LogFeatureStatus(ctx.fs, section_name, feature_using_alias, observed_using_alias_step, status_using_alias)
    if (status_using_alias != 0) {
        [[log(label: "types-log-transition")]]
        [[log(label: "types-log-section_end")]]
        return status_using_alias
    }
    [[log(label: "types-log-transition")]]
    [[log(label: "types-log-transition")]]
    let status_using_item: i32 = RunUsingItemResolution(ctx)
    let observed_using_item_step: string@View = "observed-using-item-feature-status"
    LogFeatureStatus(ctx.fs, section_name, feature_using_item, observed_using_item_step, status_using_item)
    if (status_using_item != 0) {
        [[log(label: "types-log-transition")]]
        [[log(label: "types-log-section_end")]]
        return status_using_item
    }
    [[log(label: "types-log-transition")]]
    [[log(label: "types-log-transition")]]
    let feature_brace_wildcard: string@View = "QualityIntegration::BraceAndWildcardImports"
    let status_brace_wildcard: i32 = RunBraceAndWildcardImportExercises(ctx)
    let observed_brace_wildcard_step: string@View = "observed-brace-wildcard-feature-status"
    LogFeatureStatus(ctx.fs, section_name, feature_brace_wildcard, observed_brace_wildcard_step, status_brace_wildcard)
    if (status_brace_wildcard != 0) {
        [[log(label: "types-log-transition")]]
        [[log(label: "types-log-section_end")]]
        return status_brace_wildcard
    }
    [[log(label: "types-log-transition")]]
    [[log(label: "types-log-transition")]]
    let status_behavior_types_diag: i32 = RunBehaviorTypesDiagnostics(ctx)
    let observed_behavior_types_diag_step: string@View = "observed-behavior-types-diagnostics-feature-status"
    LogFeatureStatus(ctx.fs, section_name, feature_behavior_types_diag, observed_behavior_types_diag_step, status_behavior_types_diag)
    if (status_behavior_types_diag != 0) {
        [[log(label: "types-log-transition")]]
        [[log(label: "types-log-section_end")]]
        return status_behavior_types_diag
    }
    [[log(label: "types-log-transition")]]
    [[log(label: "types-log-section_end")]]
    return 0
}
