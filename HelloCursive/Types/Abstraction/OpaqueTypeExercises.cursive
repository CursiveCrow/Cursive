public class OpaqueTagged {
    procedure tag(~) -> i32
}

record OpaqueImplA <: OpaqueTagged {
    seed: i32

    procedure tag(~) -> i32 {
        return self.seed + 100
    }
}

record OpaqueImplB <: OpaqueTagged {
    seed: i32

    procedure tag(~) -> i32 {
        return self.seed + 200
    }
}

procedure MakeOpaqueA(seed: i32) -> opaque OpaqueTagged {
    let impl_a: OpaqueImplA = OpaqueImplA { seed: seed }
    return impl_a
}

procedure MakeOpaqueB(seed: i32) -> opaque OpaqueTagged {
    let impl_b: OpaqueImplB = OpaqueImplB { seed: seed }
    return impl_b
}

procedure OpaqueMetricLabel(value: i32) -> string@View {
    if (value == 0) {
        return "0"
    }
    if (value == 105) {
        return "105"
    }
    if (value == 207) {
        return "207"
    }
    if (value == 312) {
        return "312"
    }
    if (value == 110) {
        return "110"
    }
    return "other"
}

public procedure RunOpaqueFactoryExercise(ctx: Context) -> i32 {
    [[log(label: "types-log-item_begin")]]

    let opaque_a = MakeOpaqueA(5)
    let tag_a: i32 = opaque_a~>tag()
    let tag_a_log: i32 = [[log(label: "observed-opaque-factory-a-tag", expected: 105)]] tag_a
    let a_ok: bool = tag_a_log == 105

    let opaque_b = MakeOpaqueB(7)
    let tag_b: i32 = opaque_b~>tag()
    let tag_b_log: i32 = [[log(label: "observed-opaque-factory-b-tag", expected: 207)]] tag_b
    let b_ok: bool = tag_b_log == 207

    let combined: i32 = tag_a + tag_b
    let combined_log: i32 = [[log(label: "observed-opaque-combined-tags", expected: 312)]] combined
    let combined_ok: bool = combined_log == 312

    let all_ok: bool = a_ok && b_ok && combined_ok
    let all_ok_log: bool = [[log(label: "opaque-factory-runtime", expected: true)]] all_ok

    if (all_ok_log != true) {
        [[log(label: "types-log-item_fail")]]
        return 1
    }
    [[log(label: "types-log-types_item_success")]]
    return 0
}

public procedure RunOpaqueSameFactoryIdentityExercise(ctx: Context) -> i32 {
    [[log(label: "types-log-item_begin")]]

    let first = MakeOpaqueA(10)
    let second = MakeOpaqueA(10)

    let tag_first: i32 = first~>tag()
    let tag_second: i32 = second~>tag()

    let tags_equal: bool = tag_first == tag_second
    let tags_equal_log: bool = [[log(label: "observed-opaque-same-factory-identity", expected: true)]] tags_equal

    let first_expected: i32 = 110
    let first_log: i32 = [[log(label: "observed-opaque-identity-value", expected: 110)]] tag_first
    let value_ok: bool = first_log == 110

    let all_ok: bool = tags_equal_log && value_ok
    let all_ok_log: bool = [[log(label: "opaque-identity-runtime", expected: true)]] all_ok

    if (all_ok_log != true) {
        [[log(label: "types-log-item_fail")]]
        return 1
    }
    [[log(label: "types-log-types_item_success")]]
    return 0
}

procedure RunOpaqueTypeExercises(ctx: Context) -> i32 {
    let status_factory: i32 = RunOpaqueFactoryExercise(ctx)
    if (status_factory != 0) {
        return status_factory
    }

    let status_identity: i32 = RunOpaqueSameFactoryIdentityExercise(ctx)
    if (status_identity != 0) {
        return status_identity
    }

    return 0
}
