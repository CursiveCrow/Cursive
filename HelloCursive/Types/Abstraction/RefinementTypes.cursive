public type PositiveI32 = i32 |: { self > 0 }
public type PositiveI32Alias = i32 |: { self > 0 }
public type PositiveUnderTenI32 = i32 |: { (self > 0) && (self < 10) }

procedure AcceptPositive(value: PositiveI32) -> i32 {
    return value
}

procedure AcceptPositiveAlias(value: PositiveI32Alias) -> i32 {
    return value
}

procedure AcceptPositiveUnderTen(value: PositiveUnderTenI32) -> i32 {
    return value
}

procedure IsPositiveRuntime(value: i32) -> bool {
    return value > 0
}

procedure IsPositiveUnderTenRuntime(value: i32) -> bool {
    return (value > 0) && (value < 10)
}

procedure LogRefinementValue(
    fs: $FileSystem,
    scope: string@View,
    move object_name: string@View,
    move state: string@View,
    move details: string@View
) -> () {
    }

procedure RunRefinementTypesItem(
    ctx: Context,
    scope: string@View,
    move item_name: string@View,
    move item_details: string@View,
    move item_reason: string@View,
    move step_name: string@View,
    move step_detail: string@View,
    move expected: string@View,
    move actual_pass: string@View,
    move actual_fail: string@View,
    move passed: bool,
    move failure_reason: string@View
) -> i32 {
    let detail_begin: string@View = "type feature item exercise start"
    let phase_running: string@View = "running"
    let phase_step_begin: string@View = "step-begin"
    let phase_step_pass: string@View = "step-pass"
    let phase_step_fail: string@View = "step-fail"
    let reason_pass: string@View = "expected output aligned with actual output"
    let reason_fail: string@View = "expected output did not align with actual output"
    let passed_place: bool = passed

    let item_check_log: bool = passed_place
    let item_check_ok: bool = passed_place && (item_check_log == true)
    if (item_check_ok == false) {
        return 1
    }

    return 0
}

procedure RefinementBoolLabel(value: bool) -> string@View {
    if (value) {
        return "true"
    }
    return "false"
}

procedure RefinementMetricLabel(value: i32) -> string@View {
    if (value == 0) {
        return "0"
    }
    if (value == 1) {
        return "1"
    }
    if (value == 7) {
        return "7"
    }
    return "other"
}

procedure VerifyRefinementTypesItem(ctx: Context, scope: string@View, move item_index: i32, move item_name: string@View) -> i32 {
    let refined_positive: PositiveI32 = 7
    LogRefinementValue(ctx.fs, scope, "refined_positive", "constructed", "positive refinement value constructed")
    let refined_bounded: PositiveUnderTenI32 = 7
    LogRefinementValue(ctx.fs, scope, "refined_bounded", "constructed", "bounded refinement value constructed")
    let negative_probe: i32 = -3
    LogRefinementValue(ctx.fs, scope, "negative_probe", "constructed", "negative runtime probe prepared for rejection branch")

    let predicate_runtime_ok: bool = IsPositiveRuntime(refined_positive)
    let bounded_runtime_ok: bool = IsPositiveUnderTenRuntime(refined_bounded)
    let bounded_literal_probe: i32 = 7
    let bounded_literal_runtime_ok: bool = IsPositiveUnderTenRuntime(bounded_literal_probe)
    let rejected_runtime_ok: bool = if (IsPositiveRuntime(negative_probe)) { false } else { true }
    let accepted_positive: i32 = AcceptPositive(refined_positive)
    let accepted_bounded: i32 = AcceptPositiveUnderTen(refined_bounded)
    let accepted_bounded_as_positive: i32 = AcceptPositive(refined_bounded)
    let accepted_alias_from_positive: i32 = AcceptPositiveAlias(refined_positive)
    let predicate_syntax_metric: i32 = if (predicate_runtime_ok) { 1 } else { 0 }
    let refinement_construction_metric: i32 = accepted_positive
    let verification_boundary_metric: i32 = if (bounded_runtime_ok && (accepted_bounded == 7)) { 1 } else { 0 }
    let refinement_interop_metric: i32 = if ((accepted_bounded_as_positive == 7) && (accepted_alias_from_positive == 7)) { 1 } else { 0 }
    let refinement_diagnostic_metric: i32 = if (rejected_runtime_ok) { 1 } else { 0 }

    let bounded_runtime_ok_label: string@View = RefinementBoolLabel(bounded_runtime_ok)
    let bounded_literal_runtime_ok_label: string@View = RefinementBoolLabel(bounded_literal_runtime_ok)
    let accepted_bounded_label: string@View = RefinementMetricLabel(accepted_bounded)
    let verification_boundary_metric_label: string@View = RefinementMetricLabel(verification_boundary_metric)
    let refinement_interop_metric_label: string@View = RefinementMetricLabel(refinement_interop_metric)
    let observed_bounded_runtime_step: string@View = "observed-bounded-runtime-ok"
    let observed_bounded_literal_runtime_step: string@View = "observed-bounded-literal-runtime-ok"
    let observed_accepted_bounded_step: string@View = "observed-accepted-bounded"
    let observed_verification_metric_step: string@View = "observed-verification-boundary-metric"
    let expected_true: string@View = "true"
    let expected_bounded_value: string@View = "7"
    let expected_verification_metric: string@View = "1"
    let expected_refinement_interop_metric: string@View = "1"
    let bounded_runtime_ok_passed: bool = bounded_runtime_ok
    let bounded_literal_runtime_ok_passed: bool = bounded_literal_runtime_ok
    let accepted_bounded_passed: bool = accepted_bounded == 7
    let verification_metric_passed: bool = verification_boundary_metric == 1
    let refinement_interop_metric_passed: bool = refinement_interop_metric == 1
    let predicate_syntax_metric_passed: bool = predicate_syntax_metric == 1
    let refinement_construction_metric_passed: bool = refinement_construction_metric == 7
    let refinement_diagnostic_metric_passed: bool = refinement_diagnostic_metric == 1

    let bounded_runtime_ok_passed_log_actual = bounded_runtime_ok_label
    let bounded_runtime_ok_passed_with_log: bool = bounded_runtime_ok_passed && (bounded_runtime_ok_passed_log_actual == expected_true)
    let bounded_literal_runtime_ok_passed_log_actual = bounded_literal_runtime_ok_label
    let bounded_literal_runtime_ok_passed_with_log: bool = bounded_literal_runtime_ok_passed && (bounded_literal_runtime_ok_passed_log_actual == expected_true)
    let accepted_bounded_passed_log_actual = accepted_bounded_label
    let accepted_bounded_passed_with_log: bool = accepted_bounded_passed && (accepted_bounded_passed_log_actual == expected_bounded_value)
    let verification_metric_passed_log_actual = verification_boundary_metric_label
    let verification_metric_passed_with_log: bool = verification_metric_passed && (verification_metric_passed_log_actual == expected_verification_metric)
    let refinement_interop_metric_passed_log_actual = refinement_interop_metric_label
    let refinement_interop_metric_passed_with_log: bool = refinement_interop_metric_passed && (refinement_interop_metric_passed_log_actual == expected_refinement_interop_metric)
    if (item_index == 0) {
        return RunRefinementTypesItem(
            ctx,
            scope,
            "PredicateSyntax",
            "refinement predicate syntax and bound-variable availability",
            "validated refinement predicate syntax",
            "predicate-syntax",
            "evaluate predicate form over candidate value",
            "1",
            "1",
            "not-1",
            move predicate_syntax_metric_passed,
            "predicate syntax check failed"
        )
    }

    if (item_index == 1) {
        return RunRefinementTypesItem(
            ctx,
            scope,
            "RefinementConstruction",
            "construction and propagation of predicate-constrained values",
            "validated refinement construction",
            "refinement-construction",
            "construct value under predicate gate and propagate accepted value",
            "7",
            "7",
            "not-7",
            move refinement_construction_metric_passed,
            "refinement construction check failed"
        )
    }

    if (item_index == 2) {
        return RunRefinementTypesItem(
            ctx,
            scope,
            "PredicateVerificationBoundary",
            "static verification boundary and dynamic-check handoff points",
            "validated predicate verification boundaries",
            "predicate-verification-boundary",
            "evaluate combined predicate gate representing verification boundary",
            "1",
            "1",
            "not-1",
            move verification_metric_passed_with_log,
            "predicate verification boundary check failed"
        )
    }

    if (item_index == 3) {
        return RunRefinementTypesItem(
            ctx,
            scope,
            "RefinementInterop",
            "same-predicate alias compatibility and narrower-to-wider refinement flow",
            "validated refinement interoperability",
            "refinement-interop",
            "flow bounded refinements into wider predicates and same-predicate aliases",
            "1",
            "1",
            "not-1",
            move refinement_interop_metric_passed_with_log,
            "refinement interop check failed"
        )
    }

    if (item_index == 4) {
        return RunRefinementTypesItem(
            ctx,
            scope,
            "RefinementDiagnostics",
            "deterministic diagnostics for unsatisfied or unprovable predicates",
            "validated refinement diagnostics",
            "refinement-diagnostics",
            "evaluate failing predicate branch to surface deterministic diagnostic condition",
            "1",
            "1",
            "not-1",
            move refinement_diagnostic_metric_passed,
            "refinement diagnostics check failed"
        )
    }

    return RunRefinementTypesItem(
        ctx,
        scope,
        move item_name,
        "unknown refinement types item",
        "failed unknown refinement types item",
        "item-resolution",
        "resolve item name within refinement types feature set",
        "known-item",
        "known-item",
        "unknown-item",
        false,
        "unknown refinement types item"
    )
}

procedure RunRefinementTypes(ctx: Context) -> i32 {
    let scope: string@View = "types::Abstraction::RefinementTypes"
    let checkpoint: string@View = "covered refinement types feature items"

    let status_PredicateSyntax: i32 = VerifyRefinementTypesItem(ctx, scope, 0, "PredicateSyntax")
    if (status_PredicateSyntax != 0) {
        return status_PredicateSyntax
    }

    let status_RefinementConstruction: i32 = VerifyRefinementTypesItem(ctx, scope, 1, "RefinementConstruction")
    if (status_RefinementConstruction != 0) {
        return status_RefinementConstruction
    }

    let status_PredicateVerificationBoundary: i32 = VerifyRefinementTypesItem(ctx, scope, 2, "PredicateVerificationBoundary")
    if (status_PredicateVerificationBoundary != 0) {
        return status_PredicateVerificationBoundary
    }

    let status_RefinementInterop: i32 = VerifyRefinementTypesItem(ctx, scope, 3, "RefinementInterop")
    if (status_RefinementInterop != 0) {
        return status_RefinementInterop
    }

    let status_RefinementDiagnostics: i32 = VerifyRefinementTypesItem(ctx, scope, 4, "RefinementDiagnostics")
    if (status_RefinementDiagnostics != 0) {
        return status_RefinementDiagnostics
    }

    return 0
}
