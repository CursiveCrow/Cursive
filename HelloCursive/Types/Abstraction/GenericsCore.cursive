public record GenericPair<T> {
    public left: T
    public right: T
}

public record GenericParamRulePair<T; U> {
    public left: T
    public right: U
}

public type GenericPairAlias<T> = (T, T)
public type GenericParamRuleAlias<T; U> = (T, U)

procedure Identity<T>(value: T) -> T {
    return value
}

procedure SelectLeft<T>(pair: GenericPairAlias<T>) -> T {
    return pair.0
}

procedure SelectRight<T>(pair: GenericPairAlias<T>) -> T {
    return pair.1
}

procedure ChooseFirst<T>(first: T, second: T) -> T {
    let pair: GenericPairAlias<T> = (first, second)
    return pair.0
}

procedure ChooseSecond<T; U>(first: T, second: U) -> U {
    let _ = first
    return second
}

procedure LogGenericsObject(
    fs: $FileSystem,
    scope: string@View,
    move object_name: string@View,
    move object_type: string@View,
    move state: string@View,
    move details: string@View
) -> () {
    [[log(label: "types-log-object")]]
}

procedure RunGenericsCoreItem(
    ctx: Context,
    scope: string@View,
    move item_name: string@View,
    move item_details: string@View,
    move item_reason: string@View,
    move step_name: string@View,
    move step_detail: string@View,
    move expected: string@View,
    move actual_pass: string@View,
    move actual_fail: string@View,
    move passed: bool,
    move failure_reason: string@View
) -> i32 {
    let detail_begin: string@View = "type feature item exercise start"
    [[log(label: "types-log-item_begin")]]
    let phase_running: string@View = "running"
    let phase_step_begin: string@View = "step-begin"
    let phase_step_pass: string@View = "step-pass"
    let phase_step_fail: string@View = "step-fail"
    let reason_pass: string@View = "expected output aligned with actual output"
    let reason_fail: string@View = "expected output did not align with actual output"
    let passed_place: bool = passed

    [[log(label: "types-log-runtime_phase")]]
    let item_check_log: bool = [[log(label: "observed-item-check-pass", expected: true)]] passed_place
    let item_check_ok: bool = passed_place && (item_check_log == true)
    if (item_check_ok == false) {
        [[log(label: "types-log-transition")]]
        [[log(label: "types-log-item_fail")]]
        return 1
    }

    [[log(label: "types-log-transition")]]
    [[log(label: "types-log-types_item_success")]]
    return 0
}

procedure GenericsMetricLabel(value: i32) -> string@View {
    if (value == 0) {
        return "0"
    }
    if (value == 1) {
        return "1"
    }
    if (value == 5) {
        return "5"
    }
    if (value == 8) {
        return "8"
    }
    if (value == 10) {
        return "10"
    }
    if (value == 11) {
        return "11"
    }
    if (value == 12) {
        return "12"
    }
    if (value == 22) {
        return "22"
    }
    return "other"
}

procedure VerifyGenericsCoreItem(ctx: Context, scope: string@View, move item_index: i32, move item_name: string@View) -> i32 {
    [[log(label: "types-log-runtime_phase_move")]]
    let generic_type_left_source: i32 = 4
    let generic_type_right_source: i32 = 6
    let generic_type_pair: GenericPairAlias<i32> = (generic_type_left_source, generic_type_right_source)
    LogGenericsObject(ctx.fs, scope, "generic_type_pair", "GenericPairAlias<i32>", "constructed", "pair for generic type parameter exercise prepared")

    let generic_proc_input: i32 = 5
    let generic_proc_fallback: i32 = 8
    LogGenericsObject(ctx.fs, scope, "generic_proc_args", "i32,i32", "constructed", "generic procedure inferred-argument call inputs prepared")

    let explicit_primary: i32 = 8
    let explicit_secondary: i32 = 6
    LogGenericsObject(ctx.fs, scope, "explicit_generic_args", "i32,i32", "constructed", "explicit generic instantiation inputs prepared")

    let mono_i32_input: i32 = 2
    let mono_bool_input: bool = true
    let mono_i32_fallback: i32 = 9
    let mono_bool_fallback: bool = false
    LogGenericsObject(ctx.fs, scope, "mono_i32_inputs", "i32,i32", "constructed", "monomorphized i32 specialization inputs prepared")
    LogGenericsObject(ctx.fs, scope, "mono_bool_inputs", "bool,bool", "constructed", "monomorphized bool specialization inputs prepared")
    LogGenericsObject(ctx.fs, scope, "generic_literal_arg", "i32 literal", "constructed", "inferred generic call literal argument prepared")
    LogGenericsObject(ctx.fs, scope, "generic_place_arg", "i32 place", "constructed", "inferred generic call provenance-bearing place argument prepared")
    LogGenericsObject(ctx.fs, scope, "generic_param_rule_pair", "GenericParamRuleAlias<i32, i32>", "constructed", "semicolon-separated generic parameter rule exercise prepared")

    [[log(label: "types-log-runtime_phase_move")]]
    [[log(label: "types-log-transition_move")]]
    let generic_type_left_metric: i32 = SelectLeft(generic_type_pair)
    let generic_type_right_metric: i32 = SelectRight(generic_type_pair)
    let generic_type_metric: i32 = generic_type_left_metric + generic_type_right_metric
    [[log(label: "types-log-transition_move")]]
    [[log(label: "types-log-transition_move")]]
    let generic_proc_metric: i32 = ChooseFirst(generic_proc_input, generic_proc_fallback)
    [[log(label: "types-log-transition_move")]]
    [[log(label: "types-log-transition_move")]]
    let explicit_metric: i32 = ChooseFirst<i32>(explicit_primary, explicit_secondary)
    [[log(label: "types-log-transition_move")]]
    [[log(label: "types-log-transition_move")]]
    let mono_i32: i32 = ChooseFirst<i32>(mono_i32_input, mono_i32_fallback)
    [[log(label: "types-log-transition_move")]]
    [[log(label: "types-log-transition_move")]]
    let mono_bool: bool = ChooseFirst<bool>(mono_bool_input, mono_bool_fallback)
    [[log(label: "types-log-transition_move")]]
    [[log(label: "types-log-transition_move")]]
    let generic_literal_metric: i32 = Identity(11)
    [[log(label: "types-log-transition_move")]]
    let generic_place_source: i32 = 11
    [[log(label: "types-log-transition_move")]]
    let generic_place_metric: i32 = Identity(generic_place_source)
    [[log(label: "types-log-transition_move")]]
    let generic_provenance_metric: i32 = generic_literal_metric + generic_place_metric
    let monomorph_metric: i32 = if ((mono_i32 == 2) && mono_bool) { 1 } else { 0 }
    let generic_param_rule_pair: GenericParamRuleAlias<i32, i32> = (3, 9)
    let generic_param_rule_metric: i32 = generic_param_rule_pair.0 + ChooseSecond<i32, i32>(0, generic_param_rule_pair.1)

    let observed_type_parameters_step: string@View = "observed-generic-type-parameters-metric"
    let observed_procedure_parameters_step: string@View = "observed-generic-procedure-parameters-metric"
    let observed_instantiation_step: string@View = "observed-generic-instantiation-metric"
    let observed_monomorph_step: string@View = "observed-monomorphized-calls-metric"
    let observed_generic_literal_step: string@View = "observed-generic-literal-call-metric"
    let observed_generic_place_step: string@View = "observed-generic-place-call-metric"
    let observed_generic_provenance_step: string@View = "observed-generic-provenance-aware-call-metric"
    let observed_generic_param_rule_step: string@View = "observed-generic-param-rule-metric"
    let expected_type_parameters: string@View = "10"
    let expected_procedure_parameters: string@View = "5"
    let expected_instantiation: string@View = "8"
    let expected_monomorph: string@View = "1"
    let expected_generic_literal: string@View = "11"
    let expected_generic_place: string@View = "11"
    let expected_generic_provenance: string@View = "22"
    let expected_generic_param_rule: string@View = "12"
    let type_parameters_metric_label: string@View = GenericsMetricLabel(generic_type_metric)
    let procedure_parameters_metric_label: string@View = GenericsMetricLabel(generic_proc_metric)
    let instantiation_metric_label: string@View = GenericsMetricLabel(explicit_metric)
    let monomorph_metric_label: string@View = GenericsMetricLabel(monomorph_metric)
    let generic_literal_metric_label: string@View = GenericsMetricLabel(generic_literal_metric)
    let generic_place_metric_label: string@View = GenericsMetricLabel(generic_place_metric)
    let generic_provenance_metric_label: string@View = GenericsMetricLabel(generic_provenance_metric)
    let generic_param_rule_metric_label: string@View = GenericsMetricLabel(generic_param_rule_metric)
    let type_parameters_metric_passed: bool = generic_type_metric == 10
    let procedure_parameters_metric_passed: bool = generic_proc_metric == 5
    let instantiation_metric_passed: bool = explicit_metric == 8
    let monomorph_metric_passed: bool = monomorph_metric == 1
    let generic_literal_metric_passed: bool = generic_literal_metric == 11
    let generic_place_metric_passed: bool = generic_place_metric == 11
    let generic_provenance_metric_passed: bool = generic_provenance_metric == 22
    let generic_param_rule_metric_passed: bool = generic_param_rule_metric == 12

    let type_parameters_metric_passed_log_actual = [[log(label: "observed-generic-type-parameters-metric", expected: "10")]] type_parameters_metric_label
    let type_parameters_metric_passed_with_log: bool = type_parameters_metric_passed && (type_parameters_metric_passed_log_actual == expected_type_parameters)
    let procedure_parameters_metric_passed_log_actual = [[log(label: "observed-generic-procedure-parameters-metric", expected: "5")]] procedure_parameters_metric_label
    let procedure_parameters_metric_passed_with_log: bool = procedure_parameters_metric_passed && (procedure_parameters_metric_passed_log_actual == expected_procedure_parameters)
    let instantiation_metric_passed_log_actual = [[log(label: "observed-generic-instantiation-metric", expected: "8")]] instantiation_metric_label
    let instantiation_metric_passed_with_log: bool = instantiation_metric_passed && (instantiation_metric_passed_log_actual == expected_instantiation)
    let monomorph_metric_passed_log_actual = [[log(label: "observed-monomorphized-calls-metric", expected: "1")]] monomorph_metric_label
    let monomorph_metric_passed_with_log: bool = monomorph_metric_passed && (monomorph_metric_passed_log_actual == expected_monomorph)
    let generic_literal_metric_passed_log_actual = [[log(label: "observed-generic-literal-call-metric", expected: "11")]] generic_literal_metric_label
    let generic_literal_metric_passed_with_log: bool = generic_literal_metric_passed && (generic_literal_metric_passed_log_actual == expected_generic_literal)
    let generic_place_metric_passed_log_actual = [[log(label: "observed-generic-place-call-metric", expected: "11")]] generic_place_metric_label
    let generic_place_metric_passed_with_log: bool = generic_place_metric_passed && (generic_place_metric_passed_log_actual == expected_generic_place)
    let generic_provenance_metric_passed_log_actual = [[log(label: "observed-generic-provenance-aware-call-metric", expected: "22")]] generic_provenance_metric_label
    let generic_provenance_metric_passed_with_log: bool = generic_provenance_metric_passed && (generic_provenance_metric_passed_log_actual == expected_generic_provenance)
    let generic_param_rule_metric_passed_log_actual = [[log(label: "observed-generic-param-rule-metric", expected: "12")]] generic_param_rule_metric_label
    let generic_param_rule_metric_passed_with_log: bool = generic_param_rule_metric_passed && (generic_param_rule_metric_passed_log_actual == expected_generic_param_rule)
    [[log(label: "types-log-runtime_phase_move")]]
    if (item_index == 0) {
        return RunGenericsCoreItem(
            ctx,
            scope,
            "GenericTypeParameters",
            "generic type parameter declaration forms and bounds",
            "validated generic type parameters",
            "generic-type-parameters",
            "instantiate generic record type with concrete type argument",
            "10",
            "10",
            "not-10",
            move type_parameters_metric_passed_with_log,
            "generic type parameters check failed"
        )
    }

    if (item_index == 1) {
        return RunGenericsCoreItem(
            ctx,
            scope,
            "GenericProcedureParameters",
            "generic procedure parameter typing and call constraints",
            "validated generic procedure parameters",
            "generic-procedure-parameters",
            "invoke generic procedure with inferred type parameter",
            "5",
            "5",
            "not-5",
            move procedure_parameters_metric_passed_with_log,
            "generic procedure parameters check failed"
        )
    }

    if (item_index == 2) {
        return RunGenericsCoreItem(
            ctx,
            scope,
            "GenericInstantiation",
            "generic argument application and inferred/explicit instantiation behavior",
            "validated generic instantiation",
            "generic-instantiation",
            "invoke generic procedure with explicit type argument",
            "8",
            "8",
            "not-8",
            move instantiation_metric_passed_with_log,
            "generic instantiation check failed"
        )
    }

    if (item_index == 3) {
        return RunGenericsCoreItem(
            ctx,
            scope,
            "MonomorphizedCalls",
            "monomorphization-sensitive call typing and specialization boundaries",
            "validated monomorphized call behavior",
            "monomorphized-calls",
            "evaluate generic specialization across multiple concrete instantiations",
            "1",
            "1",
            "not-1",
            move monomorph_metric_passed_with_log,
            "monomorphized calls check failed"
        )
    }

    if (item_index == 4) {
        return RunGenericsCoreItem(
            ctx,
            scope,
            "GenericLiteralArgumentTemporaries",
            "generic call inference with raw literal arguments and provenance-bearing place arguments",
            "validated generic literal argument temporary materialization behavior",
            "generic-literal-argument-temporaries",
            "evaluate inferred generic calls for literal no-provenance path and place provenance path",
            "22",
            "22",
            "not-22",
            move generic_provenance_metric_passed_with_log,
            "generic literal argument temporary behavior check failed"
        )
    }

    if (item_index == 5) {
        return RunGenericsCoreItem(
            ctx,
            scope,
            "GenericParameterRuleRuntime",
            "semicolon-separated generic parameter declarations lower through aliases and procedures",
            "validated Parse-GenericParams runtime lowering surface",
            "generic-parameter-rule-runtime",
            "evaluate two-parameter generic alias and procedure using semicolon-declared parameters",
            "12",
            "12",
            "not-12",
            move generic_param_rule_metric_passed_with_log,
            "generic parameter rule runtime lowering check failed"
        )
    }

    return RunGenericsCoreItem(
        ctx,
        scope,
        move item_name,
        "unknown generics core item",
        "failed unknown generics core item",
        "item-resolution",
        "resolve item name within generics core feature set",
        "known-item",
        "known-item",
        "unknown-item",
        false,
        "unknown generics core item"
    )
}

procedure RunGenericsCore(ctx: Context) -> i32 {
    let scope: string@View = "types::Abstraction::GenericsCore"
    let checkpoint: string@View = "covered generics core feature items"

    let status_GenericTypeParameters: i32 = VerifyGenericsCoreItem(ctx, scope, 0, "GenericTypeParameters")
    if (status_GenericTypeParameters != 0) {
        return status_GenericTypeParameters
    }

    let status_GenericProcedureParameters: i32 = VerifyGenericsCoreItem(ctx, scope, 1, "GenericProcedureParameters")
    if (status_GenericProcedureParameters != 0) {
        return status_GenericProcedureParameters
    }

    let status_GenericInstantiation: i32 = VerifyGenericsCoreItem(ctx, scope, 2, "GenericInstantiation")
    if (status_GenericInstantiation != 0) {
        return status_GenericInstantiation
    }

    let status_MonomorphizedCalls: i32 = VerifyGenericsCoreItem(ctx, scope, 3, "MonomorphizedCalls")
    if (status_MonomorphizedCalls != 0) {
        return status_MonomorphizedCalls
    }

    let status_GenericLiteralArgumentTemporaries: i32 = VerifyGenericsCoreItem(ctx, scope, 4, "GenericLiteralArgumentTemporaries")
    if (status_GenericLiteralArgumentTemporaries != 0) {
        return status_GenericLiteralArgumentTemporaries
    }

    let status_GenericParameterRuleRuntime: i32 = VerifyGenericsCoreItem(ctx, scope, 5, "GenericParameterRuleRuntime")
    if (status_GenericParameterRuleRuntime != 0) {
        return status_GenericParameterRuleRuntime
    }

    [[log(label: "types-log-checkpoint")]]
    return 0
}
