// DynamicDispatchExercises — $ClassName dynamic dispatch (spec §11.3, §13.3)
//
// Exercises dynamic dispatch through $ClassName for user-defined classes.
// Defines a Describable class with two record implementations, widens to
// $Describable, and verifies correct vtable dispatch at runtime.

public class Describable {
    procedure describe_value(~) -> i32
}

record DescribableAlpha <: Describable {
    base: i32

    procedure describe_value(~) -> i32 {
        return self.base * 2
    }
}

record DescribableBeta <: Describable {
    base: i32

    procedure describe_value(~) -> i32 {
        return self.base * 3
    }
}

procedure InvokeDescribable(obj: $Describable) -> i32 {
    return obj~>describe_value()
}

procedure DynDispatchMetricLabel(value: i32) -> string@View {
    if (value == 0) {
        return "0"
    }
    if (value == 10) {
        return "10"
    }
    if (value == 15) {
        return "15"
    }
    if (value == 25) {
        return "25"
    }
    return "other"
}

public procedure RunDynamicDispatchAlphaBetaExercise(ctx: Context) -> i32 {
    let alpha: DescribableAlpha = DescribableAlpha { base: 5 }
    let beta: DescribableBeta = DescribableBeta { base: 5 }

    let alpha_dyn: $Describable = alpha
    let beta_dyn: $Describable = beta

    let alpha_result: i32 = InvokeDescribable(alpha_dyn)
    let alpha_result_log: i32 = alpha_result
    let alpha_ok: bool = alpha_result_log == 10

    let beta_result: i32 = InvokeDescribable(beta_dyn)
    let beta_result_log: i32 = beta_result
    let beta_ok: bool = beta_result_log == 15

    let combined: i32 = alpha_result + beta_result
    let combined_log: i32 = combined
    let combined_ok: bool = combined_log == 25

    let all_ok: bool = alpha_ok && beta_ok && combined_ok
    let all_ok_log: bool = all_ok

    if (all_ok_log != true) {
        return 1
    }
    return 0
}

procedure RunDynamicDispatchExercises(ctx: Context) -> i32 {
    let status_alpha_beta: i32 = RunDynamicDispatchAlphaBetaExercise(ctx)
    if (status_alpha_beta != 0) {
        return status_alpha_beta
    }

    return 0
}
