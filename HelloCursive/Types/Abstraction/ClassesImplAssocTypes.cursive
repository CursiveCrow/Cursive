public class MetricSurface {
    procedure measure(~, input: i32) -> i32
}

public class AssocSurface {
    type Output = i32
    procedure project(~, input: i32) -> i32
}

public class BiasSurface {
    procedure bias(~) -> i32 {
        return 1
    }
}

public class MethodNameProjectionSurface {
    marker: i32
    type Output = i32
    procedure method_alpha(~) -> i32
    procedure method_beta(~, input: i32) -> i32
}

public class FieldNameProjectionSurface {
    primary: i32
    secondary: i32
    type Output = i32
    procedure field_total(~) -> i32
}

public record ScalarSurface <: MetricSurface, AssocSurface, BiasSurface {
    public base: i32

    public procedure measure(~, input: i32) -> i32 {
        return self.base + input
    }

    public procedure project(~, input: i32) -> i32 {
        return self.base + input
    }

    public override procedure bias(~) -> i32 {
        return self.base
    }
}

public record MethodNameProjectionImpl <: MethodNameProjectionSurface {
    public marker: i32

    public procedure method_alpha(~) -> i32 {
        return self.marker
    }

    public procedure method_beta(~, input: i32) -> i32 {
        return self.marker + input
    }
}

public record FieldNameProjectionImpl <: FieldNameProjectionSurface {
    public primary: i32
    public secondary: i32

    public procedure field_total(~) -> i32 {
        return self.primary + self.secondary
    }
}

procedure LogScalarSurfaceState(
    fs: $FileSystem,
    scope: string@View,
    move object_name: string@View,
    move state: string@View,
    move details: string@View
) -> () {
    [[log(label: "types-log-object")]]
}

procedure AssocMethod(surface: ScalarSurface, delta: i32) -> i32 {
    return surface~>project(delta)
}

procedure ResolveObligation(surface: ScalarSurface, input: i32) -> i32 {
    return surface~>measure(input) + surface~>bias()
}

procedure RunClassesImplAssocTypesItem(
    ctx: Context,
    scope: string@View,
    move item_name: string@View,
    move item_details: string@View,
    move item_reason: string@View,
    move step_name: string@View,
    move step_detail: string@View,
    move expected: string@View,
    move actual_pass: string@View,
    move actual_fail: string@View,
    move passed: bool,
    move failure_reason: string@View
) -> i32 {
    let detail_begin: string@View = "type feature item exercise start"
    [[log(label: "types-log-item_begin")]]
    let phase_running: string@View = "running"
    let phase_step_begin: string@View = "step-begin"
    let phase_step_pass: string@View = "step-pass"
    let phase_step_fail: string@View = "step-fail"
    let reason_pass: string@View = "expected output aligned with actual output"
    let reason_fail: string@View = "expected output did not align with actual output"
    let passed_place: bool = passed

    [[log(label: "types-log-runtime_phase")]]
    let item_check_log: bool = [[log(label: "observed-item-check-pass", expected: true)]] passed_place
    let item_check_ok: bool = passed_place && (item_check_log == true)
    if (item_check_ok == false) {
        [[log(label: "types-log-transition")]]
        [[log(label: "types-log-item_fail")]]
        return 1
    }

    [[log(label: "types-log-transition")]]
    [[log(label: "types-log-types_item_success")]]
    return 0
}

procedure ClassMetricLabel(value: i32) -> string@View {
    if (value == 0) {
        return "0"
    }
    if (value == 2) {
        return "2"
    }
    if (value == 4) {
        return "4"
    }
    if (value == 5) {
        return "5"
    }
    if (value == 7) {
        return "7"
    }
    if (value == 11) {
        return "11"
    }
    if (value == 16) {
        return "16"
    }
    if (value == 19) {
        return "19"
    }
    return "other"
}

procedure VerifyClassesImplAssocTypesItem(ctx: Context, scope: string@View, move item_index: i32, move item_name: string@View) -> i32 {
    [[log(label: "types-log-runtime_phase_move")]]
    let class_decl_surface: ScalarSurface = ScalarSurface { base: 2 }
    LogScalarSurfaceState(ctx.fs, scope, "class_decl_surface", "constructed", "class declaration surface prepared")
    let impl_surface: ScalarSurface = ScalarSurface { base: 3 }
    LogScalarSurfaceState(ctx.fs, scope, "impl_surface", "constructed", "implementation surface prepared")
    let assoc_surface: ScalarSurface = ScalarSurface { base: 3 }
    LogScalarSurfaceState(ctx.fs, scope, "assoc_surface", "constructed", "associated type declaration surface prepared")
    let assoc_method_surface: ScalarSurface = ScalarSurface { base: 5 }
    LogScalarSurfaceState(ctx.fs, scope, "assoc_method_surface", "constructed", "associated method signature surface prepared")
    let obligation_surface: ScalarSurface = ScalarSurface { base: 4 }
    LogScalarSurfaceState(ctx.fs, scope, "obligation_surface", "constructed", "obligation resolution surface prepared")
    let method_names_surface: MethodNameProjectionImpl = MethodNameProjectionImpl { marker: 7 }
    LogScalarSurfaceState(ctx.fs, scope, "method_names_surface", "constructed", "method-name projection surface prepared")
    let field_names_surface: FieldNameProjectionImpl = FieldNameProjectionImpl { primary: 8, secondary: 11 }
    LogScalarSurfaceState(ctx.fs, scope, "field_names_surface", "constructed", "field-name projection surface prepared")

    [[log(label: "types-log-runtime_phase_move")]]
    [[log(label: "types-log-transition_move")]]
    let class_decl_input: i32 = 0
    let class_decl_metric: i32 = class_decl_surface~>measure(class_decl_input)
    [[log(label: "types-log-transition_move")]]
    [[log(label: "types-log-transition_move")]]
    let impl_input: i32 = 1
    let impl_metric: i32 = impl_surface~>measure(impl_input)
    [[log(label: "types-log-transition_move")]]
    [[log(label: "types-log-transition_move")]]
    let assoc_input: i32 = 2
    let assoc_metric: i32 = AssocMethod(assoc_surface, assoc_input)
    [[log(label: "types-log-transition_move")]]
    [[log(label: "types-log-transition_move")]]
    let assoc_method_input: i32 = 2
    let assoc_method_metric: i32 = assoc_method_surface~>project(assoc_method_input)
    [[log(label: "types-log-transition_move")]]
    [[log(label: "types-log-transition_move")]]
    let obligation_input: i32 = 3
    let obligation_metric: i32 = ResolveObligation(obligation_surface, obligation_input)
    [[log(label: "types-log-transition_move")]]
    [[log(label: "types-log-transition_move")]]
    let method_names_input: i32 = 2
    let method_names_metric: i32 = method_names_surface~>method_alpha() + method_names_surface~>method_beta(method_names_input)
    [[log(label: "types-log-transition_move")]]
    [[log(label: "types-log-transition_move")]]
    let field_names_metric: i32 = field_names_surface~>field_total()
    [[log(label: "types-log-transition_move")]]
    let observed_declarations_step: string@View = "observed-class-declarations-metric"
    let observed_impl_step: string@View = "observed-impl-blocks-metric"
    let observed_associated_type_step: string@View = "observed-associated-type-definitions-metric"
    let observed_associated_method_step: string@View = "observed-associated-method-signatures-metric"
    let observed_obligation_step: string@View = "observed-obligation-resolution-metric"
    let observed_method_names_step: string@View = "observed-method-names-projection-metric"
    let observed_field_names_step: string@View = "observed-field-names-projection-metric"
    let expected_declarations: string@View = "2"
    let expected_impl: string@View = "4"
    let expected_associated_type: string@View = "5"
    let expected_associated_method: string@View = "7"
    let expected_obligation: string@View = "11"
    let expected_method_names: string@View = "16"
    let expected_field_names: string@View = "19"
    let declarations_metric_label: string@View = ClassMetricLabel(class_decl_metric)
    let impl_metric_label: string@View = ClassMetricLabel(impl_metric)
    let associated_type_metric_label: string@View = ClassMetricLabel(assoc_metric)
    let associated_method_metric_label: string@View = ClassMetricLabel(assoc_method_metric)
    let obligation_metric_label: string@View = ClassMetricLabel(obligation_metric)
    let method_names_metric_label: string@View = ClassMetricLabel(method_names_metric)
    let field_names_metric_label: string@View = ClassMetricLabel(field_names_metric)
    let declarations_metric_passed: bool = class_decl_metric == 2
    let impl_metric_passed: bool = impl_metric == 4
    let associated_type_metric_passed: bool = assoc_metric == 5
    let associated_method_metric_passed: bool = assoc_method_metric == 7
    let obligation_metric_passed: bool = obligation_metric == 11
    let method_names_metric_passed: bool = method_names_metric == 16
    let field_names_metric_passed: bool = field_names_metric == 19

    let declarations_metric_passed_log_actual = [[log(label: "observed-class-declarations-metric", expected: "2")]] declarations_metric_label
    let declarations_metric_passed_with_log: bool = declarations_metric_passed && (declarations_metric_passed_log_actual == expected_declarations)
    let impl_metric_passed_log_actual = [[log(label: "observed-impl-blocks-metric", expected: "4")]] impl_metric_label
    let impl_metric_passed_with_log: bool = impl_metric_passed && (impl_metric_passed_log_actual == expected_impl)
    let associated_type_metric_passed_log_actual = [[log(label: "observed-associated-type-definitions-metric", expected: "5")]] associated_type_metric_label
    let associated_type_metric_passed_with_log: bool = associated_type_metric_passed && (associated_type_metric_passed_log_actual == expected_associated_type)
    let associated_method_metric_passed_log_actual = [[log(label: "observed-associated-method-signatures-metric", expected: "7")]] associated_method_metric_label
    let associated_method_metric_passed_with_log: bool = associated_method_metric_passed && (associated_method_metric_passed_log_actual == expected_associated_method)
    let obligation_metric_passed_log_actual = [[log(label: "observed-obligation-resolution-metric", expected: "11")]] obligation_metric_label
    let obligation_metric_passed_with_log: bool = obligation_metric_passed && (obligation_metric_passed_log_actual == expected_obligation)
    let method_names_metric_passed_log_actual = [[log(label: "observed-method-names-projection-metric", expected: "16")]] method_names_metric_label
    let method_names_metric_passed_with_log: bool = method_names_metric_passed && (method_names_metric_passed_log_actual == expected_method_names)
    let field_names_metric_passed_log_actual = [[log(label: "observed-field-names-projection-metric", expected: "19")]] field_names_metric_label
    let field_names_metric_passed_with_log: bool = field_names_metric_passed && (field_names_metric_passed_log_actual == expected_field_names)
    [[log(label: "types-log-runtime_phase_move")]]
    if (item_index == 0) {
        return RunClassesImplAssocTypesItem(
            ctx,
            scope,
            "ClassDeclarations",
            "class declaration typing and required member signatures",
            "validated class declarations",
            "class-declarations",
            "evaluate abstract class member surface through concrete record implementation",
            "2",
            "2",
            "not-2",
            move declarations_metric_passed_with_log,
            "class declarations check failed"
        )
    }

    if (item_index == 1) {
        return RunClassesImplAssocTypesItem(
            ctx,
            scope,
            "ImplBlocks",
            "impl block typing against target types and declared classes",
            "validated impl block typing",
            "impl-blocks",
            "evaluate implementation method body against class-declared signature",
            "4",
            "4",
            "not-4",
            move impl_metric_passed_with_log,
            "impl blocks check failed"
        )
    }

    if (item_index == 2) {
        return RunClassesImplAssocTypesItem(
            ctx,
            scope,
            "AssociatedTypeDefinitions",
            "associated type declarations/definitions and bound constraints",
            "validated associated type definitions",
            "associated-types",
            "evaluate associated type declaration surface via associated-class method path",
            "5",
            "5",
            "not-5",
            move associated_type_metric_passed_with_log,
            "associated type definitions check failed"
        )
    }

    if (item_index == 3) {
        return RunClassesImplAssocTypesItem(
            ctx,
            scope,
            "AssociatedMethodSignatures",
            "associated method signature compatibility and receiver rules",
            "validated associated method signatures",
            "associated-method-signatures",
            "invoke associated method with receiver and typed argument conformance",
            "7",
            "7",
            "not-7",
            move associated_method_metric_passed_with_log,
            "associated method signatures check failed"
        )
    }

    if (item_index == 4) {
        return RunClassesImplAssocTypesItem(
            ctx,
            scope,
            "ObligationResolution",
            "class obligation resolution and ambiguity diagnostics",
            "validated obligation resolution",
            "obligation-resolution",
            "resolve multi-class obligation surface through concrete implementation dispatch",
            "11",
            "11",
            "not-11",
            move obligation_metric_passed_with_log,
            "obligation resolution check failed"
        )
    }

    if (item_index == 5) {
        return RunClassesImplAssocTypesItem(
            ctx,
            scope,
            "MethodNamesProjection",
            "class MethodNames projection over class methods with abstract field and associated type neighbors",
            "validated method-name projection",
            "method-names-projection",
            "invoke both class-declared methods through a concrete implementation while non-method class items remain separate",
            "16",
            "16",
            "not-16",
            move method_names_metric_passed_with_log,
            "method names projection check failed"
        )
    }

    if (item_index == 6) {
        return RunClassesImplAssocTypesItem(
            ctx,
            scope,
            "FieldNamesProjection",
            "class FieldNames projection over abstract fields with associated type and method neighbors",
            "validated field-name projection",
            "field-names-projection",
            "invoke concrete implementation over both class-declared fields while non-field class items remain separate",
            "19",
            "19",
            "not-19",
            move field_names_metric_passed_with_log,
            "field names projection check failed"
        )
    }

    return RunClassesImplAssocTypesItem(
        ctx,
        scope,
        move item_name,
        "unknown classes/impl/assoc-types item",
        "failed unknown classes/impl/assoc-types item",
        "item-resolution",
        "resolve item name within classes/impl/assoc-types feature set",
        "known-item",
        "known-item",
        "unknown-item",
        false,
        "unknown classes/impl/assoc-types item"
    )
}

procedure RunClassesImplAssocTypes(ctx: Context) -> i32 {
    let scope: string@View = "types::Abstraction::ClassesImplAssocTypes"
    let checkpoint: string@View = "covered classes/impl/assoc-types feature items"

    let status_ClassDeclarations: i32 = VerifyClassesImplAssocTypesItem(ctx, scope, 0, "ClassDeclarations")
    if (status_ClassDeclarations != 0) {
        return status_ClassDeclarations
    }

    let status_ImplBlocks: i32 = VerifyClassesImplAssocTypesItem(ctx, scope, 1, "ImplBlocks")
    if (status_ImplBlocks != 0) {
        return status_ImplBlocks
    }

    let status_AssociatedTypeDefinitions: i32 = VerifyClassesImplAssocTypesItem(ctx, scope, 2, "AssociatedTypeDefinitions")
    if (status_AssociatedTypeDefinitions != 0) {
        return status_AssociatedTypeDefinitions
    }

    let status_AssociatedMethodSignatures: i32 = VerifyClassesImplAssocTypesItem(ctx, scope, 3, "AssociatedMethodSignatures")
    if (status_AssociatedMethodSignatures != 0) {
        return status_AssociatedMethodSignatures
    }

    let status_ObligationResolution: i32 = VerifyClassesImplAssocTypesItem(ctx, scope, 4, "ObligationResolution")
    if (status_ObligationResolution != 0) {
        return status_ObligationResolution
    }

    let status_MethodNamesProjection: i32 = VerifyClassesImplAssocTypesItem(ctx, scope, 5, "MethodNamesProjection")
    if (status_MethodNamesProjection != 0) {
        return status_MethodNamesProjection
    }

    let status_FieldNamesProjection: i32 = VerifyClassesImplAssocTypesItem(ctx, scope, 6, "FieldNamesProjection")
    if (status_FieldNamesProjection != 0) {
        return status_FieldNamesProjection
    }

    [[log(label: "types-log-checkpoint")]]
    return 0
}
