
procedure FeatureStatusLabel(status: i32) -> string@View {
    if (status == 0) {
        return "0"
    }
    return "non-zero"
}

procedure LogFeatureStatus(
    fs: $FileSystem,
    scope: string@View,
    feature_name: string@View,
    step_name: string@View,
    status: i32
) -> () {
    let expected_zero: string@View = "0"
    let actual_status: string@View = FeatureStatusLabel(status)
    let passed: bool = status == 0
    let passed_log_actual = actual_status
    let passed_with_log: bool = passed && (passed_log_actual == expected_zero)
}

public procedure runGroup(ctx: Context) -> i32 {
    let status_generics_core: i32 = RunGenericsCore(ctx)
    if (status_generics_core != 0) {
        return status_generics_core
    }

    let status_constraints_and_where: i32 = RunConstraintsAndWhereClauses(ctx)
    if (status_constraints_and_where != 0) {
        return status_constraints_and_where
    }

    let status_poly: i32 = RunPolymorphismForms(ctx)
    if (status_poly != 0) {
        return status_poly
    }

    let status_classes_impl_assoc: i32 = RunClassesImplAssocTypes(ctx)
    if (status_classes_impl_assoc != 0) {
        return status_classes_impl_assoc
    }

    let status_refine: i32 = RunRefinementTypes(ctx)
    if (status_refine != 0) {
        return status_refine
    }

    let status_superclass: i32 = RunClassSuperclassBounds(ctx)
    if (status_superclass != 0) {
        return status_superclass
    }

    let status_assoc_abstract: i32 = RunAssociatedTypeAbstractDeclarations(ctx)
    if (status_assoc_abstract != 0) {
        return status_assoc_abstract
    }

    let status_opaque: i32 = RunOpaqueTypeExercises(ctx)
    if (status_opaque != 0) {
        return status_opaque
    }

    return RunDynamicDispatchExercises(ctx)
}
