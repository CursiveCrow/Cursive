public class BaseMetricClass {
    procedure base_metric(~) -> i32
}

public class DerivedMetricClass <: BaseMetricClass {
    procedure derived_metric(~) -> i32
}

public record DerivedMetricImpl <: DerivedMetricClass {
    public seed: i32

    public procedure base_metric(~) -> i32 {
        return self.seed
    }

    public procedure derived_metric(~) -> i32 {
        return self.seed + 10
    }
}

procedure ClassSuperclassBoundsMetricLabel(value: i32) -> string@View {
    if (value == 25) {
        return "25"
    }
    return "other"
}

procedure InvokeBaseContract(target: DerivedMetricImpl) -> i32 {
    return target~>base_metric()
}

procedure InvokeDerivedContract(target: DerivedMetricImpl) -> i32 {
    return target~>derived_metric()
}

procedure RunClassSuperclassBounds(ctx: Context) -> i32 {
    let scope: string@View = "types::Abstraction::ClassSuperclassBounds"
    let impl_value: DerivedMetricImpl = DerivedMetricImpl { seed: 5 }

    let base_result: i32 = InvokeBaseContract(impl_value)
    let derived_result: i32 = InvokeDerivedContract(impl_value)
    let combined: i32 = base_result + derived_result + impl_value.seed

    let base_result_log: i32 =
        base_result
    let derived_result_log: i32 =
        derived_result
    let combined_log: i32 =
        combined

    let scb_001: string@View = "SCB-001"
    let scb_002: string@View = "SCB-002"

    let runtime_ok: bool =
        (base_result_log == 5) &&
        (derived_result_log == 15) &&
        (combined_log == 25) &&
        (scb_001 == "SCB-001") &&
        (scb_002 == "SCB-002")
    let runtime_ok_log: bool = runtime_ok

    let metric: i32 = if (runtime_ok_log == true) { 25 } else { 0 }
    let metric_label: string@View = ClassSuperclassBoundsMetricLabel(metric)
    let metric_log_actual: string@View = metric_label
    if (metric_log_actual != "25") {
        return 1
    }

    return 0
}
