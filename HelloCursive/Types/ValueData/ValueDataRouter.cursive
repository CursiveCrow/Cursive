
procedure FeatureStatusLabel(status: i32) -> string@View {
    if (status == 0) {
        return "0"
    }
    return "non-zero"
}

procedure LogFeatureStatus(
    fs: $FileSystem,
    scope: string@View,
    feature_name: string@View,
    step_name: string@View,
    status: i32
) -> () {
    let expected_zero: string@View = "0"
    let actual_status: string@View = FeatureStatusLabel(status)
    let passed: bool = status == 0
    let passed_log_actual = actual_status
    let passed_with_log: bool = passed && (passed_log_actual == expected_zero)
}

public procedure runGroup(ctx: Context) -> i32 {
    let section_name: string@View = "types/ValueData"
    let status_ok: string@View = "ok"
    let status_failed: string@View = "failed"

    let phase_planned: string@View = "planned"
    let phase_running: string@View = "running"
    let phase_complete: string@View = "complete"
    let phase_failed: string@View = "failed"
    let dispatch_reason: string@View = "dispatching feature function"
    let complete_reason: string@View = "feature function completed"
    let failed_reason: string@View = "feature function returned non-zero status"

    let feature_tuples: string@View = "ValueData::TuplesArraysSlicesRanges"
    let feature_records: string@View = "ValueData::Records"
    let feature_enums: string@View = "ValueData::Enums"
    let feature_unions: string@View = "ValueData::UnionsPropagation"

    let status_tuples: i32 = RunTuplesArraysSlicesRanges(ctx)
    let observed_tuples_step: string@View = "observed-tuples-feature-status"
    LogFeatureStatus(ctx.fs, section_name, feature_tuples, observed_tuples_step, status_tuples)
    if (status_tuples != 0) {
        return status_tuples
    }
    let status_records: i32 = RunRecords(ctx)
    let observed_records_step: string@View = "observed-records-feature-status"
    LogFeatureStatus(ctx.fs, section_name, feature_records, observed_records_step, status_records)
    if (status_records != 0) {
        return status_records
    }
    let status_enums: i32 = RunEnums(ctx)
    let observed_enums_step: string@View = "observed-enums-feature-status"
    LogFeatureStatus(ctx.fs, section_name, feature_enums, observed_enums_step, status_enums)
    if (status_enums != 0) {
        return status_enums
    }
    let status_unions: i32 = RunUnionsPropagation(ctx)
    let observed_unions_step: string@View = "observed-unions-feature-status"
    LogFeatureStatus(ctx.fs, section_name, feature_unions, observed_unions_step, status_unions)
    if (status_unions != 0) {
        return status_unions
    }
    return 0
}
