public enum TypeEnumCase {
    Unit
    Tuple(i32, i32)
    Record { left: i32, right: i32 }
}

procedure LogEnumsObject(
    fs: $FileSystem,
    scope: string@View,
    move object_name: string@View,
    move object_type: string@View,
    move state: string@View,
    move details: string@View
) -> () {
    [[log(label: "types-log-object")]]
}

procedure RunEnumsItem(
    ctx: Context,
    scope: string@View,
    move item_name: string@View,
    move item_details: string@View,
    move item_reason: string@View,
    move step_name: string@View,
    move step_detail: string@View,
    move expected: string@View,
    move actual_pass: string@View,
    move actual_fail: string@View,
    move passed: bool,
    move failure_reason: string@View
) -> i32 {
    let detail_begin: string@View = "type feature item exercise start"
    [[log(label: "types-log-item_begin")]]
    let phase_running: string@View = "running"
    let phase_step_begin: string@View = "step-begin"
    let phase_step_pass: string@View = "step-pass"
    let phase_step_fail: string@View = "step-fail"
    let reason_pass: string@View = "expected output aligned with actual output"
    let reason_fail: string@View = "expected output did not align with actual output"
    let passed_place: bool = passed

    [[log(label: "types-log-runtime_phase")]]
    let item_check_log: bool = [[log(label: "observed-item-check-pass", expected: true)]] passed_place
    let item_check_ok: bool = passed_place && (item_check_log == true)
    if (item_check_ok == false) {
        [[log(label: "types-log-transition")]]
        [[log(label: "types-log-item_fail")]]
        return 1
    }

    [[log(label: "types-log-transition")]]
    [[log(label: "types-log-types_item_success")]]
    return 0
}

procedure EnumsMetricLabel(value: i32) -> string@View {
    if (value == 0) {
        return "0"
    }
    if (value == 1) {
        return "1"
    }
    if (value == 2) {
        return "2"
    }
    if (value == 6) {
        return "6"
    }
    if (value == 7) {
        return "7"
    }
    return "other"
}

procedure VerifyEnumsItem(ctx: Context, scope: string@View, move item_index: i32, move item_name: string@View) -> i32 {
    [[log(label: "types-log-runtime_phase_move")]]
    let unit_value: TypeEnumCase = TypeEnumCase::Unit
    let tuple_value: TypeEnumCase = TypeEnumCase::Tuple(2, 5)
    let record_value: TypeEnumCase = TypeEnumCase::Record { left: 3, right: 4 }
    LogEnumsObject(ctx.fs, scope, "unit_value", "TypeEnumCase::Unit", "constructed", "unit variant value prepared")
    LogEnumsObject(ctx.fs, scope, "tuple_value", "TypeEnumCase::Tuple", "constructed", "tuple variant value prepared")
    LogEnumsObject(ctx.fs, scope, "record_value", "TypeEnumCase::Record", "constructed", "record variant value prepared")

    [[log(label: "types-log-runtime_phase_move")]]
    [[log(label: "types-log-transition_move")]]
    let unit_metric = if unit_value is {
        TypeEnumCase::Unit { 1 }
        TypeEnumCase::Tuple(_, _) { 0 }
        TypeEnumCase::Record { left: _, right: _ } { 0 }
    }
    [[log(label: "types-log-transition_move")]]
    [[log(label: "types-log-transition_move")]]
    let tuple_metric = if tuple_value is {
        TypeEnumCase::Unit { 0 }
        TypeEnumCase::Tuple(a, b) { a + b }
        TypeEnumCase::Record { left: _, right: _ } { 0 }
    }
    [[log(label: "types-log-transition_move")]]
    [[log(label: "types-log-transition_move")]]
    let record_metric = if record_value is {
        TypeEnumCase::Unit { 0 }
        TypeEnumCase::Tuple(_, _) { 0 }
        TypeEnumCase::Record { left: l, right: r } { l + r }
    }
    [[log(label: "types-log-transition_move")]]
    [[log(label: "types-log-transition_move")]]
    let discriminant_metric = if unit_value is {
        TypeEnumCase::Unit { 1 }
        TypeEnumCase::Tuple(_, _) { 0 }
        TypeEnumCase::Record { left: _, right: _ } { 0 }
    } + if tuple_value is {
        TypeEnumCase::Unit { 0 }
        TypeEnumCase::Tuple(_, _) { 2 }
        TypeEnumCase::Record { left: _, right: _ } { 0 }
    } + if record_value is {
        TypeEnumCase::Unit { 0 }
        TypeEnumCase::Tuple(_, _) { 0 }
        TypeEnumCase::Record { left: _, right: _ } { 3 }
    }
    [[log(label: "types-log-transition_move")]]
    [[log(label: "types-log-transition_move")]]
    let exhaustive_metric = if tuple_value is {
        TypeEnumCase::Unit { 0 }
        TypeEnumCase::Tuple(_, _) { 1 }
        TypeEnumCase::Record { left: _, right: _ } { 0 }
    }
    [[log(label: "types-log-transition_move")]]
    let observed_unit_step: string@View = "observed-unit-variant-metric"
    let observed_tuple_step: string@View = "observed-tuple-variant-metric"
    let observed_record_step: string@View = "observed-record-variant-metric"
    let observed_discriminant_step: string@View = "observed-discriminant-metric"
    let observed_exhaustive_step: string@View = "observed-exhaustive-coverage-metric"
    let expected_unit: string@View = "1"
    let expected_tuple: string@View = "7"
    let expected_record: string@View = "7"
    let expected_discriminant: string@View = "6"
    let expected_exhaustive: string@View = "1"
    let unit_metric_label: string@View = EnumsMetricLabel(unit_metric)
    let tuple_metric_label: string@View = EnumsMetricLabel(tuple_metric)
    let record_metric_label: string@View = EnumsMetricLabel(record_metric)
    let discriminant_metric_label: string@View = EnumsMetricLabel(discriminant_metric)
    let exhaustive_metric_label: string@View = EnumsMetricLabel(exhaustive_metric)
    let unit_metric_passed: bool = unit_metric == 1
    let tuple_metric_passed: bool = tuple_metric == 7
    let record_metric_passed: bool = record_metric == 7
    let discriminant_metric_passed: bool = discriminant_metric == 6
    let exhaustive_metric_passed: bool = exhaustive_metric == 1

    let unit_metric_passed_log_actual = [[log(label: "observed-unit-variant-metric", expected: "1")]] unit_metric_label
    let unit_metric_passed_with_log: bool = unit_metric_passed && (unit_metric_passed_log_actual == expected_unit)
    let tuple_metric_passed_log_actual = [[log(label: "observed-tuple-variant-metric", expected: "7")]] tuple_metric_label
    let tuple_metric_passed_with_log: bool = tuple_metric_passed && (tuple_metric_passed_log_actual == expected_tuple)
    let record_metric_passed_log_actual = [[log(label: "observed-record-variant-metric", expected: "7")]] record_metric_label
    let record_metric_passed_with_log: bool = record_metric_passed && (record_metric_passed_log_actual == expected_record)
    let discriminant_metric_passed_log_actual = [[log(label: "observed-discriminant-metric", expected: "6")]] discriminant_metric_label
    let discriminant_metric_passed_with_log: bool = discriminant_metric_passed && (discriminant_metric_passed_log_actual == expected_discriminant)
    let exhaustive_metric_passed_log_actual = [[log(label: "observed-exhaustive-coverage-metric", expected: "1")]] exhaustive_metric_label
    let exhaustive_metric_passed_with_log: bool = exhaustive_metric_passed && (exhaustive_metric_passed_log_actual == expected_exhaustive)
    [[log(label: "types-log-runtime_phase_move")]]
    if (item_index == 0) {
        return RunEnumsItem(
            ctx,
            scope,
            "UnitVariants",
            "unit enum variant declaration and constructor typing",
            "validated unit variant typing",
            "unit-variant",
            "construct and case-analyze enum unit variant",
            "1",
            "1",
            "not-1",
            move unit_metric_passed_with_log,
            "unit variants check failed"
        )
    }

    if (item_index == 1) {
        return RunEnumsItem(
            ctx,
            scope,
            "TupleVariants",
            "tuple payload variant typing and positional constructor checks",
            "validated tuple variant typing",
            "tuple-variant",
            "construct tuple payload variant and destructure it",
            "7",
            "7",
            "not-7",
            move tuple_metric_passed_with_log,
            "tuple variants check failed"
        )
    }

    if (item_index == 2) {
        return RunEnumsItem(
            ctx,
            scope,
            "RecordVariants",
            "record payload variant typing and named-field constructor checks",
            "validated record variant typing",
            "record-variant",
            "construct record payload variant and destructure named fields",
            "7",
            "7",
            "not-7",
            move record_metric_passed_with_log,
            "record variants check failed"
        )
    }

    if (item_index == 3) {
        return RunEnumsItem(
            ctx,
            scope,
            "DiscriminantValues",
            "explicit and implicit discriminant typing and uniqueness constraints",
            "validated discriminant rules",
            "discriminant-identity",
            "distinguish variants through unique case-analysis discriminant mapping",
            "6",
            "6",
            "not-6",
            move discriminant_metric_passed_with_log,
            "discriminant values check failed"
        )
    }

    if (item_index == 4) {
        return RunEnumsItem(
            ctx,
            scope,
            "ExhaustivePatternCoverage",
            "pattern coverage checks and non-exhaustive case-analysis diagnostics for enums",
            "validated enum exhaustiveness behavior",
            "exhaustive-if-is",
            "evaluate fully exhaustive case analysis over all enum variants",
            "1",
            "1",
            "not-1",
            move exhaustive_metric_passed_with_log,
            "exhaustive pattern coverage check failed"
        )
    }

    return RunEnumsItem(
        ctx,
        scope,
        move item_name,
        "unknown enums item",
        "failed unknown enums item",
        "item-resolution",
        "resolve item name within enums feature set",
        "known-item",
        "known-item",
        "unknown-item",
        false,
        "unknown enums item"
    )
}

procedure RunEnums(ctx: Context) -> i32 {
    let scope: string@View = "types::ValueData::Enums"
    let checkpoint: string@View = "covered enums feature items"

    let status_UnitVariants: i32 = VerifyEnumsItem(ctx, scope, 0, "UnitVariants")
    if (status_UnitVariants != 0) {
        return status_UnitVariants
    }

    let status_TupleVariants: i32 = VerifyEnumsItem(ctx, scope, 1, "TupleVariants")
    if (status_TupleVariants != 0) {
        return status_TupleVariants
    }

    let status_RecordVariants: i32 = VerifyEnumsItem(ctx, scope, 2, "RecordVariants")
    if (status_RecordVariants != 0) {
        return status_RecordVariants
    }

    let status_DiscriminantValues: i32 = VerifyEnumsItem(ctx, scope, 3, "DiscriminantValues")
    if (status_DiscriminantValues != 0) {
        return status_DiscriminantValues
    }

    let status_ExhaustivePatternCoverage: i32 = VerifyEnumsItem(ctx, scope, 4, "ExhaustivePatternCoverage")
    if (status_ExhaustivePatternCoverage != 0) {
        return status_ExhaustivePatternCoverage
    }

    [[log(label: "types-log-checkpoint")]]
    return 0
}
