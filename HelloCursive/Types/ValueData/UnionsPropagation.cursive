public type NestedUnionAlias = i32 | bool | i32
type UnionPositiveI32 = i32 |: { self > 0 }
type UnionPositiveI32Alias = i32 |: { self > 0 }

procedure MaybeUnion(value: i32) -> i32 | bool {
    return value
}

procedure AcceptDistinctMembersGeneric<T>(value: T | bool) -> i32 {
    let _ = value
    return 9
}

procedure PropagateUnionValue() -> bool {
    let propagate_input: i32 = 7
    let resolved: i32 = MaybeUnion(propagate_input)?
    return resolved == propagate_input
}

procedure LogUnionObject(
    fs: $FileSystem,
    scope: string@View,
    move object_name: string@View,
    move object_type: string@View,
    move state: string@View,
    move details: string@View
) -> () {
    }

procedure RunUnionsPropagationItem(
    ctx: Context,
    scope: string@View,
    move item_name: string@View,
    move item_details: string@View,
    move item_reason: string@View,
    move step_name: string@View,
    move step_detail: string@View,
    move expected: string@View,
    move actual_pass: string@View,
    move actual_fail: string@View,
    move passed: bool,
    move failure_reason: string@View
) -> i32 {
    let detail_begin: string@View = "type feature item exercise start"
    let phase_running: string@View = "running"
    let phase_step_begin: string@View = "step-begin"
    let phase_step_pass: string@View = "step-pass"
    let phase_step_fail: string@View = "step-fail"
    let reason_pass: string@View = "expected output aligned with actual output"
    let reason_fail: string@View = "expected output did not align with actual output"
    let passed_place: bool = passed

    let item_check_log: bool = passed_place
    let item_check_ok: bool = passed_place && (item_check_log == true)
    if (item_check_ok == false) {
        return 1
    }

    return 0
}

procedure UnionMetricLabel(value: i32) -> string@View {
    if (value == 0) {
        return "0"
    }
    if (value == 1) {
        return "1"
    }
    if (value == 5) {
        return "5"
    }
    if (value == 7) {
        return "7"
    }
    if (value == 9) {
        return "9"
    }
    return "other"
}

procedure VerifyUnionsPropagationItem(ctx: Context, scope: string@View, move item_index: i32, move item_name: string@View) -> i32 {
    let constructed: i32 | bool = 5
    LogUnionObject(ctx.fs, scope, "constructed", "i32|bool", "constructed", "union construction source prepared")
    let construction_metric = if constructed is {
        _: i32 { 5 }
        _: bool { 0 }
    }
    let nested_union: i32 | bool | i32 = 7
    LogUnionObject(ctx.fs, scope, "nested_union", "i32|bool|i32", "constructed", "nested union source prepared for flattening")
    let flattened_union: bool | i32 = nested_union
    let flatten_metric = if flattened_union is {
        _: i32 { 7 }
        _: bool { 0 }
    }
    let alias_nested: NestedUnionAlias = true
    LogUnionObject(ctx.fs, scope, "alias_nested", "NestedUnionAlias", "constructed", "alias-expanded nested union source prepared")
    let normalized: bool | i32 = alias_nested
    let normalize_metric = if normalized is {
        _: bool { 1 }
        _: i32 { 0 }
    }
    let distinct_members_generic_source: i32 | bool | i32 = 9
    LogUnionObject(ctx.fs, scope, "distinct_members_generic_source", "i32|bool|i32", "constructed", "duplicate union source prepared for generic inference")
    let distinct_members_generic_metric: i32 = AcceptDistinctMembersGeneric(distinct_members_generic_source)
    let propagated: bool = PropagateUnionValue()
    let propagate_metric: i32 = if (propagated) { 1 } else { 0 }
    let pattern_union: i32 | bool = true
    LogUnionObject(ctx.fs, scope, "pattern_union", "i32|bool", "constructed", "union pattern narrowing source prepared")
    let pattern_metric = if pattern_union is {
        _: bool { 1 }
        _: i32 { 0 }
    }
    let refined_member: UnionPositiveI32 = 7
    let equivalent_members_union: i32 | bool = refined_member
    let set_members_metric: i32 = if equivalent_members_union is {
        value: i32 { if (value > 0) { 1 } else { 0 } }
        _: bool { 0 }
    }
    let expected_set_members_metric: string@View = "1"
    let set_members_metric_label: string@View = UnionMetricLabel(set_members_metric)
    let set_members_metric_log_actual =
        set_members_metric_label
    let set_members_passed: bool =
        (set_members_metric == 1) &&
        (set_members_metric_log_actual == expected_set_members_metric)
    let observed_construction_step: string@View = "observed-union-construction-metric"
    let observed_flatten_step: string@View = "observed-union-flattening-metric"
    let observed_normalize_step: string@View = "observed-union-normalization-metric"
    let observed_distinct_members_step: string@View = "observed-union-distinct-members-metric"
    let observed_propagate_step: string@View = "observed-union-propagation-metric"
    let observed_pattern_step: string@View = "observed-union-pattern-metric"
    let expected_construction: string@View = "5"
    let expected_flatten: string@View = "7"
    let expected_normalize: string@View = "1"
    let expected_distinct_members: string@View = "9"
    let expected_propagate: string@View = "1"
    let expected_pattern: string@View = "1"
    let construction_metric_label: string@View = UnionMetricLabel(construction_metric)
    let flatten_metric_label: string@View = UnionMetricLabel(flatten_metric)
    let normalize_metric_label: string@View = UnionMetricLabel(normalize_metric)
    let distinct_members_metric_label: string@View = UnionMetricLabel(distinct_members_generic_metric)
    let propagate_metric_label: string@View = UnionMetricLabel(propagate_metric)
    let pattern_metric_label: string@View = UnionMetricLabel(pattern_metric)
    let construction_metric_passed: bool = construction_metric == 5
    let flatten_metric_passed: bool = flatten_metric == 7
    let normalize_metric_passed: bool = normalize_metric == 1
    let distinct_members_metric_passed: bool = distinct_members_generic_metric == 9
    let propagate_metric_passed: bool = propagate_metric == 1
    let pattern_metric_passed: bool = pattern_metric == 1

    let construction_metric_passed_log_actual = construction_metric_label
    let construction_metric_passed_with_log: bool = construction_metric_passed && (construction_metric_passed_log_actual == expected_construction)
    let flatten_metric_passed_log_actual = flatten_metric_label
    let flatten_metric_passed_with_log: bool = flatten_metric_passed && (flatten_metric_passed_log_actual == expected_flatten)
    let normalize_metric_passed_log_actual = normalize_metric_label
    let normalize_metric_passed_with_log: bool = normalize_metric_passed && (normalize_metric_passed_log_actual == expected_normalize)
    let distinct_members_metric_passed_log_actual = distinct_members_metric_label
    let distinct_members_metric_passed_with_log: bool = distinct_members_metric_passed && (distinct_members_metric_passed_log_actual == expected_distinct_members)
    let propagate_metric_passed_log_actual = propagate_metric_label
    let propagate_metric_passed_with_log: bool = propagate_metric_passed && (propagate_metric_passed_log_actual == expected_propagate)
    let pattern_metric_passed_log_actual = pattern_metric_label
    let pattern_metric_passed_with_log: bool = pattern_metric_passed && (pattern_metric_passed_log_actual == expected_pattern)
    if (item_index == 0) {
        return RunUnionsPropagationItem(
            ctx,
            scope,
            "UnionConstruction",
            "union assignment compatibility and order-independent member acceptance",
            "validated union construction typing",
            "union-construction",
            "construct union value and evaluate member-typed case analysis",
            "5",
            "5",
            "not-5",
            move construction_metric_passed_with_log,
            "union construction check failed"
        )
    }

    if (item_index == 1) {
        return RunUnionsPropagationItem(
            ctx,
            scope,
            "UnionFlattening",
            "flattening of nested union members and duplicate member elimination",
            "validated union flattening",
            "union-flattening",
            "assign nested union into flattened equivalent member set",
            "7",
            "7",
            "not-7",
            move flatten_metric_passed_with_log,
            "union flattening check failed"
        )
    }

    if (item_index == 2) {
        return RunUnionsPropagationItem(
            ctx,
            scope,
            "NestedUnionNormalization",
            "normalization across deeply nested unions and alias-expanded unions",
            "validated nested union normalization",
            "union-normalization",
            "normalize alias-expanded union and evaluate narrowed member selection",
            "1",
            "1",
            "not-1",
            move normalize_metric_passed_with_log,
            "nested union normalization check failed"
        )
    }

    if (item_index == 3) {
        return RunUnionsPropagationItem(
            ctx,
            scope,
            "DistinctMembersPreservesFirstOccurrence",
            "distinct-member filtering preserves first surviving union member for downstream generic inference",
            "validated left-to-right duplicate removal for unions",
            "union-distinct-members",
            "infer generic parameter from union after preserving first equivalent member",
            "9",
            "9",
            "not-9",
            move distinct_members_metric_passed_with_log,
            "distinct members first-occurrence check failed"
        )
    }

    if (item_index == 4) {
        return RunUnionsPropagationItem(
            ctx,
            scope,
            "PropagationOperatorTyping",
            "`?` propagation typing over union result channels",
            "validated propagation operator typing",
            "union-propagation-operator",
            "propagate union member through `?` and rewrap as union result",
            "1",
            "1",
            "not-1",
            move propagate_metric_passed_with_log,
            "propagation operator typing check failed"
        )
    }

    if (item_index == 5) {
        return RunUnionsPropagationItem(
            ctx,
            scope,
            "UnionPatternUse",
            "pattern matching and flow-sensitive narrowing over union members",
            "validated union pattern narrowing",
            "union-pattern-narrowing",
            "case-analyze union with typed patterns and narrow active member",
            "1",
            "1",
            "not-1",
            move pattern_metric_passed_with_log,
            "union pattern use check failed"
        )
    }

    if (item_index == 6) {
        return RunUnionsPropagationItem(
            ctx,
            scope,
            "UnionSetMembers",
            "union member sets deduplicate repeated equivalent refinement aliases",
            "validated set-members deduplication by runtime member selection",
            "union-set-members",
            "construct a union through equivalent refinement aliases and confirm one representative member handles the value",
            "1",
            "1",
            "duplicate-equivalent-refinement-members",
            move set_members_passed,
            "set-members equivalent-refinement check failed"
        )
    }

    return RunUnionsPropagationItem(
        ctx,
        scope,
        move item_name,
        "unknown unions/propagation item",
        "failed unknown unions/propagation item",
        "item-resolution",
        "resolve item name within unions/propagation feature set",
        "known-item",
        "known-item",
        "unknown-item",
        false,
        "unknown unions/propagation item"
    )
}

procedure RunUnionsPropagation(ctx: Context) -> i32 {
    let scope: string@View = "types::ValueData::UnionsPropagation"
    let checkpoint: string@View = "covered unions/propagation feature items"

    let status_UnionConstruction: i32 = VerifyUnionsPropagationItem(ctx, scope, 0, "UnionConstruction")
    if (status_UnionConstruction != 0) {
        return status_UnionConstruction
    }

    let status_UnionFlattening: i32 = VerifyUnionsPropagationItem(ctx, scope, 1, "UnionFlattening")
    if (status_UnionFlattening != 0) {
        return status_UnionFlattening
    }

    let status_NestedUnionNormalization: i32 = VerifyUnionsPropagationItem(ctx, scope, 2, "NestedUnionNormalization")
    if (status_NestedUnionNormalization != 0) {
        return status_NestedUnionNormalization
    }

    let status_DistinctMembersPreservesFirstOccurrence: i32 = VerifyUnionsPropagationItem(ctx, scope, 3, "DistinctMembersPreservesFirstOccurrence")
    if (status_DistinctMembersPreservesFirstOccurrence != 0) {
        return status_DistinctMembersPreservesFirstOccurrence
    }

    let status_PropagationOperatorTyping: i32 = VerifyUnionsPropagationItem(ctx, scope, 4, "PropagationOperatorTyping")
    if (status_PropagationOperatorTyping != 0) {
        return status_PropagationOperatorTyping
    }

    let status_UnionPatternUse: i32 = VerifyUnionsPropagationItem(ctx, scope, 5, "UnionPatternUse")
    if (status_UnionPatternUse != 0) {
        return status_UnionPatternUse
    }

    let status_UnionSetMembers: i32 = VerifyUnionsPropagationItem(ctx, scope, 6, "UnionSetMembers")
    if (status_UnionSetMembers != 0) {
        return status_UnionSetMembers
    }

    return 0
}
