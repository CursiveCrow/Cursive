procedure AcceptSliceView(view: [i32]) -> i32 {
    let _ = view
    return 1
}

[[dynamic, mangle("hc_types_slice_index_catch"), export("C-unwind"), unwind("catch")]]
public procedure SliceIndexCatch(index: usize) -> i32
    |: true
{
    let values: [i32; 4] = [1, 2, 3, 4]
    let view: [i32] = values
    return view[index]
}

extern "C" {
    procedure hc_types_slice_index_catch(index: usize) -> i32
}

[[dynamic, mangle("hc_types_range_index_catch"), export("C-unwind"), unwind("catch")]]
public procedure RangeIndexCatch(start: usize, end: usize) -> i32
    |: true
{
    let values: [i32; 5] = [1, 2, 3, 4, 5]
    let view: [i32] = values
    let window: [i32] = view[start..end]
    return window[1usize]
}

extern "C" {
    procedure hc_types_range_index_catch(start: usize, end: usize) -> i32
}

procedure AdvanceTupleEvalOrder(counter: *mut i32, move digit: i32) -> i32 {
    var counter_mut: *mut i32 = counter
    let next: i32 = unsafe {
        let prior: i32 = *counter_mut
        let advanced: i32 = (prior * 10) + digit
        *counter_mut = advanced
        advanced
    }
    return next
}

procedure AdvanceArrayEvalOrder(counter: *mut i32, move digit: i32) -> i32 {
    var counter_mut: *mut i32 = counter
    let next: i32 = unsafe {
        let prior: i32 = *counter_mut
        let advanced: i32 = (prior * 10) + digit
        *counter_mut = advanced
        advanced
    }
    return next
}

procedure EvaluateTupleControlProbe(counter: *mut i32) -> i32 {
    var counter_mut: *mut i32 = counter
    let emit_control: bool = true
    let _tuple_probe = (
        AdvanceTupleEvalOrder(counter_mut, 4),
        if (emit_control) { return 17 } else { AdvanceTupleEvalOrder(counter_mut, 5) },
        AdvanceTupleEvalOrder(counter_mut, 6)
    )
    unsafe {
        *counter_mut = 999
    }
    return 0
}

procedure EvaluateArrayControlProbe(counter: *mut i32) -> i32 {
    var counter_mut: *mut i32 = counter
    let emit_control: bool = true
    let _array_probe: [i32; 3] = [
        AdvanceArrayEvalOrder(counter_mut, 4),
        if (emit_control) { return 17 } else { AdvanceArrayEvalOrder(counter_mut, 5) },
        AdvanceArrayEvalOrder(counter_mut, 6)
    ]
    unsafe {
        *counter_mut = 999
    }
    return 0
}

record TupleParenRecordProbe {
    left: i32
    right: i32
}

procedure ParenthesizedNonParenDelimiterMetric() -> i32 {
    let array_metric: i32 = ([7, 11])[0usize]
    let record_left: i32 = (TupleParenRecordProbe { left: 4, right: 6 }).left
    let record_right: i32 = (TupleParenRecordProbe { left: 4, right: 6 }).right
    return array_metric + record_left + record_right
}

procedure LogCompoundObject(
    fs: $FileSystem,
    scope: string@View,
    move object_name: string@View,
    move object_type: string@View,
    move state: string@View,
    move details: string@View
) -> () {
    [[log(label: "types-log-object")]]
}

procedure RunTuplesArraysSlicesRangesItem(
    ctx: Context,
    scope: string@View,
    move item_name: string@View,
    move item_details: string@View,
    move item_reason: string@View,
    move step_name: string@View,
    move step_detail: string@View,
    move expected: string@View,
    move actual_pass: string@View,
    move actual_fail: string@View,
    move passed: bool,
    move failure_reason: string@View
) -> i32 {
    let detail_begin: string@View = "type feature item exercise start"
    [[log(label: "types-log-item_begin")]]
    let phase_running: string@View = "running"
    let phase_step_begin: string@View = "step-begin"
    let phase_step_pass: string@View = "step-pass"
    let phase_step_fail: string@View = "step-fail"
    let reason_pass: string@View = "expected output aligned with actual output"
    let reason_fail: string@View = "expected output did not align with actual output"
    let passed_place: bool = passed

    [[log(label: "types-log-runtime_phase")]]
    let item_check_log: bool = [[log(label: "observed-item-check-pass", expected: true)]] passed_place
    let item_check_ok: bool = passed_place && (item_check_log == true)
    if (item_check_ok == false) {
        [[log(label: "types-log-transition")]]
        [[log(label: "types-log-item_fail")]]
        return 1
    }

    [[log(label: "types-log-transition")]]
    [[log(label: "types-log-types_item_success")]]
    return 0
}

procedure CompoundMetricLabel(value: i32) -> string@View {
    if (value == 0) {
        return "0"
    }
    if (value == 2) {
        return "2"
    }
    if (value == 5) {
        return "5"
    }
    if (value == 6) {
        return "6"
    }
    if (value == 10) {
        return "10"
    }
    if (value == 14) {
        return "14"
    }
    if (value == 17) {
        return "17"
    }
    if (value == 259) {
        return "259"
    }
    return "other"
}

procedure VerifyTuplesArraysSlicesRangesItem(ctx: Context, scope: string@View, move item_index: i32, move item_name: string@View) -> i32 {
    [[log(label: "types-log-runtime_phase_move")]]
    let tuple_pair: (i32, bool) = (7, true)
    let tuple_single: (i32;) = (7;)
    LogCompoundObject(ctx.fs, scope, "tuple_pair", "(i32,bool)", "constructed", "tuple form source prepared")
    LogCompoundObject(ctx.fs, scope, "tuple_single", "(i32;)", "constructed", "singleton tuple source prepared")

    [[log(label: "types-log-runtime_phase_move")]]
    [[log(label: "types-log-transition_move")]]
    [[log(label: "types-log-transition_move")]]
    let tuple_total: i32 = tuple_pair.0 + tuple_single.0
    [[log(label: "types-log-transition_move")]]
    [[log(label: "types-log-transition_move")]]
    let arr: [i32; 4] = [1, 2, 3, 4]
    LogCompoundObject(ctx.fs, scope, "arr", "[i32;4]", "constructed", "fixed-size array source prepared")
    [[log(label: "types-log-transition_move")]]
    let array_total: i32 = arr[0] + arr[1] + arr[2]
    [[log(label: "types-log-transition_move")]]
    let slice_view: [i32] = arr
    LogCompoundObject(ctx.fs, scope, "slice_view", "[i32]", "constructed", "slice view derived from array prepared")
    [[log(label: "types-log-transition_move")]]
    let slice_presence: i32 = AcceptSliceView(slice_view)
    let slice_total: i32 = if (slice_presence == 1) { slice_view[1usize] + slice_view[2usize] } else { 0 }
    let slice_catch_in_bounds_metric: i32 = unsafe {
        hc_types_slice_index_catch(3usize)
    }
    let slice_catch_oob_metric: i32 = unsafe {
        hc_types_slice_index_catch(9usize)
    }
    [[log(label: "types-log-transition_move")]]
    let range_source: i32 = 3
    LogCompoundObject(ctx.fs, scope, "range_source", "i32", "constructed", "range pattern source scalar prepared")
    [[log(label: "types-log-transition_move")]]
    let range_pattern_metric: i32 = if range_source is {
        1..=3 { 2 }
        _ { 0 }
    }
    let range_window_from_array: [i32] = arr[1usize..4usize]
    LogCompoundObject(ctx.fs, scope, "range_window_from_array", "[i32]", "constructed", "range slice derived from array prepared")
    let range_window_from_slice: [i32] = slice_view[0usize..2usize]
    LogCompoundObject(ctx.fs, scope, "range_window_from_slice", "[i32]", "constructed", "range slice derived from slice prepared")
    let range_slice_metric: i32 =
        range_window_from_array[0usize] +
        range_window_from_array[2usize] +
        range_window_from_slice[1usize]
    let range_catch_in_bounds_metric: i32 = unsafe {
        hc_types_range_index_catch(1usize, 4usize)
    }
    let range_catch_oob_metric: i32 = unsafe {
        hc_types_range_index_catch(3usize, 9usize)
    }
    let range_metric: i32 = range_pattern_metric + range_slice_metric
    [[log(label: "types-log-transition_move")]]
    let nested: ((i32, i32), [i32; 2]) = ((2, 3), [4, 5])
    LogCompoundObject(ctx.fs, scope, "nested", "((i32,i32),[i32;2])", "constructed", "nested compound composition source prepared")
    [[log(label: "types-log-transition_move")]]
    let nested_total: i32 = nested.0.0 + nested.0.1 + nested.1[0] + nested.1[1]
    [[log(label: "types-log-transition_move")]]
    var tuple_eval_order: i32 = 0
    let tuple_eval_ptr: Ptr<i32>@Valid = &tuple_eval_order
    var tuple_eval_raw: *mut i32 =
        unsafe { transmute<Ptr<i32>@Valid, *mut i32>(tuple_eval_ptr) }
    let tuple_eval_value: (i32, i32, i32) = (
        AdvanceTupleEvalOrder(tuple_eval_raw, 1),
        AdvanceTupleEvalOrder(tuple_eval_raw, 2),
        AdvanceTupleEvalOrder(tuple_eval_raw, 3)
    )
    LogCompoundObject(ctx.fs, scope, "tuple_eval_value", "(i32,i32,i32)", "constructed", "tuple evaluation-order probe prepared")
    [[log(label: "types-log-transition_move")]]
    let tuple_eval_metric: i32 =
        tuple_eval_value.0 + tuple_eval_value.1 + tuple_eval_value.2 + tuple_eval_order
    [[log(label: "types-log-transition_move")]]
    var tuple_ctrl_order: i32 = 0
    let tuple_ctrl_ptr: Ptr<i32>@Valid = &tuple_ctrl_order
    var tuple_ctrl_raw: *mut i32 =
        unsafe { transmute<Ptr<i32>@Valid, *mut i32>(tuple_ctrl_ptr) }
    let tuple_ctrl_result: i32 = EvaluateTupleControlProbe(tuple_ctrl_raw)
    [[log(label: "types-log-transition_move")]]
    var array_eval_order: i32 = 0
    let array_eval_ptr: Ptr<i32>@Valid = &array_eval_order
    var array_eval_raw: *mut i32 =
        unsafe { transmute<Ptr<i32>@Valid, *mut i32>(array_eval_ptr) }
    let array_eval_value: [i32; 3] = [
        AdvanceArrayEvalOrder(array_eval_raw, 1),
        AdvanceArrayEvalOrder(array_eval_raw, 2),
        AdvanceArrayEvalOrder(array_eval_raw, 3)
    ]
    LogCompoundObject(ctx.fs, scope, "array_eval_value", "[i32;3]", "constructed", "array evaluation-order probe prepared")
    [[log(label: "types-log-transition_move")]]
    let array_eval_metric: i32 =
        array_eval_value[0] + array_eval_value[1] + array_eval_value[2] + array_eval_order
    [[log(label: "types-log-transition_move")]]
    var array_ctrl_order: i32 = 0
    let array_ctrl_ptr: Ptr<i32>@Valid = &array_ctrl_order
    var array_ctrl_raw: *mut i32 =
        unsafe { transmute<Ptr<i32>@Valid, *mut i32>(array_ctrl_ptr) }
    let array_ctrl_result: i32 = EvaluateArrayControlProbe(array_ctrl_raw)
    [[log(label: "types-log-transition_move")]]
    let observed_tuple_step: string@View = "observed-tuple-forms-metric"
    let observed_array_step: string@View = "observed-array-forms-metric"
    let observed_slice_step: string@View = "observed-slice-forms-metric"
    let observed_range_step: string@View = "observed-range-forms-metric"
    let observed_nested_step: string@View = "observed-nested-compound-metric"
    let observed_tuple_eval_step: string@View = "observed-tuple-eval-order-metric"
    let observed_tuple_ctrl_step: string@View = "observed-tuple-control-propagation-metric"
    let observed_array_eval_step: string@View = "observed-array-eval-order-metric"
    let observed_array_ctrl_step: string@View = "observed-array-control-propagation-metric"
    let observed_tuple_paren_non_paren_step: string@View =
        "observed-tuple-paren-non-paren-delimiter-metric"
    let expected_tuple: string@View = "14"
    let expected_array: string@View = "6"
    let expected_slice: string@View = "5"
    let expected_range: string@View = "10"
    let expected_nested: string@View = "14"
    let expected_tuple_eval: string@View = "259"
    let expected_tuple_ctrl: string@View = "17"
    let expected_array_eval: string@View = "259"
    let expected_array_ctrl: string@View = "17"
    let expected_tuple_paren_non_paren: string@View = "17"
    let tuple_metric_label: string@View = CompoundMetricLabel(tuple_total)
    let array_metric_label: string@View = CompoundMetricLabel(array_total)
    let slice_metric_label: string@View = CompoundMetricLabel(slice_total)
    let range_metric_label: string@View = CompoundMetricLabel(range_metric)
    let nested_metric_label: string@View = CompoundMetricLabel(nested_total)
    let tuple_eval_metric_label: string@View = CompoundMetricLabel(tuple_eval_metric)
    let tuple_ctrl_metric_label: string@View = CompoundMetricLabel(tuple_ctrl_result)
    let array_eval_metric_label: string@View = CompoundMetricLabel(array_eval_metric)
    let array_ctrl_metric_label: string@View = CompoundMetricLabel(array_ctrl_result)
    let tuple_paren_non_paren_metric: i32 = ParenthesizedNonParenDelimiterMetric()
    let tuple_paren_non_paren_metric_label: string@View =
        CompoundMetricLabel(tuple_paren_non_paren_metric)
    let tuple_metric_passed: bool = tuple_total == 14
    let array_metric_passed: bool = array_total == 6
    let slice_catch_in_bounds_metric_log: i32 =
        [[log(label: "observed-slice-index-catch-in-bounds-metric", expected: 4)]]
        slice_catch_in_bounds_metric
    let slice_catch_oob_metric_log: i32 =
        [[log(label: "observed-slice-index-catch-oob-metric", expected: 0)]]
        slice_catch_oob_metric
    let slice_catch_passed: bool =
        (slice_catch_in_bounds_metric_log == 4) &&
        (slice_catch_oob_metric_log == 0)
    let slice_catch_passed_with_log: bool =
        [[log(label: "observed-slice-index-catch-bounds", expected: true)]]
        slice_catch_passed
    let slice_metric_passed: bool = (slice_total == 5) && slice_catch_passed_with_log
    let range_catch_in_bounds_metric_log: i32 =
        [[log(label: "observed-range-index-catch-in-bounds-metric", expected: 3)]]
        range_catch_in_bounds_metric
    let range_catch_oob_metric_log: i32 =
        [[log(label: "observed-range-index-catch-oob-metric", expected: 0)]]
        range_catch_oob_metric
    let range_catch_passed: bool =
        (range_catch_in_bounds_metric_log == 3) &&
        (range_catch_oob_metric_log == 0)
    let range_catch_passed_with_log: bool =
        [[log(label: "observed-range-index-catch-bounds", expected: true)]]
        range_catch_passed
    let range_metric_passed: bool = (range_metric == 10) && range_catch_passed_with_log
    let nested_metric_passed: bool = nested_total == 14
    let tuple_eval_metric_passed: bool =
        (tuple_eval_metric == 259) &&
        (tuple_eval_order == 123) &&
        (tuple_eval_value.0 == 1) &&
        (tuple_eval_value.1 == 12) &&
        (tuple_eval_value.2 == 123)
    let tuple_ctrl_metric_passed: bool =
        (tuple_ctrl_result == 17) &&
        (tuple_ctrl_order == 4)
    let array_eval_metric_passed: bool =
        (array_eval_metric == 259) &&
        (array_eval_order == 123) &&
        (array_eval_value[0] == 1) &&
        (array_eval_value[1] == 12) &&
        (array_eval_value[2] == 123)
    let array_ctrl_metric_passed: bool =
        (array_ctrl_result == 17) &&
        (array_ctrl_order == 4)
    let tuple_paren_non_paren_metric_passed: bool =
        tuple_paren_non_paren_metric == 17

    let tuple_metric_passed_log_actual = [[log(label: "observed-tuple-forms-metric", expected: "14")]] tuple_metric_label
    let tuple_metric_passed_with_log: bool = tuple_metric_passed && (tuple_metric_passed_log_actual == expected_tuple)
    let array_metric_passed_log_actual = [[log(label: "observed-array-forms-metric", expected: "6")]] array_metric_label
    let array_metric_passed_with_log: bool = array_metric_passed && (array_metric_passed_log_actual == expected_array)
    let slice_metric_passed_log_actual = [[log(label: "observed-slice-forms-metric", expected: "5")]] slice_metric_label
    let slice_metric_passed_with_log: bool = slice_metric_passed && (slice_metric_passed_log_actual == expected_slice)
    let range_metric_passed_log_actual = [[log(label: "observed-range-forms-metric", expected: "10")]] range_metric_label
    let range_metric_passed_with_log: bool = range_metric_passed && (range_metric_passed_log_actual == expected_range)
    let nested_metric_passed_log_actual = [[log(label: "observed-nested-compound-metric", expected: "14")]] nested_metric_label
    let nested_metric_passed_with_log: bool = nested_metric_passed && (nested_metric_passed_log_actual == expected_nested)
    let tuple_eval_metric_passed_log_actual = [[log(label: "observed-tuple-eval-order-metric", expected: "259")]] tuple_eval_metric_label
    let tuple_eval_metric_passed_with_log: bool =
        tuple_eval_metric_passed && (tuple_eval_metric_passed_log_actual == expected_tuple_eval)
    let tuple_ctrl_metric_passed_log_actual =
        [[log(label: "observed-tuple-control-propagation-metric", expected: "17")]] tuple_ctrl_metric_label
    let tuple_ctrl_metric_passed_with_log: bool =
        tuple_ctrl_metric_passed && (tuple_ctrl_metric_passed_log_actual == expected_tuple_ctrl)
    let array_eval_metric_passed_log_actual =
        [[log(label: "observed-array-eval-order-metric", expected: "259")]] array_eval_metric_label
    let array_eval_metric_passed_with_log: bool =
        array_eval_metric_passed && (array_eval_metric_passed_log_actual == expected_array_eval)
    let array_ctrl_metric_passed_log_actual =
        [[log(label: "observed-array-control-propagation-metric", expected: "17")]] array_ctrl_metric_label
    let array_ctrl_metric_passed_with_log: bool =
        array_ctrl_metric_passed && (array_ctrl_metric_passed_log_actual == expected_array_ctrl)
    let tuple_paren_non_paren_metric_passed_log_actual =
        [[log(label: "observed-tuple-paren-non-paren-delimiter-metric", expected: "17")]] tuple_paren_non_paren_metric_label
    let tuple_paren_non_paren_metric_passed_with_log: bool =
        tuple_paren_non_paren_metric_passed &&
        (tuple_paren_non_paren_metric_passed_log_actual == expected_tuple_paren_non_paren)
    [[log(label: "types-log-runtime_phase_move")]]
    if (item_index == 0) {
        return RunTuplesArraysSlicesRangesItem(
            ctx,
            scope,
            "TupleForms",
            "tuple arity typing including singleton tuple `(T;)` rules",
            "validated tuple form typing",
            "tuple-forms",
            "construct tuple and singleton tuple and evaluate positional projection",
            "14",
            "14",
            "not-14",
            move tuple_metric_passed_with_log,
            "tuple forms check failed"
        )
    }

    if (item_index == 1) {
        return RunTuplesArraysSlicesRangesItem(
            ctx,
            scope,
            "ArrayForms",
            "fixed-size array element typing and compile-time length conformance",
            "validated array forms",
            "array-forms",
            "construct fixed-size array and evaluate typed index access",
            "6",
            "6",
            "not-6",
            move array_metric_passed_with_log,
            "array forms check failed"
        )
    }

    if (item_index == 2) {
        return RunTuplesArraysSlicesRangesItem(
            ctx,
            scope,
            "SliceForms",
            "slice view typing from arrays plus direct scalar slice indexing and bounds panic behavior",
            "validated slice typing and runtime index semantics",
            "slice-forms",
            "construct slice view, index it directly, and verify the catch-boundary bounds surface",
            "5",
            "5",
            "not-5",
            move slice_metric_passed_with_log,
            "slice forms check failed"
        )
    }

    if (item_index == 3) {
        return RunTuplesArraysSlicesRangesItem(
            ctx,
            scope,
            "RangeForms",
            "range literal and range-expression typing for inclusive/exclusive bounds plus range-based slicing over arrays and slices",
            "validated range forms",
            "range-forms",
            "evaluate range-based indexing semantics, derived slice metrics, and catch-boundary panic behavior",
            "10",
            "10",
            "not-10",
            move range_metric_passed_with_log,
            "range forms check failed"
        )
    }

    if (item_index == 4) {
        return RunTuplesArraysSlicesRangesItem(
            ctx,
            scope,
            "NestedCompoundComposition",
            "nested tuple/array/slice compositions and recursive type compatibility",
            "validated nested compound composition",
            "nested-compound",
            "compose nested tuple and array shapes and evaluate nested projections",
            "14",
            "14",
            "not-14",
            move nested_metric_passed_with_log,
            "nested compound composition check failed"
        )
    }

    if (item_index == 5) {
        return RunTuplesArraysSlicesRangesItem(
            ctx,
            scope,
            "TupleEvaluationOrder",
            "tuple literal elements evaluate left-to-right and materialize stable temporary aggregates",
            "validated tuple dynamic evaluation semantics",
            "tuple-eval-order",
            "construct tuple from ordered side effects and verify aggregate plus final order state",
            "259",
            "259",
            "not-259",
            move tuple_eval_metric_passed_with_log,
            "tuple evaluation-order check failed"
        )
    }

    if (item_index == 6) {
        return RunTuplesArraysSlicesRangesItem(
            ctx,
            scope,
            "TupleControlPropagation",
            "tuple literal evaluation propagates control from an element and does not evaluate later elements",
            "validated tuple control propagation semantics",
            "tuple-control-propagation",
            "evaluate tuple with a returning middle element and verify later element and trailing code do not run",
            "17",
            "17",
            "not-17",
            move tuple_ctrl_metric_passed_with_log,
            "tuple control propagation check failed"
        )
    }

    if (item_index == 7) {
        return RunTuplesArraysSlicesRangesItem(
            ctx,
            scope,
            "ArrayEvaluationOrder",
            "array literal elements evaluate left-to-right and materialize a stable fixed-size aggregate",
            "validated EvalSigma-Array dynamic semantics",
            "array-eval-order",
            "construct array from ordered side effects and verify aggregate plus final order state",
            "259",
            "259",
            "not-259",
            move array_eval_metric_passed_with_log,
            "array evaluation-order check failed"
        )
    }

    if (item_index == 8) {
        return RunTuplesArraysSlicesRangesItem(
            ctx,
            scope,
            "ArrayControlPropagation",
            "array literal evaluation propagates control from an element and does not evaluate later elements",
            "validated EvalSigma-Array-Ctrl dynamic semantics",
            "array-control-propagation",
            "evaluate array literal with a returning middle element and verify later element and trailing code do not run",
            "17",
            "17",
            "not-17",
            move array_ctrl_metric_passed_with_log,
            "array control propagation check failed"
        )
    }

    if (item_index == 9) {
        return RunTuplesArraysSlicesRangesItem(
            ctx,
            scope,
            "TupleParenNonParenDelimiters",
            "tuple-vs-parenthesized disambiguation ignores commas nested inside non-paren delimiters while preserving parenthesized array and record expressions",
            "validated parenthesized-expression scanning around nested `[]` and `{}` delimiters",
            "tuple-paren-non-paren-delimiters",
            "evaluate parenthesized array and record expressions whose inner commas must not be treated as outer tuple separators",
            "17",
            "17",
            "not-17",
            move tuple_paren_non_paren_metric_passed_with_log,
            "tuple-vs-parenthesized disambiguation with nested non-paren delimiters check failed"
        )
    }

    return RunTuplesArraysSlicesRangesItem(
        ctx,
        scope,
        move item_name,
        "unknown tuples/arrays/slices/ranges item",
        "failed unknown tuples/arrays/slices/ranges item",
        "item-resolution",
        "resolve item name within tuples/arrays/slices/ranges feature set",
        "known-item",
        "known-item",
        "unknown-item",
        false,
        "unknown tuples/arrays/slices/ranges item"
    )
}

procedure RunTuplesArraysSlicesRanges(ctx: Context) -> i32 {
    let scope: string@View = "types::ValueData::TuplesArraysSlicesRanges"
    let checkpoint: string@View = "covered tuples/arrays/slices/ranges feature items"

    let status_TupleForms: i32 = VerifyTuplesArraysSlicesRangesItem(ctx, scope, 0, "TupleForms")
    if (status_TupleForms != 0) {
        return status_TupleForms
    }

    let status_ArrayForms: i32 = VerifyTuplesArraysSlicesRangesItem(ctx, scope, 1, "ArrayForms")
    if (status_ArrayForms != 0) {
        return status_ArrayForms
    }

    let status_SliceForms: i32 = VerifyTuplesArraysSlicesRangesItem(ctx, scope, 2, "SliceForms")
    if (status_SliceForms != 0) {
        return status_SliceForms
    }

    let status_RangeForms: i32 = VerifyTuplesArraysSlicesRangesItem(ctx, scope, 3, "RangeForms")
    if (status_RangeForms != 0) {
        return status_RangeForms
    }

    let status_NestedCompoundComposition: i32 = VerifyTuplesArraysSlicesRangesItem(ctx, scope, 4, "NestedCompoundComposition")
    if (status_NestedCompoundComposition != 0) {
        return status_NestedCompoundComposition
    }

    let status_TupleEvaluationOrder: i32 = VerifyTuplesArraysSlicesRangesItem(ctx, scope, 5, "TupleEvaluationOrder")
    if (status_TupleEvaluationOrder != 0) {
        return status_TupleEvaluationOrder
    }

    let status_TupleControlPropagation: i32 = VerifyTuplesArraysSlicesRangesItem(ctx, scope, 6, "TupleControlPropagation")
    if (status_TupleControlPropagation != 0) {
        return status_TupleControlPropagation
    }

    let status_ArrayEvaluationOrder: i32 = VerifyTuplesArraysSlicesRangesItem(ctx, scope, 7, "ArrayEvaluationOrder")
    if (status_ArrayEvaluationOrder != 0) {
        return status_ArrayEvaluationOrder
    }

    let status_ArrayControlPropagation: i32 = VerifyTuplesArraysSlicesRangesItem(ctx, scope, 8, "ArrayControlPropagation")
    if (status_ArrayControlPropagation != 0) {
        return status_ArrayControlPropagation
    }

    let status_TupleParenNonParenDelimiters: i32 = VerifyTuplesArraysSlicesRangesItem(ctx, scope, 9, "TupleParenNonParenDelimiters")
    if (status_TupleParenNonParenDelimiters != 0) {
        return status_TupleParenNonParenDelimiters
    }

    [[log(label: "types-log-checkpoint")]]
    return 0
}
