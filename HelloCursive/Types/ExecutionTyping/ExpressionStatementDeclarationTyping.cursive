procedure EvaluateExpressionMatrix(base: i32) -> i32 {
    return (base + 3) * 2
}

procedure LogExprStmtObject(
    fs: $FileSystem,
    scope: string@View,
    move object_name: string@View,
    move object_type: string@View,
    move state: string@View,
    move details: string@View
) -> () {
    }

procedure RunExpressionStatementDeclarationTypingItem(
    ctx: Context,
    scope: string@View,
    move item_name: string@View,
    move item_details: string@View,
    move item_reason: string@View,
    move step_name: string@View,
    move step_detail: string@View,
    move expected: string@View,
    move actual_pass: string@View,
    move actual_fail: string@View,
    move passed: bool,
    move failure_reason: string@View
) -> i32 {
    let detail_begin: string@View = "type feature item exercise start"
    let phase_running: string@View = "running"
    let phase_step_begin: string@View = "step-begin"
    let phase_step_pass: string@View = "step-pass"
    let phase_step_fail: string@View = "step-fail"
    let reason_pass: string@View = "expected output aligned with actual output"
    let reason_fail: string@View = "expected output did not align with actual output"
    let passed_place: bool = passed

    let item_check_log: bool = passed_place
    let item_check_ok: bool = passed_place && (item_check_log == true)
    if (item_check_ok == false) {
        return 1
    }

    return 0
}

procedure ExprStmtMetricLabel(value: i32) -> string@View {
    if (value == 0) {
        return "0"
    }
    if (value == 1) {
        return "1"
    }
    if (value == 7) {
        return "7"
    }
    if (value == 10) {
        return "10"
    }
    return "other"
}

procedure VerifyExpressionStatementDeclarationTypingItem(ctx: Context, scope: string@View, move item_index: i32, move item_name: string@View) -> i32 {
    let expr_input: i32 = 2
    LogExprStmtObject(ctx.fs, scope, "expr_input", "i32", "constructed", "expression typing matrix input prepared")

    let expr_metric: i32 = EvaluateExpressionMatrix(expr_input)
    let shadow_seed: i32 = 3
    LogExprStmtObject(ctx.fs, scope, "shadow_seed", "i32", "constructed", "alias source binding prepared")
    let shadow_metric: i32 = {
        let shadow_seed_inner: i32 = shadow_seed + 4
        shadow_seed_inner
    }
    let binding_next: i32 = shadow_metric
    var assign_value: i32 = 5
    LogExprStmtObject(ctx.fs, scope, "assign_value", "var i32", "constructed", "mutable assignment target prepared")
    assign_value = assign_value + 2
    let assign_metric: i32 = assign_value
    let block_metric: i32 = if (binding_next == 7) {
        let block_left: i32 = 2
        let block_right: i32 = 5
        block_left + block_right
    } else {
        0
    }
    let join_value: i32 = if (binding_next == 7) { 7 } else { 0 }
    let join_metric: i32 = if (join_value == 7) { 1 } else { 0 }
    let observed_expr_step: string@View = "observed-expression-matrix-metric"
    let observed_binding_step: string@View = "observed-let-var-shadow-metric"
    let observed_assignment_step: string@View = "observed-assignment-typing-metric"
    let observed_block_step: string@View = "observed-block-result-metric"
    let observed_join_step: string@View = "observed-control-flow-join-metric"
    let expected_expr: string@View = "10"
    let expected_binding: string@View = "7"
    let expected_assignment: string@View = "7"
    let expected_block: string@View = "7"
    let expected_join: string@View = "1"
    let expr_metric_label: string@View = ExprStmtMetricLabel(expr_metric)
    let binding_metric_label: string@View = ExprStmtMetricLabel(binding_next)
    let assignment_metric_label: string@View = ExprStmtMetricLabel(assign_metric)
    let block_metric_label: string@View = ExprStmtMetricLabel(block_metric)
    let join_metric_label: string@View = ExprStmtMetricLabel(join_metric)
    let expr_metric_passed: bool = expr_metric == 10
    let binding_metric_passed: bool = binding_next == 7
    let assignment_metric_passed: bool = assign_metric == 7
    let block_metric_passed: bool = block_metric == 7
    let join_metric_passed: bool = join_metric == 1

    let expr_metric_passed_log_actual = expr_metric_label
    let expr_metric_passed_with_log: bool = expr_metric_passed && (expr_metric_passed_log_actual == expected_expr)
    let binding_metric_passed_log_actual = binding_metric_label
    let binding_metric_passed_with_log: bool = binding_metric_passed && (binding_metric_passed_log_actual == expected_binding)
    let assignment_metric_passed_log_actual = assignment_metric_label
    let assignment_metric_passed_with_log: bool = assignment_metric_passed && (assignment_metric_passed_log_actual == expected_assignment)
    let block_metric_passed_log_actual = block_metric_label
    let block_metric_passed_with_log: bool = block_metric_passed && (block_metric_passed_log_actual == expected_block)
    let join_metric_passed_log_actual = join_metric_label
    let join_metric_passed_with_log: bool = join_metric_passed && (join_metric_passed_log_actual == expected_join)
    if (item_index == 0) {
        return RunExpressionStatementDeclarationTypingItem(
            ctx,
            scope,
            "ExpressionTypingMatrix",
            "expression category typing including operators, blocks, and calls",
            "validated expression typing matrix",
            "expression-matrix",
            "evaluate arithmetic expression typing across composed operators",
            "10",
            "10",
            "not-10",
            move expr_metric_passed_with_log,
            "expression typing matrix check failed"
        )
    }

    if (item_index == 1) {
        return RunExpressionStatementDeclarationTypingItem(
            ctx,
            scope,
            "LetVarShadowDeclarations",
            "let/var declaration typing and shadowing legality constraints",
            "validated let/var/shadow declaration typing",
            "let-var-bindings",
            "evaluate typed let bindings with block-scoped shadowing",
            "7",
            "7",
            "not-7",
            move binding_metric_passed_with_log,
            "let/var/shadow declarations check failed"
        )
    }

    if (item_index == 2) {
        return RunExpressionStatementDeclarationTypingItem(
            ctx,
            scope,
            "AssignmentTyping",
            "assignment target/value compatibility and permission-aware mutation checks",
            "validated assignment typing",
            "assignment-typing",
            "mutate typed var binding through assignment expression",
            "7",
            "7",
            "not-7",
            move assignment_metric_passed_with_log,
            "assignment typing check failed"
        )
    }

    if (item_index == 3) {
        return RunExpressionStatementDeclarationTypingItem(
            ctx,
            scope,
            "BlockResultTyping",
            "block final-expression typing and statement/result interaction",
            "validated block result typing",
            "block-result",
            "evaluate block tail expression and resulting block type",
            "7",
            "7",
            "not-7",
            move block_metric_passed_with_log,
            "block result typing check failed"
        )
    }

    if (item_index == 4) {
        return RunExpressionStatementDeclarationTypingItem(
            ctx,
            scope,
            "ControlFlowJoinTyping",
            "if/if-is/loop branch join typing and never-type interactions",
            "validated control-flow join typing",
            "control-flow-join",
            "evaluate if-expression branch join to unified result type",
            "1",
            "1",
            "not-1",
            move join_metric_passed_with_log,
            "control-flow join typing check failed"
        )
    }

    return RunExpressionStatementDeclarationTypingItem(
        ctx,
        scope,
        move item_name,
        "unknown expression/statement/declaration typing item",
        "failed unknown expression/statement/declaration typing item",
        "item-resolution",
        "resolve item name within expression/statement/declaration typing feature set",
        "known-item",
        "known-item",
        "unknown-item",
        false,
        "unknown expression/statement/declaration typing item"
    )
}

procedure RunExpressionStatementDeclarationTyping(ctx: Context) -> i32 {
    let scope: string@View = "types::ExecutionTyping::ExpressionStatementDeclarationTyping"
    let checkpoint: string@View = "covered expression/statement/declaration typing feature items"

    let status_ExpressionTypingMatrix: i32 = VerifyExpressionStatementDeclarationTypingItem(ctx, scope, 0, "ExpressionTypingMatrix")
    if (status_ExpressionTypingMatrix != 0) {
        return status_ExpressionTypingMatrix
    }

    let status_LetVarShadowDeclarations: i32 = VerifyExpressionStatementDeclarationTypingItem(ctx, scope, 1, "LetVarShadowDeclarations")
    if (status_LetVarShadowDeclarations != 0) {
        return status_LetVarShadowDeclarations
    }

    let status_AssignmentTyping: i32 = VerifyExpressionStatementDeclarationTypingItem(ctx, scope, 2, "AssignmentTyping")
    if (status_AssignmentTyping != 0) {
        return status_AssignmentTyping
    }

    let status_BlockResultTyping: i32 = VerifyExpressionStatementDeclarationTypingItem(ctx, scope, 3, "BlockResultTyping")
    if (status_BlockResultTyping != 0) {
        return status_BlockResultTyping
    }

    let status_ControlFlowJoinTyping: i32 = VerifyExpressionStatementDeclarationTypingItem(ctx, scope, 4, "ControlFlowJoinTyping")
    if (status_ControlFlowJoinTyping != 0) {
        return status_ControlFlowJoinTyping
    }

    return 0
}
