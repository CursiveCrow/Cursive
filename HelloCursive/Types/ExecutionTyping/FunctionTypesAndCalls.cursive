procedure AddCall(lhs: i32, rhs: i32) -> i32 {
    return lhs + rhs
}

procedure ConsumeMode(move value: i32) -> i32 {
    return value
}

procedure NonUnitObligation(flag: bool) -> i32 {
    if (flag) {
        return 1
    }
    return 0
}

procedure ReadConstPermission(value: const i32) -> i32 {
    return value
}

procedure ReadConstPair(left: const i32, right: const i32) -> i32 {
    return left + right
}

procedure InvokeSignature(callable: (i32, i32) -> i32, lhs: i32, rhs: i32) -> i32 {
    return callable(lhs, rhs)
}

public record ReceiverPermissionProbe {
    value: i32

    procedure read(~) -> i32 {
        return self.value
    }

    procedure sync_read(~%) -> i32 {
        return self.value
    }

    procedure mutate(~!) -> i32 {
        return self.value + 1
    }
}

procedure LogFunctionCallObject(
    fs: $FileSystem,
    scope: string@View,
    move object_name: string@View,
    move object_type: string@View,
    move state: string@View,
    move details: string@View
) -> () {
    [[log(label: "types-log-object")]]
}

procedure RunFunctionTypesAndCallsItem(
    ctx: Context,
    scope: string@View,
    move item_name: string@View,
    move item_details: string@View,
    move item_reason: string@View,
    move step_name: string@View,
    move step_detail: string@View,
    move expected: string@View,
    move actual_pass: string@View,
    move actual_fail: string@View,
    move passed: bool,
    move failure_reason: string@View
) -> i32 {
    let detail_begin: string@View = "type feature item exercise start"
    [[log(label: "types-log-item_begin")]]
    let phase_running: string@View = "running"
    let phase_step_begin: string@View = "step-begin"
    let phase_step_pass: string@View = "step-pass"
    let phase_step_fail: string@View = "step-fail"
    let reason_pass: string@View = "expected output aligned with actual output"
    let reason_fail: string@View = "expected output did not align with actual output"
    let passed_place: bool = passed

    [[log(label: "types-log-runtime_phase")]]
    let item_check_log: bool = [[log(label: "observed-item-check-pass", expected: true)]] passed_place
    let item_check_ok: bool = passed_place && (item_check_log == true)
    if (item_check_ok == false) {
        [[log(label: "types-log-transition")]]
        [[log(label: "types-log-item_fail")]]
        return 1
    }

    [[log(label: "types-log-transition")]]
    [[log(label: "types-log-types_item_success")]]
    return 0
}

procedure FunctionMetricLabel(value: i32) -> string@View {
    if (value == 0) {
        return "0"
    }
    if (value == 1) {
        return "1"
    }
    if (value == 5) {
        return "5"
    }
    if (value == 6) {
        return "6"
    }
    if (value == 7) {
        return "7"
    }
    if (value == 9) {
        return "9"
    }
    if (value == 10) {
        return "10"
    }
    if (value == 12) {
        return "12"
    }
    if (value == 16) {
        return "16"
    }
    if (value == 26) {
        return "26"
    }
    return "other"
}

procedure VerifyFunctionTypesAndCallsItem(ctx: Context, scope: string@View, move item_index: i32, move item_name: string@View) -> i32 {
    [[log(label: "types-log-runtime_phase_move")]]
    let signature_fn: (i32, i32) -> i32 = AddCall
    let signature_lhs: i32 = 2
    let signature_rhs: i32 = 3
    LogFunctionCallObject(ctx.fs, scope, "signature_fn", "(i32,i32)->i32", "constructed", "typed procedure signature callable prepared")
    LogFunctionCallObject(ctx.fs, scope, "signature_args", "i32,i32", "constructed", "procedure signature call arguments prepared")

    [[log(label: "types-log-runtime_phase_move")]]
    [[log(label: "types-log-transition_move")]]
    [[log(label: "types-log-transition_move")]]
    let signature_metric: i32 = InvokeSignature(signature_fn, signature_lhs, signature_rhs)
    [[log(label: "types-log-transition_move")]]
    [[log(label: "types-log-transition_move")]]
    LogFunctionCallObject(ctx.fs, scope, "mode_literal", "i32 literal", "constructed", "parameter-mode consuming literal prepared")
    [[log(label: "types-log-transition_move")]]
    let mode_metric: i32 = ConsumeMode(6)
    [[log(label: "types-log-transition_move")]]
    let return_flag: bool = true
    LogFunctionCallObject(ctx.fs, scope, "return_flag", "bool", "constructed", "non-unit return obligation branch selector prepared")
    [[log(label: "types-log-transition_move")]]
    let return_metric: i32 = NonUnitObligation(return_flag)
    [[log(label: "types-log-transition_move")]]
    let call_lhs: i32 = 4
    let call_rhs: i32 = 5
    LogFunctionCallObject(ctx.fs, scope, "call_args", "i32,i32", "constructed", "call-site argument matching inputs prepared")
    [[log(label: "types-log-transition_move")]]
    let call_metric: i32 = AddCall(call_lhs, call_rhs)
    [[log(label: "types-log-transition_move")]]
    LogFunctionCallObject(ctx.fs, scope, "move_literal", "i32 literal", "constructed", "move-call semantics literal prepared")
    [[log(label: "types-log-transition_move")]]
    let move_metric: i32 = ConsumeMode(9)
    [[log(label: "types-log-transition_move")]]
    let move_signature_fn: (move i32) -> i32 = ConsumeMode
    LogFunctionCallObject(ctx.fs, scope, "move_signature_fn", "(move i32)->i32", "constructed", "move-parameter function signature prepared")
    [[log(label: "types-log-transition_move")]]
    let move_signature_metric: i32 = move_signature_fn(10)
    [[log(label: "types-log-transition_move")]]
    LogFunctionCallObject(ctx.fs, scope, "ref_literal_args", "const i32,const i32 literals", "constructed", "non-move reference-call literal arguments prepared")
    [[log(label: "types-log-transition_move")]]
    let ref_literal_metric: i32 = ReadConstPair(3, 4)
    [[log(label: "types-log-transition_move")]]
    let ref_place_left: i32 = 3
    let ref_place_right: i32 = 4
    LogFunctionCallObject(ctx.fs, scope, "ref_place_args", "const i32,const i32 places", "constructed", "non-move reference-call place arguments prepared")
    [[log(label: "types-log-transition_move")]]
    let ref_place_metric: i32 = ReadConstPair(ref_place_left, ref_place_right)
    [[log(label: "types-log-transition_move")]]
    let move_place_source: i32 = 12
    LogFunctionCallObject(ctx.fs, scope, "move_place_arg", "move i32 place", "constructed", "consuming-call provenance-bearing place argument prepared")
    [[log(label: "types-log-transition_move")]]
    let move_place_metric: i32 = ConsumeMode(move move_place_source)
    [[log(label: "types-log-transition_move")]]
    let provenance_metric: i32 = ref_literal_metric + ref_place_metric + move_place_metric

    let receiver_probe_seed: unique ReceiverPermissionProbe = ReceiverPermissionProbe { value: 5 }
    LogFunctionCallObject(ctx.fs, scope, "receiver_probe_seed", "unique ReceiverPermissionProbe", "constructed", "receiver permission probe seed value prepared")
    [[log(label: "types-log-transition_move")]]
    var receiver_probe: unique ReceiverPermissionProbe = move receiver_probe_seed
    [[log(label: "types-log-transition_move")]]
    LogFunctionCallObject(ctx.fs, scope, "receiver_probe", "unique ReceiverPermissionProbe", "constructed", "receiver permission probe prepared for ~, ~%, and ~! method calls")

    [[log(label: "types-log-transition_move")]]
    let receiver_const_metric: i32 = receiver_probe~>read()
    [[log(label: "types-log-transition_move")]]
    [[log(label: "types-log-transition_move")]]
    let receiver_shared_metric: i32 = receiver_probe~>sync_read()
    [[log(label: "types-log-transition_move")]]
    [[log(label: "types-log-transition_move")]]
    let receiver_unique_metric: i32 = receiver_probe~>mutate()
    [[log(label: "types-log-transition_move")]]
    let shared_probe_seed: unique ReceiverPermissionProbe = ReceiverPermissionProbe { value: 5 }
    LogFunctionCallObject(ctx.fs, scope, "shared_probe_seed", "unique ReceiverPermissionProbe", "constructed", "shared receiver probe seed prepared")
    [[log(label: "types-log-transition_move")]]
    let shared_probe: shared ReceiverPermissionProbe = shared_probe_seed
    [[log(label: "types-log-transition_move")]]
    LogFunctionCallObject(ctx.fs, scope, "shared_probe", "shared ReceiverPermissionProbe", "constructed", "shared receiver probe prepared for key-governed ~ and ~% method calls")

    [[log(label: "types-log-transition_move")]]
    let shared_probe_const_metric: i32 = shared_probe~>read()
    [[log(label: "types-log-transition_move")]]
    [[log(label: "types-log-transition_move")]]
    let shared_probe_sync_metric: i32 = shared_probe~>sync_read()
    [[log(label: "types-log-transition_move")]]
    let shared_key_metric: i32 = shared_probe_const_metric + shared_probe_sync_metric
    let receiver_metric: i32 = receiver_const_metric + receiver_shared_metric + receiver_unique_metric + shared_key_metric

    let observed_signature_step: string@View = "observed-procedure-signature-metric"
    let observed_mode_step: string@View = "observed-parameter-mode-metric"
    let observed_return_step: string@View = "observed-return-obligation-metric"
    let observed_call_step: string@View = "observed-call-site-metric"
    let observed_move_step: string@View = "observed-move-call-metric"
    let observed_move_signature_step: string@View = "observed-move-signature-metric"
    let observed_ref_literal_step: string@View = "observed-reference-literal-call-metric"
    let observed_ref_place_step: string@View = "observed-reference-place-call-metric"
    let observed_move_place_step: string@View = "observed-move-place-call-metric"
    let observed_provenance_step: string@View = "observed-provenance-aware-argument-temporary-metric"
    let observed_receiver_step: string@View = "observed-receiver-permission-metric"
    let observed_shared_key_step: string@View = "observed-shared-key-governed-receiver-metric"
    let expected_signature: string@View = "5"
    let expected_mode: string@View = "6"
    let expected_return: string@View = "1"
    let expected_call: string@View = "9"
    let expected_move: string@View = "9"
    let expected_move_signature: string@View = "10"
    let expected_ref_literal: string@View = "7"
    let expected_ref_place: string@View = "7"
    let expected_move_place: string@View = "12"
    let expected_provenance: string@View = "26"
    let expected_receiver: string@View = "26"
    let expected_shared_key: string@View = "10"
    let signature_metric_label: string@View = FunctionMetricLabel(signature_metric)
    let mode_metric_label: string@View = FunctionMetricLabel(mode_metric)
    let return_metric_label: string@View = FunctionMetricLabel(return_metric)
    let call_metric_label: string@View = FunctionMetricLabel(call_metric)
    let move_metric_label: string@View = FunctionMetricLabel(move_metric)
    let move_signature_metric_label: string@View = FunctionMetricLabel(move_signature_metric)
    let ref_literal_metric_label: string@View = FunctionMetricLabel(ref_literal_metric)
    let ref_place_metric_label: string@View = FunctionMetricLabel(ref_place_metric)
    let move_place_metric_label: string@View = FunctionMetricLabel(move_place_metric)
    let provenance_metric_label: string@View = FunctionMetricLabel(provenance_metric)
    let receiver_metric_label: string@View = FunctionMetricLabel(receiver_metric)
    let shared_key_metric_label: string@View = FunctionMetricLabel(shared_key_metric)
    let signature_metric_passed: bool = signature_metric == 5
    let mode_metric_passed: bool = mode_metric == 6
    let return_metric_passed: bool = return_metric == 1
    let call_metric_passed: bool = call_metric == 9
    let move_metric_passed: bool = move_metric == 9
    let move_signature_metric_passed: bool = move_signature_metric == 10
    let ref_literal_metric_passed: bool = ref_literal_metric == 7
    let ref_place_metric_passed: bool = ref_place_metric == 7
    let move_place_metric_passed: bool = move_place_metric == 12
    let provenance_metric_passed: bool = provenance_metric == 26
    let receiver_metric_passed: bool = receiver_metric == 26
    let shared_key_metric_passed: bool = shared_key_metric == 10

    let signature_metric_passed_log_actual = [[log(label: "observed-procedure-signature-metric", expected: "5")]] signature_metric_label
    let signature_metric_passed_with_log: bool = signature_metric_passed && (signature_metric_passed_log_actual == expected_signature)
    let mode_metric_passed_log_actual = [[log(label: "observed-parameter-mode-metric", expected: "6")]] mode_metric_label
    let mode_metric_passed_with_log: bool = mode_metric_passed && (mode_metric_passed_log_actual == expected_mode)
    let return_metric_passed_log_actual = [[log(label: "observed-return-obligation-metric", expected: "1")]] return_metric_label
    let return_metric_passed_with_log: bool = return_metric_passed && (return_metric_passed_log_actual == expected_return)
    let call_metric_passed_log_actual = [[log(label: "observed-call-site-metric", expected: "9")]] call_metric_label
    let call_metric_passed_with_log: bool = call_metric_passed && (call_metric_passed_log_actual == expected_call)
    let move_metric_passed_log_actual = [[log(label: "observed-move-call-metric", expected: "9")]] move_metric_label
    let move_metric_passed_with_log: bool = move_metric_passed && (move_metric_passed_log_actual == expected_move)
    let move_signature_metric_passed_log_actual = [[log(label: "observed-move-signature-metric", expected: "10")]] move_signature_metric_label
    let move_signature_metric_passed_with_log: bool = move_signature_metric_passed && (move_signature_metric_passed_log_actual == expected_move_signature)
    let ref_literal_metric_passed_log_actual = [[log(label: "observed-reference-literal-call-metric", expected: "7")]] ref_literal_metric_label
    let ref_literal_metric_passed_with_log: bool = ref_literal_metric_passed && (ref_literal_metric_passed_log_actual == expected_ref_literal)
    let ref_place_metric_passed_log_actual = [[log(label: "observed-reference-place-call-metric", expected: "7")]] ref_place_metric_label
    let ref_place_metric_passed_with_log: bool = ref_place_metric_passed && (ref_place_metric_passed_log_actual == expected_ref_place)
    let move_place_metric_passed_log_actual = [[log(label: "observed-move-place-call-metric", expected: "12")]] move_place_metric_label
    let move_place_metric_passed_with_log: bool = move_place_metric_passed && (move_place_metric_passed_log_actual == expected_move_place)
    let provenance_metric_passed_log_actual = [[log(label: "observed-provenance-aware-argument-temporary-metric", expected: "26")]] provenance_metric_label
    let provenance_metric_passed_with_log: bool = provenance_metric_passed && (provenance_metric_passed_log_actual == expected_provenance)
    let receiver_metric_passed_log_actual = [[log(label: "observed-receiver-permission-metric", expected: "26")]] receiver_metric_label
    let receiver_metric_passed_with_log: bool = receiver_metric_passed && (receiver_metric_passed_log_actual == expected_receiver)
    let shared_key_metric_passed_log_actual = [[log(label: "observed-shared-key-governed-receiver-metric", expected: "10")]] shared_key_metric_label
    let shared_key_metric_passed_with_log: bool = shared_key_metric_passed && (shared_key_metric_passed_log_actual == expected_shared_key)
    [[log(label: "types-log-runtime_phase_move")]]
    if (item_index == 0) {
        return RunFunctionTypesAndCallsItem(
            ctx,
            scope,
            "ProcedureSignatures",
            "procedure signature typing including explicit return requirements",
            "validated procedure signature typing",
            "procedure-signature",
            "bind procedure to function type and invoke typed signature",
            "5",
            "5",
            "not-5",
            move signature_metric_passed_with_log,
            "procedure signatures check failed"
        )
    }

    if (item_index == 1) {
        return RunFunctionTypesAndCallsItem(
            ctx,
            scope,
            "ParameterModes",
            "by-value and `move` parameter mode compatibility and ownership transfer",
            "validated parameter mode typing",
            "parameter-modes",
            "invoke consuming parameter mode with raw literal argument (no source provenance)",
            "6",
            "6",
            "not-6",
            move mode_metric_passed_with_log,
            "parameter modes check failed"
        )
    }

    if (item_index == 2) {
        return RunFunctionTypesAndCallsItem(
            ctx,
            scope,
            "ReturnTypeObligations",
            "non-unit return obligations and path completion rules",
            "validated return type obligations",
            "return-obligation",
            "evaluate non-unit procedure with explicit return on all paths",
            "1",
            "1",
            "not-1",
            move return_metric_passed_with_log,
            "return type obligations check failed"
        )
    }

    if (item_index == 3) {
        return RunFunctionTypesAndCallsItem(
            ctx,
            scope,
            "CallSiteArgumentMatching",
            "arity and argument type matching at function/procedure call sites",
            "validated call-site argument matching",
            "call-site-arguments",
            "invoke procedure with exact arity and argument types",
            "9",
            "9",
            "not-9",
            move call_metric_passed_with_log,
            "call-site argument matching check failed"
        )
    }

    if (item_index == 4) {
        return RunFunctionTypesAndCallsItem(
            ctx,
            scope,
            "MoveCallSemantics",
            "consuming-call behavior and post-move use restrictions",
            "validated move call semantics",
            "move-call",
            "transfer ownership with move into consuming procedure",
            "9",
            "9",
            "not-9",
            move move_metric_passed_with_log,
            "move call semantics check failed"
        )
    }

    if (item_index == 5) {
        return RunFunctionTypesAndCallsItem(
            ctx,
            scope,
            "MethodReceiverPermissions",
            "receiver permission compatibility for `~`, `~%`, and `~!`",
            "validated method receiver permission rules",
            "receiver-permissions",
            "exercise unique and shared caller permission paths, including key-governed ~% receiver calls",
            "26",
            "26",
            "not-26",
            move receiver_metric_passed_with_log,
            "method receiver permissions check failed"
        )
    }

    if (item_index == 6) {
        return RunFunctionTypesAndCallsItem(
            ctx,
            scope,
            "MoveFunctionSignatures",
            "function type signatures with explicit move parameters and callable compatibility",
            "validated move function signatures",
            "move-function-signature",
            "bind procedure to (move i32)->i32 function type and invoke through typed signature",
            "10",
            "10",
            "not-10",
            move move_signature_metric_passed_with_log,
            "move function signature check failed"
        )
    }

    if (item_index == 7) {
        return RunFunctionTypesAndCallsItem(
            ctx,
            scope,
            "ProvenanceAwareArgumentTemporaries",
            "temporary materialization only for arguments without source provenance; provenance-bearing move arguments still require explicit `move`",
            "validated provenance-aware argument temporary behavior",
            "provenance-aware-arguments",
            "evaluate literal reference-call temporaries, place reference calls, and explicit move for provenance-bearing consuming calls",
            "26",
            "26",
            "not-26",
            move provenance_metric_passed_with_log,
            "provenance-aware argument temporary behavior check failed"
        )
    }

    return RunFunctionTypesAndCallsItem(
        ctx,
        scope,
        move item_name,
        "unknown function/call typing item",
        "failed unknown function/call typing item",
        "item-resolution",
        "resolve item name within function/call typing feature set",
        "known-item",
        "known-item",
        "unknown-item",
        false,
        "unknown function/call typing item"
    )
}

procedure RunFunctionTypesAndCalls(ctx: Context) -> i32 {
    let scope: string@View = "types::ExecutionTyping::FunctionTypesAndCalls"
    let checkpoint: string@View = "covered function/call typing feature items"

    let status_ProcedureSignatures: i32 = VerifyFunctionTypesAndCallsItem(ctx, scope, 0, "ProcedureSignatures")
    if (status_ProcedureSignatures != 0) {
        return status_ProcedureSignatures
    }

    let status_ParameterModes: i32 = VerifyFunctionTypesAndCallsItem(ctx, scope, 1, "ParameterModes")
    if (status_ParameterModes != 0) {
        return status_ParameterModes
    }

    let status_ReturnTypeObligations: i32 = VerifyFunctionTypesAndCallsItem(ctx, scope, 2, "ReturnTypeObligations")
    if (status_ReturnTypeObligations != 0) {
        return status_ReturnTypeObligations
    }

    let status_CallSiteArgumentMatching: i32 = VerifyFunctionTypesAndCallsItem(ctx, scope, 3, "CallSiteArgumentMatching")
    if (status_CallSiteArgumentMatching != 0) {
        return status_CallSiteArgumentMatching
    }

    let status_MoveCallSemantics: i32 = VerifyFunctionTypesAndCallsItem(ctx, scope, 4, "MoveCallSemantics")
    if (status_MoveCallSemantics != 0) {
        return status_MoveCallSemantics
    }

    let status_MethodReceiverPermissions: i32 = VerifyFunctionTypesAndCallsItem(ctx, scope, 5, "MethodReceiverPermissions")
    if (status_MethodReceiverPermissions != 0) {
        return status_MethodReceiverPermissions
    }

    let status_MoveFunctionSignatures: i32 = VerifyFunctionTypesAndCallsItem(ctx, scope, 6, "MoveFunctionSignatures")
    if (status_MoveFunctionSignatures != 0) {
        return status_MoveFunctionSignatures
    }

    let status_ProvenanceAwareArgumentTemporaries: i32 = VerifyFunctionTypesAndCallsItem(ctx, scope, 7, "ProvenanceAwareArgumentTemporaries")
    if (status_ProvenanceAwareArgumentTemporaries != 0) {
        return status_ProvenanceAwareArgumentTemporaries
    }

    [[log(label: "types-log-checkpoint")]]
    return 0
}
