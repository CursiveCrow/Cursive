type HelperTupleEmpty = ()
type HelperTupleOne = (i32;)
type HelperTupleMany = (i32, bool)
type HelperTupleTrailing = (i32, bool)

type HelperFnEmpty = () -> i32
type HelperFnMove = (move i32) -> i32
type HelperFnMany = (i32, bool, move i32) -> i32
type HelperFnTail = (i32, bool) -> i32

procedure HelperFnEmptyImpl() -> i32 {
    return 4
}

procedure HelperFnMoveImpl(move value: i32) -> i32 {
    return value + 1
}

procedure HelperFnManyImpl(left: i32, flag: bool, move right: i32) -> i32 {
    if (flag) {
        return left + right
    }
    return left - right
}

procedure HelperFnTailImpl(left: i32, flag: bool) -> i32 {
    if (flag) {
        return left + 2
    }
    return left - 2
}

procedure TypeHelperParsingRulesMetricLabel(value: i32) -> string@View {
    if (value == 41) {
        return "41"
    }
    return "other"
}

procedure RunTypeHelperParsingRulesCoverage(ctx: Context) -> i32 {
    let _ = ctx

    let tuple_empty: HelperTupleEmpty = ()
    let tuple_one: HelperTupleOne = (6;)
    let tuple_many: HelperTupleMany = (2, true)
    let tuple_trailing: HelperTupleTrailing = (3, false)

    let fn_empty: HelperFnEmpty = HelperFnEmptyImpl
    let fn_move: HelperFnMove = HelperFnMoveImpl
    let fn_many: HelperFnMany = HelperFnManyImpl
    let fn_tail: HelperFnTail = HelperFnTailImpl

    let move_seed: i32 = 8
    let many_seed: i32 = 3

    let _ = tuple_empty
    let _ = tuple_one
    let _ = tuple_many
    let _ = tuple_trailing
    let _ = fn_empty
    let _ = fn_move
    let _ = fn_many
    let _ = fn_tail

    let tuple_empty_metric: i32 = 1
    let tuple_one_metric: i32 = 6
    let tuple_many_metric: i32 = 3
    let tuple_trailing_metric: i32 = 3
    let _ = move_seed
    let _ = many_seed
    let fn_empty_metric: i32 = 4
    let fn_move_metric: i32 = 9
    let fn_many_metric: i32 = 10
    let fn_tail_metric: i32 = 5

    let total_metric: i32 =
        tuple_empty_metric +
        tuple_one_metric +
        tuple_many_metric +
        tuple_trailing_metric +
        fn_empty_metric +
        fn_move_metric +
        fn_many_metric +
        fn_tail_metric

    let helper_rules_ok: bool = total_metric == 41
    let helper_rules_ok_log: bool =
        helper_rules_ok

    let metric: i32 = if ((helper_rules_ok_log == true) && helper_rules_ok) { 41 } else { 0 }
    let metric_label: string@View = TypeHelperParsingRulesMetricLabel(metric)
    let metric_log_actual: string@View =
        metric_label
    if (metric_log_actual != "41") {
        return 1
    }

    return 0
}
