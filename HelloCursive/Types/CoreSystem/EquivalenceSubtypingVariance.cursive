public type EqAliasScalar = i32

procedure EqAdd(lhs: i32, rhs: i32) -> i32 {
    return lhs + rhs
}

procedure LogEquivalenceObject(
    fs: $FileSystem,
    scope: string@View,
    move object_name: string@View,
    move object_type: string@View,
    move state: string@View,
    move details: string@View
) -> () {
    }

procedure RunEquivalenceSubtypingVarianceItem(
    ctx: Context,
    scope: string@View,
    move item_name: string@View,
    move item_details: string@View,
    move item_reason: string@View,
    move step_name: string@View,
    move step_detail: string@View,
    move expected: string@View,
    move actual_pass: string@View,
    move actual_fail: string@View,
    move passed: bool,
    move failure_reason: string@View
) -> i32 {
    let detail_begin: string@View = "type feature item exercise start"
    let phase_running: string@View = "running"
    let phase_step_begin: string@View = "step-begin"
    let phase_step_pass: string@View = "step-pass"
    let phase_step_fail: string@View = "step-fail"
    let reason_pass: string@View = "expected output aligned with actual output"
    let reason_fail: string@View = "expected output did not align with actual output"
    let passed_place: bool = passed

    let item_check_log: bool = passed_place
    let item_check_ok: bool = passed_place && (item_check_log == true)
    if (item_check_ok == false) {
        return 1
    }

    return 0
}

procedure EquivalenceMetricLabel(value: i32) -> string@View {
    if (value == 0) {
        return "0"
    }
    if (value == 1) {
        return "1"
    }
    if (value == 7) {
        return "7"
    }
    if (value == 9) {
        return "9"
    }
    if (value == 11) {
        return "11"
    }
    return "other"
}

procedure EquivalenceBoolLabel(value: bool) -> string@View {
    if (value) {
        return "true"
    }
    return "false"
}

procedure VerifyEquivalenceSubtypingVarianceItem(ctx: Context, scope: string@View, move item_index: i32, move item_name: string@View) -> i32 {
    let alias_value: EqAliasScalar = 9
    let tuple_left: (i32, bool) = (7, true)
    let tuple_right: (i32, bool) = tuple_left
    let union_left: i32 | bool = 5
    let union_right: bool | i32 = union_left
    let union_order_metric_i32 = if union_right is {
        _: i32 { 5 }
        _: bool { 0 }
    }
    let union_left_bool: bool | i32 = true
    let union_right_bool: i32 | bool = union_left_bool
    let union_order_metric_bool = if union_right_bool is {
        _: bool { 1 }
        _: i32 { 0 }
    }
    let unique_value: unique i32 = 11
    let shared_value: shared i32 = unique_value
    let const_value: const i32 = shared_value
    let callable: (i32, i32) -> i32 = EqAdd
    let call_lhs: i32 = 3
    let call_rhs: i32 = 4
    let callable_sum: i32 = callable(call_lhs, call_rhs)
    let coercion_join: i32 = if (callable_sum == 7) { 1 } else { 0 }
    LogEquivalenceObject(ctx.fs, scope, "alias_value", "EqAliasScalar", "constructed", "nominal alias value prepared")
    LogEquivalenceObject(ctx.fs, scope, "tuple_left", "(i32,bool)", "constructed", "tuple structural-equivalence source prepared")
    LogEquivalenceObject(ctx.fs, scope, "union_left", "i32|bool", "constructed", "union order-independence source prepared")
    LogEquivalenceObject(ctx.fs, scope, "unique_value", "unique i32", "constructed", "permission lattice source value prepared")
    LogEquivalenceObject(ctx.fs, scope, "shared_value", "shared i32", "constructed", "permission lattice intermediate shared value prepared")
    LogEquivalenceObject(ctx.fs, scope, "callable", "(i32,i32)->i32", "constructed", "variance/coercion callable prepared")

    let union_order_preserved: bool = (union_order_metric_i32 == 5) && (union_order_metric_bool == 1)
    let observed_nominal_step: string@View = "observed-nominal-equivalence-metric"
    let observed_structural_step: string@View = "observed-structural-equivalence-metric"
    let observed_union_step: string@View = "observed-union-order-independence-metric"
    let observed_permission_step: string@View = "observed-permission-subtyping-metric"
    let observed_variance_step: string@View = "observed-variance-position-metric"
    let observed_coercion_step: string@View = "observed-coercion-site-metric"
    let expected_nominal: string@View = "9"
    let expected_structural: string@View = "7"
    let expected_union: string@View = "true"
    let expected_permission: string@View = "11"
    let expected_variance: string@View = "7"
    let expected_coercion: string@View = "1"
    let nominal_metric_label: string@View = EquivalenceMetricLabel(alias_value)
    let structural_metric_label: string@View = EquivalenceMetricLabel(tuple_right.0)
    let union_metric_label: string@View = EquivalenceBoolLabel(union_order_preserved)
    let permission_metric_label: string@View = EquivalenceMetricLabel(const_value)
    let variance_metric_label: string@View = EquivalenceMetricLabel(callable_sum)
    let coercion_metric_label: string@View = EquivalenceMetricLabel(coercion_join)
    let nominal_metric_passed: bool = alias_value == 9
    let structural_metric_passed: bool = tuple_right.0 == 7
    let union_metric_passed: bool = union_order_preserved
    let permission_metric_passed: bool = const_value == 11
    let variance_metric_passed: bool = callable_sum == 7
    let coercion_metric_passed: bool = coercion_join == 1

    let nominal_metric_passed_log_actual = nominal_metric_label
    let nominal_metric_passed_with_log: bool = nominal_metric_passed && (nominal_metric_passed_log_actual == expected_nominal)
    let structural_metric_passed_log_actual = structural_metric_label
    let structural_metric_passed_with_log: bool = structural_metric_passed && (structural_metric_passed_log_actual == expected_structural)
    let union_metric_passed_log_actual = union_metric_label
    let union_metric_passed_with_log: bool = union_metric_passed && (union_metric_passed_log_actual == expected_union)
    let permission_metric_passed_log_actual = permission_metric_label
    let permission_metric_passed_with_log: bool = permission_metric_passed && (permission_metric_passed_log_actual == expected_permission)
    let variance_metric_passed_log_actual = variance_metric_label
    let variance_metric_passed_with_log: bool = variance_metric_passed && (variance_metric_passed_log_actual == expected_variance)
    let coercion_metric_passed_log_actual = coercion_metric_label
    let coercion_metric_passed_with_log: bool = coercion_metric_passed && (coercion_metric_passed_log_actual == expected_coercion)
    if (item_index == 0) {
        return RunEquivalenceSubtypingVarianceItem(
            ctx,
            scope,
            "NominalEquivalence",
            "name-based type identity for records, enums, classes, and aliases",
            "validated nominal equivalence rules",
            "alias-type-identity",
            "evaluate alias identity against its nominal source type",
            "9",
            "9",
            "not-9",
            move nominal_metric_passed_with_log,
            "nominal equivalence check failed"
        )
    }

    if (item_index == 1) {
        return RunEquivalenceSubtypingVarianceItem(
            ctx,
            scope,
            "StructuralEquivalence",
            "structural compatibility for tuples/function shapes where applicable",
            "validated structural equivalence checks",
            "tuple-structural-shape",
            "evaluate tuple structural compatibility by shape and position",
            "7",
            "7",
            "not-7",
            move structural_metric_passed_with_log,
            "structural equivalence check failed"
        )
    }

    if (item_index == 2) {
        return RunEquivalenceSubtypingVarianceItem(
            ctx,
            scope,
            "UnionOrderIndependence",
            "unordered union equivalence and canonical normalization behavior",
            "validated unordered union equivalence",
            "union-order-normalization",
            "assign between unions with identical members in different orders",
            "preserved",
            "preserved",
            "not-preserved",
            move union_order_preserved,
            "union order independence check failed"
        )
    }

    if (item_index == 3) {
        return RunEquivalenceSubtypingVarianceItem(
            ctx,
            scope,
            "PermissionSubtypingLattice",
            "unique->shared->const subtyping and receiver compatibility",
            "validated permission subtyping lattice",
            "permission-subtyping",
            "convert unique permission to const permission through subtyping",
            "11",
            "11",
            "not-11",
            move permission_metric_passed_with_log,
            "permission subtyping lattice check failed"
        )
    }

    if (item_index == 4) {
        return RunEquivalenceSubtypingVarianceItem(
            ctx,
            scope,
            "VariancePositions",
            "variance constraints in generic parameter positions and nested types",
            "validated variance behavior",
            "function-position-typing",
            "evaluate function value typing through parameter and return positions",
            "7",
            "7",
            "not-7",
            move variance_metric_passed_with_log,
            "variance position check failed"
        )
    }

    if (item_index == 5) {
        return RunEquivalenceSubtypingVarianceItem(
            ctx,
            scope,
            "CoercionSites",
            "explicit and contextual coercion sites for type-directed conversion",
            "validated coercion site behavior",
            "if-join-coercion",
            "evaluate contextual join coercion across if-expression branches",
            "1",
            "1",
            "not-1",
            move coercion_metric_passed_with_log,
            "coercion site check failed"
        )
    }

    return RunEquivalenceSubtypingVarianceItem(
        ctx,
        scope,
        move item_name,
        "unknown equivalence/subtyping/variance item",
        "failed unknown equivalence/subtyping/variance item",
        "item-resolution",
        "resolve item name within equivalence/subtyping/variance feature set",
        "known-item",
        "known-item",
        "unknown-item",
        false,
        "unknown equivalence/subtyping/variance item"
    )
}

procedure RunEquivalenceSubtypingVariance(ctx: Context) -> i32 {
    let scope: string@View = "types::CoreSystem::EquivalenceSubtypingVariance"
    let checkpoint: string@View = "covered equivalence/subtyping/variance feature items"

    let status_NominalEquivalence: i32 = VerifyEquivalenceSubtypingVarianceItem(ctx, scope, 0, "NominalEquivalence")
    if (status_NominalEquivalence != 0) {
        return status_NominalEquivalence
    }

    let status_StructuralEquivalence: i32 = VerifyEquivalenceSubtypingVarianceItem(ctx, scope, 1, "StructuralEquivalence")
    if (status_StructuralEquivalence != 0) {
        return status_StructuralEquivalence
    }

    let status_UnionOrderIndependence: i32 = VerifyEquivalenceSubtypingVarianceItem(ctx, scope, 2, "UnionOrderIndependence")
    if (status_UnionOrderIndependence != 0) {
        return status_UnionOrderIndependence
    }

    let status_PermissionSubtypingLattice: i32 = VerifyEquivalenceSubtypingVarianceItem(ctx, scope, 3, "PermissionSubtypingLattice")
    if (status_PermissionSubtypingLattice != 0) {
        return status_PermissionSubtypingLattice
    }

    let status_VariancePositions: i32 = VerifyEquivalenceSubtypingVarianceItem(ctx, scope, 4, "VariancePositions")
    if (status_VariancePositions != 0) {
        return status_VariancePositions
    }

    let status_CoercionSites: i32 = VerifyEquivalenceSubtypingVarianceItem(ctx, scope, 5, "CoercionSites")
    if (status_CoercionSites != 0) {
        return status_CoercionSites
    }

    return 0
}
