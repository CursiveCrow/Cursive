public type AliasScalar = i32
public type AliasTuple = (i32, i32)
public type AliasChain0 = i32
public type AliasChain1 = AliasChain0
public type AliasChain2 = AliasChain1

procedure AliasAdd(lhs: i32, rhs: i32) -> i32 {
    return lhs + rhs
}

procedure LogAliasesObject(
    fs: $FileSystem,
    scope: string@View,
    move object_name: string@View,
    move object_type: string@View,
    move state: string@View,
    move details: string@View
) -> () {
    [[log(label: "types-log-object")]]
}

procedure RunAliasesPathsQualifiedApplyItem(
    ctx: Context,
    scope: string@View,
    move item_name: string@View,
    move item_details: string@View,
    move item_reason: string@View,
    move step_name: string@View,
    move step_detail: string@View,
    move expected: string@View,
    move actual_pass: string@View,
    move actual_fail: string@View,
    move passed: bool,
    move failure_reason: string@View
) -> i32 {
    let detail_begin: string@View = "type feature item exercise start"
    [[log(label: "types-log-item_begin")]]
    let phase_running: string@View = "running"
    let phase_step_begin: string@View = "step-begin"
    let phase_step_pass: string@View = "step-pass"
    let phase_step_fail: string@View = "step-fail"
    let reason_pass: string@View = "expected output aligned with actual output"
    let reason_fail: string@View = "expected output did not align with actual output"
    let passed_place: bool = passed

    [[log(label: "types-log-runtime_phase")]]
    let item_check_log: bool = [[log(label: "observed-item-check-pass", expected: true)]] passed_place
    let item_check_ok: bool = passed_place && (item_check_log == true)
    if (item_check_ok == false) {
        [[log(label: "types-log-transition")]]
        [[log(label: "types-log-item_fail")]]
        return 1
    }

    [[log(label: "types-log-transition")]]
    [[log(label: "types-log-types_item_success")]]
    return 0
}

procedure AliasMetricLabel(value: i32) -> string@View {
    if (value == 0) {
        return "0"
    }
    if (value == 4) {
        return "4"
    }
    if (value == 7) {
        return "7"
    }
    if (value == 15) {
        return "15"
    }
    if (value == 20) {
        return "20"
    }
    return "other"
}

procedure VerifyAliasesPathsQualifiedApplyItem(ctx: Context, scope: string@View, move item_index: i32, move item_name: string@View) -> i32 {
    [[log(label: "types-log-runtime_phase_move")]]
    let alias_scalar: AliasScalar = 12
    let alias_tuple: (i32, i32) = (3, 4)
    LogAliasesObject(ctx.fs, scope, "alias_scalar", "AliasScalar", "constructed", "alias scalar value prepared")
    LogAliasesObject(ctx.fs, scope, "alias_tuple", "AliasTuple", "constructed", "tuple alias value prepared")

    [[log(label: "types-log-runtime_phase_move")]]
    [[log(label: "types-log-transition_move")]]
    let alias_expanded: i32 = alias_scalar + alias_tuple.0
    [[log(label: "types-log-transition_move")]]
    let alias_chain: AliasChain2 = 21
    LogAliasesObject(ctx.fs, scope, "alias_chain", "AliasChain2", "constructed", "alias chain value prepared")
    [[log(label: "types-log-transition_move")]]
    let alias_chain_metric: i32 = alias_chain - 1
    [[log(label: "types-log-transition_move")]]
    [[log(label: "types-log-transition_move")]]
    let path_sum: i32 = AliasAdd(alias_tuple.0, alias_tuple.1)
    [[log(label: "types-log-transition_move")]]
    let qualified_apply_fn: (i32, i32) -> i32 = AliasAdd
    LogAliasesObject(ctx.fs, scope, "qualified_apply_fn", "(i32,i32)->i32", "constructed", "qualified apply callable prepared")
    [[log(label: "types-log-transition_move")]]
    let qualified_sum: i32 = qualified_apply_fn(alias_tuple.0, alias_tuple.1)
    [[log(label: "types-log-transition_move")]]
    let observed_alias_step: string@View = "observed-type-alias-expansion-metric"
    let observed_cycle_step: string@View = "observed-alias-cycle-baseline-metric"
    let observed_path_step: string@View = "observed-path-resolution-metric"
    let observed_qualified_type_step: string@View = "observed-qualified-type-path-metric"
    let observed_qualified_apply_step: string@View = "observed-qualified-apply-metric"
    let expected_alias: string@View = "15"
    let expected_cycle: string@View = "20"
    let expected_path: string@View = "7"
    let expected_qualified_type: string@View = "4"
    let expected_qualified_apply: string@View = "7"
    let alias_metric_label: string@View = AliasMetricLabel(alias_expanded)
    let cycle_metric_label: string@View = AliasMetricLabel(alias_chain_metric)
    let path_metric_label: string@View = AliasMetricLabel(path_sum)
    let qualified_type_metric_label: string@View = AliasMetricLabel(alias_tuple.1)
    let qualified_apply_metric_label: string@View = AliasMetricLabel(qualified_sum)
    let alias_metric_passed: bool = alias_expanded == 15
    let cycle_metric_passed: bool = alias_chain_metric == 20
    let path_metric_passed: bool = path_sum == 7
    let qualified_type_metric_passed: bool = alias_tuple.1 == 4
    let qualified_apply_metric_passed: bool = qualified_sum == 7

    let alias_metric_passed_log_actual = [[log(label: "observed-type-alias-expansion-metric", expected: "15")]] alias_metric_label
    let alias_metric_passed_with_log: bool = alias_metric_passed && (alias_metric_passed_log_actual == expected_alias)
    let cycle_metric_passed_log_actual = [[log(label: "observed-alias-cycle-baseline-metric", expected: "20")]] cycle_metric_label
    let cycle_metric_passed_with_log: bool = cycle_metric_passed && (cycle_metric_passed_log_actual == expected_cycle)
    let path_metric_passed_log_actual = [[log(label: "observed-path-resolution-metric", expected: "7")]] path_metric_label
    let path_metric_passed_with_log: bool = path_metric_passed && (path_metric_passed_log_actual == expected_path)
    let qualified_type_metric_passed_log_actual = [[log(label: "observed-qualified-type-path-metric", expected: "4")]] qualified_type_metric_label
    let qualified_type_metric_passed_with_log: bool = qualified_type_metric_passed && (qualified_type_metric_passed_log_actual == expected_qualified_type)
    let qualified_apply_metric_passed_log_actual = [[log(label: "observed-qualified-apply-metric", expected: "7")]] qualified_apply_metric_label
    let qualified_apply_metric_passed_with_log: bool = qualified_apply_metric_passed && (qualified_apply_metric_passed_log_actual == expected_qualified_apply)
    [[log(label: "types-log-runtime_phase_move")]]
    if (item_index == 0) {
        return RunAliasesPathsQualifiedApplyItem(
            ctx,
            scope,
            "TypeAliasExpansion",
            "alias declaration typing and expansion at use sites",
            "validated type alias expansion",
            "alias-expansion",
            "expand alias types at value use sites and evaluate concrete operations",
            "15",
            "15",
            "not-15",
            move alias_metric_passed_with_log,
            "type alias expansion check failed"
        )
    }

    if (item_index == 1) {
        return RunAliasesPathsQualifiedApplyItem(
            ctx,
            scope,
            "AliasCycleDiagnostics",
            "cycle detection and diagnostic determinism for recursive aliases",
            "validated alias cycle diagnostics",
            "acyclic-alias-graph",
            "exercise acyclic alias graph as baseline for cycle diagnostics",
            "20",
            "20",
            "not-20",
            move cycle_metric_passed_with_log,
            "alias cycle diagnostics check failed"
        )
    }

    if (item_index == 2) {
        return RunAliasesPathsQualifiedApplyItem(
            ctx,
            scope,
            "PathResolution",
            "absolute, relative, and module-qualified type path resolution",
            "validated type path resolution",
            "path-resolution-call",
            "resolve procedure path and invoke resolved symbol",
            "7",
            "7",
            "not-7",
            move path_metric_passed_with_log,
            "path resolution check failed"
        )
    }

    if (item_index == 3) {
        return RunAliasesPathsQualifiedApplyItem(
            ctx,
            scope,
            "QualifiedTypePaths",
            "qualified names for associated types and nested type members",
            "validated qualified type path rules",
            "qualified-type-path",
            "resolve qualified type path and project tuple member",
            "4",
            "4",
            "not-4",
            move qualified_type_metric_passed_with_log,
            "qualified type path check failed"
        )
    }

    if (item_index == 4) {
        return RunAliasesPathsQualifiedApplyItem(
            ctx,
            scope,
            "QualifiedApplyForms",
            "qualified application syntax and type-directed resolution behavior",
            "validated qualified apply typing",
            "qualified-apply-call",
            "invoke procedure through explicit qualified apply path",
            "7",
            "7",
            "not-7",
            move qualified_apply_metric_passed_with_log,
            "qualified apply check failed"
        )
    }

    return RunAliasesPathsQualifiedApplyItem(
        ctx,
        scope,
        move item_name,
        "unknown aliases/paths/qualified-apply item",
        "failed unknown aliases/paths/qualified-apply item",
        "item-resolution",
        "resolve item name within aliases/paths/qualified-apply feature set",
        "known-item",
        "known-item",
        "unknown-item",
        false,
        "unknown aliases/paths/qualified-apply item"
    )
}

procedure RunAliasesPathsQualifiedApply(ctx: Context) -> i32 {
    let scope: string@View = "types::CoreSystem::AliasesPathsQualifiedApply"
    let checkpoint: string@View = "covered aliases/paths/qualified-apply feature items"

    let status_TypeAliasExpansion: i32 = VerifyAliasesPathsQualifiedApplyItem(ctx, scope, 0, "TypeAliasExpansion")
    if (status_TypeAliasExpansion != 0) {
        return status_TypeAliasExpansion
    }

    let status_AliasCycleDiagnostics: i32 = VerifyAliasesPathsQualifiedApplyItem(ctx, scope, 1, "AliasCycleDiagnostics")
    if (status_AliasCycleDiagnostics != 0) {
        return status_AliasCycleDiagnostics
    }

    let status_PathResolution: i32 = VerifyAliasesPathsQualifiedApplyItem(ctx, scope, 2, "PathResolution")
    if (status_PathResolution != 0) {
        return status_PathResolution
    }

    let status_QualifiedTypePaths: i32 = VerifyAliasesPathsQualifiedApplyItem(ctx, scope, 3, "QualifiedTypePaths")
    if (status_QualifiedTypePaths != 0) {
        return status_QualifiedTypePaths
    }

    let status_QualifiedApplyForms: i32 = VerifyAliasesPathsQualifiedApplyItem(ctx, scope, 4, "QualifiedApplyForms")
    if (status_QualifiedApplyForms != 0) {
        return status_QualifiedApplyForms
    }

    [[log(label: "types-log-checkpoint")]]
    return 0
}
