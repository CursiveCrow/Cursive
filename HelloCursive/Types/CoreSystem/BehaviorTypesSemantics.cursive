procedure BehaviorTypesMetricLabel(value: i32) -> string@View {
    if (value == 9) {
        return "9"
    }
    if (value == 3) {
        return "3"
    }
    return "other"
}

public procedure RunBehaviorTypesSemantics(ctx: Context) -> i32 {
    let static_check_count: i32 = 6
    let runtime_check_count: i32 = 3
    let total_check_count: i32 = static_check_count + runtime_check_count
    let runtime_panic_kind_count: i32 = 3

    let static_partition_ok: bool = static_check_count == 6
    let runtime_partition_ok: bool = runtime_check_count == 3
    let total_partition_ok: bool = total_check_count == 9
    let runtime_behavior_ok: bool = runtime_panic_kind_count == runtime_check_count

    let static_partition_log =
        [[log(label: "observed-behavior-types-static-partition", expected: true)]]
        static_partition_ok
    let runtime_partition_log =
        [[log(label: "observed-behavior-types-runtime-partition", expected: true)]]
        runtime_partition_ok
    let total_partition_log =
        [[log(label: "observed-behavior-types-total-count", expected: true)]]
        total_partition_ok
    let runtime_behavior_log =
        [[log(label: "observed-behavior-types-runtime-behavior", expected: true)]]
        runtime_behavior_ok

    let static_label: string@View = BehaviorTypesMetricLabel(static_check_count)
    let runtime_label: string@View = BehaviorTypesMetricLabel(runtime_check_count)
    let total_label: string@View = BehaviorTypesMetricLabel(total_check_count)
    let static_label_log =
        [[log(label: "observed-behavior-types-static-count-value", expected: "other")]]
        static_label
    let runtime_label_log =
        [[log(label: "observed-behavior-types-runtime-count-value", expected: "3")]]
        runtime_label
    let total_label_log =
        [[log(label: "observed-behavior-types-total-count-value", expected: "9")]]
        total_label

    let overall_ok: bool =
        static_partition_ok &&
        runtime_partition_ok &&
        total_partition_ok &&
        runtime_behavior_ok &&
        (static_partition_log == true) &&
        (runtime_partition_log == true) &&
        (total_partition_log == true) &&
        (runtime_behavior_log == true) &&
        (static_label_log == "other") &&
        (runtime_label_log == "3") &&
        (total_label_log == "9")

    let overall_ok_log =
        [[log(label: "observed-behavior-types-overall-ok", expected: true)]]
        overall_ok
    let _ = ctx
    let context_probe: i32 = 6
    let context_probe_log =
        [[log(label: "observed-behavior-types-context-usage", expected: "other")]]
        BehaviorTypesMetricLabel(context_probe)

    if ((overall_ok == false) || (overall_ok_log == false) || (context_probe_log != "other")) {
        [[log(label: "types-log-item_fail")]]
        return 1
    }

    [[log(label: "types-log-types_item_success")]]
    return 0
}
