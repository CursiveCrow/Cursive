    let bytes_append_length_log_matches_expected: bool = bytes_append_length_log_value == expected_bytes_append_length_value
    let bytes_managed_surface_ok_with_log: bool = bytes_managed_surface_ok && bytes_managed_log_matches_expected && bytes_seed_length_log_matches_expected && bytes_seed_length_metric_log_matches_expected && bytes_from_slice_log_matches_expected && bytes_from_slice_length_log_matches_expected && bytes_from_slice_length_metric_log_matches_expected && bytes_append_log_matches_expected && bytes_append_length_log_matches_expected
    let never_log_value: i32 = [[log(label: "observed-never-control-flow-join", expected: 1)]] never_join
    let never_log_matches_expected: bool = never_log_value == 1
    let never_ok_with_log: bool = never_ok && never_log_matches_expected
    let numeric_log_value: bool = [[log(label: "observed-distinct-numeric-widths", expected: true)]] numeric_distinct
    let numeric_log_matches_expected: bool = numeric_log_value == true
    let numeric_distinct_ok_with_log: bool = numeric_distinct && numeric_log_matches_expected

