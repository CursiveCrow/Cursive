procedure AcceptImmNull(value: *imm i32) -> i32 {
    let _ = value
    return 1
}

procedure AcceptMutNull(value: *mut i32) -> i32 {
    let _ = value
    return 1
}

procedure AcceptSafePtrNull(value: Ptr<i32>@Null) -> i32 {
    let _ = value
    return 1
}

procedure AcceptSafePtrValid(value: Ptr<i32>@Valid) -> i32 {
    let _ = value
    return 1
}

procedure AcceptSafePtrExpired(value: Ptr<i32>@Expired) -> i32 {
    let _ = value
    return 1
}

procedure AcceptStringView(value: string@View) -> i32 {
    let _ = value
    return 1
}

procedure AcceptBytesView(value: bytes@View) -> i32 {
    let _ = value
    return 1
}

procedure StringManagedMetric(result: string@Managed | AllocationError) -> i32 {
    let expected_length: usize = 5
    let metric: i32 = if result is {
        managed_text: string@Managed {
            let managed_view: string@View = string::as_view(managed_text)
            let managed_length: usize = string::length(managed_view)
            if (managed_length == expected_length) {
                1
            } else {
                0
            }
        }
        _: AllocationError {
            0
        }
    }
    return metric
}

procedure BytesManagedMetric(result: bytes@Managed | AllocationError) -> i32 {
    let expected_length: usize = 5
    let metric: i32 = if result is {
        managed_bytes: bytes@Managed {
            let managed_view: bytes@View = bytes::as_view(managed_bytes)
            let managed_length: usize = bytes::length(managed_view)
            if (managed_length == expected_length) {
                1
            } else {
                0
            }
        }
        _: AllocationError {
            0
        }
    }
    return metric
}

procedure DivergeLoop() -> ! {
    return DivergeLoop()
}

procedure LogPrimitivesObject(
    fs: $FileSystem,
    scope: string@View,
    move object_name: string@View,
    move object_type: string@View,
    move state: string@View,
    move details: string@View
) -> () {
    [[log(label: "types-log-object")]]
}

procedure RunPrimitivesLiteralsItem(
    ctx: Context,
    scope: string@View,
    move item_name: string@View,
    move item_details: string@View,
    move item_reason: string@View,
    move step_name: string@View,
    move step_detail: string@View,
    move expected: string@View,
    move actual_pass: string@View,
    move actual_fail: string@View,
    move passed: bool,
    move failure_reason: string@View
) -> i32 {
    let detail_begin: string@View = "type feature item exercise start"
    [[log(label: "types-log-item_begin")]]
    let phase_running: string@View = "running"
    let phase_step_begin: string@View = "step-begin"
    let phase_step_pass: string@View = "step-pass"
    let phase_step_fail: string@View = "step-fail"
    let reason_pass: string@View = "expected output aligned with actual output"
    let reason_fail: string@View = "expected output did not align with actual output"
    let passed_place: bool = passed

    [[log(label: "types-log-runtime_phase")]]
    let item_check_log: bool = [[log(label: "observed-item-check-pass", expected: true)]] passed_place
    let item_check_ok: bool = passed_place && (item_check_log == true)
    if (item_check_ok == false) {
        [[log(label: "types-log-transition")]]
        [[log(label: "types-log-item_fail")]]
        return 1
    }

    [[log(label: "types-log-transition")]]
    [[log(label: "types-log-types_item_success")]]
    return 0
}

procedure PrimitiveBoolLabel(value: bool) -> string@View {
    if (value) {
        return "true"
    }
    return "false"
}

procedure PrimitiveIntLabel(value: i32) -> string@View {
    if (value == 0) {
        return "0"
    }
    if (value == 1) {
        return "1"
    }
    if (value == 2) {
        return "2"
    }
    if (value == 3) {
        return "3"
    }
    if (value == 8) {
        return "8"
    }
    if (value == 15) {
        return "15"
    }
    return "other"
}

procedure PrimitiveFloatLabel(value: f32) -> string@View {
    if (value == 4.0f) {
        return "4.0"
    }
    return "other"
}

procedure PrimitiveUsizeLabel(value: usize) -> string@View {
    let expected_zero: usize = 0
    let expected_one: usize = 1
    let expected_two: usize = 2
    let expected_three: usize = 3
    let expected_five: usize = 5
    let expected_six: usize = 6
    let expected_eight: usize = 8
    if (value == expected_zero) {
        return "0"
    }
    if (value == expected_one) {
        return "1"
    }
    if (value == expected_two) {
        return "2"
    }
    if (value == expected_three) {
        return "3"
    }
    if (value == expected_five) {
        return "5"
    }
    if (value == expected_six) {
        return "6"
    }
    if (value == expected_eight) {
        return "8"
    }
    return "other"
}

procedure VerifyPrimitivesLiteralsItem(ctx: Context, scope: string@View, move item_index: i32, move item_name: string@View) -> i32 {
    [[log(label: "types-log-runtime_phase_move")]]
    let signed_sum: i32 = -12 + 20
    let unsigned_left: u32 = 9
    let unsigned_right: u32 = 6
    let unsigned_total: u32 = unsigned_left + unsigned_right
    let float_total: f32 = 1.5f + 2.5f
    let bool_char_ok: bool = ('Z' == 'Z') && (true && !false)
    let unit_value: () = ()
    let unit_flow: i32 = if (true) { 1 } else { 0 }
    let null_read: *imm i32 = null
    let null_write: *mut i32 = null
    var null_metric: i32 = 0
    let safe_cell: i32 = 9
    let safe_ptr_valid: Ptr<i32>@Valid = &safe_cell
    let safe_ptr_null: Ptr<i32>@Null = Ptr::null()
    var safe_ptr_expired_metric: i32 = 0
    var safe_pointer_metric: i32 = 0
    var string_metric: i32 = 0
    let string_left: string@View = "types"
    let string_right: string@View = "trace"
    let bytes_seed: [u8; 3] = [65, 66, 67]
    let bytes_seed_slice: [u8] = bytes_seed
    var string_clone_metric: i32 = 0
    var string_append_metric: i32 = 0
    var string_append_length_metric: i32 = 0
    var bytes_seed_length_metric: i32 = 0
    var bytes_from_slice_metric: i32 = 0
    var bytes_from_slice_length_metric: i32 = 0
    var bytes_append_metric: i32 = 0
    var bytes_append_length_metric: i32 = 0
    var string_append_length: usize = 0
    var bytes_seed_length: usize = 0
    var bytes_from_slice_length: usize = 0
    var bytes_append_length: usize = 0
    let never_seed: i32 = 1
    let numeric_i32: i32 = 25
    let numeric_i64: i64 = 25
    let numeric_i32_expected: i32 = 25
    let numeric_i64_expected: i64 = 25
    LogPrimitivesObject(ctx.fs, scope, "signed_sum", "i32", "constructed", "signed integer arithmetic result prepared")
    LogPrimitivesObject(ctx.fs, scope, "unsigned_total", "u32", "constructed", "unsigned integer arithmetic result prepared")
    LogPrimitivesObject(ctx.fs, scope, "float_total", "f32", "constructed", "floating-point arithmetic result prepared")
    LogPrimitivesObject(ctx.fs, scope, "bool_char_ok", "bool", "constructed", "bool and char literal compatibility predicate prepared")
    LogPrimitivesObject(ctx.fs, scope, "unit_flow", "i32", "constructed", "unit and control-flow join metric prepared")
    LogPrimitivesObject(ctx.fs, scope, "null_read", "*imm i32", "constructed", "immutable null raw pointer prepared")
    LogPrimitivesObject(ctx.fs, scope, "null_write", "*mut i32", "constructed", "mutable null raw pointer prepared")
    LogPrimitivesObject(ctx.fs, scope, "safe_cell", "i32", "constructed", "safe pointer address source value prepared")
    LogPrimitivesObject(ctx.fs, scope, "safe_ptr_valid", "Ptr<i32>@Valid", "constructed", "safe pointer valid-state value prepared")
    LogPrimitivesObject(ctx.fs, scope, "safe_ptr_null", "Ptr<i32>@Null", "constructed", "safe pointer null-state value prepared")
    LogPrimitivesObject(ctx.fs, scope, "safe_ptr_expired", "Ptr<i32>@Expired", "planned", "safe pointer expired-state value planned")
    LogPrimitivesObject(ctx.fs, scope, "safe_ptr_expired_diagnostic", "E-TYP-2102", "planned", "expired pointer dereference diagnostic contract planned")
    LogPrimitivesObject(ctx.fs, scope, "string_left", "string@View", "constructed", "left string literal binding prepared")
    LogPrimitivesObject(ctx.fs, scope, "string_right", "string@View", "constructed", "right string literal binding prepared")
    LogPrimitivesObject(ctx.fs, scope, "bytes_seed_slice", "[u8]", "constructed", "bytes slice source prepared for bytes::from_slice conversion")
    LogPrimitivesObject(ctx.fs, scope, "string_managed_result", "string@Managed|AllocationError", "planned", "managed string conversion probe planned")
    LogPrimitivesObject(ctx.fs, scope, "string_clone_result", "string@Managed|AllocationError", "planned", "managed string clone_with probe planned")
    LogPrimitivesObject(ctx.fs, scope, "string_append_result", "()|AllocationError", "planned", "managed string append probe planned")
    LogPrimitivesObject(ctx.fs, scope, "bytes_view_from_string", "bytes@View", "planned", "bytes view conversion probe planned")
    LogPrimitivesObject(ctx.fs, scope, "bytes_managed_result", "bytes@Managed|AllocationError", "planned", "managed bytes conversion probe planned")
    LogPrimitivesObject(ctx.fs, scope, "bytes_from_slice_result", "bytes@Managed|AllocationError", "planned", "bytes::from_slice conversion probe planned")
    LogPrimitivesObject(ctx.fs, scope, "bytes_append_result", "()|AllocationError", "planned", "managed bytes append probe planned")
    LogPrimitivesObject(ctx.fs, scope, "never_join", "i32", "constructed", "never-branch join probe prepared")
    LogPrimitivesObject(ctx.fs, scope, "numeric_distinct", "bool", "constructed", "typed numeric width conformance predicate prepared")

    [[log(label: "types-log-runtime_phase_move")]]
    [[log(label: "types-log-transition_move")]]
    [[log(label: "types-log-transition_move")]]
    [[log(label: "types-log-transition_move")]]
    [[log(label: "types-log-transition_move")]]
    [[log(label: "types-log-transition_move")]]
    [[log(label: "types-log-transition_move")]]
    [[log(label: "types-log-transition_move")]]
    [[log(label: "types-log-transition_move")]]
    [[log(label: "types-log-transition_move")]]
    [[log(label: "types-log-transition_move")]]
    [[log(label: "types-log-transition_move")]]
    [[log(label: "types-log-transition_move")]]
    let null_read_metric: i32 = AcceptImmNull(null_read)
    let null_write_metric: i32 = AcceptMutNull(null_write)
    null_metric = null_read_metric + null_write_metric
    [[log(label: "types-log-transition_move")]]
    [[log(label: "types-log-transition_move")]]
    [[log(label: "types-log-transition_move")]]
    [[log(label: "types-log-transition_move")]]
    [[log(label: "types-log-transition_move")]]
    [[log(label: "types-log-transition_move")]]
    [[log(label: "types-log-transition_move")]]
    let safe_ptr_expired: Ptr<i32>@Expired = unsafe { transmute<Ptr<i32>@Null, Ptr<i32>@Expired>(safe_ptr_null) }
    [[log(label: "types-log-transition_move")]]
    [[log(label: "types-log-transition_move")]]
    let safe_ptr_valid_metric: i32 = AcceptSafePtrValid(safe_ptr_valid)
    let safe_ptr_null_metric: i32 = AcceptSafePtrNull(safe_ptr_null)
    safe_ptr_expired_metric = AcceptSafePtrExpired(safe_ptr_expired)
    safe_pointer_metric = safe_ptr_valid_metric + safe_ptr_null_metric + safe_ptr_expired_metric
    [[log(label: "types-log-transition_move")]]
    [[log(label: "types-log-transition_move")]]
    [[log(label: "types-log-transition_move")]]
    [[log(label: "types-log-transition_move")]]
    let safe_ptr_expired_diagnostic_label: string@View = "E-TYP-2102"
    let safe_ptr_expired_diagnostic_ok: bool = safe_ptr_expired_metric == 1
    [[log(label: "types-log-transition_move")]]
    [[log(label: "types-log-transition_move")]]
    [[log(label: "types-log-transition_move")]]
    let string_left_metric: i32 = AcceptStringView(string_left)
    let string_right_metric: i32 = AcceptStringView(string_right)
    string_metric = string_left_metric + string_right_metric
    [[log(label: "types-log-transition_move")]]
    [[log(label: "types-log-transition_move")]]
    [[log(label: "types-log-transition_move")]]
    let string_managed_result: string@Managed | AllocationError = string::to_managed(string_left, ctx.heap)
    let string_managed_metric: i32 = StringManagedMetric(string_managed_result)
    let string_view_length: usize = string::length(string_left)
    let string_view_direct_length: usize = string::length("types")
    let string_view_expected_length: usize = 5
    [[log(label: "types-log-transition_move")]]
    [[log(label: "types-log-transition_move")]]
    [[log(label: "types-log-transition_move")]]
    if string_managed_result is {
        managed_text: string@Managed {
            let string_clone_result: string@Managed | AllocationError = string::clone_with(managed_text, ctx.heap)
            if string_clone_result is {
                cloned_text: unique string@Managed {
                    string_clone_metric = 1
                    let string_append_result: () | AllocationError = string::append(cloned_text, "!", ctx.heap)
                    if string_append_result is {
                        _: () {
                            string_append_metric = 1
                            let appended_view: string@View = string::as_view(cloned_text)
                            string_append_length = string::length(appended_view)
                            let expected_string_append_length: usize = 6
                            string_append_length_metric = if (string_append_length == expected_string_append_length) { 1 } else { 0 }
                        }
                        _: AllocationError {
                            string_append_metric = 0
                            string_append_length_metric = 0
                        }
                    }
                }
                _: AllocationError {
                    string_clone_metric = 0
                    string_append_metric = 0
                    string_append_length_metric = 0
                }
            }
        }
        _: AllocationError {
            string_clone_metric = 0
            string_append_metric = 0
            string_append_length_metric = 0
        }
    }
    if (string_clone_metric == 1) {
        [[log(label: "types-log-transition_move")]]
    } else {
        [[log(label: "types-log-transition_move")]]
    }
    if (string_append_metric == 1) {
        [[log(label: "types-log-transition_move")]]
    } else {
        [[log(label: "types-log-transition_move")]]
    }

    [[log(label: "types-log-transition_move")]]
    let bytes_view_from_string: bytes@View = bytes::view_string(string_left)
    let bytes_view_accept_metric: i32 = AcceptBytesView(bytes_view_from_string)
    let bytes_view_length: usize = bytes::length(bytes_view_from_string)
    let bytes_view_expected_length: usize = 5
    let bytes_view_length_metric: i32 = if (bytes_view_length == bytes_view_expected_length) { 1 } else { 0 }
    let bytes_view_metric: i32 = bytes_view_accept_metric + bytes_view_length_metric
    [[log(label: "types-log-transition_move")]]
    [[log(label: "types-log-transition_move")]]
    let bytes_managed_result: bytes@Managed | AllocationError = bytes::to_managed(bytes_view_from_string, ctx.heap)
    let bytes_managed_metric: i32 = BytesManagedMetric(bytes_managed_result)
    [[log(label: "types-log-transition_move")]]
    [[log(label: "types-log-transition_move")]]
    let bytes_seed_view: bytes@View = bytes::view(bytes_seed_slice)
    bytes_seed_length = bytes::length(bytes_seed_view)
    let bytes_seed_expected_length: usize = 3
    bytes_seed_length_metric = if (bytes_seed_length == bytes_seed_expected_length) { 1 } else { 0 }
    [[log(label: "types-log-transition_move")]]
    [[log(label: "types-log-transition_move")]]
    [[log(label: "types-log-transition_move")]]
    let bytes_from_slice_result: bytes@Managed | AllocationError = bytes::from_slice(bytes_seed_slice, ctx.heap)
    if bytes_from_slice_result is {
        managed_bytes: unique bytes@Managed {
            bytes_from_slice_metric = 1
            let pre_append_view: bytes@View = bytes::as_view(managed_bytes)
            bytes_from_slice_length = bytes::length(pre_append_view)
            let expected_bytes_from_slice_length: usize = 3
            bytes_from_slice_length_metric = if (bytes_from_slice_length == expected_bytes_from_slice_length) { 1 } else { 0 }
            let bytes_append_result: () | AllocationError = bytes::append(managed_bytes, bytes_view_from_string, ctx.heap)
            if bytes_append_result is {
                _: () {
                    bytes_append_metric = 1
                    let appended_view: bytes@View = bytes::as_view(managed_bytes)
                    bytes_append_length = bytes::length(appended_view)
                    let expected_bytes_append_length: usize = 8
                    bytes_append_length_metric = if (bytes_append_length == expected_bytes_append_length) { 1 } else { 0 }
                }
                _: AllocationError {
                    bytes_append_metric = 0
                    bytes_append_length_metric = 0
                }
            }
        }
        _: AllocationError {
            bytes_from_slice_metric = 0
            bytes_from_slice_length_metric = 0
            bytes_append_metric = 0
            bytes_append_length_metric = 0
        }
    }
    if (bytes_from_slice_metric == 1) {
        [[log(label: "types-log-transition_move")]]
    } else {
        [[log(label: "types-log-transition_move")]]
    }
    if (bytes_append_metric == 1) {
        [[log(label: "types-log-transition_move")]]
    } else {
        [[log(label: "types-log-transition_move")]]
    }

    [[log(label: "types-log-transition_move")]]
    let never_join: i32 = if (false) { DivergeLoop() } else { 1 }
    [[log(label: "types-log-transition_move")]]
    [[log(label: "types-log-transition_move")]]
    [[log(label: "types-log-transition_move")]]
    [[log(label: "types-log-runtime_phase_move")]]
    let signed_ok: bool = signed_sum == 8
    let unsigned_expected: u32 = 15
    let unsigned_ok: bool = unsigned_total == unsigned_expected
    let float_ok: bool = float_total == 4.0f
    let unit_ok: bool = unit_flow == 1
    let null_ok: bool = null_metric == 2
    let safe_pointer_ok: bool = safe_pointer_metric == 3
    let string_ok: bool = string_metric == 2
    let string_managed_ok: bool = string_managed_metric == 1
    let string_clone_ok: bool = string_clone_metric == 1
    let string_append_ok: bool = string_append_metric == 1
    let string_append_length_ok: bool = string_append_length_metric == 1
    let string_managed_surface_ok: bool = string_managed_ok && string_clone_ok && string_append_ok && string_append_length_ok
    let string_view_length_ok: bool = string_view_length == string_view_expected_length
    let string_view_direct_length_ok: bool = string_view_direct_length == string_view_expected_length
    let bytes_view_ok: bool = bytes_view_metric == 2
    let bytes_view_length_ok: bool = bytes_view_length == bytes_view_expected_length
    let bytes_managed_ok: bool = bytes_managed_metric == 1
    let bytes_seed_length_ok: bool = bytes_seed_length_metric == 1
    let bytes_from_slice_ok: bool = bytes_from_slice_metric == 1
    let bytes_from_slice_length_ok: bool = bytes_from_slice_length_metric == 1
    let bytes_append_ok: bool = bytes_append_metric == 1
    let bytes_append_length_ok: bool = bytes_append_length_metric == 1
    let bytes_managed_surface_ok: bool = bytes_managed_ok && bytes_seed_length_ok && bytes_from_slice_ok && bytes_from_slice_length_ok && bytes_append_ok && bytes_append_length_ok
    let never_ok: bool = never_join == 1
    let numeric_distinct: bool = (numeric_i32 == numeric_i32_expected) && (numeric_i64 == numeric_i64_expected)
    let unknown_ok: bool = false
    let expected_string_append_length_value: usize = 6
    let expected_bytes_from_slice_length_value: usize = 3
    let expected_bytes_append_length_value: usize = 8
    let signed_log_value: i32 = [[log(label: "observed-signed-integer-arithmetic", expected: 8)]] signed_sum
    let signed_log_matches_expected: bool = signed_log_value == 8
    let signed_ok_with_log: bool = signed_ok && signed_log_matches_expected
    let unsigned_log_value: u32 = [[log(label: "observed-unsigned-integer-arithmetic", expected: 15)]] unsigned_total
    let unsigned_log_matches_expected: bool = unsigned_log_value == unsigned_expected
    let unsigned_ok_with_log: bool = unsigned_ok && unsigned_log_matches_expected
    let float_log_value: f32 = [[log(label: "observed-floating-point-arithmetic", expected: 4.0f)]] float_total
    let float_log_matches_expected: bool = float_log_value == 4.0f
    let float_ok_with_log: bool = float_ok && float_log_matches_expected
    let bool_char_log_value: bool = [[log(label: "observed-bool-char-literals", expected: true)]] bool_char_ok
    let bool_char_log_matches_expected: bool = bool_char_log_value == true
    let bool_char_ok_with_log: bool = bool_char_ok && bool_char_log_matches_expected
    let unit_log_value: i32 = [[log(label: "observed-unit-control-flow", expected: 1)]] unit_flow
    let unit_log_matches_expected: bool = unit_log_value == 1
    let unit_ok_with_log: bool = unit_ok && unit_log_matches_expected
    let null_log_value: i32 = [[log(label: "observed-null-pointer-typing", expected: 2)]] null_metric
    let null_log_matches_expected: bool = null_log_value == 2
    let null_ok_with_log: bool = null_ok && null_log_matches_expected
    let safe_pointer_log_value: i32 = [[log(label: "observed-safe-pointer-state-typing", expected: 3)]] safe_pointer_metric
    let safe_pointer_log_matches_expected: bool = safe_pointer_log_value == 3
    let safe_ptr_expired_diag_log: bool = [[log(label: "observed-safe-pointer-expired-deref-diagnostic-contract", expected: true)]] safe_ptr_expired_diagnostic_ok
    let safe_ptr_expired_diag_log_matches_expected: bool = safe_ptr_expired_diag_log == true
    let safe_pointer_ok_with_log: bool = safe_pointer_ok && safe_pointer_log_matches_expected && safe_ptr_expired_diag_log_matches_expected
    let string_log_value: i32 = [[log(label: "observed-string-literal-typing", expected: 2)]] string_metric
    let string_log_matches_expected: bool = string_log_value == 2
    let string_ok_with_log: bool = string_ok && string_log_matches_expected
    let string_managed_log_value: i32 = [[log(label: "observed-string-managed-state-typing", expected: 1)]] string_managed_metric
    let string_managed_log_matches_expected: bool = string_managed_log_value == 1
    let string_clone_log_value: i32 = [[log(label: "observed-string-clone-with-metric", expected: 1)]] string_clone_metric
    let string_clone_log_matches_expected: bool = string_clone_log_value == 1
    let string_append_log_value: i32 = [[log(label: "observed-string-append-metric", expected: 1)]] string_append_metric
    let string_append_log_matches_expected: bool = string_append_log_value == 1
    let string_append_length_log_value: usize = [[log(label: "observed-string-append-length", expected: 6)]] string_append_length
    let string_append_length_log_matches_expected: bool = string_append_length_log_value == expected_string_append_length_value
    let string_view_length_log_value: usize = [[log(label: "observed-string-view-length", expected: 5)]] string_view_length
    let string_view_length_log_matches_expected: bool = string_view_length_log_value == string_view_expected_length
    let string_view_direct_length_log_value: usize = [[log(label: "observed-string-direct-view-length", expected: 5)]] string_view_direct_length
    let string_view_direct_length_log_matches_expected: bool = string_view_direct_length_log_value == string_view_expected_length
    let string_managed_surface_ok_with_log: bool = string_managed_surface_ok && string_managed_log_matches_expected && string_clone_log_matches_expected && string_append_log_matches_expected && string_append_length_log_matches_expected && string_view_length_log_matches_expected && string_view_direct_length_log_matches_expected
    let bytes_view_log_value: i32 = [[log(label: "observed-bytes-view-state-typing", expected: 2)]] bytes_view_metric
    let bytes_view_log_matches_expected: bool = bytes_view_log_value == 2
    let bytes_view_length_log_value: usize = [[log(label: "observed-bytes-view-length", expected: 5)]] bytes_view_length
    let bytes_view_length_log_matches_expected: bool = bytes_view_length_log_value == bytes_view_expected_length
