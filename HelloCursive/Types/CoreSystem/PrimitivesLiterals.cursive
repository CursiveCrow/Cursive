    let bytes_from_slice_length_metric_log_matches_expected: bool = bytes_from_slice_length_metric_log_value == 1
    let bytes_append_log_value: i32 = [[log(label: "observed-bytes-append-metric", expected: 1)]] bytes_append_metric
