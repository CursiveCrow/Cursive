procedure RunPrimitivesLiterals(ctx: Context) -> i32 {
    let scope: string@View = "types::CoreSystem::PrimitivesLiterals"
    let checkpoint: string@View = "covered primitives/literals feature items"

    let status_SignedIntegers: i32 = VerifyPrimitivesLiteralsItem(ctx, scope, 0, "SignedIntegers")
    if (status_SignedIntegers != 0) {
        return status_SignedIntegers
    }

    let status_UnsignedIntegers: i32 = VerifyPrimitivesLiteralsItem(ctx, scope, 1, "UnsignedIntegers")
    if (status_UnsignedIntegers != 0) {
        return status_UnsignedIntegers
    }

    let status_FloatingPoint: i32 = VerifyPrimitivesLiteralsItem(ctx, scope, 2, "FloatingPoint")
    if (status_FloatingPoint != 0) {
        return status_FloatingPoint
    }

    let status_BoolAndChar: i32 = VerifyPrimitivesLiteralsItem(ctx, scope, 3, "BoolAndChar")
    if (status_BoolAndChar != 0) {
        return status_BoolAndChar
    }

    let status_UnitAndNever: i32 = VerifyPrimitivesLiteralsItem(ctx, scope, 4, "UnitAndNever")
    if (status_UnitAndNever != 0) {
        return status_UnitAndNever
    }

    let status_NullLiteral: i32 = VerifyPrimitivesLiteralsItem(ctx, scope, 5, "NullLiteral")
    if (status_NullLiteral != 0) {
        return status_NullLiteral
    }

    let status_SafePointerStates: i32 = VerifyPrimitivesLiteralsItem(ctx, scope, 6, "SafePointerStates")
    if (status_SafePointerStates != 0) {
        return status_SafePointerStates
    }

    let status_NumericNoSubtyping: i32 = VerifyPrimitivesLiteralsItem(ctx, scope, 7, "NumericNoSubtyping")
    if (status_NumericNoSubtyping != 0) {
        return status_NumericNoSubtyping
    }

    let status_NeverTypeControlFlow: i32 = VerifyPrimitivesLiteralsItem(ctx, scope, 8, "NeverTypeControlFlow")
    if (status_NeverTypeControlFlow != 0) {
        return status_NeverTypeControlFlow
    }

    let status_StringLiterals: i32 = VerifyPrimitivesLiteralsItem(ctx, scope, 9, "StringLiterals")
    if (status_StringLiterals != 0) {
        return status_StringLiterals
    }

    let status_StringManagedStates: i32 = VerifyPrimitivesLiteralsItem(ctx, scope, 10, "StringManagedStates")
    if (status_StringManagedStates != 0) {
        return status_StringManagedStates
    }

    let status_BytesViewStates: i32 = VerifyPrimitivesLiteralsItem(ctx, scope, 11, "BytesViewStates")
    if (status_BytesViewStates != 0) {
        return status_BytesViewStates
    }

    let status_BytesManagedStates: i32 = VerifyPrimitivesLiteralsItem(ctx, scope, 12, "BytesManagedStates")
    if (status_BytesManagedStates != 0) {
        return status_BytesManagedStates
    }

    [[log(label: "types-log-checkpoint")]]
    return 0
}
