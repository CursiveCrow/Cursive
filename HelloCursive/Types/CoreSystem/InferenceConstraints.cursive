procedure AddPair(lhs: i32, rhs: i32) -> i32 {
    return lhs + rhs
}

procedure ChooseValue(flag: bool, when_true: i32, when_false: i32) -> i32 {
    if (flag) {
        return when_true
    }
    return when_false
}

procedure IdentityInfer<T>(value: T) -> T {
    return value
}

procedure LogInferenceObject(
    fs: $FileSystem,
    scope: string@View,
    move object_name: string@View,
    move object_type: string@View,
    move state: string@View,
    move details: string@View
) -> () {
    }

procedure RunInferenceConstraintsItem(
    ctx: Context,
    scope: string@View,
    move item_name: string@View,
    move item_details: string@View,
    move item_reason: string@View,
    move step_name: string@View,
    move step_detail: string@View,
    move expected: string@View,
    move actual_pass: string@View,
    move actual_fail: string@View,
    move passed: bool,
    move failure_reason: string@View
) -> i32 {
    let detail_begin: string@View = "type feature item exercise start"
    let phase_running: string@View = "running"
    let phase_step_begin: string@View = "step-begin"
    let phase_step_pass: string@View = "step-pass"
    let phase_step_fail: string@View = "step-fail"
    let reason_pass: string@View = "expected output aligned with actual output"
    let reason_fail: string@View = "expected output did not align with actual output"
    let passed_place: bool = passed

    let item_check_log: bool = passed_place
    let item_check_ok: bool = passed_place && (item_check_log == true)
    if (item_check_ok == false) {
        return 1
    }

    return 0
}

procedure InferenceMetricLabel(value: i32) -> string@View {
    if (value == 0) {
        return "0"
    }
    if (value == 1) {
        return "1"
    }
    if (value == 20) {
        return "20"
    }
    if (value == 23) {
        return "23"
    }
    if (value == 42) {
        return "42"
    }
    return "other"
}

procedure InferenceBoolLabel(value: bool) -> string@View {
    if (value) {
        return "true"
    }
    return "false"
}

procedure VerifyInferenceConstraintsItem(ctx: Context, scope: string@View, move item_index: i32, move item_name: string@View) -> i32 {
    let inferred_lhs = 14
    let inferred_rhs = 9
    let inferred_pair = (inferred_lhs, inferred_rhs)
    LogInferenceObject(ctx.fs, scope, "inferred_pair", "(i32,i32)", "constructed", "bidirectional inference tuple source prepared")

    let inferred_total = AddPair(inferred_pair.0, inferred_pair.1)
    let local_choose_flag: bool = inferred_total == 23
    let local_choose_true: i32 = inferred_total - 3
    let local_choose_false: i32 = 0
    LogInferenceObject(ctx.fs, scope, "local_choose_inputs", "bool,i32,i32", "constructed", "local inference branch inputs prepared")
    let local_value = ChooseValue(local_choose_flag, local_choose_true, local_choose_false)
    let inferred_total_checked: i32 = IdentityInfer(inferred_total)
    let constraint_bool = (local_value == 20) && (inferred_total_checked == 23)
    let solve_true: i32 = 1
    let solve_false: i32 = 0
    LogInferenceObject(ctx.fs, scope, "constraint_solver_inputs", "bool,i32,i32", "constructed", "constraint-solving branch inputs prepared")
    let solved_join = ChooseValue(constraint_bool, solve_true, solve_false)
    LogInferenceObject(ctx.fs, scope, "ambiguity_seed", "i32", "constructed", "ambiguity fallback seed prepared")
    let ambiguity_seed: i32 = 42
    let ambiguity_fallback: i32 = IdentityInfer(ambiguity_seed)
    let inference_diag_ok = (ambiguity_fallback == 42) && constraint_bool && (solved_join == 1)

    let observed_bidirectional_step: string@View = "observed-bidirectional-inference-metric"
    let observed_local_step: string@View = "observed-local-inference-metric"
    let observed_constraint_generation_step: string@View = "observed-constraint-generation-metric"
    let observed_constraint_solving_step: string@View = "observed-constraint-solving-metric"
    let observed_ambiguity_step: string@View = "observed-ambiguity-fallback-metric"
    let observed_diagnostics_step: string@View = "observed-inference-diagnostics-metric"
    let expected_bidirectional: string@View = "23"
    let expected_local: string@View = "20"
    let expected_constraint_generation: string@View = "true"
    let expected_constraint_solving: string@View = "1"
    let expected_ambiguity: string@View = "42"
    let expected_diagnostics: string@View = "true"
    let bidirectional_metric_label: string@View = InferenceMetricLabel(inferred_total)
    let local_metric_label: string@View = InferenceMetricLabel(local_value)
    let constraint_generation_metric_label: string@View = InferenceBoolLabel(constraint_bool)
    let constraint_solving_metric_label: string@View = InferenceMetricLabel(solved_join)
    let ambiguity_metric_label: string@View = InferenceMetricLabel(ambiguity_fallback)
    let diagnostics_metric_label: string@View = InferenceBoolLabel(inference_diag_ok)
    let bidirectional_metric_passed: bool = inferred_total == 23
    let local_metric_passed: bool = local_value == 20
    let constraint_generation_metric_passed: bool = constraint_bool
    let constraint_solving_metric_passed: bool = solved_join == 1
    let ambiguity_metric_passed: bool = ambiguity_fallback == 42
    let diagnostics_metric_passed: bool = inference_diag_ok

    let bidirectional_metric_passed_log_actual = bidirectional_metric_label
    let bidirectional_metric_passed_with_log: bool = bidirectional_metric_passed && (bidirectional_metric_passed_log_actual == expected_bidirectional)
    let local_metric_passed_log_actual = local_metric_label
    let local_metric_passed_with_log: bool = local_metric_passed && (local_metric_passed_log_actual == expected_local)
    let constraint_generation_metric_passed_log_actual = constraint_generation_metric_label
    let constraint_generation_metric_passed_with_log: bool = constraint_generation_metric_passed && (constraint_generation_metric_passed_log_actual == expected_constraint_generation)
    let constraint_solving_metric_passed_log_actual = constraint_solving_metric_label
    let constraint_solving_metric_passed_with_log: bool = constraint_solving_metric_passed && (constraint_solving_metric_passed_log_actual == expected_constraint_solving)
    let ambiguity_metric_passed_log_actual = ambiguity_metric_label
    let ambiguity_metric_passed_with_log: bool = ambiguity_metric_passed && (ambiguity_metric_passed_log_actual == expected_ambiguity)
    let diagnostics_metric_passed_log_actual = diagnostics_metric_label
    let diagnostics_metric_passed_with_log: bool = diagnostics_metric_passed && (diagnostics_metric_passed_log_actual == expected_diagnostics)
    if (item_index == 0) {
        return RunInferenceConstraintsItem(
            ctx,
            scope,
            "BidirectionalInference",
            "expected-type to expression and expression to expected-type inference propagation",
            "validated bidirectional inference",
            "bidirectional-flow",
            "infer expression type from context and propagate backward constraints",
            "23",
            "23",
            "not-23",
            move bidirectional_metric_passed_with_log,
            "bidirectional inference check failed"
        )
    }

    if (item_index == 1) {
        return RunInferenceConstraintsItem(
            ctx,
            scope,
            "LocalInference",
            "local variable and expression-context inference without global guessing",
            "validated local type inference",
            "local-binding-inference",
            "infer local binding types from initializer expressions",
            "20",
            "20",
            "not-20",
            move local_metric_passed_with_log,
            "local inference check failed"
        )
    }

    if (item_index == 2) {
        return RunInferenceConstraintsItem(
            ctx,
            scope,
            "ConstraintGeneration",
            "equational and bound constraints emitted from calls, operators, and patterns",
            "validated constraint generation",
            "constraint-emission",
            "generate constraints from arithmetic and comparison relationships",
            "true",
            "true",
            "false",
            move constraint_bool,
            "constraint generation check failed"
        )
    }

    if (item_index == 3) {
        return RunInferenceConstraintsItem(
            ctx,
            scope,
            "ConstraintSolving",
            "solver unification, bound satisfaction, and deterministic conflict handling",
            "validated constraint solving",
            "constraint-solver-result",
            "solve generated constraints into a single branch-stable result",
            "1",
            "1",
            "not-1",
            move constraint_solving_metric_passed_with_log,
            "constraint solving check failed"
        )
    }

    if (item_index == 4) {
        return RunInferenceConstraintsItem(
            ctx,
            scope,
            "AmbiguityFallback",
            "ambiguous inference surfaces requiring annotations and default blocking",
            "validated ambiguity fallback behavior",
            "ambiguity-default-int",
            "use explicit fallback integer typing when context does not constrain width",
            "42",
            "42",
            "not-42",
            move ambiguity_metric_passed_with_log,
            "ambiguity fallback check failed"
        )
    }

    if (item_index == 5) {
        return RunInferenceConstraintsItem(
            ctx,
            scope,
            "InferenceDiagnostics",
            "deterministic diagnostics for failed unification and unsatisfied constraints",
            "validated inference failure diagnostics",
            "diagnostic-surface",
            "evaluate deterministic diagnostic surface prerequisites",
            "true",
            "true",
            "false",
            move inference_diag_ok,
            "inference diagnostics check failed"
        )
    }

    return RunInferenceConstraintsItem(
        ctx,
        scope,
        move item_name,
        "unknown inference/constraints item",
        "failed unknown inference/constraints item",
        "item-resolution",
        "resolve item name within inference/constraints feature set",
        "known-item",
        "known-item",
        "unknown-item",
        false,
        "unknown inference/constraints item"
    )
}

procedure RunInferenceConstraints(ctx: Context) -> i32 {
    let scope: string@View = "types::CoreSystem::InferenceConstraints"
    let checkpoint: string@View = "covered inference/constraints feature items"

    let status_BidirectionalInference: i32 = VerifyInferenceConstraintsItem(ctx, scope, 0, "BidirectionalInference")
    if (status_BidirectionalInference != 0) {
        return status_BidirectionalInference
    }

    let status_LocalInference: i32 = VerifyInferenceConstraintsItem(ctx, scope, 1, "LocalInference")
    if (status_LocalInference != 0) {
        return status_LocalInference
    }

    let status_ConstraintGeneration: i32 = VerifyInferenceConstraintsItem(ctx, scope, 2, "ConstraintGeneration")
    if (status_ConstraintGeneration != 0) {
        return status_ConstraintGeneration
    }

    let status_ConstraintSolving: i32 = VerifyInferenceConstraintsItem(ctx, scope, 3, "ConstraintSolving")
    if (status_ConstraintSolving != 0) {
        return status_ConstraintSolving
    }

    let status_AmbiguityFallback: i32 = VerifyInferenceConstraintsItem(ctx, scope, 4, "AmbiguityFallback")
    if (status_AmbiguityFallback != 0) {
        return status_AmbiguityFallback
    }

    let status_InferenceDiagnostics: i32 = VerifyInferenceConstraintsItem(ctx, scope, 5, "InferenceDiagnostics")
    if (status_InferenceDiagnostics != 0) {
        return status_InferenceDiagnostics
    }

    return 0
}
