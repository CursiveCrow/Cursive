type AstAliasPrim = i32
type AstAliasTuple = (i32, bool)
type AstAliasSingle = (i32;)
type AstAliasArray = [i32; 3]
type AstAliasSlice = [i32]
type AstAliasUnion = i32 | bool
type AstAliasFn = (i32, i32) -> i32
type AstAliasConst = const i32
type AstAliasUnique = unique i32
type AstAliasShared = shared i32
type AstAliasPtr = Ptr<i32>@Valid
type AstAliasRawImm = *imm i32
type AstAliasString = string@View
type AstAliasBytes = bytes@View
type AstAliasRefine = i32 |: { self >= 0 }

procedure AstAliasAdd(left: i32, right: i32) -> i32 {
    return left + right
}

procedure TypeAstNodeCatalogMetricLabel(value: i32) -> string@View {
    if (value == 65) {
        return "65"
    }
    return "other"
}

public procedure RunTypeAstNodeCatalogCoverage(ctx: Context) -> i32 {
    let _ = ctx

    let tuple_value: AstAliasTuple = (3, true)
    let single_value: AstAliasSingle = (4;)
    let array_value: AstAliasArray = [1, 2, 3]
    let array_for_slice: [i32; 3] = [1, 2, 3]
    let slice_value: [i32] = array_for_slice
    let union_value: AstAliasUnion = true
    let fn_value: AstAliasFn = AstAliasAdd
    let const_source: unique i32 = 5
    let shared_source: unique i32 = 6
    let unique_value: unique i32 = 7
    let const_value: AstAliasConst = const_source
    let shared_value: AstAliasShared = shared_source

    var ptr_cell: AstAliasPrim = 9
    let ptr_value: AstAliasPtr = &ptr_cell
    let raw_value: AstAliasRawImm = unsafe { transmute<Ptr<i32>@Valid, *imm i32>(ptr_value) }

    let text_value: AstAliasString = "ast"
    let byte_seed: [u8; 3] = [65, 66, 67]
    let byte_slice: [u8] = byte_seed
    let bytes_value: AstAliasBytes = bytes::view(byte_slice)
    let refine_value: AstAliasRefine = 1

    let tuple_metric: i32 = tuple_value.0 + single_value.0
    let array_metric: i32 = array_value[0] + array_value[1] + array_value[2]
    let slice_metric: i32 = slice_value[0] + slice_value[1]
    let union_metric: i32 = if union_value is {
        _: i32 { 0 }
        _: bool { 1 }
    }
    let fn_metric: i32 = fn_value(2, 3)
    let ptr_metric: i32 = *ptr_value
    let raw_metric: i32 = ptr_metric
    let text_metric: i32 = string::length(text_value) as i32
    let bytes_metric: i32 = bytes::length(bytes_value) as i32
    let permission_metric: i32 = const_value + shared_value + unique_value
    let refine_metric: i32 = refine_value

    let total_metric: i32 =
        tuple_metric +
        array_metric +
        slice_metric +
        union_metric +
        fn_metric +
        ptr_metric +
        raw_metric +
        text_metric +
        bytes_metric +
        permission_metric +
        refine_metric

    let tuple_metric_log: i32 =
        [[log(label: "types-core-ast-catalog-tuple-metric", expected: 7)]]
        tuple_metric
    let array_metric_log: i32 =
        [[log(label: "types-core-ast-catalog-array-metric", expected: 6)]]
        array_metric
    let slice_metric_log: i32 =
        [[log(label: "types-core-ast-catalog-slice-metric", expected: 3)]]
        slice_metric
    let union_metric_log: i32 =
        [[log(label: "types-core-ast-catalog-union-metric", expected: 1)]]
        union_metric
    let fn_metric_log: i32 =
        [[log(label: "types-core-ast-catalog-fn-metric", expected: 5)]]
        fn_metric
    let ptr_metric_log: i32 =
        [[log(label: "types-core-ast-catalog-ptr-metric", expected: 9)]]
        ptr_metric
    let raw_metric_log: i32 =
        [[log(label: "types-core-ast-catalog-raw-metric", expected: 9)]]
        raw_metric
    let text_metric_log: i32 =
        [[log(label: "types-core-ast-catalog-string-metric", expected: 3)]]
        text_metric
    let bytes_metric_log: i32 =
        [[log(label: "types-core-ast-catalog-bytes-metric", expected: 3)]]
        bytes_metric
    let permission_metric_log: i32 =
        [[log(label: "types-core-ast-catalog-permission-metric", expected: 18)]]
        permission_metric
    let refine_metric_log: i32 =
        [[log(label: "types-core-ast-catalog-refine-metric", expected: 1)]]
        refine_metric
    let total_metric_log: i32 =
        [[log(label: "types-core-ast-catalog-total-metric", expected: 65)]]
        total_metric

    let components_ok: bool =
        (tuple_metric_log == 7) &&
        (array_metric_log == 6) &&
        (slice_metric_log == 3) &&
        (union_metric_log == 1) &&
        (fn_metric_log == 5) &&
        (ptr_metric_log == 9) &&
        (raw_metric_log == 9) &&
        (text_metric_log == 3) &&
        (bytes_metric_log == 3) &&
        (permission_metric_log == 18) &&
        (refine_metric_log == 1) &&
        (total_metric_log == 65)

    let total_ok: bool = total_metric == 65
    let shape_ok: bool =
        tuple_value.1 &&
        (string::length(text_value) == 3usize) &&
        (bytes::length(bytes_value) == 3usize)

    let total_ok_log: bool =
        [[log(label: "types-core-ast-catalog-total", expected: true)]]
        total_ok
    let shape_ok_log: bool =
        [[log(label: "types-core-ast-catalog-shape", expected: true)]]
        shape_ok

    let metric: i32 =
        if ((components_ok == true) && (total_ok_log == true) && (shape_ok_log == true)) {
            65
        } else {
            0
        }
    let metric_label: string@View = TypeAstNodeCatalogMetricLabel(metric)
    let metric_log_actual: string@View =
        [[log(label: "observed-types-core-type-ast-node-catalog-metric", expected: "65")]]
        metric_label
    if (metric_log_actual != "65") {
        [[log(label: "types-log-item_fail")]]
        return 1
    }

    [[log(label: "types-log-types_item_success")]]
    return 0
}
