record TypeParsingPathProbe {
    value: i32
}

class TypeParsingSelfVarSurface {
    procedure combine(~, other: const Self) -> i32
    procedure bumped(~) -> Self
}

record TypeParsingSelfVarBox <: TypeParsingSelfVarSurface {
    value: i32

    procedure combine(~, other: const Self) -> i32 {
        return self.value + other.value
    }

    procedure bumped(~) -> Self {
        return TypeParsingSelfVarBox { value: self.value + 1 }
    }
}

type TypeParsingGenericPair<T> = (T, T)

type ParseTypePermConst = const i32
type ParseTypePermUnique = unique i32
type ParseTypePermShared = shared i32
type ParseTypeTuple = (i32, bool)
type ParseTypeArray = [i32; 3]
type ParseTypeSlice = [i32]
type ParseTypeUnion = i32 | bool | u8
type ParseTypeFn = (move i32, i32) -> i32
type ParseTypePtrApply = Ptr<i32>@Valid
type ParseTypeRaw = *imm i32
type ParseTypeString = string@View
type ParseTypeDynamic = $HeapAllocator
type ParseTypePath = TypeParsingPathProbe
type ParseTypeGenericPair = TypeParsingGenericPair<i32>
type ParseTypeGenericNested = TypeParsingGenericPair<TypeParsingGenericPair<i32>>
type ParseTypeRefine = i32 |: { self >= 0 }

procedure TypeParsingSurfaceAdd(move left: i32, right: i32) -> i32 {
    return left + right
}

procedure TypeParsingSurfaceSliceWindow(view: [i32]) -> i32 {
    return view[0] + view[2]
}

procedure TypeParsingSurfaceMetricLabel(value: i32) -> string@View {
    if (value == 93) {
        return "93"
    }
    if (value == 118) {
        return "118"
    }
    return "other"
}

procedure RunTypeParsingSurfaceCoverage(ctx: Context) -> i32 {
    let tuple_value: ParseTypeTuple = (4, true)
    let array_value: ParseTypeArray = [3, 5, 7]
    let array_for_slice: [i32; 3] = [3, 5, 7]
    let slice_value: [i32] = array_for_slice
    let union_value: ParseTypeUnion = 2u8
    let fn_value: ParseTypeFn = TypeParsingSurfaceAdd
    let text_value: ParseTypeString = "parse"
    let path_value: ParseTypePath = TypeParsingPathProbe { value: 9 }
    let selfvar_left: TypeParsingSelfVarBox = TypeParsingSelfVarBox { value: 7 }
    let selfvar_right: TypeParsingSelfVarBox = TypeParsingSelfVarBox { value: 10 }
    let selfvar_bumped: TypeParsingSelfVarBox = selfvar_left~>bumped()
    let generic_left_metric: i32 = 12
    let generic_right_metric: i32 = 13
    let generic_nested_metric: i32 = 14
    let generic_pair_value: ParseTypeGenericPair = (generic_left_metric, generic_right_metric)
    let generic_nested_value: ParseTypeGenericNested = ((generic_nested_metric, 0), (0, 0))
    let _ = generic_pair_value
    let _ = generic_nested_value
    let refine_value: ParseTypeRefine = 5

    let const_source: unique i32 = 10
    let shared_source: unique i32 = 11
    let const_value: ParseTypePermConst = const_source
    let shared_value: ParseTypePermShared = shared_source

    var ptr_cell: i32 = 6
    let ptr_value: ParseTypePtrApply = &ptr_cell
    let raw_value: ParseTypeRaw = unsafe { transmute<Ptr<i32>@Valid, *imm i32>(ptr_value) }

    var dynamic_heap: ParseTypeDynamic = ctx.heap
    let _ = dynamic_heap

    let fn_left: i32 = 8
    let tuple_metric: i32 = tuple_value.0 + if (tuple_value.1) { 1 } else { 0 }
    let array_metric: i32 = array_value[0] + array_value[1] + array_value[2]
    let slice_metric: i32 = slice_value[0] + slice_value[1]
    let union_metric: i32 = if union_value is {
        _: i32 { 1 }
        _: bool { 2 }
        _: u8 { 3 }
    }
    let fn_metric: i32 = fn_value(move fn_left, 1)
    let ptr_metric: i32 = *ptr_value
    let raw_metric: i32 = ptr_metric
    let text_metric: i32 = string::length(text_value) as i32
    let path_metric: i32 = path_value.value
    let selfvar_metric: i32 = selfvar_left~>combine(selfvar_right) + selfvar_bumped.value
    let selfvar_runtime_ok: bool = selfvar_metric == 25
    let selfvar_runtime_log: bool =
        selfvar_runtime_ok
    let generic_args_opt_none_runtime_ok: bool = path_metric == 9
    let generic_args_opt_none_runtime_log: bool =
        generic_args_opt_none_runtime_ok
    let generic_args_opt_yes_runtime_ok: bool = ptr_metric == 6
    let generic_args_opt_yes_runtime_log: bool =
        generic_args_opt_yes_runtime_ok
    let generic_type_apply_metric: i32 =
        generic_left_metric +
        generic_right_metric +
        generic_nested_metric
    let generic_type_apply_ok: bool = generic_type_apply_metric == 39
    let generic_type_apply_log: bool =
        generic_type_apply_ok
    let refine_metric: i32 = refine_value
    let permission_metric: i32 = const_value + shared_value
    let dynamic_metric: i32 = 1
    let slice_param_metric: i32 = TypeParsingSurfaceSliceWindow(array_for_slice)
    let slice_coercion_ok: bool = slice_param_metric == 10
    let slice_coercion_ok_log: bool =
        slice_coercion_ok

    let total_metric: i32 =
        tuple_metric +
        array_metric +
        slice_metric +
        union_metric +
        fn_metric +
        ptr_metric +
        raw_metric +
        text_metric +
        path_metric +
        selfvar_metric +
        refine_metric +
        permission_metric +
        dynamic_metric

    let parse_surface_ok: bool =
        (total_metric == 118) &&
        selfvar_runtime_ok &&
        (selfvar_runtime_log == true) &&
        slice_coercion_ok &&
        generic_args_opt_none_runtime_ok &&
        (generic_args_opt_none_runtime_log == true) &&
        generic_args_opt_yes_runtime_ok &&
        (generic_args_opt_yes_runtime_log == true) &&
        generic_type_apply_ok &&
        (generic_type_apply_log == true) &&
        (slice_coercion_ok_log == true)
    let parse_surface_ok_log: bool =
        parse_surface_ok

    let metric: i32 = if ((parse_surface_ok_log == true) && parse_surface_ok) { 118 } else { 0 }
    let metric_label: string@View = TypeParsingSurfaceMetricLabel(metric)
    let metric_log_actual: string@View =
        metric_label
    if (metric_log_actual != "118") {
        return 1
    }

    return 0
}
