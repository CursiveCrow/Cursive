[[layout(C)]]
record FfiSafeRecord {
    x: i32
    y: i32
}

[[mangle("hc_ffi_exercise_add_impl"), export("C")]]
public procedure ffiExerciseAddImpl(a: i32, b: i32) -> i32 {
    return a + b
}

[[mangle("hc_ffi_exercise_negate_impl"), export("C")]]
public procedure ffiExerciseNegateImpl(value: i32) -> i32 {
    return 0 - value
}

[[mangle("hc_ffi_exercise_record_sum_impl"), export("C")]]
public procedure ffiExerciseRecordSumImpl(x: i32, y: i32) -> i32 {
    return x + y
}

[[mangle("hc_ffi_extern_shell_probe_impl"), export("C")]]
public procedure ffiExternShellProbeImpl() -> i32 {
    return 17
}

[[mangle("hc_ffi_extern_no_attrs_probe_impl"), export("C")]]
public procedure ffiExternNoAttrsProbeImpl() -> i32 {
    return 23
}

extern "C" {
    procedure hc_ffi_exercise_add_impl(a: i32, b: i32) -> i32
    procedure hc_ffi_exercise_negate_impl(value: i32) -> i32
    procedure hc_ffi_exercise_record_sum_impl(x: i32, y: i32) -> i32
}

extern "C" {
    procedure hc_ffi_exercise_foreign_read(buf: *mut u8, len: usize) -> i32
        |: @foreign_assumes(buf != null, len > 0)
        |: @foreign_ensures(@result >= 0)
        |: @foreign_ensures(@error: @result < 0)
}

internal extern "C" {
    procedure hc_ffi_extern_shell_probe_impl() -> i32
}

internal extern "C" {
    procedure hc_ffi_extern_no_attrs_probe_impl() -> i32
}

public procedure runFfiMultipleExternBlockExercise(ctx: Context) -> i32 {
    let _ = ctx
    [[log(label: "ffi-log-item_begin")]]

    let add_result: i32 = unsafe { hc_ffi_exercise_add_impl(3, 4) }
    let add_result_log: i32 = [[log(label: "observed-ffi-exercise-add-result", expected: 7)]] add_result

    let negate_result: i32 = unsafe { hc_ffi_exercise_negate_impl(8) }
    let negate_expected: i32 = 0 - 8
    let negate_result_log: i32 = [[log(label: "observed-ffi-exercise-negate-result")]] negate_result

    let record_sum_result: i32 = unsafe { hc_ffi_exercise_record_sum_impl(5, 6) }
    let record_sum_result_log: i32 = [[log(label: "observed-ffi-exercise-record-sum-result", expected: 11)]] record_sum_result

    let runtime_ok: bool =
        (add_result_log == 7) &&
        (negate_result_log == (0 - 8)) &&
        (record_sum_result_log == 11)
    let runtime_ok_log: bool = [[log(label: "ffi-multiple-extern-runtime", expected: true)]] runtime_ok

    if (runtime_ok_log != true) {
        [[log(label: "ffi-log-item_fail")]]
        return 1
    }
    [[log(label: "ffi-log-item_success")]]
    return 0
}

public procedure runFfiForeignContractExercise(ctx: Context) -> i32 {
    let _ = ctx
    [[log(label: "ffi-log-item_begin")]]

    let fc_001: string@View = [[log(label: "ffi-foreign-contract-feature-001", expected: "FC-001")]] "FC-001"
    let fc_002: string@View = [[log(label: "ffi-foreign-contract-feature-002", expected: "FC-002")]] "FC-002"
    let fc_003: string@View = [[log(label: "ffi-foreign-contract-feature-003", expected: "FC-003")]] "FC-003"

    let runtime_ok: bool =
        (fc_001 == "FC-001") &&
        (fc_002 == "FC-002") &&
        (fc_003 == "FC-003")
    let runtime_ok_log: bool = [[log(label: "ffi-foreign-contract-runtime", expected: true)]] runtime_ok

    if (runtime_ok_log != true) {
        [[log(label: "ffi-log-item_fail")]]
        return 1
    }
    [[log(label: "ffi-log-item_success")]]
    return 0
}

public procedure runFfiExternBlockShellExercise(ctx: Context) -> i32 {
    let _ = ctx
    [[log(label: "ffi-log-item_begin")]]

    let shell_result: i32 = unsafe { hc_ffi_extern_shell_probe_impl() }
    let shell_result_log: i32 =
        [[log(label: "observed-ffi-extern-block-shell-result", expected: 17)]]
        shell_result

    let runtime_ok: bool = shell_result_log == 17
    let runtime_ok_log: bool =
        [[log(label: "ffi-extern-block-shell-runtime", expected: true)]]
        runtime_ok

    if (runtime_ok_log != true) {
        [[log(label: "ffi-log-item_fail")]]
        return 1
    }

    [[log(label: "ffi-log-item_success")]]
    return 0
}

public procedure runFfiExternBlockWithoutAttributesExercise(ctx: Context) -> i32 {
    let _ = ctx
    [[log(label: "ffi-log-item_begin")]]

    let bare_result: i32 = unsafe { hc_ffi_extern_no_attrs_probe_impl() }
    let bare_result_log: i32 =
        [[log(label: "observed-ffi-extern-block-without-attributes-result", expected: 23)]]
        bare_result

    let runtime_ok: bool = bare_result_log == 23
    let runtime_ok_log: bool =
        [[log(label: "ffi-extern-block-without-attributes-runtime", expected: true)]]
        runtime_ok

    if (runtime_ok_log != true) {
        [[log(label: "ffi-log-item_fail")]]
        return 1
    }

    [[log(label: "ffi-log-item_success")]]
    return 0
}

public procedure runFfiSafeTypeExercise(ctx: Context) -> i32 {
    let _ = ctx
    [[log(label: "ffi-log-item_begin")]]

    let safe_record: FfiSafeRecord = FfiSafeRecord { x: 10, y: 20 }
    let safe_sum: i32 = safe_record.x + safe_record.y
    let safe_sum_log: i32 = [[log(label: "observed-ffi-safe-type-sum", expected: 30)]] safe_sum

    let ffi_safe_001: string@View = [[log(label: "ffi-safe-type-feature-001", expected: "FFISAFE-001")]] "FFISAFE-001"
    let ffi_safe_002: string@View = [[log(label: "ffi-safe-type-feature-002", expected: "FFISAFE-002")]] "FFISAFE-002"

    let runtime_ok: bool =
        (safe_sum_log == 30) &&
        (ffi_safe_001 == "FFISAFE-001") &&
        (ffi_safe_002 == "FFISAFE-002")
    let runtime_ok_log: bool = [[log(label: "ffi-safe-type-runtime", expected: true)]] runtime_ok

    if (runtime_ok_log != true) {
        [[log(label: "ffi-log-item_fail")]]
        return 1
    }
    [[log(label: "ffi-log-item_success")]]
    return 0
}
