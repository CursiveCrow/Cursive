[[mangle("hc_ffi_null_probe"), export("C")]]
public procedure ffiNullProbeImpl(flag: i32) -> *imm u8 {
    if (flag == 0) {
        let np: *imm u8 = null
        return np
    }
    let wide: usize = flag as usize
    let p: *imm u8 = unsafe { transmute<usize, *imm u8>(wide) }
    return p
}

extern "C" {
    procedure hc_ffi_null_probe(flag: i32) -> *imm u8
        |: @foreign_ensures(@null_result: @result == null)
}

public procedure runFfiForeignNullResultExercise(ctx: Context) -> i32 {
    let _ = ctx
    let null_ptr: *imm u8 = null
    let null_result: *imm u8 = unsafe { hc_ffi_null_probe(0) }
    let is_null: bool = null_result == null_ptr
    let is_null_log: bool = is_null

    let nonnull_result: *imm u8 = unsafe { hc_ffi_null_probe(1) }
    let is_nonnull: bool = nonnull_result != null_ptr
    let is_nonnull_log: bool = is_nonnull

    let all_ok: bool = is_null_log && is_nonnull_log
    let all_ok_log: bool = all_ok

    if (all_ok_log != true) {
        return 1
    }
    return 0
}

procedure runForeignNullResultExercises(ctx: Context) -> i32 {
    let status_null_result: i32 = runFfiForeignNullResultExercise(ctx)
    if (status_null_result != 0) {
        return status_null_result
    }
    return 0
}
