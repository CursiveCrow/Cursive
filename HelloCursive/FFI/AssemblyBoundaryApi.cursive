[[mangle("hc_ffi_boundary_probe_impl"), export("C")]]
public procedure FfiBoundaryProbeImpl(value: i32) -> i32 {
    return value + 1
}

extern "C" {
    procedure hc_ffi_boundary_probe_impl(value: i32) -> i32
}

public procedure FfiBoundaryMetric() -> i32 {
    let observed_value: i32 = unsafe { hc_ffi_boundary_probe_impl(4) }
    if (observed_value == 5) {
        return 1
    }
    return 0
}

public procedure run(ctx: Context) -> i32 {
    let boundary_metric: i32 = FfiBoundaryMetric()
    if (boundary_metric != 1) {
        return 1
    }

    let status_multiple_extern: i32 = RunFfiMultipleExternBlockExercise(ctx)
    if (status_multiple_extern != 0) {
        return status_multiple_extern
    }

    let status_foreign_contract: i32 = RunFfiForeignContractExercise(ctx)
    if (status_foreign_contract != 0) {
        return status_foreign_contract
    }

    let status_safe_type: i32 = RunFfiSafeTypeExercise(ctx)
    if (status_safe_type != 0) {
        return status_safe_type
    }

    let status_null_result: i32 = RunForeignNullResultExercises(ctx)
    if (status_null_result != 0) {
        return status_null_result
    }

    return 0
}
