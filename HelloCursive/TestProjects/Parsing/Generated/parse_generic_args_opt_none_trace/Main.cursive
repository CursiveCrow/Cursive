record ParseGenericArgsOptPlain {
    value: i32
}

record ParseGenericArgsOptBox<T> {
    value: T
}

type ParseGenericArgsOptPlainAlias = ParseGenericArgsOptPlain
type ParseGenericArgsOptTupleAlias = (ParseGenericArgsOptPlain, i32)
type ParseGenericArgsOptApplyAlias = ParseGenericArgsOptBox<ParseGenericArgsOptPlain>
type ParseGenericArgsOptNestedApplyAlias = ParseGenericArgsOptBox<ParseGenericArgsOptBox<ParseGenericArgsOptPlain>>

procedure parseGenericArgsOptAccept(value: ParseGenericArgsOptPlain) -> ParseGenericArgsOptPlain {
    return value
}

public procedure main(move ctx: Context) -> i32 {
    let _ = ctx
    return 0
}
