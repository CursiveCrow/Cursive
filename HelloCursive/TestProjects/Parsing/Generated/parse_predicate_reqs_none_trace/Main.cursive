import probe::predicateemptydep

class PredicateReqsPlainClass {
    procedure metric(~) -> i32
}

class PredicateReqsBoundClass<T>
|: Drop(T); FfiSafe(probe::predicateemptydep::ExternalBox<T>)
{
    procedure metric(~) -> i32
}

record PredicateReqsPlainRecord {
    value: i32
}

record PredicateReqsGenericRecord<T> {
    value: T
}

record PredicateReqsBoundRecord<T>
|: Bitcopy(T); Clone(T); Drop(T); FfiSafe(probe::predicateemptydep::ExternalBox<T>)
{
    value: T
}

enum PredicateReqsPlainEnum {
    Ready
    Done
}

enum PredicateReqsBoundEnum<T>
|: Clone(T); Drop(probe::predicateemptydep::ExternalBox<T>)
{
    Box(T)
}

modal PredicateReqsPlainModal {
    @Ready {
        value: i32
    }
}

modal PredicateReqsBoundModal<T>
|: Bitcopy(T); FfiSafe(T)
{
    @Ready {
        value: T
    }
}

type PredicateReqsPlainAlias = PredicateReqsPlainRecord
type PredicateReqsExternalAlias = probe::predicateemptydep::ExternalBox<i32>
type PredicateReqsBoundAlias<T>
|: Clone(T); FfiSafe(probe::predicateemptydep::ExternalBox<T>)
= probe::predicateemptydep::ExternalBox<T>

procedure predicateReqsPlainProcedure(value: PredicateReqsPlainAlias) -> PredicateReqsPlainAlias {
    return value
}

procedure predicateReqsBoundProcedure<T>(value: T) -> T
|: Bitcopy(T); Drop(probe::predicateemptydep::ExternalBox<T>)
{
    return value
}

public procedure main(move ctx: Context) -> i32 {
    let _ = ctx
    let plain: PredicateReqsPlainRecord = PredicateReqsPlainRecord { value: 7 }
    let roundtrip: PredicateReqsPlainAlias = predicateReqsPlainProcedure(plain)
    let _ = roundtrip
    return 0
}
