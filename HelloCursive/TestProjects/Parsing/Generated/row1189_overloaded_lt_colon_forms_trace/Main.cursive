record PlainRecord {
    value: i32
}

record OverloadedRecord <: FirstMarker, probe::forms::SecondMarker {
    value: i32
}

enum PlainEnum {
    Ready
}

enum OverloadedEnum <: EnumMarker {
    Ready
}

modal PlainModal {
    @Ready {
        value: i32
    }
}

modal OverloadedModal <: ModalMarker, probe::forms::AuxMarker {
    @Ready {
        value: i32
    }
}

class PlainClass {
}

class OverloadedClass <: FirstBase + probe::forms::SecondBase {
}

public procedure main(move ctx: Context) -> i32 {
    let _ = ctx
    return 0
}
