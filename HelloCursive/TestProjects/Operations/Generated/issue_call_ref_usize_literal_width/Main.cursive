procedure idUsize(value: usize) -> usize {
    return value
}

procedure idU64(value: u64) -> u64 {
    return value
}

procedure byteAt(position: usize) -> u8 {
    if position == 0 {
        return 123
    }
    return 125
}

procedure isSpaceByte(byte: u8) -> bool {
    return byte == 32 || byte == 9 || byte == 10 || byte == 13
}

procedure skipSpaceBytes(position: usize, length: usize) -> usize {
    var current: usize = position

    loop current < length {
        if isSpaceByte(byteAt(current)) {
            current = current + 1
        } else {
            return current
        }
    }

    return current
}

public procedure main(move ctx: Context) -> i32 {
    let _ = ctx

    if idUsize(1) != 1 {
        return 10
    }

    if idU64(1) != 1 {
        return 11
    }

    let length: usize = 2
    if length != 2 {
        return 20
    }

    if byteAt(0) != 123 {
        return 21
    }

    if byteAt(1) != 125 {
        return 22
    }

    let current = skipSpaceBytes(1, length)
    if current == 1 {
        return 0
    }
    if current == 2 {
        return 23
    }
    return 99
}
