procedure MaybeValue(flag: bool) -> i32 | bool {
    if (flag == true) {
        return 9
    }
    return false
}

procedure AsyncTryInfallible() -> Async<(), (), i32, !> {
    let value: i32 = MaybeValue(true)?
    return value
}

public procedure main(move ctx: Context) -> i32 {
    let _ = ctx
    let state: Async<(), (), i32, !> = AsyncTryInfallible()
    let _ = state
    return 0
}
