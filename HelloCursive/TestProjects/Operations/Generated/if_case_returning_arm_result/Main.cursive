public enum ProbeByte {
    Some(u8)
    None
}

procedure unwrapOrReturn(value: ProbeByte) -> u8 {
    let found: u8 = if value is {
        ProbeByte::Some(byte) {
            byte
        }
        ProbeByte::None {
            return 7
        }
    }
    return found
}

public procedure main(move ctx: Context) -> i32 {
    let _ = ctx

    let some_value: ProbeByte = ProbeByte::Some(13)
    let none_value: ProbeByte = ProbeByte::None

    if unwrapOrReturn(some_value) != 13 {
        return 1
    }
    if unwrapOrReturn(none_value) != 7 {
        return 2
    }
    return 0
}
