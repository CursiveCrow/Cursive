public procedure stale_probe(move ctx: Context) -> Async<i32, i32, i32, i32> {
    let _ = ctx
    var gate: shared [i32; 1] = [0]
    # gate write {
        let incoming: i32 = yield release 1
        gate[0] = incoming
    }
    return 0
}

public procedure main(move ctx: Context) -> i32 {
    let _ = ctx
    return 0
}
