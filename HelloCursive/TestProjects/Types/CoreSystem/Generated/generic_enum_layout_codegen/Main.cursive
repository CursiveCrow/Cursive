import probe::Data

public procedure main(move ctx: Context) -> i32 {
    let _ = ctx

    let ok_value: Data::ProbeResult<i32, string@View> = Data::ProbeResult::Ok(7)
    let err_value: Data::ProbeResult<i32, string@View> =
        Data::ProbeResult::Err("not an integer")
    let payload: Data::ProbePayload = Data::ProbePayload { count: 11, marker: 29 }
    let record_payload: Data::ProbePayload = Data::ProbePayload { count: 13, marker: 29 }
    let payload_value: Data::ProbeResult<Data::ProbePayload, string@View> =
        Data::ProbeResult::Ok(payload)
    let record_value: Data::ProbeRecordResult<Data::ProbePayload, string@View> =
        Data::ProbeRecordResult::Packed { payload: record_payload }
    let direct_payload_count: i32 = if payload_value is {
        Data::ProbeResult::Ok(direct_payload) {
            direct_payload.count
        }
        Data::ProbeResult::Err(_) {
            -1
        }
    }
    let direct_payload_marker: i32 = if record_value is {
        Data::ProbeRecordResult::Packed { payload: direct_record_payload } {
            direct_record_payload.marker
        }
        Data::ProbeRecordResult::Failed(_) {
            -1
        }
    }

    let ok_is_err: bool = Data::resultIsErr(ok_value)
    let ok_is_ok_by_wildcard: bool = Data::resultIsOkByWildcard(ok_value)
    let err_is_err: bool = Data::resultIsErr(err_value)
    let err_is_ok_by_wildcard: bool = Data::resultIsOkByWildcard(err_value)
    let payload_count: i32 = Data::resultPayloadCount(payload_value)
    let payload_marker: i32 = Data::recordResultPayloadMarker(record_value)

    if ok_is_err {
        return 2
    }
    if ok_is_ok_by_wildcard == false {
        return 8
    }
    if err_is_err == false {
        return 3
    }
    if err_is_ok_by_wildcard {
        return 9
    }
    if direct_payload_count != 11 {
        return 6
    }
    if direct_payload_marker != 29 {
        return 7
    }
    if payload_count != 11 {
        return 4
    }
    if payload_marker != 29 {
        return 5
    }
    return 0
}
