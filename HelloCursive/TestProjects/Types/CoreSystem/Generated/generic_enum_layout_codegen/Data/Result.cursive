public enum ProbeResult<T; E> {
    Ok(T)
    Err(E)
}

public enum ProbeRecordResult<T; E> {
    Packed { payload: T }
    Failed(E)
}

public record ProbePayload {
    count: i32
    marker: i32
}

public procedure resultIsOk<T; E>(value: ProbeResult<T, E>) -> bool {
    return if value is {
        ProbeResult::Ok(inner) {
            let _ = inner
            true
        }
        ProbeResult::Err(err_value) {
            let _ = err_value
            false
        }
    }
}

public procedure resultIsErr<T; E>(value: ProbeResult<T, E>) -> bool {
    return resultIsOk(value) == false
}

public procedure resultIsOkByWildcard<T; E>(value: ProbeResult<T, E>) -> bool {
    return if value is {
        ProbeResult::Ok(_) {
            true
        }
        ProbeResult::Err(_) {
            false
        }
    }
}

public procedure resultPayloadCount<E>(value: ProbeResult<ProbePayload, E>) -> i32 {
    return if value is {
        ProbeResult::Ok(payload) {
            payload.count
        }
        ProbeResult::Err(_) {
            -1
        }
    }
}

public procedure recordResultPayloadMarker<E>(
    value: ProbeRecordResult<ProbePayload, E>
) -> i32 {
    return if value is {
        ProbeRecordResult::Packed { payload: packed_payload } {
            packed_payload.marker
        }
        ProbeRecordResult::Failed(_) {
            -1
        }
    }
}
