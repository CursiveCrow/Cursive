import probe::Data

procedure makeSome() -> Data::ProbeOption<i32> {
    return Data::ProbeOption::Some(17)
}

procedure readOption(value: Data::ProbeOption<i32>) -> i32 {
    return if value is {
        Data::ProbeOption::Some(inner) { inner }
        Data::ProbeOption::None { 0 }
    }
}

public procedure main(move ctx: Context) -> i32 {
    let _ = ctx

    let some_value: Data::ProbeOption<i32> = Data::ProbeOption::Some(17)
    let none_value: Data::ProbeOption<i32> = Data::ProbeOption::None

    let first: i32 = readOption(some_value)
    let second: i32 = readOption(none_value)
    let third: i32 = readOption(makeSome())

    if ((first == 17) && (second == 0) && (third == 17)) {
        return 0
    }
    return 1
}
