class RequiresModalGeneralMethod {
    procedure required(~) -> i32
}

modal StateMethodOnlyModal <: RequiresModalGeneralMethod {
    @Ready {
        value: i32

        procedure required(~) -> i32 {
            return self.value
        }
    }
}

public procedure main(move ctx: Context) -> i32 {
    let _ = ctx
    return 0
}
