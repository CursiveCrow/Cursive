public record MethodBoxI32 {
    public value: i32
    public mirror: i32

    public procedure value_metric(~) -> i32 {
        return self.value
    }

    public procedure mirror_metric(~) -> i32 {
        return self.mirror
    }

    public procedure alias_metric(~) -> i32 {
        return self.value
    }
}

public type NamedMethodBoxI32 = MethodBoxI32
