using probe::methoddep::{MethodBox, PlainMethodProbe}

procedure read_tag(box: MethodBox<i32>, delta: i32) -> i32 {
    return box~>tag_metric(delta)
}

procedure read_seed(box: MethodBox<i32>) -> i32 {
    return box~>tag_seed()
}

procedure read_plain(probe: PlainMethodProbe) -> i32 {
    return probe~>read()
}

public procedure main(move ctx: Context) -> i32 {
    let _ = ctx
    return 0
}
