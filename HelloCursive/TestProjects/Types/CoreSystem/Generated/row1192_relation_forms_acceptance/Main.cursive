public class RootMarker {
}

public class ChildMarker <: RootMarker {
}

public record RecordThroughChild <: ChildMarker {
    value: i32
}

public enum EnumDirect <: RootMarker {
    Ready
}

public modal ModalThroughChild <: ChildMarker {
    @Ready {
    }
}

procedure RequireRoot<T <: RootMarker>() -> i32 {
    return 1
}

procedure RequireChild<T <: ChildMarker>() -> i32 {
    return 1
}

public procedure main(move ctx: Context) -> i32 {
    let _ = ctx

    let total: i32 =
        RequireRoot<RecordThroughChild>() +
        RequireChild<RecordThroughChild>() +
        RequireRoot<EnumDirect>() +
        RequireRoot<ModalThroughChild>() +
        RequireChild<ModalThroughChild>()

    return if total == 5 {
        0
    } else {
        1
    }
}
