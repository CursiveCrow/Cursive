[[dynamic]]
public procedure main(move ctx: Context) -> i32 {
    let _ = ctx
    var dynamic_slots: shared [i32; 3] = [1, 2, 3]
    let dynamic_index: usize = 1usize
    let metric: i32 = parallel ctx~>cpu() {
        dispatch _ in 0usize..3usize key dynamic_slots[dynamic_index] read [reduce: +] {
            dynamic_slots[dynamic_index]
        }
    }
    return metric
}
