record WarningInner {
    value: i32
}

record WarningOuter {
    #inner: WarningInner
}

public procedure main(move ctx: Context) -> i32 {
    let _ = ctx
    var outer: shared WarningOuter =
        WarningOuter { inner: WarningInner { value: 3 } }
    var observed: i32 = 0
    # outer.#inner read {
        observed = outer.inner.value
    }
    return observed
}
