import hostedshareddep

record HostedRuntimeContext {
    fs: $FileSystem
    inline: $ExecutionDomain
}

var library_counter: i32 = 0

procedure ResetHostedSharedState() -> () {
    library_counter = 0
    hostedshareddep::reset()
}

procedure BuildHostedRuntimeContext(ctx: Context) -> HostedRuntimeContext {
    return HostedRuntimeContext {
        fs: ctx.fs,
        inline: ctx~>inline()
    }
}

procedure HostedContextMetric(ctx: HostedRuntimeContext) -> i32 {
    let write_stdout_ok: bool = if ctx.fs~>write_stdout("") is {
        _: () { true }
        _: IoError { false }
    }

    let inline_domain: $ExecutionDomain = ctx.inline
    let inline_metric: i32 = parallel inline_domain {
        spawn { 21 }
    }

    if (write_stdout_ok && (inline_metric == 21)) {
        return 21
    }
    return 0
}

procedure HostedSessionNextValue() -> i32 {
    library_counter = library_counter + 1
    let dep_value: i32 = hostedshareddep::next_value()
    return library_counter * 100 + dep_value
}

[[layout(C)]]
record HostedAggregateResult {
    first: i32
    second: i32
    third: i32
}

[[layout(C), ffi_pass_by_value]]
record HostedReadBodyCmd {
    world: u64
    body: u64
}

[[layout(C)]]
record HostedBodyState {
    status: u32
    handle: u64
    motion: u32
}

procedure BuildHostedAggregateResult() -> HostedAggregateResult {
    return HostedAggregateResult { first: 11, second: 22, third: 33 }
}

public procedure ordinary_followup_value() -> i32 {
    return HostedSessionNextValue()
}

public procedure run(ctx: Context) -> i32 {
    ResetHostedSharedState()

    let hosted_ctx: HostedRuntimeContext = BuildHostedRuntimeContext(ctx)
    let context_metric: i32 = HostedContextMetric(hosted_ctx)
    let session_metric_first: i32 = HostedSessionNextValue()
    let session_metric_second: i32 = HostedSessionNextValue()

    let context_metric_log: i32 =
        context_metric
    let session_metric_first_log: i32 =
        session_metric_first
    let session_metric_second_log: i32 =
        session_metric_second

    if ((context_metric_log != 21) ||
        (session_metric_first_log != 101) ||
        (session_metric_second_log != 202)) {
        return 1
    }

    return 0
}

[[host_export("C-unwind"), unwind("catch"), mangle("hc_hosted_context_metric")]]
public procedure host_context_metric(ctx: HostedRuntimeContext) -> i32 {
    return HostedContextMetric(ctx)
}

[[host_export("C-unwind"), unwind("catch"), mangle("hc_hosted_session_next")]]
public procedure host_session_next(ctx: HostedRuntimeContext) -> i32 {
    let _ = ctx
    return HostedSessionNextValue()
}

[[host_export("C-unwind"), unwind("catch"), mangle("hc_hosted_fail_zero")]]
public procedure host_fail_zero(ctx: HostedRuntimeContext) -> i32 {
    let _ = ctx
    let ptr_null: *imm i32 = null
    return unsafe { *ptr_null }
}

[[host_export("C-unwind"), unwind("catch"), mangle("hc_hosted_aggregate_result")]]
public procedure host_aggregate_result(ctx: HostedRuntimeContext) -> HostedAggregateResult {
    let _ = ctx
    return BuildHostedAggregateResult()
}

[[host_export("C-unwind"), unwind("catch"), mangle("hc_hosted_aggregate_fail_zero")]]
public procedure host_aggregate_fail_zero(ctx: HostedRuntimeContext) -> HostedAggregateResult {
    let _ = ctx
    let ptr_null: *imm i32 = null
    let ignored_value: i32 = unsafe { *ptr_null }
    let _ = ignored_value
    return BuildHostedAggregateResult()
}

[[host_export("C-unwind"), unwind("catch"), mangle("hc_hosted_read_body_state")]]
public procedure host_read_body_state(ctx: HostedRuntimeContext,
                                      move read_cmd: HostedReadBodyCmd,
                                      move out_state: *mut HostedBodyState) -> u32 {
    let _ = ctx
    var out_state_mut: *mut HostedBodyState = out_state
    let state: HostedBodyState = HostedBodyState {
        status: 0u32,
        handle: read_cmd.body,
        motion: 2u32
    }
    unsafe {
        *out_state_mut = move state
    }
    if (read_cmd.world == 0u64) {
        return 9u32
    }
    return 0u32
}
