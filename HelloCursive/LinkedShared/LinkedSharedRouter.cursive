import linkedshareddep

procedure BuildLinkedSharedCounter() -> i32 {
    return 10
}

var library_counter: i32 = BuildLinkedSharedCounter()

procedure NextLinkedSharedCounter() -> i32 {
    library_counter = library_counter + 1
    return library_counter
}

public procedure run(ctx: Context) -> i32 {
    let _ = ctx
    let contribution_value: i32 = linkedshareddep::contribution()
    let first_counter_value: i32 = NextLinkedSharedCounter()
    let second_counter_value: i32 = NextLinkedSharedCounter()
    let contribution_ok: bool = contribution_value == 17
    let first_counter_ok: bool = first_counter_value == 11
    let second_counter_ok: bool = second_counter_value == 12
    let contribution_ok_log: bool =
        [[log(label: "observed-linkedshared-contribution", expected: true)]]
        contribution_ok
    let first_counter_ok_log: bool =
        [[log(label: "observed-linkedshared-counter-first", expected: true)]]
        first_counter_ok
    let second_counter_ok_log: bool =
        [[log(label: "observed-linkedshared-counter-second", expected: true)]]
        second_counter_ok

    if ((contribution_ok_log == false) ||
        (first_counter_ok_log == false) ||
        (second_counter_ok_log == false)) {
        return 1
    }

    return 0
}
