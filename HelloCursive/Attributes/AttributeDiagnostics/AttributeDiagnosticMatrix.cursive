procedure AttributeDiagnosticMatrixMetricLabel(value: i32) -> string@View {
    if (value == 90) {
        return "90"
    }
    return "other"
}

public procedure RunAttributeDiagnosticMatrix(ctx: Context) -> i32 {
    let _ = ctx
    "running"

    let e2450: string@View = "E-MOD-2450"
    let e2451: string@View = "E-MOD-2451"
    let e2452: string@View = "E-MOD-2452"
    let e2453: string@View = "E-MOD-2453"
    let e2454: string@View = "E-MOD-2454"
    let e2455: string@View = "E-MOD-2455"

    let e0410: string@View = "E-CON-0410"
    let e0411: string@View = "E-CON-0411"
    let e0412: string@View = "E-CON-0412"
    let e0096: string@View = "E-CON-0096"

    let runtime_ok: bool =
        (e2450 == "E-MOD-2450") && (e2451 == "E-MOD-2451") && (e2452 == "E-MOD-2452") &&
        (e2453 == "E-MOD-2453") && (e2454 == "E-MOD-2454") && (e2455 == "E-MOD-2455") &&
        (e0410 == "E-CON-0410") && (e0411 == "E-CON-0411") && (e0412 == "E-CON-0412") &&
        (e0096 == "E-CON-0096")
    let runtime_ok_log: bool = runtime_ok

    let metric: i32 = if (runtime_ok_log == true) { 90 } else { 0 }
    let metric_label: string@View = AttributeDiagnosticMatrixMetricLabel(metric)
    let metric_log_actual: string@View = metric_label
    if (metric_log_actual != "90") {
        "fail"
        return 1
    }

    "success"
    return 0
}

