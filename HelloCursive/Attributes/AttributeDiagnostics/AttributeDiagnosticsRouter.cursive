public procedure RunGroup(ctx: Context) -> i32 {
    [[log(label: "attributes-log-section_start", expected: "section-start")]] "section-start"

    let status_attr_diag: i32 = RunAttributeDiagnosticMatrix(ctx)
    if (status_attr_diag != 0) {
        [[log(label: "attributes-log-section_end", expected: "section-end")]] "section-end"
        return status_attr_diag
    }

    let status_ffi_diag: i32 = RunFfiAttributeDiagnosticMatrix(ctx)
    if (status_ffi_diag != 0) {
        [[log(label: "attributes-log-section_end", expected: "section-end")]] "section-end"
        return status_ffi_diag
    }

    let status_warn_diag: i32 = RunAttributeWarningMatrix(ctx)
    if (status_warn_diag != 0) {
        [[log(label: "attributes-log-section_end", expected: "section-end")]] "section-end"
        return status_warn_diag
    }

    [[log(label: "attributes-log-section_end", expected: "section-end")]] "section-end"
    return 0
}

