procedure AttributeWarningMatrixMetricLabel(value: i32) -> string@View {
    if (value == 92) {
        return "92"
    }
    return "other"
}

public procedure RunAttributeWarningMatrix(ctx: Context) -> i32 {
    let _ = ctx
    "running"

    let w0601: string@View = "W-CNF-0601"
    let w2451: string@View = "W-MOD-2451"
    let w2452: string@View = "W-MOD-2452"
    let w0401: string@View = "W-CON-0401"
    let w3350: string@View = "W-SYS-3350"
    let w3355: string@View = "W-SYS-3355"

    let runtime_ok: bool =
        (w0601 == "W-CNF-0601") &&
        (w2451 == "W-MOD-2451") &&
        (w2452 == "W-MOD-2452") &&
        (w0401 == "W-CON-0401") &&
        (w3350 == "W-SYS-3350") &&
        (w3355 == "W-SYS-3355")
    let runtime_ok_log: bool = runtime_ok

    let metric: i32 = if (runtime_ok_log == true) { 92 } else { 0 }
    let metric_label: string@View = AttributeWarningMatrixMetricLabel(metric)
    let metric_log_actual: string@View = metric_label
    if (metric_log_actual != "92") {
        "fail"
        return 1
    }

    "success"
    return 0
}

