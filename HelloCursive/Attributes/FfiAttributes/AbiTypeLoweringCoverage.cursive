procedure AbiTypeLoweringCoverageMetricLabel(value: i32) -> string@View {
    if (value == 1622) {
        return "1622"
    }
    return "other"
}

public procedure RunAbiTypeLoweringCoverage(ctx: Context) -> i32 {
    let _ = ctx
    "running"

    let abi_prim: string@View =
        "ABI-Prim"
    let abi_perm: string@View =
        "ABI-Perm"
    let abi_ptr: string@View =
        "ABI-Ptr"
    let abi_raw_ptr: string@View =
        "ABI-RawPtr"
    let abi_func: string@View =
        "ABI-Func"
    let abi_alias: string@View =
        "ABI-Alias"
    let abi_record: string@View =
        "ABI-Record"
    let abi_tuple: string@View =
        "ABI-Tuple"
    let abi_array: string@View =
        "ABI-Array"
    let abi_slice: string@View =
        "ABI-Slice"
    let abi_range: string@View =
        "ABI-Range"
    let abi_enum: string@View =
        "ABI-Enum"
    let abi_union: string@View =
        "ABI-Union"
    let abi_modal: string@View =
        "ABI-Modal"
    let abi_dynamic: string@View =
        "ABI-Dynamic"
    let abi_string_bytes: string@View =
        "ABI-StringBytes"

    let runtime_ok: bool =
        (abi_prim == "ABI-Prim") &&
        (abi_perm == "ABI-Perm") &&
        (abi_ptr == "ABI-Ptr") &&
        (abi_raw_ptr == "ABI-RawPtr") &&
        (abi_func == "ABI-Func") &&
        (abi_alias == "ABI-Alias") &&
        (abi_record == "ABI-Record") &&
        (abi_tuple == "ABI-Tuple") &&
        (abi_array == "ABI-Array") &&
        (abi_slice == "ABI-Slice") &&
        (abi_range == "ABI-Range") &&
        (abi_enum == "ABI-Enum") &&
        (abi_union == "ABI-Union") &&
        (abi_modal == "ABI-Modal") &&
        (abi_dynamic == "ABI-Dynamic") &&
        (abi_string_bytes == "ABI-StringBytes")
    let runtime_ok_log: bool =
        runtime_ok

    let metric: i32 = if (runtime_ok_log == true) { 1622 } else { 0 }
    let metric_label: string@View = AbiTypeLoweringCoverageMetricLabel(metric)
    let metric_log_actual: string@View =
        metric_label
    if (metric_log_actual != "1622") {
        "fail"
        return 1
    }

    "success"
    return 0
}
