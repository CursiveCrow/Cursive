[[dynamic]]
procedure AttributeDynamicScopeProbe(value: i32) -> i32
    |: => @result == @entry(value) + 1
{
    return value + 1
}

[[dynamic]]
procedure AttributeDynamicExpressionScopeProbe(value: i32) -> i32
    |: => @result == @entry(value) + 2
{
    return value + 2
}

procedure AttributeDynamicScopeCaller(value: i32) -> i32 {
    return AttributeDynamicScopeProbe(value)
}

procedure DynamicScopeLexicalRulesMetricLabel(value: i32) -> string@View {
    if (value == 19) {
        return "19"
    }
    return "other"
}

public procedure RunDynamicScopeLexicalRules(ctx: Context) -> i32 {
    let _ = ctx
    "running"

    let direct_value: i32 = AttributeDynamicScopeProbe(5)
    let lexical_value: i32 = AttributeDynamicExpressionScopeProbe(5)
    let caller_value: i32 = AttributeDynamicScopeCaller(5)

    let direct_value_log: i32 = direct_value
    let lexical_value_log: i32 = lexical_value
    let caller_value_log: i32 = caller_value

    let atr_028: string@View = "ATR-028"
    let atr_029: string@View = "ATR-029"

    let runtime_ok: bool =
        (direct_value_log == 6) &&
        (lexical_value_log == 7) &&
        (caller_value_log == 6) &&
        (atr_028 == "ATR-028") &&
        (atr_029 == "ATR-029")
    let runtime_ok_log: bool = runtime_ok

    let metric: i32 = if (runtime_ok_log == true) { 19 } else { 0 }
    let metric_label: string@View = DynamicScopeLexicalRulesMetricLabel(metric)
    let metric_log_actual: string@View = metric_label
    if (metric_log_actual != "19") {
        "fail"
        return 1
    }

    "success"
    return 0
}

