public procedure RunGroup(ctx: Context) -> i32 {
    [[log(label: "attributes-log-section_start", expected: "section-start")]] "section-start"

    let status_deprecated: i32 = RunDeprecatedWarningsAndMessages(ctx)
    if (status_deprecated != 0) {
        [[log(label: "attributes-log-section_end", expected: "section-end")]] "section-end"
        return status_deprecated
    }

    let status_dynamic_scope: i32 = RunDynamicScopeLexicalRules(ctx)
    if (status_dynamic_scope != 0) {
        [[log(label: "attributes-log-section_end", expected: "section-end")]] "section-end"
        return status_dynamic_scope
    }

    let status_dynamic_override: i32 = RunDynamicOverrideAndCallBoundary(ctx)
    if (status_dynamic_override != 0) {
        [[log(label: "attributes-log-section_end", expected: "section-end")]] "section-end"
        return status_dynamic_override
    }

    let status_dynamic_restrict: i32 = RunDynamicRestrictionDiagnostics(ctx)
    if (status_dynamic_restrict != 0) {
        [[log(label: "attributes-log-section_end", expected: "section-end")]] "section-end"
        return status_dynamic_restrict
    }

    let status_static_dispatch: i32 = RunStaticDispatchOnlyDynamicInterop(ctx)
    if (status_static_dispatch != 0) {
        [[log(label: "attributes-log-section_end", expected: "section-end")]] "section-end"
        return status_static_dispatch
    }

    let status_stale_ok: i32 = RunStaleOkSuppressionSemantics(ctx)
    if (status_stale_ok != 0) {
        [[log(label: "attributes-log-section_end", expected: "section-end")]] "section-end"
        return status_stale_ok
    }

    [[log(label: "attributes-log-section_end", expected: "section-end")]] "section-end"
    return 0
}

