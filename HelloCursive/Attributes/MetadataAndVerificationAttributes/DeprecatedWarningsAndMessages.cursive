procedure AttributeDeprecatedProbe(value: i32) -> i32 {
    return value + 1
}

procedure DeprecatedWarningsAndMessagesMetricLabel(value: i32) -> string@View {
    if (value == 8) {
        return "8"
    }
    return "other"
}

public procedure RunDeprecatedWarningsAndMessages(ctx: Context) -> i32 {
    let _ = ctx
    "running"

    let deprecated_value: i32 = AttributeDeprecatedProbe(7)
    let deprecated_value_log: i32 = deprecated_value

    let warning_code: string@View = "W-CNF-0601"
    let atr_027: string@View = "ATR-027"

    let runtime_ok: bool =
        (deprecated_value_log == 8) &&
        (warning_code == "W-CNF-0601") &&
        (atr_027 == "ATR-027")
    let runtime_ok_log: bool = runtime_ok

    let metric: i32 = if (runtime_ok_log == true) { 8 } else { 0 }
    let metric_label: string@View = DeprecatedWarningsAndMessagesMetricLabel(metric)
    let metric_log_actual: string@View = metric_label
    if (metric_log_actual != "8") {
        "fail"
        return 1
    }

    "success"
    return 0
}
