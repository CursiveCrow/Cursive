procedure DynamicRestrictionDiagnosticsMetricLabel(value: i32) -> string@View {
    if (value == 40) {
        return "40"
    }
    return "other"
}

[[dynamic]]
procedure AttributeDynamicRestrictionRuntimeProbe(value: i32) -> i32
    |: => @result == @entry(value) + 1
{
    return value + 1
}

public procedure RunDynamicRestrictionDiagnostics(ctx: Context) -> i32 {
    let _ = ctx
    [[log(label: "attributes-log-item_begin", expected: "running")]] "running"

    let runtime_probe_value: i32 = AttributeDynamicRestrictionRuntimeProbe(7)
    let runtime_probe_log: i32 = [[log(label: "observed-attributes-dynamic-runtime-probe", expected: 8)]] runtime_probe_value

    let e0410: string@View = [[log(label: "attributes-dynamic-diagnostic-0410", expected: "E-CON-0410")]] "E-CON-0410"
    let e0411: string@View = [[log(label: "attributes-dynamic-diagnostic-0411", expected: "E-CON-0411")]] "E-CON-0411"
    let e0412: string@View = [[log(label: "attributes-dynamic-diagnostic-0412", expected: "E-CON-0412")]] "E-CON-0412"
    let w0401: string@View = [[log(label: "attributes-dynamic-warning-0401", expected: "W-CON-0401")]] "W-CON-0401"
    let i0011: string@View = [[log(label: "attributes-dynamic-info-0011", expected: "I-CON-0011")]] "I-CON-0011"
    let i0013: string@View = [[log(label: "attributes-dynamic-info-0013", expected: "I-CON-0013")]] "I-CON-0013"

    let atr_032: string@View = [[log(label: "attributes-dynamic-feature-032", expected: "ATR-032")]] "ATR-032"
    let atr_033: string@View = [[log(label: "attributes-dynamic-feature-033", expected: "ATR-033")]] "ATR-033"
    let atr_034: string@View = [[log(label: "attributes-dynamic-feature-034", expected: "ATR-034")]] "ATR-034"

    let runtime_ok: bool =
        (runtime_probe_log == 8) &&
        (e0410 == "E-CON-0410") &&
        (e0411 == "E-CON-0411") &&
        (e0412 == "E-CON-0412") &&
        (w0401 == "W-CON-0401") &&
        (i0011 == "I-CON-0011") &&
        (i0013 == "I-CON-0013") &&
        (atr_032 == "ATR-032") &&
        (atr_033 == "ATR-033") &&
        (atr_034 == "ATR-034")
    let runtime_ok_log: bool = [[log(label: "attributes-dynamic-restriction-diagnostics-runtime", expected: true)]] runtime_ok

    let metric: i32 = if (runtime_ok_log == true) { 40 } else { 0 }
    let metric_label: string@View = DynamicRestrictionDiagnosticsMetricLabel(metric)
    let metric_log_actual: string@View = [[log(label: "observed-attributes-dynamic-restriction-diagnostics-metric", expected: "40")]] metric_label
    if (metric_log_actual != "40") {
        [[log(label: "attributes-log-item_fail", expected: "fail")]] "fail"
        return 1
    }

    [[log(label: "attributes-log-item_success", expected: "success")]] "success"
    return 0
}

