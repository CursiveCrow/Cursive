public procedure runGroup(ctx: Context) -> i32 {
    [[log(label: "attributes-log-section_start", expected: "section-start")]] "section-start"

    let status_inline: i32 = RunInlineModesAndWarnings(ctx)
    if (status_inline != 0) {
        [[log(label: "attributes-log-section_end", expected: "section-end")]] "section-end"
        return status_inline
    }

    let status_cold: i32 = RunColdHintAcceptance(ctx)
    if (status_cold != 0) {
        [[log(label: "attributes-log-section_end", expected: "section-end")]] "section-end"
        return status_cold
    }

    let status_hint_default: i32 = RunInlineHintAndDefaultModes(ctx)
    if (status_hint_default != 0) {
        [[log(label: "attributes-log-section_end", expected: "section-end")]] "section-end"
        return status_hint_default
    }

    [[log(label: "attributes-log-section_end", expected: "section-end")]] "section-end"
    return 0
}

