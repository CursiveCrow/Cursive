procedure MemoryOrderSpeculativeRejectionMetricLabel(value: i32) -> string@View {
    if (value == 52) {
        return "52"
    }
    return "other"
}

public procedure RunMemoryOrderSpeculativeRejection(ctx: Context) -> i32 {
    let _ = ctx
    [[log(label: "attributes-log-item_begin", expected: "running")]] "running"

    let e0096: string@View = [[log(label: "attributes-memory-order-diagnostic-0096", expected: "E-CON-0096")]] "E-CON-0096"
    let atr_052: string@View = [[log(label: "attributes-memory-order-feature-052", expected: "ATR-052")]] "ATR-052"

    let runtime_ok: bool = (e0096 == "E-CON-0096") && (atr_052 == "ATR-052")
    let runtime_ok_log: bool = [[log(label: "attributes-memory-order-speculative-rejection-runtime", expected: true)]] runtime_ok

    let metric: i32 = if (runtime_ok_log == true) { 52 } else { 0 }
    let metric_label: string@View = MemoryOrderSpeculativeRejectionMetricLabel(metric)
    let metric_log_actual: string@View = [[log(label: "observed-attributes-memory-order-speculative-rejection-metric", expected: "52")]] metric_label
    if (metric_log_actual != "52") {
        [[log(label: "attributes-log-item_fail", expected: "fail")]] "fail"
        return 1
    }

    [[log(label: "attributes-log-item_success", expected: "success")]] "success"
    return 0
}

