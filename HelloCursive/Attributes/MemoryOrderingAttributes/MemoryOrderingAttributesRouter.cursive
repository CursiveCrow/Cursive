public procedure runGroup(ctx: Context) -> i32 {
    "section-start"

    let status_placement: i32 = RunMemoryOrderAttributePlacement(ctx)
    if (status_placement != 0) {
        "section-end"
        return status_placement
    }

    let status_speculative: i32 = RunMemoryOrderSpeculativeRejection(ctx)
    if (status_speculative != 0) {
        "section-end"
        return status_speculative
    }

    let status_fence: i32 = RunMemoryOrderAndFenceOrderingSemantics(ctx)
    if (status_fence != 0) {
        "section-end"
        return status_fence
    }

    "section-end"
    return 0
}

