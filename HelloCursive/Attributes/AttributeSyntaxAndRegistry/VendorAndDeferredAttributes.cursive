procedure VendorAndDeferredAttributesMetricLabel(value: i32) -> string@View {
    if (value == 9) {
        return "9"
    }
    return "other"
}

public procedure RunVendorAndDeferredAttributes(ctx: Context) -> i32 {
    let _ = ctx
    "running"

    let vendor_empty: string@View = "R_vendor=empty"
    let reflect_unsupported: string@View = "reflect-unsupported"
    let derive_unsupported: string@View = "derive-unsupported"
    let emit_unsupported: string@View = "emit-unsupported"
    let files_unsupported: string@View = "files-unsupported"

    let atr_008: string@View = "ATR-008"
    let atr_009: string@View = "ATR-009"

    let runtime_ok: bool =
        (vendor_empty == "R_vendor=empty") &&
        (reflect_unsupported == "reflect-unsupported") &&
        (derive_unsupported == "derive-unsupported") &&
        (emit_unsupported == "emit-unsupported") &&
        (files_unsupported == "files-unsupported") &&
        (atr_008 == "ATR-008") &&
        (atr_009 == "ATR-009")
    let runtime_ok_log: bool = runtime_ok

    let metric: i32 = if (runtime_ok_log == true) { 9 } else { 0 }
    let metric_label: string@View = VendorAndDeferredAttributesMetricLabel(metric)
    let metric_log_actual: string@View =
        metric_label
    if (metric_log_actual != "9") {
        "fail"
        return 1
    }

    "success"
    return 0
}

