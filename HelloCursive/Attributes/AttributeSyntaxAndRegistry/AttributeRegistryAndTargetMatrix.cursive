procedure AttributeRegistryAndTargetMatrixMetricLabel(value: i32) -> string@View {
    if (value == 22) {
        return "22"
    }
    return "other"
}

public procedure RunAttributeRegistryAndTargetMatrix(ctx: Context) -> i32 {
    let _ = ctx
    "running"

    let registry_count: i32 = 22

    let a01: string@View = "layout"
    let a02: string@View = "inline"
    let a03: string@View = "cold"
    let a04: string@View = "deprecated"
    let a05: string@View = "dynamic"
    let a06: string@View = "stale_ok"
    let a07: string@View = "relaxed"
    let a08: string@View = "acquire"
    let a09: string@View = "release"
    let a10: string@View = "acqrel"
    let a11: string@View = "seqcst"
    let a12: string@View = "static"
    let a13: string@View = "mangle"
    let a14: string@View = "library"
    let a15: string@View = "unwind"
    let a16: string@View = "reflect"
    let a17: string@View = "derive"
    let a18: string@View = "emit"
    let a19: string@View = "files"
    let a20: string@View = "export"
    let a21: string@View = "host_export"
    let a22: string@View = "ffi_pass_by_value"
    let atr_003: string@View = "ATR-003"
    let atr_004: string@View = "ATR-004"
    let atr_005: string@View = "ATR-005"
    let atr_006: string@View = "ATR-006"

    let runtime_ok: bool =
        (registry_count == 22) &&
        (a01 == "layout") && (a02 == "inline") && (a03 == "cold") && (a04 == "deprecated") &&
        (a05 == "dynamic") && (a06 == "stale_ok") && (a07 == "relaxed") &&
        (a08 == "acquire") && (a09 == "release") && (a10 == "acqrel") && (a11 == "seqcst") &&
        (a12 == "static") && (a13 == "mangle") && (a14 == "library") &&
        (a15 == "unwind") && (a16 == "reflect") && (a17 == "derive") && (a18 == "emit") &&
        (a19 == "files") && (a20 == "export") && (a21 == "host_export") && (a22 == "ffi_pass_by_value") &&
        (atr_003 == "ATR-003") && (atr_004 == "ATR-004") && (atr_005 == "ATR-005") && (atr_006 == "ATR-006")
    let runtime_ok_log: bool = runtime_ok

    let metric: i32 = if (runtime_ok_log == true) { 22 } else { 0 }
    let metric_label: string@View = AttributeRegistryAndTargetMatrixMetricLabel(metric)
    let metric_log_actual: string@View =
        metric_label
    if (metric_log_actual != "22") {
        "fail"
        return 1
    }

    "success"
    return 0
}

