[[layout(i32)]]
enum AttributeDiscriminantEnum {
    First = 3
    Second
    Third = 9
}

procedure LayoutDiscriminantAndApplicabilityMetricLabel(value: i32) -> string@View {
    if (value == 16) {
        return "16"
    }
    return "other"
}

public procedure RunLayoutDiscriminantAndApplicability(ctx: Context) -> i32 {
    let _ = ctx
    "running"

    let first: AttributeDiscriminantEnum = AttributeDiscriminantEnum::First
    let second: AttributeDiscriminantEnum = AttributeDiscriminantEnum::Second
    let third: AttributeDiscriminantEnum = AttributeDiscriminantEnum::Third

    let discrim_metric: i32 =
        (if first is { AttributeDiscriminantEnum::First { 3 }AttributeDiscriminantEnum::Second { 0 }AttributeDiscriminantEnum::Third { 0 } }) +
        (if second is { AttributeDiscriminantEnum::First { 0 }AttributeDiscriminantEnum::Second { 4 }AttributeDiscriminantEnum::Third { 0 } }) +
        (if third is { AttributeDiscriminantEnum::First { 0 }AttributeDiscriminantEnum::Second { 0 }AttributeDiscriminantEnum::Third { 9 } })

    let discrim_metric_log: i32 = discrim_metric

    let atr_014: string@View = "ATR-014"
    let atr_018: string@View = "ATR-018"

    let runtime_ok: bool =
        (discrim_metric_log == 16) &&
        (atr_014 == "ATR-014") &&
        (atr_018 == "ATR-018")
    let runtime_ok_log: bool = runtime_ok

    let metric: i32 = if (runtime_ok_log == true) { 16 } else { 0 }
    let metric_label: string@View = LayoutDiscriminantAndApplicabilityMetricLabel(metric)
    let metric_log_actual: string@View = metric_label
    if (metric_log_actual != "16") {
        "fail"
        return 1
    }

    "success"
    return 0
}

