procedure LogRuntimeExprBindingStmtSemanticsMetricLabel(value: i32) -> string@View {
    if (value == 48) {
        return "48"
    }
    return "other"
}

public procedure RunLogRuntimeExprBindingStmtSemantics(ctx: Context) -> i32 {
    let _ = ctx
    [[log(label: "attributes-log-item_begin", expected: "running")]] "running"

    let base: i32 = 20
    let expression_logged: i32 = [[log(label: "attributes-log-runtime-expression", expected: 21)]] base + 1
    let binding_logged: i32 = [[log(label: "attributes-log-runtime-binding", expected: 22)]] expression_logged + 1
    [[log(label: "attributes-log-runtime-statement")]]
    let statement_logged: bool = true

    let atr_046: string@View = [[log(label: "attributes-log-feature-046", expected: "ATR-046")]] "ATR-046"
    let atr_048: string@View = [[log(label: "attributes-log-feature-048", expected: "ATR-048")]] "ATR-048"

    let runtime_ok: bool =
        (expression_logged == 21) &&
        (binding_logged == 22) &&
        (statement_logged == true) &&
        (atr_046 == "ATR-046") &&
        (atr_048 == "ATR-048")
    let runtime_ok_log: bool = [[log(label: "attributes-log-runtime-expr-binding-stmt-runtime", expected: true)]] runtime_ok

    let metric: i32 = if (runtime_ok_log == true) { 48 } else { 0 }
    let metric_label: string@View = LogRuntimeExprBindingStmtSemanticsMetricLabel(metric)
    let metric_log_actual: string@View = [[log(label: "observed-attributes-log-runtime-expr-binding-stmt-metric", expected: "48")]] metric_label
    if (metric_log_actual != "48") {
        [[log(label: "attributes-log-item_fail", expected: "fail")]] "fail"
        return 1
    }

    [[log(label: "attributes-log-item_success", expected: "success")]] "success"
    return 0
}

