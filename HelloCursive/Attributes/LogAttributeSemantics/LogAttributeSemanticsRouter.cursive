public procedure runGroup(ctx: Context) -> i32 {
    [[log(label: "attributes-log-section_start", expected: "section-start")]] "section-start"

    let status_grammar: i32 = RunLogAttributeGrammarAndTargets(ctx)
    if (status_grammar != 0) {
        [[log(label: "attributes-log-section_end", expected: "section-end")]] "section-end"
        return status_grammar
    }

    let status_expected: i32 = RunLogExpectedTypingAndEqualityChecks(ctx)
    if (status_expected != 0) {
        [[log(label: "attributes-log-section_end", expected: "section-end")]] "section-end"
        return status_expected
    }

    let status_runtime_expr: i32 = RunLogRuntimeExprBindingStmtSemantics(ctx)
    if (status_runtime_expr != 0) {
        [[log(label: "attributes-log-section_end", expected: "section-end")]] "section-end"
        return status_runtime_expr
    }

    let status_proc: i32 = RunLogProcedureEntryExitSemantics(ctx)
    if (status_proc != 0) {
        [[log(label: "attributes-log-section_end", expected: "section-end")]] "section-end"
        return status_proc
    }

    let status_thread: i32 = RunLogThreadOrderingAndFailureTolerance(ctx)
    if (status_thread != 0) {
        [[log(label: "attributes-log-section_end", expected: "section-end")]] "section-end"
        return status_thread
    }

    [[log(label: "attributes-log-section_end", expected: "section-end")]] "section-end"
    return 0
}

