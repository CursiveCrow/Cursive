procedure LogAttributeGrammarAndTargetsMetricLabel(value: i32) -> string@View {
    if (value == 40) {
        return "40"
    }
    return "other"
}

public procedure RunLogAttributeGrammarAndTargets(ctx: Context) -> i32 {
    let _ = ctx
    [[log(label: "attributes-log-item_begin", expected: "running")]] "running"

    [[log(label: "attributes-log-grammar-standalone")]]
    let statement_log: bool = true
    let expression_log: i32 = [[log(label: "attributes-log-grammar-expression", expected: 9)]] 9
    let binding_log: i32 = [[log(label: "attributes-log-grammar-binding", expected: 10)]] expression_log + 1

    let procedure_target: string@View = [[log(label: "attributes-log-target-procedure", expected: "Procedure")]] "Procedure"
    let binding_target: string@View = [[log(label: "attributes-log-target-binding", expected: "Binding")]] "Binding"
    let expression_target: string@View = [[log(label: "attributes-log-target-expression", expected: "Expression")]] "Expression"
    let statement_target: string@View = [[log(label: "attributes-log-target-statement", expected: "Statement")]] "Statement"

    let atr_039: string@View = [[log(label: "attributes-log-feature-039", expected: "ATR-039")]] "ATR-039"
    let atr_040: string@View = [[log(label: "attributes-log-feature-040", expected: "ATR-040")]] "ATR-040"

    let runtime_ok: bool =
        (statement_log == true) &&
        (expression_log == 9) &&
        (binding_log == 10) &&
        (procedure_target == "Procedure") &&
        (binding_target == "Binding") &&
        (expression_target == "Expression") &&
        (statement_target == "Statement") &&
        (atr_039 == "ATR-039") &&
        (atr_040 == "ATR-040")
    let runtime_ok_log: bool = [[log(label: "attributes-log-grammar-targets-runtime", expected: true)]] runtime_ok

    let metric: i32 = if (runtime_ok_log == true) { 40 } else { 0 }
    let metric_label: string@View = LogAttributeGrammarAndTargetsMetricLabel(metric)
    let metric_log_actual: string@View = [[log(label: "observed-attributes-log-grammar-targets-metric", expected: "40")]] metric_label
    if (metric_log_actual != "40") {
        [[log(label: "attributes-log-item_fail", expected: "fail")]] "fail"
        return 1
    }

    [[log(label: "attributes-log-item_success", expected: "success")]] "success"
    return 0
}

