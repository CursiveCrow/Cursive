modal ModalLayoutCodegenProbe {
    @Empty {
    }
    @Small {
        value: i32
    }
    @Wide {
        left: i32
        right: i32
        payload: [i32; 8]
    }
}

procedure ModalLayoutCodegenMetricLabel(value: i32) -> string@View {
    if (value == 25) {
        return "25"
    }
    return "other"
}

public procedure RunModalLayoutCodegen(ctx: Context) -> i32 {
    let _ = ctx
    "running"

    let small_state: ModalLayoutCodegenProbe@Small =
        ModalLayoutCodegenProbe@Small { value: 5 }
    let wide_state: ModalLayoutCodegenProbe@Wide =
        ModalLayoutCodegenProbe@Wide {
            left: 7,
            right: 8,
            payload: [1, 2, 3, 4, 5, 6, 7, 8]
        }

    let small_general: ModalLayoutCodegenProbe = widen(small_state)
    let wide_general: ModalLayoutCodegenProbe = widen(wide_state)

    let small_metric: i32 = if small_general is {
        @Empty { } { 0 }
        @Small { value: value } { value }
        @Wide { left: _, right: _, payload: _ } { 0 }
    }
    let wide_metric: i32 = if wide_general is {
        @Empty { } { 0 }
        @Small { value: _ } { 0 }
        @Wide { left: left, right: right, payload: payload } {
            payload[0] + payload[7] + (left + right)
        }
    }

    let general_size: usize = sizeof(ModalLayoutCodegenProbe)
    let small_size: usize = sizeof(ModalLayoutCodegenProbe@Small)
    let wide_size: usize = sizeof(ModalLayoutCodegenProbe@Wide)
    let general_align: usize = alignof(ModalLayoutCodegenProbe)
    let small_align: usize = alignof(ModalLayoutCodegenProbe@Small)
    let wide_align: usize = alignof(ModalLayoutCodegenProbe@Wide)

    let small_metric_log: i32 =
        small_metric
    let wide_metric_log: i32 =
        wide_metric
    let general_size_log: usize =
        general_size
    let small_size_log: usize =
        small_size
    let wide_size_log: usize =
        wide_size
    let general_align_log: usize =
        general_align
    let small_align_log: usize =
        small_align
    let wide_align_log: usize =
        wide_align
    let layout_size_align_ok: bool =
        (general_size_log == 44usize) &&
        (small_size_log == 4usize) &&
        (wide_size_log == 40usize) &&
        (general_align_log == 4usize) &&
        (small_align_log == 4usize) &&
        (wide_align_log == 4usize)
    let layout_size_align_ok_log: bool =
        layout_size_align_ok

    let mod_054: string@View = "MOD-054"
    let mod_054_log: string@View =
        mod_054

    let runtime_ok: bool =
        (small_metric_log == 5) &&
        (wide_metric_log == 24) &&
        (layout_size_align_ok_log == true) &&
        (mod_054_log == "MOD-054")
    let runtime_ok_log: bool =
        runtime_ok

    let metric: i32 = if (runtime_ok_log == true) { 25 } else { 0 }
    let metric_label: string@View = ModalLayoutCodegenMetricLabel(metric)
    let metric_log_actual: string@View =
        metric_label
    if (metric_log_actual != "25") {
        "fail"
        return 1
    }

    "success"
    return 0
}
