public procedure runGroup(ctx: Context) -> i32 {
    "section-start"

    let status_modal_layout_codegen: i32 = RunModalLayoutCodegen(ctx)
    if (status_modal_layout_codegen != 0) {
        "section-end"
        return status_modal_layout_codegen
    }

    let status_modal_layout_runtime: i32 = RunModalLayoutRuntime(ctx)
    if (status_modal_layout_runtime != 0) {
        "section-end"
        return status_modal_layout_runtime
    }

    let status_modal_niche_and_tagged_encoding: i32 = RunModalNicheAndTaggedEncoding(ctx)
    if (status_modal_niche_and_tagged_encoding != 0) {
        "section-end"
        return status_modal_niche_and_tagged_encoding
    }

    let status_modal_value_representation: i32 = RunModalValueRepresentation(ctx)
    if (status_modal_value_representation != 0) {
        "section-end"
        return status_modal_value_representation
    }

    "section-end"
    return 0
}
