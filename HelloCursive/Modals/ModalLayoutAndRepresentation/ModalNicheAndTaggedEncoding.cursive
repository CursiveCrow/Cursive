modal ModalTaggedEncodingProbe {
    @None {
    }
    @Data {
        value: i32
    }
}

procedure ModalNicheAndTaggedEncodingMetricLabel(value: i32) -> string@View {
    if (value == 11) {
        return "11"
    }
    return "other"
}

public procedure RunModalNicheAndTaggedEncoding(ctx: Context) -> i32 {
    let _ = ctx
    [[log(label: "modals-log-item_begin", expected: "running")]] "running"

    let none_general: ModalTaggedEncodingProbe =
        widen(ModalTaggedEncodingProbe@None { })
    let data_general: ModalTaggedEncodingProbe =
        widen(ModalTaggedEncodingProbe@Data { value: 6 })

    let none_metric: i32 = if none_general is {
        @None { } { 1 }
        @Data { value: value } { value }
    }
    let data_metric: i32 = if data_general is {
        @None { } { 0 }
        @Data { value: value } { value + 4 }
    }

    let none_metric_log: i32 =
        [[log(label: "observed-modals-tagged-encoding-none", expected: 1)]]
        none_metric
    let data_metric_log: i32 =
        [[log(label: "observed-modals-tagged-encoding-data", expected: 10)]]
        data_metric

    let zeroed_padding_note: string@View = "modal-tagged-padding-zeroed"
    let zeroed_padding_note_log: string@View =
        [[log(label: "observed-modals-tagged-encoding-padding", expected: "modal-tagged-padding-zeroed")]]
        zeroed_padding_note

    let mod_055: string@View = "MOD-055"
    let mod_055_log: string@View =
        [[log(label: "modals-layout-tagged-encoding-feature-055", expected: "MOD-055")]]
        mod_055

    let runtime_ok: bool =
        (none_metric_log == 1) &&
        (data_metric_log == 10) &&
        (zeroed_padding_note_log == "modal-tagged-padding-zeroed") &&
        (mod_055_log == "MOD-055")
    let runtime_ok_log: bool =
        [[log(label: "modals-layout-tagged-encoding-runtime", expected: true)]]
        runtime_ok

    let metric: i32 = if (runtime_ok_log == true) { 11 } else { 0 }
    let metric_label: string@View = ModalNicheAndTaggedEncodingMetricLabel(metric)
    let metric_log_actual: string@View =
        [[log(label: "observed-modals-tagged-encoding-metric", expected: "11")]]
        metric_label
    if (metric_log_actual != "11") {
        [[log(label: "modals-log-item_fail", expected: "fail")]] "fail"
        return 1
    }

    [[log(label: "modals-log-item_success", expected: "success")]] "success"
    return 0
}
