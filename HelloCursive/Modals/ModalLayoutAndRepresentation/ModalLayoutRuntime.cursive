modal ModalLayoutRuntimeProbe {
    @Zero {
    }
    @Payload {
        value: i32
        marker: bool
    }
}

procedure ModalLayoutRuntimeMetricLabel(value: i32) -> string@View {
    if (value == 12) {
        return "12"
    }
    return "other"
}

public procedure RunModalLayoutRuntime(ctx: Context) -> i32 {
    let _ = ctx
    [[log(label: "modals-log-item_begin", expected: "running")]] "running"

    let zero_general: ModalLayoutRuntimeProbe =
        widen(ModalLayoutRuntimeProbe@Zero { })
    let payload_general: ModalLayoutRuntimeProbe =
        widen(ModalLayoutRuntimeProbe@Payload { value: 3, marker: true })

    let zero_metric: i32 = if zero_general is {
        @Zero { } { 2 }
        @Payload { value: value, marker: marker } {
            if (marker == true) { value } else { 0 }
        }
    }
    let payload_metric: i32 = if payload_general is {
        @Zero { } { 0 }
        @Payload { value: value, marker: marker } {
            if (marker == true) { value + 7 } else { value }
        }
    }

    let general_size: usize = sizeof(ModalLayoutRuntimeProbe)
    let zero_size: usize = sizeof(ModalLayoutRuntimeProbe@Zero)
    let payload_size: usize = sizeof(ModalLayoutRuntimeProbe@Payload)
    let general_align: usize = alignof(ModalLayoutRuntimeProbe)
    let zero_align: usize = alignof(ModalLayoutRuntimeProbe@Zero)
    let payload_align: usize = alignof(ModalLayoutRuntimeProbe@Payload)

    let zero_metric_log: i32 =
        [[log(label: "observed-modals-layout-runtime-zero", expected: 2)]]
        zero_metric
    let payload_metric_log: i32 =
        [[log(label: "observed-modals-layout-runtime-payload", expected: 10)]]
        payload_metric
    let general_size_log: usize =
        [[log(label: "observed-modals-layout-runtime-size-general")]]
        general_size
    let zero_size_log: usize =
        [[log(label: "observed-modals-layout-runtime-size-zero")]]
        zero_size
    let payload_size_log: usize =
        [[log(label: "observed-modals-layout-runtime-size-payload")]]
        payload_size
    let general_align_log: usize =
        [[log(label: "observed-modals-layout-runtime-align-general")]]
        general_align
    let zero_align_log: usize =
        [[log(label: "observed-modals-layout-runtime-align-zero")]]
        zero_align
    let payload_align_log: usize =
        [[log(label: "observed-modals-layout-runtime-align-payload")]]
        payload_align
    let layout_size_align_ok: bool =
        (general_size_log == 12usize) &&
        (zero_size_log == 0usize) &&
        (payload_size_log == 8usize) &&
        (general_align_log == 4usize) &&
        (zero_align_log == 1usize) &&
        (payload_align_log == 4usize)
    let layout_size_align_ok_log: bool =
        [[log(label: "modals-layout-runtime-size-align", expected: true)]]
        layout_size_align_ok

    let mod_056: string@View = "MOD-056"
    let mod_056_log: string@View =
        [[log(label: "modals-layout-runtime-feature-056", expected: "MOD-056")]]
        mod_056

    let runtime_ok: bool =
        (zero_metric_log == 2) &&
        (payload_metric_log == 10) &&
        (layout_size_align_ok_log == true) &&
        (mod_056_log == "MOD-056")
    let runtime_ok_log: bool =
        [[log(label: "modals-layout-runtime-runtime", expected: true)]]
        runtime_ok

    let metric: i32 = if (runtime_ok_log == true) { 12 } else { 0 }
    let metric_label: string@View = ModalLayoutRuntimeMetricLabel(metric)
    let metric_log_actual: string@View =
        [[log(label: "observed-modals-layout-runtime-metric", expected: "12")]]
        metric_label
    if (metric_log_actual != "12") {
        [[log(label: "modals-log-item_fail", expected: "fail")]] "fail"
        return 1
    }

    [[log(label: "modals-log-item_success", expected: "success")]] "success"
    return 0
}
