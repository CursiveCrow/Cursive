procedure AsyncSelectFast() -> Async<(), (), i32, !> {
    return 4
}

procedure AsyncSelectSlow() -> Async<(), (), i32, !> {
    let resume_value: () = yield ()
    return 6
}

procedure AsyncSelectThird() -> Async<(), (), i32, !> {
    let resume_value: () = yield release ()
    return 8
}

procedure AsyncSelectionRaceAllStateFlowMetricLabel(value: i32) -> string@View {
    if (value == 22) {
        return "22"
    }
    return "other"
}

public procedure RunAsyncSelectionRaceAllStateFlow(ctx: Context) -> i32 {
    let _ = ctx
    "running"

    let race_result: i32 | ! = race {
        AsyncSelectFast() -> |value| {
            value
        },
        AsyncSelectSlow() -> |value| {
            value
        }
    }
    let race_metric: i32 = if race_result is {
        value: i32 { value }
        _: ! { 0 }
    }

    let all_result: (i32, i32, i32) | ! = all {
        AsyncSelectFast(),
        AsyncSelectSlow(),
        AsyncSelectThird()
    }
    let all_metric: i32 = if all_result is {
        triple: (i32, i32, i32) { triple.0 + triple.1 + triple.2 }
        _: ! { 0 }
    }

    let aggregate_metric: i32 = race_metric + all_metric

    let race_metric_log: i32 =
        race_metric
    let all_metric_log: i32 =
        all_metric
    let aggregate_metric_log: i32 =
        aggregate_metric

    let mod_052: string@View = "MOD-052"
    let mod_052_log: string@View =
        mod_052

    let runtime_ok: bool =
        (race_metric_log == 4) &&
        (all_metric_log == 18) &&
        (aggregate_metric_log == 22) &&
        (mod_052_log == "MOD-052")
    let runtime_ok_log: bool =
        runtime_ok

    let metric: i32 = if (runtime_ok_log == true) { 22 } else { 0 }
    let metric_label: string@View = AsyncSelectionRaceAllStateFlowMetricLabel(metric)
    let metric_log_actual: string@View =
        metric_label
    if (metric_log_actual != "22") {
        "fail"
        return 1
    }

    "success"
    return 0
}
