procedure AsyncResumeProbe() -> Async<i32, i32, i32, !> {
    let input: i32 = yield 3
    return input + 5
}

procedure AsyncResumeTransitionsMetricLabel(value: i32) -> string@View {
    if (value == 9) {
        return "9"
    }
    return "other"
}

public procedure RunAsyncResumeTransitions(ctx: Context) -> i32 {
    let _ = ctx
    "running"

    let suspended_state: Async<i32, i32, i32, !> = AsyncResumeProbe()
    let suspended_output_metric: i32 = if move suspended_state is {
        @Suspended { output: output } { output }
        @Completed { value: value } { value }
        @Failed { error: _ } { 0 }
    }
    let resume_source_state: Async<i32, i32, i32, !> = AsyncResumeProbe()
    let resume_expected_metric: i32 = if move resume_source_state is {
        suspended: Async<i32, i32, i32, !>@Suspended {
            var suspended_unique: unique Async<i32, i32, i32, !>@Suspended = move suspended
            let resumed_state: Async<i32, i32, i32, !>@Suspended | Async<i32, i32, i32, !>@Completed | Async<i32, i32, i32, !>@Failed =
                suspended_unique~>resume(4)
            if move resumed_state is {
                resumed_suspended: Async<i32, i32, i32, !>@Suspended {
                    if move resumed_suspended is {
                        @Suspended { output: output } { output }
                    }
                }
                resumed_completed: Async<i32, i32, i32, !>@Completed {
                    if move resumed_completed is {
                        @Completed { value: value } { value }
                    }
                }
                _: Async<i32, i32, i32, !>@Failed { 0 }
            }
        }
        @Completed { value: value } { value }
        _: Async<i32, i32, i32, !>@Failed { 0 }
    }
    let resume_transition_supported: bool = true
    let resume_transition_supported_log: bool =
        resume_transition_supported

    let suspended_output_metric_log: i32 =
        suspended_output_metric
    let resumed_metric_log: i32 =
        resume_expected_metric

    let mod_047: string@View = "MOD-047"
    let mod_047_log: string@View =
        mod_047

    let runtime_ok: bool =
        (suspended_output_metric_log == 3) &&
        (resumed_metric_log == 9) &&
        (resume_transition_supported_log == true) &&
        (mod_047_log == "MOD-047")
    let runtime_ok_log: bool =
        runtime_ok

    let metric: i32 = if (runtime_ok_log == true) { 9 } else { 0 }
    let metric_label: string@View = AsyncResumeTransitionsMetricLabel(metric)
    let metric_log_actual: string@View =
        metric_label
    if (metric_log_actual != "9") {
        "fail"
        return 1
    }

    "success"
    return 0
}
