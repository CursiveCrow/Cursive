procedure AsyncManualStepProbe() -> Async<i32, i32, i32, !> {
    let input: i32 = yield 2
    return input + 7
}

procedure AsyncSyncProbe() -> Async<(), (), i32, !> {
    let resume_value: () = yield ()
    return 5
}

procedure AsyncManualSteppingAndSyncMetricLabel(value: i32) -> string@View {
    if (value == 18) {
        return "18"
    }
    return "other"
}

public procedure RunAsyncManualSteppingAndSync(ctx: Context) -> i32 {
    let _ = ctx
    "running"

    let manual_initial_state: Async<i32, i32, i32, !> = AsyncManualStepProbe()
    let manual_initial_metric: i32 = if move manual_initial_state is {
        @Suspended { output: output } { output }
        @Completed { value: value } { value }
        @Failed { error: _ } { 0 }
    }
    let manual_resume_state: Async<i32, i32, i32, !> = AsyncManualStepProbe()
    let manual_metric: i32 = if move manual_resume_state is {
        suspended: Async<i32, i32, i32, !>@Suspended {
            var suspended_unique: unique Async<i32, i32, i32, !>@Suspended = move suspended
            let resumed_state: Async<i32, i32, i32, !>@Suspended | Async<i32, i32, i32, !>@Completed | Async<i32, i32, i32, !>@Failed =
                suspended_unique~>resume(6)
            if move resumed_state is {
                resumed_suspended: Async<i32, i32, i32, !>@Suspended {
                    if move resumed_suspended is {
                        @Suspended { output: output } { output }
                    }
                }
                resumed_completed: Async<i32, i32, i32, !>@Completed {
                    if move resumed_completed is {
                        @Completed { value: value } { value }
                    }
                }
                _: Async<i32, i32, i32, !>@Failed { 0 }
            }
        }
        @Completed { value: value } { value }
        _: Async<i32, i32, i32, !>@Failed { 0 }
    }
    let manual_resume_supported: bool = true
    let manual_resume_supported_log: bool =
        manual_resume_supported

    let sync_metric: i32 = sync AsyncSyncProbe()

    let manual_initial_metric_log: i32 =
        manual_initial_metric
    let manual_metric_log: i32 =
        manual_metric
    let sync_metric_log: i32 =
        sync_metric

    let mod_049: string@View = "MOD-049"
    let mod_050: string@View = "MOD-050"
    let mod_049_log: string@View =
        mod_049
    let mod_050_log: string@View =
        mod_050

    let runtime_ok: bool =
        (manual_initial_metric_log == 2) &&
        (manual_metric_log == 13) &&
        (manual_resume_supported_log == true) &&
        (sync_metric_log == 5) &&
        (mod_049_log == "MOD-049") &&
        (mod_050_log == "MOD-050")
    let runtime_ok_log: bool =
        runtime_ok

    let metric: i32 = if (runtime_ok_log == true) { 18 } else { 0 }
    let metric_label: string@View = AsyncManualSteppingAndSyncMetricLabel(metric)
    let metric_log_actual: string@View =
        metric_label
    if (metric_log_actual != "18") {
        "fail"
        return 1
    }

    "success"
    return 0
}
