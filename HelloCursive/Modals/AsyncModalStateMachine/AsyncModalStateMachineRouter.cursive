public procedure runGroup(ctx: Context) -> i32 {
    "section-start"

    let status_async_procedure_state_production: i32 = RunAsyncProcedureStateProduction(ctx)
    if (status_async_procedure_state_production != 0) {
        "section-end"
        return status_async_procedure_state_production
    }

    let status_async_resume_transitions: i32 = RunAsyncResumeTransitions(ctx)
    if (status_async_resume_transitions != 0) {
        "section-end"
        return status_async_resume_transitions
    }

    let status_async_manual_stepping_and_sync: i32 = RunAsyncManualSteppingAndSync(ctx)
    if (status_async_manual_stepping_and_sync != 0) {
        "section-end"
        return status_async_manual_stepping_and_sync
    }

    let status_async_selection_race_all_state_flow: i32 = RunAsyncSelectionRaceAllStateFlow(ctx)
    if (status_async_selection_race_all_state_flow != 0) {
        "section-end"
        return status_async_selection_race_all_state_flow
    }

    let status_async_alias_types_and_iteration: i32 = RunAsyncAliasTypesAndIteration(ctx)
    if (status_async_alias_types_and_iteration != 0) {
        "section-end"
        return status_async_alias_types_and_iteration
    }

    let status_async_until_and_combinators: i32 = RunAsyncUntilAndCombinators(ctx)
    if (status_async_until_and_combinators != 0) {
        "section-end"
        return status_async_until_and_combinators
    }

    let status_async_key_integrated_state_flow: i32 = RunAsyncKeyIntegratedStateFlow(ctx)
    if (status_async_key_integrated_state_flow != 0) {
        "section-end"
        return status_async_key_integrated_state_flow
    }

    let status_pipe_exchange: i32 = RunPipeExchangeAliasExercises(ctx)
    if (status_pipe_exchange != 0) {
        "section-end"
        return status_pipe_exchange
    }

    "section-end"
    return 0
}
