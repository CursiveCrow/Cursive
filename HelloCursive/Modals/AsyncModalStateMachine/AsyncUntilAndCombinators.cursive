procedure AsyncUntilPredicateAtLeastThree(value: const i32) -> bool {
    return value >= 3
}

procedure AsyncUntilActionAddFour(value: unique i32) -> i32 {
    return value + 4
}

procedure AsyncMapSource() -> Async<i32, (), (), !> {
    let resume_a: () = yield 2
    let resume_b: () = yield 3
    return ()
}

procedure AsyncFilterSource() -> Async<i32, (), (), !> {
    let resume_a: () = yield 1
    let resume_b: () = yield 4
    return ()
}

procedure AsyncTakeSource() -> Async<i32, (), (), !> {
    let resume_a: () = yield 9
    let resume_b: () = yield 10
    return ()
}

procedure AsyncMapPlusOne(value: i32) -> i32 {
    return value + 1
}

procedure AsyncFilterAtLeastFour(value: const i32) -> bool {
    return value >= 4
}

procedure AsyncFoldSource() -> Async<i32, (), (), !> {
    let resume_a: () = yield 5
    let resume_b: () = yield 6
    return ()
}

procedure AsyncFoldSum(acc: i32, value: i32) -> i32 {
    return acc + value
}

procedure AsyncChainFutureSource() -> Future<i32> {
    return 4
}

procedure AsyncChainAddSix(value: i32) -> Future<i32> {
    return value + 6
}

procedure AsyncUntilAndCombinatorsMetricLabel(value: i32) -> string@View {
    if (value == 27) {
        return "27"
    }
    return "other"
}

public procedure RunAsyncUntilAndCombinators(ctx: Context) -> i32 {
    let _ = ctx
    "running"
    "stage-1-until-start"

    let until_seed: unique i32 = 3
    let until_shared: shared i32 = until_seed
    let until_future: Async<(), (), i32, !> =
        until_shared~>until(AsyncUntilPredicateAtLeastThree, AsyncUntilActionAddFour)
    let until_metric: i32 = sync until_future
    "stage-2-until-done"

    "stage-3-map-start"
    let mapped_state: Async<i32, (), (), !> = AsyncMapSource()~>map(AsyncMapPlusOne)
    let map_metric: i32 = if move mapped_state is {
        @Suspended { output: output } { output }
        @Completed { value: _ } { 0 }
        @Failed { error: _ } { 0 }
    }
    "stage-4-map-done"

    "stage-5-filter-start"
    let filtered_state: Async<i32, (), (), !> = AsyncFilterSource()~>filter(AsyncFilterAtLeastFour)
    let filter_metric: i32 = if move filtered_state is {
        @Suspended { output: output } { output }
        @Completed { value: _ } { 0 }
        @Failed { error: _ } { 0 }
    }
    "stage-6-filter-done"

    "stage-7-take-start"
    let take_state_first: Async<i32, (), (), !> = AsyncTakeSource()~>take(1usize)
    let take_metric: i32 = if move take_state_first is {
        @Suspended { output: output } { output }
        @Completed { value: _ } { 0 }
        @Failed { error: _ } { 0 }
    }
    "stage-8-take-done"
    "stage-9-fold-start"
    let folded_future: Future<i32> = AsyncFoldSource()~>fold(0, AsyncFoldSum)
    "stage-9a-fold-created"
    let fold_metric: i32 = sync folded_future
    "stage-10-fold-done"

    "stage-11-chain-start"
    let chained_future: Future<i32> = AsyncChainFutureSource()~>chain(AsyncChainAddSix)
    let chain_metric: i32 = sync chained_future
    "stage-12-chain-done"

    let until_metric_log: i32 =
        until_metric
    let map_metric_log: i32 =
        map_metric
    let filter_metric_log: i32 =
        filter_metric
    let take_metric_log: i32 =
        take_metric
    let fold_metric_log: i32 =
        fold_metric
    let chain_metric_log: i32 =
        chain_metric

    let mod_069: string@View = "MOD-069"
    let mod_070: string@View = "MOD-070"
    let mod_071: string@View = "MOD-071"
    let mod_072: string@View = "MOD-072"
    let mod_073: string@View = "MOD-073"
    let mod_074: string@View = "MOD-074"
    let mod_069_log: string@View =
        mod_069
    let mod_070_log: string@View =
        mod_070
    let mod_071_log: string@View =
        mod_071
    let mod_072_log: string@View =
        mod_072
    let mod_073_log: string@View =
        mod_073
    let mod_074_log: string@View =
        mod_074

    let runtime_ok: bool =
        (until_metric_log == 7) &&
        (map_metric_log == 3) &&
        (filter_metric_log == 4) &&
        (take_metric_log == 9) &&
        (fold_metric_log == 11) &&
        (chain_metric_log == 10) &&
        (mod_069_log == "MOD-069") &&
        (mod_070_log == "MOD-070") &&
        (mod_071_log == "MOD-071") &&
        (mod_072_log == "MOD-072") &&
        (mod_073_log == "MOD-073") &&
        (mod_074_log == "MOD-074")
    let runtime_ok_log: bool =
        runtime_ok

    let metric: i32 = if (runtime_ok_log == true) { 27 } else { 0 }
    let metric_label: string@View = AsyncUntilAndCombinatorsMetricLabel(metric)
    let metric_log_actual: string@View =
        metric_label
    if (metric_log_actual != "27") {
        "fail"
        return 1
    }

    "success"
    return 0
}
