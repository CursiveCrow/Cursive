type UserFuture<T> = Future<T>

procedure AsyncAliasSequenceSource() -> Sequence<i32> {
    let resume_a: () = yield 2
    let resume_b: () = yield 4
    return ()
}

procedure AsyncAliasFutureSource() -> Future<i32> {
    return 5
}

procedure AsyncAliasUserFutureSource() -> UserFuture<i32> {
    return 11
}

procedure AsyncAliasPipeSource() -> Pipe<i32, i32> {
    let input: i32 = yield 3
    return ()
}

procedure AsyncAliasExchangeSource() -> Exchange<i32> {
    let input: i32 = yield 1
    return input + 6
}

procedure AsyncAliasStreamSource() -> Stream<i32, !> {
    let resume_value: () = yield 8
    return ()
}

procedure AsyncLoopIterationSource() -> Async<i32, (), (), !> {
    let resume_a: () = yield 1
    let resume_b: () = yield 2
    let resume_c: () = yield 3
    return ()
}

procedure AsyncLoopFailureMaybe(flag: bool) -> i32 | bool {
    if (flag == true) {
        return 9
    }
    return false
}

procedure AsyncLoopFailureSource() -> Async<i32, (), (), bool> {
    let first_resume: () = yield 10
    let must_be_value: i32 = AsyncLoopFailureMaybe(false)?
    let second_resume: () = yield must_be_value
    return ()
}

procedure AsyncLoopIterationConsumer() -> Async<(), (), i32, !> {
    var sum: i32 = 0
    loop value in AsyncLoopIterationSource() {
        sum = sum + value
    }
    return sum
}

procedure AsyncLoopFailureConsumer() -> Async<(), (), i32, bool> {
    var sum: i32 = 0
    loop value in AsyncLoopFailureSource() {
        sum = sum + value
    }
    return sum
}

procedure AsyncAliasMapPlusTwo(value: i32) -> i32 {
    return value + 2
}

procedure AsyncAliasFoldSum(acc: i32, value: i32) -> i32 {
    return acc + value
}

procedure AsyncAliasTypesAndIterationMetricLabel(value: i32) -> string@View {
    if (value == 42) {
        return "42"
    }
    return "other"
}

public procedure RunAsyncAliasTypesAndIteration(ctx: Context) -> i32 {
    let _ = ctx
    "running"

    let sequence_state: Async<i32, (), (), !> = AsyncAliasSequenceSource()
    let sequence_metric: i32 = if move sequence_state is {
        @Suspended { output: output } { output }
        @Completed { value: _ } { 0 }
        @Failed { error: _ } { 0 }
    }

    let future_metric: i32 = sync AsyncAliasFutureSource()

    let user_future_state: Async<(), (), i32, !> = AsyncAliasUserFutureSource()
    let user_future_metric: i32 = if move user_future_state is {
        suspended: Async<(), (), i32, !>@Suspended {
            var suspended_unique: unique Async<(), (), i32, !>@Suspended = move suspended
            let resumed_state: Async<(), (), i32, !>@Suspended | Async<(), (), i32, !>@Completed | Async<(), (), i32, !>@Failed =
                suspended_unique~>resume(())
            if move resumed_state is {
                resumed_completed: Async<(), (), i32, !>@Completed {
                    if move resumed_completed is {
                        @Completed { value: value } { value }
                    }
                }
                _: Async<(), (), i32, !>@Suspended { 0 }
                _: Async<(), (), i32, !>@Failed { 0 }
            }
        }
        @Completed { value: value } { value }
        @Failed { error: _ } { 0 }
    }

    let pipe_state: Async<i32, i32, (), !> = AsyncAliasPipeSource()
    let pipe_metric: i32 = if move pipe_state is {
        @Suspended { output: output } { output }
        @Completed { value: _ } { 0 }
        @Failed { error: _ } { 0 }
    }

    let exchange_state: Async<i32, i32, i32, !> = AsyncAliasExchangeSource()
    let exchange_metric: i32 = if move exchange_state is {
        @Suspended { output: output } { output }
        @Completed { value: value } { value }
        @Failed { error: _ } { 0 }
    }

    let stream_state: Async<i32, (), (), !> = AsyncAliasStreamSource()
    let stream_metric: i32 = if move stream_state is {
        @Suspended { output: output } { output }
        @Completed { value: _ } { 0 }
        @Failed { error: _ } { 0 }
    }

    let sequence_mapped_state: Async<i32, (), (), !> = AsyncAliasSequenceSource()~>map(AsyncAliasMapPlusTwo)
    let sequence_mapped_metric: i32 = if move sequence_mapped_state is {
        @Suspended { output: output } { output }
        @Completed { value: _ } { 0 }
        @Failed { error: _ } { 0 }
    }

    let sequence_folded_future: Future<i32> = AsyncAliasSequenceSource()~>fold(0, AsyncAliasFoldSum)
    let sequence_folded_metric: i32 = sync sequence_folded_future

    let loop_metric: i32 = sync AsyncLoopIterationConsumer()
    let loop_failure_state: Async<(), (), i32, bool> = AsyncLoopFailureConsumer()
    let loop_failure_metric: bool = if move loop_failure_state is {
        @Failed { error: error } { error == false }
        _ { false }
    }

    let sequence_metric_log: i32 =
        sequence_metric
    let future_metric_log: i32 =
        future_metric
    let user_future_metric_log: i32 =
        user_future_metric
    let pipe_metric_log: i32 =
        pipe_metric
    let exchange_metric_log: i32 =
        exchange_metric
    let stream_metric_log: i32 =
        stream_metric
    let sequence_mapped_metric_log: i32 =
        sequence_mapped_metric
    let sequence_folded_metric_log: i32 =
        sequence_folded_metric
    let loop_metric_log: i32 =
        loop_metric
    let loop_failure_metric_log: bool =
        loop_failure_metric

    let mod_067: string@View = "MOD-067"
    let mod_068: string@View = "MOD-068"
    let mod_067_log: string@View =
        mod_067
    let mod_068_log: string@View =
        mod_068

    let runtime_ok: bool =
        (sequence_metric_log == 2) &&
        (future_metric_log == 5) &&
        (user_future_metric_log == 11) &&
        (pipe_metric_log == 3) &&
        (exchange_metric_log == 1) &&
        (stream_metric_log == 8) &&
        (sequence_mapped_metric_log == 4) &&
        (sequence_folded_metric_log == 6) &&
        (loop_metric_log == 6) &&
        (loop_failure_metric_log == true) &&
        (mod_067_log == "MOD-067") &&
        (mod_068_log == "MOD-068")
    let runtime_ok_log: bool =
        runtime_ok

    let metric: i32 = if (runtime_ok_log == true) { 42 } else { 0 }
    let metric_label: string@View = AsyncAliasTypesAndIterationMetricLabel(metric)
    let metric_log_actual: string@View =
        metric_label
    if (metric_log_actual != "42") {
        "fail"
        return 1
    }

    "success"
    return 0
}
