procedure ModalDiagnosticMatrixMetricLabel(value: i32) -> string@View {
    if (value == 24) {
        return "24"
    }
    return "other"
}

public procedure RunModalDiagnosticMatrix(ctx: Context) -> i32 {
    let _ = ctx
    "running"

    let d2050: string@View = "E-TYP-2050"
    let d2051: string@View = "E-TYP-2051"
    let d2052: string@View = "E-TYP-2052"
    let d2053: string@View = "E-TYP-2053"
    let d2054: string@View = "E-TYP-2054"
    let d2055: string@View = "E-TYP-2055"
    let d2056: string@View = "E-TYP-2056"
    let d2057: string@View = "E-TYP-2057"
    let d2058: string@View = "E-TYP-2058"
    let d2059: string@View = "E-TYP-2059"
    let d2060: string@View = "E-TYP-2060"
    let d2061: string@View = "E-TYP-2061"
    let d2062: string@View = "E-TYP-2062"
    let d2063: string@View = "E-TYP-2063"
    let d2064: string@View = "E-TYP-2064"
