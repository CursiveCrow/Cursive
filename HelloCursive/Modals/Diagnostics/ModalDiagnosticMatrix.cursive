    let d2071: string@View = "E-TYP-2071"
    let d2072: string@View = "E-TYP-2072"
    let d2073: string@View = "E-TYP-2073"
    let d2303: string@View = "E-TYP-2303"
    let w4010: string@View = "W-SYS-4010"

    let d2050_log: string@View = d2050
    let d2051_log: string@View = d2051
    let d2052_log: string@View = d2052
    let d2053_log: string@View = d2053
    let d2054_log: string@View = d2054
    let d2055_log: string@View = d2055
    let d2056_log: string@View = d2056
    let d2057_log: string@View = d2057
    let d2058_log: string@View = d2058
    let d2059_log: string@View = d2059
    let d2060_log: string@View = d2060
    let d2061_log: string@View = d2061
    let d2062_log: string@View = d2062
    let d2063_log: string@View = d2063
    let d2064_log: string@View = d2064
    let d2065_log: string@View = d2065
    let d2070_log: string@View = d2070
    let d2071_log: string@View = d2071
    let d2072_log: string@View = d2072
    let d2073_log: string@View = d2073
    let d2303_log: string@View = d2303
    let w4010_log: string@View = w4010

    let mod_061: string@View = "MOD-061"
    let mod_062: string@View = "MOD-062"
    let mod_063: string@View = "MOD-063"
    let mod_061_log: string@View =
        mod_061
    let mod_062_log: string@View =
        mod_062
    let mod_063_log: string@View =
        mod_063

    let runtime_ok: bool =
        (d2050_log == "E-TYP-2050") &&
        (d2051_log == "E-TYP-2051") &&
        (d2052_log == "E-TYP-2052") &&
        (d2053_log == "E-TYP-2053") &&
        (d2054_log == "E-TYP-2054") &&
        (d2055_log == "E-TYP-2055") &&
        (d2056_log == "E-TYP-2056") &&
        (d2057_log == "E-TYP-2057") &&
        (d2058_log == "E-TYP-2058") &&
        (d2059_log == "E-TYP-2059") &&
        (d2060_log == "E-TYP-2060") &&
        (d2061_log == "E-TYP-2061") &&
        (d2062_log == "E-TYP-2062") &&
        (d2063_log == "E-TYP-2063") &&
        (d2064_log == "E-TYP-2064") &&
        (d2065_log == "E-TYP-2065") &&
