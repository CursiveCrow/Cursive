procedure AsyncBuiltinShapeMaybe(flag: bool) -> i32 | bool {
    if (flag == true) {
        return 4
    }
    return false
}

procedure AsyncBuiltinShapeYield() -> Async<i32, (), i32, !> {
    let resume_value: () = yield 6
    return 9
}

procedure AsyncBuiltinShapeComplete() -> Async<(), (), i32, !> {
    return 5
}

procedure AsyncBuiltinShapeResumeMetric() -> i32 {
    "resume-metric-start"
    let source_state: Async<i32, (), i32, !> = AsyncBuiltinShapeYield()
    "resume-metric-after-source"
    let resumed_metric: i32 = if move source_state is {
        suspended: Async<i32, (), i32, !>@Suspended {
            "resume-metric-enter-suspended"
            var suspended_unique: unique Async<i32, (), i32, !>@Suspended = move suspended
            let resumed_state: Async<i32, (), i32, !>@Suspended | Async<i32, (), i32, !>@Completed | Async<i32, (), i32, !>@Failed =
                suspended_unique~>resume(())
            "resume-metric-after-resume-call"
            if move resumed_state is {
                resumed_suspended: Async<i32, (), i32, !>@Suspended {
                    "resume-metric-resumed-suspended"
                    if move resumed_suspended is {
                        @Suspended { output: output } { output }
                    }
                }
                resumed_completed: Async<i32, (), i32, !>@Completed {
                    "resume-metric-resumed-completed"
                    if move resumed_completed is {
                        @Completed { value: value } { value }
                    }
                }
                _: Async<i32, (), i32, !>@Failed {
                    "resume-metric-resumed-failed"
                    0
                }
            }
        }
        @Completed { value: value } {
            "resume-metric-source-completed"
            value
        }
        _: Async<i32, (), i32, !>@Failed {
            "resume-metric-source-failed"
            0
        }
    }
    "resume-metric-end"
    return resumed_metric
}

procedure AsyncBuiltinModalShapeMetricLabel(value: i32) -> string@View {
    if (value == 16) {
        return "16"
    }
    return "other"
}

public procedure RunAsyncBuiltinModalShape(ctx: Context) -> i32 {
    let _ = ctx
    "running"
    "before-suspended-state"

    let suspended_state: Async<i32, (), i32, !> = AsyncBuiltinShapeYield()
    "after-suspended-state"
    let suspended_metric: i32 = if move suspended_state is {
        @Suspended { output: output } { output }
        @Completed { value: value } { value }
        @Failed { error: _ } { 0 }
    }
    "after-suspended-case"
    let completed_state: Async<(), (), i32, !> = AsyncBuiltinShapeComplete()
    "after-completed-state"
    let completed_metric: i32 = if move completed_state is {
        @Completed { value: value } { value }
        @Suspended { output: _ } { 0 }
        @Failed { error: _ } { 0 }
    }
    "after-completed-case"
    let resumed_metric: i32 = AsyncBuiltinShapeResumeMetric()
    "after-resume-metric"
    let failed_state: Async<(), (), i32, !> = AsyncBuiltinShapeComplete()
    "after-failed-state"
    let failed_metric: bool = if move failed_state is {
        @Failed { error: _ } { true }
        _ { false }
    }
    "after-failed-case"

    let suspended_metric_log: i32 =
        suspended_metric
    let completed_metric_log: i32 =
        completed_metric
    let resumed_metric_log: i32 =
        resumed_metric
    let failed_metric_log: bool =
        failed_metric

    let resume_signature_shape_supported: bool = true
    let resume_signature_shape_supported_log: bool =
        resume_signature_shape_supported

    let mod_045: string@View = "MOD-045"
    let mod_045_log: string@View =
        mod_045

    let runtime_ok: bool =
        (suspended_metric_log == 6) &&
        (completed_metric_log == 5) &&
        (resumed_metric_log == 9) &&
        (failed_metric_log == false) &&
        (resume_signature_shape_supported_log == true) &&
        (mod_045_log == "MOD-045")
    let runtime_ok_log: bool =
        runtime_ok

    let metric: i32 = if (runtime_ok_log == true) { 16 } else { 0 }
    let metric_label: string@View = AsyncBuiltinModalShapeMetricLabel(metric)
    let metric_log_actual: string@View =
        metric_label
    if (metric_log_actual != "16") {
        "fail"
        return 1
    }

    "success"
    return 0
}
