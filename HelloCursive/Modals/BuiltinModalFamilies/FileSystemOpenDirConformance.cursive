procedure FileSystemOpenDirConformanceMetricLabel(value: i32) -> string@View {
    if (value == 6) {
        return "6"
    }
    return "other"
}

public procedure RunFileSystemOpenDirConformance(ctx: Context) -> i32 {
    "running"

    let fs: $FileSystem = ctx.fs
    let build_dir_path: string@View = "build"
    let build_main_dir_path: string@View = "build/main"
    let logs_dir_path: string@View = "build/main/logs"
    let runtime_logs_dir_path: string@View = "build/main/logs/runtime"
    let build_dir_ready: bool = if fs~>create_dir(build_dir_path) is {
        _: () { true }
        _: IoError { fs~>exists(build_dir_path) }
    }
    let build_main_dir_ready: bool = if (build_dir_ready == true) {
        if fs~>create_dir(build_main_dir_path) is {
            _: () { true }
            _: IoError { fs~>exists(build_main_dir_path) }
        }
    } else {
        false
    }
    let logs_dir_ready: bool = if (build_main_dir_ready == true) {
        if fs~>create_dir(logs_dir_path) is {
            _: () { true }
            _: IoError { fs~>exists(logs_dir_path) }
        }
    } else {
        false
    }
    let runtime_logs_dir_ready: bool = if (logs_dir_ready == true) {
        if fs~>create_dir(runtime_logs_dir_path) is {
            _: () { true }
            _: IoError { fs~>exists(runtime_logs_dir_path) }
        }
    } else {
        false
    }

    let probe_dir_path: string@View =
        "build/main/logs/runtime/fs_open_dir_conformance_probe_dir"
    let probe_file_path: string@View =
        "build/main/logs/runtime/fs_open_dir_conformance_probe_dir/entry.txt"
    let missing_dir_path: string@View =
        "build/main/logs/runtime/fs_open_dir_conformance_missing_dir"
    let payload: bytes@View = bytes::view_string("open-dir-probe")

    let stale_probe_file_cleanup: () | IoError = fs~>remove(probe_file_path)
    let _ = stale_probe_file_cleanup
    let stale_probe_dir_cleanup: () | IoError = fs~>remove(probe_dir_path)
    let _ = stale_probe_dir_cleanup
    let stale_missing_cleanup: () | IoError = fs~>remove(missing_dir_path)
    let _ = stale_missing_cleanup

    let probe_dir_ready: bool = if (runtime_logs_dir_ready == true) {
        if fs~>create_dir(probe_dir_path) is {
            _: () { true }
            _: IoError { fs~>exists(probe_dir_path) }
        }
    } else {
        false
    }

    let probe_file_seeded: bool = if (probe_dir_ready == true) {
        if fs~>write_file(probe_file_path, payload) is {
            _: () { true }
            _: IoError { false }
        }
    } else {
        false
    }

    let first_entry_ok: bool = if (probe_file_seeded == true) {
        if fs~>open_dir(probe_dir_path) is {
            iter: unique DirIter@Open {
                let first_result: DirEntry | () | IoError = iter~>next()
                let second_result: DirEntry | () | IoError = iter~>next()
                let closed_iter: DirIter@Closed = iter~>close()
                let _ = closed_iter
                let first_entry_matches: bool = if first_result is {
                    entry: DirEntry {
                        if entry.kind is {
                            FileKind::File { true }
                            FileKind::Dir { false }
                            FileKind::Other { false }
                        }
                    }
                    _: () { false }
                    _: IoError { false }
                }
                let second_result_done: bool = if second_result is {
                    _: DirEntry { false }
                    _: () { true }
                    _: IoError { false }
                }
                first_entry_matches && second_result_done
            }
            _: IoError { false }
        }
    } else {
        false
    }

    let missing_dir_error: bool = if fs~>open_dir(missing_dir_path) is {
        iter: unique DirIter@Open {
            let closed_iter: DirIter@Closed = iter~>close()
            let _ = closed_iter
            false
        }
        _: IoError { true }
    }

    let runtime_logs_dir_ready_log: bool =
        runtime_logs_dir_ready
    let probe_dir_ready_log: bool =
        probe_dir_ready
    let probe_file_seeded_log: bool =
        probe_file_seeded
    let first_entry_ok_log: bool =
        first_entry_ok
    let missing_dir_error_log: bool =
        missing_dir_error

    let metric: i32 = if (
        (runtime_logs_dir_ready_log == true) &&
        (probe_dir_ready_log == true) &&
        (probe_file_seeded_log == true) &&
        (first_entry_ok_log == true) &&
        (missing_dir_error_log == true)
    ) { 6 } else { 0 }
    let metric_label: string@View = FileSystemOpenDirConformanceMetricLabel(metric)
    let metric_log_actual: string@View =
        metric_label

    let cleanup_probe_file: () | IoError = fs~>remove(probe_file_path)
    let _ = cleanup_probe_file
    let cleanup_probe_dir: () | IoError = fs~>remove(probe_dir_path)
    let _ = cleanup_probe_dir
    let cleanup_missing_dir: () | IoError = fs~>remove(missing_dir_path)
    let _ = cleanup_missing_dir

    if (metric_log_actual != "6") {
        "fail"
        return 1
    }

    "success"
    return 0
}
