procedure FileSystemOpenReadConformanceMetricLabel(value: i32) -> string@View {
    if (value == 18) {
        return "18"
    }
    return "other"
}

public procedure RunFileSystemOpenReadConformance(ctx: Context) -> i32 {
    [[log(label: "modals-log-item_begin", expected: "running")]] "running"

    let fs: $FileSystem = ctx.fs
    let build_dir_path: string@View = "build"
    let build_main_dir_path: string@View = "build/main"
    let logs_dir_path: string@View = "build/main/logs"
    let runtime_logs_dir_path: string@View = "build/main/logs/runtime"
    let build_dir_ready: bool = if fs~>create_dir(build_dir_path) is {
        _: () { true }
        _: IoError { fs~>exists(build_dir_path) }
    }
    let build_main_dir_ready: bool = if (build_dir_ready == true) {
        if fs~>create_dir(build_main_dir_path) is {
            _: () { true }
            _: IoError { fs~>exists(build_main_dir_path) }
        }
    } else {
        false
    }
    let logs_dir_ready: bool = if (build_main_dir_ready == true) {
        if fs~>create_dir(logs_dir_path) is {
            _: () { true }
            _: IoError { fs~>exists(logs_dir_path) }
        }
    } else {
        false
    }
    let runtime_logs_dir_ready: bool = if (logs_dir_ready == true) {
        if fs~>create_dir(runtime_logs_dir_path) is {
            _: () { true }
            _: IoError { fs~>exists(runtime_logs_dir_path) }
        }
    } else {
        false
    }

    let probe_path: string@View =
        "build/main/logs/runtime/fs_open_read_conformance_probe.txt"
    let missing_path: string@View =
        "build/main/logs/runtime/fs_open_read_conformance_missing.txt"
    let payload_text: string@View = "fs-open-read-probe"
    let payload_bytes: bytes@View = bytes::view_string(payload_text)
    let payload_length: i32 = string::length(payload_text) as i32

    let stale_probe_cleanup: () | IoError = fs~>remove(probe_path)
    let _ = stale_probe_cleanup
    let stale_missing_cleanup: () | IoError = fs~>remove(missing_path)
    let _ = stale_missing_cleanup

    let write_ready: bool = if (runtime_logs_dir_ready == true) {
        if fs~>create_write(probe_path) is {
            writer: unique File@Write {
                let write_result: () | IoError = writer~>write(payload_bytes)
                let flush_result: () | IoError = writer~>flush()
                let closed_writer: File@Closed = writer~>close()
                let _ = closed_writer
                let write_ok: bool = if write_result is {
                    _: () { true }
                    _: IoError { false }
                }
                let flush_ok: bool = if flush_result is {
                    _: () { true }
                    _: IoError { false }
                }
                write_ok && flush_ok
            }
            _: IoError { false }
        }
    } else {
        false
    }

    let open_read_length: i32 = if (write_ready == true) {
        if fs~>open_read(probe_path) is {
            reader: unique File@Read {
                let read_result: string@Managed | IoError = reader~>read_all()
                let closed_reader: File@Closed = reader~>close()
                let _ = closed_reader
                if read_result is {
                    read_text: string@Managed {
                        let read_view: string@View = string::as_view(read_text)
                        string::length(read_view) as i32
                    }
                    _: IoError { 0 }
                }
            }
            _: IoError { 0 }
        }
    } else {
        0
    }
    let open_read_success: bool = open_read_length == payload_length

    let open_read_missing_error: bool = if fs~>open_read(missing_path) is {
        _: unique File@Read { false }
        _: IoError { true }
    }

    let runtime_logs_dir_ready_log: bool =
        [[log(label: "observed-modals-fs-open-read-runtime-dir-ready", expected: true)]]
        runtime_logs_dir_ready
    let write_ready_log: bool =
        [[log(label: "observed-modals-fs-open-read-write-ready", expected: true)]]
        write_ready
    let open_read_length_log: i32 =
        [[log(label: "observed-modals-fs-open-read-text-length", expected: 18)]]
        open_read_length
    let open_read_success_log: bool =
        [[log(label: "observed-modals-fs-open-read-success", expected: true)]]
        open_read_success
    let open_read_missing_error_log: bool =
        [[log(label: "observed-modals-fs-open-read-missing-error", expected: true)]]
        open_read_missing_error

    let metric: i32 = if (
        (runtime_logs_dir_ready_log == true) &&
        (write_ready_log == true) &&
        (open_read_length_log == 18) &&
        (open_read_success_log == true) &&
        (open_read_missing_error_log == true)
    ) { 18 } else { 0 }
    let metric_label: string@View = FileSystemOpenReadConformanceMetricLabel(metric)
    let metric_log_actual: string@View =
        [[log(label: "observed-modals-fs-open-read-metric", expected: "18")]]
        metric_label

    let cleanup_probe: () | IoError = fs~>remove(probe_path)
    let _ = cleanup_probe

    if (metric_log_actual != "18") {
        [[log(label: "modals-log-item_fail", expected: "fail")]] "fail"
        return 1
    }

    [[log(label: "modals-log-item_success", expected: "success")]] "success"
    return 0
}
