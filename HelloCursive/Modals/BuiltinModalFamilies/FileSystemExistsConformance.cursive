procedure FileSystemExistsConformanceMetricLabel(value: i32) -> string@View {
    if (value == 5) {
        return "5"
    }
    return "other"
}

public procedure RunFileSystemExistsConformance(ctx: Context) -> i32 {
    "running"

    let fs: $FileSystem = ctx.fs
    let build_dir_path: string@View = "build"
    let build_main_dir_path: string@View = "build/main"
    let logs_dir_path: string@View = "build/main/logs"
    let runtime_logs_dir_path: string@View = "build/main/logs/runtime"
    let build_dir_ready: bool = if fs~>create_dir(build_dir_path) is {
        _: () { true }
        _: IoError { fs~>exists(build_dir_path) }
    }
    let build_main_dir_ready: bool = if (build_dir_ready == true) {
        if fs~>create_dir(build_main_dir_path) is {
            _: () { true }
            _: IoError { fs~>exists(build_main_dir_path) }
        }
    } else {
        false
    }
    let logs_dir_ready: bool = if (build_main_dir_ready == true) {
        if fs~>create_dir(logs_dir_path) is {
            _: () { true }
            _: IoError { fs~>exists(logs_dir_path) }
        }
    } else {
        false
    }
    let runtime_logs_dir_ready: bool = if (logs_dir_ready == true) {
        if fs~>create_dir(runtime_logs_dir_path) is {
            _: () { true }
            _: IoError { fs~>exists(runtime_logs_dir_path) }
        }
    } else {
        false
    }

    let probe_path: string@View =
        "build/main/logs/runtime/fs_exists_conformance_probe.txt"
    let missing_path: string@View =
        "build/main/logs/runtime/fs_exists_conformance_missing.txt"
    let escaped_target_path: string@View =
        "build/main/logs/fs_exists_escape.txt"
    let escape_path: string@View = "../fs_exists_escape.txt"
    let payload: bytes@View = bytes::view_string("exists-probe")

    let stale_probe_cleanup: () | IoError = fs~>remove(probe_path)
    let _ = stale_probe_cleanup
    let stale_missing_cleanup: () | IoError = fs~>remove(missing_path)
    let _ = stale_missing_cleanup
    let stale_escaped_cleanup: () | IoError = fs~>remove(escaped_target_path)
    let _ = stale_escaped_cleanup

    let exists_before_create: bool = fs~>exists(probe_path)
    let write_ready: bool = if (runtime_logs_dir_ready == true) {
        if fs~>write_file(probe_path, payload) is {
            _: () { true }
            _: IoError { false }
        }
    } else {
        false
    }
    let exists_after_create: bool = if (write_ready == true) {
        fs~>exists(probe_path)
    } else {
        false
    }
    let missing_is_false: bool = fs~>exists(missing_path) == false

    let restricted_fs: $FileSystem = fs~>restrict(runtime_logs_dir_path)
    let restricted_escape_is_false: bool = restricted_fs~>exists(escape_path) == false
    let escaped_target_missing: bool = fs~>exists(escaped_target_path) == false

    let runtime_logs_dir_ready_log: bool =
        runtime_logs_dir_ready
    let exists_before_create_log: bool =
        exists_before_create
    let exists_after_create_log: bool =
        exists_after_create
    let missing_is_false_log: bool =
        missing_is_false
    let restricted_escape_is_false_log: bool =
        restricted_escape_is_false
    let escaped_target_missing_log: bool =
        escaped_target_missing

    let metric: i32 = if (
        (runtime_logs_dir_ready_log == true) &&
        (exists_before_create_log == false) &&
        (exists_after_create_log == true) &&
        (missing_is_false_log == true) &&
        (restricted_escape_is_false_log == true) &&
        (escaped_target_missing_log == true)
    ) { 5 } else { 0 }
    let metric_label: string@View = FileSystemExistsConformanceMetricLabel(metric)
    let metric_log_actual: string@View =
        metric_label

    let cleanup_probe: () | IoError = fs~>remove(probe_path)
    let _ = cleanup_probe
    let cleanup_escaped_target: () | IoError = fs~>remove(escaped_target_path)
    let _ = cleanup_escaped_target

    if (metric_log_actual != "5") {
        "fail"
        return 1
    }

    "success"
    return 0
}
