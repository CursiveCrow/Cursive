procedure FileSystemRemoveConformanceMetricLabel(value: i32) -> string@View {
    if (value == 7) {
        return "7"
    }
    return "other"
}

public procedure RunFileSystemRemoveConformance(ctx: Context) -> i32 {
    [[log(label: "modals-log-item_begin", expected: "running")]] "running"

    let fs: $FileSystem = ctx.fs
    let build_dir_path: string@View = "build"
    let build_main_dir_path: string@View = "build/main"
    let logs_dir_path: string@View = "build/main/logs"
    let runtime_logs_dir_path: string@View = "build/main/logs/runtime"
    let build_dir_ready: bool = if fs~>create_dir(build_dir_path) is {
        _: () { true }
        _: IoError { fs~>exists(build_dir_path) }
    }
    let build_main_dir_ready: bool = if (build_dir_ready == true) {
        if fs~>create_dir(build_main_dir_path) is {
            _: () { true }
            _: IoError { fs~>exists(build_main_dir_path) }
        }
    } else {
        false
    }
    let logs_dir_ready: bool = if (build_main_dir_ready == true) {
        if fs~>create_dir(logs_dir_path) is {
            _: () { true }
            _: IoError { fs~>exists(logs_dir_path) }
        }
    } else {
        false
    }
    let runtime_logs_dir_ready: bool = if (logs_dir_ready == true) {
        if fs~>create_dir(runtime_logs_dir_path) is {
            _: () { true }
            _: IoError { fs~>exists(runtime_logs_dir_path) }
        }
    } else {
        false
    }

    let probe_path: string@View =
        "build/main/logs/runtime/fs_remove_conformance_probe.txt"
    let probe_dir_path: string@View =
        "build/main/logs/runtime/fs_remove_conformance_probe_dir"
    let missing_path: string@View =
        "build/main/logs/runtime/fs_remove_conformance_missing.txt"
    let escaped_target_path: string@View =
        "build/main/logs/fs_remove_escape.txt"
    let escape_path: string@View = "../fs_remove_escape.txt"
    let payload: bytes@View = bytes::view_string("remove-probe")

    let stale_probe_cleanup: () | IoError = fs~>remove(probe_path)
    let _ = stale_probe_cleanup
    let stale_probe_dir_cleanup: () | IoError = fs~>remove(probe_dir_path)
    let _ = stale_probe_dir_cleanup
    let stale_missing_cleanup: () | IoError = fs~>remove(missing_path)
    let _ = stale_missing_cleanup
    let stale_escaped_cleanup: () | IoError = fs~>remove(escaped_target_path)
    let _ = stale_escaped_cleanup

    let probe_created: bool = if (runtime_logs_dir_ready == true) {
        if fs~>write_file(probe_path, payload) is {
            _: () { true }
            _: IoError { false }
        }
    } else {
        false
    }
    let file_removed_ok: bool = if (probe_created == true) {
        if fs~>remove(probe_path) is {
            _: () { fs~>exists(probe_path) == false }
            _: IoError { false }
        }
    } else {
        false
    }

    let dir_created: bool = if (runtime_logs_dir_ready == true) {
        if fs~>create_dir(probe_dir_path) is {
            _: () { true }
            _: IoError { fs~>exists(probe_dir_path) }
        }
    } else {
        false
    }
    let dir_removed_ok: bool = if (dir_created == true) {
        if fs~>remove(probe_dir_path) is {
            _: () { fs~>exists(probe_dir_path) == false }
            _: IoError { false }
        }
    } else {
        false
    }

    let missing_remove_error: bool = if fs~>remove(missing_path) is {
        _: () { false }
        _: IoError { true }
    }

    let escaped_target_seeded: bool = if (logs_dir_ready == true) {
        if fs~>write_file(escaped_target_path, payload) is {
            _: () { true }
            _: IoError { false }
        }
    } else {
        false
    }
    let restricted_fs: $FileSystem = fs~>restrict(runtime_logs_dir_path)
    let restricted_escape_error: bool = if (escaped_target_seeded == true) {
        if restricted_fs~>remove(escape_path) is {
            _: () { false }
            _: IoError { true }
        }
    } else {
        false
    }
    let escaped_target_still_exists: bool = if (escaped_target_seeded == true) {
        fs~>exists(escaped_target_path)
    } else {
        false
    }

    let runtime_logs_dir_ready_log: bool =
        [[log(label: "observed-modals-fs-remove-runtime-dir-ready", expected: true)]]
        runtime_logs_dir_ready
    let file_removed_ok_log: bool =
        [[log(label: "observed-modals-fs-remove-file-removed", expected: true)]]
        file_removed_ok
    let dir_removed_ok_log: bool =
        [[log(label: "observed-modals-fs-remove-dir-removed", expected: true)]]
        dir_removed_ok
    let missing_remove_error_log: bool =
        [[log(label: "observed-modals-fs-remove-missing-errors", expected: true)]]
        missing_remove_error
    let escaped_target_seeded_log: bool =
        [[log(label: "observed-modals-fs-remove-escape-seeded", expected: true)]]
        escaped_target_seeded
    let restricted_escape_error_log: bool =
        [[log(label: "observed-modals-fs-remove-restricted-escape-error", expected: true)]]
        restricted_escape_error
    let escaped_target_still_exists_log: bool =
        [[log(label: "observed-modals-fs-remove-restricted-escape-preserved", expected: true)]]
        escaped_target_still_exists

    let metric: i32 = if (
        (runtime_logs_dir_ready_log == true) &&
        (file_removed_ok_log == true) &&
        (dir_removed_ok_log == true) &&
        (missing_remove_error_log == true) &&
        (escaped_target_seeded_log == true) &&
        (restricted_escape_error_log == true) &&
        (escaped_target_still_exists_log == true)
    ) { 7 } else { 0 }
    let metric_label: string@View = FileSystemRemoveConformanceMetricLabel(metric)
    let metric_log_actual: string@View =
        [[log(label: "observed-modals-fs-remove-metric", expected: "7")]]
        metric_label

    let cleanup_probe: () | IoError = fs~>remove(probe_path)
    let _ = cleanup_probe
    let cleanup_probe_dir: () | IoError = fs~>remove(probe_dir_path)
    let _ = cleanup_probe_dir
    let cleanup_missing: () | IoError = fs~>remove(missing_path)
    let _ = cleanup_missing
    let cleanup_escaped_target: () | IoError = fs~>remove(escaped_target_path)
    let _ = cleanup_escaped_target

    if (metric_log_actual != "7") {
        [[log(label: "modals-log-item_fail", expected: "fail")]] "fail"
        return 1
    }

    [[log(label: "modals-log-item_success", expected: "success")]] "success"
    return 0
}
