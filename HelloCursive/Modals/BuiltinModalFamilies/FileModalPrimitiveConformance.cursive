procedure FileModalPrimitiveConformanceMetricLabel(value: i32) -> string@View {
    if (value == 4) {
        return "4"
    }
    return "other"
}

public procedure RunFileModalPrimitiveConformance(ctx: Context) -> i32 {
    [[log(label: "modals-log-item_begin", expected: "running")]] "running"

    let fs: $FileSystem = ctx.fs
    let runtime_logs_dir_path: string@View = "build/main/logs/runtime"
    let probe_file_path: string@View =
        "build/main/logs/runtime/file_modal_primitive_conformance_probe.txt"
    let seed_bytes: bytes@View = bytes::view_string("alpha")
    let append_bytes: bytes@View = bytes::view_string("-beta")

    let runtime_logs_dir_ready: bool = if fs~>ensure_dir(runtime_logs_dir_path) is {
        _: () { true }
        _: IoError { false }
    }

    let stale_probe_file_cleanup: () | IoError = fs~>remove(probe_file_path)
    let _ = stale_probe_file_cleanup

    let write_ok: bool = if (runtime_logs_dir_ready == true) {
        if fs~>create_write(probe_file_path) is {
            writer: unique File@Write {
                let write_result: () | IoError = writer~>write(seed_bytes)
                let flush_result: () | IoError = writer~>flush()
                let closed: File@Closed = writer~>close()
                let _ = closed
                let write_done: bool = if write_result is {
                    _: () { true }
                    _: IoError { false }
                }
                let flush_done: bool = if flush_result is {
                    _: () { true }
                    _: IoError { false }
                }
                write_done && flush_done
            }
            _: IoError { false }
        }
    } else {
        false
    }

    let append_ok: bool = if (write_ok == true) {
        if fs~>open_append(probe_file_path) is {
            appender: unique File@Append {
                let write_result: () | IoError = appender~>write(append_bytes)
                let flush_result: () | IoError = appender~>flush()
                let closed: File@Closed = appender~>close()
                let _ = closed
                let write_done: bool = if write_result is {
                    _: () { true }
                    _: IoError { false }
                }
                let flush_done: bool = if flush_result is {
                    _: () { true }
                    _: IoError { false }
                }
                write_done && flush_done
            }
            _: IoError { false }
        }
    } else {
        false
    }

    let read_text_len: i32 = if (append_ok == true) {
        if fs~>open_read(probe_file_path) is {
            reader: unique File@Read {
                let text_result: string@Managed | IoError = reader~>read_all()
                let closed: File@Closed = reader~>close()
                let _ = closed
                if text_result is {
                    text_value: string@Managed {
                        let text_view: string@View = string::as_view(text_value)
                        string::length(text_view) as i32
                    }
                    _: IoError { 0 }
                }
            }
            _: IoError { 0 }
        }
    } else {
        0
    }

    let read_bytes_len: i32 = if (append_ok == true) {
        if fs~>open_read(probe_file_path) is {
            reader: unique File@Read {
                let bytes_result: bytes@Managed | IoError = reader~>read_all_bytes()
                let closed: File@Closed = reader~>close()
                let _ = closed
                if bytes_result is {
                    bytes_value: bytes@Managed {
                        let bytes_view: bytes@View = bytes::as_view(bytes_value)
                        bytes::length(bytes_view) as i32
                    }
                    _: IoError { 0 }
                }
            }
            _: IoError { 0 }
        }
    } else {
        0
    }

    let write_ok_log: bool =
        [[log(label: "observed-modals-file-primitive-write", expected: true)]]
        write_ok
    let append_ok_log: bool =
        [[log(label: "observed-modals-file-primitive-append", expected: true)]]
        append_ok
    let read_text_len_log: i32 =
        [[log(label: "observed-modals-file-primitive-read-text-len", expected: 10)]]
        read_text_len
    let read_bytes_len_log: i32 =
        [[log(label: "observed-modals-file-primitive-read-bytes-len", expected: 10)]]
        read_bytes_len

    let metric: i32 = if (
        (write_ok_log == true) &&
        (append_ok_log == true) &&
        (read_text_len_log == 10) &&
        (read_bytes_len_log == 10)
    ) { 4 } else { 0 }
    let metric_label: string@View = FileModalPrimitiveConformanceMetricLabel(metric)
    let metric_log_actual: string@View =
        [[log(label: "observed-modals-file-primitive-metric", expected: "4")]]
        metric_label

    let cleanup_probe_file: () | IoError = fs~>remove(probe_file_path)
    let _ = cleanup_probe_file

    if (metric_log_actual != "4") {
        [[log(label: "modals-log-item_fail", expected: "fail")]] "fail"
        return 1
    }

    [[log(label: "modals-log-item_success", expected: "success")]] "success"
    return 0
}
