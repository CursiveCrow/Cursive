procedure FileSystemReadFileConformanceMetricLabel(value: i32) -> string@View {
    if (value == 13) {
        return "13"
    }
    return "other"
}

public procedure RunFileSystemReadFileConformance(ctx: Context) -> i32 {
    [[log(label: "modals-log-item_begin", expected: "running")]] "running"

    let fs: $FileSystem = ctx.fs
    let build_dir_path: string@View = "build"
    let build_main_dir_path: string@View = "build/main"
    let logs_dir_path: string@View = "build/main/logs"
    let runtime_logs_dir_path: string@View = "build/main/logs/runtime"
    let build_dir_ready: bool = if fs~>create_dir(build_dir_path) is {
        _: () { true }
        _: IoError { fs~>exists(build_dir_path) }
    }
    let build_main_dir_ready: bool = if (build_dir_ready == true) {
        if fs~>create_dir(build_main_dir_path) is {
            _: () { true }
            _: IoError { fs~>exists(build_main_dir_path) }
        }
    } else {
        false
    }
    let logs_dir_ready: bool = if (build_main_dir_ready == true) {
        if fs~>create_dir(logs_dir_path) is {
            _: () { true }
            _: IoError { fs~>exists(logs_dir_path) }
        }
    } else {
        false
    }
    let runtime_logs_dir_ready: bool = if (logs_dir_ready == true) {
        if fs~>create_dir(runtime_logs_dir_path) is {
            _: () { true }
            _: IoError { fs~>exists(runtime_logs_dir_path) }
        }
    } else {
        false
    }

    let probe_path: string@View =
        "build/main/logs/runtime/fs_read_file_conformance_probe.txt"
    let missing_path: string@View =
        "build/main/logs/runtime/fs_read_file_conformance_missing.txt"
    let payload_text: string@View = "read-file-text"
    let payload_bytes: bytes@View = bytes::view_string(payload_text)
    let expected_length: i32 = string::length(payload_text) as i32

    let stale_probe_cleanup: () | IoError = fs~>remove(probe_path)
    let _ = stale_probe_cleanup
    let stale_missing_cleanup: () | IoError = fs~>remove(missing_path)
    let _ = stale_missing_cleanup

    let seed_ready: bool = if (runtime_logs_dir_ready == true) {
        if fs~>create_write(probe_path) is {
            writer: unique File@Write {
                let write_result: () | IoError = writer~>write(payload_bytes)
                let flush_result: () | IoError = writer~>flush()
                let closed_writer: File@Closed = writer~>close()
                let _ = closed_writer
                let write_ok: bool = if write_result is {
                    _: () { true }
                    _: IoError { false }
                }
                let flush_ok: bool = if flush_result is {
                    _: () { true }
                    _: IoError { false }
                }
                write_ok && flush_ok
            }
            _: IoError { false }
        }
    } else {
        false
    }

    let read_file_length: i32 = if (seed_ready == true) {
        if fs~>read_file(probe_path) is {
            read_text: string@Managed {
                let read_view: string@View = string::as_view(read_text)
                string::length(read_view) as i32
            }
            _: IoError { 0 }
        }
    } else {
        0
    }

    let read_file_exact_text: bool = if (seed_ready == true) {
        if fs~>read_file(probe_path) is {
            read_text: string@Managed {
                let read_view: string@View = string::as_view(read_text)
                let read_bytes: bytes@View = bytes::view_string(read_view)
                let read_slice = bytes::as_slice(read_bytes)
                let read_length_ok: bool = bytes::length(read_bytes) == 14usize
                if (read_length_ok == true) {
                    let first_ok: bool = read_slice[0] == 114u8
                    let second_ok: bool = read_slice[1] == 101u8
                    let dash_ok: bool = read_slice[4] == 45u8
                    let last_ok: bool = read_slice[13] == 116u8
                    first_ok && second_ok && dash_ok && last_ok
                } else {
                    false
                }
            }
            _: IoError { false }
        }
    } else {
        false
    }

    let read_file_missing_error: bool = if fs~>read_file(missing_path) is {
        _: string@Managed { false }
        _: IoError { true }
    }

    let runtime_logs_dir_ready_log: bool =
        [[log(label: "observed-modals-fs-read-file-runtime-dir-ready", expected: true)]]
        runtime_logs_dir_ready
    let seed_ready_log: bool =
        [[log(label: "observed-modals-fs-read-file-seed-ready", expected: true)]]
        seed_ready
    let read_file_length_log: i32 =
        [[log(label: "observed-modals-fs-read-file-text-length", expected: 14)]]
        read_file_length
    let read_file_exact_text_log: bool =
        [[log(label: "observed-modals-fs-read-file-exact-text", expected: true)]]
        read_file_exact_text
    let read_file_missing_error_log: bool =
        [[log(label: "observed-modals-fs-read-file-missing-error", expected: true)]]
        read_file_missing_error

    let metric: i32 = if (
        (runtime_logs_dir_ready_log == true) &&
        (seed_ready_log == true) &&
        (read_file_length_log == expected_length) &&
        (read_file_exact_text_log == true) &&
        (read_file_missing_error_log == true)
    ) { 13 } else { 0 }
    let metric_label: string@View = FileSystemReadFileConformanceMetricLabel(metric)
    let metric_log_actual: string@View =
        [[log(label: "observed-modals-fs-read-file-metric", expected: "13")]]
        metric_label

    let cleanup_probe: () | IoError = fs~>remove(probe_path)
    let _ = cleanup_probe

    if (metric_log_actual != "13") {
        [[log(label: "modals-log-item_fail", expected: "fail")]] "fail"
        return 1
    }

    [[log(label: "modals-log-item_success", expected: "success")]] "success"
    return 0
}
