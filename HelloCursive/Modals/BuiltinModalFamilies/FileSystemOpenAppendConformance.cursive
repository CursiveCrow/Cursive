procedure FileSystemOpenAppendConformanceMetricLabel(value: i32) -> string@View {
    if (value == 9) {
        return "9"
    }
    return "other"
}

public procedure RunFileSystemOpenAppendConformance(ctx: Context) -> i32 {
    "running"

    let fs: $FileSystem = ctx.fs
    let build_dir_path: string@View = "build"
    let build_main_dir_path: string@View = "build/main"
    let logs_dir_path: string@View = "build/main/logs"
    let runtime_logs_dir_path: string@View = "build/main/logs/runtime"
    let build_dir_ready: bool = if fs~>create_dir(build_dir_path) is {
        _: () { true }
        _: IoError { fs~>exists(build_dir_path) }
    }
    let build_main_dir_ready: bool = if (build_dir_ready == true) {
        if fs~>create_dir(build_main_dir_path) is {
            _: () { true }
            _: IoError { fs~>exists(build_main_dir_path) }
        }
    } else {
        false
    }
    let logs_dir_ready: bool = if (build_main_dir_ready == true) {
        if fs~>create_dir(logs_dir_path) is {
            _: () { true }
            _: IoError { fs~>exists(logs_dir_path) }
        }
    } else {
        false
    }
    let runtime_logs_dir_ready: bool = if (logs_dir_ready == true) {
        if fs~>create_dir(runtime_logs_dir_path) is {
            _: () { true }
            _: IoError { fs~>exists(runtime_logs_dir_path) }
        }
    } else {
        false
    }

    let probe_path: string@View =
        "build/main/logs/runtime/fs_open_append_conformance_probe.txt"
    let missing_path: string@View =
        "build/main/logs/runtime/fs_open_append_conformance_missing.txt"
    let initial_text: string@View = "alpha"
    let append_text: string@View = "-beta"
    let initial_bytes: bytes@View = bytes::view_string(initial_text)
    let append_bytes: bytes@View = bytes::view_string(append_text)

    let stale_probe_cleanup: () | IoError = fs~>remove(probe_path)
    let _ = stale_probe_cleanup
    let stale_missing_cleanup: () | IoError = fs~>remove(missing_path)
    let _ = stale_missing_cleanup

    let seed_ready: bool = if (runtime_logs_dir_ready == true) {
        if fs~>create_write(probe_path) is {
            writer: unique File@Write {
                let write_result: () | IoError = writer~>write(initial_bytes)
                let flush_result: () | IoError = writer~>flush()
                let closed_writer: File@Closed = writer~>close()
                let _ = closed_writer
                let write_ok: bool = if write_result is {
                    _: () { true }
                    _: IoError { false }
                }
                let flush_ok: bool = if flush_result is {
                    _: () { true }
                    _: IoError { false }
                }
                write_ok && flush_ok
            }
            _: IoError { false }
        }
    } else {
        false
    }

    let append_ready: bool = if (seed_ready == true) {
        if fs~>open_append(probe_path) is {
            appender: unique File@Append {
                let write_result: () | IoError = appender~>write(append_bytes)
                let flush_result: () | IoError = appender~>flush()
                let closed_appender: File@Closed = appender~>close()
                let _ = closed_appender
                let write_ok: bool = if write_result is {
                    _: () { true }
                    _: IoError { false }
                }
                let flush_ok: bool = if flush_result is {
                    _: () { true }
                    _: IoError { false }
                }
                write_ok && flush_ok
            }
            _: IoError { false }
        }
    } else {
        false
    }

    let open_append_missing_error: bool = if fs~>open_append(missing_path) is {
        _: unique File@Append { false }
        _: IoError { true }
    }

    let open_append_length: i32 = if (append_ready == true) {
        if fs~>open_read(probe_path) is {
            reader: unique File@Read {
                let read_result: bytes@Managed | IoError = reader~>read_all_bytes()
                let closed_reader: File@Closed = reader~>close()
                let _ = closed_reader
                if read_result is {
                    read_bytes: unique bytes@Managed {
                        let read_view: bytes@View = bytes::as_view(read_bytes)
                        bytes::length(read_view) as i32
                    }
                    _: IoError { 0 }
                }
            }
            _: IoError { 0 }
        }
    } else {
        0
    }

    let open_append_exact_text: bool = if (append_ready == true) {
        if fs~>open_read(probe_path) is {
            reader: unique File@Read {
                let read_result: bytes@Managed | IoError = reader~>read_all_bytes()
                let closed_reader: File@Closed = reader~>close()
                let _ = closed_reader
                if read_result is {
                    read_bytes: unique bytes@Managed {
                        let read_view: bytes@View = bytes::as_view(read_bytes)
                        let read_slice = bytes::as_slice(read_view)
                        let read_length_ok: bool = bytes::length(read_view) == 10usize
                        if (read_length_ok == true) {
                            (read_slice[0] == 97u8) &&
                            (read_slice[1] == 108u8) &&
                            (read_slice[2] == 112u8) &&
                            (read_slice[3] == 104u8) &&
                            (read_slice[4] == 97u8) &&
                            (read_slice[5] == 45u8) &&
                            (read_slice[6] == 98u8) &&
                            (read_slice[7] == 101u8) &&
                            (read_slice[8] == 116u8) &&
                            (read_slice[9] == 97u8)
                        } else {
                            false
                        }
                    }
                    _: IoError { false }
                }
            }
            _: IoError { false }
        }
    } else {
        false
    }

    let runtime_logs_dir_ready_log: bool =
        runtime_logs_dir_ready
    let seed_ready_log: bool =
        seed_ready
    let append_ready_log: bool =
        append_ready
    let open_append_length_log: i32 =
        open_append_length
    let open_append_exact_text_log: bool =
        open_append_exact_text
    let open_append_missing_error_log: bool =
        open_append_missing_error

    let metric: i32 = if (
        (runtime_logs_dir_ready_log == true) &&
        (seed_ready_log == true) &&
        (append_ready_log == true) &&
        (open_append_length_log == 10) &&
        (open_append_exact_text_log == true) &&
        (open_append_missing_error_log == true)
    ) { 9 } else { 0 }
    let metric_label: string@View = FileSystemOpenAppendConformanceMetricLabel(metric)
    let metric_log_actual: string@View =
        metric_label

    let cleanup_probe: () | IoError = fs~>remove(probe_path)
    let _ = cleanup_probe

    if (metric_log_actual != "9") {
        "fail"
        return 1
    }

    "success"
    return 0
}
