procedure FileSystemRestrictConformanceMetricLabel(value: i32) -> string@View {
    if (value == 5) {
        return "5"
    }
    return "other"
}

public procedure RunFileSystemRestrictConformance(ctx: Context) -> i32 {
    [[log(label: "modals-log-item_begin", expected: "running")]] "running"

    let fs: $FileSystem = ctx.fs
    let runtime_logs_dir_path: string@View = "build/main/logs/runtime"
    let probe_root_path: string@View =
        "build/main/logs/runtime/fs_restrict_conformance_probe"
    let probe_nested_path: string@View =
        "build/main/logs/runtime/fs_restrict_conformance_probe/nested"
    let probe_nested_file_path: string@View =
        "build/main/logs/runtime/fs_restrict_conformance_probe/nested/probe.txt"
    let probe_sibling_file_path: string@View =
        "build/main/logs/runtime/fs_restrict_conformance_probe/sibling.txt"
    let payload: bytes@View = bytes::view_string("fs-restrict-probe")

    let runtime_logs_dir_ready: bool = if fs~>ensure_dir(runtime_logs_dir_path) is {
        _: () { true }
        _: IoError { false }
    }

    let stale_probe_nested_file_cleanup: () | IoError = fs~>remove(probe_nested_file_path)
    let _ = stale_probe_nested_file_cleanup
    let stale_probe_sibling_file_cleanup: () | IoError = fs~>remove(probe_sibling_file_path)
    let _ = stale_probe_sibling_file_cleanup
    let stale_probe_nested_cleanup: () | IoError = fs~>remove(probe_nested_path)
    let _ = stale_probe_nested_cleanup
    let stale_probe_root_cleanup: () | IoError = fs~>remove(probe_root_path)
    let _ = stale_probe_root_cleanup

    let probe_root_ready: bool = if (runtime_logs_dir_ready == true) {
        if fs~>ensure_dir(probe_nested_path) is {
            _: () { true }
            _: IoError { false }
        }
    } else {
        false
    }

    let seeded_nested_file: bool = if (probe_root_ready == true) {
        if fs~>write_file(probe_nested_file_path, payload) is {
            _: () { true }
            _: IoError { false }
        }
    } else {
        false
    }

    let seeded_sibling_file: bool = if (seeded_nested_file == true) {
        if fs~>write_file(probe_sibling_file_path, payload) is {
            _: () { true }
            _: IoError { false }
        }
    } else {
        false
    }

    let restricted_fs: $FileSystem = fs~>restrict(probe_root_path)
    let nested_fs: $FileSystem = restricted_fs~>restrict("nested")

    let parent_can_see_nested: bool = if (seeded_sibling_file == true) {
        restricted_fs~>exists("nested/probe.txt")
    } else {
        false
    }
    let child_can_see_probe: bool = if (seeded_sibling_file == true) {
        nested_fs~>exists("probe.txt")
    } else {
        false
    }
    let child_escape_blocked: bool = if (seeded_sibling_file == true) {
        nested_fs~>exists("../sibling.txt") == false
    } else {
        false
    }
    let parent_still_usable: bool = if (seeded_sibling_file == true) {
        restricted_fs~>exists("sibling.txt")
    } else {
        false
    }
    let ambient_still_usable: bool = fs~>exists(probe_root_path)

    let parent_can_see_nested_log: bool =
        [[log(label: "observed-modals-fs-restrict-parent-can-see-nested", expected: true)]]
        parent_can_see_nested
    let child_can_see_probe_log: bool =
        [[log(label: "observed-modals-fs-restrict-child-can-see-probe", expected: true)]]
        child_can_see_probe
    let child_escape_blocked_log: bool =
        [[log(label: "observed-modals-fs-restrict-child-escape-blocked", expected: true)]]
        child_escape_blocked
    let parent_still_usable_log: bool =
        [[log(label: "observed-modals-fs-restrict-parent-still-usable", expected: true)]]
        parent_still_usable
    let ambient_still_usable_log: bool =
        [[log(label: "observed-modals-fs-restrict-ambient-still-usable", expected: true)]]
        ambient_still_usable

    let metric: i32 = if (
        (parent_can_see_nested_log == true) &&
        (child_can_see_probe_log == true) &&
        (child_escape_blocked_log == true) &&
        (parent_still_usable_log == true) &&
        (ambient_still_usable_log == true)
    ) { 5 } else { 0 }
    let metric_label: string@View = FileSystemRestrictConformanceMetricLabel(metric)
    let metric_log_actual: string@View =
        [[log(label: "observed-modals-fs-restrict-metric", expected: "5")]]
        metric_label

    let cleanup_probe_nested_file: () | IoError = fs~>remove(probe_nested_file_path)
    let _ = cleanup_probe_nested_file
    let cleanup_probe_sibling_file: () | IoError = fs~>remove(probe_sibling_file_path)
    let _ = cleanup_probe_sibling_file
    let cleanup_probe_nested: () | IoError = fs~>remove(probe_nested_path)
    let _ = cleanup_probe_nested
    let cleanup_probe_root: () | IoError = fs~>remove(probe_root_path)
    let _ = cleanup_probe_root

    if (metric_log_actual != "5") {
        [[log(label: "modals-log-item_fail", expected: "fail")]] "fail"
        return 1
    }

    [[log(label: "modals-log-item_success", expected: "success")]] "success"
    return 0
}
