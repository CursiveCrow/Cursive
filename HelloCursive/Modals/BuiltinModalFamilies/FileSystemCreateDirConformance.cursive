procedure FileSystemCreateDirConformanceMetricLabel(value: i32) -> string@View {
    if (value == 4) {
        return "4"
    }
    return "other"
}

public procedure RunFileSystemCreateDirConformance(ctx: Context) -> i32 {
    [[log(label: "modals-log-item_begin", expected: "running")]] "running"

    let fs: $FileSystem = ctx.fs
    let build_dir_path: string@View = "build"
    let build_main_dir_path: string@View = "build/main"
    let logs_dir_path: string@View = "build/main/logs"
    let runtime_logs_dir_path: string@View = "build/main/logs/runtime"
    let build_dir_ready: bool = if fs~>create_dir(build_dir_path) is {
        _: () { true }
        _: IoError { fs~>exists(build_dir_path) }
    }
    let build_main_dir_ready: bool = if (build_dir_ready == true) {
        if fs~>create_dir(build_main_dir_path) is {
            _: () { true }
            _: IoError { fs~>exists(build_main_dir_path) }
        }
    } else {
        false
    }
    let logs_dir_ready: bool = if (build_main_dir_ready == true) {
        if fs~>create_dir(logs_dir_path) is {
            _: () { true }
            _: IoError { fs~>exists(logs_dir_path) }
        }
    } else {
        false
    }
    let runtime_logs_dir_ready: bool = if (logs_dir_ready == true) {
        if fs~>create_dir(runtime_logs_dir_path) is {
            _: () { true }
            _: IoError { fs~>exists(runtime_logs_dir_path) }
        }
    } else {
        false
    }

    let probe_dir_path: string@View =
        "build/main/logs/runtime/fs_create_dir_conformance_probe_dir"
    let stale_probe_dir_cleanup: () | IoError = fs~>remove(probe_dir_path)
    let _ = stale_probe_dir_cleanup

    let create_dir_ok: bool = if (runtime_logs_dir_ready == true) {
        if fs~>create_dir(probe_dir_path) is {
            _: () { true }
            _: IoError { false }
        }
    } else {
        false
    }

    let exists_after_create: bool = if (create_dir_ok == true) {
        fs~>exists(probe_dir_path)
    } else {
        false
    }

    let open_dir_empty_ok: bool = if (exists_after_create == true) {
        if fs~>open_dir(probe_dir_path) is {
            iter: unique DirIter@Open {
                let first_result: DirEntry | () | IoError = iter~>next()
                let closed_iter: DirIter@Closed = iter~>close()
                let _ = closed_iter
                if first_result is {
                    _: DirEntry { false }
                    _: () { true }
                    _: IoError { false }
                }
            }
            _: IoError { false }
        }
    } else {
        false
    }

    let runtime_logs_dir_ready_log: bool =
        [[log(label: "observed-modals-fs-create-dir-runtime-dir-ready", expected: true)]]
        runtime_logs_dir_ready
    let create_dir_ok_log: bool =
        [[log(label: "observed-modals-fs-create-dir-success", expected: true)]]
        create_dir_ok
    let exists_after_create_log: bool =
        [[log(label: "observed-modals-fs-create-dir-exists-after", expected: true)]]
        exists_after_create
    let open_dir_empty_ok_log: bool =
        [[log(label: "observed-modals-fs-create-dir-open-empty", expected: true)]]
        open_dir_empty_ok

    let metric: i32 = if (
        (runtime_logs_dir_ready_log == true) &&
        (create_dir_ok_log == true) &&
        (exists_after_create_log == true) &&
        (open_dir_empty_ok_log == true)
    ) { 4 } else { 0 }
    let metric_label: string@View = FileSystemCreateDirConformanceMetricLabel(metric)
    let metric_log_actual: string@View =
        [[log(label: "observed-modals-fs-create-dir-metric", expected: "4")]]
        metric_label

    let cleanup_probe_dir: () | IoError = fs~>remove(probe_dir_path)
    let _ = cleanup_probe_dir

    if (metric_log_actual != "4") {
        [[log(label: "modals-log-item_fail", expected: "fail")]] "fail"
        return 1
    }

    [[log(label: "modals-log-item_success", expected: "success")]] "success"
    return 0
}
