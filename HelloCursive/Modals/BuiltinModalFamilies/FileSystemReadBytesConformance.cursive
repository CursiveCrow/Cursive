procedure FileSystemReadBytesConformanceMetricLabel(value: i32) -> string@View {
    if (value == 4) {
        return "4"
    }
    return "other"
}

public procedure RunFileSystemReadBytesConformance(ctx: Context) -> i32 {
    [[log(label: "modals-log-item_begin", expected: "running")]] "running"

    let fs: $FileSystem = ctx.fs
    let build_dir_path: string@View = "build"
    let build_main_dir_path: string@View = "build/main"
    let logs_dir_path: string@View = "build/main/logs"
    let runtime_logs_dir_path: string@View = "build/main/logs/runtime"
    let build_dir_ready: bool = if fs~>create_dir(build_dir_path) is {
        _: () { true }
        _: IoError { fs~>exists(build_dir_path) }
    }
    let build_main_dir_ready: bool = if (build_dir_ready == true) {
        if fs~>create_dir(build_main_dir_path) is {
            _: () { true }
            _: IoError { fs~>exists(build_main_dir_path) }
        }
    } else {
        false
    }
    let logs_dir_ready: bool = if (build_main_dir_ready == true) {
        if fs~>create_dir(logs_dir_path) is {
            _: () { true }
            _: IoError { fs~>exists(logs_dir_path) }
        }
    } else {
        false
    }
    let runtime_logs_dir_ready: bool = if (logs_dir_ready == true) {
        if fs~>create_dir(runtime_logs_dir_path) is {
            _: () { true }
            _: IoError { fs~>exists(runtime_logs_dir_path) }
        }
    } else {
        false
    }

    let probe_path: string@View =
        "build/main/logs/runtime/fs_read_bytes_conformance_probe.bin"
    let missing_path: string@View =
        "build/main/logs/runtime/fs_read_bytes_conformance_missing.bin"
    let payload_seed: [u8; 4] = [0u8, 255u8, 254u8, 10u8]
    let payload_slice: [u8] = payload_seed
    let payload_bytes: bytes@View = bytes::view(payload_slice)
    let payload_length: i32 = bytes::length(payload_bytes) as i32

    let stale_probe_cleanup: () | IoError = fs~>remove(probe_path)
    let _ = stale_probe_cleanup
    let stale_missing_cleanup: () | IoError = fs~>remove(missing_path)
    let _ = stale_missing_cleanup

    let seed_ready: bool = if (runtime_logs_dir_ready == true) {
        if fs~>create_write(probe_path) is {
            writer: unique File@Write {
                let write_result: () | IoError = writer~>write(payload_bytes)
                let flush_result: () | IoError = writer~>flush()
                let closed_writer: File@Closed = writer~>close()
                let _ = closed_writer
                let write_ok: bool = if write_result is {
                    _: () { true }
                    _: IoError { false }
                }
                let flush_ok: bool = if flush_result is {
                    _: () { true }
                    _: IoError { false }
                }
                write_ok && flush_ok
            }
            _: IoError { false }
        }
    } else {
        false
    }

    let read_bytes_length: i32 = if (seed_ready == true) {
        if fs~>read_bytes(probe_path) is {
            read_bytes: unique bytes@Managed {
                let read_view: bytes@View = bytes::as_view(read_bytes)
                bytes::length(read_view) as i32
            }
            _: IoError { 0 }
        }
    } else {
        0
    }

    let read_bytes_exact_payload: bool = if (seed_ready == true) {
        if fs~>read_bytes(probe_path) is {
            read_bytes: unique bytes@Managed {
                let read_view: bytes@View = bytes::as_view(read_bytes)
                let read_slice = bytes::as_slice(read_view)
                let read_length_ok: bool = bytes::length(read_view) == 4usize
                if (read_length_ok == true) {
                    (read_slice[0] == 0u8) &&
                    (read_slice[1] == 255u8) &&
                    (read_slice[2] == 254u8) &&
                    (read_slice[3] == 10u8)
                } else {
                    false
                }
            }
            _: IoError { false }
        }
    } else {
        false
    }

    let read_bytes_missing_error: bool = if fs~>read_bytes(missing_path) is {
        _: unique bytes@Managed { false }
        _: IoError { true }
    }

    let runtime_logs_dir_ready_log: bool =
        [[log(label: "observed-modals-fs-read-bytes-runtime-dir-ready", expected: true)]]
        runtime_logs_dir_ready
    let seed_ready_log: bool =
        [[log(label: "observed-modals-fs-read-bytes-seed-ready", expected: true)]]
        seed_ready
    let read_bytes_length_log: i32 =
        [[log(label: "observed-modals-fs-read-bytes-length", expected: 4)]]
        read_bytes_length
    let read_bytes_exact_payload_log: bool =
        [[log(label: "observed-modals-fs-read-bytes-exact-payload", expected: true)]]
        read_bytes_exact_payload
    let read_bytes_missing_error_log: bool =
        [[log(label: "observed-modals-fs-read-bytes-missing-error", expected: true)]]
        read_bytes_missing_error

    let metric: i32 = if (
        (runtime_logs_dir_ready_log == true) &&
        (seed_ready_log == true) &&
        (read_bytes_length_log == payload_length) &&
        (read_bytes_exact_payload_log == true) &&
        (read_bytes_missing_error_log == true)
    ) { 4 } else { 0 }
    let metric_label: string@View = FileSystemReadBytesConformanceMetricLabel(metric)
    let metric_log_actual: string@View =
        [[log(label: "observed-modals-fs-read-bytes-metric", expected: "4")]]
        metric_label

    let cleanup_probe: () | IoError = fs~>remove(probe_path)
    let _ = cleanup_probe

    if (metric_log_actual != "4") {
        [[log(label: "modals-log-item_fail", expected: "fail")]] "fail"
        return 1
    }

    [[log(label: "modals-log-item_success", expected: "success")]] "success"
    return 0
}
