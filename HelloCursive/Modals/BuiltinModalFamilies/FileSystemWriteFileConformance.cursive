procedure FileSystemWriteFileConformanceMetricLabel(value: i32) -> string@View {
    if (value == 6) {
        return "6"
    }
    return "other"
}

public procedure RunFileSystemWriteFileConformance(ctx: Context) -> i32 {
    [[log(label: "modals-log-item_begin", expected: "running")]] "running"

    let fs: $FileSystem = ctx.fs
    let build_dir_path: string@View = "build"
    let build_main_dir_path: string@View = "build/main"
    let logs_dir_path: string@View = "build/main/logs"
    let runtime_logs_dir_path: string@View = "build/main/logs/runtime"
    let build_dir_ready: bool = if fs~>create_dir(build_dir_path) is {
        _: () { true }
        _: IoError { fs~>exists(build_dir_path) }
    }
    let build_main_dir_ready: bool = if (build_dir_ready == true) {
        if fs~>create_dir(build_main_dir_path) is {
            _: () { true }
            _: IoError { fs~>exists(build_main_dir_path) }
        }
    } else {
        false
    }
    let logs_dir_ready: bool = if (build_main_dir_ready == true) {
        if fs~>create_dir(logs_dir_path) is {
            _: () { true }
            _: IoError { fs~>exists(logs_dir_path) }
        }
    } else {
        false
    }
    let runtime_logs_dir_ready: bool = if (logs_dir_ready == true) {
        if fs~>create_dir(runtime_logs_dir_path) is {
            _: () { true }
            _: IoError { fs~>exists(runtime_logs_dir_path) }
        }
    } else {
        false
    }

    let probe_path: string@View =
        "build/main/logs/runtime/fs_write_file_conformance_probe.bin"
    let escaped_target_path: string@View =
        "build/main/logs/fs_write_file_escape.bin"
    let escape_path: string@View = "../fs_write_file_escape.bin"
    let initial_text: string@View = "abcdef"
    let overwrite_text: string@View = "xy"
    let initial_bytes: bytes@View = bytes::view_string(initial_text)
    let overwrite_bytes: bytes@View = bytes::view_string(overwrite_text)

    let stale_probe_cleanup: () | IoError = fs~>remove(probe_path)
    let _ = stale_probe_cleanup
    let stale_escaped_cleanup: () | IoError = fs~>remove(escaped_target_path)
    let _ = stale_escaped_cleanup

    let write_initial_ok: bool = if (runtime_logs_dir_ready == true) {
        if fs~>write_file(probe_path, initial_bytes) is {
            _: () { true }
            _: IoError { false }
        }
    } else {
        false
    }

    let overwrite_ok: bool = if (write_initial_ok == true) {
        if fs~>write_file(probe_path, overwrite_bytes) is {
            _: () { true }
            _: IoError { false }
        }
    } else {
        false
    }

    let read_back_length: i32 = if (overwrite_ok == true) {
        if fs~>read_bytes(probe_path) is {
            read_bytes: unique bytes@Managed {
                let read_view: bytes@View = bytes::as_view(read_bytes)
                bytes::length(read_view) as i32
            }
            _: IoError { 0 }
        }
    } else {
        0
    }

    let read_back_exact_payload: bool = if (overwrite_ok == true) {
        if fs~>read_bytes(probe_path) is {
            read_bytes: unique bytes@Managed {
                let read_view: bytes@View = bytes::as_view(read_bytes)
                let read_slice = bytes::as_slice(read_view)
                let read_length_ok: bool = bytes::length(read_view) == 2usize
                if (read_length_ok == true) {
                    (read_slice[0] == 120u8) && (read_slice[1] == 121u8)
                } else {
                    false
                }
            }
            _: IoError { false }
        }
    } else {
        false
    }

    let restricted_fs: $FileSystem = fs~>restrict(runtime_logs_dir_path)
    let restricted_escape_error: bool = if restricted_fs~>write_file(escape_path, initial_bytes) is {
        _: () { false }
        _: IoError { true }
    }
    let escaped_target_missing: bool = fs~>exists(escaped_target_path) == false

    let runtime_logs_dir_ready_log: bool =
        [[log(label: "observed-modals-fs-write-file-runtime-dir-ready", expected: true)]]
        runtime_logs_dir_ready
    let write_initial_ok_log: bool =
        [[log(label: "observed-modals-fs-write-file-initial-write", expected: true)]]
        write_initial_ok
    let overwrite_ok_log: bool =
        [[log(label: "observed-modals-fs-write-file-overwrite", expected: true)]]
        overwrite_ok
    let read_back_length_log: i32 =
        [[log(label: "observed-modals-fs-write-file-read-length", expected: 2)]]
        read_back_length
    let read_back_exact_payload_log: bool =
        [[log(label: "observed-modals-fs-write-file-read-exact-payload", expected: true)]]
        read_back_exact_payload
    let restricted_escape_error_log: bool =
        [[log(label: "observed-modals-fs-write-file-restricted-escape-error", expected: true)]]
        restricted_escape_error
    let escaped_target_missing_log: bool =
        [[log(label: "observed-modals-fs-write-file-restricted-escape-no-file", expected: true)]]
        escaped_target_missing

    let metric: i32 = if (
        (runtime_logs_dir_ready_log == true) &&
        (write_initial_ok_log == true) &&
        (overwrite_ok_log == true) &&
        (read_back_length_log == 2) &&
        (read_back_exact_payload_log == true) &&
        (restricted_escape_error_log == true) &&
        (escaped_target_missing_log == true)
    ) { 6 } else { 0 }
    let metric_label: string@View = FileSystemWriteFileConformanceMetricLabel(metric)
    let metric_log_actual: string@View =
        [[log(label: "observed-modals-fs-write-file-metric", expected: "6")]]
        metric_label

    let cleanup_probe: () | IoError = fs~>remove(probe_path)
    let _ = cleanup_probe
    let cleanup_escaped_target: () | IoError = fs~>remove(escaped_target_path)
    let _ = cleanup_escaped_target

    if (metric_log_actual != "6") {
        [[log(label: "modals-log-item_fail", expected: "fail")]] "fail"
        return 1
    }

    [[log(label: "modals-log-item_success", expected: "success")]] "success"
    return 0
}
