modal BuiltinLiteralRestrictionCustomProbe {
    @Only {
        value: i32
    }
}

procedure BuiltinModalLiteralRestrictionsMetricLabel(value: i32) -> string@View {
    if (value == 9) {
        return "9"
    }
    return "other"
}

public procedure RunBuiltinModalLiteralRestrictions(ctx: Context) -> i32 {
    let _ = ctx
    [[log(label: "modals-log-item_begin", expected: "running")]] "running"

    let custom_state: BuiltinLiteralRestrictionCustomProbe@Only =
        BuiltinLiteralRestrictionCustomProbe@Only { value: 3 }
    let custom_general: BuiltinLiteralRestrictionCustomProbe = widen(custom_state)
    let custom_metric: i32 = if custom_general is {
        @Only { value: value } { value }
    }

    let token = CancelToken::new()
    let token_metric: bool = token~>is_cancelled() == false

    let custom_metric_log: i32 =
        [[log(label: "observed-modals-builtin-literal-custom", expected: 3)]]
        custom_metric
    let token_metric_log: bool =
        [[log(label: "observed-modals-builtin-literal-token-constructor", expected: true)]]
        token_metric

    let forbidden_literal_diag: string@View = "E-TYP-2073"
    let forbidden_literal_diag_log: string@View =
        [[log(label: "modals-builtin-literal-restriction-diagnostic", expected: "E-TYP-2073")]]
        forbidden_literal_diag

    let mod_009: string@View = "MOD-009"
    let mod_009_log: string@View =
        [[log(label: "modals-builtin-literal-restriction-feature-009", expected: "MOD-009")]]
        mod_009

    let runtime_ok: bool =
        (custom_metric_log == 3) &&
        (token_metric_log == true) &&
        (forbidden_literal_diag_log == "E-TYP-2073") &&
        (mod_009_log == "MOD-009")
    let runtime_ok_log: bool =
        [[log(label: "modals-builtin-literal-restriction-runtime", expected: true)]]
        runtime_ok

    let metric: i32 = if (runtime_ok_log == true) { 9 } else { 0 }
    let metric_label: string@View = BuiltinModalLiteralRestrictionsMetricLabel(metric)
    let metric_log_actual: string@View =
        [[log(label: "observed-modals-builtin-literal-restrictions-metric", expected: "9")]]
        metric_label
    if (metric_log_actual != "9") {
        [[log(label: "modals-log-item_fail", expected: "fail")]] "fail"
        return 1
    }

    [[log(label: "modals-log-item_success", expected: "success")]] "success"
    return 0
}
