procedure FileSystemWriteStdoutConformanceMetricLabel(value: i32) -> string@View {
    if (value == 2) {
        return "2"
    }
    return "other"
}

public procedure RunFileSystemWriteStdoutConformance(ctx: Context) -> i32 {
    "running"

    let fs: $FileSystem = ctx.fs
    let stdout_marker: string@View = "modals-fs-write-stdout-sentinel\n"
    let write_stdout_ok: bool = if fs~>write_stdout(stdout_marker) is {
        _: () { true }
        _: IoError { false }
    }
    let write_stdout_empty_ok: bool = if fs~>write_stdout("") is {
        _: () { true }
        _: IoError { false }
    }

    let write_stdout_ok_log: bool =
        write_stdout_ok
    let write_stdout_empty_ok_log: bool =
        write_stdout_empty_ok

    let metric: i32 = if (
        (write_stdout_ok_log == true) &&
        (write_stdout_empty_ok_log == true)
    ) { 2 } else { 0 }
    let metric_label: string@View = FileSystemWriteStdoutConformanceMetricLabel(metric)
    let metric_log_actual: string@View =
        metric_label

    if (metric_log_actual != "2") {
        "fail"
        return 1
    }

    "success"
    return 0
}
