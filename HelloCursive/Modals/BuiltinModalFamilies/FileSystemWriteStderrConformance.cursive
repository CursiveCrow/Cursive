procedure FileSystemWriteStderrConformanceMetricLabel(value: i32) -> string@View {
    if (value == 2) {
        return "2"
    }
    return "other"
}

public procedure RunFileSystemWriteStderrConformance(ctx: Context) -> i32 {
    [[log(label: "modals-log-item_begin", expected: "running")]] "running"

    let fs: $FileSystem = ctx.fs
    let stderr_marker: string@View = "modals-fs-write-stderr-sentinel\n"
    let write_stderr_ok: bool = if fs~>write_stderr(stderr_marker) is {
        _: () { true }
        _: IoError { false }
    }
    let write_stderr_empty_ok: bool = if fs~>write_stderr("") is {
        _: () { true }
        _: IoError { false }
    }

    let write_stderr_ok_log: bool =
        [[log(label: "observed-modals-fs-write-stderr-success", expected: true)]]
        write_stderr_ok
    let write_stderr_empty_ok_log: bool =
        [[log(label: "observed-modals-fs-write-stderr-empty-success", expected: true)]]
        write_stderr_empty_ok

    let metric: i32 = if (
        (write_stderr_ok_log == true) &&
        (write_stderr_empty_ok_log == true)
    ) { 2 } else { 0 }
    let metric_label: string@View = FileSystemWriteStderrConformanceMetricLabel(metric)
    let metric_log_actual: string@View =
        [[log(label: "observed-modals-fs-write-stderr-metric", expected: "2")]]
        metric_label

    if (metric_log_actual != "2") {
        [[log(label: "modals-log-item_fail", expected: "fail")]] "fail"
        return 1
    }

    [[log(label: "modals-log-item_success", expected: "success")]] "success"
    return 0
}
