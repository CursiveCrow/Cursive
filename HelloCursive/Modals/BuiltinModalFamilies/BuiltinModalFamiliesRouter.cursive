public procedure RunGroup(ctx: Context) -> i32 {
    [[log(label: "modals-log-section_start", expected: "section-start")]] "section-start"

    let status_async_builtin_modal_shape: i32 = RunAsyncBuiltinModalShape(ctx)
    if (status_async_builtin_modal_shape != 0) {
        [[log(label: "modals-log-section_end", expected: "section-end")]] "section-end"
        return status_async_builtin_modal_shape
    }

    let status_builtin_modal_literal_restrictions: i32 = RunBuiltinModalLiteralRestrictions(ctx)
    if (status_builtin_modal_literal_restrictions != 0) {
        [[log(label: "modals-log-section_end", expected: "section-end")]] "section-end"
        return status_builtin_modal_literal_restrictions
    }

    let status_cancel_token_modal_behavior: i32 = RunCancelTokenModalBehavior(ctx)
    if (status_cancel_token_modal_behavior != 0) {
        [[log(label: "modals-log-section_end", expected: "section-end")]] "section-end"
        return status_cancel_token_modal_behavior
    }

    let status_region_modal_lifecycle: i32 = RunRegionModalLifecycle(ctx)
    if (status_region_modal_lifecycle != 0) {
        [[log(label: "modals-log-section_end", expected: "section-end")]] "section-end"
        return status_region_modal_lifecycle
    }

    let status_spawned_tracked_handle_states: i32 = RunSpawnedTrackedHandleStates(ctx)
    if (status_spawned_tracked_handle_states != 0) {
        [[log(label: "modals-log-section_end", expected: "section-end")]] "section-end"
        return status_spawned_tracked_handle_states
    }

    let status_file_system_exists_conformance: i32 = RunFileSystemExistsConformance(ctx)
    if (status_file_system_exists_conformance != 0) {
        [[log(label: "modals-log-section_end", expected: "section-end")]] "section-end"
        return status_file_system_exists_conformance
    }

    let status_file_system_create_dir_conformance: i32 = RunFileSystemCreateDirConformance(ctx)
    if (status_file_system_create_dir_conformance != 0) {
        [[log(label: "modals-log-section_end", expected: "section-end")]] "section-end"
        return status_file_system_create_dir_conformance
    }

    let status_file_system_ensure_dir_conformance: i32 = RunFileSystemEnsureDirConformance(ctx)
    if (status_file_system_ensure_dir_conformance != 0) {
        [[log(label: "modals-log-section_end", expected: "section-end")]] "section-end"
        return status_file_system_ensure_dir_conformance
    }

    let status_file_system_kind_conformance: i32 = RunFileSystemKindConformance(ctx)
    if (status_file_system_kind_conformance != 0) {
        [[log(label: "modals-log-section_end", expected: "section-end")]] "section-end"
        return status_file_system_kind_conformance
    }

    let status_file_system_restrict_conformance: i32 = RunFileSystemRestrictConformance(ctx)
    if (status_file_system_restrict_conformance != 0) {
        [[log(label: "modals-log-section_end", expected: "section-end")]] "section-end"
        return status_file_system_restrict_conformance
    }

    let status_file_system_create_write_conformance: i32 = RunFileSystemCreateWriteConformance(ctx)
    if (status_file_system_create_write_conformance != 0) {
        [[log(label: "modals-log-section_end", expected: "section-end")]] "section-end"
        return status_file_system_create_write_conformance
    }

    let status_file_system_open_read_conformance: i32 = RunFileSystemOpenReadConformance(ctx)
    if (status_file_system_open_read_conformance != 0) {
        [[log(label: "modals-log-section_end", expected: "section-end")]] "section-end"
        return status_file_system_open_read_conformance
    }

    let status_file_system_open_write_conformance: i32 = RunFileSystemOpenWriteConformance(ctx)
    if (status_file_system_open_write_conformance != 0) {
        [[log(label: "modals-log-section_end", expected: "section-end")]] "section-end"
        return status_file_system_open_write_conformance
    }

    let status_file_system_open_append_conformance: i32 = RunFileSystemOpenAppendConformance(ctx)
    if (status_file_system_open_append_conformance != 0) {
        [[log(label: "modals-log-section_end", expected: "section-end")]] "section-end"
        return status_file_system_open_append_conformance
    }

    let status_file_system_read_bytes_conformance: i32 = RunFileSystemReadBytesConformance(ctx)
    if (status_file_system_read_bytes_conformance != 0) {
        [[log(label: "modals-log-section_end", expected: "section-end")]] "section-end"
        return status_file_system_read_bytes_conformance
    }

    let status_file_system_read_file_conformance: i32 = RunFileSystemReadFileConformance(ctx)
    if (status_file_system_read_file_conformance != 0) {
        [[log(label: "modals-log-section_end", expected: "section-end")]] "section-end"
        return status_file_system_read_file_conformance
    }

    let status_file_system_write_file_conformance: i32 = RunFileSystemWriteFileConformance(ctx)
    if (status_file_system_write_file_conformance != 0) {
        [[log(label: "modals-log-section_end", expected: "section-end")]] "section-end"
        return status_file_system_write_file_conformance
    }

    let status_file_system_remove_conformance: i32 = RunFileSystemRemoveConformance(ctx)
    if (status_file_system_remove_conformance != 0) {
        [[log(label: "modals-log-section_end", expected: "section-end")]] "section-end"
        return status_file_system_remove_conformance
    }

    let status_file_system_write_stdout_conformance: i32 = RunFileSystemWriteStdoutConformance(ctx)
    if (status_file_system_write_stdout_conformance != 0) {
        [[log(label: "modals-log-section_end", expected: "section-end")]] "section-end"
        return status_file_system_write_stdout_conformance
    }

    let status_file_system_write_stderr_conformance: i32 = RunFileSystemWriteStderrConformance(ctx)
    if (status_file_system_write_stderr_conformance != 0) {
        [[log(label: "modals-log-section_end", expected: "section-end")]] "section-end"
        return status_file_system_write_stderr_conformance
    }

    let status_file_system_open_dir_conformance: i32 = RunFileSystemOpenDirConformance(ctx)
    if (status_file_system_open_dir_conformance != 0) {
        [[log(label: "modals-log-section_end", expected: "section-end")]] "section-end"
        return status_file_system_open_dir_conformance
    }

    let status_file_modal_primitive_conformance: i32 = RunFileModalPrimitiveConformance(ctx)
    if (status_file_modal_primitive_conformance != 0) {
        [[log(label: "modals-log-section_end", expected: "section-end")]] "section-end"
        return status_file_modal_primitive_conformance
    }

    let status_dir_iter_primitive_conformance: i32 = RunDirIterPrimitiveConformance(ctx)
    if (status_dir_iter_primitive_conformance != 0) {
        [[log(label: "modals-log-section_end", expected: "section-end")]] "section-end"
        return status_dir_iter_primitive_conformance
    }

    let status_file_diriter_modal_behavior: i32 = RunFileAndDirIterModalBehavior(ctx)
    if (status_file_diriter_modal_behavior != 0) {
        [[log(label: "modals-log-section_end", expected: "section-end")]] "section-end"
        return status_file_diriter_modal_behavior
    }

    [[log(label: "modals-log-section_end", expected: "section-end")]] "section-end"
    return 0
}
