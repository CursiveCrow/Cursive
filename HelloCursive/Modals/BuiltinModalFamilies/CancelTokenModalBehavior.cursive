procedure CancelTokenModalBehaviorMetricLabel(value: i32) -> string@View {
    if (value == 13) {
        return "13"
    }
    return "other"
}

public procedure RunCancelTokenModalBehavior(ctx: Context) -> i32 {
    let _ = ctx
    "running"

    let token_owner: unique (CancelToken@Active;) = (CancelToken::new();)
    let token: shared CancelToken@Active = move token_owner.0
    let child_token: CancelToken@Active = token~>child()

    let before_cancel: bool = token~>is_cancelled()
    let wait_pending_state: Async<(), (), (), !> = token~>wait_cancelled()
    let wait_pending_metric: bool = if wait_pending_state is {
        @Suspended { output: _ } { true }
        _ { false }
    }
    token~>cancel()
    let after_cancel: bool = token~>is_cancelled()

    let child_state_metric: bool = child_token~>is_cancelled() == true
    let wait_completed_state: Async<(), (), (), !> = token~>wait_cancelled()
    let wait_completed_metric: bool = if wait_completed_state is {
        @Completed { value: _ } { true }
        _ { false }
    }
    let wait_metric: bool = wait_pending_metric && wait_completed_metric

    let before_cancel_log: bool =
        before_cancel
    let after_cancel_log: bool =
        after_cancel
    let child_state_metric_log: bool =
        child_state_metric
    let wait_metric_log: bool =
        wait_metric

    let mod_042: string@View = "MOD-042"
    let mod_042_log: string@View =
        mod_042

    let runtime_ok: bool =
        (before_cancel_log == false) &&
        (after_cancel_log == true) &&
        (child_state_metric_log == true) &&
        (wait_metric_log == true) &&
        (mod_042_log == "MOD-042")
    let runtime_ok_log: bool =
        runtime_ok

    let metric: i32 = if (runtime_ok_log == true) { 13 } else { 0 }
    let metric_label: string@View = CancelTokenModalBehaviorMetricLabel(metric)
    let metric_log_actual: string@View =
        metric_label
    if (metric_log_actual != "13") {
        "fail"
        return 1
    }

    "success"
    return 0
}
