procedure FileSystemOpenWriteConformanceMetricLabel(value: i32) -> string@View {
    if (value == 24) {
        return "24"
    }
    return "other"
}

public procedure RunFileSystemOpenWriteConformance(ctx: Context) -> i32 {
    [[log(label: "modals-log-item_begin", expected: "running")]] "running"

    let fs: $FileSystem = ctx.fs
    let build_dir_path: string@View = "build"
    let build_main_dir_path: string@View = "build/main"
    let logs_dir_path: string@View = "build/main/logs"
    let runtime_logs_dir_path: string@View = "build/main/logs/runtime"
    let build_dir_ready: bool = if fs~>create_dir(build_dir_path) is {
        build_created: () {
            let _ = build_created
            true
        }
        build_err: IoError { fs~>exists(build_dir_path) }
    }
    let build_main_dir_ready: bool = if (build_dir_ready == true) {
        if fs~>create_dir(build_main_dir_path) is {
            build_main_created: () {
                let _ = build_main_created
                true
            }
            build_main_err: IoError { fs~>exists(build_main_dir_path) }
        }
    } else {
        false
    }
    let logs_dir_ready: bool = if (build_main_dir_ready == true) {
        if fs~>create_dir(logs_dir_path) is {
            logs_created: () {
                let _ = logs_created
                true
            }
            logs_err: IoError { fs~>exists(logs_dir_path) }
        }
    } else {
        false
    }
    let runtime_logs_dir_ready: bool = if (logs_dir_ready == true) {
        if fs~>create_dir(runtime_logs_dir_path) is {
            runtime_logs_created: () {
                let _ = runtime_logs_created
                true
            }
            runtime_logs_err: IoError { fs~>exists(runtime_logs_dir_path) }
        }
    } else {
        false
    }

    let probe_path: string@View =
        "build/main/logs/runtime/fs_open_write_conformance_probe.txt"
    let missing_path: string@View =
        "build/main/logs/runtime/fs_open_write_conformance_missing.txt"
    let initial_text: string@View = "abcdef"
    let overwrite_text: string@View = "XY"
    let expected_text: string@View = "XYcdef"
    let initial_bytes: bytes@View = bytes::view_string(initial_text)
    let overwrite_bytes: bytes@View = bytes::view_string(overwrite_text)
    let expected_length: i32 = string::length(expected_text) as i32

    let stale_probe_cleanup: () | IoError = fs~>remove(probe_path)
    let _ = stale_probe_cleanup
    let stale_missing_cleanup: () | IoError = fs~>remove(missing_path)
    let _ = stale_missing_cleanup

    let seed_write_ready: bool = if (runtime_logs_dir_ready == true) {
        if fs~>create_write(probe_path) is {
            seed_writer: unique File@Write {
                let write_result: () | IoError = seed_writer~>write(initial_bytes)
                let flush_result: () | IoError = seed_writer~>flush()
                let closed_writer: File@Closed = seed_writer~>close()
                let _ = closed_writer
                let write_ok: bool = if write_result is {
                    seed_write_unit: () {
                        let _ = seed_write_unit
                        true
                    }
                    seed_write_err: IoError {
                        let _ = seed_write_err
                        false
                    }
                }
                let flush_ok: bool = if flush_result is {
                    seed_flush_unit: () {
                        let _ = seed_flush_unit
                        true
                    }
                    seed_flush_err: IoError {
                        let _ = seed_flush_err
                        false
                    }
                }
                write_ok && flush_ok
            }
            seed_open_err: IoError {
                let _ = seed_open_err
                false
            }
        }
    } else {
        false
    }

    let open_write_ready: bool = if (seed_write_ready == true) {
        if fs~>open_write(probe_path) is {
            writer: unique File@Write {
                let write_result: () | IoError = writer~>write(overwrite_bytes)
                let flush_result: () | IoError = writer~>flush()
                let closed_writer: File@Closed = writer~>close()
                let _ = closed_writer
                let write_ok: bool = if write_result is {
                    write_unit: () {
                        let _ = write_unit
                        true
                    }
                    write_err: IoError {
                        let _ = write_err
                        false
                    }
                }
                let flush_ok: bool = if flush_result is {
                    flush_unit: () {
                        let _ = flush_unit
                        true
                    }
                    flush_err: IoError {
                        let _ = flush_err
                        false
                    }
                }
                write_ok && flush_ok
            }
            open_err: IoError {
                let _ = open_err
                false
            }
        }
    } else {
        false
    }

    let open_write_missing_error: bool = if fs~>open_write(missing_path) is {
        missing_writer: unique File@Write {
            let closed_writer: File@Closed = missing_writer~>close()
            let _ = closed_writer
            false
        }
        missing_err: IoError {
            let _ = missing_err
            true
        }
    }

    let open_write_length: i32 = if (open_write_ready == true) {
        if fs~>open_read(probe_path) is {
            reader: unique File@Read {
                let read_result: bytes@Managed | IoError = reader~>read_all_bytes()
                let closed_reader: File@Closed = reader~>close()
                let _ = closed_reader
                if read_result is {
                    read_bytes: unique bytes@Managed {
                        let read_view: bytes@View = bytes::as_view(read_bytes)
                        bytes::length(read_view) as i32
                    }
                    read_err: IoError {
                        let _ = read_err
                        0
                    }
                }
            }
            open_err: IoError {
                let _ = open_err
                0
            }
        }
    } else {
        0
    }
    let open_write_exact_text: bool = if (open_write_ready == true) {
        if fs~>open_read(probe_path) is {
            reader: unique File@Read {
                let read_result: bytes@Managed | IoError = reader~>read_all_bytes()
                let closed_reader: File@Closed = reader~>close()
                let _ = closed_reader
                if read_result is {
                    read_bytes: unique bytes@Managed {
                        let read_view: bytes@View = bytes::as_view(read_bytes)
                        let read_slice = bytes::as_slice(read_view)
                        let read_length_ok: bool = bytes::length(read_view) == 6usize
                        if (read_length_ok == true) {
                            (read_slice[0] == 88u8) &&
                            (read_slice[1] == 89u8) &&
                            (read_slice[2] == 99u8) &&
                            (read_slice[3] == 100u8) &&
                            (read_slice[4] == 101u8) &&
                            (read_slice[5] == 102u8)
                        } else {
                            false
                        }
                    }
                    read_err: IoError {
                        let _ = read_err
                        false
                    }
                }
            }
            open_err: IoError {
                let _ = open_err
                false
            }
        }
    } else {
        false
    }

    let runtime_logs_dir_ready_log: bool =
        [[log(label: "observed-modals-fs-open-write-runtime-dir-ready", expected: true)]]
        runtime_logs_dir_ready
    let seed_write_ready_log: bool =
        [[log(label: "observed-modals-fs-open-write-seed-ready", expected: true)]]
        seed_write_ready
    let open_write_ready_log: bool =
        [[log(label: "observed-modals-fs-open-write-overwrite-ready", expected: true)]]
        open_write_ready
    let open_write_length_log: i32 =
        [[log(label: "observed-modals-fs-open-write-text-length", expected: 6)]]
        open_write_length
    let open_write_exact_text_log: bool =
        [[log(label: "observed-modals-fs-open-write-exact-text", expected: true)]]
        open_write_exact_text
    let open_write_missing_error_log: bool =
        [[log(label: "observed-modals-fs-open-write-missing-error", expected: true)]]
        open_write_missing_error

    let metric: i32 = if (
        (runtime_logs_dir_ready_log == true) &&
        (seed_write_ready_log == true) &&
        (open_write_ready_log == true) &&
        (open_write_length_log == expected_length) &&
        (open_write_exact_text_log == true) &&
        (open_write_missing_error_log == true)
    ) { 24 } else { 0 }
    let metric_label: string@View = FileSystemOpenWriteConformanceMetricLabel(metric)
    let metric_log_actual: string@View =
        [[log(label: "observed-modals-fs-open-write-metric", expected: "24")]]
        metric_label

    let cleanup_probe: () | IoError = fs~>remove(probe_path)
    let _ = cleanup_probe

    if (metric_log_actual != "24") {
        [[log(label: "modals-log-item_fail", expected: "fail")]] "fail"
        return 1
    }

    [[log(label: "modals-log-item_success", expected: "success")]] "success"
    return 0
}
