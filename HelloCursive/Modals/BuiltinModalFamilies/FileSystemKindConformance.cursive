procedure FileSystemKindConformanceMetricLabel(value: i32) -> string@View {
    if (value == 6) {
        return "6"
    }
    return "other"
}

procedure FileSystemKindConformanceCodeLabel(value: i32) -> string@View {
    if (value == 0) {
        return "0"
    }
    if (value == 21) {
        return "21"
    }
    if (value == 22) {
        return "22"
    }
    if (value == 23) {
        return "23"
    }
    if (value == 24) {
        return "24"
    }
    if (value == 31) {
        return "31"
    }
    if (value == 32) {
        return "32"
    }
    if (value == 33) {
        return "33"
    }
    if (value == 34) {
        return "34"
    }
    return "other"
}

public procedure RunFileSystemKindConformance(ctx: Context) -> i32 {
    [[log(label: "modals-log-item_begin", expected: "running")]] "running"

    let fs: $FileSystem = ctx.fs
    let runtime_logs_dir_path: string@View = "build/main/logs/runtime"
    let runtime_logs_dir_ready: bool = if fs~>ensure_dir(runtime_logs_dir_path) is {
        _: () { true }
        _: IoError { false }
    }

    let probe_dir_path: string@View =
        "build/main/logs/runtime/fs_kind_conformance_probe_dir"
    let probe_file_path: string@View =
        "build/main/logs/runtime/fs_kind_conformance_probe_file.txt"
    let missing_path: string@View =
        "build/main/logs/runtime/fs_kind_conformance_missing.txt"
    let payload: bytes@View = bytes::view_string("kind-probe")

    let stale_probe_file_cleanup: () | IoError = fs~>remove(probe_file_path)
    let _ = stale_probe_file_cleanup
    let stale_probe_dir_cleanup: () | IoError = fs~>remove(probe_dir_path)
    let _ = stale_probe_dir_cleanup
    let stale_missing_cleanup: () | IoError = fs~>remove(missing_path)
    let _ = stale_missing_cleanup

    let probe_dir_ready: bool = if (runtime_logs_dir_ready == true) {
        if fs~>create_dir(probe_dir_path) is {
            _: () { true }
            _: IoError { false }
        }
    } else {
        false
    }

    let probe_file_ready: bool = if (runtime_logs_dir_ready == true) {
        if fs~>write_file(probe_file_path, payload) is {
            _: () { true }
            _: IoError { false }
        }
    } else {
        false
    }

    let dir_kind_code: i32 = if (probe_dir_ready == true) {
        if fs~>kind(probe_dir_path) is {
            kind: FileKind {
                if kind is {
                    FileKind::Dir { 0 }
                    FileKind::File { 21 }
                    FileKind::Other { 22 }
                }
            }
            _: IoError { 23 }
        }
    } else {
        24
    }

    let file_kind_code: i32 = if (probe_file_ready == true) {
        if fs~>kind(probe_file_path) is {
            kind: FileKind {
                if kind is {
                    FileKind::Dir { 31 }
                    FileKind::File { 0 }
                    FileKind::Other { 32 }
                }
            }
            _: IoError { 33 }
        }
    } else {
        34
    }

    let dir_kind_is_dir: bool = dir_kind_code == 0
    let file_kind_is_file: bool = file_kind_code == 0

    let missing_kind_errors: bool = if fs~>kind(missing_path) is {
        _: FileKind { false }
        _: IoError { true }
    }

    let runtime_logs_dir_ready_log: bool =
        [[log(label: "observed-modals-fs-kind-runtime-dir-ready", expected: true)]]
        runtime_logs_dir_ready
    let probe_dir_ready_log: bool =
        [[log(label: "observed-modals-fs-kind-probe-dir-ready", expected: true)]]
        probe_dir_ready
    let probe_file_ready_log: bool =
        [[log(label: "observed-modals-fs-kind-probe-file-ready", expected: true)]]
        probe_file_ready
    let dir_kind_is_dir_log: bool =
        [[log(label: "observed-modals-fs-kind-dir-is-dir", expected: true)]]
        dir_kind_is_dir
    let dir_kind_code_label: string@View = FileSystemKindConformanceCodeLabel(dir_kind_code)
    let dir_kind_code_label_log: string@View =
        [[log(label: "observed-modals-fs-kind-dir-kind-code")]]
        dir_kind_code_label
    let file_kind_is_file_log: bool =
        [[log(label: "observed-modals-fs-kind-file-is-file", expected: true)]]
        file_kind_is_file
    let file_kind_code_label: string@View = FileSystemKindConformanceCodeLabel(file_kind_code)
    let file_kind_code_label_log: string@View =
        [[log(label: "observed-modals-fs-kind-file-kind-code")]]
        file_kind_code_label
    let missing_kind_errors_log: bool =
        [[log(label: "observed-modals-fs-kind-missing-errors", expected: true)]]
        missing_kind_errors

    let metric: i32 = if (
        (runtime_logs_dir_ready_log == true) &&
        (probe_dir_ready_log == true) &&
        (probe_file_ready_log == true) &&
        (dir_kind_is_dir_log == true) &&
        (dir_kind_code_label_log == "0") &&
        (file_kind_is_file_log == true) &&
        (file_kind_code_label_log == "0") &&
        (missing_kind_errors_log == true)
    ) { 6 } else { 0 }
    let metric_label: string@View = FileSystemKindConformanceMetricLabel(metric)
    let metric_log_actual: string@View =
        [[log(label: "observed-modals-fs-kind-metric", expected: "6")]]
        metric_label

    let cleanup_probe_file: () | IoError = fs~>remove(probe_file_path)
    let _ = cleanup_probe_file
    let cleanup_probe_dir: () | IoError = fs~>remove(probe_dir_path)
    let _ = cleanup_probe_dir

    if (metric_log_actual != "6") {
        [[log(label: "modals-log-item_fail", expected: "fail")]] "fail"
        return 1
    }

    [[log(label: "modals-log-item_success", expected: "success")]] "success"
    return 0
}
