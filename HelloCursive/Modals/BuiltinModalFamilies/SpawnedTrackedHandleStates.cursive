procedure SpawnedTrackedHandleStatesMetricLabel(value: i32) -> string@View {
    if (value == 28) {
        return "28"
    }
    return "other"
}

procedure SpawnedTrackedFutureSource() -> Future<i32, bool> {
    return 10
}

public procedure RunSpawnedTrackedHandleStates(ctx: Context) -> i32 {
    "running"

    let spawned_metric: i32 = parallel ctx~>cpu() {
        let spawned_handle: Spawned<i32> = spawn { 8 }
        wait spawned_handle
    }

    let tracked_metric: i32 = 10

    let spawned_metric_log: i32 =
        spawned_metric
    let tracked_metric_log: i32 =
        tracked_metric

    let mod_043: string@View = "MOD-043"
    let mod_044: string@View = "MOD-044"
    let mod_043_log: string@View =
        mod_043
    let mod_044_log: string@View =
        mod_044

    let runtime_ok: bool =
        (spawned_metric_log == 8) &&
        (tracked_metric_log == 10) &&
        (mod_043_log == "MOD-043") &&
        (mod_044_log == "MOD-044")
    let runtime_ok_log: bool =
        runtime_ok

    let metric: i32 = if (runtime_ok_log == true) { 28 } else { 0 }
    let metric_label: string@View = SpawnedTrackedHandleStatesMetricLabel(metric)
    let metric_log_actual: string@View =
        metric_label
    if (metric_log_actual != "28") {
        "fail"
        return 1
    }

    "success"
    return 0
}
