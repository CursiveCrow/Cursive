import CoreModalTypeSystem
import StateMembersAndVisibility
import ModalPatternsAndCaseAnalysis
import ModalWideningAndSubtyping
import BuiltinModalFamilies
import AsyncModalStateMachine
import ModalLayoutAndRepresentation
import ModalClassInteroperability
import Diagnostics

procedure ModalsLogGroupStatus(group_name: string@View, status: i32) -> () {
    [[log(label: "modals-log-group-name", expected: "group")]] "group"
    [[log(label: "observed-modals-group-name")]] group_name
    [[log(label: "observed-modals-group-status", expected: 0)]] status
    return ()
}

public procedure run(ctx: Context) -> i32 {
    let status_core_modal_type_system: i32 = CoreModalTypeSystem::RunGroup(ctx)
    ModalsLogGroupStatus("modals::CoreModalTypeSystem", status_core_modal_type_system)
    if (status_core_modal_type_system != 0) {
        return status_core_modal_type_system
    }

    let status_state_members_and_visibility: i32 = StateMembersAndVisibility::RunGroup(ctx)
    ModalsLogGroupStatus(
        "modals::StateMembersAndVisibility",
        status_state_members_and_visibility
    )
    if (status_state_members_and_visibility != 0) {
        return status_state_members_and_visibility
    }

    let status_modal_patterns_and_case_analysis: i32 = ModalPatternsAndCaseAnalysis::RunGroup(ctx)
    ModalsLogGroupStatus(
        "modals::ModalPatternsAndCaseAnalysis",
        status_modal_patterns_and_case_analysis
    )
    if (status_modal_patterns_and_case_analysis != 0) {
        return status_modal_patterns_and_case_analysis
    }

    let status_modal_widening_and_subtyping: i32 = ModalWideningAndSubtyping::RunGroup(ctx)
    ModalsLogGroupStatus(
        "modals::ModalWideningAndSubtyping",
        status_modal_widening_and_subtyping
    )
    if (status_modal_widening_and_subtyping != 0) {
        return status_modal_widening_and_subtyping
    }

    let status_builtin_modal_families: i32 = BuiltinModalFamilies::RunGroup(ctx)
    ModalsLogGroupStatus(
        "modals::BuiltinModalFamilies",
        status_builtin_modal_families
    )
    if (status_builtin_modal_families != 0) {
        return status_builtin_modal_families
    }

    let status_async_modal_state_machine: i32 = AsyncModalStateMachine::RunGroup(ctx)
    ModalsLogGroupStatus(
        "modals::AsyncModalStateMachine",
        status_async_modal_state_machine
    )
    if (status_async_modal_state_machine != 0) {
        return status_async_modal_state_machine
    }

    let status_modal_layout_and_representation: i32 = ModalLayoutAndRepresentation::RunGroup(ctx)
    ModalsLogGroupStatus(
        "modals::ModalLayoutAndRepresentation",
        status_modal_layout_and_representation
    )
    if (status_modal_layout_and_representation != 0) {
        return status_modal_layout_and_representation
    }

    let status_modal_class_interoperability: i32 = ModalClassInteroperability::RunGroup(ctx)
    ModalsLogGroupStatus(
        "modals::ModalClassInteroperability",
        status_modal_class_interoperability
    )
    if (status_modal_class_interoperability != 0) {
        return status_modal_class_interoperability
    }

    let status_diagnostics: i32 = Diagnostics::RunGroup(ctx)
    ModalsLogGroupStatus("modals::Diagnostics", status_diagnostics)
    if (status_diagnostics != 0) {
        return status_diagnostics
    }

    return 0
}
