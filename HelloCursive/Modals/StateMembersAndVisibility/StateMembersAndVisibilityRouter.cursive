public procedure runGroup(ctx: Context) -> i32 {
    "section-start"

    let status_modal_field_access_rules: i32 = RunModalFieldAccessRules(ctx)
    if (status_modal_field_access_rules != 0) {
        "section-end"
        return status_modal_field_access_rules
    }

    let status_modal_state_method_dispatch: i32 = RunModalStateMethodDispatch(ctx)
    if (status_modal_state_method_dispatch != 0) {
        "section-end"
        return status_modal_state_method_dispatch
    }

    let status_modal_transition_invocation_rules: i32 = RunModalTransitionInvocationRules(ctx)
    if (status_modal_transition_invocation_rules != 0) {
        "section-end"
        return status_modal_transition_invocation_rules
    }

    let status_modal_member_visibility_and_conflicts: i32 = RunModalMemberVisibilityAndConflicts(ctx)
    if (status_modal_member_visibility_and_conflicts != 0) {
        "section-end"
        return status_modal_member_visibility_and_conflicts
    }

    let status_visibility_access_conformance: i32 = RunVisibilityAccessConformance(ctx)
    if (status_visibility_access_conformance != 0) {
        "section-end"
        return status_visibility_access_conformance
    }

    "section-end"
    return 0
}
