modal ModalTypeRelationProbe {
    @Alpha {
        value: i32
    }
    @Beta {
        value: i32
    }
}

procedure ModalTypeRelationsMetricLabel(value: i32) -> string@View {
    if (value == 19) {
        return "19"
    }
    return "other"
}

public procedure RunModalTypeRelations(ctx: Context) -> i32 {
    let _ = ctx
    "running"

    let alpha_one: ModalTypeRelationProbe@Alpha =
        ModalTypeRelationProbe@Alpha { value: 3 }
    let alpha_two: ModalTypeRelationProbe@Alpha =
        ModalTypeRelationProbe@Alpha { value: 3 }
    let beta_one: ModalTypeRelationProbe@Beta =
        ModalTypeRelationProbe@Beta { value: 8 }

    let alpha_general: ModalTypeRelationProbe = widen(alpha_one)
    let beta_general: ModalTypeRelationProbe = widen(beta_one)

    let alpha_equivalence_metric: bool = alpha_two.value == 3
    let alpha_general_metric: i32 = if alpha_general is {
        @Alpha { value: value } { value }
        @Beta { value: value } { value }
    }
    let beta_general_metric: i32 = if beta_general is {
        @Alpha { value: value } { value }
        @Beta { value: value } { value }
    }

    let alpha_equivalence_metric_log: bool =
        alpha_equivalence_metric
    let alpha_general_metric_log: i32 =
        alpha_general_metric
    let beta_general_metric_log: i32 =
        beta_general_metric

    let incomparability_rule: string@View = "M@A-not-subtype-of-M@B"
    let incomparability_rule_log: string@View =
        incomparability_rule

    let mod_010: string@View = "MOD-010"
    let mod_011: string@View = "MOD-011"
    let mod_010_log: string@View =
        mod_010
    let mod_011_log: string@View =
        mod_011

    let runtime_ok: bool =
        (alpha_equivalence_metric_log == true) &&
        (alpha_general_metric_log == 3) &&
        (beta_general_metric_log == 8) &&
        (incomparability_rule_log == "M@A-not-subtype-of-M@B") &&
        (mod_010_log == "MOD-010") &&
        (mod_011_log == "MOD-011")
    let runtime_ok_log: bool =
        runtime_ok

    let metric: i32 = if (runtime_ok_log == true) { 19 } else { 0 }
    let metric_label: string@View = ModalTypeRelationsMetricLabel(metric)
    let metric_log_actual: string@View =
        metric_label
    if (metric_log_actual != "19") {
        "fail"
        return 1
    }

    "success"
    return 0
}
