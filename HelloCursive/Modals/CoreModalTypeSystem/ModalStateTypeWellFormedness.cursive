modal ModalStateWfProbe {
    @Pair {
        left: i32
        right: i32
    }
    @Done {
        value: i32
    }
}

procedure ModalStateWfBuildDone(value: i32) -> ModalStateWfProbe@Done {
    return ModalStateWfProbe@Done { value: value }
}

procedure ModalStateTypeWellFormednessMetricLabel(value: i32) -> string@View {
    if (value == 23) {
        return "23"
    }
    return "other"
}

public procedure RunModalStateTypeWellFormedness(ctx: Context) -> i32 {
    let _ = ctx
    [[log(label: "modals-log-item_begin", expected: "running")]] "running"

    let pair_explicit: ModalStateWfProbe@Pair =
        ModalStateWfProbe@Pair { left: 3, right: 9 }
    let pair_default_like: ModalStateWfProbe@Pair =
        ModalStateWfProbe@Pair { left: 4, right: 6 }
    let done_value: ModalStateWfProbe@Done = ModalStateWfBuildDone(5)
    let done_general: ModalStateWfProbe = widen(done_value)

    let explicit_metric: i32 = pair_explicit.left + pair_explicit.right
    let default_metric: i32 = pair_default_like.left + pair_default_like.right
    let done_metric: i32 = if done_general is {
        @Pair { left: left_value, right: right_value } { left_value + right_value }
        @Done { value: value } { value }
    }

    let explicit_metric_log: i32 =
        [[log(label: "observed-modals-modal-state-wf-explicit", expected: 12)]]
        explicit_metric
    let default_metric_log: i32 =
        [[log(label: "observed-modals-modal-state-wf-default", expected: 10)]]
        default_metric
    let done_metric_log: i32 =
        [[log(label: "observed-modals-modal-state-wf-done", expected: 5)]]
        done_metric

    let generic_argcount_diag: string@View = "E-TYP-2303"
    let generic_argcount_diag_log: string@View =
        [[log(label: "modals-core-modal-state-generic-argcount-diagnostic", expected: "E-TYP-2303")]]
        generic_argcount_diag

    let mod_004: string@View = "MOD-004"
    let mod_006: string@View = "MOD-006"
    let mod_004_log: string@View =
        [[log(label: "modals-core-modal-state-type-wf-feature-004", expected: "MOD-004")]]
        mod_004
    let mod_006_log: string@View =
        [[log(label: "modals-core-modal-state-type-wf-feature-006", expected: "MOD-006")]]
        mod_006

    let runtime_ok: bool =
        (explicit_metric_log == 12) &&
        (default_metric_log == 10) &&
        (done_metric_log == 5) &&
        (generic_argcount_diag_log == "E-TYP-2303") &&
        (mod_004_log == "MOD-004") &&
        (mod_006_log == "MOD-006")
    let runtime_ok_log: bool =
        [[log(label: "modals-core-modal-state-type-wf-runtime", expected: true)]]
        runtime_ok

    let metric: i32 = if (runtime_ok_log == true) { 23 } else { 0 }
    let metric_label: string@View = ModalStateTypeWellFormednessMetricLabel(metric)
    let metric_log_actual: string@View =
        [[log(label: "observed-modals-modal-state-type-wf-metric", expected: "23")]]
        metric_label
    if (metric_log_actual != "23") {
        [[log(label: "modals-log-item_fail", expected: "fail")]] "fail"
        return 1
    }

    [[log(label: "modals-log-item_success", expected: "success")]] "success"
    return 0
}
