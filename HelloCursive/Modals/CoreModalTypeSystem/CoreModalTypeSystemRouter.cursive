public procedure RunGroup(ctx: Context) -> i32 {
    [[log(label: "modals-log-section_start", expected: "section-start")]] "section-start"

    let status_modal_declaration_syntax: i32 = RunModalDeclarationSyntax(ctx)
    if (status_modal_declaration_syntax != 0) {
        [[log(label: "modals-log-section_end", expected: "section-end")]] "section-end"
        return status_modal_declaration_syntax
    }

    let status_modal_state_type_well_formedness: i32 = RunModalStateTypeWellFormedness(ctx)
    if (status_modal_state_type_well_formedness != 0) {
        [[log(label: "modals-log-section_end", expected: "section-end")]] "section-end"
        return status_modal_state_type_well_formedness
    }

    let status_modal_payload_and_state_validity: i32 = RunModalPayloadAndStateValidity(ctx)
    if (status_modal_payload_and_state_validity != 0) {
        [[log(label: "modals-log-section_end", expected: "section-end")]] "section-end"
        return status_modal_payload_and_state_validity
    }

    let status_modal_state_construction: i32 = RunModalStateConstruction(ctx)
    if (status_modal_state_construction != 0) {
        [[log(label: "modals-log-section_end", expected: "section-end")]] "section-end"
        return status_modal_state_construction
    }

    let status_modal_invariant_and_where_clause: i32 = RunModalInvariantAndWhereClause(ctx)
    if (status_modal_invariant_and_where_clause != 0) {
        [[log(label: "modals-log-section_end", expected: "section-end")]] "section-end"
        return status_modal_invariant_and_where_clause
    }

    let status_modal_type_relations: i32 = RunModalTypeRelations(ctx)
    if (status_modal_type_relations != 0) {
        [[log(label: "modals-log-section_end", expected: "section-end")]] "section-end"
        return status_modal_type_relations
    }

    [[log(label: "modals-log-section_end", expected: "section-end")]] "section-end"
    return 0
}
