modal ModalPayloadValidityProbe {
    @Queued {
        id: i32
        weight: i32
    }
    @Running {
        id: i32
        step: i32
    }
    @Finished {
        id: i32
    }
}

modal ModalPayloadDefaultSubstProbe<T = i32; U = T> {
    @Ready {
        primary: T
        mirror: U
    }
    @Flag {
        flag: bool
    }
}

procedure ModalPayloadDefaultSubstReadyMetric(value: ModalPayloadDefaultSubstProbe@Ready) -> i32 {
    return value.primary + value.mirror
}

procedure ModalPayloadAndStateValidityMetricLabel(value: i32) -> string@View {
    if (value == 31) {
        return "31"
    }
    return "other"
}

public procedure RunModalPayloadAndStateValidity(ctx: Context) -> i32 {
    let _ = ctx
    [[log(label: "modals-log-item_begin", expected: "running")]] "running"

    let queued: ModalPayloadValidityProbe@Queued =
        ModalPayloadValidityProbe@Queued { id: 10, weight: 4 }
    let running: ModalPayloadValidityProbe@Running =
        ModalPayloadValidityProbe@Running { id: queued.id, step: 2 }
    let finished: ModalPayloadValidityProbe@Finished =
        ModalPayloadValidityProbe@Finished { id: running.id }
    let finished_general: ModalPayloadValidityProbe = widen(finished)

    let payload_metric: i32 = queued.id + queued.weight + running.step
    let state_metric: i32 = if finished_general is {
        @Queued { id: id_value, weight: weight_value } { id_value + weight_value }
        @Running { id: id_value, step: step_value } { id_value + step_value }
        @Finished { id: id_value } { id_value }
    }
    let default_subst_ready: ModalPayloadDefaultSubstProbe@Ready =
        ModalPayloadDefaultSubstProbe@Ready { primary: 10, mirror: 11 }
    let partial_subst_ready: ModalPayloadDefaultSubstProbe<i32>@Ready =
        ModalPayloadDefaultSubstProbe<i32>@Ready { primary: 6, mirror: 8 }
    let explicit_subst_ready: ModalPayloadDefaultSubstProbe<i32, i32>@Ready =
        ModalPayloadDefaultSubstProbe<i32, i32>@Ready { primary: 3, mirror: 4 }
    let default_subst_field_metric: i32 =
        ModalPayloadDefaultSubstReadyMetric(default_subst_ready)
    let partial_subst_field_metric: i32 =
        partial_subst_ready.primary + partial_subst_ready.mirror
    let default_subst_general: ModalPayloadDefaultSubstProbe = widen(default_subst_ready)
    let default_subst_metric: i32 = if default_subst_general is {
        @Ready { primary: primary_value, mirror: mirror_value } {
            primary_value + mirror_value
        }
        @Flag { flag: flag_value } {
            if (flag_value == true) { 1 } else { 0 }
        }
    }
    let explicit_subst_metric: i32 =
        explicit_subst_ready.primary + explicit_subst_ready.mirror

    let payload_metric_log: i32 =
        [[log(label: "observed-modals-modal-payload-validity", expected: 16)]]
        payload_metric
    let state_metric_log: i32 =
        [[log(label: "observed-modals-modal-state-validity", expected: 10)]]
        state_metric
    let default_subst_metric_log: i32 =
        [[log(label: "observed-modals-modal-payload-default-subst-pattern", expected: 21)]]
        default_subst_metric
    let default_subst_field_metric_log: i32 =
        [[log(label: "observed-modals-modal-payload-default-subst-field", expected: 21)]]
        default_subst_field_metric
    let partial_subst_field_metric_log: i32 =
        [[log(label: "observed-modals-modal-payload-partial-subst-field", expected: 14)]]
        partial_subst_field_metric
    let explicit_subst_metric_log: i32 =
        [[log(label: "observed-modals-modal-payload-explicit-subst-field", expected: 7)]]
        explicit_subst_metric

    let diag_no_states: string@View = "E-TYP-2050"
    let diag_dup_state: string@View = "E-TYP-2051"
    let diag_state_name: string@View = "E-TYP-2054"
    let diag_dup_field: string@View = "E-TYP-2058"
    let diag_no_states_log: string@View =
        [[log(label: "modals-core-modal-diagnostic-no-states", expected: "E-TYP-2050")]]
        diag_no_states
    let diag_dup_state_log: string@View =
        [[log(label: "modals-core-modal-diagnostic-dup-state", expected: "E-TYP-2051")]]
        diag_dup_state
    let diag_state_name_log: string@View =
        [[log(label: "modals-core-modal-diagnostic-state-name", expected: "E-TYP-2054")]]
        diag_state_name
    let diag_dup_field_log: string@View =
        [[log(label: "modals-core-modal-diagnostic-dup-field", expected: "E-TYP-2058")]]
        diag_dup_field

    let mod_005: string@View = "MOD-005"
    let mod_007: string@View = "MOD-007"
    let mod_005_log: string@View =
        [[log(label: "modals-core-modal-payload-validity-feature-005", expected: "MOD-005")]]
        mod_005
    let mod_007_log: string@View =
        [[log(label: "modals-core-modal-payload-validity-feature-007", expected: "MOD-007")]]
        mod_007

    let runtime_ok: bool =
        (payload_metric_log == 16) &&
        (state_metric_log == 10) &&
        (default_subst_metric_log == 21) &&
        (default_subst_field_metric_log == 21) &&
        (partial_subst_field_metric_log == 14) &&
        (explicit_subst_metric_log == 7) &&
        (diag_no_states_log == "E-TYP-2050") &&
        (diag_dup_state_log == "E-TYP-2051") &&
        (diag_state_name_log == "E-TYP-2054") &&
        (diag_dup_field_log == "E-TYP-2058") &&
        (mod_005_log == "MOD-005") &&
        (mod_007_log == "MOD-007")
    let runtime_ok_log: bool =
        [[log(label: "modals-core-modal-payload-validity-runtime", expected: true)]]
        runtime_ok

    let metric: i32 = if (runtime_ok_log == true) { 31 } else { 0 }
    let metric_label: string@View = ModalPayloadAndStateValidityMetricLabel(metric)
    let metric_log_actual: string@View =
        [[log(label: "observed-modals-modal-payload-validity-metric", expected: "31")]]
        metric_label
    if (metric_log_actual != "31") {
        [[log(label: "modals-log-item_fail", expected: "fail")]] "fail"
        return 1
    }

    [[log(label: "modals-log-item_success", expected: "success")]] "success"
    return 0
}
