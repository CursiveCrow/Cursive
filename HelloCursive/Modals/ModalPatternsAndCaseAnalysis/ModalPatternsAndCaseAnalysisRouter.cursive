public procedure runGroup(ctx: Context) -> i32 {
    "section-start"

    let status_modal_pattern_syntax_and_typing: i32 = RunModalPatternSyntaxAndTyping(ctx)
    if (status_modal_pattern_syntax_and_typing != 0) {
        "section-end"
        return status_modal_pattern_syntax_and_typing
    }

    let status_modal_if_is_exhaustiveness: i32 = RunModalIfIsExhaustiveness(ctx)
    if (status_modal_if_is_exhaustiveness != 0) {
        "section-end"
        return status_modal_if_is_exhaustiveness
    }

    let status_runtime_modal_pattern_semantics: i32 = RunRuntimeModalPatternSemantics(ctx)
    if (status_runtime_modal_pattern_semantics != 0) {
        "section-end"
        return status_runtime_modal_pattern_semantics
    }

    "section-end"
    return 0
}
