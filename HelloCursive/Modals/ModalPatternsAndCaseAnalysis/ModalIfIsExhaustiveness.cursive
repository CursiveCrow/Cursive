modal ModalIfIsExhaustivenessProbe {
    @A {
    }
    @B {
        value: i32
    }
    @C {
        value: i32
    }
}

procedure ModalIfIsExhaustivenessMetricLabel(value: i32) -> string@View {
    if (value == 15) {
        return "15"
    }
    return "other"
}

public procedure RunModalIfIsExhaustiveness(ctx: Context) -> i32 {
    let _ = ctx
    "running"

    let scrutinee: ModalIfIsExhaustivenessProbe =
        widen(ModalIfIsExhaustivenessProbe@B { value: 4 })

    let exhaustive_metric: i32 = if scrutinee is {
        @A { } { 1 }
        @B { value: value } { value }
        @C { value: value } { value + 1 }
    }
    let check_mode_metric: i32 = if scrutinee is {
        @A { } { 0 }
        _ { 11 }
    }

    let exhaustive_metric_log: i32 =
        exhaustive_metric
    let check_mode_metric_log: i32 =
        check_mode_metric

    let non_exhaustive_diag: string@View = "E-TYP-2060"
    let non_exhaustive_diag_log: string@View =
        non_exhaustive_diag

    let mod_031: string@View = "MOD-031"
    let mod_032: string@View = "MOD-032"
    let mod_033: string@View = "MOD-033"
    let mod_031_log: string@View =
        mod_031
    let mod_032_log: string@View =
        mod_032
    let mod_033_log: string@View =
        mod_033

    let runtime_ok: bool =
        (exhaustive_metric_log == 4) &&
        (check_mode_metric_log == 11) &&
        (non_exhaustive_diag_log == "E-TYP-2060") &&
        (mod_031_log == "MOD-031") &&
        (mod_032_log == "MOD-032") &&
        (mod_033_log == "MOD-033")
    let runtime_ok_log: bool =
        runtime_ok

    let metric: i32 = if (runtime_ok_log == true) { 15 } else { 0 }
    let metric_label: string@View = ModalIfIsExhaustivenessMetricLabel(metric)
    let metric_log_actual: string@View =
        metric_label
    if (metric_log_actual != "15") {
        "fail"
        return 1
    }

    "success"
    return 0
}
