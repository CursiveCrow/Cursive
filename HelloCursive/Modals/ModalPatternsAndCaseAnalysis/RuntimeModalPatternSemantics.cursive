modal RuntimeModalPatternProbe {
    @Cold {
        value: i32
    }
    @Warm {
        value: i32
    }
}

procedure RuntimeModalPatternSelect(flag: bool) -> RuntimeModalPatternProbe {
    if (flag == true) {
        return widen(RuntimeModalPatternProbe@Warm { value: 6 })
    }
    return widen(RuntimeModalPatternProbe@Cold { value: 2 })
}

procedure RuntimeModalPatternSemanticsMetricLabel(value: i32) -> string@View {
    if (value == 14) {
        return "14"
    }
    return "other"
}

public procedure RunRuntimeModalPatternSemantics(ctx: Context) -> i32 {
    let _ = ctx
    [[log(label: "modals-log-item_begin", expected: "running")]] "running"

    let warm_path: RuntimeModalPatternProbe = RuntimeModalPatternSelect(true)
    let cold_path: RuntimeModalPatternProbe = RuntimeModalPatternSelect(false)

    let warm_metric: i32 = if warm_path is {
        @Cold { value: value } { value }
        @Warm { value: value } { value + 1 }
    }
    let cold_metric: i32 = if cold_path is {
        @Cold { value: value } { value + 5 }
        @Warm { value: value } { value }
    }

    let warm_metric_log: i32 =
        [[log(label: "observed-modals-runtime-modal-pattern-warm", expected: 7)]]
        warm_metric
    let cold_metric_log: i32 =
        [[log(label: "observed-modals-runtime-modal-pattern-cold", expected: 7)]]
        cold_metric

    let mod_034: string@View = "MOD-034"
    let mod_034_log: string@View =
        [[log(label: "modals-runtime-modal-pattern-feature-034", expected: "MOD-034")]]
        mod_034

    let runtime_ok: bool =
        (warm_metric_log == 7) &&
        (cold_metric_log == 7) &&
        (mod_034_log == "MOD-034")
    let runtime_ok_log: bool =
        [[log(label: "modals-runtime-modal-pattern-semantics-runtime", expected: true)]]
        runtime_ok

    let metric: i32 = if (runtime_ok_log == true) { 14 } else { 0 }
    let metric_label: string@View = RuntimeModalPatternSemanticsMetricLabel(metric)
    let metric_log_actual: string@View =
        [[log(label: "observed-modals-runtime-modal-pattern-semantics-metric", expected: "14")]]
        metric_label
    if (metric_log_actual != "14") {
        [[log(label: "modals-log-item_fail", expected: "fail")]] "fail"
        return 1
    }

    [[log(label: "modals-log-item_success", expected: "success")]] "success"
    return 0
}
