public procedure runGroup(ctx: Context) -> i32 {
    "section-start"

    let status_modal_niche_subtyping: i32 = RunModalNicheSubtyping(ctx)
    if (status_modal_niche_subtyping != 0) {
        "section-end"
        return status_modal_niche_subtyping
    }

    let status_modal_widen_typing_and_errors: i32 = RunModalWidenTypingAndErrors(ctx)
    if (status_modal_widen_typing_and_errors != 0) {
        "section-end"
        return status_modal_widen_typing_and_errors
    }

    let status_modal_widen_runtime_and_warnings: i32 = RunModalWidenRuntimeAndWarnings(ctx)
    if (status_modal_widen_runtime_and_warnings != 0) {
        "section-end"
        return status_modal_widen_runtime_and_warnings
    }

    "section-end"
    return 0
}
