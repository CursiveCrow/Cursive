modal ModalNicheSubtypeProbe {
    @Empty {
    }
    @Payload {
        value: i32
    }
}

procedure ModalNicheSubtypingMetricLabel(value: i32) -> string@View {
    if (value == 14) {
        return "14"
    }
    return "other"
}

public procedure RunModalNicheSubtyping(ctx: Context) -> i32 {
    let _ = ctx
    "running"

    let payload_state: ModalNicheSubtypeProbe@Payload =
        ModalNicheSubtypeProbe@Payload { value: 9 }
    let explicit_general: ModalNicheSubtypeProbe = widen(payload_state)

    let empty_state: ModalNicheSubtypeProbe@Empty =
        ModalNicheSubtypeProbe@Empty { }
    let implicit_general: ModalNicheSubtypeProbe = widen(empty_state)

    let explicit_metric: i32 = if explicit_general is {
        @Empty { } { 0 }
        @Payload { value: value } { value }
    }
    let implicit_metric: i32 = if implicit_general is {
        @Empty { } { 5 }
        @Payload { value: value } { value }
    }

    let explicit_metric_log: i32 =
        explicit_metric
    let implicit_metric_log: i32 =
        implicit_metric

    let non_niche_diag: string@View = "E-TYP-2070"
    let non_niche_diag_log: string@View =
        non_niche_diag

    let mod_012: string@View = "MOD-012"
    let mod_013: string@View = "MOD-013"
    let mod_012_log: string@View =
        mod_012
    let mod_013_log: string@View =
        mod_013

    let runtime_ok: bool =
        (explicit_metric_log == 9) &&
        (implicit_metric_log == 5) &&
        (non_niche_diag_log == "E-TYP-2070") &&
        (mod_012_log == "MOD-012") &&
        (mod_013_log == "MOD-013")
    let runtime_ok_log: bool =
        runtime_ok

    let metric: i32 = if (runtime_ok_log == true) { 14 } else { 0 }
    let metric_label: string@View = ModalNicheSubtypingMetricLabel(metric)
    let metric_log_actual: string@View =
        metric_label
    if (metric_log_actual != "14") {
        "fail"
        return 1
    }

    "success"
    return 0
}
