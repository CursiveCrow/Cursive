public modal class ResourceLifecycleClass {
    @Acquired {
        handle: i32
    }
    @Released {
        handle: i32
    }
}

public modal class TaggedModalClass {
    @Idle {
        tag: i32
    }
    @Active {
        tag: i32
        payload: i32
    }
}

public modal ResourceLifecycleModal <: ResourceLifecycleClass {
    @Acquired {
        handle: i32

        public transition release() -> @Released {
            return ResourceLifecycleModal@Released { handle: self.handle }
        }
    }
    @Released {
        handle: i32
    }
}

public modal TaggedLifecycleModal <: TaggedModalClass {
    @Idle {
        tag: i32

        public transition activate(payload: i32) -> @Active {
            return TaggedLifecycleModal@Active { tag: self.tag, payload: payload }
        }
    }
    @Active {
        tag: i32
        payload: i32
    }
}

procedure ModalClassDeclarationsMetricLabel(value: i32) -> string@View {
    if (value == 15) {
        return "15"
    }
    return "other"
}

public procedure RunModalClassDeclarations(ctx: Context) -> i32 {
    let _ = ctx
    [[log(label: "modals-log-item_begin", expected: "running")]] "running"

    var resource: unique ResourceLifecycleModal@Acquired =
        ResourceLifecycleModal@Acquired { handle: 7 }
    let released: ResourceLifecycleModal@Released = resource~>release()
    let released_handle: i32 = released.handle

    var tagged: unique TaggedLifecycleModal@Idle =
        TaggedLifecycleModal@Idle { tag: 3 }
    let activated: TaggedLifecycleModal@Active = tagged~>activate(5)
    let activated_tag: i32 = activated.tag
    let activated_payload: i32 = activated.payload

    let released_handle_log: i32 =
        [[log(label: "observed-modals-modal-class-decl-released-handle", expected: 7)]]
        released_handle
    let activated_tag_log: i32 =
        [[log(label: "observed-modals-modal-class-decl-activated-tag", expected: 3)]]
        activated_tag
    let activated_payload_log: i32 =
        [[log(label: "observed-modals-modal-class-decl-activated-payload", expected: 5)]]
        activated_payload

    let mcl_001: string@View = [[log(label: "modals-modal-class-decl-feature-001", expected: "MCL-001")]] "MCL-001"
    let mcl_002: string@View = [[log(label: "modals-modal-class-decl-feature-002", expected: "MCL-002")]] "MCL-002"
    let mcl_003: string@View = [[log(label: "modals-modal-class-decl-feature-003", expected: "MCL-003")]] "MCL-003"

    let metric_sum: i32 = released_handle + activated_tag + activated_payload

    let runtime_ok: bool =
        (released_handle_log == 7) &&
        (activated_tag_log == 3) &&
        (activated_payload_log == 5) &&
        (metric_sum == 15) &&
        (mcl_001 == "MCL-001") &&
        (mcl_002 == "MCL-002") &&
        (mcl_003 == "MCL-003")
    let runtime_ok_log: bool =
        [[log(label: "modals-modal-class-declarations-runtime", expected: true)]]
        runtime_ok

    let metric: i32 = if (runtime_ok_log == true) { 15 } else { 0 }
    let metric_label: string@View = ModalClassDeclarationsMetricLabel(metric)
    let metric_log_actual: string@View =
        [[log(label: "observed-modals-modal-class-declarations-metric", expected: "15")]]
        metric_label
    if (metric_log_actual != "15") {
        [[log(label: "modals-log-item_fail", expected: "fail")]] "fail"
        return 1
    }

    [[log(label: "modals-log-item_success", expected: "success")]] "success"
    return 0
}
