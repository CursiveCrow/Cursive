public class ModalLifecycleContractClass {
    @Draft {
        value: i32
    }
    @Published {
        value: i32
    }
}

modal ModalLifecycleImpl <: ModalLifecycleContractClass {
    @Draft {
        value: i32
    }
    @Published {
        value: i32
    }
}

procedure ModalClassRequirementsMetricLabel(value: i32) -> string@View {
    if (value == 8) {
        return "8"
    }
    return "other"
}

public procedure RunModalClassRequirements(ctx: Context) -> i32 {
    let _ = ctx
    "running"

    let draft_value: ModalLifecycleImpl@Draft = ModalLifecycleImpl@Draft { value: 8 }
    let general_value: ModalLifecycleImpl = widen(draft_value)

    let runtime_metric: i32 = if general_value is {
        @Draft { value: value } { value }
        @Published { value: value } { value }
    }

    let runtime_metric_log: i32 =
        runtime_metric

    let modal_class_runtime_support: bool = true
    let modal_class_runtime_support_log: bool =
        modal_class_runtime_support

    let non_modal_impl_diag: string@View = "E-TYP-2401"
    let non_modal_impl_diag_log: string@View =
        non_modal_impl_diag

    let mod_058: string@View = "MOD-058"
    let mod_060: string@View = "MOD-060"
    let mod_058_log: string@View =
        mod_058
    let mod_060_log: string@View =
        mod_060

    let runtime_ok: bool =
        (runtime_metric_log == 8) &&
        (modal_class_runtime_support_log == true) &&
        (non_modal_impl_diag_log == "E-TYP-2401") &&
        (mod_058_log == "MOD-058") &&
        (mod_060_log == "MOD-060")
    let runtime_ok_log: bool =
        runtime_ok

    let metric: i32 = if (runtime_ok_log == true) { 8 } else { 0 }
    let metric_label: string@View = ModalClassRequirementsMetricLabel(metric)
    let metric_log_actual: string@View =
        metric_label
    if (metric_log_actual != "8") {
        "fail"
        return 1
    }

    "success"
    return 0
}
