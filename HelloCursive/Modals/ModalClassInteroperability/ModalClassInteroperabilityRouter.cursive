public procedure RunGroup(ctx: Context) -> i32 {
    [[log(label: "modals-log-section_start", expected: "section-start")]] "section-start"

    let status_modal_class_requirements: i32 = RunModalClassRequirements(ctx)
    if (status_modal_class_requirements != 0) {
        [[log(label: "modals-log-section_end", expected: "section-end")]] "section-end"
        return status_modal_class_requirements
    }

    let status_modal_class_state_conformance: i32 = RunModalClassStateConformance(ctx)
    if (status_modal_class_state_conformance != 0) {
        [[log(label: "modals-log-section_end", expected: "section-end")]] "section-end"
        return status_modal_class_state_conformance
    }

    let status_modal_class_declarations: i32 = RunModalClassDeclarations(ctx)
    if (status_modal_class_declarations != 0) {
        [[log(label: "modals-log-section_end", expected: "section-end")]] "section-end"
        return status_modal_class_declarations
    }

    [[log(label: "modals-log-section_end", expected: "section-end")]] "section-end"
    return 0
}
