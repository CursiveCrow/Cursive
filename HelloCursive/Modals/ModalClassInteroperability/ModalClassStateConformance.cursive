public class ModalConformanceContractClass {
    @Start {
        id: i32
    }
    @End {
        id: i32
        status: i32
    }
}

modal ModalConformanceImpl <: ModalConformanceContractClass {
    @Start {
        id: i32
    }
    @End {
        id: i32
        status: i32
    }
}

procedure ModalClassStateConformanceMetricLabel(value: i32) -> string@View {
    if (value == 15) {
        return "15"
    }
    return "other"
}

public procedure RunModalClassStateConformance(ctx: Context) -> i32 {
    let _ = ctx
    "running"

    let end_value: ModalConformanceImpl@End =
        ModalConformanceImpl@End { id: 10, status: 5 }
    let general_value: ModalConformanceImpl = widen(end_value)

    let runtime_metric: i32 = if general_value is {
        @Start { id: id } { id }
        @End { id: id, status: status } { id + status }
    }

    let runtime_metric_log: i32 =
        runtime_metric

    let missing_state_diag: string@View = "E-TYP-2403"
    let missing_state_diag_log: string@View =
        missing_state_diag

    let mod_059: string@View = "MOD-059"
    let mod_059_log: string@View =
        mod_059

    let runtime_ok: bool =
        (runtime_metric_log == 15) &&
        (missing_state_diag_log == "E-TYP-2403") &&
        (mod_059_log == "MOD-059")
    let runtime_ok_log: bool =
        runtime_ok

    let metric: i32 = if (runtime_ok_log == true) { 15 } else { 0 }
    let metric_label: string@View = ModalClassStateConformanceMetricLabel(metric)
    let metric_log_actual: string@View =
        metric_label
    if (metric_log_actual != "15") {
        "fail"
        return 1
    }

    "success"
    return 0
}
