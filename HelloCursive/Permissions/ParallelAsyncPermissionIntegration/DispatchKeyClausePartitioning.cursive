procedure DispatchKeyClausePartitioningMetricLabel(value: i32) -> string@View {
    if (value == 38) {
        return "38"
    }
    return "other"
}

[[dynamic]]
public procedure RunDispatchKeyClausePartitioning(ctx: Context) -> i32 {
    [[log(label: "permissions-log-item_begin", expected: "running")]] "running"

    var read_gate: i32 = 3
    let read_partition_metric: i32 = parallel ctx~>cpu() {
        dispatch i in 0usize..4usize key read_gate read [reduce: +] {
            read_gate + (i as i32)
        }
    }

    var write_gate: i32 = 0
    let write_partition_metric: i32 = parallel ctx~>cpu() {
        dispatch _ in 0usize..5usize key write_gate write {
            write_gate = write_gate + 1
        }
        write_gate
    }

    var dynamic_slots: [i32; 3] = [2, 4, 6]
    let dynamic_index: usize = 1usize
    let dynamic_partition_metric: i32 = parallel ctx~>cpu() {
        dispatch _ in 0usize..3usize key dynamic_slots[dynamic_index] read [reduce: +] {
            dynamic_slots[dynamic_index]
        }
    }

    let diagnostic_dynamic_key_inference: string@View = "E-CON-0141"
    let diagnostic_domain_expression: string@View = "E-CON-0102"
    let diagnostic_key_partition_surface: string@View = "E-CON-0140"
    let warning_dynamic_key_runtime: string@View = "W-CON-0140"

    let read_partition_metric_log: i32 = [[log(label: "observed-permissions-DispatchKeyClausePartitioning-read-partition", expected: 18)]] read_partition_metric
    let write_partition_metric_log: i32 = [[log(label: "observed-permissions-DispatchKeyClausePartitioning-write-partition", expected: 5)]] write_partition_metric
    let dynamic_partition_metric_log: i32 = [[log(label: "observed-permissions-DispatchKeyClausePartitioning-dynamic-partition", expected: 12)]] dynamic_partition_metric
    let diagnostic_dynamic_key_inference_log: string@View = [[log(label: "permissions-DispatchKeyClausePartitioning-diag-dynamic-key", expected: "E-CON-0141")]] diagnostic_dynamic_key_inference
    let diagnostic_domain_expression_log: string@View = [[log(label: "permissions-DispatchKeyClausePartitioning-diag-domain-expression", expected: "E-CON-0102")]] diagnostic_domain_expression
    let diagnostic_key_partition_surface_log: string@View = [[log(label: "permissions-DispatchKeyClausePartitioning-diag-key-partition", expected: "E-CON-0140")]] diagnostic_key_partition_surface
    let warning_dynamic_key_runtime_log: string@View = [[log(label: "permissions-DispatchKeyClausePartitioning-warning-dynamic-key", expected: "W-CON-0140")]] warning_dynamic_key_runtime

    let runtime_ok: bool =
        (read_partition_metric_log == 18) &&
        (write_partition_metric_log == 5) &&
        (dynamic_partition_metric_log == 12) &&
        (diagnostic_dynamic_key_inference_log == "E-CON-0141") &&
        (diagnostic_domain_expression_log == "E-CON-0102") &&
        (diagnostic_key_partition_surface_log == "E-CON-0140") &&
        (warning_dynamic_key_runtime_log == "W-CON-0140")
    let runtime_ok_log: bool = [[log(label: "permissions-DispatchKeyClausePartitioning-runtime", expected: true)]] runtime_ok

    let metric: i32 = if (runtime_ok_log) { 38 } else { 0 }
    let metric_label: string@View = DispatchKeyClausePartitioningMetricLabel(metric)
    let metric_label_log: string@View = [[log(label: "observed-permissions-DispatchKeyClausePartitioning-metric", expected: "38")]] metric_label

    if (metric_label_log != "38") {
        [[log(label: "permissions-log-item_fail", expected: "fail")]] "fail"
        return 1
    }

    [[log(label: "permissions-log-item_success", expected: "success")]] "success"
    return 0
}
