procedure StalenessSuppressionStaleOkAsync() -> Async<(), (), i32, !> {
    let shared_seed_owner: unique i32 = 7
    let shared_seed: shared i32 = shared_seed_owner

    [[stale_ok]]
    let stale_snapshot: i32 = {
        var local_snapshot: i32 = 0
        # shared_seed read {
            local_snapshot = shared_seed
        }
        local_snapshot
    }

    let resume_point: () = yield release ()
    return stale_snapshot + 2
}

procedure StalenessSuppressionStaleOkMetricLabel(value: i32) -> string@View {
    if (value == 18) {
        return "18"
    }
    return "other"
}

public procedure RunStalenessSuppressionStaleOk(ctx: Context) -> i32 {
    [[log(label: "permissions-log-item_begin", expected: "running")]] "running"

    let stale_metric: i32 = sync StalenessSuppressionStaleOkAsync()

    var release_gate: shared i32 = 3
    # release_gate read {
        # release_gate release write {
            release_gate = release_gate + 4
        }
    }
    let release_metric: i32 = release_gate

    let wait_metric: i32 = parallel ctx~>cpu() {
        let handle = spawn { 2 }
        wait handle
    }

    let warning_code: string@View = "W-CON-0011"

    let stale_metric_log: i32 = [[log(label: "observed-permissions-StalenessSuppressionStaleOk-stale-metric", expected: 9)]] stale_metric
    let release_metric_log: i32 = [[log(label: "observed-permissions-StalenessSuppressionStaleOk-release-metric", expected: 7)]] release_metric
    let wait_metric_log: i32 = [[log(label: "observed-permissions-StalenessSuppressionStaleOk-wait-metric", expected: 2)]] wait_metric
    let warning_log: string@View = [[log(label: "permissions-StalenessSuppressionStaleOk-warning", expected: "W-CON-0011")]] warning_code

    let runtime_ok: bool =
        (stale_metric_log == 9) &&
        (release_metric_log == 7) &&
        (wait_metric_log == 2) &&
        (warning_log == "W-CON-0011")
    let runtime_ok_log: bool = [[log(label: "permissions-StalenessSuppressionStaleOk-runtime", expected: true)]] runtime_ok

    let metric: i32 = if (runtime_ok_log) { 18 } else { 0 }
    let metric_label: string@View = StalenessSuppressionStaleOkMetricLabel(metric)
    let metric_label_log: string@View = [[log(label: "observed-permissions-StalenessSuppressionStaleOk-metric", expected: "18")]] metric_label

    if (metric_label_log != "18") {
        [[log(label: "permissions-log-item_fail", expected: "fail")]] "fail"
        return 1
    }

    [[log(label: "permissions-log-item_success", expected: "success")]] "success"
    return 0
}
