procedure YieldWaitKeyIntegrationChild() -> Async<(), (), i32, !> {
    let child_resume: () = yield release ()
    return 5
}

procedure YieldWaitKeyIntegrationHost() -> Async<(), (), i32, !> {
    let host_resume: () = yield release ()
    let child_value: i32 = yield release from YieldWaitKeyIntegrationChild()
    return child_value + 1
}

procedure YieldWaitKeyIntegrationMetricLabel(value: i32) -> string@View {
    if (value == 19) {
        return "19"
    }
    return "other"
}

public procedure RunYieldWaitKeyIntegration(ctx: Context) -> i32 {
    [[log(label: "permissions-log-item_begin", expected: "running")]] "running"

    let async_metric: i32 = sync YieldWaitKeyIntegrationHost()

    let wait_metric: i32 = parallel ctx~>cpu() {
        let handle = spawn { 4 }
        wait handle
    }

    var key_gate: shared i32 = 2
    # key_gate read {
        # key_gate release write {
            key_gate = key_gate + 3
        }
    }
    let release_metric: i32 = key_gate

    let wait_after_key_metric: i32 = parallel ctx~>cpu() {
        var local_gate: shared i32 = 1
        # local_gate write {
            local_gate = local_gate + 1
        }
        let local_gate_snapshot: i32 = local_gate
        let handle = spawn { local_gate_snapshot + 2 }
        wait handle
    }

    let wait_diag: string@View = "E-CON-0133"
    let yield_diag: string@View = "E-CON-0213"
    let yield_from_diag: string@View = "E-CON-0224"

    let async_metric_log: i32 = [[log(label: "observed-permissions-YieldWaitKeyIntegration-async", expected: 6)]] async_metric
    let wait_metric_log: i32 = [[log(label: "observed-permissions-YieldWaitKeyIntegration-wait", expected: 4)]] wait_metric
    let release_metric_log: i32 = [[log(label: "observed-permissions-YieldWaitKeyIntegration-release", expected: 5)]] release_metric
    let wait_after_key_metric_log: i32 = [[log(label: "observed-permissions-YieldWaitKeyIntegration-wait-after-key", expected: 4)]] wait_after_key_metric
    let wait_diag_log: string@View = [[log(label: "permissions-YieldWaitKeyIntegration-wait-diagnostic", expected: "E-CON-0133")]] wait_diag
    let yield_diag_log: string@View = [[log(label: "permissions-YieldWaitKeyIntegration-yield-diagnostic", expected: "E-CON-0213")]] yield_diag
    let yield_from_diag_log: string@View = [[log(label: "permissions-YieldWaitKeyIntegration-yield-from-diagnostic", expected: "E-CON-0224")]] yield_from_diag

    let runtime_ok: bool =
        (async_metric_log == 6) &&
        (wait_metric_log == 4) &&
        (release_metric_log == 5) &&
        (wait_after_key_metric_log == 4) &&
        (wait_diag_log == "E-CON-0133") &&
        (yield_diag_log == "E-CON-0213") &&
        (yield_from_diag_log == "E-CON-0224")
    let runtime_ok_log: bool = [[log(label: "permissions-YieldWaitKeyIntegration-runtime", expected: true)]] runtime_ok

    let metric: i32 = if (runtime_ok_log) { 19 } else { 0 }
    let metric_label: string@View = YieldWaitKeyIntegrationMetricLabel(metric)
    let metric_label_log: string@View = [[log(label: "observed-permissions-YieldWaitKeyIntegration-metric", expected: "19")]] metric_label

    if (metric_label_log != "19") {
        [[log(label: "permissions-log-item_fail", expected: "fail")]] "fail"
        return 1
    }

    [[log(label: "permissions-log-item_success", expected: "success")]] "success"
    return 0
}
