procedure YieldWaitKeyIntegrationChild() -> Async<(), (), i32, !> {
    let child_resume: () = yield release ()
    return 5
}

procedure YieldWaitKeyIntegrationHost() -> Async<(), (), i32, !> {
    let host_resume: () = yield release ()
    let child_value: i32 = yield release from YieldWaitKeyIntegrationChild()
    return child_value + 1
}

procedure YieldWaitKeyIntegrationMetricLabel(value: i32) -> string@View {
    if (value == 19) {
        return "19"
    }
    return "other"
}

public procedure RunYieldWaitKeyIntegration(ctx: Context) -> i32 {
    "running"

    let async_metric: i32 = sync YieldWaitKeyIntegrationHost()

    let wait_metric: i32 = parallel ctx~>cpu() {
        let handle = spawn { 4 }
        wait handle
    }

    var key_gate: shared i32 = 2
    # key_gate write {
        let rmw_warning_55 = key_gate
        key_gate = rmw_warning_55 + 3
    }
    let release_metric: i32 = key_gate

    let wait_after_key_metric: i32 = parallel ctx~>cpu() {
        var local_gate: shared i32 = 1
        # local_gate write {
            let rmw_warning_56 = local_gate
            local_gate = rmw_warning_56 + 1
        }
        let local_gate_snapshot: i32 = local_gate
        let handle = spawn { local_gate_snapshot + 2 }
        wait handle
    }

    let wait_diag: string@View = "E-CON-0133"
    let yield_diag: string@View = "E-CON-0213"
    let yield_from_diag: string@View = "E-CON-0224"

    let async_metric_log: i32 = async_metric
    let wait_metric_log: i32 = wait_metric
    let release_metric_log: i32 = release_metric
    let wait_after_key_metric_log: i32 = wait_after_key_metric
    let wait_diag_log: string@View = wait_diag
    let yield_diag_log: string@View = yield_diag
    let yield_from_diag_log: string@View = yield_from_diag

    let runtime_ok: bool =
        (async_metric_log == 6) &&
        (wait_metric_log == 4) &&
        (release_metric_log == 5) &&
        (wait_after_key_metric_log == 4) &&
        (wait_diag_log == "E-CON-0133") &&
        (yield_diag_log == "E-CON-0213") &&
        (yield_from_diag_log == "E-CON-0224")
    let runtime_ok_log: bool = runtime_ok

    let metric: i32 = if (runtime_ok_log) { 19 } else { 0 }
    let metric_label: string@View = YieldWaitKeyIntegrationMetricLabel(metric)
    let metric_label_log: string@View = metric_label

    if (metric_label_log != "19") {
        "fail"
        return 1
    }

    "success"
    return 0
}
