public procedure runGroup(ctx: Context) -> i32 {
    "section-start"

    let status_capture_rules: i32 = RunParallelCaptureRulesConstSharedUnique(ctx)
    if (status_capture_rules != 0) {
        "section-end"
        return status_capture_rules
    }

    let status_closure: i32 = RunParallelClosureCaptureRestrictions(ctx)
    if (status_closure != 0) {
        "section-end"
        return status_closure
    }

    let status_gpu: i32 = RunGpuPermissionCaptureRestrictions(ctx)
    if (status_gpu != 0) {
        "section-end"
        return status_gpu
    }

    let status_dispatch: i32 = RunDispatchKeyClausePartitioning(ctx)
    if (status_dispatch != 0) {
        "section-end"
        return status_dispatch
    }

    let status_yield_wait: i32 = RunYieldWaitKeyIntegration(ctx)
    if (status_yield_wait != 0) {
        "section-end"
        return status_yield_wait
    }

    let status_stale_ok: i32 = RunStalenessSuppressionStaleOk(ctx)
    if (status_stale_ok != 0) {
        "section-end"
        return status_stale_ok
    }

    let status_async_gpu: i32 = RunAsyncGpuAndCaptureDiagnostics(ctx)
    if (status_async_gpu != 0) {
        "section-end"
        return status_async_gpu
    }

    "section-end"
    return 0
}
