procedure GpuPermissionCaptureRestrictionsMetricLabel(value: i32) -> string@View {
    if (value == 34) {
        return "34"
    }
    return "other"
}

public procedure RunGpuPermissionCaptureRestrictions(ctx: Context) -> i32 {
    "running"

    let const_capture: const i32 = 6
    let gpu_const_metric: i32 = parallel ctx~>gpu() {
        const_capture + 1
    }

    let unique_seed: unique i32 = 8
    let gpu_unique_metric: i32 = parallel ctx~>gpu() {
        let local_unique: unique i32 = move unique_seed
        local_unique + 2
    }

    let gpu_dispatch_metric: i32 = parallel ctx~>gpu() {
        dispatch i in 0usize..4usize [reduce: +] {
            (i as i32) + 1
        }
    }

    let cpu_metric: i32 = parallel ctx~>cpu() {
        7
    }

    let shared_capture_diag: string@View = "E-CON-0151"
    let key_block_diag: string@View = "E-CON-0155"

    let gpu_const_metric_log: i32 = gpu_const_metric
    let gpu_unique_metric_log: i32 = gpu_unique_metric
    let gpu_dispatch_metric_log: i32 = gpu_dispatch_metric
    let cpu_metric_log: i32 = cpu_metric
    let shared_capture_diag_log: string@View = shared_capture_diag
    let key_block_diag_log: string@View = key_block_diag

    let runtime_ok: bool =
        (gpu_const_metric_log == 7) &&
        (gpu_unique_metric_log == 10) &&
        (gpu_dispatch_metric_log == 10) &&
        (cpu_metric_log == 7) &&
        (shared_capture_diag_log == "E-CON-0151") &&
        (key_block_diag_log == "E-CON-0155")
    let runtime_ok_log: bool = runtime_ok

    let metric: i32 = if (runtime_ok_log) { 34 } else { 0 }
    let metric_label: string@View = GpuPermissionCaptureRestrictionsMetricLabel(metric)
    let metric_label_log: string@View = metric_label

    if (metric_label_log != "34") {
        "fail"
        return 1
    }

    "success"
    return 0
}
