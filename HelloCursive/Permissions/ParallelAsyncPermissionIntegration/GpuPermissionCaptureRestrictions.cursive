procedure GpuPermissionCaptureRestrictionsMetricLabel(value: i32) -> string@View {
    if (value == 34) {
        return "34"
    }
    return "other"
}

public procedure RunGpuPermissionCaptureRestrictions(ctx: Context) -> i32 {
    [[log(label: "permissions-log-item_begin", expected: "running")]] "running"

    let const_capture: const i32 = 6
    let gpu_const_metric: i32 = parallel ctx~>gpu() {
        const_capture + 1
    }

    let unique_seed: unique i32 = 8
    let gpu_unique_metric: i32 = parallel ctx~>gpu() {
        let local_unique: unique i32 = move unique_seed
        local_unique + 2
    }

    let gpu_dispatch_metric: i32 = parallel ctx~>gpu() {
        dispatch i in 0usize..4usize [reduce: +] {
            (i as i32) + 1
        }
    }

    let cpu_metric: i32 = parallel ctx~>cpu() {
        7
    }

    let shared_capture_diag: string@View = "E-CON-0151"
    let key_block_diag: string@View = "E-CON-0155"

    let gpu_const_metric_log: i32 = [[log(label: "observed-permissions-GpuPermissionCaptureRestrictions-const", expected: 7)]] gpu_const_metric
    let gpu_unique_metric_log: i32 = [[log(label: "observed-permissions-GpuPermissionCaptureRestrictions-unique-move", expected: 10)]] gpu_unique_metric
    let gpu_dispatch_metric_log: i32 = [[log(label: "observed-permissions-GpuPermissionCaptureRestrictions-dispatch", expected: 10)]] gpu_dispatch_metric
    let cpu_metric_log: i32 = [[log(label: "observed-permissions-GpuPermissionCaptureRestrictions-cpu-compare", expected: 7)]] cpu_metric
    let shared_capture_diag_log: string@View = [[log(label: "permissions-GpuPermissionCaptureRestrictions-shared-diagnostic", expected: "E-CON-0151")]] shared_capture_diag
    let key_block_diag_log: string@View = [[log(label: "permissions-GpuPermissionCaptureRestrictions-key-diagnostic", expected: "E-CON-0155")]] key_block_diag

    let runtime_ok: bool =
        (gpu_const_metric_log == 7) &&
        (gpu_unique_metric_log == 10) &&
        (gpu_dispatch_metric_log == 10) &&
        (cpu_metric_log == 7) &&
        (shared_capture_diag_log == "E-CON-0151") &&
        (key_block_diag_log == "E-CON-0155")
    let runtime_ok_log: bool = [[log(label: "permissions-GpuPermissionCaptureRestrictions-runtime", expected: true)]] runtime_ok

    let metric: i32 = if (runtime_ok_log) { 34 } else { 0 }
    let metric_label: string@View = GpuPermissionCaptureRestrictionsMetricLabel(metric)
    let metric_label_log: string@View = [[log(label: "observed-permissions-GpuPermissionCaptureRestrictions-metric", expected: "34")]] metric_label

    if (metric_label_log != "34") {
        [[log(label: "permissions-log-item_fail", expected: "fail")]] "fail"
        return 1
    }

    [[log(label: "permissions-log-item_success", expected: "success")]] "success"
    return 0
}
