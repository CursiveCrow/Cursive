procedure AsyncGpuAndCaptureDiagnosticsWorker() -> Async<(), (), i32, !> {
    let _resume: () = yield release ()
    return 7
}

procedure AsyncGpuAndCaptureDiagnosticsMetricLabel(value: i32) -> string@View {
    if (value == 32) {
        return "32"
    }
    return "other"
}

public procedure RunAsyncGpuAndCaptureDiagnostics(ctx: Context) -> i32 {
    "running"

    let const_metric: i32 = parallel ctx~>cpu() {
        let worker = spawn { 3 + 2 }
        wait worker
    }

    let unique_source: unique i32 = 6
    let unique_target: unique i32 = move unique_source
    let unique_metric: i32 = unique_target + 4

    let async_metric: i32 = sync AsyncGpuAndCaptureDiagnosticsWorker()

    let dispatch_metric: i32 = parallel ctx~>cpu() {
        dispatch _ in 0usize..3usize [reduce: +] { 1 }
    }

    let diag_unique_multi_capture: string@View = "E-CON-0122"
    let diag_spawn_capture_surface: string@View = "E-CON-0130"
    let diag_gpu_non_safe: string@View = "E-CON-0153"
    let diag_gpu_barrier_divergence: string@View = "E-CON-0158"
    let diag_gpu_type_layout: string@View = "E-TYP-2640"
    let diag_gpu_type_effect: string@View = "E-TYP-2642"
    let diag_wait_operand: string@View = "E-CON-0132"
    let diag_cross_iteration_dependency: string@View = "E-CON-0142"
    let diag_non_associative_reduction: string@View = "E-CON-0143"
    let diag_gpu_nested_parallel: string@View = "E-CON-0152"
    let diag_gpu_intrinsic_outside: string@View = "E-CON-0154"
    let diag_gpu_barrier_outside: string@View = "E-CON-0156"
    let diag_gpu_workgroup_limit: string@View = "E-CON-0157"
    let diag_async_capture_escape: string@View = "E-CON-0280"
    let diag_async_capture_lifetime: string@View = "E-CON-0281"
    let warn_shared_capture: string@View = "W-CON-0009"

    let const_metric_log: i32 = const_metric
    let unique_metric_log: i32 = unique_metric
    let async_metric_log: i32 = async_metric
    let dispatch_metric_log: i32 = dispatch_metric

    let diag_unique_multi_capture_log: string@View = diag_unique_multi_capture
    let diag_spawn_capture_surface_log: string@View = diag_spawn_capture_surface
    let diag_gpu_non_safe_log: string@View = diag_gpu_non_safe
    let diag_gpu_barrier_divergence_log: string@View = diag_gpu_barrier_divergence
    let diag_gpu_type_layout_log: string@View = diag_gpu_type_layout
    let diag_gpu_type_effect_log: string@View = diag_gpu_type_effect
    let diag_wait_operand_log: string@View = diag_wait_operand
    let diag_cross_iteration_dependency_log: string@View = diag_cross_iteration_dependency
    let diag_non_associative_reduction_log: string@View = diag_non_associative_reduction
    let diag_gpu_nested_parallel_log: string@View = diag_gpu_nested_parallel
    let diag_gpu_intrinsic_outside_log: string@View = diag_gpu_intrinsic_outside
    let diag_gpu_barrier_outside_log: string@View = diag_gpu_barrier_outside
    let diag_gpu_workgroup_limit_log: string@View = diag_gpu_workgroup_limit
    let diag_async_capture_escape_log: string@View = diag_async_capture_escape
    let diag_async_capture_lifetime_log: string@View = diag_async_capture_lifetime
    let warn_shared_capture_log: string@View = warn_shared_capture

    let runtime_ok: bool =
        (const_metric_log == 5) &&
        (unique_metric_log == 10) &&
        (async_metric_log == 7) &&
        (dispatch_metric_log == 3) &&
        (diag_unique_multi_capture_log == "E-CON-0122") &&
        (diag_spawn_capture_surface_log == "E-CON-0130") &&
        (diag_gpu_non_safe_log == "E-CON-0153") &&
        (diag_gpu_barrier_divergence_log == "E-CON-0158") &&
        (diag_gpu_type_layout_log == "E-TYP-2640") &&
        (diag_gpu_type_effect_log == "E-TYP-2642") &&
        (diag_wait_operand_log == "E-CON-0132") &&
        (diag_cross_iteration_dependency_log == "E-CON-0142") &&
        (diag_non_associative_reduction_log == "E-CON-0143") &&
        (diag_gpu_nested_parallel_log == "E-CON-0152") &&
        (diag_gpu_intrinsic_outside_log == "E-CON-0154") &&
        (diag_gpu_barrier_outside_log == "E-CON-0156") &&
        (diag_gpu_workgroup_limit_log == "E-CON-0157") &&
        (diag_async_capture_escape_log == "E-CON-0280") &&
        (diag_async_capture_lifetime_log == "E-CON-0281") &&
        (warn_shared_capture_log == "W-CON-0009")
    let runtime_ok_log: bool = runtime_ok

    let metric: i32 = if (runtime_ok_log) { 32 } else { 0 }
    let metric_label: string@View = AsyncGpuAndCaptureDiagnosticsMetricLabel(metric)
    let metric_label_log: string@View = metric_label

    if (metric_label_log != "32") {
        "fail"
        return 1
    }

    "success"
    return 0
}
