record KeyCompatibilityPair {
    left: i32
    right: i32
}

procedure KeyCompatibilityCoverageMetricLabel(value: i32) -> string@View {
    if (value == 13) {
        return "13"
    }
    return "other"
}

public procedure RunKeyCompatibilityCoverage(ctx: Context) -> i32 {
    let _ = ctx
    "running"

    var pair: shared KeyCompatibilityPair = KeyCompatibilityPair {
        left: 2,
        right: 5
    }

    var same_path_read_metric: i32 = 0
    # pair.left read {
        same_path_read_metric = pair.left
        same_path_read_metric += pair.left
    }

    # pair.right write {
        let rmw_warning_45 = pair.right
        pair.right = rmw_warning_45 + 4
    }

    var disjoint_read_metric: i32 = 0
    # pair.right read {
        disjoint_read_metric = pair.right
    }

    let compatibility_metric: i32 = same_path_read_metric + disjoint_read_metric
    let diagnostic_code: string@View = "E-CON-0010"

    let same_path_log: i32 = same_path_read_metric
    let disjoint_read_log: i32 = disjoint_read_metric
    let compatibility_metric_log: i32 = compatibility_metric
    let diagnostic_log: string@View = diagnostic_code

    let runtime_ok: bool =
        (same_path_log == 4) &&
        (disjoint_read_log == 9) &&
        (compatibility_metric_log == 13) &&
        (diagnostic_log == "E-CON-0010")
    let runtime_ok_log: bool = runtime_ok

    let metric: i32 = if (runtime_ok_log) { 13 } else { 0 }
    let metric_label: string@View = KeyCompatibilityCoverageMetricLabel(metric)
    let metric_label_log: string@View = metric_label

    if (metric_label_log != "13") {
        "fail"
        return 1
    }

    "success"
    return 0
}
