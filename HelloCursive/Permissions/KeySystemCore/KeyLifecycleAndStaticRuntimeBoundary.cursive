procedure KeyLifecycleAndStaticRuntimeBoundaryMetricLabel(value: i32) -> string@View {
    if (value == 33) {
        return "33"
    }
    return "other"
}

[[dynamic]]
public procedure RunKeyLifecycleAndStaticRuntimeBoundary(ctx: Context) -> i32 {
    "running"

    var gate: shared i32 = 5
    var statement_read_metric: i32 = 0
    # gate read {
        statement_read_metric = gate
    }

    # gate write {
        let rmw_warning_46 = gate
        gate = rmw_warning_46 + 4
    }
    let post_write_metric: i32 = gate

    let parallel_wait_metric: i32 = parallel ctx~>cpu() {
        var local_gate: shared i32 = 3
        # local_gate write {
            let rmw_warning_47 = local_gate
            local_gate = rmw_warning_47 + 2
        }
        let local_snapshot: i32 = local_gate
        let worker = spawn { local_snapshot + 1 }
        wait worker
    }

    var dynamic_slots: shared [i32; 3] = [1, 3, 5]
    let dynamic_index: usize = 2usize
    var dynamic_read_metric: i32 = 0
    # dynamic_slots[dynamic_index] dynamic read {
        dynamic_read_metric = dynamic_slots[dynamic_index]
    }

    let diag_mode: string@View = "E-CON-0005"
    let diag_release: string@View = "E-CON-0006"
    let diag_dynamic_required: string@View = "E-CON-0014"
    let diag_pointer_boundary: string@View = "E-CON-0034"
    let info_dynamic_sync: string@View = "I-CON-0011"
    let info_static_safe: string@View = "I-CON-0013"
    let warn_acquire_order: string@View = "W-CON-0001"
    let warn_release_scope: string@View = "W-CON-0002"

    let statement_read_metric_log: i32 = statement_read_metric
    let post_write_metric_log: i32 = post_write_metric
    let parallel_wait_metric_log: i32 = parallel_wait_metric
    let dynamic_read_metric_log: i32 = dynamic_read_metric

    let diag_mode_log: string@View = diag_mode
    let diag_release_log: string@View = diag_release
    let diag_dynamic_required_log: string@View = diag_dynamic_required
    let diag_pointer_boundary_log: string@View = diag_pointer_boundary
    let info_dynamic_sync_log: string@View = info_dynamic_sync
    let info_static_safe_log: string@View = info_static_safe
    let warn_acquire_order_log: string@View = warn_acquire_order
    let warn_release_scope_log: string@View = warn_release_scope

    let runtime_ok: bool =
        (statement_read_metric_log == 5) &&
        (post_write_metric_log == 9) &&
        (parallel_wait_metric_log == 6) &&
        (dynamic_read_metric_log == 5) &&
        (diag_mode_log == "E-CON-0005") &&
        (diag_release_log == "E-CON-0006") &&
        (diag_dynamic_required_log == "E-CON-0014") &&
        (diag_pointer_boundary_log == "E-CON-0034") &&
        (info_dynamic_sync_log == "I-CON-0011") &&
        (info_static_safe_log == "I-CON-0013") &&
        (warn_acquire_order_log == "W-CON-0001") &&
        (warn_release_scope_log == "W-CON-0002")
    let runtime_ok_log: bool = runtime_ok

    let metric: i32 = if (runtime_ok_log) { 33 } else { 0 }
    let metric_label: string@View = KeyLifecycleAndStaticRuntimeBoundaryMetricLabel(metric)
    let metric_label_log: string@View = metric_label

    if (metric_label_log != "33") {
        "fail"
        return 1
    }

    "success"
    return 0
}
