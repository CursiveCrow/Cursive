procedure KeyModeInferenceMetricLabel(value: i32) -> string@View {
    if (value == 40) {
        return "40"
    }
    return "other"
}

public procedure RunKeyModeInferenceReadWrite(ctx: Context) -> i32 {
    let _ = ctx
    [[log(label: "permissions-log-item_begin", expected: "running")]] "running"

    var gate: shared i32 = 10

    var read_before_write: i32 = 0
    # gate read {
        read_before_write = gate
    }

    # gate write {
        gate = gate + 5
    }

    var read_after_write: i32 = 0
    # gate read {
        read_after_write = gate
    }

    let mode_total_metric: i32 = read_before_write + read_after_write + gate
    let mode_anchor: string@View = "K-Mode-Write"

    let read_before_log: i32 = [[log(label: "observed-permissions-KeyModeInferenceReadWrite-read-before", expected: 10)]] read_before_write
    let read_after_log: i32 = [[log(label: "observed-permissions-KeyModeInferenceReadWrite-read-after", expected: 15)]] read_after_write
    let gate_log: i32 = [[log(label: "observed-permissions-KeyModeInferenceReadWrite-gate", expected: 15)]] gate
    let mode_total_log: i32 = [[log(label: "observed-permissions-KeyModeInferenceReadWrite-total", expected: 40)]] mode_total_metric
    let mode_anchor_log: string@View = [[log(label: "permissions-KeyModeInferenceReadWrite-anchor", expected: "K-Mode-Write")]] mode_anchor

    let runtime_ok: bool =
        (read_before_log == 10) &&
        (read_after_log == 15) &&
        (gate_log == 15) &&
        (mode_total_log == 40) &&
        (mode_anchor_log == "K-Mode-Write")
    let runtime_ok_log: bool = [[log(label: "permissions-KeyModeInferenceReadWrite-runtime", expected: true)]] runtime_ok

    let metric: i32 = if (runtime_ok_log) { 40 } else { 0 }
    let metric_label: string@View = KeyModeInferenceMetricLabel(metric)
    let metric_label_log: string@View = [[log(label: "observed-permissions-KeyModeInferenceReadWrite-metric", expected: "40")]] metric_label

    if (metric_label_log != "40") {
        [[log(label: "permissions-log-item_fail", expected: "fail")]] "fail"
        return 1
    }

    [[log(label: "permissions-log-item_success", expected: "success")]] "success"
    return 0
}
