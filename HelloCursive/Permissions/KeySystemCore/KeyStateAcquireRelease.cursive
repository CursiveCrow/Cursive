procedure KeyStateAcquireReleaseMetricLabel(value: i32) -> string@View {
    if (value == 27) {
        return "27"
    }
    return "other"
}

public procedure RunKeyStateAcquireRelease(ctx: Context) -> i32 {
    let _ = ctx
    "running"

    var gate: shared i32 = 4
    var outer_read_metric: i32 = 0
    var release_write_metric: i32 = 0
    var post_release_metric: i32 = 0

    # gate write {
        outer_read_metric = gate
        let rmw_warning_51 = gate
        gate = rmw_warning_51 + 3
        release_write_metric = gate
        post_release_metric = gate
    }

    # gate write {
        let rmw_warning_52 = gate
        gate = rmw_warning_52 + 2
    }
    let final_gate_metric: i32 = gate

    let diagnostic_code: string@View = "E-CON-0133"

    let outer_read_log: i32 = outer_read_metric
    let release_write_log: i32 = release_write_metric
    let post_release_log: i32 = post_release_metric
    let final_gate_log: i32 = final_gate_metric
    let diagnostic_log: string@View = diagnostic_code

    let runtime_ok: bool =
        (outer_read_log == 4) &&
        (release_write_log == 7) &&
        (post_release_log == 7) &&
        (final_gate_log == 9) &&
        (diagnostic_log == "E-CON-0133")
    let runtime_ok_log: bool = runtime_ok

    let metric: i32 = if (runtime_ok_log) { 27 } else { 0 }
    let metric_label: string@View = KeyStateAcquireReleaseMetricLabel(metric)
    let metric_label_log: string@View = metric_label

    if (metric_label_log != "27") {
        "fail"
        return 1
    }

    "success"
    return 0
}
