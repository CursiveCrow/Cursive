public procedure runGroup(ctx: Context) -> i32 {
    "section-start"

    let status_capture: i32 = RunSharedClosureCaptureLocalVsEscaping(ctx)
    if (status_capture != 0) {
        "section-end"
        return status_capture
    }

    let status_class: i32 = RunSharedDynamicClassRestrictions(ctx)
    if (status_class != 0) {
        "section-end"
        return status_class
    }

    let status_dynamic_key: i32 = RunDynamicKeyVerificationAndRuntimeSync(ctx)
    if (status_dynamic_key != 0) {
        "section-end"
        return status_dynamic_key
    }

    let status_locking: i32 = RunDynamicLockOrderingAndProgress(ctx)
    if (status_locking != 0) {
        "section-end"
        return status_locking
    }

    "section-end"
    return 0
}
