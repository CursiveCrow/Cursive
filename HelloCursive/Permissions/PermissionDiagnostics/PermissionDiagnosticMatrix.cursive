procedure PermissionDiagnosticMatrixMetricLabel(value: i32) -> string@View {
    if (value == 21) {
        return "21"
    }
    return "other"
}

public procedure RunPermissionDiagnosticMatrix(ctx: Context) -> i32 {
    let _ = ctx
    "running"

    let typ_1601: string@View = "E-TYP-1601"
    let typ_1602: string@View = "E-TYP-1602"
    let typ_1603: string@View = "E-TYP-1603"
    let typ_1604: string@View = "E-TYP-1604"
    let typ_1605: string@View = "E-TYP-1605"

    let con_0010: string@View = "E-CON-0010"
    let con_0020: string@View = "E-CON-0020"
    let con_0085: string@View = "E-CON-0085"
    let con_0086: string@View = "E-CON-0086"
    let con_0090: string@View = "E-CON-0090"
    let con_0095: string@View = "E-CON-0095"
    let con_0131: string@View = "E-CON-0131"
    let con_0133: string@View = "E-CON-0133"
    let con_0141: string@View = "E-CON-0141"
    let con_0150: string@View = "E-CON-0150"
    let con_0151: string@View = "E-CON-0151"
    let con_0155: string@View = "E-CON-0155"
    let con_0213: string@View = "E-CON-0213"
    let con_0224: string@View = "E-CON-0224"

    let wcon_0011: string@View = "W-CON-0011"
    let wcon_0140: string@View = "W-CON-0140"

    let typ_1601_log: string@View = typ_1601
    let typ_1602_log: string@View = typ_1602
    let typ_1603_log: string@View = typ_1603
    let typ_1604_log: string@View = typ_1604
    let typ_1605_log: string@View = typ_1605

    let con_0010_log: string@View = con_0010
    let con_0020_log: string@View = con_0020
    let con_0085_log: string@View = con_0085
    let con_0086_log: string@View = con_0086
    let con_0090_log: string@View = con_0090
    let con_0095_log: string@View = con_0095
    let con_0131_log: string@View = con_0131
    let con_0133_log: string@View = con_0133
    let con_0141_log: string@View = con_0141
    let con_0150_log: string@View = con_0150
    let con_0151_log: string@View = con_0151
    let con_0155_log: string@View = con_0155
    let con_0213_log: string@View = con_0213
    let con_0224_log: string@View = con_0224

    let wcon_0011_log: string@View = wcon_0011
    let wcon_0140_log: string@View = wcon_0140

    let matrix_ok: bool =
        (typ_1601_log == "E-TYP-1601") &&
        (typ_1602_log == "E-TYP-1602") &&
        (typ_1603_log == "E-TYP-1603") &&
        (typ_1604_log == "E-TYP-1604") &&
        (typ_1605_log == "E-TYP-1605") &&
        (con_0010_log == "E-CON-0010") &&
        (con_0020_log == "E-CON-0020") &&
        (con_0085_log == "E-CON-0085") &&
        (con_0086_log == "E-CON-0086") &&
        (con_0090_log == "E-CON-0090") &&
        (con_0095_log == "E-CON-0095") &&
        (con_0131_log == "E-CON-0131") &&
        (con_0133_log == "E-CON-0133") &&
        (con_0141_log == "E-CON-0141") &&
        (con_0150_log == "E-CON-0150") &&
        (con_0151_log == "E-CON-0151") &&
        (con_0155_log == "E-CON-0155") &&
        (con_0213_log == "E-CON-0213") &&
        (con_0224_log == "E-CON-0224") &&
        (wcon_0011_log == "W-CON-0011") &&
        (wcon_0140_log == "W-CON-0140")
    let matrix_ok_log: bool =
        matrix_ok

    let cardinality: i32 = if (matrix_ok_log == true) { 21 } else { 0 }
    let cardinality_log: i32 = cardinality

    let metric: i32 = if (cardinality_log == 21) { 21 } else { 0 }
    let metric_label: string@View = PermissionDiagnosticMatrixMetricLabel(metric)
    let metric_label_log: string@View =
        metric_label
    if (metric_label_log != "21") {
        "fail"
        return 1
    }

    "success"
    return 0
}
