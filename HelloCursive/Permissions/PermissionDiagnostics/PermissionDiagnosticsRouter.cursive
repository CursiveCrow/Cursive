public procedure runGroup(ctx: Context) -> i32 {
    "section-start"

    let status_matrix: i32 = RunPermissionDiagnosticMatrix(ctx)
    if (status_matrix != 0) {
        "section-end"
        return status_matrix
    }

    let status_extended: i32 = RunPermissionDiagnosticExtendedMatrix(ctx)
    if (status_extended != 0) {
        "section-end"
        return status_extended
    }

    "section-end"
    return 0
}
