procedure PermissionSyntaxDefaultsReadConst(value: const i32) -> i32 {
    return value
}

procedure PermissionSyntaxDefaultsReadShared(value: shared i32) -> i32 {
    return value
}

procedure PermissionSyntaxDefaultsReadUnique(value: unique i32) -> i32 {
    return value
}

procedure PermissionSyntaxDefaultsMetricLabel(value: i32) -> string@View {
    if (value == 38) {
        return "38"
    }
    return "other"
}

public procedure RunPermissionSyntaxAndDefaults(ctx: Context) -> i32 {
    let _ = ctx
    [[log(label: "permissions-log-item_begin", expected: "running")]] "running"

    let inferred_default: i32 = 10
    let inferred_const: const i32 = inferred_default

    var mutable_default: i32 = 3
    mutable_default = mutable_default + 2

    let shared_owner: unique i32 = 7
    let shared_view: shared i32 = shared_owner

    let unique_value: unique i32 = 9

    let const_metric: i32 = PermissionSyntaxDefaultsReadConst(inferred_const) + PermissionSyntaxDefaultsReadConst(shared_view)
    let shared_metric: i32 = PermissionSyntaxDefaultsReadShared(shared_view)
    let unique_metric: i32 = PermissionSyntaxDefaultsReadUnique(unique_value)
    let mutable_metric: i32 = mutable_default

    let diagnostic_code: string@View = "E-TYP-1601"

    let const_metric_log: i32 = [[log(label: "observed-permissions-PermissionSyntaxAndDefaults-const", expected: 17)]] const_metric
    let shared_metric_log: i32 = [[log(label: "observed-permissions-PermissionSyntaxAndDefaults-shared", expected: 7)]] shared_metric
    let unique_metric_log: i32 = [[log(label: "observed-permissions-PermissionSyntaxAndDefaults-unique", expected: 9)]] unique_metric
    let mutable_metric_log: i32 = [[log(label: "observed-permissions-PermissionSyntaxAndDefaults-mutable-default", expected: 5)]] mutable_metric
    let diagnostic_log: string@View = [[log(label: "permissions-PermissionSyntaxAndDefaults-diagnostic", expected: "E-TYP-1601")]] diagnostic_code

    let runtime_ok: bool =
        (const_metric_log == 17) &&
        (shared_metric_log == 7) &&
        (unique_metric_log == 9) &&
        (mutable_metric_log == 5) &&
        (diagnostic_log == "E-TYP-1601")
    let runtime_ok_log: bool = [[log(label: "permissions-PermissionSyntaxAndDefaults-runtime", expected: true)]] runtime_ok

    let metric: i32 = if (runtime_ok_log) { 38 } else { 0 }
    let metric_label: string@View = PermissionSyntaxDefaultsMetricLabel(metric)
    let metric_label_log: string@View = [[log(label: "observed-permissions-PermissionSyntaxAndDefaults-metric", expected: "38")]] metric_label

    if (metric_label_log != "38") {
        [[log(label: "permissions-log-item_fail", expected: "fail")]] "fail"
        return 1
    }

    [[log(label: "permissions-log-item_success", expected: "success")]] "success"
    return 0
}
