procedure NestedReleaseAndReacquireMetricLabel(value: i32) -> string@View {
    if (value == 54) {
        return "54"
    }
    return "other"
}

public procedure RunNestedReleaseAndReacquire(ctx: Context) -> i32 {
    let _ = ctx
    "running"

    var gate: shared i32 = 10
    var outer_before: i32 = 0
    var inner_write_value: i32 = 0
    var outer_after: i32 = 0

    # gate write {
        outer_before = gate
        let rmw_warning_32 = gate
        gate = rmw_warning_32 + 2
        inner_write_value = gate
        outer_after = gate
    }

    var write_outer_before: i32 = 0
    var inner_read_value: i32 = 0
    var write_outer_after: i32 = 0

    # gate write {
        write_outer_before = gate
        inner_read_value = gate
        let rmw_warning_33 = gate
        gate = rmw_warning_33 + 4
        write_outer_after = gate
    }

    let diagnostic_code: string@View = "W-CON-0011"

    let outer_before_log: i32 = outer_before
    let inner_write_log: i32 = inner_write_value
    let outer_after_log: i32 = outer_after
    let write_outer_before_log: i32 = write_outer_before
    let inner_read_log: i32 = inner_read_value
    let write_outer_after_log: i32 = write_outer_after
    let diagnostic_log: string@View = diagnostic_code

    let runtime_ok: bool =
        (outer_before_log == 10) &&
        (inner_write_log == 12) &&
        (outer_after_log == 12) &&
        (write_outer_before_log == 12) &&
        (inner_read_log == 12) &&
        (write_outer_after_log == 16) &&
        (diagnostic_log == "W-CON-0011")
    let runtime_ok_log: bool = runtime_ok

    let metric: i32 = if (runtime_ok_log) { 54 } else { 0 }
    let metric_label: string@View = NestedReleaseAndReacquireMetricLabel(metric)
    let metric_label_log: string@View = metric_label

    if (metric_label_log != "54") {
        "fail"
        return 1
    }

    "success"
    return 0
}
