procedure KeyConflictDetectionMetricLabel(value: i32) -> string@View {
    if (value == 18) {
        return "18"
    }
    return "other"
}

public procedure RunKeyConflictDetectionAndReadWriteProhibition(ctx: Context) -> i32 {
    [[log(label: "permissions-log-item_begin", expected: "running")]] "running"

    var slots: shared [i32; 4] = [1, 3, 5, 7]

    var read_metric: i32 = 0
    # slots[2usize] read {
        read_metric = slots[2usize]
    }

    # slots[2usize] write {
        let rmw_warning_31 = slots[2usize]
        slots[2usize] = rmw_warning_31 + 4
    }

    var post_write_metric: i32 = 0
    # slots[2usize] read {
        post_write_metric = slots[2usize]
    }

    let dispatch_metric: i32 = parallel ctx~>cpu() {
        var dispatch_gate: i32 = 1
        dispatch i in 0usize..2usize key dispatch_gate read [reduce: +] { 2 }
    }

    let conflict_anchor: string@View = "read-then-write-requires-coverage"
    let diagnostic_code: string@View = "E-CON-0010"

    let read_metric_log: i32 = [[log(label: "observed-permissions-KeyConflictDetectionAndReadWriteProhibition-read", expected: 5)]] read_metric
    let post_write_metric_log: i32 = [[log(label: "observed-permissions-KeyConflictDetectionAndReadWriteProhibition-post-write", expected: 9)]] post_write_metric
    let dispatch_metric_log: i32 = [[log(label: "observed-permissions-KeyConflictDetectionAndReadWriteProhibition-dispatch", expected: 4)]] dispatch_metric
    let anchor_log: string@View = [[log(label: "permissions-KeyConflictDetectionAndReadWriteProhibition-anchor", expected: "read-then-write-requires-coverage")]] conflict_anchor
    let diagnostic_log: string@View = [[log(label: "permissions-KeyConflictDetectionAndReadWriteProhibition-diagnostic", expected: "E-CON-0010")]] diagnostic_code

    let runtime_ok: bool =
        (read_metric_log == 5) &&
        (post_write_metric_log == 9) &&
        (dispatch_metric_log == 4) &&
        (anchor_log == "read-then-write-requires-coverage") &&
        (diagnostic_log == "E-CON-0010")
    let runtime_ok_log: bool = [[log(label: "permissions-KeyConflictDetectionAndReadWriteProhibition-runtime", expected: true)]] runtime_ok

    let metric: i32 = if (runtime_ok_log) { 18 } else { 0 }
    let metric_label: string@View = KeyConflictDetectionMetricLabel(metric)
    let metric_label_log: string@View = [[log(label: "observed-permissions-KeyConflictDetectionAndReadWriteProhibition-metric", expected: "18")]] metric_label

    if (metric_label_log != "18") {
        [[log(label: "permissions-log-item_fail", expected: "fail")]] "fail"
        return 1
    }

    [[log(label: "permissions-log-item_success", expected: "success")]] "success"
    return 0
}
