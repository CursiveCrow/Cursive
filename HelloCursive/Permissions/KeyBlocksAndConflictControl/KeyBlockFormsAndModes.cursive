procedure KeyBlockFormsAndModesMetricLabel(value: i32) -> string@View {
    if (value == 46) {
        return "46"
    }
    return "other"
}

[[dynamic]]
public procedure RunKeyBlockFormsAndModes(ctx: Context) -> i32 {
    [[log(label: "permissions-log-item_begin", expected: "running")]] "running"

    var gate: shared i32 = 4
    var read_metric: i32 = 0
    # gate read {
        read_metric = gate
    }

    # gate write {
        gate = gate + 3
    }
    let write_metric: i32 = gate

    # gate read {
        # gate release write {
            gate = gate + 2
        }
    }
    let release_metric: i32 = gate

    var dynamic_slots: shared [i32; 3] = [2, 4, 6]
    let dynamic_index: usize = 1usize
    var dynamic_metric: i32 = 0
    # dynamic_slots[dynamic_index] dynamic read {
        dynamic_metric = dynamic_slots[dynamic_index]
    }

    let dispatch_metric: i32 = parallel ctx~>cpu() {
        var dispatch_gate: i32 = 2
        dispatch _ in 0usize..4usize key dispatch_gate read [reduce: +] { 2 }
    }

    let diagnostic_nested_mode_mismatch: string@View = "E-CON-0012"
    let diagnostic_path_not_scope: string@View = "E-CON-0031"

    let read_metric_log: i32 = [[log(label: "observed-permissions-KeyBlockFormsAndModes-read", expected: 4)]] read_metric
    let write_metric_log: i32 = [[log(label: "observed-permissions-KeyBlockFormsAndModes-write", expected: 7)]] write_metric
    let release_metric_log: i32 = [[log(label: "observed-permissions-KeyBlockFormsAndModes-release", expected: 9)]] release_metric
    let dynamic_metric_log: i32 = [[log(label: "observed-permissions-KeyBlockFormsAndModes-dynamic", expected: 4)]] dynamic_metric
    let dispatch_metric_log: i32 = [[log(label: "observed-permissions-KeyBlockFormsAndModes-dispatch", expected: 8)]] dispatch_metric
    let diagnostic_nested_mode_mismatch_log: string@View = [[log(label: "permissions-KeyBlockFormsAndModes-diag-nested-mode", expected: "E-CON-0012")]] diagnostic_nested_mode_mismatch
    let diagnostic_path_not_scope_log: string@View = [[log(label: "permissions-KeyBlockFormsAndModes-diag-path-scope", expected: "E-CON-0031")]] diagnostic_path_not_scope

    let runtime_ok: bool =
        (read_metric_log == 4) &&
        (write_metric_log == 7) &&
        (release_metric_log == 9) &&
        (dynamic_metric_log == 4) &&
        (dispatch_metric_log == 8) &&
        (diagnostic_nested_mode_mismatch_log == "E-CON-0012") &&
        (diagnostic_path_not_scope_log == "E-CON-0031")
    let runtime_ok_log: bool = [[log(label: "permissions-KeyBlockFormsAndModes-runtime", expected: true)]] runtime_ok

    let metric: i32 = if (runtime_ok_log) { 46 } else { 0 }
    let metric_label: string@View = KeyBlockFormsAndModesMetricLabel(metric)
    let metric_label_log: string@View = [[log(label: "observed-permissions-KeyBlockFormsAndModes-metric", expected: "46")]] metric_label

    if (metric_label_log != "46") {
        [[log(label: "permissions-log-item_fail", expected: "fail")]] "fail"
        return 1
    }

    [[log(label: "permissions-log-item_success", expected: "success")]] "success"
    return 0
}
