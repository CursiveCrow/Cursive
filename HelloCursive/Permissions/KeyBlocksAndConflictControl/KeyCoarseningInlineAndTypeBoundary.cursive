record KeyCoarseningInner {
    leaf: i32
}

record KeyCoarseningOuter {
    #inner: KeyCoarseningInner
    side: i32
}

procedure KeyCoarseningInlineAndTypeBoundaryMetricLabel(value: i32) -> string@View {
    if (value == 26) {
        return "26"
    }
    return "other"
}

[[dynamic]]
public procedure RunKeyCoarseningInlineAndTypeBoundary(ctx: Context) -> i32 {
    let _ = ctx
    "running"

    var outer: shared KeyCoarseningOuter = KeyCoarseningOuter {
        inner: KeyCoarseningInner { leaf: 6 },
        side: 2
    }

    var inline_read_metric: i32 = 0
    # outer.inner read {
        inline_read_metric = outer.inner.leaf
    }

    # outer.inner write {
        let rmw_warning_29 = outer.inner.leaf
        outer.inner.leaf = rmw_warning_29 + 3
    }

    # outer.inner write {
        let rmw_warning_30 = outer.inner.leaf
        outer.inner.leaf = rmw_warning_30 + outer.side
    }
    let boundary_metric: i32 = outer.inner.leaf

    var slots: shared [i32; 3] = [1, 3, 5]
    let slot_index: usize = 2usize
    var index_coarsen_metric: i32 = 0
    # slots[#slot_index] read {
        index_coarsen_metric = slots[slot_index]
    }

    let diagnostic_code: string@View = "E-CON-0033"

    let inline_read_log: i32 = inline_read_metric
    let boundary_metric_log: i32 = boundary_metric
    let index_coarsen_log: i32 = index_coarsen_metric
    let diagnostic_log: string@View = diagnostic_code

    let runtime_ok: bool =
        (inline_read_log == 6) &&
        (boundary_metric_log == 11) &&
        (index_coarsen_log == 5) &&
        (diagnostic_log == "E-CON-0033")
    let runtime_ok_log: bool = runtime_ok

    let metric: i32 = if (runtime_ok_log) { 26 } else { 0 }
    let metric_label: string@View = KeyCoarseningInlineAndTypeBoundaryMetricLabel(metric)
    let metric_label_log: string@View = metric_label

    if (metric_label_log != "26") {
        "fail"
        return 1
    }

    "success"
    return 0
}
