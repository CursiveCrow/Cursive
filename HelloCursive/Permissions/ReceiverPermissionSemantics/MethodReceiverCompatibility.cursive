record MethodReceiverCompatibilityProbe {
    value: i32

    procedure read(~) -> i32 {
        return self.value
    }

    procedure read_sync(~%) -> i32 {
        return self.value
    }

    procedure write_unique(~!) -> i32 {
        return self.value + 3
    }
}

procedure MethodReceiverCompatibilityMetricLabel(value: i32) -> string@View {
    if (value == 23) {
        return "23"
    }
    return "other"
}

public procedure RunMethodReceiverCompatibility(ctx: Context) -> i32 {
    let _ = ctx
    [[log(label: "permissions-log-item_begin", expected: "running")]] "running"

    var unique_probe: unique MethodReceiverCompatibilityProbe = MethodReceiverCompatibilityProbe { value: 5 }
    let unique_read: i32 = unique_probe~>read()
    let unique_sync: i32 = unique_probe~>read_sync()
    let unique_write: i32 = unique_probe~>write_unique()

    let shared_seed: unique MethodReceiverCompatibilityProbe = MethodReceiverCompatibilityProbe { value: 20 }
    let shared_probe: shared MethodReceiverCompatibilityProbe = shared_seed
    let shared_read: i32 = shared_probe~>read()
    let shared_sync: i32 = shared_probe~>read_sync()

    let recv_perm_diag: string@View = "E-TYP-1605"

    let unique_read_log: i32 = [[log(label: "observed-permissions-method-recv-unique-read", expected: 5)]] unique_read
    let unique_sync_log: i32 = [[log(label: "observed-permissions-method-recv-unique-sync", expected: 5)]] unique_sync
    let unique_write_log: i32 = [[log(label: "observed-permissions-method-recv-unique-write", expected: 8)]] unique_write
    let shared_read_log: i32 = [[log(label: "observed-permissions-method-recv-shared-read", expected: 20)]] shared_read
    let shared_sync_log: i32 = [[log(label: "observed-permissions-method-recv-shared-sync", expected: 20)]] shared_sync
    let recv_perm_diag_log: string@View = [[log(label: "permissions-method-recv-diag-anchor", expected: "E-TYP-1605")]] recv_perm_diag

    let runtime_ok: bool =
        (unique_read_log == 5) &&
        (unique_sync_log == 5) &&
        (unique_write_log == 8) &&
        (shared_read_log == 20) &&
        (shared_sync_log == 20) &&
        (recv_perm_diag_log == "E-TYP-1605")
    let runtime_ok_log: bool = [[log(label: "permissions-method-recv-runtime", expected: true)]] runtime_ok

    let metric: i32 = if (runtime_ok_log == true) { 23 } else { 0 }
    let metric_label: string@View = MethodReceiverCompatibilityMetricLabel(metric)
    let metric_label_log: string@View = [[log(label: "observed-permissions-method-recv-metric", expected: "23")]] metric_label
    if (metric_label_log != "23") {
        [[log(label: "permissions-log-item_fail", expected: "fail")]] "fail"
        return 1
    }

    [[log(label: "permissions-log-item_success", expected: "success")]] "success"
    return 0
}
