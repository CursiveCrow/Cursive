record PermissionTokenInventoryProbe {
    value: i32

    procedure read(~) -> i32 {
        return self.value
    }

    procedure read_sync(~%) -> i32 {
        return self.value
    }

    procedure write_unique(~!) -> i32 {
        return self.value + 4
    }
}

procedure PermissionTokenInventoryReadConst(value: const i32) -> i32 {
    return value
}

procedure PermissionTokenInventoryReadShared(value: shared i32) -> i32 {
    return value
}

procedure PermissionTokenInventoryReadUnique(value: unique i32) -> i32 {
    return value
}

procedure PermissionTokenInventoryMetricLabel(value: i32) -> string@View {
    if (value == 77) {
        return "77"
    }
    return "other"
}

public procedure RunPermissionTokenInventoryCoverage(ctx: Context) -> i32 {
    let _ = ctx
    "running"

    var receiver_probe: unique PermissionTokenInventoryProbe =
        PermissionTokenInventoryProbe { value: 9 }
    let receiver_const_metric: i32 = receiver_probe~>read()
    let receiver_shared_metric: i32 = receiver_probe~>read_sync()
    let receiver_unique_metric: i32 = receiver_probe~>write_unique()

    let shared_seed: unique i32 = 14
    let shared_value: shared i32 = shared_seed
    let const_value: const i32 = shared_value
    let unique_value: unique i32 = 18

    let type_const_metric: i32 = PermissionTokenInventoryReadConst(const_value)
    let type_shared_metric: i32 = PermissionTokenInventoryReadShared(shared_value)
    let type_unique_metric: i32 = PermissionTokenInventoryReadUnique(unique_value)

    let receiver_const_metric_log: i32 =
        receiver_const_metric
    let receiver_shared_metric_log: i32 =
        receiver_shared_metric
    let receiver_unique_metric_log: i32 =
        receiver_unique_metric
    let type_const_metric_log: i32 =
        type_const_metric
    let type_shared_metric_log: i32 =
        type_shared_metric
    let type_unique_metric_log: i32 =
        type_unique_metric

    let runtime_ok: bool =
        (receiver_const_metric_log == 9) &&
        (receiver_shared_metric_log == 9) &&
        (receiver_unique_metric_log == 13) &&
        (type_const_metric_log == 14) &&
        (type_shared_metric_log == 14) &&
        (type_unique_metric_log == 18)
    let runtime_ok_log: bool =
        runtime_ok

    let metric: i32 = if (runtime_ok_log == true) { 77 } else { 0 }
    let metric_label: string@View = PermissionTokenInventoryMetricLabel(metric)
    let metric_label_log: string@View =
        metric_label
    if (metric_label_log != "77") {
        "fail"
        return 1
    }

    "success"
    return 0
}
