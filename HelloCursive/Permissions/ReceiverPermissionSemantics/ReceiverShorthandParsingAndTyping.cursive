record ReceiverShorthandProbe {
    value: i32

    procedure read(~) -> i32 {
        return self.value
    }

    procedure read_sync(~%) -> i32 {
        return self.value
    }

    procedure write_unique(~!) -> i32 {
        return self.value + 1
    }
}

procedure ReceiverShorthandParsingAndTypingMetricLabel(value: i32) -> string@View {
    if (value == 26) {
        return "26"
    }
    return "other"
}

public procedure RunReceiverShorthandParsingAndTyping(ctx: Context) -> i32 {
    let _ = ctx
    "running"

    var probe: unique ReceiverShorthandProbe = ReceiverShorthandProbe { value: 7 }
    let read_metric: i32 = probe~>read()
    let sync_metric: i32 = probe~>read_sync()
    let unique_metric: i32 = probe~>write_unique()

    let read_metric_log: i32 =
        read_metric
    let sync_metric_log: i32 =
        sync_metric
    let unique_metric_log: i32 =
        unique_metric

    let runtime_ok: bool =
        (read_metric_log == 7) &&
        (sync_metric_log == 7) &&
        (unique_metric_log == 8)
    let runtime_ok_log: bool =
        runtime_ok

    let metric: i32 = if (runtime_ok_log == true) { 26 } else { 0 }
    let metric_label: string@View = ReceiverShorthandParsingAndTypingMetricLabel(metric)
    let metric_label_log: string@View =
        metric_label
    if (metric_label_log != "26") {
        "fail"
        return 1
    }

    "success"
    return 0
}
