procedure UniqueExclusivityReadShared(value: shared i32) -> i32 {
    return value
}

procedure UniqueExclusivityReadConst(value: const i32) -> i32 {
    return value
}

procedure UniqueExclusivityMetricLabel(value: i32) -> string@View {
    if (value == 28) {
        return "28"
    }
    return "other"
}

public procedure RunUniqueExclusivityInvariant(ctx: Context) -> i32 {
    let _ = ctx
    [[log(label: "permissions-log-item_begin", expected: "running")]] "running"

    let first_unique: unique i32 = 11
    let second_unique: unique i32 = 13

    let first_shared: shared i32 = first_unique
    let second_const: const i32 = second_unique

    let first_metric: i32 = UniqueExclusivityReadShared(first_shared)
    let second_metric: i32 = UniqueExclusivityReadConst(second_const)
    let balance_metric: i32 = second_metric - first_metric

    let diagnostic_code: string@View = "E-TYP-1602"

    let first_metric_log: i32 = [[log(label: "observed-permissions-UniqueExclusivityInvariant-first", expected: 11)]] first_metric
    let second_metric_log: i32 = [[log(label: "observed-permissions-UniqueExclusivityInvariant-second", expected: 13)]] second_metric
    let balance_metric_log: i32 = [[log(label: "observed-permissions-UniqueExclusivityInvariant-balance", expected: 2)]] balance_metric
    let diagnostic_log: string@View = [[log(label: "permissions-UniqueExclusivityInvariant-diagnostic", expected: "E-TYP-1602")]] diagnostic_code

    let runtime_ok: bool =
        (first_metric_log == 11) &&
        (second_metric_log == 13) &&
        (balance_metric_log == 2) &&
        (diagnostic_log == "E-TYP-1602")
    let runtime_ok_log: bool = [[log(label: "permissions-UniqueExclusivityInvariant-runtime", expected: true)]] runtime_ok

    let metric: i32 = if (runtime_ok_log) { 28 } else { 0 }
    let metric_label: string@View = UniqueExclusivityMetricLabel(metric)
    let metric_label_log: string@View = [[log(label: "observed-permissions-UniqueExclusivityInvariant-metric", expected: "28")]] metric_label

    if (metric_label_log != "28") {
        [[log(label: "permissions-log-item_fail", expected: "fail")]] "fail"
        return 1
    }

    [[log(label: "permissions-log-item_success", expected: "success")]] "success"
    return 0
}
