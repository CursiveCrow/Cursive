procedure UniqueDowngradeReactivationMetricLabel(value: i32) -> string@View {
    if (value == 21) {
        return "21"
    }
    return "other"
}

public procedure RunUniqueDowngradeAndReactivation(ctx: Context) -> i32 {
    let _ = ctx
    "running"

    let first_unique: unique i32 = 9
    let downgraded_shared: shared i32 = first_unique
    let downgraded_const: const i32 = downgraded_shared
    let downgraded_metric: i32 = downgraded_const

    let new_active: unique i32 = 12
    let new_active_metric: i32 = new_active

    let reactivation_anchor: string@View = "new-binding-reactivates-unique-ownership"

    let downgraded_metric_log: i32 = downgraded_metric
    let new_active_metric_log: i32 = new_active_metric
    let anchor_log: string@View = reactivation_anchor

    let runtime_ok: bool =
        (downgraded_metric_log == 9) &&
        (new_active_metric_log == 12) &&
        (anchor_log == "new-binding-reactivates-unique-ownership")
    let runtime_ok_log: bool = runtime_ok

    let metric: i32 = if (runtime_ok_log) { 21 } else { 0 }
    let metric_label: string@View = UniqueDowngradeReactivationMetricLabel(metric)
    let metric_label_log: string@View = metric_label

    if (metric_label_log != "21") {
        "fail"
        return 1
    }

    "success"
    return 0
}
