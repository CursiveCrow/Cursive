procedure ConstMutationRejectionMetricLabel(value: i32) -> string@View {
    if (value == 28) {
        return "28"
    }
    return "other"
}

public procedure RunConstMutationRejection(ctx: Context) -> i32 {
    let _ = ctx
    [[log(label: "permissions-log-item_begin", expected: "running")]] "running"

    let source_unique: unique i32 = 9
    let readonly_view: const i32 = source_unique
    let readonly_metric: i32 = readonly_view

    var writable_copy: i32 = readonly_view
    writable_copy = writable_copy + 4

    let second_source: unique i32 = 6
    let second_const: const i32 = second_source
    let combined_metric: i32 = writable_copy + second_const

    let diagnostic_code: string@View = "E-TYP-1601"

    let readonly_metric_log: i32 = [[log(label: "observed-permissions-ConstMutationRejection-readonly", expected: 9)]] readonly_metric
    let writable_copy_log: i32 = [[log(label: "observed-permissions-ConstMutationRejection-copy", expected: 13)]] writable_copy
    let combined_metric_log: i32 = [[log(label: "observed-permissions-ConstMutationRejection-combined", expected: 19)]] combined_metric
    let diagnostic_log: string@View = [[log(label: "permissions-ConstMutationRejection-diagnostic", expected: "E-TYP-1601")]] diagnostic_code

    let runtime_ok: bool =
        (readonly_metric_log == 9) &&
        (writable_copy_log == 13) &&
        (combined_metric_log == 19) &&
        (diagnostic_log == "E-TYP-1601")
    let runtime_ok_log: bool = [[log(label: "permissions-ConstMutationRejection-runtime", expected: true)]] runtime_ok

    let metric: i32 = if (runtime_ok_log) { 28 } else { 0 }
    let metric_label: string@View = ConstMutationRejectionMetricLabel(metric)
    let metric_label_log: string@View = [[log(label: "observed-permissions-ConstMutationRejection-metric", expected: "28")]] metric_label

    if (metric_label_log != "28") {
        [[log(label: "permissions-log-item_fail", expected: "fail")]] "fail"
        return 1
    }

    [[log(label: "permissions-log-item_success", expected: "success")]] "success"
    return 0
}
