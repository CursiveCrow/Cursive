record UniquePathAccessPair {
    left: i32
    right: i32
}

procedure UniquePathAccessLegalityMetricLabel(value: i32) -> string@View {
    if (value == 27) {
        return "27"
    }
    return "other"
}

public procedure RunUniquePathAccessLegality(ctx: Context) -> i32 {
    let _ = ctx
    "running"

    let pair: unique UniquePathAccessPair = UniquePathAccessPair {
        left: 12,
        right: 4
    }

    let pair_shared: shared UniquePathAccessPair = pair

    var left_metric: i32 = 0
    var right_metric: i32 = 0
    # pair_shared read {
        left_metric = pair_shared.left
        right_metric = pair_shared.right
    }

    let path_sum: i32 = left_metric + right_metric
    let diagnostic_code: string@View = "E-TYP-1602"

    let left_metric_log: i32 = left_metric
    let right_metric_log: i32 = right_metric
    let path_sum_log: i32 = path_sum
    let diagnostic_log: string@View = diagnostic_code

    let runtime_ok: bool =
        (left_metric_log == 12) &&
        (right_metric_log == 4) &&
        (path_sum_log == 16) &&
        (diagnostic_log == "E-TYP-1602")
    let runtime_ok_log: bool = runtime_ok

    let metric: i32 = if (runtime_ok_log) { 27 } else { 0 }
    let metric_label: string@View = UniquePathAccessLegalityMetricLabel(metric)
    let metric_label_log: string@View = metric_label

    if (metric_label_log != "27") {
        "fail"
        return 1
    }

    "success"
    return 0
}
