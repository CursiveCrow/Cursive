public procedure runGroup(ctx: Context) -> i32 {
    "section-start"

    let status_exclusive: i32 = RunUniqueExclusivityInvariant(ctx)
    if (status_exclusive != 0) {
        "section-end"
        return status_exclusive
    }

    let status_transitions: i32 = RunUniqueActiveInactiveTransitions(ctx)
    if (status_transitions != 0) {
        "section-end"
        return status_transitions
    }

    let status_paths: i32 = RunUniquePathAccessLegality(ctx)
    if (status_paths != 0) {
        "section-end"
        return status_paths
    }

    let status_downgrade: i32 = RunUniqueDowngradeAndReactivation(ctx)
    if (status_downgrade != 0) {
        "section-end"
        return status_downgrade
    }

    let status_move: i32 = RunUniqueBindingMoveRequirements(ctx)
    if (status_move != 0) {
        "section-end"
        return status_move
    }

    let status_const_reject: i32 = RunConstMutationRejection(ctx)
    if (status_const_reject != 0) {
        "section-end"
        return status_const_reject
    }

    "section-end"
    return 0
}
