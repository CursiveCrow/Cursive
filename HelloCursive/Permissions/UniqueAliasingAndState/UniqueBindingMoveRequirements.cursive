procedure UniqueBindingMoveConsume(move value: i32) -> i32 {
    return value + 10
}

procedure UniqueBindingMoveRequirementsMetricLabel(value: i32) -> string@View {
    if (value == 33) {
        return "33"
    }
    return "other"
}

public procedure RunUniqueBindingMoveRequirements(ctx: Context) -> i32 {
    let _ = ctx
    "running"

    let source_binding: unique i32 = 7
    let moved_binding: unique i32 = move source_binding
    let consumed_metric: i32 = UniqueBindingMoveConsume(move moved_binding)

    let literal_metric: i32 = UniqueBindingMoveConsume(5)
    let restaged_source: unique i32 = 2
    let restaged_target: unique i32 = move restaged_source
    let restaged_metric: i32 = restaged_target

    let diagnostic_permission_surface: string@View = "E-TYP-1603"
    let diagnostic_move_of_moved_binding: string@View = "E-CON-0121"

    let consumed_metric_log: i32 = consumed_metric
    let literal_metric_log: i32 = literal_metric
    let restaged_metric_log: i32 = restaged_metric
    let diagnostic_permission_surface_log: string@View = diagnostic_permission_surface
    let diagnostic_move_of_moved_binding_log: string@View = diagnostic_move_of_moved_binding

    let runtime_ok: bool =
        (consumed_metric_log == 17) &&
        (literal_metric_log == 15) &&
        (restaged_metric_log == 2) &&
        (diagnostic_permission_surface_log == "E-TYP-1603") &&
        (diagnostic_move_of_moved_binding_log == "E-CON-0121")
    let runtime_ok_log: bool = runtime_ok

    let metric: i32 = if (runtime_ok_log) { 33 } else { 0 }
    let metric_label: string@View = UniqueBindingMoveRequirementsMetricLabel(metric)
    let metric_label_log: string@View = metric_label

    if (metric_label_log != "33") {
        "fail"
        return 1
    }

    "success"
    return 0
}
