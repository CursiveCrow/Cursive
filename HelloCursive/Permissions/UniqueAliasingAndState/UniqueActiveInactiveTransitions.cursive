procedure UniqueActiveTransitionsConsume(move value: i32) -> i32 {
    return value + 1
}

procedure UniqueActiveTransitionsMetricLabel(value: i32) -> string@View {
    if (value == 30) {
        return "30"
    }
    return "other"
}

public procedure RunUniqueActiveInactiveTransitions(ctx: Context) -> i32 {
    let _ = ctx
    "running"

    let origin: unique i32 = 14
    let moved_once: unique i32 = move origin
    let consumed_metric: i32 = UniqueActiveTransitionsConsume(move moved_once)

    let replacement_active: unique i32 = 15
    let replacement_shared: shared i32 = replacement_active
    let replacement_metric: i32 = replacement_shared

    let transition_anchor: string@View = "move-deactivates-source"

    let consumed_metric_log: i32 = consumed_metric
    let replacement_metric_log: i32 = replacement_metric
    let anchor_log: string@View = transition_anchor

    let runtime_ok: bool =
        (consumed_metric_log == 15) &&
        (replacement_metric_log == 15) &&
        (anchor_log == "move-deactivates-source")
    let runtime_ok_log: bool = runtime_ok

    let metric: i32 = if (runtime_ok_log) { 30 } else { 0 }
    let metric_label: string@View = UniqueActiveTransitionsMetricLabel(metric)
    let metric_label_log: string@View = metric_label

    if (metric_label_log != "30") {
        "fail"
        return 1
    }

    "success"
    return 0
}
