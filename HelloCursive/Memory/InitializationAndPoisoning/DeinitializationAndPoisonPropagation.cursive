procedure DeinitPoisonMetricLabel(value: i32) -> string@View {
    if (value == 24) {
        return "24"
    }
    return "other"
}

public procedure RunDeinitializationAndPoisonPropagation(ctx: Context) -> i32 {
    var deinit_metric: i32 = 0
    {
        defer {
            deinit_metric = deinit_metric + 1
        }
        {
            defer {
                deinit_metric = deinit_metric + 2
            }
            deinit_metric = deinit_metric + 3
        }
        deinit_metric = deinit_metric + 4
    }

    let poison_probe_value: i32 = 11
    let poison_probe_ptr: Ptr<i32>@Valid = &poison_probe_value
    let poison_access_metric: i32 = *poison_probe_ptr
    let poison_addrof_metric: bool = poison_probe_ptr == &poison_probe_value

    let managed_probe: string@Managed | AllocationError =
        string::to_managed("pi", ctx.heap)
    var managed_metric: i32 = -1
    if managed_probe is {
        managed_text: unique string@Managed {
            let managed_view: string@View = string::as_view(managed_text)
            managed_metric = string::length(managed_view) as i32
        }
        _: AllocationError {
            managed_metric = -1
        }
    }

    let deinit_order_ok: bool = deinit_metric == 10
    let poison_access_runtime_ok: bool = poison_access_metric == 11
    let poison_addrof_runtime_ok: bool = poison_addrof_metric
    let poison_init_runtime_ok: bool = managed_metric == 2

    let deinit_order_log: bool = deinit_order_ok
    let poison_init_surface_ok_log: bool =        poison_init_runtime_ok
    let poison_access_runtime_ok_log: bool =        poison_access_runtime_ok
    let poison_addrof_runtime_ok_log: bool =        poison_addrof_runtime_ok

    let metric: i32 = if (deinit_order_ok &&
        poison_init_runtime_ok &&
        poison_access_runtime_ok &&
        poison_addrof_runtime_ok &&
        (deinit_order_log == true) &&
        (poison_init_surface_ok_log == true) &&
        (poison_access_runtime_ok_log == true) &&
        (poison_addrof_runtime_ok_log == true)) { 24 } else { 0 }
    let metric_label: string@View = DeinitPoisonMetricLabel(metric)
    let metric_log_actual: string@View =        metric_label
    if (metric_log_actual != "24") {
        return 1
    }

    return 0
}
