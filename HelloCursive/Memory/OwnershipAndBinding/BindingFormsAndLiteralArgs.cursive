procedure OwnershipConsume(move value: i32) -> i32 {
    return value + 1
}

procedure OwnershipObserve(value: i32) -> i32 {
    return value + 2
}

procedure OwnershipObservePair(left: i32, right: i32) -> i32 {
    return left + right
}

procedure OwnershipMetricLabel(value: i32) -> string@View {
    if (value == 34) {
        return "34"
    }
    return "other"
}

public procedure RunBindingFormsAndLiteralArgs(ctx: Context) -> i32 {
    let movable_let: i32 = 4
    let immovable_let: i32 := 6
    var movable_var: i32 = 5
    var immovable_var: i32 := 8
    var mutable_counter: i32 = movable_var
    mutable_counter = mutable_counter + 4

    let observe_literal_metric: i32 = OwnershipObserve(7)
    let observe_literal_pair_metric: i32 = OwnershipObservePair(2, 5)
    let consume_literal_metric: i32 = OwnershipConsume(3)

    var move_slot: i32 = 12
    let move_slot_first_metric: i32 = OwnershipConsume(move move_slot)
    move_slot = 15
    let move_slot_second_metric: i32 = OwnershipConsume(move move_slot)

    let immovable_observe_metric: i32 = OwnershipObserve(immovable_var)
    let mutable_observe_metric: i32 = OwnershipObserve(mutable_counter)

    let observe_literal_metric_log: i32 =
        observe_literal_metric
    let observe_literal_pair_metric_log: i32 =
        observe_literal_pair_metric
    let consume_literal_metric_log: i32 =
        consume_literal_metric
    let move_slot_first_metric_log: i32 =
        move_slot_first_metric
    let move_slot_second_metric_log: i32 =
        move_slot_second_metric
    let immovable_observe_metric_log: i32 =
        immovable_observe_metric
    let mutable_observe_metric_log: i32 =
        mutable_observe_metric

    let forms_ok: bool =
        (movable_let == 4) &&
        (immovable_let == 6) &&
        (movable_var == 5) &&
        (immovable_var == 8)
    let literal_nonconsuming_ok: bool =
        (observe_literal_metric_log == 9) &&
        (observe_literal_pair_metric_log == 7)
    let literal_consuming_ok: bool = consume_literal_metric_log == 4
    let move_slot_reset_ok: bool =
        (move_slot_first_metric_log == 13) &&
        (move_slot_second_metric_log == 16)
    let observe_paths_ok: bool =
        (immovable_observe_metric_log == 10) &&
        (mutable_observe_metric_log == 11)

    let forms_ok_log =
        forms_ok
    let literal_nonconsuming_ok_log =
        literal_nonconsuming_ok
    let literal_consuming_ok_log =
        literal_consuming_ok
    let move_slot_reset_ok_log =
        move_slot_reset_ok
    let observe_paths_ok_log =
        observe_paths_ok

    let metric: i32 = if (
        forms_ok &&
        literal_nonconsuming_ok &&
        literal_consuming_ok &&
        move_slot_reset_ok &&
        observe_paths_ok &&
        (forms_ok_log == true) &&
        (literal_nonconsuming_ok_log == true) &&
        (literal_consuming_ok_log == true) &&
        (move_slot_reset_ok_log == true) &&
        (observe_paths_ok_log == true)
    ) { 34 } else { 0 }
    let metric_label: string@View = OwnershipMetricLabel(metric)
    let metric_log_actual =
        metric_label
    if (metric_log_actual != "34") {
        return 1
    }

    return 0
}
