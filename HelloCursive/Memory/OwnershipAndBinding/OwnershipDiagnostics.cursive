public record OwnershipDiagCarrier {
    public left: unique i32
    public right: unique i32
}

procedure OwnershipDiagConsume(move value: i32) -> i32 {
    return value + 1
}

procedure OwnershipDiagnosticsMetricLabel(value: i32) -> string@View {
    if (value == 61) {
        return "61"
    }
    return "other"
}

public procedure RunOwnershipDiagnostics(ctx: Context) -> i32 {
    let _ = ctx
    [[log(label: "memory-log-item_begin")]]

    var whole_slot: i32 = 12
    let whole_take_one: i32 = OwnershipDiagConsume(move whole_slot)
    whole_slot = 20
    let whole_take_two: i32 = OwnershipDiagConsume(move whole_slot)

    var carrier: unique OwnershipDiagCarrier =
        OwnershipDiagCarrier { left: 4, right: 6 }
    let field_take_left: i32 = OwnershipDiagConsume(move carrier.left)
    carrier = OwnershipDiagCarrier { left: 10, right: 12 }
    let field_take_left_reset: i32 = OwnershipDiagConsume(move carrier.left)
    let field_take_right_reset: i32 = OwnershipDiagConsume(move carrier.right)

    let place_source: i32 = 8
    let place_take: i32 = OwnershipDiagConsume(move place_source)
    let literal_take: i32 = OwnershipDiagConsume(9)

    let whole_move_ok: bool =
        (whole_take_one == 13) && (whole_take_two == 21)
    let field_move_ok: bool =
        (field_take_left == 5) &&
        (field_take_left_reset == 11) &&
        (field_take_right_reset == 13)
    let arg_move_ok: bool =
        (place_take == 9) && (literal_take == 10)

    let whole_move_ok_log: bool = [[log(label: "memory-ownership-diagnostic-whole-moved", expected: true)]] whole_move_ok
    let field_move_ok_log: bool = [[log(label: "memory-ownership-diagnostic-field-moved", expected: true)]] field_move_ok
    let arg_move_ok_log: bool = [[log(label: "memory-ownership-diagnostic-arg-move", expected: true)]] arg_move_ok

    let diag_ok: bool =
        (whole_move_ok_log == true) &&
        (field_move_ok_log == true) &&
        (arg_move_ok_log == true)

    let metric: i32 = if (diag_ok) { 61 } else { 0 }
    let metric_label: string@View = OwnershipDiagnosticsMetricLabel(metric)
    let metric_log_actual = [[log(label: "observed-memory-ownership-diagnostics-metric", expected: "61")]] metric_label
    if (metric_log_actual != "61") {
        [[log(label: "memory-log-item_fail")]]
        return 1
    }

    [[log(label: "memory-log-memory_item_success")]]
    return 0
}
