public record OwnershipStateCarrier {
    public left: unique i32
    public right: unique i32
}

procedure OwnershipStateConsume(move value: i32) -> i32 {
    return value + 1
}

procedure OwnershipStateMetricLabel(value: i32) -> string@View {
    if (value == 46) {
        return "46"
    }
    return "other"
}

public procedure RunResponsibilityModelAndStateContracts(ctx: Context) -> i32 {
    let _ = ctx
    [[log(label: "memory-log-item_begin")]]

    var responsible_slot: i32 = 30
    let alias_read_metric: i32 = {
        let alias_view: const i32 = responsible_slot
        alias_view
    }

    let transfer_take_one: i32 = OwnershipStateConsume(move responsible_slot)
    responsible_slot = 41
    let transfer_take_two: i32 = OwnershipStateConsume(move responsible_slot)

    var partial_carrier: unique OwnershipStateCarrier =
        OwnershipStateCarrier { left: 5, right: 7 }
    let partial_left_take: i32 = OwnershipStateConsume(move partial_carrier.left)
    partial_carrier = OwnershipStateCarrier { left: 11, right: 13 }
    let partial_right_take: i32 = OwnershipStateConsume(move partial_carrier.right)

    let responsible_alias_ok: bool = alias_read_metric == 30
    let responsible_transfer_ok: bool =
        (transfer_take_one == 31) && (transfer_take_two == 42)
    let partial_state_ok: bool =
        (partial_left_take == 6) && (partial_right_take == 14)

    let diag_moved_whole_read: string@View = "E-MEM-3001"
    let diag_moved_partial_read: string@View = "E-MEM-3003"
    let diag_moved_partial_move: string@View = "E-MEM-3004"

    let responsible_alias_ok_log: bool = [[log(label: "memory-ownership-responsible-alias-read", expected: true)]] responsible_alias_ok
    let responsible_transfer_ok_log: bool = [[log(label: "memory-ownership-responsible-transfer", expected: true)]] responsible_transfer_ok
    let partial_state_ok_log: bool = [[log(label: "memory-ownership-partial-state-surface", expected: true)]] partial_state_ok

    let diag_moved_whole_read_log: string@View = [[log(label: "memory-ownership-diagnostic-code-moved-whole-read", expected: "E-MEM-3001")]] diag_moved_whole_read
    let diag_moved_partial_read_log: string@View = [[log(label: "memory-ownership-diagnostic-code-moved-partial-read", expected: "E-MEM-3003")]] diag_moved_partial_read
    let diag_moved_partial_move_log: string@View = [[log(label: "memory-ownership-diagnostic-code-moved-partial-move", expected: "E-MEM-3004")]] diag_moved_partial_move

    let diag_matrix_ok: bool =
        (diag_moved_whole_read_log == "E-MEM-3001") &&
        (diag_moved_partial_read_log == "E-MEM-3003") &&
        (diag_moved_partial_move_log == "E-MEM-3004")
    let diag_matrix_ok_log: bool = [[log(label: "memory-ownership-diagnostic-move-matrix", expected: true)]] diag_matrix_ok

    let metric_ok: bool =
        (responsible_alias_ok_log == true) &&
        (responsible_transfer_ok_log == true) &&
        (partial_state_ok_log == true) &&
        (diag_matrix_ok_log == true)

    let metric: i32 = if (metric_ok) { 46 } else { 0 }
    let metric_label: string@View = OwnershipStateMetricLabel(metric)
    let metric_log_actual: string@View = [[log(label: "observed-memory-ownership-responsibility-state-metric", expected: "46")]] metric_label
    if (metric_log_actual != "46") {
        [[log(label: "memory-log-item_fail")]]
        return 1
    }

    [[log(label: "memory-log-memory_item_success")]]
    return 0
}
