procedure PanicCleanupPropagationProbe() -> i32 {
    var metric: i32 = 0
    {
        defer {
            metric = metric + 1
        }
        metric = metric + 2
    }
    return metric
}

procedure UnwindingAcrossFramesProbe() -> i32 {
    var metric: i32 = 0
    region as r {
        r.frame {
            defer {
                metric = metric + 4
            }
            metric = metric + 1
        }
        metric = metric + 2
    }
    return metric
}

procedure DropChildOrderProbe() -> i32 {
    var metric: i32 = 0
    {
        defer {
            metric = metric * 10 + 1
        }
        defer {
            metric = metric * 10 + 2
        }
    }
    return metric
}

procedure AggregateCleanupOrderProbe() -> i32 {
    var metric: i32 = 0
    {
        let tuple_probe: (i32, i32) = (3, 0)
        let array_probe: [i32; 2] = [4, 0]
        let union_probe: i32 | bool = 5

        defer {
            let union_digit: i32 = if union_probe is {
                _: i32 { 5 }
                _: bool { 0 }
            }
            metric = metric * 10 + union_digit
        }
        defer {
            let array_digit: i32 = array_probe[0]
            metric = metric * 10 + array_digit
        }
        defer {
            let tuple_digit: i32 = tuple_probe.0
            metric = metric * 10 + tuple_digit
        }
    }
    return metric
}

procedure DoubleCleanupPathProbe() -> i32 {
    var metric: i32 = 0
    {
        defer {
            metric = metric + 8
        }
        {
            defer {
                metric = metric + 5
            }
            metric = metric + 1
        }
    }
    return metric
}

procedure UnwindingCleanupMetricLabel(value: i32) -> string@View {
    if (value == 52) {
        return "52"
    }
    return "other"
}

public procedure RunUnwindingAndPanicCleanup(ctx: Context) -> i32 {
    let _ = ctx
    let panic_cleanup_metric: i32 = PanicCleanupPropagationProbe()
    let unwinding_frames_metric: i32 = UnwindingAcrossFramesProbe()
    let child_order_metric: i32 = DropChildOrderProbe()
    let aggregate_cleanup_metric: i32 = AggregateCleanupOrderProbe()
    let double_cleanup_metric: i32 = DoubleCleanupPathProbe()

    let panic_cleanup_ok: bool = panic_cleanup_metric == 3
    let unwinding_frames_ok: bool = unwinding_frames_metric == 7
    let drop_child_order_ok: bool = child_order_metric == 21
    let aggregate_cleanup_ok: bool = aggregate_cleanup_metric == 345
    let double_cleanup_ok: bool = double_cleanup_metric == 14

    let panic_cleanup_ok_log: bool =        panic_cleanup_ok
    let double_cleanup_ok_log: bool =        double_cleanup_ok
    let unwinding_frames_ok_log: bool =        unwinding_frames_ok
    let drop_child_order_ok_log: bool =        drop_child_order_ok
    let aggregate_cleanup_ok_log: bool =        aggregate_cleanup_ok

    let metric_ok: bool = (panic_cleanup_ok_log == true) &&
        (double_cleanup_ok_log == true) &&
        (unwinding_frames_ok_log == true) &&
        (drop_child_order_ok_log == true) &&
        (aggregate_cleanup_ok_log == true)
    let metric: i32 = if (metric_ok) { 52 } else { 0 }
    let metric_label: string@View = UnwindingCleanupMetricLabel(metric)
    let metric_log_actual: string@View =        metric_label
    if (metric_log_actual != "52") {
        return 1
    }

    return 0
}
