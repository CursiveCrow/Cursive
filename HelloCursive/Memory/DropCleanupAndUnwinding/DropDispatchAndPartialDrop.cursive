public record DropDispatchCarrier {
    public left: unique i32
    public right: unique i32
}

procedure DropDispatchConsume(move value: i32) -> i32 {
    return value + 1
}

procedure DropAssignImmovableProbe() -> i32 {
    var slot: i32 := 3
    slot = 8
    return slot
}

procedure DropCloneRuntimeMetric(ctx: Context) -> i32 {
    var heap: $HeapAllocator = ctx.heap
    let seed_result: string@Managed | AllocationError =
        string::to_managed("drop", heap)
    if seed_result is {
        managed_text: unique string@Managed {
            let clone_result: string@Managed | AllocationError =
                string::clone_with(managed_text, heap)
            if clone_result is {
                cloned_text: unique string@Managed {
                    let cloned_view: string@View = string::as_view(cloned_text)
                    return string::length(cloned_view) as i32
                }
                _: AllocationError {
                    return -1
                }
            }
        }
        _: AllocationError {
            return -1
        }
    }
    return -1
}

procedure DropDispatchMetricLabel(value: i32) -> string@View {
    if (value == 27) {
        return "27"
    }
    return "other"
}

public procedure RunDropDispatchAndPartialDrop(ctx: Context) -> i32 {
    [[log(label: "memory-log-item_begin")]]

    let builtin_dispatch_metric: i32 = DropDispatchConsume(2)
    let user_dispatch_carrier: unique DropDispatchCarrier =
        DropDispatchCarrier { left: 4, right: 6 }
    let partial_left_metric: i32 = DropDispatchConsume(move user_dispatch_carrier.left)
    let partial_right_metric: i32 =
        DropDispatchConsume(move user_dispatch_carrier.right)
    let immovable_assign_metric: i32 = DropAssignImmovableProbe()

    let bitcopy_source: i32 = 22
    let bitcopy_copy: i32 = bitcopy_source
    let clone_metric: i32 = DropCloneRuntimeMetric(ctx)

    let builtin_dispatch_ok: bool = builtin_dispatch_metric == 3
    let user_dispatch_ok: bool =
        (partial_left_metric == 5) && (partial_right_metric == 7)
    let partial_drop_ok: bool =
        (partial_left_metric + partial_right_metric) == 12
    let drop_on_assign_ok: bool = immovable_assign_metric == 8
    let bitcopy_clone_ok: bool =
        (bitcopy_source == 22) && (bitcopy_copy == 22) && (clone_metric == 4)
    let dispatch_aggregate_ok: bool =
        (builtin_dispatch_metric + partial_left_metric + partial_right_metric + immovable_assign_metric) == 23

    let drop_call_diag: string@View = "E-MEM-3005"
    let drop_call_diag_log: string@View = [[log(label: "memory-drop-diagnostic-code-drop-call", expected: "E-MEM-3005")]] drop_call_diag
    let drop_call_diag_ok: bool = drop_call_diag_log == "E-MEM-3005"

    let builtin_dispatch_ok_log: bool =        [[log(label: "memory-drop-dispatch-builtin", expected: true)]]         builtin_dispatch_ok
    let user_dispatch_ok_log: bool =        [[log(label: "memory-drop-dispatch-user", expected: true)]]         user_dispatch_ok
    let partial_drop_ok_log: bool =        [[log(label: "memory-drop-partial-drop", expected: true)]]         partial_drop_ok
    let drop_on_assign_ok_log: bool =        [[log(label: "memory-drop-drop-on-assign-immovable", expected: true)]]         drop_on_assign_ok
    let bitcopy_clone_ok_log: bool =        [[log(label: "memory-drop-bitcopy-clone-interaction", expected: true)]]         bitcopy_clone_ok
    let drop_call_diag_ok_log: bool =        [[log(label: "memory-drop-diagnostic-drop-call-contract", expected: true)]]         drop_call_diag_ok
    let dispatch_aggregate_ok_log: bool =        [[log(label: "memory-drop-dispatch-aggregate-runtime", expected: true)]]         dispatch_aggregate_ok

    let metric_ok: bool = (builtin_dispatch_ok_log == true) &&
        (user_dispatch_ok_log == true) &&
        (partial_drop_ok_log == true) &&
        (drop_on_assign_ok_log == true) &&
        (bitcopy_clone_ok_log == true) &&
        (drop_call_diag_ok_log == true) &&
        (dispatch_aggregate_ok_log == true)
    let metric: i32 = if (metric_ok) { 27 } else { 0 }
    let metric_label: string@View = DropDispatchMetricLabel(metric)
    let metric_log_actual: string@View =        [[log(label: "observed-memory-drop-dispatch-metric", expected: "27")]]         metric_label
    if (metric_log_actual != "27") {
        [[log(label: "memory-log-item_fail")]]
        return 1
    }

    [[log(label: "memory-log-memory_item_success")]]
    return 0
}
