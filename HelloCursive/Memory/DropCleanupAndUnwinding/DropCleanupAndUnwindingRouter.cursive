procedure DropLogFeatureStatus(feature_name: string@View, status: i32) -> () {
    status
    feature_name
    return ()
}

public procedure runGroup(ctx: Context) -> i32 {
    "memory::DropCleanupAndUnwinding::DeferCleanupOrdering"
    let status_ordering: i32 = RunDeferCleanupOrdering(ctx)
    DropLogFeatureStatus("memory::DropCleanupAndUnwinding::DeferCleanupOrdering", status_ordering)
    if (status_ordering != 0) {
        return status_ordering
    }

    "memory::DropCleanupAndUnwinding::DropDispatchAndPartialDrop"
    let status_dispatch: i32 = RunDropDispatchAndPartialDrop(ctx)
    DropLogFeatureStatus("memory::DropCleanupAndUnwinding::DropDispatchAndPartialDrop", status_dispatch)
    if (status_dispatch != 0) {
        return status_dispatch
    }

    "memory::DropCleanupAndUnwinding::PanicAbortContractSurface"
    let status_panic_surface: i32 = RunPanicAbortContractSurface(ctx)
    DropLogFeatureStatus("memory::DropCleanupAndUnwinding::PanicAbortContractSurface", status_panic_surface)
    if (status_panic_surface != 0) {
        return status_panic_surface
    }

    "memory::DropCleanupAndUnwinding::UnwindingAndPanicCleanup"
    let status_unwind: i32 = RunUnwindingAndPanicCleanup(ctx)
    DropLogFeatureStatus("memory::DropCleanupAndUnwinding::UnwindingAndPanicCleanup", status_unwind)
    if (status_unwind != 0) {
        return status_unwind
    }

    return 0
}
