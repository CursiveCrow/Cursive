procedure DiagnosticLogFeatureStatus(feature_name: string@View, status: i32) -> () {
    status
    feature_name
    return ()
}

public procedure runGroup(ctx: Context) -> i32 {
    let status_alloc_deref: i32 = RunAllocationAndDereferenceDiagnostics(ctx)
    DiagnosticLogFeatureStatus(
        "memory::MemoryDiagnostics::AllocationAndDereferenceDiagnostics",
        status_alloc_deref)
    if (status_alloc_deref != 0) {
        return status_alloc_deref
    }

    let status_move_cleanup: i32 = RunMoveAndCleanupDiagnostics(ctx)
    DiagnosticLogFeatureStatus(
        "memory::MemoryDiagnostics::MoveAndCleanupDiagnostics",
        status_move_cleanup)
    if (status_move_cleanup != 0) {
        return status_move_cleanup
    }

    let status_matrix: i32 = RunDiagnosticCodeMatrix(ctx)
    DiagnosticLogFeatureStatus(
        "memory::MemoryDiagnostics::DiagnosticCodeMatrix",
        status_matrix)
    if (status_matrix != 0) {
        return status_matrix
    }

    let status_surface: i32 = RunDiagnosticSurfaceAndExpectedActual(ctx)
    DiagnosticLogFeatureStatus(
        "memory::MemoryDiagnostics::DiagnosticSurfaceAndExpectedActual",
        status_surface)
    if (status_surface != 0) {
        return status_surface
    }

    return 0
}
