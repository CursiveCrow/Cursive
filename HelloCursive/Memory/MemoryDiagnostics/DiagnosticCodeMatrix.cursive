procedure DiagnosticCodeMatrixMetricLabel(value: i32) -> string@View {
    if (value == 88) {
        return "88"
    }
    return "other"
}

public procedure RunDiagnosticCodeMatrix(ctx: Context) -> i32 {
    let _ = ctx
    [[log(label: "memory-log-item_begin")]]

    let mem_1206: string@View = "E-MEM-1206"
    let mem_1207: string@View = "E-MEM-1207"
    let mem_1208: string@View = "E-MEM-1208"
    let mem_3001: string@View = "E-MEM-3001"
    let mem_3003: string@View = "E-MEM-3003"
    let mem_3004: string@View = "E-MEM-3004"
    let mem_3005: string@View = "E-MEM-3005"
    let mem_3006: string@View = "E-MEM-3006"
    let mem_3007: string@View = "E-MEM-3007"
    let mem_3020: string@View = "E-MEM-3020"
    let mem_3021: string@View = "E-MEM-3021"
    let mem_3030: string@View = "E-MEM-3030"
    let mem_3031: string@View = "E-MEM-3031"

    let typ_2101: string@View = "E-TYP-2101"
    let typ_2102: string@View = "E-TYP-2102"
    let typ_2103: string@View = "E-TYP-2103"
    let typ_2104: string@View = "E-TYP-2104"
    let typ_2105: string@View = "E-TYP-2105"
    let typ_2106: string@View = "E-TYP-2106"
    let sem_2534: string@View = "E-SEM-2534"
    let sem_2535: string@View = "E-SEM-2535"
    let sem_3152: string@View = "E-SEM-3152"

    let mem_1206_log: string@View = [[log(label: "memory-diagnostic-code-E-MEM-1206", expected: "E-MEM-1206")]] mem_1206
    let mem_1207_log: string@View = [[log(label: "memory-diagnostic-code-E-MEM-1207", expected: "E-MEM-1207")]] mem_1207
    let mem_1208_log: string@View = [[log(label: "memory-diagnostic-code-E-MEM-1208", expected: "E-MEM-1208")]] mem_1208
    let mem_3001_log: string@View = [[log(label: "memory-diagnostic-code-E-MEM-3001", expected: "E-MEM-3001")]] mem_3001
    let mem_3003_log: string@View = [[log(label: "memory-diagnostic-code-E-MEM-3003", expected: "E-MEM-3003")]] mem_3003
    let mem_3004_log: string@View = [[log(label: "memory-diagnostic-code-E-MEM-3004", expected: "E-MEM-3004")]] mem_3004
    let mem_3005_log: string@View = [[log(label: "memory-diagnostic-code-E-MEM-3005", expected: "E-MEM-3005")]] mem_3005
    let mem_3006_log: string@View = [[log(label: "memory-diagnostic-code-E-MEM-3006", expected: "E-MEM-3006")]] mem_3006
    let mem_3007_log: string@View = [[log(label: "memory-diagnostic-code-E-MEM-3007", expected: "E-MEM-3007")]] mem_3007
    let mem_3020_log: string@View = [[log(label: "memory-diagnostic-code-E-MEM-3020", expected: "E-MEM-3020")]] mem_3020
    let mem_3021_log: string@View = [[log(label: "memory-diagnostic-code-E-MEM-3021", expected: "E-MEM-3021")]] mem_3021
    let mem_3030_log: string@View = [[log(label: "memory-diagnostic-code-E-MEM-3030", expected: "E-MEM-3030")]] mem_3030
    let mem_3031_log: string@View = [[log(label: "memory-diagnostic-code-E-MEM-3031", expected: "E-MEM-3031")]] mem_3031

    let typ_2101_log: string@View = [[log(label: "memory-diagnostic-code-E-TYP-2101", expected: "E-TYP-2101")]] typ_2101
    let typ_2102_log: string@View = [[log(label: "memory-diagnostic-code-E-TYP-2102", expected: "E-TYP-2102")]] typ_2102
    let typ_2103_log: string@View = [[log(label: "memory-diagnostic-code-E-TYP-2103", expected: "E-TYP-2103")]] typ_2103
    let typ_2104_log: string@View = [[log(label: "memory-diagnostic-code-E-TYP-2104", expected: "E-TYP-2104")]] typ_2104
    let typ_2105_log: string@View = [[log(label: "memory-diagnostic-code-E-TYP-2105", expected: "E-TYP-2105")]] typ_2105
    let typ_2106_log: string@View = [[log(label: "memory-diagnostic-code-E-TYP-2106", expected: "E-TYP-2106")]] typ_2106
    let sem_2534_log: string@View = [[log(label: "memory-diagnostic-code-E-SEM-2534", expected: "E-SEM-2534")]] sem_2534
    let sem_2535_log: string@View = [[log(label: "memory-diagnostic-code-E-SEM-2535", expected: "E-SEM-2535")]] sem_2535
    let sem_3152_log: string@View = [[log(label: "memory-diagnostic-code-E-SEM-3152", expected: "E-SEM-3152")]] sem_3152

    let mem_codes_ok: bool =
        (mem_1206_log == "E-MEM-1206") &&
        (mem_1207_log == "E-MEM-1207") &&
        (mem_1208_log == "E-MEM-1208") &&
        (mem_3001_log == "E-MEM-3001") &&
        (mem_3003_log == "E-MEM-3003") &&
        (mem_3004_log == "E-MEM-3004") &&
        (mem_3005_log == "E-MEM-3005") &&
        (mem_3006_log == "E-MEM-3006") &&
        (mem_3007_log == "E-MEM-3007") &&
        (mem_3020_log == "E-MEM-3020") &&
        (mem_3021_log == "E-MEM-3021") &&
        (mem_3030_log == "E-MEM-3030") &&
        (mem_3031_log == "E-MEM-3031")
    let pointer_codes_ok: bool =
        (typ_2101_log == "E-TYP-2101") &&
        (typ_2102_log == "E-TYP-2102") &&
        (typ_2103_log == "E-TYP-2103") &&
        (typ_2104_log == "E-TYP-2104") &&
        (typ_2105_log == "E-TYP-2105") &&
        (typ_2106_log == "E-TYP-2106")
    let sem_codes_ok: bool =
        (sem_2534_log == "E-SEM-2534") &&
        (sem_2535_log == "E-SEM-2535") &&
        (sem_3152_log == "E-SEM-3152")

    let matrix_cardinality: i32 = if (mem_codes_ok && pointer_codes_ok && sem_codes_ok) { 22 } else { 0 }
    let matrix_cardinality_log: i32 = [[log(label: "memory-diagnostic-code-matrix-cardinality", expected: 22)]] matrix_cardinality

    let mem_codes_ok_log: bool = [[log(label: "memory-diagnostic-code-matrix-emem", expected: true)]] mem_codes_ok
    let pointer_codes_ok_log: bool = [[log(label: "memory-diagnostic-code-matrix-pointer", expected: true)]] pointer_codes_ok
    let sem_codes_ok_log: bool = [[log(label: "memory-diagnostic-code-matrix-sem", expected: true)]] sem_codes_ok

    let metric_ok: bool =
        (mem_codes_ok_log == true) &&
        (pointer_codes_ok_log == true) &&
        (sem_codes_ok_log == true) &&
        (matrix_cardinality_log == 22)

    let metric: i32 = if (metric_ok) { 88 } else { 0 }
    let metric_label: string@View = DiagnosticCodeMatrixMetricLabel(metric)
    let metric_log_actual: string@View = [[log(label: "observed-memory-diagnostic-code-matrix-metric", expected: "88")]] metric_label
    if (metric_log_actual != "88") {
        [[log(label: "memory-log-item_fail")]]
        return 1
    }

    [[log(label: "memory-log-memory_item_success")]]
    return 0
}
