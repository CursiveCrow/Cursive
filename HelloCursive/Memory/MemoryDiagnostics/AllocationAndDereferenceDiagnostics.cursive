procedure AllocationDereferenceDiagnosticsMetricLabel(value: i32) -> string@View {
    if (value == 15) {
        return "15"
    }
    return "other"
}

public procedure RunAllocationAndDereferenceDiagnostics(ctx: Context) -> i32 {
    [[log(label: "memory-log-item_begin")]]

    let safe_ptr_null: Ptr<i32>@Null = Ptr::null()
    let safe_ptr_null_check: Ptr<i32>@Null = Ptr::null()
    let safe_ptr_state: Ptr<i32> = safe_ptr_null
    let safe_ptr_state_check: Ptr<i32> = safe_ptr_null_check
    let raw_ptr_null: *imm i32 = null
    let raw_ptr_null_check: *imm i32 = null

    let deref_value: i32 = 8
    let safe_ptr_valid: Ptr<i32>@Valid = &deref_value
    let raw_ptr_valid: *imm i32 =
        unsafe { transmute<Ptr<i32>@Valid, *imm i32>(safe_ptr_valid) }
    let safe_deref_metric: i32 = *safe_ptr_valid
    let raw_deref_metric: i32 = unsafe { *raw_ptr_valid }
    let safe_deref_metric_log: i32 =
        [[log(label: "observed-memory-diagnostics-safe-deref-metric", expected: 8)]]
        safe_deref_metric
    let raw_deref_metric_log: i32 =
        [[log(label: "observed-memory-diagnostics-raw-deref-metric", expected: 8)]]
        raw_deref_metric

    let managed_alloc_result: string@Managed | AllocationError =
        string::to_managed("a", ctx.heap)
    var alloc_metric: i32 = -1
    if managed_alloc_result is {
        managed_text: unique string@Managed {
            let managed_view: string@View = string::as_view(managed_text)
            alloc_metric = string::length(managed_view) as i32
        }
        _: AllocationError {
            alloc_metric = -1
        }
    }

    var quota_source: $HeapAllocator = ctx.heap
    let quota_heap_tight: $HeapAllocator = quota_source~>with_quota(1usize)
    let quota_result: string@Managed | AllocationError =
        string::to_managed("qq", quota_heap_tight)
    var allocation_error_path_ok: bool = false
    if quota_result is {
        _: unique string@Managed {
            allocation_error_path_ok = false
        }
        _: AllocationError {
            allocation_error_path_ok = true
        }
    }

    let alloc_metric_log: i32 =
        [[log(label: "observed-memory-diagnostics-managed-alloc-metric", expected: 1)]]
        alloc_metric
    let allocation_runtime_ok: bool = alloc_metric_log == 1
    let dereference_runtime_ok: bool =
        (safe_deref_metric_log == 8) && (raw_deref_metric_log == 8)
    let null_surface_ok: bool =
        (safe_ptr_null == safe_ptr_null_check) &&
        (raw_ptr_null == raw_ptr_null_check)
    let expired_shape_ok: bool = safe_ptr_state == safe_ptr_state_check

    let allocation_runtime_ok_log: bool =
        [[log(label: "memory-diagnostics-alloc-runtime", expected: true)]]
        allocation_runtime_ok
    let dereference_runtime_ok_log: bool =
        [[log(label: "memory-diagnostics-deref-runtime", expected: true)]]
        dereference_runtime_ok
    let null_surface_ok_log: bool =
        [[log(label: "memory-diagnostics-null-surface", expected: true)]]
        null_surface_ok
    let expired_shape_ok_log: bool =
        [[log(label: "memory-diagnostics-expired-shape", expected: true)]]
        expired_shape_ok
    let allocation_error_path_ok_log: bool =
        [[log(label: "memory-diagnostics-allocation-error-runtime", expected: true)]]
        allocation_error_path_ok

    let metric_ok: bool = (allocation_runtime_ok_log == true) &&
        (dereference_runtime_ok_log == true) &&
        (null_surface_ok_log == true) &&
        (expired_shape_ok_log == true) &&
        (allocation_error_path_ok_log == true)
    let metric: i32 = if (metric_ok) { 15 } else { 0 }
    let metric_label: string@View = AllocationDereferenceDiagnosticsMetricLabel(metric)
    let metric_log_actual: string@View =
        [[log(label: "observed-memory-diagnostics-alloc-deref-metric", expected: "15")]]
        metric_label
    if (metric_log_actual != "15") {
        [[log(label: "memory-log-item_fail")]]
        return 1
    }

    [[log(label: "memory-log-memory_item_success")]]
    return 0
}
