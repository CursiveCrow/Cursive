record PointerAddressRecord {
    left: i32
    right: i32
}

record PointerAddressNested {
    pair: (i32, i32)
    cells: [i32; 3]
}

procedure PointerAddressingMetricLabel(value: i32) -> string@View {
    if (value == 57) {
        return "57"
    }
    return "other"
}

public procedure RunAddressOfAndIndexAddressing(ctx: Context) -> i32 {
    let _ = ctx

    let cell: i32 = 9
    let ptr_cell: Ptr<i32>@Valid = &cell
    let ptr_metric: i32 = *ptr_cell

    let tuple_seed: (i32, i32) = (2, 3)
    let tuple_metric: i32 = tuple_seed.0 + tuple_seed.1

    let array_seed: [i32; 3] = [3, 4, 5]
    let slice_seed: [i32] = array_seed
    let index_metric: i32 = slice_seed[1]

    let record_seed: PointerAddressRecord = PointerAddressRecord {
        left: 11,
        right: 13
    }
    let record_left_ptr: Ptr<i32>@Valid = &record_seed.left
    let record_right_ptr: Ptr<i32>@Valid = &record_seed.right
    let record_metric: i32 = (*record_left_ptr) + (*record_right_ptr)

    let nested_seed: PointerAddressNested = PointerAddressNested {
        pair: (7, 9),
        cells: [1, 3, 5]
    }
    let nested_tuple_ptr: Ptr<i32>@Valid = &nested_seed.pair.1
    let nested_index_ptr: Ptr<i32>@Valid = &nested_seed.cells[1usize]
    let nested_metric: i32 = (*nested_tuple_ptr) + (*nested_index_ptr)

    let index_ptr: Ptr<i32>@Valid = &slice_seed[2usize]
    let raw_from_index: *imm i32 =
        unsafe { transmute<Ptr<i32>@Valid, *imm i32>(index_ptr) }
    let raw_index_metric: i32 = unsafe { *raw_from_index }

    let ptr_metric_log: i32 =
        ptr_metric
    let tuple_metric_log: i32 =
        tuple_metric
    let index_metric_log: i32 =
        index_metric
    let record_metric_log: i32 =
        record_metric
    let nested_metric_log: i32 =
        nested_metric
    let raw_index_metric_log: i32 =
        raw_index_metric

    let address_of_ok: bool = ptr_metric_log == 9
    let tuple_addressing_ok: bool = tuple_metric_log == 5
    let index_addressing_ok: bool = index_metric_log == 4
    let record_field_address_ok: bool = record_metric_log == 24
    let nested_provenance_flow_ok: bool = nested_metric_log == 12
    let raw_index_address_ok: bool = raw_index_metric_log == 5

    let address_of_ok_log: bool =
        address_of_ok
    let tuple_addressing_ok_log: bool =
        tuple_addressing_ok
    let index_addressing_ok_log: bool =
        index_addressing_ok
    let record_field_address_ok_log: bool =
        record_field_address_ok
    let nested_provenance_flow_ok_log: bool =
        nested_provenance_flow_ok
    let raw_index_address_ok_log: bool =
        raw_index_address_ok

    let metric_ok: bool =
        address_of_ok &&
        tuple_addressing_ok &&
        index_addressing_ok &&
        record_field_address_ok &&
        nested_provenance_flow_ok &&
        raw_index_address_ok &&
        (address_of_ok_log == true) &&
        (tuple_addressing_ok_log == true) &&
        (index_addressing_ok_log == true) &&
        (record_field_address_ok_log == true) &&
        (nested_provenance_flow_ok_log == true) &&
        (raw_index_address_ok_log == true)
    let metric: i32 = if (metric_ok) { 57 } else { 0 }
    let metric_label: string@View = PointerAddressingMetricLabel(metric)
    let metric_log_actual: string@View =
        metric_label
    if (metric_log_actual != "57") {
        let fail_marker: string@View = "memory-pointer-addressing-fail"
        fail_marker
        return 1
    }

    let success_marker: string@View = "memory-pointer-addressing-success"
    success_marker
    return 0
}
