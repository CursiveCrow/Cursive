public procedure runGroup(ctx: Context) -> i32 {
    let status_behavior: i32 = RunSafeAndRawPointerBehavior(ctx)
    if (status_behavior != 0) {
        return status_behavior
    }

    let status_surface: i32 = RunDerefAndAddressDiagnosticSurface(ctx)
    if (status_surface != 0) {
        return status_surface
    }

    let status_addressing: i32 = RunAddressOfAndIndexAddressing(ctx)
    if (status_addressing != 0) {
        return status_addressing
    }

    let status_diag: i32 = RunPointerDiagnostics(ctx)
    if (status_diag != 0) {
        return status_diag
    }

    return 0
}
