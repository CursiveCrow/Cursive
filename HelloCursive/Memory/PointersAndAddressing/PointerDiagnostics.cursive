[[layout(packed)]]
public record PackedPointerCell {
    public value: i32
}

procedure PackedPointerCellProbe() -> i32 {
    let packed_cell: PackedPointerCell = PackedPointerCell { value: 41 }
    let packed_ptr: Ptr<i32>@Valid = unsafe { &packed_cell.value }
    return *packed_ptr
}

procedure PointerDiagnosticsMetricLabel(value: i32) -> string@View {
    if (value == 47) {
        return "47"
    }
    return "other"
}

public procedure RunPointerDiagnostics(ctx: Context) -> i32 {
    let _ = ctx
    let safe_ptr_null: Ptr<i32>@Null = Ptr::null()
    let safe_ptr_null_check: Ptr<i32>@Null = Ptr::null()
    let safe_ptr_state: Ptr<i32> = safe_ptr_null
    let safe_ptr_state_check: Ptr<i32> = safe_ptr_null_check
    let raw_ptr_null: *imm i32 = null
    let raw_ptr_null_check: *imm i32 = null

    var read_cell: i32 = 14
    let safe_ptr_valid: Ptr<i32>@Valid = &read_cell
    let raw_ptr_from_valid: *imm i32 =
        unsafe { transmute<Ptr<i32>@Valid, *imm i32>(safe_ptr_valid) }
    let safe_read_metric: i32 = *safe_ptr_valid
    let raw_read_metric: i32 = unsafe { *raw_ptr_from_valid }

    let index_seed: [i32; 2] = [3, 5]
    let index_ptr: Ptr<i32>@Valid = &index_seed[1usize]
    let index_metric: i32 = *index_ptr

    let tuple_seed: (i32, i32) = (21, 34)
    let tuple_ptr: Ptr<i32>@Valid = &tuple_seed.1
    let tuple_metric: i32 = *tuple_ptr

    let packed_metric: i32 = PackedPointerCellProbe()

    let safe_null_shape_ok: bool = safe_ptr_null == safe_ptr_null_check
    let expired_shape_ok: bool = safe_ptr_state == safe_ptr_state_check
    let raw_null_shape_ok: bool = raw_ptr_null == raw_ptr_null_check
    let valid_read_path_ok: bool =
        (safe_read_metric == 14) && (raw_read_metric == 14)
    let index_addressing_ok: bool = index_metric == 5
    let tuple_addressing_ok: bool = tuple_metric == 34
    let packed_field_unsafe_ok: bool = packed_metric == 41

    let deref_null_contract_ok: bool = safe_null_shape_ok
    let deref_expired_contract_ok: bool = expired_shape_ok
    let raw_unsafe_contract_ok: bool = valid_read_path_ok
    let addr_of_place_contract_ok: bool =
        index_addressing_ok && tuple_addressing_ok

    let safe_null_shape_ok_log: bool =        safe_null_shape_ok
    let expired_shape_ok_log: bool =        expired_shape_ok
    let raw_null_shape_ok_log: bool =        raw_null_shape_ok
    let valid_read_path_ok_log: bool =        valid_read_path_ok
    let index_addressing_ok_log: bool =        index_addressing_ok
    let tuple_addressing_ok_log: bool =        tuple_addressing_ok
    let packed_field_unsafe_ok_log: bool =        packed_field_unsafe_ok

    let deref_null_contract_ok_log: bool = deref_null_contract_ok
    let deref_expired_contract_ok_log: bool = deref_expired_contract_ok
    let raw_unsafe_contract_ok_log: bool = raw_unsafe_contract_ok
    let addr_of_place_contract_ok_log: bool = addr_of_place_contract_ok

    let packed_field_diag: string@View = "E-TYP-2105"
    let packed_field_diag_log: string@View = packed_field_diag
    let packed_field_diag_ok: bool = packed_field_diag_log == "E-TYP-2105"
    let packed_field_diag_ok_log: bool = packed_field_diag_ok

    let metric_ok: bool = (safe_null_shape_ok_log == true) &&
        (expired_shape_ok_log == true) &&
        (raw_null_shape_ok_log == true) &&
        (valid_read_path_ok_log == true) &&
        (index_addressing_ok_log == true) &&
        (tuple_addressing_ok_log == true) &&
        (packed_field_unsafe_ok_log == true) &&
        (deref_null_contract_ok_log == true) &&
        (deref_expired_contract_ok_log == true) &&
        (raw_unsafe_contract_ok_log == true) &&
        (addr_of_place_contract_ok_log == true) &&
        (packed_field_diag_ok_log == true)
    let metric: i32 = if (metric_ok) { 47 } else { 0 }
    let metric_label: string@View = PointerDiagnosticsMetricLabel(metric)
    let metric_log_actual =        metric_label
    if (metric_log_actual != "47") {
        return 1
    }

    return 0
}
