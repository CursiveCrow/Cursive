procedure ManagedViewsMetricLabel(value: i32) -> string@View {
    if (value == 13) {
        return "13"
    }
    return "other"
}

public procedure RunManagedViewsAndLengths(ctx: Context) -> i32 {
    let _ = ctx

    let text_seed: string@View = "mem"
    let bytes_seed: [u8; 3] = [65, 66, 67]
    let bytes_slice: [u8] = bytes_seed
    let bytes_view: bytes@View = bytes::view(bytes_slice)

    let string_len_ok: bool = string::length(text_seed) == 3usize
    let bytes_len_ok: bool = bytes::length(bytes_view) == 3usize
    let non_empty_ok: bool = string::is_empty(text_seed) == false

    let string_len_log: bool = string_len_ok
    let bytes_len_log: bool = bytes_len_ok
    let non_empty_log: bool = non_empty_ok

    let metric: i32 = if (string_len_ok && bytes_len_ok && non_empty_ok && (string_len_log == true) && (bytes_len_log == true) && (non_empty_log == true)) { 13 } else { 0 }
    let metric_label: string@View = ManagedViewsMetricLabel(metric)
    let metric_log_actual: string@View = metric_label
    if (metric_log_actual != "13") {
        let fail_marker: string@View = "memory-managed-views-fail"
        fail_marker
        return 1
    }

    let success_marker: string@View = "memory-managed-views-success"
    success_marker
    return 0
}
