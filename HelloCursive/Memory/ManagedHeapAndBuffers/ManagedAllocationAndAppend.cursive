procedure ManagedAllocationMetricLabel(value: i32) -> string@View {
    if (value == 41) {
        return "41"
    }
    return "other"
}

public procedure RunManagedAllocationAndAppend(ctx: Context) -> i32 {
    let text_seed: string@View = "mem"
    let bytes_seed: [u8; 3] = [65, 66, 67]
    let bytes_slice: [u8] = bytes_seed
    let bytes_view_from_text: bytes@View = bytes::view_string(text_seed)

    let managed_string_result: string@Managed | AllocationError =
        string::to_managed(text_seed, ctx.heap)
    let managed_bytes_slice_result: bytes@Managed | AllocationError =
        bytes::from_slice(bytes_slice, ctx.heap)
    let managed_bytes_view_result: bytes@Managed | AllocationError =
        bytes::to_managed(bytes_view_from_text, ctx.heap)
    let managed_bytes_capacity_result: bytes@Managed | AllocationError =
        bytes::with_capacity(6usize, ctx.heap)

    var managed_string_metric: i32 = -1
    var managed_bytes_slice_metric: i32 = -1
    var managed_bytes_view_metric: i32 = -1
    var managed_bytes_capacity_metric: i32 = -1
    var string_append_metric: i32 = -1
    var bytes_append_metric: i32 = -1

    if managed_string_result is {
        managed_text: unique string@Managed {
            let managed_text_view: string@View = string::as_view(managed_text)
            managed_string_metric = string::length(managed_text_view) as i32

            let append_result: () | AllocationError =
                string::append(managed_text, "!", ctx.heap)
            if append_result is {
                _: () {
                    let appended_view: string@View = string::as_view(managed_text)
                    string_append_metric = string::length(appended_view) as i32
                }
                _: AllocationError {
                    string_append_metric = -1
                }
            }
        }
        _: AllocationError {
            managed_string_metric = -1
            string_append_metric = -1
        }
    }

    if managed_bytes_slice_result is {
        managed_data: unique bytes@Managed {
            let managed_data_view: bytes@View = bytes::as_view(managed_data)
            managed_bytes_slice_metric = bytes::length(managed_data_view) as i32

            let append_result: () | AllocationError =
                bytes::append(managed_data, bytes_view_from_text, ctx.heap)
            if append_result is {
                _: () {
                    let appended_view: bytes@View = bytes::as_view(managed_data)
                    bytes_append_metric = bytes::length(appended_view) as i32
                }
                _: AllocationError {
                    bytes_append_metric = -1
                }
            }
        }
        _: AllocationError {
            managed_bytes_slice_metric = -1
            bytes_append_metric = -1
        }
    }

    if managed_bytes_view_result is {
        managed_data: unique bytes@Managed {
            let managed_data_view: bytes@View = bytes::as_view(managed_data)
            managed_bytes_view_metric = bytes::length(managed_data_view) as i32
        }
        _: AllocationError {
            managed_bytes_view_metric = -1
        }
    }

    if managed_bytes_capacity_result is {
        managed_data: unique bytes@Managed {
            let before_append_view: bytes@View = bytes::as_view(managed_data)
            let before_append_len: i32 = bytes::length(before_append_view) as i32
            let append_result: () | AllocationError =
                bytes::append(managed_data, bytes_view_from_text, ctx.heap)
            if append_result is {
                _: () {
                    let after_append_view: bytes@View = bytes::as_view(managed_data)
                    let after_append_len: i32 = bytes::length(after_append_view) as i32
                    if ((before_append_len == 0) && (after_append_len == 3)) {
                        managed_bytes_capacity_metric = 3
                    } else {
                        managed_bytes_capacity_metric = -1
                    }
                }
                _: AllocationError {
                    managed_bytes_capacity_metric = -1
                }
            }
        }
        _: AllocationError {
            managed_bytes_capacity_metric = -1
        }
    }

    let observed_string_len: i32 =
        managed_string_metric
    let observed_bytes_slice_len: i32 =
        managed_bytes_slice_metric
    let observed_bytes_view_len: i32 =
        managed_bytes_view_metric
    let observed_bytes_capacity_len: i32 =
        managed_bytes_capacity_metric
    let observed_string_append_len: i32 =
        string_append_metric
    let observed_bytes_append_len: i32 =
        bytes_append_metric

    let string_to_managed_ok: bool = observed_string_len == 3
    let bytes_slice_to_managed_ok: bool = observed_bytes_slice_len == 3
    let bytes_view_to_managed_ok: bool = observed_bytes_view_len == 3
    let bytes_with_capacity_ok: bool = observed_bytes_capacity_len == 3
    let string_append_realloc_ok: bool = observed_string_append_len == 4
    let bytes_append_realloc_ok: bool = observed_bytes_append_len == 6

    let string_to_managed_log: bool =
        string_to_managed_ok
    let bytes_slice_to_managed_log: bool =
        bytes_slice_to_managed_ok
    let bytes_view_to_managed_log: bool =
        bytes_view_to_managed_ok
    let bytes_with_capacity_log: bool =
        bytes_with_capacity_ok
    let string_append_realloc_log: bool =
        string_append_realloc_ok
    let bytes_append_realloc_log: bool =
        bytes_append_realloc_ok

    let metric: i32 = if (
        string_to_managed_ok &&
        bytes_slice_to_managed_ok &&
        bytes_view_to_managed_ok &&
        bytes_with_capacity_ok &&
        string_append_realloc_ok &&
        bytes_append_realloc_ok &&
        (string_to_managed_log == true) &&
        (bytes_slice_to_managed_log == true) &&
        (bytes_view_to_managed_log == true) &&
        (bytes_with_capacity_log == true) &&
        (string_append_realloc_log == true) &&
        (bytes_append_realloc_log == true)
    ) { 41 } else { 0 }
    let metric_label: string@View = ManagedAllocationMetricLabel(metric)
    let metric_log_actual: string@View =
        metric_label
    if (metric_log_actual != "41") {
        let fail_marker: string@View = "memory-managed-allocation-fail"
        fail_marker
        return 1
    }

    let success_marker: string@View = "memory-managed-allocation-success"
    success_marker
    return 0
}
