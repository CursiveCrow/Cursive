record MemoryIntrinsicPair {
    left: i32
    right: i32
}

procedure MemoryIntrinsicsMetricLabel(value: i32) -> string@View {
    if (value == 30) {
        return "30"
    }
    return "other"
}

public procedure RunMemoryIntrinsicsCoverage(ctx: Context) -> i32 {
    let src_pair: MemoryIntrinsicPair = MemoryIntrinsicPair { left: 7, right: 9 }
    let copy_pair: MemoryIntrinsicPair = src_pair
    let agg_copy_metric: i32 = copy_pair.left + copy_pair.right

    let src_bytes: [u8; 4] = [1u8, 2u8, 3u8, 4u8]
    let dst_bytes: [u8; 4] = src_bytes
    let array_copy_metric: i32 = (dst_bytes[0] as i32) + (dst_bytes[3] as i32)

    let zero_bytes: [u8; 4] = [0u8, 0u8, 0u8, 0u8]
    let zero_metric: i32 =
        (zero_bytes[0] as i32) +
        (zero_bytes[1] as i32) +
        (zero_bytes[2] as i32) +
        (zero_bytes[3] as i32)

    let bytes_seed: [u8; 3] = [65, 66, 67]
    let bytes_slice: [u8] = bytes_seed
    let bytes_view: bytes@View = bytes::view(bytes_slice)
    let managed_result: bytes@Managed | AllocationError =
        bytes::from_slice(bytes_slice, ctx.heap)
    var append_metric: i32 = -1
    if managed_result is {
        managed_bytes: unique bytes@Managed {
            let append_result: () | AllocationError =
                bytes::append(managed_bytes, bytes_view, ctx.heap)
            if append_result is {
                _: () {
                    let appended_view: bytes@View = bytes::as_view(managed_bytes)
                    append_metric = bytes::length(appended_view) as i32
                }
                _: AllocationError {
                    append_metric = -1
                }
            }
        }
        _: AllocationError {
            append_metric = -1
        }
    }

    let lifetime_scope_ok: bool = {
        let local_bytes: [u8; 2] = [9u8, 8u8]
        let local_copy: [u8; 2] = local_bytes
        (local_copy[0] == 9u8) && (local_copy[1] == 8u8)
    }
    let lifetime_metric: i32 = if (lifetime_scope_ok) { 3 } else { 0 }

    let intrinsics_surface_ok: bool =
        (agg_copy_metric == 16) &&
        (array_copy_metric == 5) &&
        (zero_metric == 0) &&
        (append_metric == 6) &&
        (lifetime_metric == 3)

    let intrinsics_surface_ok_log: bool =
        [[log(label: "memory-managed-intrinsics-surface", expected: true)]]
        intrinsics_surface_ok

    let metric: i32 = if (
        intrinsics_surface_ok &&
        (intrinsics_surface_ok_log == true)
    ) { 30 } else { 0 }
    let metric_label: string@View = MemoryIntrinsicsMetricLabel(metric)
    let metric_log_actual: string@View =
        [[log(label: "observed-memory-managed-intrinsics-metric", expected: "30")]]
        metric_label
    if (metric_log_actual != "30") {
        let fail_marker: string@View = "memory-managed-intrinsics-fail"
        [[log(label: "memory-log-item_fail")]] fail_marker
        return 1
    }

    let success_marker: string@View = "memory-managed-intrinsics-success"
    [[log(label: "memory-log-memory_item_success")]] success_marker
    return 0
}
