procedure ManagedDiagnosticsMetricLabel(value: i32) -> string@View {
    if (value == 79) {
        return "79"
    }
    return "other"
}

procedure ManagedQuotaExhausted(heap: $HeapAllocator) -> bool {
    let result: string@Managed | AllocationError = string::to_managed("qq", heap)
    if result is {
        _: unique string@Managed {
            return false
        }
        _: AllocationError {
            return true
        }
    }
    return false
}

procedure ManagedDropHookReuseProbe(base_heap: $HeapAllocator) -> bool {
    let quota_heap: $HeapAllocator = base_heap~>with_quota(4usize)

    var first_allocation_ok: bool = false
    {
        let first_result: string@Managed | AllocationError =
            string::to_managed("ab", quota_heap)
        if first_result is {
            first_text: unique string@Managed {
                let first_view: string@View = string::as_view(first_text)
                first_allocation_ok = string::length(first_view) as i32 == 2
            }
            _: AllocationError {
                first_allocation_ok = false
            }
        }
    }

    var second_allocation_ok: bool = false
    let second_result: string@Managed | AllocationError =
        string::to_managed("ab", quota_heap)
    if second_result is {
        second_text: unique string@Managed {
            let second_view: string@View = string::as_view(second_text)
            second_allocation_ok = string::length(second_view) as i32 == 2
        }
        _: AllocationError {
            second_allocation_ok = false
        }
    }

    return first_allocation_ok && second_allocation_ok
}

procedure ManagedBytesDropHookReuseProbe(base_heap: $HeapAllocator) -> bool {
    let quota_heap: $HeapAllocator = base_heap~>with_quota(4usize)
    let bytes_seed: [u8; 2] = [65, 66]
    let bytes_slice: [u8] = bytes_seed

    var first_allocation_ok: bool = false
