    return first_allocation_ok && second_allocation_ok
}

procedure ManagedDropHookReallocCapProbe(base_heap: $HeapAllocator) -> bool {
    let quota_heap: $HeapAllocator = base_heap~>with_quota(4usize)

    var first_phase_ok: bool = false
    {
        let first_result: string@Managed | AllocationError =
            string::to_managed("ab", quota_heap)
        if first_result is {
            first_text: unique string@Managed {
                let append_result: () | AllocationError =
                    string::append(first_text, "c", quota_heap)
                if append_result is {
                    _: () {
                        let first_view: string@View = string::as_view(first_text)
                        first_phase_ok = string::length(first_view) as i32 == 3
                    }
                    _: AllocationError {
                        first_phase_ok = false
                    }
                }
            }
            _: AllocationError {
                first_phase_ok = false
            }
        }
    }

    var second_phase_ok: bool = false
    let second_result: string@Managed | AllocationError =
        string::to_managed("wxyz", quota_heap)
    if second_result is {
        second_text: unique string@Managed {
            let second_view: string@View = string::as_view(second_text)
            second_phase_ok = string::length(second_view) as i32 == 4
        }
        _: AllocationError {
            second_phase_ok = false
        }
    }

    return first_phase_ok && second_phase_ok
}

procedure ManagedBytesDropHookReallocCapProbe(base_heap: $HeapAllocator) -> bool {
    let quota_heap: $HeapAllocator = base_heap~>with_quota(4usize)
    let first_seed: [u8; 2] = [65, 66]
    let first_slice: [u8] = first_seed
    let append_seed: [u8; 1] = [67]
    let append_slice: [u8] = append_seed
    let append_view: bytes@View = bytes::view(append_slice)
    let second_seed: [u8; 4] = [70, 71, 72, 73]
    let second_slice: [u8] = second_seed

    var first_phase_ok: bool = false
    {
        let first_result: bytes@Managed | AllocationError =
            bytes::from_slice(first_slice, quota_heap)
        if first_result is {
            first_bytes: unique bytes@Managed {
                let append_result: () | AllocationError =
                    bytes::append(first_bytes, append_view, quota_heap)
                if append_result is {
                    _: () {
                        let first_view: bytes@View = bytes::as_view(first_bytes)
                        first_phase_ok = bytes::length(first_view) as i32 == 3
                    }
                    _: AllocationError {
                        first_phase_ok = false
                    }
                }
            }
            _: AllocationError {
                first_phase_ok = false
            }
        }
    }

    var second_phase_ok: bool = false
    let second_result: bytes@Managed | AllocationError =
        bytes::from_slice(second_slice, quota_heap)
    if second_result is {
        second_bytes: unique bytes@Managed {
            let second_view: bytes@View = bytes::as_view(second_bytes)
            second_phase_ok = bytes::length(second_view) as i32 == 4
        }
        _: AllocationError {
            second_phase_ok = false
        }
    }

    return first_phase_ok && second_phase_ok
}

procedure ManagedNestedQuotaReleaseProbe(base_heap: $HeapAllocator) -> bool {
    let parent_heap: $HeapAllocator = base_heap~>with_quota(4usize)

    var child_phase_ok: bool = false
    {
        let child_heap: $HeapAllocator = parent_heap~>with_quota(4usize)
        let child_result: string@Managed | AllocationError =
            string::to_managed("ab", child_heap)
        if child_result is {
            child_text: unique string@Managed {
                let child_view: string@View = string::as_view(child_text)
                child_phase_ok = string::length(child_view) as i32 == 2
            }
            _: AllocationError {
                child_phase_ok = false
            }
        }
    }

    var parent_phase_ok: bool = false
    let parent_result: string@Managed | AllocationError =
        string::to_managed("wxyz", parent_heap)
    if parent_result is {
        parent_text: unique string@Managed {
            let parent_view: string@View = string::as_view(parent_text)
            parent_phase_ok = string::length(parent_view) as i32 == 4
        }
        _: AllocationError {
            parent_phase_ok = false
        }
    }

    return child_phase_ok && parent_phase_ok
}

procedure ManagedZeroLengthDropProbe(base_heap: $HeapAllocator) -> bool {
    let string_quota: $HeapAllocator = base_heap~>with_quota(1usize)

    var empty_string_ok: bool = false
    {
        let empty_string_result: string@Managed | AllocationError =
            string::to_managed("", string_quota)
        if empty_string_result is {
            empty_text: unique string@Managed {
                let empty_view: string@View = string::as_view(empty_text)
                empty_string_ok = string::length(empty_view) as i32 == 0
            }
            _: AllocationError {
                empty_string_ok = false
            }
        }
    }

    var string_reuse_ok: bool = false
    let nonempty_string_result: string@Managed | AllocationError =
        string::to_managed("a", string_quota)
    if nonempty_string_result is {
        nonempty_text: unique string@Managed {
            let nonempty_view: string@View = string::as_view(nonempty_text)
            string_reuse_ok = string::length(nonempty_view) as i32 == 1
        }
        _: AllocationError {
            string_reuse_ok = false
        }
    }

    let bytes_quota: $HeapAllocator = base_heap~>with_quota(1usize)
    let empty_bytes_view: bytes@View = bytes::view_string("")

    var empty_bytes_ok: bool = false
    {
        let empty_bytes_result: bytes@Managed | AllocationError =
            bytes::to_managed(empty_bytes_view, bytes_quota)
        if empty_bytes_result is {
            empty_bytes: unique bytes@Managed {
                let view_after_alloc: bytes@View = bytes::as_view(empty_bytes)
                empty_bytes_ok = bytes::length(view_after_alloc) as i32 == 0
            }
            _: AllocationError {
                empty_bytes_ok = false
            }
        }
    }

    let byte_seed: [u8; 1] = [65]
    let byte_slice: [u8] = byte_seed
    var bytes_reuse_ok: bool = false
    let nonempty_bytes_result: bytes@Managed | AllocationError =
        bytes::from_slice(byte_slice, bytes_quota)
    if nonempty_bytes_result is {
        nonempty_bytes: unique bytes@Managed {
            let nonempty_view: bytes@View = bytes::as_view(nonempty_bytes)
            bytes_reuse_ok = bytes::length(nonempty_view) as i32 == 1
        }
        _: AllocationError {
            bytes_reuse_ok = false
        }
    }

    return empty_string_ok && string_reuse_ok && empty_bytes_ok && bytes_reuse_ok
}

public procedure RunManagedDiagnosticsAndFailureModes(ctx: Context) -> i32 {
    [[log(label: "memory-log-item_begin")]]

    var quota_source: $HeapAllocator = ctx.heap
    let quota_heap_tight: $HeapAllocator = quota_source~>with_quota(1usize)
    let quota_heap_usable: $HeapAllocator = quota_source~>with_quota(8usize)

    let quota_tight_exhausted: bool = ManagedQuotaExhausted(quota_heap_tight)

    var quota_raw_roundtrip_ok: bool = false
    var quota_raw_reuse_ok: bool = false
    unsafe {
        var first_ptr: *mut u8 = quota_heap_usable~>alloc_raw(8usize)
        if (first_ptr != null) {
            *first_ptr = 90u8
            quota_raw_roundtrip_ok = (*first_ptr == 90u8)
            quota_heap_usable~>dealloc_raw(first_ptr, 8usize)

            var second_ptr: *mut u8 = quota_heap_usable~>alloc_raw(8usize)
            if (second_ptr != null) {
                quota_raw_reuse_ok = true
                quota_heap_usable~>dealloc_raw(second_ptr, 8usize)
            }
        }
    }

    var raw_heap: $HeapAllocator = ctx.heap
    var raw_alloc_ptr: *mut u8 = null
    var raw_payload_roundtrip_ok: bool = false
    unsafe {
        raw_alloc_ptr = raw_heap~>alloc_raw(8usize)
        if (raw_alloc_ptr != null) {
            *raw_alloc_ptr = 66u8
            raw_payload_roundtrip_ok = (*raw_alloc_ptr == 66u8)
            raw_heap~>dealloc_raw(raw_alloc_ptr, 8usize)
        }
    }
    let raw_alloc_roundtrip_ok: bool =
        (raw_alloc_ptr != null) && raw_payload_roundtrip_ok
    let raw_alloc_path_ok: bool =
        (raw_alloc_ptr == null) || raw_payload_roundtrip_ok

    let text_seed: string@View = "heap"
    let bytes_seed: [u8; 2] = [72, 73]
    let bytes_slice: [u8] = bytes_seed

    let managed_text_result: string@Managed | AllocationError =
        string::to_managed(text_seed, raw_heap)
    let managed_bytes_result: bytes@Managed | AllocationError =
        bytes::from_slice(bytes_slice, raw_heap)

    var managed_text_len: i32 = -1
    var managed_clone_len: i32 = -1
    var managed_bytes_len: i32 = -1
    var allocation_path_handled: bool = false

    if managed_text_result is {
        managed_text: unique string@Managed {
            let managed_view: string@View = string::as_view(managed_text)
            managed_text_len = string::length(managed_view) as i32
            let clone_result: string@Managed | AllocationError =
                string::clone_with(managed_text, raw_heap)
            if clone_result is {
                cloned_text: unique string@Managed {
                    let cloned_view: string@View = string::as_view(cloned_text)
                    managed_clone_len = string::length(cloned_view) as i32
                    allocation_path_handled = true
                }
                _: AllocationError {
                    managed_clone_len = -1
                    allocation_path_handled = true
                }
            }
        }
        _: AllocationError {
            managed_text_len = -1
            managed_clone_len = -1
            allocation_path_handled = true
        }
    }

    if managed_bytes_result is {
        managed_bytes: unique bytes@Managed {
            let managed_view: bytes@View = bytes::as_view(managed_bytes)
            managed_bytes_len = bytes::length(managed_view) as i32
            allocation_path_handled = true
        }
        _: AllocationError {
            managed_bytes_len = -1
            allocation_path_handled = true
        }
    }

    let managed_drop_hook_reuse_ok: bool = ManagedDropHookReuseProbe(ctx.heap)
    let managed_bytes_drop_hook_reuse_ok: bool =
        ManagedBytesDropHookReuseProbe(ctx.heap)
    let managed_drop_hook_realloc_cap_ok: bool =
        ManagedDropHookReallocCapProbe(ctx.heap)
    let managed_bytes_drop_hook_realloc_cap_ok: bool =
        ManagedBytesDropHookReallocCapProbe(ctx.heap)
    let managed_nested_quota_release_ok: bool =
        ManagedNestedQuotaReleaseProbe(ctx.heap)
    let managed_zero_length_drop_ok: bool =
        ManagedZeroLengthDropProbe(ctx.heap)

    let quota_tight_exhausted_log: bool = [[log(label: "memory-managed-heap-with-quota-tight", expected: true)]] quota_tight_exhausted
    let quota_raw_roundtrip_ok_log: bool = [[log(label: "memory-managed-heap-with-quota-roundtrip", expected: true)]] quota_raw_roundtrip_ok
    [[log(label: "observed-memory-managed-heap-with-quota-reuse")]] quota_raw_reuse_ok

    [[log(label: "observed-memory-managed-raw-alloc-roundtrip")]] raw_alloc_roundtrip_ok
    let raw_alloc_roundtrip_ok_log: bool = [[log(label: "memory-managed-raw-alloc-dealloc-runtime", expected: true)]] raw_alloc_path_ok

    let managed_text_ok: bool = managed_text_len == 4
    let managed_clone_ok: bool = managed_clone_len == 4
    let managed_bytes_ok: bool = managed_bytes_len == 2
    let allocation_error_runtime_ok: bool = allocation_path_handled

    let managed_text_ok_log: bool = [[log(label: "memory-managed-allocation-runtime", expected: true)]] managed_text_ok
    let managed_clone_ok_log: bool = [[log(label: "memory-managed-clone-runtime", expected: true)]] managed_clone_ok
    let managed_bytes_ok_log: bool = [[log(label: "memory-managed-bytes-runtime", expected: true)]] managed_bytes_ok
    let allocation_error_runtime_ok_log: bool = [[log(label: "memory-managed-allocation-error-path", expected: true)]] allocation_error_runtime_ok
    let managed_drop_hook_reuse_ok_log: bool = [[log(label: "memory-managed-drop-hook-reuse", expected: true)]] managed_drop_hook_reuse_ok
    let managed_bytes_drop_hook_reuse_ok_log: bool = [[log(label: "memory-managed-bytes-drop-hook-reuse", expected: true)]] managed_bytes_drop_hook_reuse_ok
    let managed_drop_hook_realloc_cap_ok_log: bool = [[log(label: "memory-managed-drop-hook-realloc-capacity", expected: true)]] managed_drop_hook_realloc_cap_ok
    let managed_bytes_drop_hook_realloc_cap_ok_log: bool = [[log(label: "memory-managed-bytes-drop-hook-realloc-capacity", expected: true)]] managed_bytes_drop_hook_realloc_cap_ok
    let managed_nested_quota_release_ok_log: bool = [[log(label: "memory-managed-drop-hook-nested-quota-release", expected: true)]] managed_nested_quota_release_ok
    let managed_zero_length_drop_ok_log: bool = [[log(label: "memory-managed-drop-hook-zero-length", expected: true)]] managed_zero_length_drop_ok

    let metric_ok: bool =
        (quota_tight_exhausted_log == true) &&
        (quota_raw_roundtrip_ok_log == true) &&
        (raw_alloc_roundtrip_ok_log == true) &&
        (managed_text_ok_log == true) &&
        (managed_clone_ok_log == true) &&
        (managed_bytes_ok_log == true) &&
        (allocation_error_runtime_ok_log == true) &&
        (managed_drop_hook_reuse_ok_log == true) &&
        (managed_bytes_drop_hook_reuse_ok_log == true) &&
        (managed_drop_hook_realloc_cap_ok_log == true) &&
        (managed_bytes_drop_hook_realloc_cap_ok_log == true) &&
        (managed_nested_quota_release_ok_log == true) &&
        (managed_zero_length_drop_ok_log == true)
    let metric: i32 = if (metric_ok) { 79 } else { 0 }
    let metric_label: string@View = ManagedDiagnosticsMetricLabel(metric)
    let metric_log_actual: string@View = [[log(label: "observed-memory-managed-diagnostics-metric", expected: "79")]] metric_label
    if (metric_log_actual != "79") {
        [[log(label: "memory-log-item_fail")]]
        return 1
    }

    [[log(label: "memory-log-memory_item_success")]]
    return 0
}
