procedure ProvenanceStatementFlowMetricLabel(value: i32) -> string@View {
    if (value == 41) {
        return "41"
    }
    return "other"
}

public procedure RunStatementAndFrameProvenanceFlow(ctx: Context) -> i32 {
    var statement_metric: i32 = 0
    let base_value: i32 = 5
    let base_ptr: Ptr<i32>@Valid = &base_value

    if ((*base_ptr) == 5) {
        statement_metric = statement_metric + 4
    } else {
        statement_metric = statement_metric - 1
    }

    var loop_counter: i32 = 0
    loop {
        if (loop_counter == 2) {
            break
        }
        loop_counter = loop_counter + 1
    }
    statement_metric = statement_metric + loop_counter

    let union_probe: i32 | bool = 9
    let if_case_metric: i32 = if union_probe is {
        _: i32 { 9 }
        _: bool { 0 }
    }
    statement_metric = statement_metric + if_case_metric

    var frame_region_runtime_ok: bool = false
    var frame_inner_runtime_ok: bool = false
    region as r {
        let region_value: i32 = r ^ 7
        let region_ptr: Ptr<i32>@Valid = &region_value
        let region_check_ok: bool = (*region_ptr) == 7
        let region_check_ok_log: bool = region_check_ok
        frame_region_runtime_ok = region_check_ok_log == true

        r.frame {
            let frame_value: i32 = r ^ 6
            let frame_ptr: Ptr<i32>@Valid = &frame_value
            let frame_check_ok: bool = (*frame_ptr) == 6
            let frame_check_ok_log: bool = frame_check_ok
            frame_inner_runtime_ok = frame_check_ok_log == true
        }
    }

    let capture_seed: i32 = 10
    let closure_fn = |delta: i32| -> i32 {
        capture_seed + delta
    }
    let closure_metric: i32 = closure_fn(3)
    let async_metric: i32 = parallel ctx~>cpu() {
        let h = spawn { capture_seed + 4 }
        wait h
    }

    let statement_flow_ok: bool = statement_metric == 15
    let frame_target_lifetime_ok: bool =
        frame_region_runtime_ok && frame_inner_runtime_ok
    let capture_flow_ok: bool = (closure_metric == 13) && (async_metric == 14)

    let diag_escape_assignment: string@View = "E-MEM-3020"
    let diag_async_capture_lifetime: string@View = "E-CON-0280"
    let diag_async_operation_escape: string@View = "E-CON-0281"

    let statement_flow_ok_log: bool = statement_flow_ok
    let frame_target_lifetime_ok_log: bool = frame_target_lifetime_ok
    let capture_flow_ok_log: bool = capture_flow_ok

    let diag_escape_assignment_log: string@View = diag_escape_assignment
    let diag_async_capture_lifetime_log: string@View = diag_async_capture_lifetime
    let diag_async_operation_escape_log: string@View = diag_async_operation_escape

    let diag_matrix_ok: bool =
        (diag_escape_assignment_log == "E-MEM-3020") &&
        (diag_async_capture_lifetime_log == "E-CON-0280") &&
        (diag_async_operation_escape_log == "E-CON-0281")
    let diag_matrix_ok_log: bool = diag_matrix_ok

    let metric_ok: bool =
        (statement_flow_ok_log == true) &&
        (frame_target_lifetime_ok_log == true) &&
        (capture_flow_ok_log == true) &&
        (diag_matrix_ok_log == true)

    let metric: i32 = if (metric_ok) { 41 } else { 0 }
    let metric_label: string@View = ProvenanceStatementFlowMetricLabel(metric)
    let metric_log_actual: string@View = metric_label
    if (metric_log_actual != "41") {
        return 1
    }

    return 0
}
