procedure ProvenanceDiagnosticsMetricLabel(value: i32) -> string@View {
    if (value == 63) {
        return "63"
    }
    return "other"
}

procedure ProvenanceDeferProbe() -> i32 {
    var metric: i32 = 0
    {
        defer {
            metric = metric + 2
        }
        metric = metric + 3
    }
    return metric
}

public procedure RunProvenanceDiagnostics(ctx: Context) -> i32 {
    let stack_value: i32 = 6
    let stack_ptr: Ptr<i32>@Valid = &stack_value
    let stack_read_metric: i32 = *stack_ptr
    let stack_runtime_ok: bool = (stack_read_metric == 6) && (stack_ptr == &stack_value)

    let capture_seed: i32 = 5
    let capture_fn = |delta: i32| -> i32 {
        capture_seed + delta
    }
    let closure_capture_metric: i32 = capture_fn(4)
    let async_capture_metric: i32 = parallel ctx~>cpu() {
        let capture_handle = spawn { capture_seed + 5 }
        let capture_value: i32 = wait capture_handle
        capture_value
    }
    let capture_runtime_ok: bool =
        (closure_capture_metric == 9) && (async_capture_metric == 10)

    region as r {
        let region_value: i32 = r ^ 7
        let region_ptr: Ptr<i32>@Valid = &region_value
        let region_runtime_ok: bool = (*region_ptr) == 7
        let region_runtime_ok_log: bool = region_runtime_ok
        if (region_runtime_ok_log != true) {
            return 1
        }

        r.frame {
            let frame_value: i32 = r ^ 8
            let frame_ptr: Ptr<i32>@Valid = &frame_value
            let frame_runtime_ok: bool = (*frame_ptr) == 8
            let frame_runtime_ok_log: bool = frame_runtime_ok
            if (frame_runtime_ok_log != true) {
                return 1
            }
        }
    }

    var nested_region_order_runtime_ok: bool = false
    region as outer_region {
        let outer_value: i32 = outer_region ^ 4
        let outer_ptr: Ptr<i32>@Valid = &outer_value

        region as inner_region {
            let inner_value: i32 = inner_region ^ 7
            let inner_ptr: Ptr<i32>@Valid = &inner_value
            let nested_region_ok: bool = (*outer_ptr == 4) && (*inner_ptr == 7)
            let nested_region_ok_log: bool = nested_region_ok
            nested_region_order_runtime_ok = nested_region_ok_log == true
        }
    }

    let managed_heap_result: string@Managed | AllocationError =
        string::to_managed("pv", ctx.heap)
    var heap_metric: i32 = -1
    if managed_heap_result is {
        managed_text: unique string@Managed {
            let managed_view: string@View = string::as_view(managed_text)
            heap_metric = string::length(managed_view) as i32
        }
        _: AllocationError {
            heap_metric = -1
        }
    }
    let heap_runtime_ok: bool = heap_metric == 2

    let cleanup_metric: i32 = ProvenanceDeferProbe()
    let cleanup_runtime_ok: bool = cleanup_metric == 5

    let stack_runtime_ok_log: bool =
        stack_runtime_ok
    let capture_runtime_ok_log: bool =
        capture_runtime_ok
    let heap_runtime_ok_log: bool =
        heap_runtime_ok
    let cleanup_runtime_ok_log: bool =
        cleanup_runtime_ok

    let diag_escape_err: string@View = "E-MEM-3020"
    let diag_async_capture_lifetime_err: string@View = "E-CON-0280"
    let diag_async_operation_escape_err: string@View = "E-CON-0281"

    let diag_escape_err_log: string@View = diag_escape_err
    let diag_async_capture_lifetime_err_log: string@View = diag_async_capture_lifetime_err
    let diag_async_operation_escape_err_log: string@View = diag_async_operation_escape_err

    let diag_matrix_ok: bool =
        (diag_escape_err_log == "E-MEM-3020") &&
        (diag_async_capture_lifetime_err_log == "E-CON-0280") &&
        (diag_async_operation_escape_err_log == "E-CON-0281")
    let diag_matrix_ok_log: bool = diag_matrix_ok

    let metric_ok: bool = (stack_runtime_ok_log == true) &&
        (capture_runtime_ok_log == true) &&
        (heap_runtime_ok_log == true) &&
        (cleanup_runtime_ok_log == true) &&
        (nested_region_order_runtime_ok == true) &&
        (diag_matrix_ok_log == true)
    let metric: i32 = if (metric_ok) { 63 } else { 0 }
    let metric_label: string@View = ProvenanceDiagnosticsMetricLabel(metric)
    let metric_log_actual: string@View =
        metric_label
    if (metric_log_actual != "63") {
        return 1
    }

    return 0
}
