procedure EscapeAnalysisMetricLabel(value: i32) -> string@View {
    if (value == 49) {
        return "49"
    }
    return "other"
}

public procedure RunEscapeAnalysisAssignmentsAndCaptures(ctx: Context) -> i32 {
    var assign_target: i32 = 4
    assign_target = assign_target + 3
    assign_target += 2
    let assignment_metric: i32 = assign_target

    let capture_seed: i32 = 5
    let capture_fn = |delta: i32| -> i32 {
        capture_seed + delta
    }
    let closure_metric: i32 = capture_fn(4)

    let nested_capture_seed: i32 = 2
    let nested_closure_metric: i32 = parallel ctx~>cpu() {
        let nested_capture_fn = |delta: i32| -> i32 {
            nested_capture_seed + delta
        }
        nested_capture_fn(8)
    }

    let async_capture_metric: i32 = parallel ctx~>cpu() {
        let capture_handle = spawn { capture_seed + 5 }
        let capture_value: i32 = wait capture_handle
        capture_value
    }

    let async_capture_chain_metric: i32 = parallel ctx~>cpu() {
        let base_seed: i32 = 3
        let first_handle = spawn { base_seed + 4 }
        let second_handle = spawn { base_seed + 5 }
        let first_value: i32 = wait first_handle
        let second_value: i32 = wait second_handle
        first_value + second_value
    }

    let assignment_metric_log: i32 =
        assignment_metric
    let closure_metric_log: i32 =
        closure_metric
    let nested_closure_metric_log: i32 =
        nested_closure_metric
    let async_capture_metric_log: i32 =
        async_capture_metric
    let async_capture_chain_metric_log: i32 =
        async_capture_chain_metric

    let assignment_ok: bool = assignment_metric_log == 9
    let compound_ok: bool = assignment_metric_log == 9
    let closure_ok: bool = closure_metric_log == 9
    let nested_closure_ok: bool = nested_closure_metric_log == 10
    let async_capture_ok: bool = async_capture_metric_log == 10
    let async_capture_chain_ok: bool = async_capture_chain_metric_log == 15

    let assignment_ok_log: bool = assignment_ok
    let compound_ok_log: bool = compound_ok
    let closure_ok_log: bool = closure_ok
    let nested_closure_ok_log: bool = nested_closure_ok
    let async_capture_ok_log: bool = async_capture_ok
    let async_capture_chain_ok_log: bool = async_capture_chain_ok

    let metric: i32 = if (
        assignment_ok &&
        compound_ok &&
        closure_ok &&
        nested_closure_ok &&
        async_capture_ok &&
        async_capture_chain_ok &&
        (assignment_ok_log == true) &&
        (compound_ok_log == true) &&
        (closure_ok_log == true) &&
        (nested_closure_ok_log == true) &&
        (async_capture_ok_log == true) &&
        (async_capture_chain_ok_log == true)
    ) { 49 } else { 0 }
    let metric_label: string@View = EscapeAnalysisMetricLabel(metric)
    let metric_log_actual: string@View =
        metric_label
    if (metric_log_actual != "49") {
        let fail_marker: string@View = "memory-provenance-escape-fail"
        fail_marker
        return 1
    }

    let success_marker: string@View = "memory-provenance-escape-success"
    success_marker
    return 0
}
