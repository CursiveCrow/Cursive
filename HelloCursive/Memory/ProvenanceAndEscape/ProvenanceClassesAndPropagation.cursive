procedure ProvenanceClassesMetricLabel(value: i32) -> string@View {
    if (value == 19) {
        return "19"
    }
    return "other"
}

public procedure RunProvenanceClassesAndPropagation(ctx: Context) -> i32 {
    let stack_value: i32 = 6
    let stack_ptr: Ptr<i32>@Valid = &stack_value
    let read_metric: i32 = *stack_ptr
    let global_literal_view: string@View = "global-provenance"
    let global_metric: i32 = string::length(global_literal_view) as i32

    region as r {
        let region_value: i32 = r ^ 8
        let region_ptr: Ptr<i32>@Valid = &region_value
        let region_ok: bool = (*region_ptr) == 8
        let region_ok_log: bool = [[log(label: "memory-provenance-region-class", expected: true)]] region_ok
        if (region_ok_log != true) {
            let fail_marker: string@View = "memory-provenance-classes-fail"
            [[log(label: "memory-log-item_fail")]] fail_marker
            return 1
        }
    }

    [[log(label: "memory-provenance-probe-after-region")]] true

    [[log(label: "memory-provenance-probe-before-to_managed")]] true
    let managed_heap_result: string@Managed | AllocationError =
        string::to_managed("hp", ctx.heap)
    [[log(label: "memory-provenance-probe-after-to_managed")]] true
    var heap_metric: i32 = -1
    if managed_heap_result is {
        managed_text: unique string@Managed {
            let managed_view: string@View = string::as_view(managed_text)
            heap_metric = string::length(managed_view) as i32
        }
        _: AllocationError {
            heap_metric = -1
        }
    }

    let stack_ok: bool = read_metric == 6
    let global_ok: bool = global_metric == 17
    let heap_ok: bool = heap_metric == 2
    let place_alias_ptr: Ptr<i32>@Valid = &stack_value
    let place_ok: bool = (*place_alias_ptr) == 6
    let expr_ok: bool = (read_metric + 2) == 8

    let stack_ok_log: bool = [[log(label: "memory-provenance-stack-class", expected: true)]] stack_ok
    let global_ok_log: bool = [[log(label: "memory-provenance-global-class", expected: true)]] global_ok
    let heap_ok_log: bool = [[log(label: "memory-provenance-heap-class", expected: true)]] heap_ok
    let place_ok_log: bool = [[log(label: "memory-provenance-place-propagation", expected: true)]] place_ok
    let expr_ok_log: bool = [[log(label: "memory-provenance-expression-propagation", expected: true)]] expr_ok

    let metric: i32 = if (stack_ok &&
        global_ok &&
        heap_ok &&
        place_ok &&
        expr_ok &&
        (stack_ok_log == true) &&
        (global_ok_log == true) &&
        (heap_ok_log == true) &&
        (place_ok_log == true) &&
        (expr_ok_log == true)) { 19 } else { 0 }
    let metric_label: string@View = ProvenanceClassesMetricLabel(metric)
    let metric_log_actual: string@View = [[log(label: "observed-memory-provenance-classes-metric", expected: "19")]] metric_label
    if (metric_log_actual != "19") {
        let fail_marker: string@View = "memory-provenance-classes-fail"
        [[log(label: "memory-log-item_fail")]] fail_marker
        return 1
    }

    let success_marker: string@View = "memory-provenance-classes-success"
    [[log(label: "memory-log-memory_item_success")]] success_marker
    return 0
}
