procedure SequentialOrderingMetricLabel(value: i32) -> string@View {
    if (value == 24) {
        return "24"
    }
    return "other"
}

public procedure RunSequentialOrderingAndBoundaryScope(ctx: Context) -> i32 {
    let _ = ctx

    var first_slot: shared i32 = 2
    # first_slot write {
        let rmw_warning_3 = first_slot
        first_slot = rmw_warning_3 + 3
    }

    var read_back_metric: i32 = 0
    # first_slot read {
        read_back_metric = first_slot
    }

    var second_slot: shared i32 = 1
    # second_slot write {
        let rmw_warning_4 = second_slot
        second_slot = rmw_warning_4 + 2
    }
    # second_slot write {
        let rmw_warning_5 = second_slot
        second_slot = rmw_warning_5 * 3
    }

    let second_metric: i32 = second_slot
    let boundary_ptr: Ptr<shared i32>@Valid = &second_slot
    let boundary_raw: *imm i32 =
        unsafe { transmute<Ptr<shared i32>@Valid, *imm i32>(boundary_ptr) }
    let boundary_metric: i32 = unsafe { *boundary_raw }

    let second_metric_log: i32 =
        second_metric
    let read_back_metric_log: i32 =
        read_back_metric
    let boundary_metric_log: i32 =
        boundary_metric

    let sequential_ok: bool = second_metric_log == 9
    let key_consistency_ok: bool = read_back_metric_log == 5
    let boundary_scope_ok: bool = boundary_metric_log == 9

    let sequential_log: bool = sequential_ok
    let key_consistency_log: bool = key_consistency_ok
    let boundary_scope_log: bool = boundary_scope_ok

    let metric: i32 = if (sequential_ok && key_consistency_ok && boundary_scope_ok && (sequential_log == true) && (key_consistency_log == true) && (boundary_scope_log == true)) { 24 } else { 0 }
    let metric_label: string@View = SequentialOrderingMetricLabel(metric)
    let metric_log_actual: string@View = metric_label
    if (metric_log_actual != "24") {
        let fail_marker: string@View = "memory-boundary-sequential-fail"
        fail_marker
        return 1
    }

    let success_marker: string@View = "memory-boundary-sequential-success"
    success_marker
    return 0
}
