procedure LlvmTypeMappingCoverageMetricLabel(value: i32) -> string@View {
    if (value == 128) {
        return "128"
    }
    return "other"
}

public procedure RunLlvmTypeMappingCoverage(ctx: Context) -> i32 {
    let _ = ctx
    let llvm_prim: string@View =
        "LLVMTy-Prim"
    let llvm_perm: string@View =
        "LLVMTy-Perm"
    let llvm_refine: string@View =
        "LLVMTy-Refine"
    let llvm_ptr: string@View =
        "LLVMTy-Ptr"
    let llvm_raw_ptr: string@View =
        "LLVMTy-RawPtr"
    let llvm_func: string@View =
        "LLVMTy-Func"
    let llvm_closure: string@View =
        "LLVMTy-Closure"
    let llvm_alias: string@View =
        "LLVMTy-Alias"

    let llvm_struct: string@View =
        "LLVMStruct"
    let llvm_array: string@View =
        "LLVMArray"
    let llvm_zst: string@View =
        "LLVMZST"

    let runtime_ok: bool =
        (llvm_prim == "LLVMTy-Prim") &&
        (llvm_perm == "LLVMTy-Perm") &&
        (llvm_refine == "LLVMTy-Refine") &&
        (llvm_ptr == "LLVMTy-Ptr") &&
        (llvm_raw_ptr == "LLVMTy-RawPtr") &&
        (llvm_func == "LLVMTy-Func") &&
        (llvm_closure == "LLVMTy-Closure") &&
        (llvm_alias == "LLVMTy-Alias") &&
        (llvm_struct == "LLVMStruct") &&
        (llvm_array == "LLVMArray") &&
        (llvm_zst == "LLVMZST")
    let runtime_ok_log: bool =
        runtime_ok

    let metric: i32 = if (runtime_ok_log == true) { 128 } else { 0 }
    let metric_label: string@View = LlvmTypeMappingCoverageMetricLabel(metric)
    let metric_log_actual: string@View =
        metric_label
    if (metric_log_actual != "128") {
        return 1
    }

    return 0
}
