modal LayoutSurfaceModal {
    @Empty {
    }
    @Payload {
        value: i32
    }
}

procedure LayoutSurfaceMetricLabel(value: i32) -> string@View {
    if (value == 26) {
        return "26"
    }
    return "other"
}

public procedure RunLayoutSurfaceCoverage(ctx: Context) -> i32 {
    let text_seed: string@View = "ly"
    let text_managed_result: string@Managed | AllocationError =
        string::to_managed(text_seed, ctx.heap)

    let bytes_seed: [u8; 2] = [65, 66]
    let bytes_slice: [u8] = bytes_seed
    let bytes_managed_result: bytes@Managed | AllocationError =
        bytes::from_slice(bytes_slice, ctx.heap)

    var managed_string_len: i32 = -1
    if text_managed_result is {
        managed_text: unique string@Managed {
            let view: string@View = string::as_view(managed_text)
            managed_string_len = string::length(view) as i32
        }
        _: AllocationError {
            managed_string_len = -1
        }
    }

    var managed_bytes_len: i32 = -1
    if bytes_managed_result is {
        managed_bytes: unique bytes@Managed {
            let view: bytes@View = bytes::as_view(managed_bytes)
            managed_bytes_len = bytes::length(view) as i32
        }
        _: AllocationError {
            managed_bytes_len = -1
        }
    }

    let tuple_probe: (i32, bool) = (9, true)
    let array_probe: [i32; 2] = [4, 6]
    let slice_probe: [i32] = array_probe
    let union_bool_case: bool = slice_probe[0] < slice_probe[1]
    let union_probe: i32 | bool = union_bool_case
    let modal_probe: LayoutSurfaceModal =
        widen(LayoutSurfaceModal@Payload { value: 7 })

    let tuple_metric: i32 = if (tuple_probe.1) { tuple_probe.0 } else { 0 }
    let slice_metric: i32 = slice_probe[0] + slice_probe[1]
    let union_metric: i32 = if union_probe is {
        _: i32 { 0 }
        _: bool { 1 }
    }
    let modal_metric: i32 = if modal_probe is {
        @Empty { } { 0 }
        @Payload { value: v } { v }
    }

    let managed_views_ok: bool =
        (managed_string_len == 2) && (managed_bytes_len == 2)
    let tuple_array_slice_ok: bool =
        (tuple_metric == 9) && (slice_metric == 10)
    let union_modal_ok: bool = (union_metric == 1) && (modal_metric == 7)

    let managed_views_ok_log: bool = [[log(label: "memory-layout-managed-view-shapes", expected: true)]] managed_views_ok
    let tuple_array_slice_ok_log: bool = [[log(label: "memory-layout-tuple-array-slice-shapes", expected: true)]] tuple_array_slice_ok
    let union_modal_ok_log: bool = [[log(label: "memory-layout-union-modal-shapes", expected: true)]] union_modal_ok

    let metric_ok: bool =
        (managed_views_ok_log == true) &&
        (tuple_array_slice_ok_log == true) &&
        (union_modal_ok_log == true)

    let metric: i32 = if (metric_ok) { 26 } else { 0 }
    let metric_label: string@View = LayoutSurfaceMetricLabel(metric)
    let metric_log_actual: string@View = [[log(label: "observed-memory-layout-surface-coverage-metric", expected: "26")]] metric_label
    if (metric_log_actual != "26") {
        [[log(label: "memory-log-item_fail")]]
        return 1
    }

    [[log(label: "memory-log-memory_item_success")]]
    return 0
}
