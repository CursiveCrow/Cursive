public procedure runGroup(ctx: Context) -> i32 {
    let status_forms: i32 = RunRegionAndFrameForms(ctx)
    if (status_forms != 0) {
        return status_forms
    }

    let status_alloc: i32 = RunRegionOptionsAndAllocation(ctx)
    if (status_alloc != 0) {
        return status_alloc
    }

    let status_diag: i32 = RunRegionLifecycleAndDiagnostics(ctx)
    if (status_diag != 0) {
        return status_diag
    }

    return 0
}
