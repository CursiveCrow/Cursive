procedure RegionFrameFormsMetricLabel(value: i32) -> string@View {
    if (value == 14) {
        return "14"
    }
    return "other"
}

public procedure RunRegionAndFrameForms(ctx: Context) -> i32 {
    let _ = ctx
    var alias_region_probe_ok: bool = false
    region as r {
        let local_value: i32 = 4
        let local_ok: bool = local_value == 4
        let local_ok_log = local_ok
        alias_region_probe_ok = local_ok_log == true
    }

    var no_alias_region_probe_ok: bool = false
    region {
        let local_value: i32 = 3
        let local_ok: bool = local_value == 3
        let local_ok_log = local_ok
        no_alias_region_probe_ok = local_ok_log == true
    }

    var frame_implicit_probe_ok: bool = false
    region as r {
        var local_value: i32 = 3
        frame {
            local_value = local_value + 5
        }
        let frame_implicit_ok: bool = local_value == 8
        let frame_implicit_ok_log = frame_implicit_ok
        frame_implicit_probe_ok = frame_implicit_ok_log == true
    }

    var frame_explicit_probe_ok: bool = false
    region as r {
        var local_value: i32 = 2
        r.frame {
            local_value = local_value + 7
        }
        let frame_explicit_ok: bool = local_value == 9
        let frame_explicit_ok_log = frame_explicit_ok
        frame_explicit_probe_ok = frame_explicit_ok_log == true
    }

    let metric: i32 = if (alias_region_probe_ok &&
        no_alias_region_probe_ok &&
        frame_implicit_probe_ok &&
        frame_explicit_probe_ok) {
        14
    } else {
        0
    }
    let metric_label: string@View = RegionFrameFormsMetricLabel(metric)
    let metric_log_actual = metric_label
    if (metric_log_actual != "14") {
        return 1
    }

    return 0
}
