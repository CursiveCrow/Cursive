procedure RegionOptionsAllocationMetricLabel(value: i32) -> string@View {
    if (value == 37) {
        return "37"
    }
    return "other"
}

public procedure RunRegionOptionsAndAllocation(ctx: Context) -> i32 {
    let _ = ctx
    var implicit_explicit_alloc_ok: bool = false
    region (RegionOptions()) as r {
        let implicit_alloc: i32 = ^2
        let explicit_alloc: i32 = r ^ 5
        let alloc_ok: bool = (implicit_alloc + explicit_alloc) == 7
        let alloc_ok_log = alloc_ok
        implicit_explicit_alloc_ok = alloc_ok_log == true
    }

    var options_alloc_probe_ok: bool = false
    region (RegionOptions { stack_size: 0usize, name: "memory-region" }) as r {
        let options_alloc: i32 = r ^ 6
        let options_ok: bool = options_alloc == 6
        let options_ok_log = options_ok
        options_alloc_probe_ok = options_ok_log == true
    }

    var method_alloc_probe_ok: bool = false
    region (RegionOptions { stack_size: 0usize, name: "memory-region-method-alloc" }) as r {
        let method_alloc: i32 = r~>alloc(8)
        let method_alloc_ok: bool = method_alloc == 8
        let method_alloc_ok_log = method_alloc_ok
        method_alloc_probe_ok = method_alloc_ok_log == true
    }

    var new_scoped_probe_ok: bool = false
    let new_scoped_opts: RegionOptions = RegionOptions { stack_size: 0usize, name: "memory-region-new-scoped" }
    var scoped_region: unique Region@Active = Region::new_scoped(new_scoped_opts)
    let scoped_alloc: i32 = scoped_region~>alloc(9)
    let scoped_alloc_ok: bool = scoped_alloc == 9
    let scoped_alloc_ok_log = scoped_alloc_ok
    unsafe {
        scoped_region~>free_unchecked()
    }
    new_scoped_probe_ok = scoped_alloc_ok_log == true

    let metric: i32 = if (implicit_explicit_alloc_ok &&
        options_alloc_probe_ok &&
        method_alloc_probe_ok &&
        new_scoped_probe_ok) { 37 } else { 0 }
    let metric_label: string@View = RegionOptionsAllocationMetricLabel(metric)
    let metric_log_actual = metric_label
    if (metric_log_actual != "37") {
        return 1
    }

    return 0
}
