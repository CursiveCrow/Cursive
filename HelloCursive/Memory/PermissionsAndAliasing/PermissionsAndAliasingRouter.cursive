public procedure runGroup(ctx: Context) -> i32 {
    let status_lattice: i32 = RunPermissionLatticeAndCoercions(ctx)
    if (status_lattice != 0) {
        return status_lattice
    }

    let status_exclusivity: i32 = RunExclusivityAndOverlapContracts(ctx)
    if (status_exclusivity != 0) {
        return status_exclusivity
    }

    let status_aliasing: i32 = RunUniqueAliasingAndRestoration(ctx)
    if (status_aliasing != 0) {
        return status_aliasing
    }

    let status_diag: i32 = RunPermissionsDiagnostics(ctx)
    if (status_diag != 0) {
        return status_diag
    }

    return 0
}
