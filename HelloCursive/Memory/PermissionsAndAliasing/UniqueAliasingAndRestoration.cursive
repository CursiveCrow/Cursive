procedure PermissionsAliasReadConst(value: const i32) -> i32 {
    return value
}

procedure PermissionsAliasReadShared(value: shared i32) -> i32 {
    return value
}

procedure PermissionsAliasReadUnique(value: unique i32) -> i32 {
    return value
}

procedure PermissionsAliasMetricLabel(value: i32) -> string@View {
    if (value == 27) {
        return "27"
    }
    return "other"
}

public procedure RunUniqueAliasingAndRestoration(ctx: Context) -> i32 {
    let _ = ctx
    [[log(label: "memory-log-item_begin")]]

    let unique_seed: unique i32 = 8
    let unique_metric: i32 = PermissionsAliasReadUnique(unique_seed)
    let shared_metric: i32 = {
        let shared_seed: shared i32 = unique_seed
        PermissionsAliasReadShared(shared_seed)
    }
    let const_metric: i32 = {
        let shared_seed_for_const: shared i32 = unique_seed
        let const_seed: const i32 = shared_seed_for_const
        PermissionsAliasReadConst(const_seed)
    }

    let restore_seed: unique i32 = 9
    let restore_scoped_metric: i32 = {
        let restore_shared: shared i32 = restore_seed
        let restore_const: const i32 = restore_shared
        PermissionsAliasReadConst(restore_const)
    }
    let restored_unique_metric: i32 = PermissionsAliasReadUnique(restore_seed)

    let alias_seed: unique i32 = 6
    var alias_sum: i32 = 0
    {
        let alias_shared: shared i32 = alias_seed
        alias_sum = alias_sum + PermissionsAliasReadShared(alias_shared)
        let alias_const: const i32 = alias_shared
        alias_sum = alias_sum + PermissionsAliasReadConst(alias_const)
    }
    let alias_unique_metric: i32 = PermissionsAliasReadUnique(alias_seed)

    let transfer_source: unique i32 = 14
    let transfer_target: unique i32 = move transfer_source
    let transfer_metric: i32 = PermissionsAliasReadUnique(transfer_target)

    let downgrade_ok: bool =
        (unique_metric == 8) && (shared_metric == 8) && (const_metric == 8)
    let restore_ok: bool =
        (restore_scoped_metric == 9) && (restored_unique_metric == 9)
    let alias_ok: bool =
        (alias_sum == 12) && (alias_unique_metric == 6)
    let transfer_ok: bool = transfer_metric == 14

    let downgrade_ok_log: bool = [[log(label: "memory-permissions-unique-downgrade", expected: true)]] downgrade_ok
    let restore_ok_log: bool = [[log(label: "memory-permissions-restore-across-scope", expected: true)]] restore_ok
    let alias_ok_log: bool = [[log(label: "memory-permissions-aliasing-coexistence", expected: true)]] alias_ok
    let transfer_ok_log: bool = [[log(label: "memory-permissions-unique-transfer", expected: true)]] transfer_ok

    let metric_ok: bool =
        (downgrade_ok_log == true) &&
        (restore_ok_log == true) &&
        (alias_ok_log == true) &&
        (transfer_ok_log == true)
    let metric: i32 = if (metric_ok) { 27 } else { 0 }
    let metric_label: string@View = PermissionsAliasMetricLabel(metric)
    let metric_log_actual: string@View = [[log(label: "observed-memory-permissions-aliasing-metric", expected: "27")]] metric_label
    if (metric_log_actual != "27") {
        [[log(label: "memory-log-item_fail")]]
        return 1
    }

    [[log(label: "memory-log-memory_item_success")]]
    return 0
}
