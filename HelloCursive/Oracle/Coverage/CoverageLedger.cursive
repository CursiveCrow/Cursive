import core::Reporting
import spec::Obligations

public enum CoverageState {
    Uncovered
    ParsedOnly
    Modeled
    ReferenceCovered
    Generated
    ExecutedPass
    ExecutedFail
    BlockedByCurrentCompiler
    BlockedByOracleLanguageSupport
    UnsupportedByReference
    OutsideConformance
    InformativeOnly
}

public record CoverageRecord {
    public obligation_id: bytes@View
    public source_start: i32
    public source_end: i32
    public source_line: i32
    public source_column: i32
    public content_identity: i32
    public obligation_kind: Obligations::ObligationKind
    public obligation_strength: Obligations::ObligationStrength
    public coverage_state: CoverageState
    public blocker_kind: Obligations::ObligationBlockerKind
    public blocker_reason: string@View
    public evidence_path: string@View
    public comparison_id: string@View
}

public record CoverageLedger {
    public ledger_id: string@View
    public source_spec_path: string@View
    public source_unit_ledger_path: string@View
    public report_path: string@View
    public total_obligation_count: i32
    public required_obligation_count: i32
    public uncovered_count: i32
    public parsed_only_count: i32
    public modeled_count: i32
    public reference_covered_count: i32
    public generated_count: i32
    public executed_pass_count: i32
    public executed_fail_count: i32
    public blocked_by_current_compiler_count: i32
    public blocked_by_oracle_language_support_count: i32
    public unsupported_by_reference_count: i32
    public outside_conformance_count: i32
    public informative_only_count: i32
    public source_unit_ledger_read_failure_count: i32
    public malformed_source_unit_record_count: i32
    public has_top_uncovered_obligation: bool
    public top_uncovered_obligation: CoverageRecord
    public has_top_current_compiler_blocker: bool
    public top_current_compiler_blocker: CoverageRecord
    public has_top_oracle_language_blocker: bool
    public top_oracle_language_blocker: CoverageRecord
    public status: i32
}

public record CoverageRunResult {
    public ctx: Reporting::OutputContext
    public status: i32
    public ledger: CoverageLedger
}

public procedure renderCoverageState(value: CoverageState) -> string@View {
    return if value is {
        CoverageState::Uncovered { "uncovered" }
        CoverageState::ParsedOnly { "parsed_only" }
        CoverageState::Modeled { "modeled" }
        CoverageState::ReferenceCovered { "reference_covered" }
        CoverageState::Generated { "generated" }
        CoverageState::ExecutedPass { "executed_pass" }
        CoverageState::ExecutedFail { "executed_fail" }
        CoverageState::BlockedByCurrentCompiler { "blocked_by_current_compiler" }
        CoverageState::BlockedByOracleLanguageSupport {
            "blocked_by_oracle_language_support"
        }
        CoverageState::UnsupportedByReference { "unsupported_by_reference" }
        CoverageState::OutsideConformance { "outside_conformance" }
        CoverageState::InformativeOnly { "informative_only" }
    }
}

public procedure coverageStateStatus(value: CoverageState) -> Reporting::ReportStatus {
    return if value is {
        CoverageState::Uncovered { Reporting::ReportStatus::Uncovered }
        CoverageState::ParsedOnly { Reporting::ReportStatus::ParsedOnly }
        CoverageState::Modeled { Reporting::ReportStatus::Modeled }
        CoverageState::ReferenceCovered { Reporting::ReportStatus::ReferenceCovered }
        CoverageState::Generated { Reporting::ReportStatus::Generated }
        CoverageState::ExecutedPass { Reporting::ReportStatus::ExecutedPass }
        CoverageState::ExecutedFail { Reporting::ReportStatus::ExecutedFail }
        CoverageState::BlockedByCurrentCompiler {
            Reporting::ReportStatus::BlockedByCurrentCompiler
        }
        CoverageState::BlockedByOracleLanguageSupport {
            Reporting::ReportStatus::BlockedByOracleLanguageSupport
        }
        CoverageState::UnsupportedByReference {
            Reporting::ReportStatus::UnsupportedByReference
        }
        CoverageState::OutsideConformance { Reporting::ReportStatus::OutsideConformance }
        CoverageState::InformativeOnly { Reporting::ReportStatus::InformativeOnly }
    }
}

public procedure coverageLedgerStatus(value: CoverageLedger) -> Reporting::ReportStatus {
    if (value.status == 0) {
        return Reporting::ReportStatus::ExecutedPass
    }
    return Reporting::ReportStatus::Uncovered
}

public procedure coverageRunResult(
    ctx: Reporting::OutputContext,
    status: i32,
    ledger: CoverageLedger
) -> CoverageRunResult {
    return CoverageRunResult {
        ctx: ctx,
        status: status,
        ledger: ledger
    }
}

procedure nonNegative(value: i32) -> i32 {
    if (value < 0) {
        return 0
    }
    return value
}

procedure emptyCoverageRecord() -> CoverageRecord {
    return CoverageRecord {
        obligation_id: bytes::view_string(""),
        source_start: 0,
        source_end: 0,
        source_line: 1,
        source_column: 1,
        content_identity: 0,
        obligation_kind: Obligations::ObligationKind::OutsideConformanceUnit,
        obligation_strength: Obligations::ObligationStrength::Informative,
        coverage_state: CoverageState::Uncovered,
        blocker_kind: Obligations::ObligationBlockerKind::NoBlocker,
        blocker_reason: "-",
        evidence_path: "-",
        comparison_id: "-"
    }
}

procedure coverageRecordFromObligation(
    obligation: Obligations::ObligationRecord,
    state: CoverageState,
    blocker: Obligations::ObligationBlockerKind,
    blocker_reason: string@View
) -> CoverageRecord {
    return CoverageRecord {
        obligation_id: obligation.source_unit_id,
        source_start: obligation.source_start,
        source_end: obligation.source_end,
        source_line: obligation.source_line,
        source_column: obligation.source_column,
        content_identity: obligation.content_identity,
        obligation_kind: obligation.kind,
        obligation_strength: obligation.strength,
        coverage_state: state,
        blocker_kind: blocker,
        blocker_reason: blocker_reason,
        evidence_path: "HelloCursive/Cases/ConformanceModel/Definitions/DefConforming/Positive/Primary",
        comparison_id: "comparison.case.conformance_model.definitions.def_conforming.positive.primary"
    }
}

procedure coverageRecordFromSpecObligation(
    obligation: Obligations::SpecObligation,
    state: CoverageState,
    blocker: Obligations::ObligationBlockerKind,
    blocker_reason: string@View
) -> CoverageRecord {
    return CoverageRecord {
        obligation_id: bytes::view_string(obligation.obligation_id),
        source_start: obligation.source.source_start,
        source_end: obligation.source.source_end,
        source_line: obligation.source.source_line,
        source_column: obligation.source.source_column,
        content_identity: obligation.source.content_identity,
        obligation_kind: obligation.kind,
        obligation_strength: obligation.strength,
        coverage_state: state,
        blocker_kind: blocker,
        blocker_reason: blocker_reason,
        evidence_path: "HelloCursive/Cases/ConformanceModel/Definitions/DefConforming/Positive/Primary",
        comparison_id: "comparison.case.conformance_model.definitions.def_conforming.positive.primary"
    }
}

procedure obligationKindIsInformative(value: Obligations::ObligationKind) -> bool {
    return if value is {
        Obligations::ObligationKind::InformativeUnit { true }
        _ { false }
    }
}

procedure obligationKindIsOutsideConformance(value: Obligations::ObligationKind) -> bool {
    return if value is {
        Obligations::ObligationKind::OutsideConformanceUnit { true }
        _ { false }
    }
}

procedure obligationStrengthIsInformative(value: Obligations::ObligationStrength) -> bool {
    return if value is {
        Obligations::ObligationStrength::Informative { true }
        _ { false }
    }
}

procedure obligationStrengthIsRequired(value: Obligations::ObligationStrength) -> bool {
    return if value is {
        Obligations::ObligationStrength::Required { true }
        _ { false }
    }
}

procedure obligationStateIsInformativeOnly(value: Obligations::ObligationState) -> bool {
    return if value is {
        Obligations::ObligationState::InformativeOnly { true }
        _ { false }
    }
}

procedure obligationStateIsOutsideConformance(value: Obligations::ObligationState) -> bool {
    return if value is {
        Obligations::ObligationState::OutsideConformance { true }
        _ { false }
    }
}

procedure obligationRecordIsInformativeOnly(value: Obligations::ObligationRecord) -> bool {
    return obligationStateIsInformativeOnly(value.state) ||
        obligationKindIsInformative(value.kind) ||
        obligationStrengthIsInformative(value.strength)
}

procedure obligationRecordIsOutsideConformance(value: Obligations::ObligationRecord) -> bool {
    return obligationStateIsOutsideConformance(value.state) ||
        obligationKindIsOutsideConformance(value.kind)
}

procedure boolCount(value: bool) -> i32 {
    if (value == true) {
        return 1
    }
    return 0
}

procedure coverageLedgerFinalStatus(
    required_count: i32,
    executed_pass_count: i32,
    read_failure_count: i32,
    malformed_count: i32
) -> i32 {
    if ((read_failure_count != 0) || (malformed_count != 0)) {
        return 75
    }
    if (required_count == executed_pass_count) {
        return 0
    }
    return 1
}

procedure coverageLedgerFromCounts(
    source_unit_ledger_path: string@View,
    total_count: i32,
    required_count: i32,
    parsed_only_count: i32,
    executed_pass_count: i32,
    executed_fail_count: i32,
    outside_conformance_count: i32,
    informative_only_count: i32,
    read_failure_count: i32,
    malformed_count: i32,
    has_top_uncovered_obligation: bool,
    top_uncovered_obligation: CoverageRecord
) -> CoverageLedger {
    let empty_record: CoverageRecord = emptyCoverageRecord()
    let uncovered_count: i32 = nonNegative(required_count - executed_pass_count)
    return CoverageLedger {
        ledger_id: "coverage.ledger.main",
        source_spec_path: "docs/CursiveSpecification.md",
        source_unit_ledger_path: source_unit_ledger_path,
        report_path: "HelloCursive/Oracle/Reports/coverage-ledger.txt",
        total_obligation_count: total_count,
        required_obligation_count: required_count,
        uncovered_count: uncovered_count,
        parsed_only_count: parsed_only_count,
        modeled_count: 0,
        reference_covered_count: 0,
        generated_count: 0,
        executed_pass_count: executed_pass_count,
        executed_fail_count: executed_fail_count,
        blocked_by_current_compiler_count: 0,
        blocked_by_oracle_language_support_count: 0,
        unsupported_by_reference_count: 0,
        outside_conformance_count: outside_conformance_count,
        informative_only_count: informative_only_count,
        source_unit_ledger_read_failure_count: read_failure_count,
        malformed_source_unit_record_count: malformed_count,
        has_top_uncovered_obligation: has_top_uncovered_obligation,
        top_uncovered_obligation: top_uncovered_obligation,
        has_top_current_compiler_blocker: false,
        top_current_compiler_blocker: empty_record,
        has_top_oracle_language_blocker: false,
        top_oracle_language_blocker: empty_record,
        status: coverageLedgerFinalStatus(
            required_count,
            executed_pass_count,
            read_failure_count,
            malformed_count
        )
    }
}

public procedure coverageLedgerForReadFailure(source_unit_ledger_path: string@View) -> CoverageLedger {
    return coverageLedgerFromCounts(
        source_unit_ledger_path,
        0,
        0,
        0,
        0,
        0,
        0,
        0,
        1,
        0,
        false,
        emptyCoverageRecord()
    )
}

public procedure coverageLedgerForSummary(ledger: CoverageLedger) -> CoverageLedger {
    return coverageLedgerFromCounts(
        ledger.source_unit_ledger_path,
        ledger.total_obligation_count,
        ledger.required_obligation_count,
        ledger.parsed_only_count,
        ledger.executed_pass_count,
        ledger.executed_fail_count,
        ledger.outside_conformance_count,
        ledger.informative_only_count,
        ledger.source_unit_ledger_read_failure_count,
        ledger.malformed_source_unit_record_count,
        false,
        emptyCoverageRecord()
    )
}

procedure classifiedCoverageState(obligation: Obligations::ObligationRecord) -> CoverageState {
    if (obligationRecordIsInformativeOnly(obligation) == true) {
        return CoverageState::InformativeOnly
    }
    if (obligationRecordIsOutsideConformance(obligation) == true) {
        return CoverageState::OutsideConformance
    }
    return CoverageState::ParsedOnly
}

procedure coverageBlockerKindForState(state: CoverageState) -> Obligations::ObligationBlockerKind {
    return if state is {
        CoverageState::OutsideConformance {
            Obligations::ObligationBlockerKind::OutsideConformance
        }
        CoverageState::InformativeOnly { Obligations::ObligationBlockerKind::InformativeOnly }
        _ { Obligations::ObligationBlockerKind::NoBlocker }
    }
}

procedure coverageBlockerReasonForState(state: CoverageState) -> string@View {
    return if state is {
        CoverageState::OutsideConformance { "outside_conformance" }
        CoverageState::InformativeOnly { "informative_only" }
        CoverageState::ParsedOnly { "hand_case_not_yet_mapped_to_required_obligation" }
        CoverageState::ExecutedPass { "-" }
        CoverageState::ExecutedFail { "comparison_failed" }
        CoverageState::Uncovered { "required_obligation_without_passing_hand_case" }
        _ { "coverage_state_not_executable" }
    }
}

public procedure buildCoverageLedger(
    obligations: Obligations::ObligationSummary
) -> CoverageLedger {
    let total_count: i32 = obligations.counts.total_count
    let required_count: i32 = obligations.counts.required_count
    let parsed_only_count: i32 = obligations.counts.parsed_count
    let executed_pass_count: i32 = 0
    let executed_fail_count: i32 = 0
    let outside_conformance_count: i32 = obligations.counts.outside_conformance_count
    let informative_only_count: i32 = obligations.counts.informative_count
    let read_failure_count: i32 = obligations.ledger.storage_failure_count
    let malformed_count: i32 = obligations.ledger.malformed_record_count
    let has_top_uncovered_obligation: bool =
        (required_count > executed_pass_count) &&
        (Obligations::obligationIsRequired(obligations.primary_obligation) == true)
    let top_uncovered_obligation: CoverageRecord = if has_top_uncovered_obligation == true {
        coverageRecordFromSpecObligation(
            obligations.primary_obligation,
            CoverageState::ParsedOnly,
            Obligations::ObligationBlockerKind::NoBlocker,
            "required_obligation_without_passing_hand_case"
        )
    } else {
        emptyCoverageRecord()
    }

    return coverageLedgerFromCounts(
        obligations.ledger.path,
        total_count,
        required_count,
        parsed_only_count,
        executed_pass_count,
        executed_fail_count,
        outside_conformance_count,
        informative_only_count,
        read_failure_count,
        malformed_count,
        has_top_uncovered_obligation,
        top_uncovered_obligation
    )
}
