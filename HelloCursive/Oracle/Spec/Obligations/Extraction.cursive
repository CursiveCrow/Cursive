import core::Reporting
import spec::Source

internal record ObligationExtractionBuild {
    internal output: Reporting::OutputContext
    internal counts: ObligationCounts
    internal ledger: ObligationSourceLedgerSummary
    internal primary_obligation: SpecObligation
}

procedure primaryObligationFromSource(
    path: string@View,
    source: Source::SpecIngestionResult
) -> SpecObligation {
    if (source.unit_count == 0) {
        return absentSpecObligation(path)
    }
    return specObligation(
        "obligation.primary_bridge",
        obligationKindFromSpecUnitKind(source.primary_kind),
        obligationStrengthFromSpecUnitStrength(source.primary_strength),
        ObligationState::Parsed,
        ObligationBlockerKind::NoBlocker,
        "Spec::Obligations",
        obligationSource(
            path,
            "spec_unit.primary_bridge",
            "section.primary_bridge",
            "-",
            source.primary_unit_start,
            source.primary_unit_end,
            source.primary_unit_line,
            source.primary_unit_column,
            source.primary_unit_identity
        )
    )
}

procedure nonNegativeCount(value: i32) -> i32 {
    if (value < 0) {
        return 0
    }
    return value
}

procedure obligationCountsFromSource(source: Source::SpecIngestionResult) -> ObligationCounts {
    let required_count: i32 = source.required_count + source.normative_strength_count
    let recommended_count: i32 = source.recommended_count + source.advisory_count
    let permitted_count: i32 = source.permitted_count +
        source.allowed_count +
        source.optional_count
    let informative_count: i32 = source.informative_strength_count +
        source.unknown_strength_count
    let outside_conformance_count: i32 = source.unknown_kind_count
    let formal_rule_count: i32 = source.formal_rule_count +
        source.formal_definition_count +
        source.lowering_rule_count
    let grammar_production_count: i32 = source.grammar_count +
        source.grammar_requirement_count
    let diagnostic_table_row_count: i32 = source.diagnostic_table_count +
        source.diagnostic_requirement_count +
        source.diagnostics_count
    let normative_sentence_count: i32 = source.semantic_requirement_count +
        source.syntax_requirement_count +
        source.dynamic_semantics_count +
        source.normative_requirement_count +
        source.lowering_requirement_count
    let conformance_statement_count: i32 = source.conformance_statement_count +
        source.metatheoretic_property_count
    let blocked_count: i32 = source.marker_parse_error_count +
        outside_conformance_count +
        informative_count
    return obligationCounts(
        source.unit_count,
        required_count,
        recommended_count,
        permitted_count,
        informative_count,
        outside_conformance_count,
        formal_rule_count,
        grammar_production_count,
        diagnostic_table_row_count,
        normative_sentence_count,
        conformance_statement_count,
        nonNegativeCount(source.unit_count - blocked_count),
        0,
        blocked_count
    )
}

procedure obligationKindFromSpecUnitKind(kind: Source::SpecUnitKind) -> ObligationKind {
    return if kind is {
        Source::SpecUnitKind::Grammar { ObligationKind::GrammarProduction }
        Source::SpecUnitKind::GrammarRequirement { ObligationKind::GrammarProduction }
        Source::SpecUnitKind::FormalRule { ObligationKind::FormalRule }
        Source::SpecUnitKind::FormalDefinition { ObligationKind::FormalRule }
        Source::SpecUnitKind::LoweringRule { ObligationKind::FormalRule }
        Source::SpecUnitKind::DiagnosticTable { ObligationKind::DiagnosticTableRow }
        Source::SpecUnitKind::DiagnosticRequirement { ObligationKind::DiagnosticTableRow }
        Source::SpecUnitKind::Diagnostics { ObligationKind::DiagnosticTableRow }
        Source::SpecUnitKind::SemanticRequirement { ObligationKind::NormativeSentence }
        Source::SpecUnitKind::SyntaxRequirement { ObligationKind::NormativeSentence }
        Source::SpecUnitKind::DynamicSemantics { ObligationKind::NormativeSentence }
        Source::SpecUnitKind::NormativeRequirement { ObligationKind::NormativeSentence }
        Source::SpecUnitKind::LoweringRequirement { ObligationKind::NormativeSentence }
        Source::SpecUnitKind::ConformanceStatement { ObligationKind::ConformanceStatement }
        Source::SpecUnitKind::MetatheoreticProperty { ObligationKind::ConformanceStatement }
        Source::SpecUnitKind::Informative { ObligationKind::InformativeUnit }
        Source::SpecUnitKind::InformativeNote { ObligationKind::InformativeUnit }
        Source::SpecUnitKind::Unknown { ObligationKind::OutsideConformanceUnit }
    }
}

procedure obligationStrengthFromSpecUnitStrength(
    strength: Source::SpecUnitStrength
) -> ObligationStrength {
    return if strength is {
        Source::SpecUnitStrength::Required { ObligationStrength::Required }
        Source::SpecUnitStrength::Normative { ObligationStrength::Required }
        Source::SpecUnitStrength::Recommended { ObligationStrength::Recommended }
        Source::SpecUnitStrength::Advisory { ObligationStrength::Recommended }
        Source::SpecUnitStrength::Permitted { ObligationStrength::Permitted }
        Source::SpecUnitStrength::Allowed { ObligationStrength::Permitted }
        Source::SpecUnitStrength::Optional { ObligationStrength::Permitted }
        Source::SpecUnitStrength::Informative { ObligationStrength::Informative }
        Source::SpecUnitStrength::Unknown { ObligationStrength::Informative }
    }
}

procedure emitObligationMetric(
    ctx: Reporting::OutputContext,
    subject_id: string@View,
    metric_kind: Reporting::ReportMetricKind,
    value: i32,
    message: string@View
) -> Reporting::OutputContext {
    return Reporting::emitEvent(
        ctx,
        Reporting::metricIntegerEvent(
            Reporting::ReportPhase::ObligationExtraction,
            Reporting::ReportSubjectKind::Obligation,
            subject_id,
            "Spec::Obligations",
            Reporting::ReportStatus::Parsed,
            metric_kind,
            value,
            message
        )
    )
}

procedure emitObligationCheckpoint(
    ctx: Reporting::OutputContext,
    subject_id: string@View
) -> Reporting::OutputContext {
    return Reporting::emitCheckpoint(
        ctx,
        Reporting::ReportPhase::ObligationExtraction,
        Reporting::ReportSubjectKind::Obligation,
        subject_id,
        "Spec::Obligations"
    )
}

procedure obligationStateFromSourceUnit(unit: Source::SpecUnitRecord) -> ObligationState {
    if (unit.parse_defect_count != 0) {
        return ObligationState::BlockedBySpecParse
    }
    if (obligationKindIsOutsideConformance(obligationKindFromSpecUnitKind(unit.kind)) == true) {
        return ObligationState::OutsideConformance
    }
    return if obligationStrengthFromSpecUnitStrength(unit.strength) is {
        ObligationStrength::Informative { ObligationState::InformativeOnly }
        _ { ObligationState::Parsed }
    }
}

procedure obligationBlockerFromSourceUnit(unit: Source::SpecUnitRecord) -> ObligationBlockerKind {
    if (unit.parse_defect_count != 0) {
        return ObligationBlockerKind::SpecParseError
    }
    if (obligationKindIsOutsideConformance(obligationKindFromSpecUnitKind(unit.kind)) == true) {
        return ObligationBlockerKind::OutsideConformance
    }
    return if obligationStrengthFromSpecUnitStrength(unit.strength) is {
        ObligationStrength::Informative { ObligationBlockerKind::InformativeOnly }
        _ { ObligationBlockerKind::NoBlocker }
    }
}

public procedure obligationRecordFromSourceUnit(unit: Source::SpecUnitRecord) -> ObligationRecord {
    return ObligationRecord {
        ordinal: unit.ordinal,
        source_start: unit.source_start,
        source_end: unit.source_end,
        source_line: unit.source_line,
        source_column: unit.source_column,
        content_identity: unit.content_identity,
        kind: obligationKindFromSpecUnitKind(unit.kind),
        strength: obligationStrengthFromSpecUnitStrength(unit.strength),
        state: obligationStateFromSourceUnit(unit),
        blocker: obligationBlockerFromSourceUnit(unit),
        parse_defect_count: unit.parse_defect_count,
        source_unit_id: unit.id_text,
        owner: unit.owner_text,
        phase: unit.phase_text,
        applies_to: unit.applies_to_text,
        summary: unit.summary_text,
        labels: unit.labels_text
    }
}

procedure obligationStrengthIsRequired(value: ObligationStrength) -> bool {
    return if value is {
        ObligationStrength::Required { true }
        _ { false }
    }
}

procedure obligationStrengthIsRecommended(value: ObligationStrength) -> bool {
    return if value is {
        ObligationStrength::Recommended { true }
        _ { false }
    }
}

procedure obligationStrengthIsPermitted(value: ObligationStrength) -> bool {
    return if value is {
        ObligationStrength::Permitted { true }
        _ { false }
    }
}

procedure obligationStrengthIsInformative(value: ObligationStrength) -> bool {
    return if value is {
        ObligationStrength::Informative { true }
        _ { false }
    }
}

procedure obligationKindIsOutsideConformance(value: ObligationKind) -> bool {
    return if value is {
        ObligationKind::OutsideConformanceUnit { true }
        _ { false }
    }
}

procedure obligationKindIsFormalRule(value: ObligationKind) -> bool {
    return if value is {
        ObligationKind::FormalRule { true }
        _ { false }
    }
}

procedure obligationKindIsGrammarProduction(value: ObligationKind) -> bool {
    return if value is {
        ObligationKind::GrammarProduction { true }
        _ { false }
    }
}

procedure obligationKindIsDiagnosticTableRow(value: ObligationKind) -> bool {
    return if value is {
        ObligationKind::DiagnosticTableRow { true }
        _ { false }
    }
}

procedure obligationKindIsNormativeSentence(value: ObligationKind) -> bool {
    return if value is {
        ObligationKind::NormativeSentence { true }
        _ { false }
    }
}

procedure obligationKindIsConformanceStatement(value: ObligationKind) -> bool {
    return if value is {
        ObligationKind::ConformanceStatement { true }
        _ { false }
    }
}

procedure obligationStateIsParsed(value: ObligationState) -> bool {
    return if value is {
        ObligationState::Parsed { true }
        _ { false }
    }
}

procedure obligationStateIsClassified(value: ObligationState) -> bool {
    return if value is {
        ObligationState::Classified { true }
        _ { false }
    }
}

procedure boolCount(value: bool) -> i32 {
    if (value == true) {
        return 1
    }
    return 0
}

procedure obligationBlockerKindIsBlocking(value: ObligationBlockerKind) -> bool {
    return if value is {
        ObligationBlockerKind::NoBlocker { false }
        _ { true }
    }
}

procedure countWithObligationRecord(
    counts: ObligationCounts,
    obligation_record: ObligationRecord
) -> ObligationCounts {
    return obligationCounts(
        counts.total_count + 1,
        counts.required_count + boolCount(obligationStrengthIsRequired(obligation_record.strength)),
        counts.recommended_count + boolCount(
            obligationStrengthIsRecommended(obligation_record.strength)
        ),
        counts.permitted_count + boolCount(
            obligationStrengthIsPermitted(obligation_record.strength)
        ),
        counts.informative_count + boolCount(
            obligationStrengthIsInformative(obligation_record.strength)
        ),
        counts.outside_conformance_count + boolCount(
            obligationKindIsOutsideConformance(obligation_record.kind)
        ),
        counts.formal_rule_count + boolCount(obligationKindIsFormalRule(obligation_record.kind)),
        counts.grammar_production_count + boolCount(
            obligationKindIsGrammarProduction(obligation_record.kind)
        ),
        counts.diagnostic_table_row_count + boolCount(
            obligationKindIsDiagnosticTableRow(obligation_record.kind)
        ),
        counts.normative_sentence_count + boolCount(
            obligationKindIsNormativeSentence(obligation_record.kind)
        ),
        counts.conformance_statement_count + boolCount(
            obligationKindIsConformanceStatement(obligation_record.kind)
        ),
        counts.parsed_count + boolCount(obligationStateIsParsed(obligation_record.state)),
        counts.classified_count + boolCount(obligationStateIsClassified(obligation_record.state)),
        counts.blocked_count + boolCount(obligationBlockerKindIsBlocking(obligation_record.blocker))
    )
}

procedure emitPrimaryObligation(
    ctx: Reporting::OutputContext,
    obligation: SpecObligation
) -> Reporting::OutputContext {
    let event: Reporting::OutputEvent = Reporting::eventWithSourceContext(
        Reporting::eventWithEvidence(
            Reporting::eventWithExpectedObserved(
                Reporting::eventBase(
                    Reporting::ReportEventKind::Evidence,
                    Reporting::ReportSeverity::Info,
                    Reporting::ReportPhase::ObligationExtraction,
                    Reporting::ReportSubjectKind::Obligation,
                    obligation.obligation_id,
                    "Spec::Obligations",
                    Reporting::ReportStatus::Parsed,
                    "obligation_extracted"
                ),
                obligation.source.spec_unit_id,
                renderObligationStrength(obligation.strength)
            ),
            Reporting::ReportEvidenceKind::ObligationId,
            obligation.obligation_id
        ),
        obligation.source.source_start,
        obligation.source.source_end,
        obligation.source.source_line,
        obligation.source.source_column,
        obligation.source.content_identity
    )
    return Reporting::emitEvent(ctx, event)
}

procedure finishObligationExtractionBuild(
    output: Reporting::OutputContext,
    source_unit_ledger_path: string@View,
    counts: ObligationCounts,
    record_count: i32,
    storage_failure_count: i32,
    malformed_count: i32,
    primary_obligation: SpecObligation
) -> ObligationExtractionBuild {
    return ObligationExtractionBuild {
        output: output,
        counts: counts,
        ledger: obligationSourceLedgerSummary(
            source_unit_ledger_path,
            record_count,
            storage_failure_count,
            malformed_count
        ),
        primary_obligation: primary_obligation
    }
}

procedure emitObligationSource(
    ctx: Reporting::OutputContext,
    path: string@View,
    source: Source::SpecIngestionResult
) -> ObligationSummary {
    let primary_obligation: SpecObligation = primaryObligationFromSource(path, source)
    let extracted: ObligationExtractionBuild = finishObligationExtractionBuild(
        emitObligationCheckpoint(ctx, "obligation_source_ledger_classified"),
        source.unit_ledger_path,
        obligationCountsFromSource(source),
        source.unit_ledger_record_count,
        source.unit_ledger_storage_failure_count,
        source.marker_parse_error_count,
        primary_obligation
    )
    var output: Reporting::OutputContext = emitObligationMetric(
        extracted.output,
        "kind.formal_rule",
        Reporting::ReportMetricKind::ObligationCount,
        extracted.counts.formal_rule_count,
        "obligation_count_by_kind"
    )
    output = emitObligationMetric(
        output,
        "kind.grammar",
        Reporting::ReportMetricKind::ObligationCount,
        extracted.counts.grammar_production_count,
        "obligation_count_by_kind"
    )
    output = emitObligationMetric(
        output,
        "kind.diagnostic",
        Reporting::ReportMetricKind::ObligationCount,
        extracted.counts.diagnostic_table_row_count,
        "obligation_count_by_kind"
    )
    output = emitObligationMetric(
        output,
        "kind.normative",
        Reporting::ReportMetricKind::ObligationCount,
        extracted.counts.normative_sentence_count,
        "obligation_count_by_kind"
    )
    output = emitObligationMetric(
        output,
        "kind.conformance",
        Reporting::ReportMetricKind::ObligationCount,
        extracted.counts.conformance_statement_count,
        "obligation_count_by_kind"
    )
    output = emitObligationMetric(
        output,
        "strength.required",
        Reporting::ReportMetricKind::RequiredObligationCount,
        extracted.counts.required_count,
        "obligation_count_by_strength"
    )
    output = emitObligationMetric(
        output,
        "strength.recommended",
        Reporting::ReportMetricKind::ObligationCount,
        extracted.counts.recommended_count,
        "obligation_count_by_strength"
    )
    output = emitObligationMetric(
        output,
        "strength.permitted",
        Reporting::ReportMetricKind::InformativeObligationCount,
        extracted.counts.permitted_count,
        "obligation_count_by_strength"
    )
    output = emitObligationMetric(
        output,
        "status.parsed",
        Reporting::ReportMetricKind::TotalObligationCount,
        extracted.counts.total_count,
        "obligation_count_by_status"
    )
    output = emitObligationMetric(
        output,
        primary_obligation.source.section_path,
        Reporting::ReportMetricKind::ObligationCount,
        extracted.counts.total_count,
        "obligation_count_by_section"
    )
    output = emitPrimaryObligation(output, primary_obligation)
    return obligationSummary(
        output,
        if ((extracted.ledger.storage_failure_count != 0) ||
            (extracted.ledger.malformed_record_count != 0)) {
            75
        } else {
            0
        },
        extracted.counts,
        extracted.ledger,
        primary_obligation
    )
}

public procedure runObligationExtraction(
    ctx: Reporting::OutputContext,
    source: Source::SpecIngestionResult
) -> ObligationSummary {
    let path: string@View = Source::canonicalSpecPath()
    var output: Reporting::OutputContext = Reporting::emitPhaseBegin(
        ctx,
        Reporting::ReportPhase::ObligationExtraction,
        "obligation_extraction",
        "Spec::Obligations"
    )
    output = emitObligationCheckpoint(output, "obligation_source_ledger_ready")
    let summary: ObligationSummary = emitObligationSource(output, path, source)
    output = Reporting::emitPhaseEnd(
        summary.ctx,
        Reporting::ReportPhase::ObligationExtraction,
        "obligation_extraction",
        "Spec::Obligations",
        Reporting::ReportStatus::Parsed
    )
    return obligationSummary(
        output,
        summary.status,
        summary.counts,
        summary.ledger,
        summary.primary_obligation
    )
}
