procedure failureOutputRegressionEvent(
    phase: ReportPhase,
    subject_kind: ReportSubjectKind,
    subject_id: string@View,
    owner: string@View,
    status: ReportStatus,
    failure_kind: ReportFailureKind,
    evidence_kind: ReportEvidenceKind,
    expected: string@View,
    observed: string@View,
    evidence_path: string@View,
    has_source: bool,
    source_start: i32,
    source_end: i32,
    source_line: i32,
    source_column: i32,
    content_identity: i32,
    metric_kind: ReportMetricKind,
    metric_value: ReportTextValue,
    message: string@View
) -> OutputEvent {
    return outputRegressionEvent(
        ReportEventKind::Failure,
        ReportSeverity::Error,
        phase,
        subject_kind,
        textValue(subject_id),
        textValue(owner),
        status,
        failure_kind,
        evidence_kind,
        textValue(expected),
        textValue(observed),
        textValue(evidence_path),
        has_source,
        source_start,
        source_end,
        source_line,
        source_column,
        content_identity,
        metric_kind,
        metric_value,
        textValue(message)
    )
}

public procedure oracleInternalFailureEvent() -> OutputEvent {
    return failureOutputRegressionEvent(
        ReportPhase::FoundationSelftest,
        ReportSubjectKind::OutputRegression,
        "oracle_internal",
        "Core::Reporting",
        ReportStatus::Failed,
        ReportFailureKind::OracleInternal,
        ReportEvidenceKind::EmittedArtifactPath,
        "passed",
        "failed",
        oracleInternalStderrPath(),
        false,
        0,
        0,
        1,
        1,
        0,
        ReportMetricKind::Absent,
        omittedText(),
        "synthetic_oracle_internal_failure"
    )
}

