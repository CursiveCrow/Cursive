        valueSpanEquals(line, start_index, end_index, "final_exit_status")
}

public procedure validateEventLineShape(line: string@View) -> bool {
    if (textStartsWithAt(line, "protocol=cursive-oracle-event-v1 ", 0) == false) {
        return false
    }
    let run_scope: i32 = textFindFrom(line, "run_scope=", 0)
    let event_index: i32 = textFindFrom(line, " event_index=", 0)
    let event_kind: i32 = textFindFrom(line, " event_kind=", 0)
    let severity: i32 = textFindFrom(line, " severity=", 0)
    let phase: i32 = textFindFrom(line, " phase=", 0)
    let subject_kind: i32 = textFindFrom(line, " subject_kind=", 0)
    let subject_id: i32 = textFindFrom(line, " subject_id=", 0)
    let owner: i32 = textFindFrom(line, " owner=", 0)
    let status: i32 = textFindFrom(line, " status=", 0)
    let failure_kind: i32 = textFindFrom(line, " failure_kind=", 0)
    let evidence_kind: i32 = textFindFrom(line, " evidence_kind=", 0)
    let expected: i32 = textFindFrom(line, " expected=", 0)
    let observed: i32 = textFindFrom(line, " observed=", 0)
    let evidence_path: i32 = textFindFrom(line, " evidence_path=", 0)
    let source_start: i32 = textFindFrom(line, " source_start=", 0)
    let source_end: i32 = textFindFrom(line, " source_end=", 0)
    let source_line: i32 = textFindFrom(line, " source_line=", 0)
    let source_column: i32 = textFindFrom(line, " source_column=", 0)
    let content_identity: i32 = textFindFrom(line, " content_identity=", 0)
    let metric_kind: i32 = textFindFrom(line, " metric_kind=", 0)
    let metric_value: i32 = textFindFrom(line, " metric_value=", 0)
    let message: i32 = textFindFrom(line, " message=", 0)
    let payload_end: i32 = linePayloadEnd(line)
    if ((run_scope < 0) || (event_index <= run_scope) || (event_kind <= event_index)) {
        return false
    }
    if ((severity <= event_kind) || (phase <= severity) || (subject_kind <= phase)) {
        return false
    }
    if ((subject_id <= subject_kind) || (owner <= subject_id) || (status <= owner)) {
        return false
    }
    if ((failure_kind <= status) || (evidence_kind <= failure_kind) || (expected <= evidence_kind)) {
        return false
    }
    if ((observed <= expected) || (evidence_path <= observed) || (source_start <= evidence_path)) {
        return false
    }
    if ((source_end <= source_start) || (source_line <= source_end)) {
        return false
    }
    if ((source_column <= source_line) || (content_identity <= source_column)) {
        return false
    }
    if ((metric_kind <= content_identity) || (metric_value <= metric_kind) || (message <= metric_value)) {
        return false
    }
    if (validateEventKindSpan(line, event_kind + 12, severity) == false) {
        return false
    }
    if (validateSeveritySpan(line, severity + 10, phase) == false) {
        return false
    }
    if (validatePhaseSpan(line, phase + 7, subject_kind) == false) {
        return false
    }
    if (validateSubjectKindSpan(line, subject_kind + 14, subject_id) == false) {
        return false
    }
    if (validateStatusSpan(line, status + 8, failure_kind) == false) {
        return false
    }
    if (validateFailureKindSpan(line, failure_kind + 14, evidence_kind) == false) {
        return false
    }
    if (validateEvidenceKindSpan(line, evidence_kind + 15, expected) == false) {
        return false
    }
    if (validateMetricKindSpan(line, metric_kind + 13, metric_value) == false) {
        return false
    }
    return validateValueSpan(line, run_scope + 10, event_index) &&
        validateValueSpan(line, subject_id + 12, owner) &&
        validateValueSpan(line, owner + 7, status) &&
        validateValueSpan(line, expected + 10, observed) &&
        validateValueSpan(line, observed + 10, evidence_path) &&
        validateValueSpan(line, evidence_path + 15, source_start) &&
        validateValueSpan(line, source_start + 14, source_end) &&
        validateValueSpan(line, source_end + 12, source_line) &&
        validateValueSpan(line, source_line + 13, source_column) &&
        validateValueSpan(line, source_column + 15, content_identity) &&
        validateValueSpan(line, content_identity + 18, metric_kind) &&
        validateValueSpan(line, metric_value + 14, message) &&
        validateValueSpan(line, message + 9, payload_end)
}

public procedure validateFailureLine(line: string@View, failure_text: string@View) -> bool {
    if (validateEventLineShape(line) == false) {
        return false
    }
    if (textFindFrom(line, " event_kind=failure ", 0) < 0) {
        return false
    }
    if (textFindFrom(line, failure_text, 0) < 0) {
        return false
    }
    return true
}

procedure bytesByteLength(value: bytes@View) -> i32 {
    return bytes::length(value) as i32
}

procedure bytesByteAt(value: bytes@View, index: i32) -> u8 {
    let slice: const [u8] = bytes::as_slice(value)
    return slice[index as usize]
}

procedure bytesStartsWithTextAtFrom(
    value: bytes@View,
    prefix: string@View,
    value_index: i32,
    prefix_index: i32
) -> bool {
    let prefix_length: i32 = textByteLength(prefix)
    if (prefix_index >= prefix_length) {
        return true
    }
    if ((value_index + prefix_index) >= bytesByteLength(value)) {
        return false
    }
    if (bytesByteAt(value, value_index + prefix_index) != textByteAt(prefix, prefix_index)) {
        return false
    }
    return bytesStartsWithTextAtFrom(value, prefix, value_index, prefix_index + 1)
}

procedure bytesStartsWithTextAt(value: bytes@View, prefix: string@View, index: i32) -> bool {
    if (index < 0) {
        return false
    }
    return bytesStartsWithTextAtFrom(value, prefix, index, 0)
}

procedure bytesFindTextFrom(value: bytes@View, needle: string@View, index: i32) -> i32 {
    if (index >= bytesByteLength(value)) {
        return -1
    }
    if (bytesStartsWithTextAt(value, needle, index) == true) {
        return index
    }
    return bytesFindTextFrom(value, needle, index + 1)
}

procedure bytesPayloadEnd(line: bytes@View) -> i32 {
    let length: i32 = bytesByteLength(line)
    if (length == 0) {
        return 0
    }
    if (bytesByteAt(line, length - 1) == 10) {
        return length - 1
    }
    return length
}

procedure validateBytesScalarValueSpanFrom(
    line: bytes@View,
    index: i32,
    end_index: i32
) -> bool {
    if (index >= end_index) {
        return true
    }
    let byte: u8 = bytesByteAt(line, index)
    if (byte == 37) {
        if ((index + 2) >= end_index) {
            return false
        }
        if (isAllowedEscapePair(bytesByteAt(line, index + 1), bytesByteAt(line, index + 2)) == false) {
            return false
        }
        return validateBytesScalarValueSpanFrom(line, index + 3, end_index)
    }
    if (byteIsRawReservedValueByte(byte) == true) {
        return false
    }
    return validateBytesScalarValueSpanFrom(line, index + 1, end_index)
}

procedure validateBytesScalarValueSpan(
    line: bytes@View,
    start_index: i32,
    end_index: i32
) -> bool {
    if (start_index >= end_index) {
        return false
    }
    return validateBytesScalarValueSpanFrom(line, start_index, end_index)
}

procedure findBytesRawListComma(line: bytes@View, index: i32, end_index: i32) -> i32 {
    if (index >= end_index) {
        return -1
    }
    let byte: u8 = bytesByteAt(line, index)
    if (byte == 37) {
        return findBytesRawListComma(line, index + 3, end_index)
    }
    if (byte == 44) {
        return index
    }
    return findBytesRawListComma(line, index + 1, end_index)
}

procedure validateBytesListValueSpan(
    line: bytes@View,
    start_index: i32,
    end_index: i32
) -> bool {
    if ((end_index - start_index) < 2) {
        return false
    }
    if (bytesByteAt(line, start_index) != 91) {
        return false
    }
    if (bytesByteAt(line, end_index - 1) != 93) {
        return false
    }
    if ((end_index - start_index) == 2) {
        return true
    }
    let inner_start: i32 = start_index + 1
    let inner_end: i32 = end_index - 1
    let comma_index: i32 = findBytesRawListComma(line, inner_start, inner_end)
    if (comma_index < 0) {
        return validateBytesScalarValueSpan(line, inner_start, inner_end)
    }
    if ((comma_index == inner_start) || ((comma_index + 1) >= inner_end)) {
        return false
    }
    if (findBytesRawListComma(line, comma_index + 1, inner_end) >= 0) {
        return false
    }
    return validateBytesScalarValueSpan(line, inner_start, comma_index) &&
        validateBytesScalarValueSpan(line, comma_index + 1, inner_end)
}

procedure validateBytesValueSpan(line: bytes@View, start_index: i32, end_index: i32) -> bool {
    if (start_index >= end_index) {
        return false
    }
    if (bytesByteAt(line, start_index) == 91) {
        return validateBytesListValueSpan(line, start_index, end_index)
    }
    return validateBytesScalarValueSpan(line, start_index, end_index)
}

procedure bytesValueSpanEqualsText(
    line: bytes@View,
    start_index: i32,
    end_index: i32,
    value: string@View
) -> bool {
    if ((end_index - start_index) != textByteLength(value)) {
        return false
    }
    return bytesStartsWithTextAt(line, value, start_index)
}

procedure validateBytesEventKindSpan(
    line: bytes@View,
