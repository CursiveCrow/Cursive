procedure linePayloadEnd(line: string@View) -> i32 {
    let length: i32 = textByteLength(line)
    if (length == 0) {
        return 0
    }
    if (textByteAt(line, length - 1) == 10) {
        return length - 1
    }
    return length
}

procedure byteIsRawReservedValueByte(byte: u8) -> bool {
    if (byte == 9) { return true }
    if (byte == 10) { return true }
    if (byte == 13) { return true }
    if (byte == 32) { return true }
    if (byte == 44) { return true }
    if (byte == 61) { return true }
    if (byte == 91) { return true }
    if (byte == 92) { return true }
    if (byte == 93) { return true }
    if (byte == 124) { return true }
    return false
}

procedure byteIsUpperHex(byte: u8) -> bool {
    return ((byte >= 48) && (byte <= 57)) || ((byte >= 65) && (byte <= 70))
}

procedure isAllowedEscapePair(first: u8, second: u8) -> bool {
    return byteIsUpperHex(first) && byteIsUpperHex(second)
}

procedure validateScalarValueSpanFrom(line: string@View, index: i32, end_index: i32) -> bool {
    if (index >= end_index) {
        return true
    }
    let byte: u8 = textByteAt(line, index)
    if (byte == 37) {
        if ((index + 2) >= end_index) {
            return false
        }
        if (isAllowedEscapePair(textByteAt(line, index + 1), textByteAt(line, index + 2)) == false) {
            return false
        }
        return validateScalarValueSpanFrom(line, index + 3, end_index)
    }
    if (byteIsRawReservedValueByte(byte) == true) {
        return false
    }
    return validateScalarValueSpanFrom(line, index + 1, end_index)
}

procedure validateScalarValueSpan(line: string@View, start_index: i32, end_index: i32) -> bool {
    if (start_index >= end_index) {
        return false
    }
    return validateScalarValueSpanFrom(line, start_index, end_index)
}

procedure findRawListComma(line: string@View, index: i32, end_index: i32) -> i32 {
    if (index >= end_index) {
        return -1
    }
    let byte: u8 = textByteAt(line, index)
    if (byte == 37) {
        return findRawListComma(line, index + 3, end_index)
    }
    if (byte == 44) {
        return index
    }
    return findRawListComma(line, index + 1, end_index)
}

procedure validateListValueSpan(line: string@View, start_index: i32, end_index: i32) -> bool {
    if ((end_index - start_index) < 2) {
        return false
    }
    if (textByteAt(line, start_index) != 91) {
        return false
    }
    if (textByteAt(line, end_index - 1) != 93) {
        return false
    }
    if ((end_index - start_index) == 2) {
        return true
    }
    let inner_start: i32 = start_index + 1
    let inner_end: i32 = end_index - 1
    let comma_index: i32 = findRawListComma(line, inner_start, inner_end)
    if (comma_index < 0) {
        return validateScalarValueSpan(line, inner_start, inner_end)
    }
    if ((comma_index == inner_start) || ((comma_index + 1) >= inner_end)) {
        return false
    }
    if (findRawListComma(line, comma_index + 1, inner_end) >= 0) {
        return false
    }
    return validateScalarValueSpan(line, inner_start, comma_index) &&
        validateScalarValueSpan(line, comma_index + 1, inner_end)
}

procedure validateValueSpan(line: string@View, start_index: i32, end_index: i32) -> bool {
    if (start_index >= end_index) {
        return false
    }
    if (textByteAt(line, start_index) == 91) {
        return validateListValueSpan(line, start_index, end_index)
    }
    return validateScalarValueSpan(line, start_index, end_index)
}

procedure valueSpanEquals(
    line: string@View,
    start_index: i32,
    end_index: i32,
    value: string@View
) -> bool {
    if ((end_index - start_index) != textByteLength(value)) {
        return false
    }
    return textStartsWithAt(line, value, start_index)
}

