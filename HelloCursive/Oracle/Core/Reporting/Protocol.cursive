public procedure renderSeverity(value: ReportSeverity) -> string@View {
    return if value is {
        ReportSeverity::Info { "info" }
        ReportSeverity::Warning { "warning" }
        ReportSeverity::Error { "error" }
        ReportSeverity::Fatal { "fatal" }
    }
}

