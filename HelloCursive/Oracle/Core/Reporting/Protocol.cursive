        bytesValueSpanEqualsText(line, start_index, end_index, "obligation_id") ||
        bytesValueSpanEqualsText(line, start_index, end_index, "case_id") ||
        bytesValueSpanEqualsText(line, start_index, end_index, "check_id") ||
        bytesValueSpanEqualsText(line, start_index, end_index, "command_text") ||
        bytesValueSpanEqualsText(line, start_index, end_index, "compiler_status") ||
        bytesValueSpanEqualsText(line, start_index, end_index, "runtime_status") ||
        bytesValueSpanEqualsText(line, start_index, end_index, "diagnostic_json_path") ||
        bytesValueSpanEqualsText(line, start_index, end_index, "stdout_path") ||
        bytesValueSpanEqualsText(line, start_index, end_index, "stderr_path") ||
        bytesValueSpanEqualsText(line, start_index, end_index, "trace_path") ||
        bytesValueSpanEqualsText(line, start_index, end_index, "emitted_artifact_path") ||
        bytesValueSpanEqualsText(line, start_index, end_index, "comparison_result_id") ||
        bytesValueSpanEqualsText(line, start_index, end_index, "coverage_ledger_path")
}

procedure validateBytesStatusSpan(
    line: bytes@View,
    start_index: i32,
    end_index: i32
) -> bool {
    return bytesValueSpanEqualsText(line, start_index, end_index, "started") ||
        bytesValueSpanEqualsText(line, start_index, end_index, "running") ||
        bytesValueSpanEqualsText(line, start_index, end_index, "completed") ||
        bytesValueSpanEqualsText(line, start_index, end_index, "passed") ||
        bytesValueSpanEqualsText(line, start_index, end_index, "failed") ||
        bytesValueSpanEqualsText(line, start_index, end_index, "blocked") ||
        bytesValueSpanEqualsText(line, start_index, end_index, "skipped") ||
        bytesValueSpanEqualsText(line, start_index, end_index, "rendered") ||
        bytesValueSpanEqualsText(line, start_index, end_index, "utf8_valid") ||
        bytesValueSpanEqualsText(line, start_index, end_index, "utf8_invalid") ||
        bytesValueSpanEqualsText(line, start_index, end_index, "parsed") ||
        bytesValueSpanEqualsText(line, start_index, end_index, "parse_error") ||
        bytesValueSpanEqualsText(line, start_index, end_index, "modeled") ||
        bytesValueSpanEqualsText(line, start_index, end_index, "unmodeled") ||
        bytesValueSpanEqualsText(line, start_index, end_index, "generated") ||
        bytesValueSpanEqualsText(line, start_index, end_index, "unsupported_by_reference") ||
        bytesValueSpanEqualsText(line, start_index, end_index, "outside_conformance") ||
        bytesValueSpanEqualsText(line, start_index, end_index, "uncovered") ||
        bytesValueSpanEqualsText(line, start_index, end_index, "parsed_only") ||
        bytesValueSpanEqualsText(line, start_index, end_index, "reference_covered") ||
        bytesValueSpanEqualsText(line, start_index, end_index, "executed_pass") ||
        bytesValueSpanEqualsText(line, start_index, end_index, "executed_fail") ||
        bytesValueSpanEqualsText(line, start_index, end_index, "blocked_by_current_compiler") ||
        bytesValueSpanEqualsText(line, start_index, end_index, "blocked_by_oracle_language_support") ||
        bytesValueSpanEqualsText(line, start_index, end_index, "informative_only") ||
        bytesValueSpanEqualsText(line, start_index, end_index, "report_write_failed")
}

procedure validateBytesMetricKindSpan(
    line: bytes@View,
    start_index: i32,
    end_index: i32
) -> bool {
    return bytesValueSpanEqualsText(line, start_index, end_index, "-") ||
        bytesValueSpanEqualsText(line, start_index, end_index, "byte_length") ||
        bytesValueSpanEqualsText(line, start_index, end_index, "line_count") ||
        bytesValueSpanEqualsText(line, start_index, end_index, "section_count") ||
        bytesValueSpanEqualsText(line, start_index, end_index, "parsed_unit_count") ||
        bytesValueSpanEqualsText(line, start_index, end_index, "obligation_count") ||
        bytesValueSpanEqualsText(line, start_index, end_index, "modeled_obligation_count") ||
        bytesValueSpanEqualsText(line, start_index, end_index, "generated_case_count") ||
        bytesValueSpanEqualsText(line, start_index, end_index, "selftest_check_count") ||
        bytesValueSpanEqualsText(line, start_index, end_index, "passed_count") ||
        bytesValueSpanEqualsText(line, start_index, end_index, "failed_count") ||
        bytesValueSpanEqualsText(line, start_index, end_index, "blocked_count") ||
        bytesValueSpanEqualsText(line, start_index, end_index, "unsupported_count") ||
        bytesValueSpanEqualsText(line, start_index, end_index, "outside_conformance_count") ||
        bytesValueSpanEqualsText(line, start_index, end_index, "uncovered_count") ||
        bytesValueSpanEqualsText(line, start_index, end_index, "parsed_only_count") ||
        bytesValueSpanEqualsText(line, start_index, end_index, "reference_covered_count") ||
        bytesValueSpanEqualsText(line, start_index, end_index, "executed_pass_count") ||
        bytesValueSpanEqualsText(line, start_index, end_index, "executed_fail_count") ||
        bytesValueSpanEqualsText(line, start_index, end_index, "total_obligation_count") ||
        bytesValueSpanEqualsText(line, start_index, end_index, "required_obligation_count") ||
        bytesValueSpanEqualsText(line, start_index, end_index, "informative_obligation_count") ||
        bytesValueSpanEqualsText(line, start_index, end_index, "report_write_failure_count") ||
        bytesValueSpanEqualsText(line, start_index, end_index, "event_count") ||
        bytesValueSpanEqualsText(line, start_index, end_index, "final_exit_status")
}

public procedure validateEventLineBytes(line: bytes@View) -> bool {
    if (bytesStartsWithTextAt(line, "protocol=cursive-oracle-event-v1 ", 0) == false) {
        return false
    }
    let run_scope: i32 = bytesFindTextFrom(line, "run_scope=", 0)
    let event_index: i32 = bytesFindTextFrom(line, " event_index=", 0)
    let event_kind: i32 = bytesFindTextFrom(line, " event_kind=", 0)
    let severity: i32 = bytesFindTextFrom(line, " severity=", 0)
    let phase: i32 = bytesFindTextFrom(line, " phase=", 0)
    let subject_kind: i32 = bytesFindTextFrom(line, " subject_kind=", 0)
    let subject_id: i32 = bytesFindTextFrom(line, " subject_id=", 0)
    let owner: i32 = bytesFindTextFrom(line, " owner=", 0)
    let status: i32 = bytesFindTextFrom(line, " status=", 0)
    let failure_kind: i32 = bytesFindTextFrom(line, " failure_kind=", 0)
    let evidence_kind: i32 = bytesFindTextFrom(line, " evidence_kind=", 0)
    let expected: i32 = bytesFindTextFrom(line, " expected=", 0)
    let observed: i32 = bytesFindTextFrom(line, " observed=", 0)
    let evidence_path: i32 = bytesFindTextFrom(line, " evidence_path=", 0)
    let source_start: i32 = bytesFindTextFrom(line, " source_start=", 0)
    let source_end: i32 = bytesFindTextFrom(line, " source_end=", 0)
    let source_line: i32 = bytesFindTextFrom(line, " source_line=", 0)
    let source_column: i32 = bytesFindTextFrom(line, " source_column=", 0)
    let content_identity: i32 = bytesFindTextFrom(line, " content_identity=", 0)
    let metric_kind: i32 = bytesFindTextFrom(line, " metric_kind=", 0)
    let metric_value: i32 = bytesFindTextFrom(line, " metric_value=", 0)
    let message: i32 = bytesFindTextFrom(line, " message=", 0)
    let payload_end: i32 = bytesPayloadEnd(line)
    if ((run_scope < 0) || (event_index <= run_scope) || (event_kind <= event_index)) {
        return false
    }
    if ((severity <= event_kind) || (phase <= severity) || (subject_kind <= phase)) {
        return false
    }
    if ((subject_id <= subject_kind) || (owner <= subject_id) || (status <= owner)) {
        return false
    }
    if ((failure_kind <= status) || (evidence_kind <= failure_kind) || (expected <= evidence_kind)) {
        return false
    }
    if ((observed <= expected) || (evidence_path <= observed) || (source_start <= evidence_path)) {
        return false
    }
    if ((source_end <= source_start) || (source_line <= source_end)) {
        return false
    }
    if ((source_column <= source_line) || (content_identity <= source_column)) {
        return false
    }
    if ((metric_kind <= content_identity) || (metric_value <= metric_kind) || (message <= metric_value)) {
        return false
    }
    if (validateBytesEventKindSpan(line, event_kind + 12, severity) == false) {
        return false
    }
    if (validateBytesSeveritySpan(line, severity + 10, phase) == false) {
        return false
    }
    if (validateBytesPhaseSpan(line, phase + 7, subject_kind) == false) {
        return false
    }
    if (validateBytesSubjectKindSpan(line, subject_kind + 14, subject_id) == false) {
        return false
    }
    if (validateBytesStatusSpan(line, status + 8, failure_kind) == false) {
        return false
    }
    if (validateBytesFailureKindSpan(line, failure_kind + 14, evidence_kind) == false) {
        return false
    }
    if (validateBytesEvidenceKindSpan(line, evidence_kind + 15, expected) == false) {
        return false
    }
    if (validateBytesMetricKindSpan(line, metric_kind + 13, metric_value) == false) {
        return false
    }
    return validateBytesValueSpan(line, run_scope + 10, event_index) &&
        validateBytesValueSpan(line, subject_id + 12, owner) &&
        validateBytesValueSpan(line, owner + 7, status) &&
        validateBytesValueSpan(line, expected + 10, observed) &&
        validateBytesValueSpan(line, observed + 10, evidence_path) &&
        validateBytesValueSpan(line, evidence_path + 15, source_start) &&
        validateBytesValueSpan(line, source_start + 14, source_end) &&
        validateBytesValueSpan(line, source_end + 12, source_line) &&
        validateBytesValueSpan(line, source_line + 13, source_column) &&
        validateBytesValueSpan(line, source_column + 15, content_identity) &&
        validateBytesValueSpan(line, content_identity + 18, metric_kind) &&
        validateBytesValueSpan(line, metric_value + 14, message) &&
        validateBytesValueSpan(line, message + 9, payload_end)
}

public procedure validateFailureLineBytes(line: bytes@View, failure_text: string@View) -> bool {
    if (validateEventLineBytes(line) == false) {
        return false
    }
    if (bytesFindTextFrom(line, " event_kind=failure ", 0) < 0) {
        return false
    }
    if (bytesFindTextFrom(line, failure_text, 0) < 0) {
        return false
    }
    return true
}

public procedure eventLineBytesContain(line: bytes@View, text: string@View) -> bool {
    return bytesFindTextFrom(line, text, 0) >= 0
}
