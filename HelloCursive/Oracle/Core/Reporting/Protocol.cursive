procedure textByteLength(text: string@View) -> i32 {
    return string::length(text) as i32
}

procedure textByteAt(text: string@View, index: i32) -> u8 {
    let view: bytes@View = bytes::view_string(text)
    let slice: const [u8] = bytes::as_slice(view)
    return slice[index as usize]
}

procedure textStartsWithAtFrom(
    text: string@View,
    prefix: string@View,
    text_index: i32,
    prefix_index: i32
) -> bool {
    let prefix_length: i32 = textByteLength(prefix)
    if (prefix_index >= prefix_length) {
        return true
    }
    if ((text_index + prefix_index) >= textByteLength(text)) {
        return false
    }
    if (textByteAt(text, text_index + prefix_index) != textByteAt(prefix, prefix_index)) {
        return false
    }
    return textStartsWithAtFrom(text, prefix, text_index, prefix_index + 1)
}

procedure textStartsWithAt(text: string@View, prefix: string@View, index: i32) -> bool {
    if (index < 0) {
        return false
    }
    return textStartsWithAtFrom(text, prefix, index, 0)
}

procedure textFindFrom(text: string@View, needle: string@View, index: i32) -> i32 {
    if (index >= textByteLength(text)) {
        return -1
    }
    if (textStartsWithAt(text, needle, index) == true) {
        return index
    }
    return textFindFrom(text, needle, index + 1)
}

procedure textRequiresEscapingFrom(text: string@View, index: i32, length: i32) -> bool {
    if (index >= length) {
        return false
    }
    let byte: u8 = textByteAt(text, index)
    if (byte == 9) { return true }
    if (byte == 10) { return true }
    if (byte == 13) { return true }
    if (byte == 32) { return true }
    if (byte == 37) { return true }
    if (byte == 44) { return true }
    if (byte == 61) { return true }
    if (byte == 91) { return true }
    if (byte == 92) { return true }
    if (byte == 93) { return true }
    if (byte == 124) { return true }
    return textRequiresEscapingFrom(text, index + 1, length)
}

public procedure textRequiresEscaping(text: string@View) -> bool {
    return textRequiresEscapingFrom(text, 0, textByteLength(text))
}

public procedure renderReservedEscape(byte: u8) -> string@View {
    if (byte == 9) { return "%09" }
    if (byte == 10) { return "%0A" }
    if (byte == 13) { return "%0D" }
    if (byte == 32) { return "%20" }
    if (byte == 37) { return "%25" }
    if (byte == 44) { return "%2C" }
    if (byte == 61) { return "%3D" }
    if (byte == 91) { return "%5B" }
    if (byte == 92) { return "%5C" }
    if (byte == 93) { return "%5D" }
    if (byte == 124) { return "%7C" }
    return ""
}

