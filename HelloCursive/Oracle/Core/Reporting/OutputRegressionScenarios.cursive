}

public procedure escapedValueScenario() -> OutputRegressionScenario {
    let event: OutputEvent = outputRegressionEvent(
        ReportEventKind::Evidence,
        ReportSeverity::Info,
        ReportPhase::ReportWrite,
        ReportSubjectKind::Report,
        textValue("escaped subject"),
        textValue("Core::Reporting"),
        ReportStatus::Rendered,
        ReportFailureKind::Absent,
        ReportEvidenceKind::EmittedArtifactPath,
        textValue("value=with reserved"),
        textValue("value=with reserved"),
        textValue(escapedValueStdoutPath()),
        false,
        0,
        0,
        1,
        1,
        0,
        ReportMetricKind::EventCount,
        integerValue(1),
        textValue("contains space=equals|pipe[bracket]")
    )
    return outputRegressionScenario(
        "output_regression.escaped_value",
        escapedValueStdoutPath(),
        escapedValueStderrPath(),
        event
    )
}

public procedure listValueScenario() -> OutputRegressionScenario {
    let event: OutputEvent = outputRegressionEvent(
        ReportEventKind::Evidence,
        ReportSeverity::Info,
        ReportPhase::FoundationSelftest,
        ReportSubjectKind::OutputRegression,
        ReportTextValue::ListTwo("output_regression", "list_value"),
        textValue("Core::Reporting"),
        ReportStatus::Rendered,
        ReportFailureKind::Absent,
        ReportEvidenceKind::EmittedArtifactPath,
        ReportTextValue::ListTwo("stdout", "stderr"),
        ReportTextValue::ListTwo("validated", "empty"),
        textValue(listValueStdoutPath()),
        false,
        0,
        0,
        1,
        1,
        0,
        ReportMetricKind::EventCount,
        integerValue(1),
        textValue("synthetic_list_value")
    )
    return outputRegressionScenario(
        "output_regression.list_value",
        listValueStdoutPath(),
        listValueStderrPath(),
        event
    )
}
