import core::Reporting
import compare
import coverage
import runner::Compiler
import runner::Contract as RunnerContract
import runner::Runtime
import spec::Obligations
import spec::Source
import suites::SelfTest

public procedure main(move ctx: Context) -> i32 {
    var output: Reporting::OutputContext =
        Reporting::outputContext(ctx.fs, "main.default")
    output = Reporting::emitPhaseBegin(
        output,
        Reporting::ReportPhase::Startup,
        "startup",
        "HelloCursive::Oracle"
    )
    output = Reporting::emitPhaseEnd(
        output,
        Reporting::ReportPhase::Startup,
        "startup",
        "HelloCursive::Oracle",
        Reporting::ReportStatus::Completed
    )
    output = Reporting::emitPhaseBegin(
        output,
        Reporting::ReportPhase::FoundationSelftest,
        "foundation_selftest",
        "Suites::SelfTest"
    )
    let result: Reporting::PhaseRunResult = SelfTest::run(output)
    output = result.ctx

    let phase_status: Reporting::ReportStatus = Reporting::statusFromCode(result.status)
    output = Reporting::emitPhaseEnd(
        output,
        Reporting::ReportPhase::FoundationSelftest,
        "foundation_selftest",
        "Suites::SelfTest",
        phase_status
    )

    let spec_result: Source::SpecIngestionResult = Source::runSpecIngestion(output)
    output = spec_result.ctx
    let obligation_result: Obligations::ObligationSummary =
        Obligations::runObligationExtraction(output, spec_result)
    output = obligation_result.ctx
    let compiler_run: RunnerContract::CompilerRunResult =
        Compiler::runCompilerCheck(output, ctx.sys)
    output = compiler_run.ctx
    let runtime_result: Reporting::PhaseRunResult =
        Runtime::recordRuntimeSkipped(output, compiler_run.result)
    output = runtime_result.ctx
    let comparison_result: compare::ComparisonSummary =
        compare::runComparison(output, compiler_run.result, obligation_result)
    output = comparison_result.ctx
    let coverage_result: coverage::CoverageRunResult =
        coverage::runCoverage(output, obligation_result)
    output = coverage_result.ctx

    var run_status: i32 = result.status
    if (run_status == 0) {
        run_status = spec_result.status
    }
    if (run_status == 0) {
        run_status = obligation_result.status
    }
    if (run_status == 0) {
        run_status = compiler_run.result.exit_status
    }
    if (run_status == 0) {
        run_status = runtime_result.status
    }
    if (run_status == 0) {
        run_status = comparison_result.status
    }
    if (run_status == 0) {
        run_status = coverage_result.status
    }

    let final_phase_status: Reporting::ReportStatus = Reporting::statusFromCode(run_status)
    let final_exit_status: i32 = Reporting::finalStatus(output, run_status)

    output = Reporting::emitFinalSummary(
        output,
        final_phase_status,
        output.next_event_index
    )
    output = Reporting::emitFinalMetric(
        output,
        final_phase_status,
        Reporting::ReportMetricKind::TotalObligationCount,
        obligation_result.counts.total_count,
        "final_summary_total_obligations"
    )
    output = Reporting::emitFinalMetric(
        output,
        final_phase_status,
        Reporting::ReportMetricKind::RequiredObligationCount,
        obligation_result.counts.required_count,
        "final_summary_required_obligations"
    )
    output = Reporting::emitFinalMetric(
        output,
        final_phase_status,
        Reporting::ReportMetricKind::UncoveredCount,
        coverage_result.ledger.uncovered_count,
        "final_summary_uncovered_obligations"
    )
    output = Reporting::emitFinalMetric(
        output,
        final_phase_status,
        Reporting::ReportMetricKind::ExecutedPassCount,
        coverage_result.ledger.executed_pass_count,
        "final_summary_executed_pass"
    )
    output = Reporting::emitFinalMetric(
        output,
        final_phase_status,
        Reporting::ReportMetricKind::ExecutedFailCount,
        coverage_result.ledger.executed_fail_count,
        "final_summary_executed_fail"
    )
    output = Reporting::emitFinalMetric(
        output,
        final_phase_status,
        Reporting::ReportMetricKind::BlockedCount,
        coverage_result.ledger.blocked_by_current_compiler_count,
        "final_summary_blocked_by_current_compiler"
    )
    output = Reporting::emitFinalMetric(
        output,
        final_phase_status,
        Reporting::ReportMetricKind::BlockedCount,
        coverage_result.ledger.blocked_by_oracle_language_support_count,
        "final_summary_blocked_by_oracle_language_support"
    )
    output = Reporting::emitFinalEvidence(
        output,
        final_phase_status,
        Reporting::ReportEvidenceKind::CoverageLedgerPath,
        coverage_result.ledger.report_path,
        "final_summary_coverage_report_path"
    )
    output = Reporting::emitFinalMetric(
        output,
        final_phase_status,
        Reporting::ReportMetricKind::FinalExitStatus,
        final_exit_status,
        "final_summary_exit_status"
    )
    output = Reporting::emitPhaseEnd(
        output,
        Reporting::ReportPhase::Shutdown,
        "shutdown",
        "HelloCursive::Oracle",
        final_phase_status
    )
    return Reporting::finalStatus(output, run_status)
}
