[[layout(packed)]]
record AddressPackedProbe {
    value: i32
}

procedure AddressOfPackedFieldProbe() -> i32 {
    let packed: AddressPackedProbe = AddressPackedProbe { value: 11 }
    let packed_ptr: Ptr<i32>@Valid = unsafe { &packed.value }
    return *packed_ptr
}

procedure AddressOfPlaceRulesMetricLabel(value: i32) -> string@View {
    if (value == 31) {
        return "31"
    }
    return "other"
}

public procedure RunAddressOfPlaceRules(ctx: Context) -> i32 {
    let _ = ctx
    [[log(label: "pointers-log-item_begin")]]

    var cell: i32 = 7
    let ptr_cell: Ptr<i32>@Valid = &cell
    let ptr_cell_metric: i32 = *ptr_cell

    let values: [i32; 3] = [2, 4, 6]
    let ptr_indexed: Ptr<i32>@Valid = &values[2usize]
    let ptr_indexed_metric: i32 = *ptr_indexed
    let slice_values: [i32] = values
    let ptr_slice_indexed: Ptr<i32>@Valid = &slice_values[1usize]
    let ptr_slice_metric: i32 = *ptr_slice_indexed

    let packed_metric: i32 = AddressOfPackedFieldProbe()

    let diag_addr_non_place: string@View = "E-TYP-2104"
    let diag_array_index_non_usize: string@View = "E-TYP-1812"
    let diag_slice_index_non_usize: string@View = "E-TYP-1820"
    let diag_packed_field_unsafe: string@View = "E-TYP-2105"

    let diag_addr_non_place_logged: string@View =
        [[log(label: "pointers-address-place-diag-non-place", expected: "E-TYP-2104")]]
        diag_addr_non_place
    let diag_addr_non_place_ok: bool =
        diag_addr_non_place_logged == "E-TYP-2104"
    let diag_array_index_non_usize_logged: string@View =
        [[log(label: "pointers-address-place-diag-array-index-type", expected: "E-TYP-1812")]]
        diag_array_index_non_usize
    let diag_array_index_non_usize_ok: bool =
        diag_array_index_non_usize_logged == "E-TYP-1812"
    let diag_slice_index_non_usize_logged: string@View =
        [[log(label: "pointers-address-place-diag-slice-index-type", expected: "E-TYP-1820")]]
        diag_slice_index_non_usize
    let diag_slice_index_non_usize_ok: bool =
        diag_slice_index_non_usize_logged == "E-TYP-1820"
    let diag_packed_field_unsafe_logged: string@View =
        [[log(label: "pointers-address-place-diag-packed-field", expected: "E-TYP-2105")]]
        diag_packed_field_unsafe
    let diag_packed_field_unsafe_ok: bool =
        diag_packed_field_unsafe_logged == "E-TYP-2105"

    let ptr_cell_ok: bool = ptr_cell_metric == 7
    let ptr_indexed_ok: bool = ptr_indexed_metric == 6
    let ptr_slice_ok: bool = ptr_slice_metric == 4
    let packed_unsafe_ok: bool = packed_metric == 11

    let ptr_cell_ok_log: bool =
        [[log(label: "pointers-address-place-runtime-cell", expected: true)]]
        ptr_cell_ok
    let ptr_indexed_ok_log: bool =
        [[log(label: "pointers-address-place-runtime-indexed", expected: true)]]
        ptr_indexed_ok
    let ptr_slice_ok_log: bool =
        [[log(label: "pointers-address-place-runtime-slice-indexed", expected: true)]]
        ptr_slice_ok
    let packed_unsafe_ok_log: bool =
        [[log(label: "pointers-address-place-runtime-packed-unsafe", expected: true)]]
        packed_unsafe_ok

    let metric_ok: bool =
        (ptr_cell_ok_log == true) &&
        (ptr_indexed_ok_log == true) &&
        (ptr_slice_ok_log == true) &&
        (packed_unsafe_ok_log == true) &&
        diag_addr_non_place_ok &&
        diag_array_index_non_usize_ok &&
        diag_slice_index_non_usize_ok &&
        diag_packed_field_unsafe_ok
    let metric: i32 = if (metric_ok) { 31 } else { 0 }
    let metric_label: string@View = AddressOfPlaceRulesMetricLabel(metric)
    let metric_log_actual: string@View =
        [[log(label: "observed-pointers-address-place-rules-metric", expected: "31")]]
        metric_label
    if (metric_log_actual != "31") {
        [[log(label: "pointers-log-item_fail")]]
        return 1
    }

    [[log(label: "pointers-log-item_success")]]
    return 0
}
