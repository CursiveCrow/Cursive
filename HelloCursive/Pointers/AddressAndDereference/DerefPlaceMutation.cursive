procedure DerefPlaceMutationMetricLabel(value: i32) -> string@View {
    if (value == 25) {
        return "25"
    }
    return "other"
}

public procedure RunDerefPlaceMutation(ctx: Context) -> i32 {
    let _ = ctx
    [[log(label: "pointers-log-item_begin")]]

    var cell: i32 = 30

    let safe_for_mut: Ptr<i32>@Valid = &cell
    var raw_mut: *mut i32 =
        unsafe { transmute<Ptr<i32>@Valid, *mut i32>(safe_for_mut) }
    let replacement: unique i32 = 45
    unsafe {
        *raw_mut = move replacement
    }

    let safe_for_imm: Ptr<i32>@Valid = &cell
    let raw_imm: *imm i32 =
        unsafe { transmute<Ptr<i32>@Valid, *imm i32>(safe_for_imm) }
    let imm_read_metric: i32 = unsafe { *raw_imm }

    let mut_write_ok: bool = cell == 45
    let imm_read_ok: bool = imm_read_metric == 45

    let diag_const_mutation: string@View = "E-TYP-1601"
    let diag_const_mutation_logged: string@View =
        [[log(label: "pointers-deref-place-diag-const-mutation", expected: "E-TYP-1601")]]
        diag_const_mutation
    let diag_const_mutation_ok: bool =
        diag_const_mutation_logged == "E-TYP-1601"

    let mut_write_ok_log: bool =
        [[log(label: "pointers-deref-place-runtime-mut-write", expected: true)]]
        mut_write_ok
    let imm_read_ok_log: bool =
        [[log(label: "pointers-deref-place-runtime-imm-read", expected: true)]]
        imm_read_ok

    let metric_ok: bool =
        (mut_write_ok_log == true) &&
        (imm_read_ok_log == true) &&
        diag_const_mutation_ok
    let metric: i32 = if (metric_ok) { 25 } else { 0 }
    let metric_label: string@View = DerefPlaceMutationMetricLabel(metric)
    let metric_log_actual: string@View =
        [[log(label: "observed-pointers-deref-place-mutation-metric", expected: "25")]]
        metric_label
    if (metric_log_actual != "25") {
        [[log(label: "pointers-log-item_fail")]]
        return 1
    }

    [[log(label: "pointers-log-item_success")]]
    return 0
}
