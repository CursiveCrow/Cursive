record AddressCompositeLeaf {
    value: i32
    pair: (i32, i32)
    cells: [i32; 3]
}

record AddressCompositeRoot {
    left: AddressCompositeLeaf
    right: (i32, i32)
}

procedure AddressOfCompositePathsMetricLabel(value: i32) -> string@View {
    if (value == 28) {
        return "28"
    }
    return "other"
}

public procedure RunAddressOfCompositePaths(ctx: Context) -> i32 {
    let _ = ctx
    let root: AddressCompositeRoot = AddressCompositeRoot {
        left: AddressCompositeLeaf {
            value: 10,
            pair: (3, 8),
            cells: [4, 6, 9]
        },
        right: (11, 12)
    }

    let ptr_left_value: Ptr<i32>@Valid = &root.left.value
    let ptr_left_tuple: Ptr<i32>@Valid = &root.left.pair.1
    let ptr_left_index: Ptr<i32>@Valid = &root.left.cells[1usize]
    let ptr_right_tuple: Ptr<i32>@Valid = &root.right.0

    let left_value_metric: i32 = *ptr_left_value
    let left_tuple_metric: i32 = *ptr_left_tuple
    let left_index_metric: i32 = *ptr_left_index
    let right_tuple_metric: i32 = *ptr_right_tuple
    let left_value_metric_log: i32 =
        left_value_metric
    let left_tuple_metric_log: i32 =
        left_tuple_metric
    let left_index_metric_log: i32 =
        left_index_metric
    let right_tuple_metric_log: i32 =
        right_tuple_metric

    let path_metric: i32 =
        left_value_metric +
        left_tuple_metric +
        left_index_metric +
        right_tuple_metric
    let path_metric_log: i32 =
        path_metric
    let path_ok: bool = path_metric == 35

    let path_ok_log: bool =
        (path_ok &&
        (left_value_metric_log == 10) &&
        (left_tuple_metric_log == 8) &&
        (left_index_metric_log == 6) &&
        (right_tuple_metric_log == 11) &&
        (path_metric_log == 35))

    let metric_ok: bool =
        (path_ok_log == true)
    let metric: i32 = if (metric_ok) { 28 } else { 0 }
    let metric_label: string@View = AddressOfCompositePathsMetricLabel(metric)
    let metric_log_actual: string@View =
        metric_label
    if (metric_log_actual != "28") {
        return 1
    }

    return 0
}
