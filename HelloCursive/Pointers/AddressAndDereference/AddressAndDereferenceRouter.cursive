public procedure runGroup(ctx: Context) -> i32 {
    let status_place: i32 = RunAddressOfPlaceRules(ctx)
    if (status_place != 0) {
        return status_place
    }

    let status_composite: i32 = RunAddressOfCompositePaths(ctx)
    if (status_composite != 0) {
        return status_composite
    }

    let status_chains: i32 = RunAddressOfDerefChains(ctx)
    if (status_chains != 0) {
        return status_chains
    }

    let status_safe_deref: i32 = RunDereferenceSafeStates(ctx)
    if (status_safe_deref != 0) {
        return status_safe_deref
    }

    let status_raw_deref: i32 = RunDereferenceRawSafety(ctx)
    if (status_raw_deref != 0) {
        return status_raw_deref
    }

    let status_place_mut: i32 = RunDerefPlaceMutation(ctx)
    if (status_place_mut != 0) {
        return status_place_mut
    }

    return 0
}
