procedure PointerArgObserve(value: Ptr<i32>@Valid) -> i32 {
    return *value
}

procedure PointerArgConsume(move value: *imm i32) -> i32 {
    return unsafe { *value }
}

procedure PointerArgPassingModesMetricLabel(value: i32) -> string@View {
    if (value == 24) {
        return "24"
    }
    return "other"
}

public procedure RunPointerArgPassingModes(ctx: Context) -> i32 {
    let _ = ctx
    let cell: i32 = 12
    let ptr_nonconsuming: Ptr<i32>@Valid = &cell
    let nonconsuming_metric: i32 = PointerArgObserve(ptr_nonconsuming)

    let ptr_for_consuming: Ptr<i32>@Valid = &cell
    let raw_for_consuming: *imm i32 =
        unsafe { transmute<Ptr<i32>@Valid, *imm i32>(ptr_for_consuming) }
    let consuming_metric: i32 = PointerArgConsume(move raw_for_consuming)

    let nonconsuming_ok: bool = nonconsuming_metric == 12
    let consuming_ok: bool = consuming_metric == 12

    let nonconsuming_ok_log: bool =
        nonconsuming_ok
    let consuming_ok_log: bool =
        consuming_ok

    let metric_ok: bool =
        (nonconsuming_ok_log == true) &&
        (consuming_ok_log == true)
    let metric: i32 = if (metric_ok) { 24 } else { 0 }
    let metric_label: string@View = PointerArgPassingModesMetricLabel(metric)
    let metric_log_actual: string@View =
        metric_label
    if (metric_log_actual != "24") {
        return 1
    }

    return 0
}
