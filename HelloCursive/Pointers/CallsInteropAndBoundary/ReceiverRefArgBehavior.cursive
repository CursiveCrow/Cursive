record ReceiverPointerCarrier {
    value: i32

    procedure read(~) -> i32 {
        let ptr = &self.value
        return *ptr
    }

    procedure read_sync(~%) -> i32 {
        let ptr = &self.value
        return *ptr
    }

    procedure write_through_raw(~!) -> i32 {
        let ptr_valid: Ptr<unique i32>@Valid = &self.value
        var raw_mut: *mut i32 =
            unsafe { transmute<Ptr<unique i32>@Valid, *mut i32>(ptr_valid) }
        let replacement: unique i32 = 33
        unsafe {
            *raw_mut = move replacement
        }
        return self.value
    }
}

procedure ReceiverRefArgBehaviorMetricLabel(value: i32) -> string@View {
    if (value == 30) {
        return "30"
    }
    return "other"
}

public procedure RunReceiverRefArgBehavior(ctx: Context) -> i32 {
    let _ = ctx
    let carrier_seed: unique ReceiverPointerCarrier =
        ReceiverPointerCarrier { value: 12 }
    var carrier: unique ReceiverPointerCarrier = move carrier_seed

    let read_before_metric: i32 = carrier~>read()
    let write_metric: i32 = carrier~>write_through_raw()
    let read_after_metric: i32 = carrier~>read()
    let sync_after_metric: i32 = carrier~>read_sync()
    let read_before_metric_log: i32 =
        read_before_metric
    let write_metric_log: i32 =
        write_metric
    let read_after_metric_log: i32 =
        read_after_metric
    let sync_after_metric_log: i32 =
        sync_after_metric

    let shared_seed: unique ReceiverPointerCarrier =
        ReceiverPointerCarrier { value: 20 }
    let shared_carrier: shared ReceiverPointerCarrier = shared_seed
    let shared_const_metric: i32 = shared_carrier~>read()
    let shared_sync_metric: i32 = shared_carrier~>read_sync()
    let shared_const_metric_log: i32 =
        shared_const_metric
    let shared_sync_metric_log: i32 =
        shared_sync_metric
    let shared_path_metric: i32 = shared_const_metric + shared_sync_metric

    let receiver_path_ok: bool =
        (read_before_metric_log == 12) &&
        (write_metric_log == 33) &&
        (read_after_metric_log == 33) &&
        (sync_after_metric_log == 33)
    let shared_path_ok: bool =
        (shared_const_metric_log == 20) &&
        (shared_sync_metric_log == 20) &&
        (shared_path_metric == 40)
    let receiver_path_ok_log: bool =
        receiver_path_ok
    let shared_path_ok_log: bool =
        shared_path_ok

    let metric_ok: bool =
        (receiver_path_ok_log == true) &&
        (shared_path_ok_log == true)
    let metric: i32 = if (metric_ok) { 30 } else { 0 }
    let metric_label: string@View = ReceiverRefArgBehaviorMetricLabel(metric)
    let metric_log_actual: string@View =
        metric_label
    if (metric_log_actual != "30") {
        return 1
    }

    return 0
}
