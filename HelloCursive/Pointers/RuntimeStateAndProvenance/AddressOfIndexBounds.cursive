[[mangle("hc_pointers_addr_index_catch"), export("C-unwind"), unwind("catch")]]
public procedure PointersAddressIndexCatch(index: usize) -> i32 {
    let values_array: [i32; 3] = [4, 7, 11]
    let values: [i32] = values_array
    let ptr: Ptr<i32>@Valid = &values[index]
    return *ptr
}

extern "C" {
    procedure hc_pointers_addr_index_catch(index: usize) -> i32
}

procedure AddressOfIndexBoundsMetricLabel(value: i32) -> string@View {
    if (value == 18) {
        return "18"
    }
    return "other"
}

public procedure RunAddressOfIndexBounds(ctx: Context) -> i32 {
    let _ = ctx
    let values: [i32; 3] = [4, 7, 11]
    let in_bounds_ptr: Ptr<i32>@Valid = &values[1usize]
    let in_bounds_metric: i32 = *in_bounds_ptr
    let slice_values: [i32] = values
    let in_bounds_slice_ptr: Ptr<i32>@Valid = &slice_values[2usize]
    let in_bounds_slice_metric: i32 = *in_bounds_slice_ptr
    let in_bounds_catch_metric: i32 = unsafe {
        hc_pointers_addr_index_catch(2usize)
    }
    let oob_catch_metric: i32 = unsafe {
        hc_pointers_addr_index_catch(9usize)
    }
    let in_bounds_metric_log: i32 =
        in_bounds_metric
    let in_bounds_slice_metric_log: i32 =
        in_bounds_slice_metric
    let in_bounds_catch_metric_log: i32 =
        in_bounds_catch_metric
    let oob_catch_metric_log: i32 =
        oob_catch_metric

    let in_bounds_ok: bool = in_bounds_metric_log == 7
    let in_bounds_slice_ok: bool = in_bounds_slice_metric_log == 11
    let in_bounds_catch_ok: bool = in_bounds_catch_metric_log == 11
    let oob_catch_ok: bool = oob_catch_metric_log == 0
    let in_bounds_ok_log: bool =
        in_bounds_ok
    let in_bounds_slice_ok_log: bool =
        in_bounds_slice_ok
    let in_bounds_catch_ok_log: bool =
        in_bounds_catch_ok
    let oob_catch_ok_log: bool =
        oob_catch_ok

    let metric_ok: bool =
        (in_bounds_ok_log == true) &&
        (in_bounds_slice_ok_log == true) &&
        (in_bounds_catch_ok_log == true) &&
        (oob_catch_ok_log == true)
    let metric: i32 = if (metric_ok) { 18 } else { 0 }
    let metric_label: string@View = AddressOfIndexBoundsMetricLabel(metric)
    let metric_log_actual: string@View =
        metric_label
    if (metric_log_actual != "18") {
        return 1
    }

    return 0
}
