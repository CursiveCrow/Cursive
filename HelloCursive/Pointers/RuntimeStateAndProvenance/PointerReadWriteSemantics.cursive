procedure PointerReadWriteSemanticsMetricLabel(value: i32) -> string@View {
    if (value == 29) {
        return "29"
    }
    return "other"
}

public procedure RunPointerReadWriteSemantics(ctx: Context) -> i32 {
    let _ = ctx
    [[log(label: "pointers-log-item_begin")]]

    var cell: i32 = 6
    let safe_read_ptr: Ptr<i32>@Valid = &cell
    let safe_read_metric: i32 = *safe_read_ptr

    let safe_for_write: Ptr<i32>@Valid = &cell
    var raw_write_ptr: *mut i32 =
        unsafe { transmute<Ptr<i32>@Valid, *mut i32>(safe_for_write) }
    let updated_value: unique i32 = 17
    unsafe {
        *raw_write_ptr = move updated_value
    }
    let post_write_metric: i32 = cell

    let ptr_null: Ptr<i32>@Null = Ptr::null()
    let ptr_state: Ptr<i32> = ptr_null

    let safe_read_ok: bool = safe_read_metric == 6
    let post_write_ok: bool = post_write_metric == 17
    let null_shape_ok: bool = ptr_null == ptr_null
    let expired_shape_ok: bool = ptr_state == ptr_state

    let safe_read_ok_log: bool =
        [[log(label: "pointers-runtime-readwrite-safe-read", expected: true)]]
        safe_read_ok
    let post_write_ok_log: bool =
        [[log(label: "pointers-runtime-readwrite-post-write", expected: true)]]
        post_write_ok
    let null_shape_ok_log: bool =
        [[log(label: "pointers-runtime-readwrite-null-shape", expected: true)]]
        null_shape_ok
    let expired_shape_ok_log: bool =
        [[log(label: "pointers-runtime-readwrite-expired-shape", expected: true)]]
        expired_shape_ok

    let metric_ok: bool =
        (safe_read_ok_log == true) &&
        (post_write_ok_log == true) &&
        (null_shape_ok_log == true) &&
        (expired_shape_ok_log == true)
    let metric: i32 = if (metric_ok) { 29 } else { 0 }
    let metric_label: string@View = PointerReadWriteSemanticsMetricLabel(metric)
    let metric_log_actual: string@View =
        [[log(label: "observed-pointers-runtime-readwrite-semantics-metric", expected: "29")]]
        metric_label
    if (metric_log_actual != "29") {
        [[log(label: "pointers-log-item_fail")]]
        return 1
    }

    [[log(label: "pointers-log-item_success")]]
    return 0
}
