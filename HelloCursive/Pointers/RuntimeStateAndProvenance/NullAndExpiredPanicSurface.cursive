[[mangle("hc_pointers_null_deref_catch"), export("C-unwind"), unwind("catch")]]
public procedure PointersNullDerefCatch() -> i32 {
    let ptr_null: Ptr<i32>@Null = Ptr::null()
    let ptr_valid: Ptr<i32>@Valid =
        unsafe { transmute<Ptr<i32>@Null, Ptr<i32>@Valid>(ptr_null) }
    return *ptr_valid
}

[[mangle("hc_pointers_expired_deref_catch"), export("C-unwind"), unwind("catch")]]
public procedure PointersExpiredDerefCatch() -> i32 {
    region as r {
        let live_value: i32 = r ^ 13
        let live_ptr: Ptr<i32>@Valid = &live_value
        unsafe {
            r~>reset_unchecked()
            let stale_expired: Ptr<i32>@Expired =
                transmute<Ptr<i32>@Valid, Ptr<i32>@Expired>(live_ptr)
            let stale_valid: Ptr<i32>@Valid =
                transmute<Ptr<i32>@Expired, Ptr<i32>@Valid>(stale_expired)
            return *stale_valid
        }
    }
    return 1
}

extern "C" {
    procedure hc_pointers_null_deref_catch() -> i32
    procedure hc_pointers_expired_deref_catch() -> i32
}

procedure NullAndExpiredPanicSurfaceMetricLabel(value: i32) -> string@View {
    if (value == 20) {
        return "20"
    }
    return "other"
}

public procedure RunNullAndExpiredPanicSurface(ctx: Context) -> i32 {
    let _ = ctx
    [[log(label: "pointers-log-item_begin")]]

    let ptr_null: Ptr<i32>@Null = Ptr::null()
    let ptr_expired: Ptr<i32>@Expired =
        unsafe { transmute<Ptr<i32>@Null, Ptr<i32>@Expired>(ptr_null) }
    let null_panic_catch_metric: i32 = unsafe {
        hc_pointers_null_deref_catch()
    }
    let expired_panic_catch_metric: i32 = unsafe {
        hc_pointers_expired_deref_catch()
    }

    let null_shape_ok: bool = ptr_null == ptr_null
    let expired_shape_ok: bool = ptr_expired == ptr_expired
    let null_panic_catch_ok: bool = null_panic_catch_metric == 0
    let expired_panic_catch_ok: bool = expired_panic_catch_metric == 0

    let diag_deref_null: string@View = "E-TYP-2101"
    let diag_deref_expired: string@View = "E-TYP-2102"

    let diag_deref_null_logged: string@View =
        [[log(label: "pointers-runtime-panic-diag-null", expected: "E-TYP-2101")]]
        diag_deref_null
    let diag_deref_null_ok: bool =
        diag_deref_null_logged == "E-TYP-2101"
    let diag_deref_expired_logged: string@View =
        [[log(label: "pointers-runtime-panic-diag-expired", expected: "E-TYP-2102")]]
        diag_deref_expired
    let diag_deref_expired_ok: bool =
        diag_deref_expired_logged == "E-TYP-2102"

    let null_shape_ok_log: bool =
        [[log(label: "pointers-runtime-panic-null-shape", expected: true)]]
        null_shape_ok
    let expired_shape_ok_log: bool =
        [[log(label: "pointers-runtime-panic-expired-shape", expected: true)]]
        expired_shape_ok
    let null_panic_catch_ok_log: bool =
        [[log(label: "pointers-runtime-panic-null-catch", expected: true)]]
        null_panic_catch_ok
    let expired_panic_catch_ok_log: bool =
        [[log(label: "pointers-runtime-panic-expired-catch", expected: true)]]
        expired_panic_catch_ok

    let metric_ok: bool =
        (null_shape_ok_log == true) &&
        (expired_shape_ok_log == true) &&
        (null_panic_catch_ok_log == true) &&
        (expired_panic_catch_ok_log == true) &&
        diag_deref_null_ok &&
        diag_deref_expired_ok
    let metric: i32 = if (metric_ok) { 20 } else { 0 }
    let metric_label: string@View = NullAndExpiredPanicSurfaceMetricLabel(metric)
    let metric_log_actual: string@View =
        [[log(label: "observed-pointers-runtime-null-expired-panic-surface-metric", expected: "20")]]
        metric_label
    if (metric_log_actual != "20") {
        [[log(label: "pointers-log-item_fail")]]
        return 1
    }

    [[log(label: "pointers-log-item_success")]]
    return 0
}
