record ProvenancePropagationRecord {
    pair: (i32, i32)
    values: [i32; 3]
}

procedure PointerProvenancePropagationMetricLabel(value: i32) -> string@View {
    if (value == 27) {
        return "27"
    }
    return "other"
}

public procedure RunPointerProvenancePropagation(ctx: Context) -> i32 {
    let _ = ctx
    let seed: ProvenancePropagationRecord = ProvenancePropagationRecord {
        pair: (5, 8),
        values: [3, 6, 9]
    }

    let pair_ptr: Ptr<i32>@Valid = &seed.pair.1
    let values_ptr: Ptr<i32>@Valid = &seed.values[2usize]

    let pair_metric: i32 = *pair_ptr
    let values_metric: i32 = *values_ptr

    let pair_ptr_for_raw: Ptr<i32>@Valid = &seed.pair.1
    let pair_raw: *imm i32 =
        unsafe { transmute<Ptr<i32>@Valid, *imm i32>(pair_ptr_for_raw) }
    let raw_metric: i32 = unsafe { *pair_raw }

    let chain_pair_ptr: Ptr<i32>@Valid = &*pair_ptr
    let chain_metric: i32 = *chain_pair_ptr
    let pair_metric_log: i32 =
        pair_metric
    let values_metric_log: i32 =
        values_metric
    let raw_metric_log: i32 =
        raw_metric
    let chain_metric_log: i32 =
        chain_metric

    let pair_addr_bits: usize =
        unsafe { transmute<Ptr<i32>@Valid, usize>(pair_ptr) }
    let values_addr_bits: usize =
        unsafe { transmute<Ptr<i32>@Valid, usize>(values_ptr) }
    let chain_addr_bits: usize =
        unsafe { transmute<Ptr<i32>@Valid, usize>(chain_pair_ptr) }
    let addr_chain_ok: bool = pair_addr_bits == chain_addr_bits
    let addr_distinct_ok: bool = pair_addr_bits != values_addr_bits

    let provenance_path_ok: bool =
        (pair_metric_log == 8) &&
        (values_metric_log == 9) &&
        (raw_metric_log == 8) &&
        (chain_metric_log == 8)

    let provenance_path_ok_log: bool =
        provenance_path_ok
    let addr_chain_ok_log: bool =
        addr_chain_ok
    let addr_distinct_ok_log: bool =
        addr_distinct_ok

    let metric_ok: bool =
        (provenance_path_ok_log == true) &&
        (addr_chain_ok_log == true) &&
        (addr_distinct_ok_log == true)
    let metric: i32 = if (metric_ok) { 27 } else { 0 }
    let metric_label: string@View = PointerProvenancePropagationMetricLabel(metric)
    let metric_log_actual: string@View =
        metric_label
    if (metric_log_actual != "27") {
        return 1
    }

    return 0
}
