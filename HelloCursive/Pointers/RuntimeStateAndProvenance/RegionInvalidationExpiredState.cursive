procedure RegionInvalidationExpiredProbe() -> i32 {
    region as r {
        let live_value: i32 = r ^ 16
        let live_ptr: Ptr<i32>@Valid = &live_value
        let live_metric: i32 = *live_ptr

        unsafe {
            r~>reset_unchecked()
            let stale_ptr: Ptr<i32> = live_ptr
            let stale_shape_metric: bool = stale_ptr == stale_ptr
            r~>free_unchecked()

            if ((live_metric == 16) && (stale_shape_metric == true)) {
                return 17
            }
        }
    }
    return 0
}

procedure RegionInvalidationExpiredStateMetricLabel(value: i32) -> string@View {
    if (value == 24) {
        return "24"
    }
    return "other"
}

public procedure RunRegionInvalidationExpiredState(ctx: Context) -> i32 {
    let _ = ctx
    let invalidation_metric: i32 = RegionInvalidationExpiredProbe()
    let invalidation_metric_ok: bool = invalidation_metric == 17

    let diag_expired_deref: string@View = "E-TYP-2102"
    let diag_unchecked_requires_unsafe: string@View = "E-MEM-3030"

    let diag_expired_deref_logged: string@View =
        diag_expired_deref
    let diag_expired_deref_ok: bool =
        diag_expired_deref_logged == "E-TYP-2102"
    let diag_unchecked_requires_unsafe_logged: string@View =
        diag_unchecked_requires_unsafe
    let diag_unchecked_requires_unsafe_ok: bool =
        diag_unchecked_requires_unsafe_logged == "E-MEM-3030"

    let invalidation_metric_ok_log: bool =
        invalidation_metric_ok

    let metric_ok: bool =
        (invalidation_metric_ok_log == true) &&
        diag_expired_deref_ok &&
        diag_unchecked_requires_unsafe_ok
    let metric: i32 = if (metric_ok) { 24 } else { 0 }
    let metric_label: string@View = RegionInvalidationExpiredStateMetricLabel(metric)
    let metric_log_actual: string@View =
        metric_label
    if (metric_log_actual != "24") {
        return 1
    }

    return 0
}
