procedure SafePointerStateFormsAcceptState(value: Ptr<i32>) -> i32 {
    let _ = value
    return 1
}

procedure SafePointerStateFormsMetricLabel(value: i32) -> string@View {
    if (value == 27) {
        return "27"
    }
    return "other"
}

public procedure RunSafePointerStateForms(ctx: Context) -> i32 {
    let _ = ctx
    var cell: i32 = 9
    let ptr_unqualified: Ptr<i32> = &cell
    let ptr_valid: Ptr<i32>@Valid = &cell
    let ptr_general_from_valid: Ptr<i32> = ptr_valid

    let ptr_null: Ptr<i32>@Null = Ptr::null()
    let ptr_general_from_null: Ptr<i32> = ptr_null
    let ptr_valid_for_expired: Ptr<i32>@Valid = &cell
    let ptr_state: Ptr<i32> = ptr_valid_for_expired

    let valid_read_metric: i32 = *ptr_valid
    let general_from_valid_metric: i32 = *ptr_general_from_valid
    let valid_read_metric_log: i32 =
        valid_read_metric
    let general_from_valid_metric_log: i32 =
        general_from_valid_metric

    let ptr_general_shape_ok: bool = ptr_general_from_valid == ptr_general_from_valid
    let ptr_general_from_null_shape_ok: bool =
        ptr_general_from_null == ptr_general_from_null
    let ptr_unqualified_shape_ok: bool = ptr_unqualified == ptr_unqualified
    let ptr_null_shape_ok: bool = ptr_null == ptr_null
    let ptr_expired_shape_ok: bool = ptr_state == ptr_state
    let ptr_expired_accept_ok: bool = SafePointerStateFormsAcceptState(ptr_state) == 1
    let valid_read_ok: bool = valid_read_metric_log == 9
    let general_from_valid_read_ok: bool = general_from_valid_metric_log == 9

    let valid_read_ok_log: bool =
        valid_read_ok
    let general_from_valid_read_ok_log: bool =
        general_from_valid_read_ok
    let ptr_general_shape_ok_log: bool =
        ptr_general_shape_ok
    let ptr_general_from_null_shape_ok_log: bool =
        ptr_general_from_null_shape_ok
    let ptr_unqualified_shape_ok_log: bool =
        ptr_unqualified_shape_ok
    let ptr_null_shape_ok_log: bool =
        ptr_null_shape_ok
    let ptr_expired_shape_ok_log: bool =
        ptr_expired_shape_ok
    let ptr_expired_accept_ok_log: bool =
        ptr_expired_accept_ok

    let metric_ok: bool =
        (valid_read_ok_log == true) &&
        (general_from_valid_read_ok_log == true) &&
        (ptr_general_shape_ok_log == true) &&
        (ptr_general_from_null_shape_ok_log == true) &&
        (ptr_unqualified_shape_ok_log == true) &&
        (ptr_null_shape_ok_log == true) &&
        (ptr_expired_shape_ok_log == true) &&
        (ptr_expired_accept_ok_log == true)
    let metric: i32 = if (metric_ok) { 27 } else { 0 }
    let metric_label: string@View = SafePointerStateFormsMetricLabel(metric)
    let metric_log_actual: string@View =
        metric_label
    if (metric_log_actual != "27") {
        return 1
    }

    return 0
}
