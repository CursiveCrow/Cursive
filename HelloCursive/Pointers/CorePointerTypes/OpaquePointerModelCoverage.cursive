type OpaquePointerSafe = Ptr<i32>@Valid
type OpaquePointerRaw = *imm i32
type OpaquePointerPermWrapped = const Ptr<i32>@Valid
type OpaquePointerFn = (i32) -> i32

procedure OpaquePointerFnImpl(value: i32) -> i32 {
    return value + 1
}

procedure OpaquePointerModelMetricLabel(value: i32) -> string@View {
    if (value == 66) {
        return "66"
    }
    return "other"
}

public procedure RunOpaquePointerModelCoverage(ctx: Context) -> i32 {
    let _ = ctx
    [[log(label: "pointers-log-item_begin")]]

    var cell: i32 = 20
    let safe_for_raw: Ptr<i32>@Valid = &cell
    let safe_ptr: OpaquePointerSafe = safe_for_raw
    let raw_ptr: OpaquePointerRaw = unsafe { transmute<Ptr<i32>@Valid, *imm i32>(safe_for_raw) }
    let perm_ptr: OpaquePointerPermWrapped = safe_for_raw
    let fn_ptr: OpaquePointerFn = OpaquePointerFnImpl

    let safe_metric: i32 = *safe_ptr
    let raw_metric: i32 = unsafe { *raw_ptr }
    let perm_metric: i32 = *perm_ptr
    let fn_metric: i32 = fn_ptr(4)
    let shape_metric: i32 = if (
        (safe_ptr == safe_ptr) &&
        (raw_ptr == raw_ptr) &&
        (perm_ptr == perm_ptr)
    ) { 1 } else { 0 }

    let total_metric: i32 =
        safe_metric +
        raw_metric +
        perm_metric +
        fn_metric +
        shape_metric

    let opaque_pointer_model_ok: bool = total_metric == 66
    let opaque_pointer_model_ok_log: bool =
        [[log(label: "pointers-core-opaque-pointer-model-surface", expected: true)]]
        opaque_pointer_model_ok

    let metric: i32 = if ((opaque_pointer_model_ok_log == true) && opaque_pointer_model_ok) { 66 } else { 0 }
    let metric_label: string@View = OpaquePointerModelMetricLabel(metric)
    let metric_log_actual: string@View =
        [[log(label: "observed-pointers-core-opaque-pointer-model-metric", expected: "66")]]
        metric_label
    if (metric_log_actual != "66") {
        [[log(label: "pointers-log-item_fail")]]
        return 1
    }

    [[log(label: "pointers-log-item_success")]]
    return 0
}
