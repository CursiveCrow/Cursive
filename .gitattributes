# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts must always be LF so shebangs parse under WSL/Linux from
# a Windows checkout (otherwise `/usr/bin/env: 'bash\r': Permission denied`).
*.sh text eol=lf
scripts/spec-audit-loop text eol=lf
extern/icu/**/bin64/* -text
extern/icu/**/bin64/*.dll filter=lfs diff=lfs merge=lfs -text
extern/icu/**/lib/*.dat -text
extern/icu/**/lib/*.dat filter=lfs diff=lfs merge=lfs -text
extern/icu/**/lib/*.so -text
extern/icu/**/lib/*.so filter=lfs diff=lfs merge=lfs -text
extern/icu/**/lib/*.so.* -text
extern/icu/**/lib/*.so.* filter=lfs diff=lfs merge=lfs -text
extern/icu/**/lib64/*.lib -text
extern/icu/**/lib64/*.lib filter=lfs diff=lfs merge=lfs -text
extern/llvm/**/bin/* -text
extern/llvm/**/bin/* filter=lfs diff=lfs merge=lfs -text
extern/llvm/**/lib/*.a -text
extern/llvm/**/lib/*.a filter=lfs diff=lfs merge=lfs -text
extern/llvm/**/lib/*.so -text
extern/llvm/**/lib/*.so filter=lfs diff=lfs merge=lfs -text
extern/llvm/**/lib/*.so.* -text
extern/llvm/**/lib/*.so.* filter=lfs diff=lfs merge=lfs -text
extern/llvm/**/lib/*.lib -text
extern/llvm/**/lib/*.lib filter=lfs diff=lfs merge=lfs -text
extern/llvm/llvm-21.1.8-x86_64-sysv/bin/clang++ filter=lfs diff=lfs merge=lfs -text
extern/llvm/llvm-21.1.8-x86_64-sysv/bin/ld.lld filter=lfs diff=lfs merge=lfs -text
