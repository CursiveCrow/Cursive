{
  "name": "cursive-vscode",
  "displayName": "Cursive",
  "description": "VS Code language support for Cursive.",
  "version": "0.0.3",
  "publisher": "local",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:cursive"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "cursive",
        "aliases": [
          "Cursive",
          "cursive"
        ],
        "extensions": [
          ".cursive"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "cursive",
        "scopeName": "source.cursive",
        "path": "./syntaxes/cursive.tmLanguage.json"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "cursive",
        "scopes": {
          "namespace": [
            "entity.name.namespace.cursive"
          ],
          "type": [
            "entity.name.type.cursive",
            "support.type.cursive"
          ],
          "class": [
            "entity.name.type.class.cursive"
          ],
          "enum": [
            "entity.name.type.enum.cursive"
          ],
          "struct": [
            "entity.name.type.struct.cursive"
          ],
          "enumMember": [
            "variable.other.enummember.cursive"
          ],
          "function": [
            "entity.name.function.cursive"
          ],
          "method": [
            "entity.name.function.member.cursive"
          ],
          "property": [
            "variable.other.property.cursive"
          ],
          "parameter": [
            "variable.parameter.cursive"
          ],
          "variable": [
            "variable.other.readwrite.cursive"
          ],
          "variable.readonly": [
            "variable.other.constant.cursive"
          ],
          "keyword": [
            "keyword.control.cursive"
          ],
          "number": [
            "constant.numeric.cursive"
          ],
          "string": [
            "string.quoted.cursive"
          ],
          "operator": [
            "keyword.operator.cursive"
          ],
          "comment": [
            "comment.line.double-slash.cursive"
          ],
          "comment.documentation": [
            "comment.line.documentation.cursive"
          ]
        }
      }
    ],
    "configurationDefaults": {
      "[cursive]": {
        "editor.semanticHighlighting.enabled": true
      }
    },
    "configuration": {
      "title": "Cursive",
      "properties": {
        "cursive.lsp.path": {
          "type": "string",
          "default": "",
          "description": "Path to the Cursive language server executable. Leave empty to use the repo-local debug build."
        },
        "cursive.lsp.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace communication with the Cursive language server."
        },
        "cursive.lsp.logFile": {
          "type": "string",
          "default": "",
          "description": "Optional path for Cursive language server lifecycle logs."
        },
        "cursive.lsp.targetProfile": {
          "type": "string",
          "enum": [
            "",
            "x86_64-sysv",
            "x86_64-win64",
            "aarch64-aapcs64"
          ],
          "default": "",
          "description": "Optional target profile passed to the Cursive language server."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.4.0"
  }
}
