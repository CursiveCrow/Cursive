public record Cell {
    public value: i32
}

procedure consumeShared(cell: shared Cell) -> i32 {
    let _ = cell
    return 7
}

public procedure main(move ctx: Context) -> i32 {
    let _ = ctx
    let owner: unique Cell = Cell { value: 7 }
    let view: shared Cell = owner
    return consumeShared(view)
}
