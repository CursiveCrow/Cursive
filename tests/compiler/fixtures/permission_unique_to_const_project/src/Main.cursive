public record Cell {
    public value: i32
}

procedure consumeConst(cell: const Cell) -> i32 {
    return cell.value
}

public procedure main(move ctx: Context) -> i32 {
    let _ = ctx
    let owner: unique Cell = Cell { value: 7 }
    let view: const Cell = owner
    return consumeConst(owner) + view.value
}
