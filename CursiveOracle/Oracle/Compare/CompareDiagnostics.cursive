procedure diagnosticMismatchKind(
    reference: ReferenceContract::ReferenceResult,
    implementation: RunnerContract::ImplementationResult
) -> ComparisonMismatchKind {
    if (reportStatusIsFailed(reference.expected_status) == true) {
        if (implementation.exit_status == 0) {
            return ComparisonMismatchKind::MissingRequiredDiagnostic
        }
    }
    if (reportStatusIsPassed(reference.expected_status) == true) {
        if (implementation.exit_status != 0) {
            return ComparisonMismatchKind::UnexpectedDiagnostic
        }
    }
    return ComparisonMismatchKind::CompileStatusMismatch
}

public procedure compareDiagnosticResult(
    reference: ReferenceContract::ReferenceResult,
    implementation: RunnerContract::ImplementationResult,
    obligation: Obligations::SpecObligation
) -> ComparisonResult {
    let coverage_status: Reporting::ReportStatus =
        ReferenceContract::coverageStatus(reference.coverage_state)
    if (reportStatusIsUnsupportedByReference(coverage_status) == true) {
        return comparisonResult(
            "comparison.case_obligation_0001",
            reference,
            implementation,
            obligation,
            Reporting::ReportStatus::UnsupportedByReference,
            ComparisonMismatchKind::ReferenceUnsupported,
            expectedStatusSummary(reference.expected_status),
            observedCompilerSummary(implementation),
            implementation.diagnostic_path
        )
    }
    if (reportStatusIsOutsideConformance(coverage_status) == true) {
        return comparisonResult(
            "comparison.case_obligation_0001",
            reference,
            implementation,
            obligation,
            Reporting::ReportStatus::OutsideConformance,
            ComparisonMismatchKind::OutsideConformance,
            expectedStatusSummary(reference.expected_status),
            observedCompilerSummary(implementation),
            implementation.diagnostic_path
        )
    }
    if (reportStatusIsBlockedByOracleLanguageSupport(coverage_status) == true) {
        return comparisonResult(
            "comparison.case_obligation_0001",
            reference,
            implementation,
            obligation,
            Reporting::ReportStatus::Blocked,
            ComparisonMismatchKind::ReferenceBlocked,
            expectedStatusSummary(reference.expected_status),
            observedCompilerSummary(implementation),
            implementation.artifact_path
        )
    }
    if (implementationMatchesExpectedStatus(reference, implementation) == true) {
        return comparisonResult(
            "comparison.case_obligation_0001",
            reference,
            implementation,
            obligation,
            Reporting::ReportStatus::Passed,
            ComparisonMismatchKind::None,
            expectedStatusSummary(reference.expected_status),
            observedCompilerSummary(implementation),
            implementation.diagnostic_path
        )
    }
    return comparisonResult(
        "comparison.case_obligation_0001",
        reference,
        implementation,
        obligation,
        Reporting::ReportStatus::Failed,
        diagnosticMismatchKind(reference, implementation),
        expectedStatusSummary(reference.expected_status),
        observedCompilerSummary(implementation),
        implementation.diagnostic_path
    )
}

procedure emitComparisonResult(
    ctx: Reporting::OutputContext,
    result: ComparisonResult
) -> Reporting::OutputContext {
    let event: Reporting::OutputEvent = Reporting::eventWithSourceContext(
        Reporting::eventWithEvidence(
            Reporting::eventWithExpectedObserved(
                Reporting::eventBase(
                    Reporting::ReportEventKind::Evidence,
                    Reporting::ReportSeverity::Info,
                    Reporting::ReportPhase::Comparison,
                    Reporting::ReportSubjectKind::ComparisonResult,
                    result.comparison_id,
                    "Oracle::Compare",
                    result.status,
                    renderComparisonMismatchKind(result.mismatch_kind)
                ),
                result.expected_summary,
                result.observed_summary
            ),
            Reporting::ReportEvidenceKind::ComparisonResultId,
            result.evidence_path
        ),
        result.source_start,
        result.source_end,
        result.source_line,
        result.source_column,
        result.content_identity
    )
    return Reporting::emitEvent(ctx, event)
}

procedure emitDiagnosticFailure(
    ctx: Reporting::OutputContext,
    result: ComparisonResult
) -> Reporting::OutputContext {
    if (reportStatusIsFailed(result.status) == true) {
        let event: Reporting::OutputEvent = Reporting::eventWithSourceContext(
            Reporting::eventWithEvidence(
                Reporting::failureEvent(
                    Reporting::ReportPhase::Comparison,
                    Reporting::ReportSubjectKind::ComparisonResult,
                    result.comparison_id,
                    "Oracle::Compare",
                    Reporting::ReportFailureKind::DiagnosticMismatch,
                    result.expected_summary,
                    result.observed_summary,
                    renderComparisonMismatchKind(result.mismatch_kind)
                ),
                Reporting::ReportEvidenceKind::ComparisonResultId,
                result.evidence_path
            ),
            result.source_start,
            result.source_end,
            result.source_line,
            result.source_column,
            result.content_identity
        )
        return Reporting::emitEvent(ctx, event)
    }
    return ctx
}

procedure emitComparisonMetric(
    ctx: Reporting::OutputContext,
    subject_id: string@View,
    metric_kind: Reporting::ReportMetricKind,
    value: i32,
    status: Reporting::ReportStatus
) -> Reporting::OutputContext {
    return Reporting::emitEvent(
        ctx,
        Reporting::metricIntegerEvent(
            Reporting::ReportPhase::Comparison,
            Reporting::ReportSubjectKind::ComparisonResult,
            subject_id,
            "Oracle::Compare",
            status,
            metric_kind,
            value,
            "comparison_count_by_status"
        )
    )
}

procedure comparisonExitStatus(result: ComparisonResult) -> i32 {
    if (reportStatusIsFailed(result.status) == true) {
        return 1
    }
    return 0
}

procedure comparisonPassedCount(result: ComparisonResult) -> i32 {
    if (reportStatusIsPassed(result.status) == true) {
        return 1
    }
    return 0
}

procedure comparisonFailedCount(result: ComparisonResult) -> i32 {
    if (reportStatusIsFailed(result.status) == true) {
        return 1
    }
    return 0
}

procedure comparisonBlockedCount(result: ComparisonResult) -> i32 {
    if (reportStatusIsBlocked(result.status) == true) {
        return 1
    }
    return 0
}

procedure comparisonUnsupportedCount(result: ComparisonResult) -> i32 {
    if (reportStatusIsUnsupportedByReference(result.status) == true) {
        return 1
    }
    return 0
}

procedure comparisonOutsideConformanceCount(result: ComparisonResult) -> i32 {
    if (reportStatusIsOutsideConformance(result.status) == true) {
        return 1
    }
    return 0
}

public procedure runComparison(
    ctx: Reporting::OutputContext,
    reference: ReferenceContract::ReferenceModelSummary,
    implementation: RunnerContract::ImplementationResult,
    obligation: Obligations::ObligationSummary
) -> ComparisonSummary {
    var output: Reporting::OutputContext = Reporting::emitPhaseBegin(
        ctx,
        Reporting::ReportPhase::Comparison,
        "comparison",
        "Oracle::Compare"
    )
    let result: ComparisonResult = compareDiagnosticResult(
        reference.result,
        implementation,
        obligation.primary_obligation
    )
    output = emitComparisonResult(output, result)
    output = emitDiagnosticFailure(output, result)

    let passed_count: i32 = comparisonPassedCount(result)
    let failed_count: i32 = comparisonFailedCount(result)
    let blocked_count: i32 = comparisonBlockedCount(result)
    let unsupported_count: i32 = comparisonUnsupportedCount(result)
    let outside_conformance_count: i32 = comparisonOutsideConformanceCount(result)
    output = emitComparisonMetric(
        output,
        "status.passed",
        Reporting::ReportMetricKind::PassedCount,
        passed_count,
        Reporting::ReportStatus::Passed
    )
    output = emitComparisonMetric(
        output,
        "status.failed",
        Reporting::ReportMetricKind::FailedCount,
        failed_count,
        Reporting::ReportStatus::Failed
    )
    output = emitComparisonMetric(
        output,
        "status.blocked",
        Reporting::ReportMetricKind::BlockedCount,
        blocked_count,
        Reporting::ReportStatus::Blocked
    )
    output = emitComparisonMetric(
        output,
        "status.unsupported",
        Reporting::ReportMetricKind::UnsupportedCount,
        unsupported_count,
        Reporting::ReportStatus::UnsupportedByReference
    )
    output = emitComparisonMetric(
        output,
        "status.outside_conformance",
        Reporting::ReportMetricKind::OutsideConformanceCount,
        outside_conformance_count,
        Reporting::ReportStatus::OutsideConformance
    )
    output = Reporting::emitPhaseEnd(
        output,
        Reporting::ReportPhase::Comparison,
        "comparison",
        "Oracle::Compare",
        result.status
    )
    return comparisonSummary(
        output,
        result,
        comparisonExitStatus(result),
        passed_count,
        failed_count,
        blocked_count,
        unsupported_count,
        outside_conformance_count
    )
}
