public procedure hashByteView(view: bytes@View) -> i32 {
    let length: i32 = byteLength(view)
    let view_slice: const [u8] = bytes::as_slice(view)
    var index: i32 = 0
    var state: i32 = 17
    loop {
        if (index >= length) {
            break
        }
        let value: i32 = view_slice[index as usize] as i32
        let state_part: i32 = state % 4093
        let index_part: i32 = index % 4093
        state = ((state_part * 33) + value + index_part) % 4093
        index = index + 1
    }
    return state
}

public procedure hashText(text: string@View) -> i32 {
    return hashByteView(textAsBytes(text))
}
