public procedure metricEvent(
    phase: ReportPhase,
    subject_kind: ReportSubjectKind,
    subject_id: string@View,
    owner: string@View,
    status: ReportStatus,
    metric_kind: ReportMetricKind,
    metric_value: string@View,
    message: string@View
) -> OutputEvent {
    return eventWithMetricText(
        eventBase(
            ReportEventKind::Progress,
            ReportSeverity::Info,
            phase,
            subject_kind,
            subject_id,
            owner,
            status,
            message
        ),
        metric_kind,
        metric_value
    )
}

public procedure metricIntegerEvent(
    phase: ReportPhase,
    subject_kind: ReportSubjectKind,
    subject_id: string@View,
    owner: string@View,
    status: ReportStatus,
    metric_kind: ReportMetricKind,
    metric_value: i32,
    message: string@View
) -> OutputEvent {
    return eventWithMetricInteger(
        eventBase(
            ReportEventKind::Progress,
            ReportSeverity::Info,
            phase,
            subject_kind,
            subject_id,
            owner,
            status,
            message
        ),
        metric_kind,
        metric_value
    )
}

public procedure evidenceEvent(
    phase: ReportPhase,
    subject_kind: ReportSubjectKind,
    subject_id: string@View,
    owner: string@View,
    status: ReportStatus,
    evidence_kind: ReportEvidenceKind,
    evidence_path: string@View,
    message: string@View
) -> OutputEvent {
    return eventWithEvidence(
        eventBase(
            ReportEventKind::Evidence,
            ReportSeverity::Info,
            phase,
            subject_kind,
            subject_id,
            owner,
            status,
            message
        ),
        evidence_kind,
        evidence_path
    )
}

public procedure failureEvent(
    phase: ReportPhase,
    subject_kind: ReportSubjectKind,
    subject_id: string@View,
    owner: string@View,
    failure_kind: ReportFailureKind,
    expected: string@View,
    observed: string@View,
    message: string@View
) -> OutputEvent {
    let event: OutputEvent = eventBase(
        ReportEventKind::Failure,
        ReportSeverity::Error,
        phase,
        subject_kind,
        subject_id,
        owner,
        ReportStatus::Failed,
        message
    )
    return eventWithExpectedObserved(
        OutputEvent {
            event_kind: event.event_kind,
            severity: event.severity,
            phase: event.phase,
            subject_kind: event.subject_kind,
            subject_id: event.subject_id,
            owner: event.owner,
            status: event.status,
            failure_kind: failure_kind,
            evidence_kind: event.evidence_kind,
            expected: event.expected,
            observed: event.observed,
            evidence_path: event.evidence_path,
            source_start: event.source_start,
            source_end: event.source_end,
            source_line: event.source_line,
            source_column: event.source_column,
            content_identity: event.content_identity,
            metric_kind: event.metric_kind,
            metric_value: event.metric_value,
            message: event.message
        },
        expected,
        observed
    )
}
