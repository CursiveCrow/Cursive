internal record SourceLine {
    internal start: i32
    internal end: i32
    internal break_width: i32
    internal line_number: i32
}

internal record MetadataValueSpan {
    internal present: bool
    internal start: i32
    internal end: i32
}

procedure markerStartText() -> string@View {
    return "<!-- CURSIVE-SPEC-UNIT"
}

procedure markerEndText() -> string@View {
    return "<!-- /CURSIVE-SPEC-UNIT -->"
}

procedure metadataCloseText() -> string@View {
    return "-->"
}

procedure absentMetadataValue(at: i32) -> MetadataValueSpan {
    return MetadataValueSpan { present: false, start: at, end: at }
}

procedure byteAtOrZero(slice: const [u8], index: i32, length: i32) -> u8 {
    if ((index < 0) || (index >= length)) {
        return 0
    }
    return slice[index as usize]
}

procedure isLineBreak(byte: u8) -> bool {
    return (byte == 10) || (byte == 13)
}

procedure isBlankBodyByte(byte: u8) -> bool {
    return (byte == 9) || (byte == 10) || (byte == 13) || (byte == 32)
}

procedure lineBreakWidthAt(slice: const [u8], index: i32, length: i32) -> i32 {
    let byte: u8 = byteAtOrZero(slice, index, length)
    if (byte == 13) {
        if (((index + 1) < length) && (byteAtOrZero(slice, index + 1, length) == 10)) {
            return 2
        }
        return 1
    }
    if (byte == 10) {
        return 1
    }
    return 0
}

procedure lineEndFrom(slice: const [u8], start: i32, length: i32) -> i32 {
    var index: i32 = start
    loop {
        if (index >= length) {
            break
        }
        if (isLineBreak(byteAtOrZero(slice, index, length)) == true) {
            break
        }
        index = index + 1
    }
    return index
}

procedure sourceLineAt(
    slice: const [u8],
    start: i32,
    length: i32,
    line_number: i32
) -> SourceLine {
    let end: i32 = lineEndFrom(slice, start, length)
    return SourceLine {
        start: start,
        end: end,
        break_width: lineBreakWidthAt(slice, end, length),
        line_number: line_number
    }
}

procedure hashStep(state: i32, byte: u8, index: i32) -> i32 {
    let state_part: i32 = state % 4093
    let index_part: i32 = index % 4093
    return ((state_part * 33) + (byte as i32) + index_part) % 4093
}

procedure hashBytes(slice: const [u8], start: i32, end: i32, length: i32) -> i32 {
    var index: i32 = start
    var state: i32 = 17
    loop {
        if (index >= end) {
            break
        }
        state = hashStep(state, byteAtOrZero(slice, index, length), index - start)
        index = index + 1
    }
    return state
}

procedure bodyHasContent(slice: const [u8], start: i32, end: i32, length: i32) -> bool {
    var index: i32 = start
    loop {
        if (index >= end) {
            break
        }
        if (isBlankBodyByte(byteAtOrZero(slice, index, length)) == false) {
            return true
        }
        index = index + 1
    }
    return false
}

procedure byteSpanEqualsText(
    slice: const [u8],
    start: i32,
    end: i32,
    text: string@View
) -> bool {
    let text_view: bytes@View = bytes::view_string(text)
    let text_length: i32 = bytes::length(text_view) as i32
    if ((end - start) != text_length) {
        return false
    }

    let text_slice: const [u8] = bytes::as_slice(text_view)
    var index: i32 = 0
    loop {
        if (index >= text_length) {
            break
        }
        if (byteAtOrZero(slice, start + index, end) != text_slice[index as usize]) {
            return false
        }
        index = index + 1
    }
    return true
}

procedure byteSpanEqualsSpan(
    slice: const [u8],
    left_start: i32,
    left_end: i32,
    right_start: i32,
    right_end: i32
) -> bool {
    if ((left_end - left_start) != (right_end - right_start)) {
        return false
    }
    var index: i32 = 0
    let length: i32 = left_end - left_start
    loop {
        if (index >= length) {
            break
        }
        if (byteAtOrZero(slice, left_start + index, left_end) !=
            byteAtOrZero(slice, right_start + index, right_end)) {
            return false
        }
        index = index + 1
    }
    return true
}

procedure lineEqualsText(
    slice: const [u8],
    line: SourceLine,
    text: string@View
) -> bool {
    return byteSpanEqualsText(slice, line.start, line.end, text)
}

procedure lineStartsWithText(
    slice: const [u8],
    line: SourceLine,
    text: string@View
) -> bool {
    let text_view: bytes@View = bytes::view_string(text)
    let text_length: i32 = bytes::length(text_view) as i32
    if ((line.end - line.start) < text_length) {
        return false
    }
    return byteSpanEqualsText(slice, line.start, line.start + text_length, text)
}

procedure metadataValueSpan(
    slice: const [u8],
    line: SourceLine,
    key: string@View
) -> MetadataValueSpan {
    let key_view: bytes@View = bytes::view_string(key)
    let key_length: i32 = bytes::length(key_view) as i32
    let key_slice: const [u8] = bytes::as_slice(key_view)
    if ((line.end - line.start) <= key_length) {
        return absentMetadataValue(line.end)
    }

    var key_index: i32 = 0
    loop {
        if (key_index >= key_length) {
            break
        }
        if (byteAtOrZero(slice, line.start + key_index, line.end) !=
            key_slice[key_index as usize]) {
            return absentMetadataValue(line.end)
        }
        key_index = key_index + 1
    }
    if (byteAtOrZero(slice, line.start + key_length, line.end) != 58) {
        return absentMetadataValue(line.end)
    }

    var value_start: i32 = line.start + key_length + 1
    loop {
        if (value_start >= line.end) {
            break
        }
        if (byteAtOrZero(slice, value_start, line.end) != 32) {
            break
        }
        value_start = value_start + 1
    }
    return MetadataValueSpan {
        present: true,
        start: value_start,
        end: line.end
    }
}

procedure metadataLineHasKey(slice: const [u8], line: SourceLine, key: string@View) -> bool {
    return metadataValueSpan(slice, line, key).present
}

procedure metadataValueEqualsText(
    slice: const [u8],
    line: SourceLine,
    key: string@View,
    value: string@View
) -> bool {
    let value_span: MetadataValueSpan = metadataValueSpan(slice, line, key)
    if (value_span.present == false) {
        return false
    }
    return byteSpanEqualsText(slice, value_span.start, value_span.end, value)
}

procedure kindFromMetadataLine(slice: const [u8], line: SourceLine) -> SpecUnitKind {
    if (metadataValueEqualsText(slice, line, "kind", "grammar") == true) {
        return SpecUnitKind::Grammar
    }
    if (metadataValueEqualsText(slice, line, "kind", "grammar-requirement") == true) {
        return SpecUnitKind::GrammarRequirement
    }
    if (metadataValueEqualsText(slice, line, "kind", "formal-rule") == true) {
        return SpecUnitKind::FormalRule
    }
    if (metadataValueEqualsText(slice, line, "kind", "formal-definition") == true) {
        return SpecUnitKind::FormalDefinition
    }
    if (metadataValueEqualsText(slice, line, "kind", "diagnostic-table") == true) {
        return SpecUnitKind::DiagnosticTable
    }
    if (metadataValueEqualsText(slice, line, "kind", "diagnostic-requirement") == true) {
        return SpecUnitKind::DiagnosticRequirement
    }
    if (metadataValueEqualsText(slice, line, "kind", "diagnostics") == true) {
        return SpecUnitKind::Diagnostics
    }
    if (metadataValueEqualsText(slice, line, "kind", "semantic-requirement") == true) {
        return SpecUnitKind::SemanticRequirement
    }
    if (metadataValueEqualsText(slice, line, "kind", "syntax-requirement") == true) {
        return SpecUnitKind::SyntaxRequirement
    }
    if (metadataValueEqualsText(slice, line, "kind", "dynamic-semantics") == true) {
        return SpecUnitKind::DynamicSemantics
    }
    if (metadataValueEqualsText(slice, line, "kind", "normative-requirement") == true) {
        return SpecUnitKind::NormativeRequirement
    }
    if (metadataValueEqualsText(slice, line, "kind", "lowering-rule") == true) {
        return SpecUnitKind::LoweringRule
    }
    if (metadataValueEqualsText(slice, line, "kind", "lowering-requirement") == true) {
        return SpecUnitKind::LoweringRequirement
    }
    if (metadataValueEqualsText(slice, line, "kind", "conformance-statement") == true) {
        return SpecUnitKind::ConformanceStatement
    }
    if (metadataValueEqualsText(slice, line, "kind", "metatheoretic-property") == true) {
        return SpecUnitKind::MetatheoreticProperty
    }
    if (metadataValueEqualsText(slice, line, "kind", "informative") == true) {
        return SpecUnitKind::Informative
    }
    if (metadataValueEqualsText(slice, line, "kind", "informative-note") == true) {
        return SpecUnitKind::InformativeNote
    }
    return SpecUnitKind::Unknown
}

procedure strengthFromMetadataLine(slice: const [u8], line: SourceLine) -> SpecUnitStrength {
    if (metadataValueEqualsText(slice, line, "strength", "required") == true) {
        return SpecUnitStrength::Required
    }
    if (metadataValueEqualsText(slice, line, "strength", "normative") == true) {
        return SpecUnitStrength::Normative
    }
    if (metadataValueEqualsText(slice, line, "strength", "recommended") == true) {
        return SpecUnitStrength::Recommended
    }
    if (metadataValueEqualsText(slice, line, "strength", "advisory") == true) {
        return SpecUnitStrength::Advisory
    }
    if (metadataValueEqualsText(slice, line, "strength", "permitted") == true) {
        return SpecUnitStrength::Permitted
    }
    if (metadataValueEqualsText(slice, line, "strength", "allowed") == true) {
        return SpecUnitStrength::Allowed
    }
    if (metadataValueEqualsText(slice, line, "strength", "optional") == true) {
        return SpecUnitStrength::Optional
    }
    if (metadataValueEqualsText(slice, line, "strength", "informative") == true) {
        return SpecUnitStrength::Informative
    }
    return SpecUnitStrength::Unknown
}

procedure kindIsUnknown(kind: SpecUnitKind) -> bool {
    return if kind is {
        SpecUnitKind::Unknown { true }
        _ { false }
    }
}

procedure strengthIsUnknown(strength: SpecUnitStrength) -> bool {
    return if strength is {
        SpecUnitStrength::Unknown { true }
        _ { false }
    }
}

public procedure renderSpecUnitKind(kind: SpecUnitKind) -> string@View {
    return if kind is {
        SpecUnitKind::Unknown { "unknown" }
        SpecUnitKind::Grammar { "grammar" }
        SpecUnitKind::GrammarRequirement { "grammar-requirement" }
        SpecUnitKind::FormalRule { "formal-rule" }
        SpecUnitKind::FormalDefinition { "formal-definition" }
        SpecUnitKind::DiagnosticTable { "diagnostic-table" }
        SpecUnitKind::DiagnosticRequirement { "diagnostic-requirement" }
        SpecUnitKind::Diagnostics { "diagnostics" }
        SpecUnitKind::SemanticRequirement { "semantic-requirement" }
        SpecUnitKind::SyntaxRequirement { "syntax-requirement" }
        SpecUnitKind::DynamicSemantics { "dynamic-semantics" }
        SpecUnitKind::NormativeRequirement { "normative-requirement" }
        SpecUnitKind::LoweringRule { "lowering-rule" }
        SpecUnitKind::LoweringRequirement { "lowering-requirement" }
        SpecUnitKind::ConformanceStatement { "conformance-statement" }
        SpecUnitKind::MetatheoreticProperty { "metatheoretic-property" }
        SpecUnitKind::Informative { "informative" }
        SpecUnitKind::InformativeNote { "informative-note" }
    }
}

public procedure renderSpecUnitStrength(strength: SpecUnitStrength) -> string@View {
    return if strength is {
        SpecUnitStrength::Unknown { "unknown" }
        SpecUnitStrength::Required { "required" }
        SpecUnitStrength::Normative { "normative" }
        SpecUnitStrength::Recommended { "recommended" }
        SpecUnitStrength::Advisory { "advisory" }
        SpecUnitStrength::Permitted { "permitted" }
        SpecUnitStrength::Allowed { "allowed" }
        SpecUnitStrength::Optional { "optional" }
        SpecUnitStrength::Informative { "informative" }
    }
}

procedure boolMissing(value: bool) -> i32 {
    if (value == true) {
        return 0
    }
    return 1
}

procedure requiredMetadataMissingCount(
    has_id: bool,
    has_kind: bool,
    has_phase: bool,
    has_strength: bool,
    has_owner: bool,
    has_applies_to: bool,
    has_summary: bool,
    has_metadata_close: bool
) -> i32 {
    return boolMissing(has_id) +
        boolMissing(has_kind) +
        boolMissing(has_phase) +
        boolMissing(has_strength) +
        boolMissing(has_owner) +
        boolMissing(has_applies_to) +
        boolMissing(has_summary) +
        boolMissing(has_metadata_close)
}

procedure kindDefectCount(has_kind: bool, kind: SpecUnitKind) -> i32 {
    if ((has_kind == true) && (kindIsUnknown(kind) == true)) {
        return 1
    }
    return 0
}

procedure strengthDefectCount(has_strength: bool, strength: SpecUnitStrength) -> i32 {
    if ((has_strength == true) && (strengthIsUnknown(strength) == true)) {
        return 1
    }
    return 0
}

procedure bodyDefectCount(has_body_content: bool) -> i32 {
    if (has_body_content == true) {
        return 0
    }
    return 1
}

procedure specIdLedgerInitialByteCapacity(spec_byte_length: i32) -> usize {
    if (spec_byte_length <= 0) {
        return 1usize
    }
    return spec_byte_length as usize
}

public procedure specUnitLedgerPath() -> string@View {
    return "CursiveOracle/build/main/spec-units/parsed-units.bin"
}

procedure ensureSpecUnitLedgerDirectory(fs: $FileSystem) -> bool {
    return if fs~>ensure_dir("CursiveOracle/build") is {
        _: () { true }
        _: IoError { false }
    } && if fs~>ensure_dir("CursiveOracle/build/main") is {
        _: () { true }
        _: IoError { false }
    } && if fs~>ensure_dir("CursiveOracle/build/main/spec-units") is {
        _: () { true }
        _: IoError { false }
    }
}

procedure writeSpecUnitLedger(fs: $FileSystem, view: bytes@View) -> bool {
    if (ensureSpecUnitLedgerDirectory(fs) == false) {
        return false
    }
    return if fs~>write_file(specUnitLedgerPath(), view) is {
        _: () { true }
        _: IoError { false }
    }
}

procedure specUnitLedgerInitialByteCapacity(spec_byte_length: i32) -> usize {
    if (spec_byte_length <= 0) {
        return 1usize
    }
    return (spec_byte_length * 2) as usize
}

procedure specIdLedgerDelimiter() -> bytes@View {
    return bytes::view_string("\n")
}

procedure byteViewFromSpan(slice: const [u8], start: i32, end: i32) -> bytes@View {
    if (end <= start) {
        return bytes::view_string("")
    }

    let start_index: usize = start as usize
    let end_index: usize = end as usize
    let window: const [u8] = slice[start_index..end_index]
    return bytes::view(window)
}

procedure specUnitKindTag(kind: SpecUnitKind) -> i32 {
    return if kind is {
        SpecUnitKind::Unknown { 0 }
        SpecUnitKind::Grammar { 1 }
        SpecUnitKind::GrammarRequirement { 2 }
        SpecUnitKind::FormalRule { 3 }
        SpecUnitKind::FormalDefinition { 4 }
        SpecUnitKind::DiagnosticTable { 5 }
        SpecUnitKind::DiagnosticRequirement { 6 }
        SpecUnitKind::Diagnostics { 7 }
        SpecUnitKind::SemanticRequirement { 8 }
        SpecUnitKind::SyntaxRequirement { 9 }
        SpecUnitKind::DynamicSemantics { 10 }
        SpecUnitKind::NormativeRequirement { 11 }
        SpecUnitKind::LoweringRule { 12 }
        SpecUnitKind::LoweringRequirement { 13 }
        SpecUnitKind::ConformanceStatement { 14 }
        SpecUnitKind::MetatheoreticProperty { 15 }
        SpecUnitKind::Informative { 16 }
        SpecUnitKind::InformativeNote { 17 }
    }
}

procedure specUnitKindFromTag(tag: i32) -> SpecUnitKind {
    if (tag == 1) { return SpecUnitKind::Grammar }
    if (tag == 2) { return SpecUnitKind::GrammarRequirement }
    if (tag == 3) { return SpecUnitKind::FormalRule }
    if (tag == 4) { return SpecUnitKind::FormalDefinition }
    if (tag == 5) { return SpecUnitKind::DiagnosticTable }
    if (tag == 6) { return SpecUnitKind::DiagnosticRequirement }
    if (tag == 7) { return SpecUnitKind::Diagnostics }
    if (tag == 8) { return SpecUnitKind::SemanticRequirement }
    if (tag == 9) { return SpecUnitKind::SyntaxRequirement }
    if (tag == 10) { return SpecUnitKind::DynamicSemantics }
    if (tag == 11) { return SpecUnitKind::NormativeRequirement }
    if (tag == 12) { return SpecUnitKind::LoweringRule }
    if (tag == 13) { return SpecUnitKind::LoweringRequirement }
    if (tag == 14) { return SpecUnitKind::ConformanceStatement }
    if (tag == 15) { return SpecUnitKind::MetatheoreticProperty }
    if (tag == 16) { return SpecUnitKind::Informative }
    if (tag == 17) { return SpecUnitKind::InformativeNote }
    return SpecUnitKind::Unknown
}

procedure specUnitStrengthTag(strength: SpecUnitStrength) -> i32 {
    return if strength is {
        SpecUnitStrength::Unknown { 0 }
        SpecUnitStrength::Required { 1 }
        SpecUnitStrength::Normative { 2 }
        SpecUnitStrength::Recommended { 3 }
        SpecUnitStrength::Advisory { 4 }
        SpecUnitStrength::Permitted { 5 }
        SpecUnitStrength::Allowed { 6 }
        SpecUnitStrength::Optional { 7 }
        SpecUnitStrength::Informative { 8 }
    }
}

procedure specUnitStrengthFromTag(tag: i32) -> SpecUnitStrength {
    if (tag == 1) { return SpecUnitStrength::Required }
    if (tag == 2) { return SpecUnitStrength::Normative }
    if (tag == 3) { return SpecUnitStrength::Recommended }
    if (tag == 4) { return SpecUnitStrength::Advisory }
    if (tag == 5) { return SpecUnitStrength::Permitted }
    if (tag == 6) { return SpecUnitStrength::Allowed }
    if (tag == 7) { return SpecUnitStrength::Optional }
    if (tag == 8) { return SpecUnitStrength::Informative }
    return SpecUnitStrength::Unknown
}

procedure boolLedgerFlag(value: bool) -> i32 {
    if (value == true) {
        return 1
    }
    return 0
}

procedure boolFromLedgerFlag(value: i32) -> bool {
    return value != 0
}

procedure appendLedgerText(ledger: unique bytes@Managed, text: string@View, heap: $HeapAllocator) -> bool {
    return if bytes::append(ledger, bytes::view_string(text), heap) is {
        _: () { true }
        _: AllocationError { false }
    }
}

procedure appendLedgerDigitText(
    ledger: unique bytes@Managed,
    digit: i32,
    heap: $HeapAllocator
) -> bool {
    if (digit == 0) { return appendLedgerText(ledger, "0", heap) }
    if (digit == 1) { return appendLedgerText(ledger, "1", heap) }
    if (digit == 2) { return appendLedgerText(ledger, "2", heap) }
    if (digit == 3) { return appendLedgerText(ledger, "3", heap) }
    if (digit == 4) { return appendLedgerText(ledger, "4", heap) }
    if (digit == 5) { return appendLedgerText(ledger, "5", heap) }
    if (digit == 6) { return appendLedgerText(ledger, "6", heap) }
    if (digit == 7) { return appendLedgerText(ledger, "7", heap) }
    if (digit == 8) { return appendLedgerText(ledger, "8", heap) }
    if (digit == 9) { return appendLedgerText(ledger, "9", heap) }
    return false
}

procedure appendLedgerUnsignedIntegerText(
    ledger: unique bytes@Managed,
    value: i32,
    heap: $HeapAllocator
) -> bool {
    if (value >= 10) {
        return appendLedgerUnsignedIntegerText(ledger, value / 10, heap) &&
            appendLedgerDigitText(ledger, value % 10, heap)
    }
    return appendLedgerDigitText(ledger, value, heap)
}

procedure appendLedgerIntegerText(
    ledger: unique bytes@Managed,
    value: i32,
    heap: $HeapAllocator
) -> bool {
    if (value < 0) {
        return appendLedgerText(ledger, "-", heap) &&
            appendLedgerUnsignedIntegerText(ledger, 0 - value, heap)
    }
    return appendLedgerUnsignedIntegerText(ledger, value, heap)
}

procedure appendLedgerSpanText(
    ledger: unique bytes@Managed,
    slice: const [u8],
    start: i32,
    end: i32,
    heap: $HeapAllocator
) -> bool {
    return if bytes::append(ledger, byteViewFromSpan(slice, start, end), heap) is {
        _: () { true }
        _: AllocationError { false }
    }
}

procedure appendSpecUnitRecordField(
    ledger: unique bytes@Managed,
    value: i32,
    heap: $HeapAllocator
) -> bool {
    return appendLedgerIntegerText(ledger, value, heap) &&
        appendLedgerText(ledger, "\t", heap)
}

procedure appendSpecUnitRecordSpan(
    ledger: unique bytes@Managed,
    slice: const [u8],
    start: i32,
    end: i32,
    heap: $HeapAllocator
) -> bool {
    return appendLedgerIntegerText(ledger, end - start, heap) &&
        appendLedgerText(ledger, ":", heap) &&
        appendLedgerSpanText(ledger, slice, start, end, heap) &&
        appendLedgerText(ledger, "\t", heap)
}

procedure appendSpecUnitRecordFinalSpan(
    ledger: unique bytes@Managed,
    slice: const [u8],
    start: i32,
    end: i32,
    heap: $HeapAllocator
) -> bool {
    return appendLedgerIntegerText(ledger, end - start, heap) &&
        appendLedgerText(ledger, ":", heap) &&
        appendLedgerSpanText(ledger, slice, start, end, heap) &&
        appendLedgerText(ledger, "\n", heap)
}

procedure appendSpecUnitRecord(
    ledger: unique bytes@Managed,
    slice: const [u8],
    unit: SpecParsedUnit,
    heap: $HeapAllocator
) -> bool {
    return appendSpecUnitRecordField(ledger, unit.ordinal, heap) &&
        appendSpecUnitRecordField(ledger, unit.source_start, heap) &&
        appendSpecUnitRecordField(ledger, unit.source_end, heap) &&
        appendSpecUnitRecordField(ledger, unit.metadata_start, heap) &&
        appendSpecUnitRecordField(ledger, unit.metadata_end, heap) &&
        appendSpecUnitRecordField(ledger, unit.body_start, heap) &&
        appendSpecUnitRecordField(ledger, unit.body_end, heap) &&
        appendSpecUnitRecordField(ledger, unit.source_line, heap) &&
        appendSpecUnitRecordField(ledger, unit.source_column, heap) &&
        appendSpecUnitRecordField(ledger, unit.content_identity, heap) &&
        appendSpecUnitRecordField(ledger, specUnitKindTag(unit.kind), heap) &&
        appendSpecUnitRecordField(ledger, specUnitStrengthTag(unit.strength), heap) &&
        appendSpecUnitRecordField(ledger, boolLedgerFlag(unit.has_id), heap) &&
        appendSpecUnitRecordField(ledger, boolLedgerFlag(unit.has_kind), heap) &&
        appendSpecUnitRecordField(ledger, boolLedgerFlag(unit.has_phase), heap) &&
        appendSpecUnitRecordField(ledger, boolLedgerFlag(unit.has_strength), heap) &&
        appendSpecUnitRecordField(ledger, boolLedgerFlag(unit.has_owner), heap) &&
        appendSpecUnitRecordField(ledger, boolLedgerFlag(unit.has_applies_to), heap) &&
        appendSpecUnitRecordField(ledger, boolLedgerFlag(unit.has_summary), heap) &&
        appendSpecUnitRecordField(ledger, boolLedgerFlag(unit.has_labels), heap) &&
        appendSpecUnitRecordField(ledger, boolLedgerFlag(unit.has_metadata_close), heap) &&
        appendSpecUnitRecordField(ledger, boolLedgerFlag(unit.has_body_content), heap) &&
        appendSpecUnitRecordField(ledger, boolLedgerFlag(unit.duplicate_id), heap) &&
        appendSpecUnitRecordField(ledger, unit.parse_defect_count, heap) &&
        appendSpecUnitRecordSpan(ledger, slice, unit.id_start, unit.id_end, heap) &&
        appendSpecUnitRecordSpan(ledger, slice, unit.phase_start, unit.phase_end, heap) &&
        appendSpecUnitRecordSpan(ledger, slice, unit.owner_start, unit.owner_end, heap) &&
        appendSpecUnitRecordSpan(ledger, slice, unit.applies_to_start, unit.applies_to_end, heap) &&
        appendSpecUnitRecordSpan(ledger, slice, unit.summary_start, unit.summary_end, heap) &&
        appendSpecUnitRecordFinalSpan(ledger, slice, unit.labels_start, unit.labels_end, heap)
}

procedure emptySpecUnitRecord() -> SpecUnitRecord {
    return SpecUnitRecord {
        ordinal: 0,
        source_start: 0,
        source_end: 0,
        metadata_start: 0,
        metadata_end: 0,
        body_start: 0,
        body_end: 0,
        source_line: 1,
        source_column: 1,
        content_identity: 0,
        kind: SpecUnitKind::Unknown,
        strength: SpecUnitStrength::Unknown,
        has_id: false,
        has_kind: false,
        has_phase: false,
        has_strength: false,
        has_owner: false,
        has_applies_to: false,
        has_summary: false,
        has_labels: false,
        has_metadata_close: false,
        has_body_content: false,
        duplicate_id: false,
        parse_defect_count: 1,
        id_text: bytes::view_string(""),
        phase_text: bytes::view_string(""),
        owner_text: bytes::view_string(""),
        applies_to_text: bytes::view_string(""),
        summary_text: bytes::view_string(""),
        labels_text: bytes::view_string("")
    }
}

procedure ledgerByteAt(slice: const [u8], index: i32, length: i32) -> u8 {
    if ((index < 0) || (index >= length)) {
        return 0
    }
    return slice[index as usize]
}

procedure ledgerDigitValue(byte: u8) -> i32 {
    if ((byte >= 48) && (byte <= 57)) {
        return (byte as i32) - 48
    }
    return -1
}

procedure readLedgerIntegerUntil(
    slice: const [u8],
    length: i32,
    offset: i32,
    terminator: u8
) -> LedgerIntegerRead {
    if (offset >= length) {
        return LedgerIntegerRead { valid: false, value: 0, next_offset: offset }
    }

    var index: i32 = offset
    var sign: i32 = 1
    if (ledgerByteAt(slice, index, length) == 45) {
        sign = -1
        index = index + 1
    }

    var value: i32 = 0
    var digit_count: i32 = 0
    loop {
        if (index >= length) {
            break
        }
        let byte: u8 = ledgerByteAt(slice, index, length)
        if (byte == terminator) {
            return LedgerIntegerRead {
                valid: digit_count > 0,
                value: value * sign,
                next_offset: index + 1
            }
        }
        let digit: i32 = ledgerDigitValue(byte)
        if (digit < 0) {
            return LedgerIntegerRead { valid: false, value: 0, next_offset: index }
        }
        value = (value * 10) + digit
        digit_count = digit_count + 1
        index = index + 1
    }
    return LedgerIntegerRead { valid: false, value: 0, next_offset: index }
}

procedure readLedgerField(
    slice: const [u8],
    length: i32,
    offset: i32
) -> LedgerIntegerRead {
    return readLedgerIntegerUntil(slice, length, offset, 9)
}

procedure readLedgerBytesField(
    slice: const [u8],
    length: i32,
    offset: i32,
    terminator: u8
) -> LedgerBytesRead {
    let size_read: LedgerIntegerRead = readLedgerIntegerUntil(slice, length, offset, 58)
    if (size_read.valid == false) {
        return LedgerBytesRead {
            valid: false,
            value: bytes::view_string(""),
            next_offset: size_read.next_offset
        }
    }
    if ((size_read.value < 0) || ((size_read.next_offset + size_read.value) > length)) {
        return LedgerBytesRead {
            valid: false,
            value: bytes::view_string(""),
            next_offset: size_read.next_offset
        }
    }

    let start_index: usize = size_read.next_offset as usize
    let end_index: usize = (size_read.next_offset + size_read.value) as usize
    let window: const [u8] = slice[start_index..end_index]
    let terminator_offset: i32 = size_read.next_offset + size_read.value
    if ((terminator_offset >= length) ||
        (ledgerByteAt(slice, terminator_offset, length) != terminator)) {
        return LedgerBytesRead {
            valid: false,
            value: bytes::view_string(""),
            next_offset: terminator_offset
        }
    }
    return LedgerBytesRead {
        valid: true,
        value: bytes::view(window),
        next_offset: terminator_offset + 1
    }
}

procedure readLedgerTextField(
    slice: const [u8],
    length: i32,
    offset: i32
) -> LedgerBytesRead {
    return readLedgerBytesField(slice, length, offset, 9)
}

procedure readLedgerFinalTextField(
    slice: const [u8],
    length: i32,
    offset: i32
) -> LedgerBytesRead {
    return readLedgerBytesField(slice, length, offset, 10)
}

public procedure readSpecUnitRecord(
    ledger: bytes@View,
    offset: i32
) -> SpecUnitRecordRead {
    let length: i32 = bytes::length(ledger) as i32
    if (offset >= length) {
        return SpecUnitRecordRead {
            state: SpecUnitRecordReadState::EndOfLedger,
            next_offset: offset,
            record: emptySpecUnitRecord()
        }
    }

    let slice: const [u8] = bytes::as_slice(ledger)
    let ordinal: LedgerIntegerRead = readLedgerField(slice, length, offset)
    let source_start: LedgerIntegerRead = readLedgerField(slice, length, ordinal.next_offset)
    let source_end: LedgerIntegerRead = readLedgerField(slice, length, source_start.next_offset)
    let metadata_start: LedgerIntegerRead = readLedgerField(slice, length, source_end.next_offset)
    let metadata_end: LedgerIntegerRead = readLedgerField(slice, length, metadata_start.next_offset)
    let body_start: LedgerIntegerRead = readLedgerField(slice, length, metadata_end.next_offset)
    let body_end: LedgerIntegerRead = readLedgerField(slice, length, body_start.next_offset)
    let source_line: LedgerIntegerRead = readLedgerField(slice, length, body_end.next_offset)
    let source_column: LedgerIntegerRead = readLedgerField(slice, length, source_line.next_offset)
    let content_identity: LedgerIntegerRead =
        readLedgerField(slice, length, source_column.next_offset)
    let kind_tag: LedgerIntegerRead = readLedgerField(slice, length, content_identity.next_offset)
    let strength_tag: LedgerIntegerRead = readLedgerField(slice, length, kind_tag.next_offset)
    let has_id: LedgerIntegerRead = readLedgerField(slice, length, strength_tag.next_offset)
    let has_kind: LedgerIntegerRead = readLedgerField(slice, length, has_id.next_offset)
    let has_phase: LedgerIntegerRead = readLedgerField(slice, length, has_kind.next_offset)
    let has_strength: LedgerIntegerRead = readLedgerField(slice, length, has_phase.next_offset)
    let has_owner: LedgerIntegerRead = readLedgerField(slice, length, has_strength.next_offset)
    let has_applies_to: LedgerIntegerRead = readLedgerField(slice, length, has_owner.next_offset)
    let has_summary: LedgerIntegerRead = readLedgerField(slice, length, has_applies_to.next_offset)
    let has_labels: LedgerIntegerRead = readLedgerField(slice, length, has_summary.next_offset)
    let has_metadata_close: LedgerIntegerRead = readLedgerField(slice, length, has_labels.next_offset)
    let has_body_content: LedgerIntegerRead =
        readLedgerField(slice, length, has_metadata_close.next_offset)
    let duplicate_id: LedgerIntegerRead =
        readLedgerField(slice, length, has_body_content.next_offset)
    let parse_defect_count: LedgerIntegerRead =
        readLedgerField(slice, length, duplicate_id.next_offset)
    let id_text: LedgerBytesRead = readLedgerTextField(slice, length, parse_defect_count.next_offset)
    let phase_text: LedgerBytesRead = readLedgerTextField(slice, length, id_text.next_offset)
    let owner_text: LedgerBytesRead = readLedgerTextField(slice, length, phase_text.next_offset)
    let applies_to_text: LedgerBytesRead =
        readLedgerTextField(slice, length, owner_text.next_offset)
    let summary_text: LedgerBytesRead =
        readLedgerTextField(slice, length, applies_to_text.next_offset)
    let labels_text: LedgerBytesRead =
        readLedgerFinalTextField(slice, length, summary_text.next_offset)

    let valid: bool = ordinal.valid &&
        source_start.valid &&
        source_end.valid &&
        metadata_start.valid &&
        metadata_end.valid &&
        body_start.valid &&
        body_end.valid &&
        source_line.valid &&
        source_column.valid &&
        content_identity.valid &&
        kind_tag.valid &&
        strength_tag.valid &&
        has_id.valid &&
        has_kind.valid &&
        has_phase.valid &&
        has_strength.valid &&
        has_owner.valid &&
        has_applies_to.valid &&
        has_summary.valid &&
        has_labels.valid &&
        has_metadata_close.valid &&
        has_body_content.valid &&
        duplicate_id.valid &&
        parse_defect_count.valid &&
        id_text.valid &&
        phase_text.valid &&
        owner_text.valid &&
        applies_to_text.valid &&
        summary_text.valid &&
        labels_text.valid
    if (valid == false) {
        return SpecUnitRecordRead {
            state: SpecUnitRecordReadState::Malformed,
            next_offset: labels_text.next_offset,
            record: emptySpecUnitRecord()
        }
    }

    return SpecUnitRecordRead {
        state: SpecUnitRecordReadState::Readable,
        next_offset: labels_text.next_offset,
        record: SpecUnitRecord {
            ordinal: ordinal.value,
            source_start: source_start.value,
            source_end: source_end.value,
            metadata_start: metadata_start.value,
            metadata_end: metadata_end.value,
            body_start: body_start.value,
            body_end: body_end.value,
            source_line: source_line.value,
            source_column: source_column.value,
            content_identity: content_identity.value,
            kind: specUnitKindFromTag(kind_tag.value),
            strength: specUnitStrengthFromTag(strength_tag.value),
            has_id: boolFromLedgerFlag(has_id.value),
            has_kind: boolFromLedgerFlag(has_kind.value),
            has_phase: boolFromLedgerFlag(has_phase.value),
            has_strength: boolFromLedgerFlag(has_strength.value),
            has_owner: boolFromLedgerFlag(has_owner.value),
            has_applies_to: boolFromLedgerFlag(has_applies_to.value),
            has_summary: boolFromLedgerFlag(has_summary.value),
            has_labels: boolFromLedgerFlag(has_labels.value),
            has_metadata_close: boolFromLedgerFlag(has_metadata_close.value),
            has_body_content: boolFromLedgerFlag(has_body_content.value),
            duplicate_id: boolFromLedgerFlag(duplicate_id.value),
            parse_defect_count: parse_defect_count.value,
            id_text: id_text.value,
            phase_text: phase_text.value,
            owner_text: owner_text.value,
            applies_to_text: applies_to_text.value,
            summary_text: summary_text.value,
            labels_text: labels_text.value
        }
    }
}

procedure specIdLedgerEntryEquals(
    ledger_slice: const [u8],
    ledger_length: i32,
    entry_start: i32,
    entry_end: i32,
    spec_slice: const [u8],
    spec_length: i32,
    id_start: i32,
    id_end: i32
) -> bool {
    if ((entry_end - entry_start) != (id_end - id_start)) {
        return false
    }

    var index: i32 = 0
    let id_length: i32 = id_end - id_start
    loop {
        if (index >= id_length) {
            break
        }
        if (byteAtOrZero(ledger_slice, entry_start + index, ledger_length) !=
            byteAtOrZero(spec_slice, id_start + index, spec_length)) {
            return false
        }
        index = index + 1
    }
    return true
}

procedure specIdLedgerContains(
    ledger_view: bytes@View,
    spec_slice: const [u8],
    spec_length: i32,
    id_start: i32,
    id_end: i32
) -> bool {
    if (id_end <= id_start) {
        return false
    }

    let ledger_length: i32 = bytes::length(ledger_view) as i32
    let ledger_slice: const [u8] = bytes::as_slice(ledger_view)
    var entry_start: i32 = 0
    var index: i32 = 0
    loop {
        if (index >= ledger_length) {
            if (index > entry_start) {
                return specIdLedgerEntryEquals(
                    ledger_slice,
                    ledger_length,
                    entry_start,
                    index,
                    spec_slice,
                    spec_length,
                    id_start,
                    id_end
                )
            }
            break
        }

        if (byteAtOrZero(ledger_slice, index, ledger_length) == 10) {
            if (specIdLedgerEntryEquals(
                ledger_slice,
                ledger_length,
                entry_start,
                index,
                spec_slice,
                spec_length,
                id_start,
                id_end
            ) == true) {
                return true
            }
            entry_start = index + 1
        }
        index = index + 1
    }
    return false
}

procedure appendSpecIdToLedger(
    ledger: unique bytes@Managed,
    spec_slice: const [u8],
    id_start: i32,
    id_end: i32,
    heap: $HeapAllocator
) -> bool {
    if (id_end <= id_start) {
        return false
    }

    let id_view: bytes@View = byteViewFromSpan(spec_slice, id_start, id_end)
    let id_append: () | AllocationError = bytes::append(ledger, id_view, heap)
    if id_append is {
        _: () {
            let delimiter_append: () | AllocationError =
                bytes::append(ledger, specIdLedgerDelimiter(), heap)
            return if delimiter_append is {
                _: () { true }
                _: AllocationError { false }
            }
        }
        _: AllocationError {
            return false
        }
    }
    return false
}

procedure parsedUnitFromState(
    slice: const [u8],
    length: i32,
    ordinal: i32,
    unit_start: i32,
    unit_end: i32,
    metadata_start: i32,
    metadata_end: i32,
    body_start: i32,
    body_end: i32,
    source_line: i32,
    id_span: MetadataValueSpan,
    kind: SpecUnitKind,
    strength: SpecUnitStrength,
    phase_span: MetadataValueSpan,
    owner_span: MetadataValueSpan,
    applies_to_span: MetadataValueSpan,
    summary_span: MetadataValueSpan,
    labels_span: MetadataValueSpan,
    has_kind: bool,
    has_strength: bool,
    has_metadata_close: bool,
    duplicate_id: bool
) -> SpecParsedUnit {
    let has_body_content: bool = bodyHasContent(slice, body_start, body_end, length)
    let missing_count: i32 = requiredMetadataMissingCount(
        id_span.present,
        has_kind,
        phase_span.present,
        has_strength,
        owner_span.present,
        applies_to_span.present,
        summary_span.present,
        has_metadata_close
    )
    let defect_count: i32 = missing_count +
        kindDefectCount(has_kind, kind) +
        strengthDefectCount(has_strength, strength) +
        bodyDefectCount(has_body_content)

    return SpecParsedUnit {
        ordinal: ordinal,
        source_start: unit_start,
        source_end: unit_end,
        metadata_start: metadata_start,
        metadata_end: metadata_end,
        body_start: body_start,
        body_end: body_end,
        source_line: source_line,
        source_column: 1,
        content_identity: hashBytes(slice, unit_start, unit_end, length),
        id_start: id_span.start,
        id_end: id_span.end,
        kind: kind,
        strength: strength,
        phase_start: phase_span.start,
        phase_end: phase_span.end,
        owner_start: owner_span.start,
        owner_end: owner_span.end,
        applies_to_start: applies_to_span.start,
        applies_to_end: applies_to_span.end,
        summary_start: summary_span.start,
        summary_end: summary_span.end,
        labels_start: labels_span.start,
        labels_end: labels_span.end,
        has_id: id_span.present,
        has_kind: has_kind,
        has_phase: phase_span.present,
        has_strength: has_strength,
        has_owner: owner_span.present,
        has_applies_to: applies_to_span.present,
        has_summary: summary_span.present,
        has_labels: labels_span.present,
        has_metadata_close: has_metadata_close,
        has_body_content: has_body_content,
        duplicate_id: duplicate_id,
        parse_defect_count: defect_count
    }
}

procedure specUnitSummaryEmpty() -> SpecUnitSummary {
    return SpecUnitSummary {
        unit_count: 0,
        parse_error_count: 0,
        duplicate_id_count: 0,
        empty_body_count: 0,
        missing_metadata_count: 0,
        grammar_count: 0,
        grammar_requirement_count: 0,
        formal_rule_count: 0,
        formal_definition_count: 0,
        diagnostic_table_count: 0,
        diagnostic_requirement_count: 0,
        diagnostics_count: 0,
        semantic_requirement_count: 0,
        syntax_requirement_count: 0,
        dynamic_semantics_count: 0,
        normative_requirement_count: 0,
        lowering_rule_count: 0,
        lowering_requirement_count: 0,
        conformance_statement_count: 0,
        metatheoretic_property_count: 0,
        informative_count: 0,
        informative_note_count: 0,
        unknown_kind_count: 0,
        required_count: 0,
        normative_strength_count: 0,
        recommended_count: 0,
        advisory_count: 0,
        permitted_count: 0,
        allowed_count: 0,
        optional_count: 0,
        informative_strength_count: 0,
        unknown_strength_count: 0,
        primary_unit_start: 0,
        primary_unit_end: 0,
        primary_unit_line: 1,
        primary_unit_column: 1,
        primary_unit_identity: 0,
        primary_kind: SpecUnitKind::Unknown,
        primary_strength: SpecUnitStrength::Unknown
    }
}

procedure unitSummaryWithUnit(summary: SpecUnitSummary, unit: SpecParsedUnit) -> SpecUnitSummary {
    let new_unit_count: i32 = summary.unit_count + 1
    let new_parse_error_count: i32 = summary.parse_error_count + unit.parse_defect_count
    let new_duplicate_id_count: i32 = if unit.duplicate_id == true {
        summary.duplicate_id_count + 1
    } else {
        summary.duplicate_id_count
    }
    let new_empty_body_count: i32 = if unit.has_body_content == true {
        summary.empty_body_count
    } else {
        summary.empty_body_count + 1
    }
    let new_missing_metadata_count: i32 = summary.missing_metadata_count +
        requiredMetadataMissingCount(
            unit.has_id,
            unit.has_kind,
            unit.has_phase,
            unit.has_strength,
            unit.has_owner,
            unit.has_applies_to,
            unit.has_summary,
            unit.has_metadata_close
        )
    let primary_start: i32 = if summary.unit_count == 0 {
        unit.source_start
    } else {
        summary.primary_unit_start
    }
    let primary_end: i32 = if summary.unit_count == 0 {
        unit.source_end
    } else {
        summary.primary_unit_end
    }
    let primary_line: i32 = if summary.unit_count == 0 {
        unit.source_line
    } else {
        summary.primary_unit_line
    }
    let primary_column: i32 = if summary.unit_count == 0 {
        unit.source_column
    } else {
        summary.primary_unit_column
    }
    let primary_identity: i32 = if summary.unit_count == 0 {
        unit.content_identity
    } else {
        summary.primary_unit_identity
    }
    let primary_kind: SpecUnitKind = if summary.unit_count == 0 {
        unit.kind
    } else {
        summary.primary_kind
    }
    let primary_strength: SpecUnitStrength = if summary.unit_count == 0 {
        unit.strength
    } else {
        summary.primary_strength
    }

    let grammar_count: i32 = if unit.kind is {
        SpecUnitKind::Grammar { summary.grammar_count + 1 }
        _ { summary.grammar_count }
    }
    let grammar_requirement_count: i32 = if unit.kind is {
        SpecUnitKind::GrammarRequirement { summary.grammar_requirement_count + 1 }
        _ { summary.grammar_requirement_count }
    }
    let formal_rule_count: i32 = if unit.kind is {
        SpecUnitKind::FormalRule { summary.formal_rule_count + 1 }
        _ { summary.formal_rule_count }
    }
    let formal_definition_count: i32 = if unit.kind is {
        SpecUnitKind::FormalDefinition { summary.formal_definition_count + 1 }
        _ { summary.formal_definition_count }
    }
    let diagnostic_table_count: i32 = if unit.kind is {
        SpecUnitKind::DiagnosticTable { summary.diagnostic_table_count + 1 }
        _ { summary.diagnostic_table_count }
    }
    let diagnostic_requirement_count: i32 = if unit.kind is {
        SpecUnitKind::DiagnosticRequirement { summary.diagnostic_requirement_count + 1 }
        _ { summary.diagnostic_requirement_count }
    }
    let diagnostics_count: i32 = if unit.kind is {
        SpecUnitKind::Diagnostics { summary.diagnostics_count + 1 }
        _ { summary.diagnostics_count }
    }
    let semantic_requirement_count: i32 = if unit.kind is {
        SpecUnitKind::SemanticRequirement { summary.semantic_requirement_count + 1 }
        _ { summary.semantic_requirement_count }
    }
    let syntax_requirement_count: i32 = if unit.kind is {
        SpecUnitKind::SyntaxRequirement { summary.syntax_requirement_count + 1 }
        _ { summary.syntax_requirement_count }
    }
    let dynamic_semantics_count: i32 = if unit.kind is {
        SpecUnitKind::DynamicSemantics { summary.dynamic_semantics_count + 1 }
        _ { summary.dynamic_semantics_count }
    }
    let normative_requirement_count: i32 = if unit.kind is {
        SpecUnitKind::NormativeRequirement { summary.normative_requirement_count + 1 }
        _ { summary.normative_requirement_count }
    }
    let lowering_rule_count: i32 = if unit.kind is {
        SpecUnitKind::LoweringRule { summary.lowering_rule_count + 1 }
        _ { summary.lowering_rule_count }
    }
    let lowering_requirement_count: i32 = if unit.kind is {
        SpecUnitKind::LoweringRequirement { summary.lowering_requirement_count + 1 }
        _ { summary.lowering_requirement_count }
    }
    let conformance_statement_count: i32 = if unit.kind is {
        SpecUnitKind::ConformanceStatement { summary.conformance_statement_count + 1 }
        _ { summary.conformance_statement_count }
    }
    let metatheoretic_property_count: i32 = if unit.kind is {
        SpecUnitKind::MetatheoreticProperty { summary.metatheoretic_property_count + 1 }
        _ { summary.metatheoretic_property_count }
    }
    let informative_count: i32 = if unit.kind is {
        SpecUnitKind::Informative { summary.informative_count + 1 }
        _ { summary.informative_count }
    }
    let informative_note_count: i32 = if unit.kind is {
        SpecUnitKind::InformativeNote { summary.informative_note_count + 1 }
        _ { summary.informative_note_count }
    }
    let unknown_kind_count: i32 = if unit.kind is {
        SpecUnitKind::Unknown { summary.unknown_kind_count + 1 }
        _ { summary.unknown_kind_count }
    }
    let required_count: i32 = if unit.strength is {
        SpecUnitStrength::Required { summary.required_count + 1 }
        _ { summary.required_count }
    }
    let normative_strength_count: i32 = if unit.strength is {
        SpecUnitStrength::Normative { summary.normative_strength_count + 1 }
        _ { summary.normative_strength_count }
    }
    let recommended_count: i32 = if unit.strength is {
        SpecUnitStrength::Recommended { summary.recommended_count + 1 }
        _ { summary.recommended_count }
    }
    let advisory_count: i32 = if unit.strength is {
        SpecUnitStrength::Advisory { summary.advisory_count + 1 }
        _ { summary.advisory_count }
    }
    let permitted_count: i32 = if unit.strength is {
        SpecUnitStrength::Permitted { summary.permitted_count + 1 }
        _ { summary.permitted_count }
    }
    let allowed_count: i32 = if unit.strength is {
        SpecUnitStrength::Allowed { summary.allowed_count + 1 }
        _ { summary.allowed_count }
    }
    let optional_count: i32 = if unit.strength is {
        SpecUnitStrength::Optional { summary.optional_count + 1 }
        _ { summary.optional_count }
    }
    let informative_strength_count: i32 = if unit.strength is {
        SpecUnitStrength::Informative { summary.informative_strength_count + 1 }
        _ { summary.informative_strength_count }
    }
    let unknown_strength_count: i32 = if unit.strength is {
        SpecUnitStrength::Unknown { summary.unknown_strength_count + 1 }
        _ { summary.unknown_strength_count }
    }

    return SpecUnitSummary {
        unit_count: new_unit_count,
        parse_error_count: new_parse_error_count,
        duplicate_id_count: new_duplicate_id_count,
        empty_body_count: new_empty_body_count,
        missing_metadata_count: new_missing_metadata_count,
        grammar_count: grammar_count,
        grammar_requirement_count: grammar_requirement_count,
        formal_rule_count: formal_rule_count,
        formal_definition_count: formal_definition_count,
        diagnostic_table_count: diagnostic_table_count,
        diagnostic_requirement_count: diagnostic_requirement_count,
        diagnostics_count: diagnostics_count,
        semantic_requirement_count: semantic_requirement_count,
        syntax_requirement_count: syntax_requirement_count,
        dynamic_semantics_count: dynamic_semantics_count,
        normative_requirement_count: normative_requirement_count,
        lowering_rule_count: lowering_rule_count,
        lowering_requirement_count: lowering_requirement_count,
        conformance_statement_count: conformance_statement_count,
        metatheoretic_property_count: metatheoretic_property_count,
        informative_count: informative_count,
        informative_note_count: informative_note_count,
        unknown_kind_count: unknown_kind_count,
        required_count: required_count,
        normative_strength_count: normative_strength_count,
        recommended_count: recommended_count,
        advisory_count: advisory_count,
        permitted_count: permitted_count,
        allowed_count: allowed_count,
        optional_count: optional_count,
        informative_strength_count: informative_strength_count,
        unknown_strength_count: unknown_strength_count,
        primary_unit_start: primary_start,
        primary_unit_end: primary_end,
        primary_unit_line: primary_line,
        primary_unit_column: primary_column,
        primary_unit_identity: primary_identity,
        primary_kind: primary_kind,
        primary_strength: primary_strength
    }
}

procedure scanSpecStructure(
    view: bytes@View,
    utf8_valid: bool,
    ledger: unique bytes@Managed,
    unit_ledger: unique bytes@Managed,
    heap: $HeapAllocator
) -> SpecSourceScan {
    let length: i32 = bytes::length(view) as i32
    let slice: const [u8] = bytes::as_slice(view)
    var index: i32 = 0
    var line_number: i32 = 1
    var section_count: i32 = 0
    var storage_failure_count: i32 = 0
    var summary: SpecUnitSummary = specUnitSummaryEmpty()
    var inside_unit: bool = false
    var inside_metadata: bool = false
    var unit_start: i32 = 0
    var unit_line: i32 = 1
    var metadata_start: i32 = 0
    var metadata_end: i32 = 0
    var body_start: i32 = 0
    var unit_kind: SpecUnitKind = SpecUnitKind::Unknown
    var unit_strength: SpecUnitStrength = SpecUnitStrength::Unknown
    var id_span: MetadataValueSpan = absentMetadataValue(0)
    var phase_span: MetadataValueSpan = absentMetadataValue(0)
    var owner_span: MetadataValueSpan = absentMetadataValue(0)
    var applies_to_span: MetadataValueSpan = absentMetadataValue(0)
    var summary_span: MetadataValueSpan = absentMetadataValue(0)
    var labels_span: MetadataValueSpan = absentMetadataValue(0)
    var has_kind: bool = false
    var has_strength: bool = false
    var has_metadata_close: bool = false

    loop {
        if (index >= length) {
            break
        }

        let line: SourceLine = sourceLineAt(slice, index, length, line_number)
        if (lineStartsWithText(slice, line, "#") == true) {
            section_count = section_count + 1
        }

        if (lineEqualsText(slice, line, markerStartText()) == true) {
            if (inside_unit == true) {
                summary = SpecUnitSummary {
                    unit_count: summary.unit_count,
                    parse_error_count: summary.parse_error_count + 1,
                    duplicate_id_count: summary.duplicate_id_count,
                    empty_body_count: summary.empty_body_count,
                    missing_metadata_count: summary.missing_metadata_count,
                    grammar_count: summary.grammar_count,
                    grammar_requirement_count: summary.grammar_requirement_count,
                    formal_rule_count: summary.formal_rule_count,
                    formal_definition_count: summary.formal_definition_count,
                    diagnostic_table_count: summary.diagnostic_table_count,
                    diagnostic_requirement_count: summary.diagnostic_requirement_count,
                    diagnostics_count: summary.diagnostics_count,
                    semantic_requirement_count: summary.semantic_requirement_count,
                    syntax_requirement_count: summary.syntax_requirement_count,
                    dynamic_semantics_count: summary.dynamic_semantics_count,
                    normative_requirement_count: summary.normative_requirement_count,
                    lowering_rule_count: summary.lowering_rule_count,
                    lowering_requirement_count: summary.lowering_requirement_count,
                    conformance_statement_count: summary.conformance_statement_count,
                    metatheoretic_property_count: summary.metatheoretic_property_count,
                    informative_count: summary.informative_count,
                    informative_note_count: summary.informative_note_count,
                    unknown_kind_count: summary.unknown_kind_count,
                    required_count: summary.required_count,
                    normative_strength_count: summary.normative_strength_count,
                    recommended_count: summary.recommended_count,
                    advisory_count: summary.advisory_count,
                    permitted_count: summary.permitted_count,
                    allowed_count: summary.allowed_count,
                    optional_count: summary.optional_count,
                    informative_strength_count: summary.informative_strength_count,
                    unknown_strength_count: summary.unknown_strength_count,
                    primary_unit_start: summary.primary_unit_start,
                    primary_unit_end: summary.primary_unit_end,
                    primary_unit_line: summary.primary_unit_line,
                    primary_unit_column: summary.primary_unit_column,
                    primary_unit_identity: summary.primary_unit_identity,
                    primary_kind: summary.primary_kind,
                    primary_strength: summary.primary_strength
                }
            }
            inside_unit = true
            inside_metadata = true
            unit_start = line.start
            unit_line = line.line_number
            metadata_start = line.start
            metadata_end = line.end
            body_start = line.end
            unit_kind = SpecUnitKind::Unknown
            unit_strength = SpecUnitStrength::Unknown
            id_span = absentMetadataValue(line.end)
            phase_span = absentMetadataValue(line.end)
            owner_span = absentMetadataValue(line.end)
            applies_to_span = absentMetadataValue(line.end)
            summary_span = absentMetadataValue(line.end)
            labels_span = absentMetadataValue(line.end)
            has_kind = false
            has_strength = false
            has_metadata_close = false
        } else if ((inside_unit == true) && (inside_metadata == true)) {
            if (lineEqualsText(slice, line, metadataCloseText()) == true) {
                inside_metadata = false
                has_metadata_close = true
                metadata_end = line.end
                body_start = line.end + line.break_width
            } else {
                let id_value: MetadataValueSpan = metadataValueSpan(slice, line, "id")
                if (id_value.present == true) {
                    id_span = id_value
                }
                let phase_value: MetadataValueSpan = metadataValueSpan(slice, line, "phase")
                if (phase_value.present == true) {
                    phase_span = phase_value
                }
                let owner_value: MetadataValueSpan = metadataValueSpan(slice, line, "owner")
                if (owner_value.present == true) {
                    owner_span = owner_value
                }
                let applies_to_value: MetadataValueSpan =
                    metadataValueSpan(slice, line, "applies-to")
                if (applies_to_value.present == true) {
                    applies_to_span = applies_to_value
                }
                let summary_value: MetadataValueSpan = metadataValueSpan(slice, line, "summary")
                if (summary_value.present == true) {
                    summary_span = summary_value
                }
                let labels_value: MetadataValueSpan = metadataValueSpan(slice, line, "labels")
                if (labels_value.present == true) {
                    labels_span = labels_value
                }
                if (metadataLineHasKey(slice, line, "kind") == true) {
                    has_kind = true
                    unit_kind = kindFromMetadataLine(slice, line)
                }
                if (metadataLineHasKey(slice, line, "strength") == true) {
                    has_strength = true
                    unit_strength = strengthFromMetadataLine(slice, line)
                }
            }
        } else if ((inside_unit == true) && (lineEqualsText(slice, line, markerEndText()) == true)) {
            let duplicate_id: bool = if id_span.present == true {
                specIdLedgerContains(
                    bytes::as_view(ledger),
                    slice,
                    length,
                    id_span.start,
                    id_span.end
                )
            } else {
                false
            }
            if (id_span.present == true) {
                if (appendSpecIdToLedger(
                    ledger,
                    slice,
                    id_span.start,
                    id_span.end,
                    heap
                ) == false) {
                    storage_failure_count = storage_failure_count + 1
                }
            }

            let unit: SpecParsedUnit = parsedUnitFromState(
                slice,
                length,
                summary.unit_count + 1,
                unit_start,
                line.end,
                metadata_start,
                metadata_end,
                body_start,
                line.start,
                unit_line,
                id_span,
                unit_kind,
                unit_strength,
                phase_span,
                owner_span,
                applies_to_span,
                summary_span,
                labels_span,
                has_kind,
                has_strength,
                has_metadata_close,
                duplicate_id
            )
            if (appendSpecUnitRecord(unit_ledger, slice, unit, heap) == false) {
                storage_failure_count = storage_failure_count + 1
            }
            summary = unitSummaryWithUnit(summary, unit)
            inside_unit = false
            inside_metadata = false
        } else if (lineEqualsText(slice, line, markerEndText()) == true) {
            summary = SpecUnitSummary {
                unit_count: summary.unit_count,
                parse_error_count: summary.parse_error_count + 1,
                duplicate_id_count: summary.duplicate_id_count,
                empty_body_count: summary.empty_body_count,
                missing_metadata_count: summary.missing_metadata_count,
                grammar_count: summary.grammar_count,
                grammar_requirement_count: summary.grammar_requirement_count,
                formal_rule_count: summary.formal_rule_count,
                formal_definition_count: summary.formal_definition_count,
                diagnostic_table_count: summary.diagnostic_table_count,
                diagnostic_requirement_count: summary.diagnostic_requirement_count,
                diagnostics_count: summary.diagnostics_count,
                semantic_requirement_count: summary.semantic_requirement_count,
                syntax_requirement_count: summary.syntax_requirement_count,
                dynamic_semantics_count: summary.dynamic_semantics_count,
                normative_requirement_count: summary.normative_requirement_count,
                lowering_rule_count: summary.lowering_rule_count,
                lowering_requirement_count: summary.lowering_requirement_count,
                conformance_statement_count: summary.conformance_statement_count,
                metatheoretic_property_count: summary.metatheoretic_property_count,
                informative_count: summary.informative_count,
                informative_note_count: summary.informative_note_count,
                unknown_kind_count: summary.unknown_kind_count,
                required_count: summary.required_count,
                normative_strength_count: summary.normative_strength_count,
                recommended_count: summary.recommended_count,
                advisory_count: summary.advisory_count,
                permitted_count: summary.permitted_count,
                allowed_count: summary.allowed_count,
                optional_count: summary.optional_count,
                informative_strength_count: summary.informative_strength_count,
                unknown_strength_count: summary.unknown_strength_count,
                primary_unit_start: summary.primary_unit_start,
                primary_unit_end: summary.primary_unit_end,
                primary_unit_line: summary.primary_unit_line,
                primary_unit_column: summary.primary_unit_column,
                primary_unit_identity: summary.primary_unit_identity,
                primary_kind: summary.primary_kind,
                primary_strength: summary.primary_strength
            }
        }

        index = line.end + line.break_width
        line_number = line_number + 1
    }

    if (inside_unit == true) {
        summary = SpecUnitSummary {
            unit_count: summary.unit_count,
            parse_error_count: summary.parse_error_count + 1,
            duplicate_id_count: summary.duplicate_id_count,
            empty_body_count: summary.empty_body_count,
            missing_metadata_count: summary.missing_metadata_count,
            grammar_count: summary.grammar_count,
            grammar_requirement_count: summary.grammar_requirement_count,
            formal_rule_count: summary.formal_rule_count,
            formal_definition_count: summary.formal_definition_count,
            diagnostic_table_count: summary.diagnostic_table_count,
            diagnostic_requirement_count: summary.diagnostic_requirement_count,
            diagnostics_count: summary.diagnostics_count,
            semantic_requirement_count: summary.semantic_requirement_count,
            syntax_requirement_count: summary.syntax_requirement_count,
            dynamic_semantics_count: summary.dynamic_semantics_count,
            normative_requirement_count: summary.normative_requirement_count,
            lowering_rule_count: summary.lowering_rule_count,
            lowering_requirement_count: summary.lowering_requirement_count,
            conformance_statement_count: summary.conformance_statement_count,
            metatheoretic_property_count: summary.metatheoretic_property_count,
            informative_count: summary.informative_count,
            informative_note_count: summary.informative_note_count,
            unknown_kind_count: summary.unknown_kind_count,
            required_count: summary.required_count,
            normative_strength_count: summary.normative_strength_count,
            recommended_count: summary.recommended_count,
            advisory_count: summary.advisory_count,
            permitted_count: summary.permitted_count,
            allowed_count: summary.allowed_count,
            optional_count: summary.optional_count,
            informative_strength_count: summary.informative_strength_count,
            unknown_strength_count: summary.unknown_strength_count,
            primary_unit_start: summary.primary_unit_start,
            primary_unit_end: summary.primary_unit_end,
            primary_unit_line: summary.primary_unit_line,
            primary_unit_column: summary.primary_unit_column,
            primary_unit_identity: summary.primary_unit_identity,
            primary_kind: summary.primary_kind,
            primary_strength: summary.primary_strength
        }
    }

    return SpecSourceScan {
        byte_length: length,
        line_count: line_number - 1,
        utf8_valid: utf8_valid,
        section_count: section_count,
        storage_failure_count: storage_failure_count,
        units: summary
    }
}

procedure emitSpecMetric(
    ctx: Reporting::OutputContext,
    value: i32,
    message: string@View
) -> Reporting::OutputContext {
    return Reporting::emitEvent(
        ctx,
        Reporting::metricIntegerEvent(
            Reporting::ReportPhase::SpecIngestion,
            Reporting::ReportSubjectKind::SpecDocument,
            canonicalSpecPath(),
            "Spec::Source",
            Reporting::ReportStatus::Parsed,
            Reporting::ReportMetricKind::ParsedUnitCount,
            value,
            message
        )
    )
}

procedure emitSpecIntegerMetric(
    ctx: Reporting::OutputContext,
    kind: Reporting::ReportMetricKind,
    value: i32,
    message: string@View
) -> Reporting::OutputContext {
    return Reporting::emitEvent(
        ctx,
        Reporting::metricIntegerEvent(
            Reporting::ReportPhase::SpecIngestion,
            Reporting::ReportSubjectKind::SpecDocument,
            canonicalSpecPath(),
            "Spec::Source",
            Reporting::ReportStatus::Parsed,
            kind,
            value,
            message
        )
    )
}

procedure emitParsedSpecUnit(
    ctx: Reporting::OutputContext,
    unit: SpecParsedUnit
) -> Reporting::OutputContext {
    let base: Reporting::OutputEvent = Reporting::eventWithSubjectInteger(
        Reporting::eventBase(
            Reporting::ReportEventKind::Evidence,
            Reporting::ReportSeverity::Info,
            Reporting::ReportPhase::SpecIngestion,
            Reporting::ReportSubjectKind::SpecUnit,
            "spec_unit",
            "Spec::Source",
            Reporting::ReportStatus::Parsed,
            "spec_unit_parsed"
        ),
        unit.ordinal
    )
    let with_evidence: Reporting::OutputEvent = Reporting::eventWithEvidence(
        base,
        Reporting::ReportEvidenceKind::SpecSpan,
        canonicalSpecPath()
    )
    let with_kind_strength: Reporting::OutputEvent = Reporting::eventWithExpectedObserved(
        with_evidence,
        renderSpecUnitKind(unit.kind),
        renderSpecUnitStrength(unit.strength)
    )
    return Reporting::emitEvent(
        ctx,
        Reporting::eventWithSourceContext(
            with_kind_strength,
            unit.source_start,
            unit.source_end,
            unit.source_line,
            unit.source_column,
            unit.content_identity
        )
    )
}

procedure emitSpecDuplicateWarning(
    ctx: Reporting::OutputContext,
    unit: SpecParsedUnit
) -> Reporting::OutputContext {
    let base: Reporting::OutputEvent = Reporting::eventWithSubjectInteger(
        Reporting::eventBase(
            Reporting::ReportEventKind::Warning,
            Reporting::ReportSeverity::Warning,
            Reporting::ReportPhase::SpecIngestion,
            Reporting::ReportSubjectKind::SpecUnit,
            "spec_unit",
            "Spec::Source",
            Reporting::ReportStatus::Parsed,
            "duplicate_spec_unit_id"
        ),
        unit.ordinal
    )
    let with_evidence: Reporting::OutputEvent = Reporting::eventWithEvidence(
        base,
        Reporting::ReportEvidenceKind::SpecSpan,
        canonicalSpecPath()
    )
    return Reporting::emitEvent(
        ctx,
        Reporting::eventWithSourceContext(
            with_evidence,
            unit.id_start,
            unit.id_end,
            unit.source_line,
            unit.source_column,
            unit.content_identity
        )
    )
}

procedure emitSpecStorageFailure(
    ctx: Reporting::OutputContext,
    scan: SpecSourceScan
) -> Reporting::OutputContext {
    let event: Reporting::OutputEvent = Reporting::failureEvent(
        Reporting::ReportPhase::SpecIngestion,
        Reporting::ReportSubjectKind::SpecDocument,
        canonicalSpecPath(),
        "Spec::Source",
        Reporting::ReportFailureKind::OracleInternal,
        "0",
        Reporting::renderSmallInteger(scan.storage_failure_count),
        "spec_ingestion_storage_failure"
    )
    return Reporting::emitEvent(ctx, event)
}

procedure emitSpecParseFailure(
    ctx: Reporting::OutputContext,
    scan: SpecSourceScan
) -> Reporting::OutputContext {
    let event: Reporting::OutputEvent = Reporting::failureEvent(
        Reporting::ReportPhase::SpecIngestion,
        Reporting::ReportSubjectKind::SpecDocument,
        canonicalSpecPath(),
        "Spec::Source",
        Reporting::ReportFailureKind::SpecParseError,
        "0",
        Reporting::renderSmallInteger(scan.units.parse_error_count),
        "spec_parse_error"
    )
    return Reporting::emitEvent(ctx, event)
}

procedure emitSpecUnitEvents(
    ctx: Reporting::OutputContext,
    view: bytes@View,
    ledger: unique bytes@Managed,
    heap: $HeapAllocator
) -> Reporting::OutputContext {
    let length: i32 = bytes::length(view) as i32
    let slice: const [u8] = bytes::as_slice(view)
    var output: Reporting::OutputContext = ctx
    var index: i32 = 0
    var line_number: i32 = 1
    var unit_count: i32 = 0
    var inside_unit: bool = false
    var inside_metadata: bool = false
    var unit_start: i32 = 0
    var unit_line: i32 = 1
    var metadata_start: i32 = 0
    var metadata_end: i32 = 0
    var body_start: i32 = 0
    var unit_kind: SpecUnitKind = SpecUnitKind::Unknown
    var unit_strength: SpecUnitStrength = SpecUnitStrength::Unknown
    var id_span: MetadataValueSpan = absentMetadataValue(0)
    var phase_span: MetadataValueSpan = absentMetadataValue(0)
    var owner_span: MetadataValueSpan = absentMetadataValue(0)
    var applies_to_span: MetadataValueSpan = absentMetadataValue(0)
    var summary_span: MetadataValueSpan = absentMetadataValue(0)
    var labels_span: MetadataValueSpan = absentMetadataValue(0)
    var has_kind: bool = false
    var has_strength: bool = false
    var has_metadata_close: bool = false

    loop {
        if (index >= length) {
            break
        }

        let line: SourceLine = sourceLineAt(slice, index, length, line_number)
        if (lineEqualsText(slice, line, markerStartText()) == true) {
            inside_unit = true
            inside_metadata = true
            unit_start = line.start
            unit_line = line.line_number
            metadata_start = line.start
            metadata_end = line.end
            body_start = line.end
            unit_kind = SpecUnitKind::Unknown
            unit_strength = SpecUnitStrength::Unknown
            id_span = absentMetadataValue(line.end)
            phase_span = absentMetadataValue(line.end)
            owner_span = absentMetadataValue(line.end)
            applies_to_span = absentMetadataValue(line.end)
            summary_span = absentMetadataValue(line.end)
            labels_span = absentMetadataValue(line.end)
            has_kind = false
            has_strength = false
            has_metadata_close = false
        } else if ((inside_unit == true) && (inside_metadata == true)) {
            if (lineEqualsText(slice, line, metadataCloseText()) == true) {
                inside_metadata = false
                has_metadata_close = true
                metadata_end = line.end
                body_start = line.end + line.break_width
            } else {
                let id_value: MetadataValueSpan = metadataValueSpan(slice, line, "id")
                if (id_value.present == true) {
                    id_span = id_value
                }
                let phase_value: MetadataValueSpan = metadataValueSpan(slice, line, "phase")
                if (phase_value.present == true) {
                    phase_span = phase_value
                }
                let owner_value: MetadataValueSpan = metadataValueSpan(slice, line, "owner")
                if (owner_value.present == true) {
                    owner_span = owner_value
                }
                let applies_to_value: MetadataValueSpan =
                    metadataValueSpan(slice, line, "applies-to")
                if (applies_to_value.present == true) {
                    applies_to_span = applies_to_value
                }
                let summary_value: MetadataValueSpan = metadataValueSpan(slice, line, "summary")
                if (summary_value.present == true) {
                    summary_span = summary_value
                }
                let labels_value: MetadataValueSpan = metadataValueSpan(slice, line, "labels")
                if (labels_value.present == true) {
                    labels_span = labels_value
                }
                if (metadataLineHasKey(slice, line, "kind") == true) {
                    has_kind = true
                    unit_kind = kindFromMetadataLine(slice, line)
                }
                if (metadataLineHasKey(slice, line, "strength") == true) {
                    has_strength = true
                    unit_strength = strengthFromMetadataLine(slice, line)
                }
            }
        } else if ((inside_unit == true) && (lineEqualsText(slice, line, markerEndText()) == true)) {
            let duplicate_id: bool = if id_span.present == true {
                specIdLedgerContains(
                    bytes::as_view(ledger),
                    slice,
                    length,
                    id_span.start,
                    id_span.end
                )
            } else {
                false
            }
            if (id_span.present == true) {
                let append_ok: bool =
                    appendSpecIdToLedger(ledger, slice, id_span.start, id_span.end, heap)
                let _ = append_ok
            }

            let unit: SpecParsedUnit = parsedUnitFromState(
                slice,
                length,
                unit_count + 1,
                unit_start,
                line.end,
                metadata_start,
                metadata_end,
                body_start,
                line.start,
                unit_line,
                id_span,
                unit_kind,
                unit_strength,
                phase_span,
                owner_span,
                applies_to_span,
                summary_span,
                labels_span,
                has_kind,
                has_strength,
                has_metadata_close,
                duplicate_id
            )
            output = emitParsedSpecUnit(output, unit)
            if (unit.duplicate_id == true) {
                output = emitSpecDuplicateWarning(output, unit)
            }
            unit_count = unit_count + 1
            inside_unit = false
            inside_metadata = false
        }

        index = line.end + line.break_width
        line_number = line_number + 1
    }

    return output
}

procedure emitSpecMetrics(
    ctx: Reporting::OutputContext,
    scan: SpecSourceScan
) -> Reporting::OutputContext {
    var output: Reporting::OutputContext = emitSpecIntegerMetric(
        ctx,
        Reporting::ReportMetricKind::ByteLength,
        scan.byte_length,
        "spec_byte_length"
    )
    output = emitSpecIntegerMetric(
        output,
        Reporting::ReportMetricKind::LineCount,
        scan.line_count,
        "spec_line_count"
    )
    output = emitSpecIntegerMetric(
        output,
        Reporting::ReportMetricKind::SectionCount,
        scan.section_count,
        "spec_section_count"
    )
    output = emitSpecMetric(output, scan.units.unit_count, "spec_unit_count")
    output = emitSpecMetric(output, scan.units.grammar_count, "spec_unit_kind_grammar")
    output = emitSpecMetric(
        output,
        scan.units.grammar_requirement_count,
        "spec_unit_kind_grammar_requirement"
    )
    output = emitSpecMetric(output, scan.units.formal_rule_count, "spec_unit_kind_formal_rule")
    output = emitSpecMetric(
        output,
        scan.units.formal_definition_count,
        "spec_unit_kind_formal_definition"
    )
    output = emitSpecMetric(
        output,
        scan.units.diagnostic_table_count,
        "spec_unit_kind_diagnostic_table"
    )
    output = emitSpecMetric(
        output,
        scan.units.diagnostic_requirement_count,
        "spec_unit_kind_diagnostic_requirement"
    )
    output = emitSpecMetric(output, scan.units.diagnostics_count, "spec_unit_kind_diagnostics")
    output = emitSpecMetric(
        output,
        scan.units.semantic_requirement_count,
        "spec_unit_kind_semantic_requirement"
    )
    output = emitSpecMetric(
        output,
        scan.units.syntax_requirement_count,
        "spec_unit_kind_syntax_requirement"
    )
    output = emitSpecMetric(
        output,
        scan.units.dynamic_semantics_count,
        "spec_unit_kind_dynamic_semantics"
    )
    output = emitSpecMetric(
        output,
        scan.units.normative_requirement_count,
        "spec_unit_kind_normative_requirement"
    )
    output = emitSpecMetric(output, scan.units.lowering_rule_count, "spec_unit_kind_lowering_rule")
    output = emitSpecMetric(
        output,
        scan.units.lowering_requirement_count,
        "spec_unit_kind_lowering_requirement"
    )
    output = emitSpecMetric(
        output,
        scan.units.conformance_statement_count,
        "spec_unit_kind_conformance_statement"
    )
    output = emitSpecMetric(
        output,
        scan.units.metatheoretic_property_count,
        "spec_unit_kind_metatheoretic_property"
    )
    output = emitSpecMetric(output, scan.units.informative_count, "spec_unit_kind_informative")
    output = emitSpecMetric(
        output,
        scan.units.informative_note_count,
        "spec_unit_kind_informative_note"
    )
    output = emitSpecMetric(output, scan.units.unknown_kind_count, "spec_unit_kind_unknown")
    output = emitSpecMetric(output, scan.units.required_count, "spec_unit_strength_required")
    output = emitSpecMetric(output, scan.units.normative_strength_count, "spec_unit_strength_normative")
    output = emitSpecMetric(output, scan.units.recommended_count, "spec_unit_strength_recommended")
    output = emitSpecMetric(output, scan.units.advisory_count, "spec_unit_strength_advisory")
    output = emitSpecMetric(output, scan.units.permitted_count, "spec_unit_strength_permitted")
    output = emitSpecMetric(output, scan.units.allowed_count, "spec_unit_strength_allowed")
    output = emitSpecMetric(output, scan.units.optional_count, "spec_unit_strength_optional")
    output = emitSpecMetric(
        output,
        scan.units.informative_strength_count,
        "spec_unit_strength_informative"
    )
    output = emitSpecMetric(output, scan.units.unknown_strength_count, "spec_unit_strength_unknown")
    output = emitSpecMetric(output, scan.units.missing_metadata_count, "spec_unit_missing_metadata_count")
    output = emitSpecMetric(output, scan.units.empty_body_count, "spec_unit_empty_body_count")
    output = emitSpecMetric(output, scan.units.duplicate_id_count, "spec_unit_duplicate_id_count")
    output = emitSpecMetric(output, scan.storage_failure_count, "spec_ingestion_storage_failure_count")
    return emitSpecMetric(output, scan.units.parse_error_count, "spec_unit_parse_error_count")
}

procedure specIngestionResult(
    ctx: Reporting::OutputContext,
    status: i32,
    passed_count: i32,
    failed_count: i32,
    scan: SpecSourceScan,
    unit_ledger_storage_failure_count: i32
) -> SpecIngestionResult {
    let document: Document::SpecDocumentSummary = Document::specDocumentSummary(
        canonicalSpecPath(),
        scan.byte_length,
        scan.line_count,
        scan.utf8_valid,
        scan.section_count,
        scan.units.unit_count
    )
    return SpecIngestionResult {
        ctx: ctx,
        status: status,
        passed_count: passed_count,
        failed_count: failed_count,
        document: document,
        unit_ledger_path: specUnitLedgerPath(),
        unit_ledger_record_count: scan.units.unit_count,
        unit_ledger_storage_failure_count: unit_ledger_storage_failure_count,
        unit_count: scan.units.unit_count,
        marker_parse_error_count: scan.units.parse_error_count,
        duplicate_id_count: scan.units.duplicate_id_count,
        empty_body_count: scan.units.empty_body_count,
        missing_metadata_count: scan.units.missing_metadata_count,
        grammar_count: scan.units.grammar_count,
        grammar_requirement_count: scan.units.grammar_requirement_count,
        formal_rule_count: scan.units.formal_rule_count,
        formal_definition_count: scan.units.formal_definition_count,
        diagnostic_table_count: scan.units.diagnostic_table_count,
        diagnostic_requirement_count: scan.units.diagnostic_requirement_count,
        diagnostics_count: scan.units.diagnostics_count,
        semantic_requirement_count: scan.units.semantic_requirement_count,
        syntax_requirement_count: scan.units.syntax_requirement_count,
        dynamic_semantics_count: scan.units.dynamic_semantics_count,
        normative_requirement_count: scan.units.normative_requirement_count,
        lowering_rule_count: scan.units.lowering_rule_count,
        lowering_requirement_count: scan.units.lowering_requirement_count,
        conformance_statement_count: scan.units.conformance_statement_count,
        metatheoretic_property_count: scan.units.metatheoretic_property_count,
        informative_count: scan.units.informative_count,
        informative_note_count: scan.units.informative_note_count,
        unknown_kind_count: scan.units.unknown_kind_count,
        required_count: scan.units.required_count,
        normative_strength_count: scan.units.normative_strength_count,
        recommended_count: scan.units.recommended_count,
        advisory_count: scan.units.advisory_count,
        permitted_count: scan.units.permitted_count,
        allowed_count: scan.units.allowed_count,
        optional_count: scan.units.optional_count,
        informative_strength_count: scan.units.informative_strength_count,
        unknown_strength_count: scan.units.unknown_strength_count,
        primary_unit_start: scan.units.primary_unit_start,
        primary_unit_end: scan.units.primary_unit_end,
        primary_unit_line: scan.units.primary_unit_line,
        primary_unit_column: scan.units.primary_unit_column,
        primary_unit_identity: scan.units.primary_unit_identity,
        primary_kind: scan.units.primary_kind,
        primary_strength: scan.units.primary_strength
    }
}

procedure failedSpecReadResult(ctx: Reporting::OutputContext) -> SpecIngestionResult {
    let empty_scan: SpecSourceScan = SpecSourceScan {
        byte_length: 0,
        line_count: 0,
        utf8_valid: false,
        section_count: 0,
        storage_failure_count: 0,
        units: specUnitSummaryEmpty()
    }
    return specIngestionResult(ctx, 73, 0, 1, empty_scan, 1)
}

public procedure runSpecIngestion(
    ctx: Reporting::OutputContext,
    heap: $HeapAllocator
) -> SpecIngestionResult {
    var output: Reporting::OutputContext = Reporting::emitPhaseBegin(
        ctx,
        Reporting::ReportPhase::SpecIngestion,
        "spec_ingestion",
        "Spec::Source"
    )
    output = Reporting::emitEvent(
        output,
        Reporting::evidenceEvent(
            Reporting::ReportPhase::SpecIngestion,
            Reporting::ReportSubjectKind::SpecDocument,
            canonicalSpecPath(),
            "Spec::Source",
            Reporting::ReportStatus::Running,
            Reporting::ReportEvidenceKind::SpecPath,
            canonicalSpecPath(),
            "spec_path"
        )
    )
    output = Reporting::emitCheckpoint(
        output,
        Reporting::ReportPhase::SpecIngestion,
        Reporting::ReportSubjectKind::SpecDocument,
        "spec_read_start",
        "Spec::Source"
    )

    return if output.fs~>read_bytes(canonicalSpecPath()) is {
        spec_bytes: unique bytes@Managed {
            let view: bytes@View = bytes::as_view(spec_bytes)
            output = Reporting::emitCheckpoint(
                output,
                Reporting::ReportPhase::SpecIngestion,
                Reporting::ReportSubjectKind::SpecDocument,
                "spec_read_complete",
                "Spec::Source"
            )
            let utf8: Text::Utf8Validation = Text::utf8Validate(view)
            let utf8_valid: bool = Text::utf8ValidationIsValid(utf8)
            output = Reporting::emitEvent(
                output,
                Reporting::metricIntegerEvent(
                    Reporting::ReportPhase::SpecIngestion,
                    Reporting::ReportSubjectKind::SpecDocument,
                    canonicalSpecPath(),
                    "Spec::Source",
                    if utf8_valid { Reporting::ReportStatus::Utf8Valid } else {
                        Reporting::ReportStatus::Utf8Invalid
                    },
                    Reporting::ReportMetricKind::ByteLength,
                    utf8.byte_length,
                    "spec_utf8_status"
                )
            )
            output = Reporting::emitCheckpoint(
                output,
                Reporting::ReportPhase::SpecIngestion,
                Reporting::ReportSubjectKind::SpecDocument,
                "spec_structure_scan_start",
                "Spec::Source"
            )
            var unit_ledger_storage_failure_count: i32 = 0
            let ledger_result: bytes@Managed | AllocationError =
                bytes::with_capacity(specIdLedgerInitialByteCapacity(bytes::length(view) as i32), heap)
            let raw_scan: SpecSourceScan = if ledger_result is {
                ledger: unique bytes@Managed {
                    let unit_ledger_result: bytes@Managed | AllocationError =
                        bytes::with_capacity(
                            specUnitLedgerInitialByteCapacity(bytes::length(view) as i32),
                            heap
                        )
                    if unit_ledger_result is {
                        unit_ledger: unique bytes@Managed {
                            let parsed_scan: SpecSourceScan =
                                scanSpecStructure(view, utf8_valid, ledger, unit_ledger, heap)
                            if (writeSpecUnitLedger(output.fs, bytes::as_view(unit_ledger)) == false) {
                                unit_ledger_storage_failure_count =
                                    unit_ledger_storage_failure_count + 1
                            }
                            parsed_scan
                        }
                        _: AllocationError {
                            unit_ledger_storage_failure_count =
                                unit_ledger_storage_failure_count + 1
                            if (writeSpecUnitLedger(output.fs, bytes::view_string("")) == false) {
                                unit_ledger_storage_failure_count =
                                    unit_ledger_storage_failure_count + 1
                            }
                            SpecSourceScan {
                                byte_length: bytes::length(view) as i32,
                                line_count: 0,
                                utf8_valid: utf8_valid,
                                section_count: 0,
                                storage_failure_count: 1,
                                units: specUnitSummaryEmpty()
                            }
                        }
                    }
                }
                _: AllocationError {
                    unit_ledger_storage_failure_count = unit_ledger_storage_failure_count + 1
                    if (writeSpecUnitLedger(output.fs, bytes::view_string("")) == false) {
                        unit_ledger_storage_failure_count = unit_ledger_storage_failure_count + 1
                    }
                    SpecSourceScan {
                        byte_length: bytes::length(view) as i32,
                        line_count: 0,
                        utf8_valid: utf8_valid,
                        section_count: 0,
                        storage_failure_count: 1,
                        units: specUnitSummaryEmpty()
                    }
                }
            }
            let scan: SpecSourceScan = if unit_ledger_storage_failure_count == 0 {
                raw_scan
            } else {
                let total_storage_failure_count: i32 =
                    raw_scan.storage_failure_count + unit_ledger_storage_failure_count
                SpecSourceScan {
                    byte_length: raw_scan.byte_length,
                    line_count: raw_scan.line_count,
                    utf8_valid: raw_scan.utf8_valid,
                    section_count: raw_scan.section_count,
                    storage_failure_count: total_storage_failure_count,
                    units: raw_scan.units
                }
            }
            output = Reporting::emitCheckpoint(
                output,
                Reporting::ReportPhase::SpecIngestion,
                Reporting::ReportSubjectKind::SpecDocument,
                "spec_structure_scan_complete",
                "Spec::Source"
            )
            output = emitSpecMetrics(output, scan)
            output = Reporting::emitCheckpoint(
                output,
                Reporting::ReportPhase::SpecIngestion,
                Reporting::ReportSubjectKind::SpecDocument,
                "spec_unit_emit_start",
                "Spec::Source"
            )
            let emit_ledger_result: bytes@Managed | AllocationError =
                bytes::with_capacity(specIdLedgerInitialByteCapacity(bytes::length(view) as i32), heap)
            output = if emit_ledger_result is {
                emit_ledger: unique bytes@Managed {
                    emitSpecUnitEvents(output, view, emit_ledger, heap)
                }
                _: AllocationError {
                    emitSpecStorageFailure(
                        output,
                        SpecSourceScan {
                            byte_length: bytes::length(view) as i32,
                            line_count: scan.line_count,
                            utf8_valid: utf8_valid,
                            section_count: scan.section_count,
                            storage_failure_count: scan.storage_failure_count + 1,
                            units: scan.units
                        }
                    )
                }
            }
            output = Reporting::emitCheckpoint(
                output,
                Reporting::ReportPhase::SpecIngestion,
                Reporting::ReportSubjectKind::SpecDocument,
                "spec_unit_emit_complete",
                "Spec::Source"
            )

            let status: i32 = if (utf8_valid == false) {
                72
            } else {
                if (scan.storage_failure_count != 0) {
                    74
                } else {
                    if (scan.units.parse_error_count != 0) { 73 } else { 0 }
                }
            }
            if (scan.units.parse_error_count != 0) {
                output = emitSpecParseFailure(output, scan)
            }
            if (scan.storage_failure_count != 0) {
                output = emitSpecStorageFailure(output, scan)
            }
            let phase_status: Reporting::ReportStatus = if (status == 0) {
                Reporting::ReportStatus::Parsed
            } else {
                Reporting::ReportStatus::ParseError
            }
            output = Reporting::emitPhaseEnd(
                output,
                Reporting::ReportPhase::SpecIngestion,
                "spec_ingestion",
                "Spec::Source",
                phase_status
            )
            specIngestionResult(
                output,
                status,
                if status == 0 { 1 } else { 0 },
                if status == 0 { 0 } else { 1 },
                scan,
                unit_ledger_storage_failure_count
            )
        }
        _: IoError {
            output = Reporting::emitEvent(
                output,
                Reporting::failureEvent(
                    Reporting::ReportPhase::SpecIngestion,
                    Reporting::ReportSubjectKind::SpecDocument,
                    canonicalSpecPath(),
                    "Spec::Source",
                    Reporting::ReportFailureKind::SpecParseError,
                    "readable_spec_file",
                    "read_error",
                    "spec_read_failed"
                )
            )
            output = Reporting::emitPhaseEnd(
                output,
                Reporting::ReportPhase::SpecIngestion,
                "spec_ingestion",
                "Spec::Source",
                Reporting::ReportStatus::Failed
            )
            failedSpecReadResult(output)
        }
    }
}
