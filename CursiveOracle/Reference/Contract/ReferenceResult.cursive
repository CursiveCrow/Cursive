import core::Reporting

public enum ReferenceCoverageState {
    Modeled
    UnsupportedByReference
    OutsideConformance
    BlockedByOracleLanguageSupport
}

public record ReferenceResult {
    public obligation_id: string@View
    public rule_id: string@View
    public coverage_state: ReferenceCoverageState
    public expected_status: Reporting::ReportStatus
    public blocker_reason: string@View
}

public record ReferenceModelSummary {
    public ctx: Reporting::OutputContext
    public status: i32
    public modeled_count: i32
    public unsupported_count: i32
    public outside_conformance_count: i32
    public blocked_by_oracle_language_support_count: i32
    public result: ReferenceResult
}

public procedure referenceResult(
    obligation_id: string@View,
    rule_id: string@View,
    coverage_state: ReferenceCoverageState,
    expected_status: Reporting::ReportStatus,
    blocker_reason: string@View
) -> ReferenceResult {
    return ReferenceResult {
        obligation_id: obligation_id,
        rule_id: rule_id,
        coverage_state: coverage_state,
        expected_status: expected_status,
        blocker_reason: blocker_reason
    }
}

public procedure referenceModelSummary(
    ctx: Reporting::OutputContext,
    status: i32,
    modeled_count: i32,
    unsupported_count: i32,
    outside_conformance_count: i32,
    blocked_by_oracle_language_support_count: i32,
    result: ReferenceResult
) -> ReferenceModelSummary {
    return ReferenceModelSummary {
        ctx: ctx,
        status: status,
        modeled_count: modeled_count,
        unsupported_count: unsupported_count,
        outside_conformance_count: outside_conformance_count,
        blocked_by_oracle_language_support_count: blocked_by_oracle_language_support_count,
        result: result
    }
}

public procedure coverageStatus(value: ReferenceCoverageState) -> Reporting::ReportStatus {
    return if value is {
        ReferenceCoverageState::Modeled { Reporting::ReportStatus::Modeled }
        ReferenceCoverageState::UnsupportedByReference {
            Reporting::ReportStatus::UnsupportedByReference
        }
        ReferenceCoverageState::OutsideConformance { Reporting::ReportStatus::OutsideConformance }
        ReferenceCoverageState::BlockedByOracleLanguageSupport {
            Reporting::ReportStatus::BlockedByOracleLanguageSupport
        }
    }
}
